+class _Urllib3Session(object):
+    def __init__(self, *args, **kwargs):
+        self._pool = urllib3.PoolManager(*args, **kwargs)
+        self.headers = dict(getattr(self._pool, 'headers', {}) or {})
+
+    def get(self, url, params=None, headers=None, **kwargs):
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        return self._pool.request(
+            'GET',
+            url,
+            fields=params,
+            headers=request_headers or None,
+            **kwargs
+        )
+
+    def close(self):
+        self._pool.clear()
+
+
+class _SessionAdapter(object):
+    def __init__(self, session):
+        self._session = session
+        self.headers = dict(getattr(session, 'headers', {}) or {})
+
+    def get(self, url, params=None, headers=None, **kwargs):
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        if hasattr(self._session, 'request'):
+            return self._session.request(
+                'GET',
+                url,
+                fields=params,
+                headers=request_headers or None,
+                **kwargs
+            )
+
+        if hasattr(self._session, 'get'):
+            return self._session.get(
+                url,
+                params=params,
+                headers=request_headers or None,
+                **kwargs
+            )
+
+        raise TypeError('session must provide a get or request method')
+
+    def close(self):
+        closer = getattr(self._session, 'close', None)
+        if callable(closer):
+            closer()
+            return
+
+        clearer = getattr(self._session, 'clear', None)
+        if callable(clearer):
+            clearer()
+
