+
+def _response_status(response):
+    return getattr(response, 'status_code', getattr(response, 'status', None))
+
+
+def _response_text(response):
+    text = getattr(response, 'text', None)
+    if text is not None:
+        return text
+
+    data = getattr(response, 'data', None)
+    if data is None:
+        data = getattr(response, 'content', b'')
+
+    if isinstance(data, str):
+        return data
+
+    headers = getattr(response, 'headers', None)
+    encoding = None
+    if headers is not None:
+        encoding = getattr(headers, 'get_content_charset', lambda: None)()
+        if not encoding:
+            content_type = headers.get('Content-Type') or headers.get('content-type')
+            if content_type and 'charset=' in content_type:
+                encoding = content_type.split('charset=', 1)[1].split(';', 1)[0].strip()
+
+    return data.decode(encoding or 'utf-8', errors='replace')
+
+
+def _response_json(response):
+    json_method = getattr(response, 'json', None)
+    if callable(json_method):
+        return json_method()
+    return json.loads(_response_text(response))
+
+
+def _response_close(response):
+    closer = getattr(response, 'close', None)
+    if callable(closer):
+        closer()
 
 
