+from dataclasses import dataclass
+from typing import Iterable, Mapping, Optional
+from urllib import error, request as urllib_request
+
+import ssl
+
+
+class Headers(dict):
+    @property
+    def raw(self):
+        return [(str(key).encode("utf-8"), str(value).encode("utf-8")) for key, value in self.items()]
+
+
+class Cookies:
+    def extract_cookies(self, response):
+        return None
+
+
+class Request:
+    def __init__(self, method, url, headers=None, content=b""):
+        self.method = method
+        self.url = url
+        self.headers = Headers(headers or {})
+        self._content = content if isinstance(content, bytes) else str(content).encode()
+
+    def read(self):
+        return self._content
+
+
+class Response:
+    def __init__(self, status_code, request=None, headers=None, content=b"", history=None, extensions=None):
+        self.status_code = status_code
+        self.request = request
+        self.headers = Headers(headers or {})
+        self._content = content if isinstance(content, bytes) else str(content).encode()
+        self.history = history or []
+        self.extensions = extensions or {}
+        self.cookies = Cookies()
+        self.reason_phrase = self.extensions.get("reason_phrase", b"").decode("utf-8", errors="ignore")
+
+    @property
+    def content(self):
+        return self._content
+
+    @property
+    def text(self):
+        return self._content.decode()
+
+    def read(self):
+        self._decoder = self._get_content_decoder()
+        return self._content
+
+    async def aread(self):
+        self._decoder = self._get_content_decoder()
+        return self._content
+
+    def _get_content_decoder(self):
+        class _Decoder:
+            @staticmethod
+            def decode(content):
+                return content
+
+        return _Decoder()
+
+    def close(self):
+        return None
+
+
+class Client:
+    def __init__(self, *args, **kwargs):
+        self.cookies = Cookies()
+
+    def request(self, method, url, headers=None, timeout=None, verify=True, content=b"", follow_redirects=None, allow_redirects=None, **kwargs):
+        request_obj = Request(method=method, url=url, headers=headers, content=content)
+        return self._send_single_request(request_obj, timeout=timeout, verify=verify, follow_redirects=follow_redirects, allow_redirects=allow_redirects, **kwargs)
+
+    def get(self, url, **kwargs):
+        return self.request("GET", url, **kwargs)
+
+    def _send_single_request(self, request_obj, timeout=None, verify=True, **kwargs):
+        req = urllib_request.Request(url=request_obj.url, headers=dict(request_obj.headers), method=request_obj.method)
+        context: Optional[ssl.SSLContext] = None
+        if not verify:
+            context = ssl._create_unverified_context()
+
+        try:
+            with urllib_request.urlopen(req, timeout=timeout, context=context) as response:
+                body = response.read()
+                return Response(
+                    status_code=response.getcode(),
+                    request=request_obj,
+                    headers=dict(response.headers.items()),
+                    content=body,
+                )
+        except error.HTTPError as exc:
+            body = exc.read()
+            return Response(
+                status_code=exc.code,
+                request=request_obj,
+                headers=dict(exc.headers.items()) if exc.headers else {},
+                content=body,
+            )
+
+    def close(self):
+        return None
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        self.close()
+        return False
+
+
+class AsyncClient:
+    def __init__(self, *args, **kwargs):
+        self.cookies = Cookies()
+
+    async def request(self, method, url, headers=None, timeout=None, verify=True, content=b"", follow_redirects=None, allow_redirects=None, **kwargs):
+        request_obj = Request(method=method, url=url, headers=headers, content=content)
+        return await self._send_single_request(request_obj, timeout=timeout, verify=verify, follow_redirects=follow_redirects, allow_redirects=allow_redirects, **kwargs)
+
+    async def get(self, url, **kwargs):
+        return await self.request("GET", url, **kwargs)
+
+    async def _send_single_request(self, request_obj, timeout=None, verify=True, **kwargs):
+        client = Client()
+        return client._send_single_request(request_obj, timeout=timeout, verify=verify, **kwargs)
+
+    async def aclose(self):
+        return None
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb):
+        await self.aclose()
+        return False
+
+
+@dataclass
+class _ModuleResponse:
+    status_code: int
+    text: str
+    headers: Mapping[str, str]
+
+
+def request(method, url, *, headers=None, timeout=None, verify=True, **kwargs):
+    return Client().request(method, url, headers=headers, timeout=timeout, verify=verify, **kwargs)
+
+
+def get(url, *, headers=None, timeout=None, verify=True, **kwargs):
+    return request("GET", url, headers=headers, timeout=timeout, verify=verify, **kwargs)
