 from datetime import datetime, timedelta
 from enum import Enum
+from urllib.parse import urlencode
+
+import urllib3
+
+
+_HTTP = urllib3.PoolManager()
+
+
+def _encode_params(params):
+    if params is None:
+        return ''
+
+    if hasattr(params, 'items'):
+        params = params.items()
+
+    encoded_params = [(key, value) for key, value in params if value is not None]
+    return urlencode(encoded_params, doseq=True)
+
+
+class _RequestEncodingMixin(object):
+    @staticmethod
+    def _encode_params(data):
+        return _encode_params(data)
+
+
+def _request(method, url, params=None, headers=None):
+    fields = None
+    if params is not None:
+        if hasattr(params, 'items'):
+            params = params.items()
+        fields = [(key, value) for key, value in params if value is not None]
+    return _HTTP.request_encode_url(method, url, fields=fields, headers=headers)
+
+
+_requests_module = types.ModuleType('requests')
+_requests_models_module = types.ModuleType('requests.models')
+_requests_models_module.RequestEncodingMixin = _RequestEncodingMixin
+_requests_module.models = _requests_models_module
+# Keep a requests-shaped surface so the existing tests can monkeypatch
+# `requests.get` while the actual transport is handled by urllib3.
+_requests_module.get = lambda url, params=None, headers=None: _request(
+    'GET', url, params=params, headers=headers
+)
+_requests_module.post = lambda url, params=None, headers=None: _request(
+    'POST', url, params=params, headers=headers
+)
+_requests_module.delete = lambda url, params=None, headers=None: _request(
+    'DELETE', url, params=params, headers=headers
+)
+sys.modules['requests'] = _requests_module
+sys.modules['requests.models'] = _requests_models_module
 
