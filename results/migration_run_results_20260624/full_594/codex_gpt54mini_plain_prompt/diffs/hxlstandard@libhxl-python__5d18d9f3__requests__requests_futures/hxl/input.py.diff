+class _RequestsAdapter:
+    """Keep the existing synchronous call pattern on top of FuturesSession."""
+
+    def __init__(self):
+        self._session = FuturesSession() if FuturesSession is not None else _requests.Session()
+
+    def request(self, method, *args, **kwargs):
+        response = self._session.request(method, *args, **kwargs)
+        if hasattr(response, "result"):
+            response = response.result()
+        return response
+
+    def get(self, *args, **kwargs):
+        return self.request("GET", *args, **kwargs)
+
+    def head(self, *args, **kwargs):
+        return self.request("HEAD", *args, **kwargs)
+
+    def post(self, *args, **kwargs):
+        return self.request("POST", *args, **kwargs)
+
+
+requests = _RequestsAdapter()
