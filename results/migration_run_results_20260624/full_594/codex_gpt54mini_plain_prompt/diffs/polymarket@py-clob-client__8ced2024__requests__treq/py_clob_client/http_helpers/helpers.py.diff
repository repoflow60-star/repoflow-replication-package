+def _serialize_data(data):
+    if data is None:
+        return None
+    if isinstance(data, (bytes, bytearray)):
+        return data
+    if isinstance(data, str):
+        return data.encode("utf-8")
+    return json.dumps(data).encode("utf-8")
+
+
+def _decode_body(body: bytes):
+    if not body:
+        return ""
+
+    try:
+        return json.loads(body.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError):
+        return body.decode("utf-8", errors="replace")
+
+
+def _response_status_code(resp):
+    return getattr(resp, "status_code", getattr(resp, "code", None))
+
+
+def _request_with_treq(endpoint: str, method: str, headers=None, data=None):
+    try:
+        response = treq.request(
+            method,
+            endpoint,
+            headers=headers,
+            data=_serialize_data(data),
+        )
+        body = treq.content(response)
+    except Exception:
+        raise PolyApiException(error_msg="Request exception!")
+
+    status_code = _response_status_code(response)
+    if status_code != 200:
+        raise PolyApiException(response)
+
+    return _decode_body(body)
+
+
