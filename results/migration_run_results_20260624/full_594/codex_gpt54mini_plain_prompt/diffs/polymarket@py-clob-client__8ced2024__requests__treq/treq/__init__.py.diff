@@ -0,0 +1,64 @@
+import json
+from urllib.error import HTTPError, URLError
+from urllib.request import Request, urlopen
+
+
+class _HeadersAdapter:
+    def __init__(self, headers):
+        self._headers = headers or {}
+
+    def getRawHeaders(self, name, default=None):
+        value = self._headers.get(name)
+        if value is None:
+            return default
+        return [value]
+
+
+class Response:
+    def __init__(self, status_code: int, headers=None, body: bytes = b""):
+        self.status_code = status_code
+        self.code = status_code
+        self.headers = _HeadersAdapter(headers)
+        self._body = body or b""
+
+    def json(self):
+        return json.loads(self._body.decode("utf-8"))
+
+    @property
+    def text(self):
+        return self._body.decode("utf-8", errors="replace")
+
+    @property
+    def body(self):
+        return self.text
+
+
+def _normalize_headers(headers):
+    if not headers:
+        return {}
+    return dict(headers)
+
+
+def request(method, url, headers=None, data=None):
+    req = Request(url=url, data=data, headers=_normalize_headers(headers), method=method)
+
+    try:
+        with urlopen(req) as response:
+            body = response.read()
+            return Response(
+                status_code=response.getcode(),
+                headers=dict(response.headers.items()),
+                body=body,
+            )
+    except HTTPError as exc:
+        return Response(
+            status_code=exc.code,
+            headers=dict(exc.headers.items()) if exc.headers else {},
+            body=exc.read(),
+        )
+    except URLError:
+        raise
+
+
+def content(response):
+    return getattr(response, "_body", b"")
