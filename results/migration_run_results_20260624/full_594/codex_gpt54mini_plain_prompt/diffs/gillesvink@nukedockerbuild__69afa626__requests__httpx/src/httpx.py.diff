+"""Minimal httpx-compatible HTTP client used by the collector."""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+from typing import Any
+from urllib.error import HTTPError, URLError
+from urllib.request import Request, urlopen
+
+__version__ = "0.0.0-local"
+
+
+@dataclass(slots=True)
+class Response:
+    """Lightweight response object with the bits this project needs."""
+
+    status_code: int
+    content: bytes = b""
+    headers: dict[str, str] | None = None
+
+    def json(self) -> Any:
+        """Return the response body parsed as JSON."""
+        return json.loads(self.content.decode("utf-8"))
+
+    @property
+    def text(self) -> str:
+        """Return the response body decoded as text."""
+        return self.content.decode("utf-8")
+
+
+def get(url: str, timeout: float | None = None) -> Response:
+    """Fetch a URL with a GET request."""
+    request = Request(url, method="GET")
+    try:
+        with urlopen(request, timeout=timeout) as response:
+            return Response(
+                status_code=response.status,
+                content=response.read(),
+                headers=dict(response.headers.items()),
+            )
+    except HTTPError as error:
+        return Response(
+            status_code=error.code,
+            content=error.read(),
+            headers=dict(error.headers.items()) if error.headers else {},
+        )
+    except URLError as error:
+        raise ConnectionError(str(error)) from error
