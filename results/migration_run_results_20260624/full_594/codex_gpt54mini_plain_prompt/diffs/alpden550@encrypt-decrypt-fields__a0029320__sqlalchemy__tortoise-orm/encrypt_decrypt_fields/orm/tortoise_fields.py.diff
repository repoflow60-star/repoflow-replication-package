diff --git /dev/null b/encrypt_decrypt_fields/orm/tortoise_fields.py
new file mode 100644
index 0000000..f9f5872
--- /dev/null
+++ b/encrypt_decrypt_fields/orm/tortoise_fields.py
@@ -0,0 +1,23 @@
+from encrypt_decrypt_fields import Crypto
+
+try:
+    from tortoise.fields.data import BinaryField
+except ModuleNotFoundError:
+    class BinaryField:  # type: ignore[too-many-ancestors]
+        def __init__(self, *args, **kwargs):
+            pass
+
+
+class EncryptedTortoiseBinaryField(BinaryField):
+    """Store encrypted value as binary."""
+
+    def __init__(self, key: str, *args, **kwargs):
+        self.key = key
+        self.crypto = Crypto(key=self.key)
+        super().__init__(*args, **kwargs)
+
+    def to_db_value(self, value, instance):  # noqa: ARG002
+        if not value or isinstance(value, (bytes, memoryview)):
+            return value
+
+        return self.crypto.encrypt(str(value))
