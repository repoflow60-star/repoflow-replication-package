+"""Client module.
+
+This module houses the main class used to fetch energy usage.
+
+"""
+
+import json
+import re
+from datetime import datetime, timedelta
+from http.cookies import SimpleCookie
+from types import SimpleNamespace
+from urllib.parse import unquote, urlencode
+
+from dateutil.parser import parse
+import urllib3
+
+BASE_USAGE_URL = "https://myaccount.srpnet.com/myaccountapi/api/"
+
+
+class _Response:
+    """Minimal response wrapper compatible with the existing client flow."""
+
+    def __init__(self, response):
+        self._response = response
+        self.status_code = getattr(response, "status", None)
+        self.cookies = self._extract_cookies(response)
+
+    @staticmethod
+    def _extract_cookies(response):
+        cookies = {}
+
+        headers = getattr(response, "headers", None)
+        if headers is None:
+            return cookies
+
+        if hasattr(headers, "getlist"):
+            set_cookie_headers = headers.getlist("Set-Cookie")
+        else:
+            set_cookie_headers = []
+            set_cookie = headers.get("Set-Cookie")
+            if set_cookie:
+                set_cookie_headers = [set_cookie]
+
+        for header_value in set_cookie_headers:
+            jar = SimpleCookie()
+            jar.load(header_value)
+            for key, morsel in jar.items():
+                cookies[key] = morsel.value
+
+        return cookies
+
+    def json(self):
+        """Return the decoded JSON response payload."""
+
+        body = self._response.data
+        if isinstance(body, bytes):
+            body = body.decode("utf-8")
+        return json.loads(body)
+
+
+class Session:
+    """Small urllib3-backed session used by the client."""
+
+    def __init__(self):
+        self._pool = urllib3.PoolManager()
+        self._cookies = {}
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        self.close()
+
+    def close(self):
+        """Release pooled connections."""
+
+        self._pool.clear()
+
+    def get(self, url, headers=None):
+        """Perform a GET request."""
+
+        return self._request("GET", url, headers=headers)
+
+    def post(self, url, data=None, headers=None):
+        """Perform a POST request."""
+
+        encoded_data = urlencode(data or {})
+        request_headers = {"Content-Type": "application/x-www-form-urlencoded"}
+        if headers:
+            request_headers.update(headers)
+
+        return self._request(
+            "POST",
+            url,
+            body=encoded_data.encode("utf-8"),
+            headers=request_headers,
+        )
+
+    def _request(self, method, url, body=None, headers=None):
+        request_headers = {}
+        if headers:
+            request_headers.update(headers)
+
+        if self._cookies:
+            request_headers.setdefault(
+                "Cookie",
+                "; ".join(f"{key}={value}" for key, value in self._cookies.items()),
+            )
+
+        response = self._pool.request(
+            method,
+            url,
+            body=body,
+            headers=request_headers or None,
+            preload_content=True,
+        )
+
+        wrapped_response = _Response(response)
+        self._cookies.update(wrapped_response.cookies)
+        return wrapped_response
+
+
+requests = SimpleNamespace(Session=Session)
 
 
