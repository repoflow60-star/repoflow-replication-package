+from .graph_objects import Figure
+
+
+def make_subplots(rows=1, cols=1, shared_xaxes=False, shared_yaxes=False, subplot_titles=None, **kwargs):
+    layout = {
+        "grid": {
+            "rows": rows,
+            "columns": cols,
+            "shared_xaxes": shared_xaxes,
+            "shared_yaxes": shared_yaxes,
+        }
+    }
+    if subplot_titles is not None:
+        layout["subplot_titles"] = list(subplot_titles)
+    if kwargs:
+        layout.update(kwargs)
+    return Figure(layout=layout)
