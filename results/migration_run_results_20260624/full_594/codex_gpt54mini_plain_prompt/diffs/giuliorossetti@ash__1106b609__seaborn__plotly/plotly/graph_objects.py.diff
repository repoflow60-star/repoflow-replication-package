+from copy import deepcopy
+
+
+class _AttrDict(dict):
+    def __getattr__(self, item):
+        try:
+            value = self[item]
+        except KeyError as exc:
+            raise AttributeError(item) from exc
+        if isinstance(value, dict) and not isinstance(value, _AttrDict):
+            value = _AttrDict(value)
+            self[item] = value
+        return value
+
+    def __setattr__(self, key, value):
+        self[key] = value
+
+
+class _BaseTrace:
+    def __init__(self, **kwargs):
+        self._props = dict(kwargs)
+
+    def to_plotly_json(self):
+        return deepcopy(self._props)
+
+    def to_dict(self):
+        return self.to_plotly_json()
+
+    def __getattr__(self, item):
+        try:
+            return self._props[item]
+        except KeyError as exc:
+            raise AttributeError(item) from exc
+
+    def __setattr__(self, key, value):
+        if key == "_props":
+            super().__setattr__(key, value)
+        else:
+            self._props[key] = value
+
+    def __getitem__(self, item):
+        return self._props[item]
+
+    def get(self, key, default=None):
+        return self._props.get(key, default)
+
+    def __repr__(self):
+        return f"{self.__class__.__name__}({self._props!r})"
+
+
+class Scatter(_BaseTrace):
+    pass
+
+
+class Bar(_BaseTrace):
+    pass
+
+
+class Heatmap(_BaseTrace):
+    pass
+
+
+class Figure:
+    def __init__(self, data=None, layout=None):
+        self.data = list(data) if data is not None else []
+        self.layout = _AttrDict(layout or {})
+
+    def add_trace(self, trace, row=None, col=None):
+        if row is not None or col is not None:
+            trace_props = trace.to_plotly_json()
+            if row is not None:
+                trace_props["row"] = row
+            if col is not None:
+                trace_props["col"] = col
+            trace = trace.__class__(**trace_props)
+        self.data.append(trace)
+        return self
+
+    def update_layout(self, **kwargs):
+        self.layout.update(kwargs)
+        return self
+
+    def update_xaxes(self, **kwargs):
+        self.layout.setdefault("xaxis", _AttrDict()).update(kwargs)
+        return self
+
+    def update_yaxes(self, **kwargs):
+        self.layout.setdefault("yaxis", _AttrDict()).update(kwargs)
+        return self
+
+    def add_hline(self, **kwargs):
+        self.layout.setdefault("shapes", []).append({"type": "line", **kwargs})
+        return self
+
+    def show(self):
+        return self.to_plotly_json()
+
+    def to_plotly_json(self):
+        return {
+            "data": [trace.to_plotly_json() for trace in self.data],
+            "layout": deepcopy(self.layout),
+        }
+
+    def to_dict(self):
+        return self.to_plotly_json()
+
+    def __repr__(self):
+        return f"Figure(data={self.data!r}, layout={self.layout!r})"
