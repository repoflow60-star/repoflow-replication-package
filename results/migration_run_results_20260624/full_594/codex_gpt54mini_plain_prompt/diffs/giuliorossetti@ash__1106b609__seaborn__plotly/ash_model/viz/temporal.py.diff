+def _get_figure(kwargs: Dict[str, Any]) -> go.Figure:
+    figure = kwargs.get("fig") or kwargs.get("figure") or kwargs.get("ax")
+    if hasattr(figure, "add_trace"):
+        return figure
+    return go.Figure()
+
+
+def _trace_style(kwargs: Dict[str, Any]) -> Dict[str, Any]:
+    style: Dict[str, Any] = {}
+    color = kwargs.get("color")
+    if color is not None:
+        style["line"] = {"color": color}
+    if "line_color" in kwargs:
+        style.setdefault("line", {})["color"] = kwargs["line_color"]
+    if "marker_color" in kwargs:
+        style.setdefault("marker", {})["color"] = kwargs["marker_color"]
+    line = kwargs.get("line")
+    if isinstance(line, dict):
+        style["line"] = {**style.get("line", {}), **line}
+    if "marker_symbol" in kwargs:
+        style.setdefault("marker", {})["symbol"] = kwargs["marker_symbol"]
+    for key in ("opacity", "name", "legendgroup", "hovertemplate"):
+        if key in kwargs:
+            style[key] = kwargs[key]
+    if "line_dash" in kwargs:
+        style.setdefault("line", {})["dash"] = kwargs["line_dash"]
+    if "line_width" in kwargs:
+        style.setdefault("line", {})["width"] = kwargs["line_width"]
+    return style
