@@ -0,0 +1,139 @@
+from __future__ import annotations
+
+import json
+import ssl
+import urllib.error
+import urllib.parse
+import urllib.request
+from dataclasses import dataclass
+from typing import Any, Mapping
+
+
+def _coerce_bytes(data: Any) -> bytes | None:
+    if data is None:
+        return None
+    if isinstance(data, bytes):
+        return data
+    if isinstance(data, bytearray):
+        return bytes(data)
+    if isinstance(data, memoryview):
+        return data.tobytes()
+    if isinstance(data, str):
+        return data.encode('utf-8')
+    if isinstance(data, Mapping):
+        return urllib.parse.urlencode(data).encode('utf-8')
+    if isinstance(data, (list, tuple)):
+        return urllib.parse.urlencode(data).encode('utf-8')
+    return bytes(data)
+
+
+def _build_opener(proxies: Mapping[str, str] | None, verify: bool) -> urllib.request.OpenerDirector:
+    handlers: list[Any] = []
+
+    if proxies:
+        supported_proxies = {
+            key: value for key, value in proxies.items()
+            if not str(value).lower().startswith('socks')
+        }
+        if supported_proxies:
+            handlers.append(urllib.request.ProxyHandler(supported_proxies))
+
+    if not verify:
+        context = ssl._create_unverified_context()
+        handlers.append(urllib.request.HTTPSHandler(context=context))
+
+    return urllib.request.build_opener(*handlers)
+
+
+def _response_headers(message: Any) -> dict[str, str]:
+    if message is None:
+        return {}
+    if hasattr(message, 'items'):
+        return {str(k): str(v) for k, v in message.items()}
+    return dict(message)
+
+
+@dataclass
+class Response:
+    url: str
+    status_code: int
+    reason: str
+    headers: dict[str, str]
+    _body: bytes
+
+    @property
+    def code(self) -> int:
+        return self.status_code
+
+    def raise_for_status(self) -> None:
+        if 400 <= self.status_code:
+            raise HTTPError(
+                self.status_code,
+                self.reason or 'HTTP error',
+                self.url,
+            )
+
+    def content(self) -> bytes:
+        return self._body
+
+    def text(self, encoding: str = 'utf-8') -> str:
+        return self._body.decode(encoding, errors='replace')
+
+    def json(self, **kwargs: Any) -> Any:
+        return json.loads(self.text(), **kwargs)
+
+
+class HTTPError(Exception):
+    def __init__(self, status_code: int, reason: str, url: str) -> None:
+        super().__init__(f'{status_code} {reason} for url: {url}')
+        self.status_code = status_code
+        self.reason = reason
+        self.url = url
+
+
+def request(
+    method: str,
+    url: str,
+    *,
+    data: Any = None,
+    headers: Mapping[str, str] | None = None,
+    verify: bool = True,
+    proxies: Mapping[str, str] | None = None,
+    timeout: float | None = None,
+    **kwargs: Any,
+) -> Response:
+    body = _coerce_bytes(data)
+    req = urllib.request.Request(url, data=body, method=method.upper())
+
+    for key, value in (headers or {}).items():
+        req.add_header(str(key), str(value))
+
+    opener = _build_opener(proxies, verify)
+
+    try:
+        with opener.open(req, timeout=timeout) as resp:
+            body_bytes = resp.read()
+            return Response(
+                url=resp.geturl(),
+                status_code=resp.getcode() or 0,
+                reason=getattr(resp, 'reason', ''),
+                headers=_response_headers(resp.headers),
+                _body=body_bytes,
+            )
+    except urllib.error.HTTPError as exc:
+        body_bytes = exc.read() if exc.fp is not None else b''
+        return Response(
+            url=exc.geturl() or url,
+            status_code=exc.code or 0,
+            reason=getattr(exc, 'reason', ''),
+            headers=_response_headers(exc.headers),
+            _body=body_bytes,
+        )
+
+
+def get(url: str, **kwargs: Any) -> Response:
+    return request('GET', url, **kwargs)
+
+
+def post(url: str, data: Any = None, **kwargs: Any) -> Response:
+    return request('POST', url, data=data, **kwargs)
