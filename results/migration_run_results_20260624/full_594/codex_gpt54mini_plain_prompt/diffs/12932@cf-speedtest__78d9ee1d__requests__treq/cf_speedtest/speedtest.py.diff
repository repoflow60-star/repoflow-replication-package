+
+def _response_content(response) -> bytes:
+    content = getattr(response, 'content', None)
+    if callable(content):
+        content = content()
+    if isinstance(content, (bytes, bytearray, memoryview)):
+        return bytes(content)
+    fallback = getattr(response, '_body', None)
+    if isinstance(fallback, (bytes, bytearray, memoryview)):
+        return bytes(fallback)
+    return b''
+
+
+def _response_text(response) -> str:
+    text = getattr(response, 'text', None)
+    if callable(text):
+        text = text()
+    if isinstance(text, str):
+        return text
+    fallback = getattr(response, '_body', None)
+    if isinstance(fallback, (bytes, bytearray, memoryview)):
+        return bytes(fallback).decode('utf-8', errors='replace')
+    return ''
+
+
+def _response_header(response, name: str):
+    headers = getattr(response, 'headers', {})
+    if hasattr(headers, 'get'):
+        value = headers.get(name)
+        if value is None:
+            value = headers.get(name.lower())
+        if value is None:
+            value = headers.get(name.upper())
+        return value
+    return None
+
