+from urllib3 import PoolManager
+from urllib3.exceptions import HTTPError as ConnectionError
+
+
+class Session:
+    def __init__(self):
+        self.headers = {}
+        self._pool = PoolManager()
+
+    def get(self, url):
+        return self._pool.request('GET', url, headers=self.headers)
