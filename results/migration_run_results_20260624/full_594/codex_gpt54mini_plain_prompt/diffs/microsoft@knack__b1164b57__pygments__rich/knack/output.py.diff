+def _format_colorized_text(text, lexer_name):
+    try:
+        from rich.console import Console
+        from rich.syntax import Syntax
+    except ImportError:
+        return text
+
+    output = StringIO()
+    console = Console(file=output, force_terminal=True, color_system='standard', legacy_windows=False)
+    console.print(Syntax(text, lexer_name, theme='monokai', word_wrap=False), end='')
+
+    colored_text = output.getvalue()
+    if text.endswith('\n') and not colored_text.endswith('\n'):
+        colored_text += '\n'
+    return colored_text
+
