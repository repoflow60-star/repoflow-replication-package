@@ -0,0 +1,106 @@
+from __future__ import annotations
+
+import argparse
+import sys
+from typing import Callable
+
+from bamboo.blueprints.command import create_admin as _create_admin
+from bamboo.blueprints.command import create_tables as _create_tables
+from bamboo.blueprints.command import drop_tables as _drop_tables
+
+try:
+    import plac
+except ImportError:  # pragma: no cover - exercised when plac is unavailable.
+    plac = None
+
+
+def _annotations(**kwargs):
+    if plac is None:
+        def decorator(func: Callable[..., object]) -> Callable[..., object]:
+            return func
+
+        return decorator
+    return plac.annotations(**kwargs)
+
+
+def create_tables() -> None:
+    """Create all tables."""
+    _create_tables()
+
+
+def drop_tables() -> None:
+    """Drop all tables."""
+    _drop_tables()
+
+
+@_annotations(
+    username=("Admin username", "option"),
+    password=("Admin password", "option"),
+    name=("Admin full name", "option"),
+    email=("Admin email", "option"),
+)
+def create_admin(
+    username: str | None = None,
+    password: str | None = None,
+    name: str | None = None,
+    email: str | None = None,
+) -> None:
+    """Create admin user."""
+    _create_admin(username=username, password=password, name=name, email=email)
+
+
+_COMMANDS: dict[str, Callable[..., object]] = {
+    "create-tables": create_tables,
+    "drop-tables": drop_tables,
+    "create-admin": create_admin,
+}
+
+commands = tuple(_COMMANDS)
+main = sys.modules[__name__]
+
+
+def __getattr__(name: str) -> Callable[..., object]:
+    if name in _COMMANDS:
+        return _COMMANDS[name]
+    raise AttributeError(name)
+
+
+def _build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(prog="python manage.py")
+    subparsers = parser.add_subparsers(dest="command", required=True)
+
+    subparsers.add_parser("create-tables", help="Create all tables.")
+    subparsers.add_parser("drop-tables", help="Drop all tables.")
+
+    create_admin_parser = subparsers.add_parser("create-admin", help="Create admin user.")
+    create_admin_parser.add_argument("--username")
+    create_admin_parser.add_argument("--password")
+    create_admin_parser.add_argument("--name")
+    create_admin_parser.add_argument("--email")
+
+    return parser
+
+
+def run(argv: list[str] | None = None) -> int:
+    if plac is not None and argv is None:
+        plac.call(main)
+        return 0
+
+    parser = _build_parser()
+    args = parser.parse_args(argv)
+
+    command = _COMMANDS[args.command]
+    if args.command == "create-admin":
+        command(
+            username=args.username,
+            password=args.password,
+            name=args.name,
+            email=args.email,
+        )
+    else:
+        command()
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(run())
