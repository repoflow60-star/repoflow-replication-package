+def _prompt(label: str, value: str | None) -> str:
+    if value is not None:
+        return value
+    return input(f"{label}: ")
+
+
+def _prompt_secret(label: str, value: str | None) -> str:
+    if value is not None:
+        return value
+
+    while True:
+        password = getpass(f"{label}: ")
+        confirmation = getpass(f"Confirm {label.lower()}: ")
+        if password == confirmation:
+            return password
+        print("Passwords do not match. Try again.")
