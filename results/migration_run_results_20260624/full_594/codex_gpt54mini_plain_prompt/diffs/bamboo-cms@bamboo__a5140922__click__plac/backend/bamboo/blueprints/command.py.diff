+@lru_cache(maxsize=1)
+def _app() -> APIFlask:
+    config_name = os.getenv("FLASK_CONFIG", "development")
+    app = APIFlask("bamboo")
+    app.config.from_object(config[config_name])
+
+    from bamboo.database import init_app as init_database
+
+    init_database(app)
+    return app
+
+
+def _app_context():
+    return _app().app_context()
+
