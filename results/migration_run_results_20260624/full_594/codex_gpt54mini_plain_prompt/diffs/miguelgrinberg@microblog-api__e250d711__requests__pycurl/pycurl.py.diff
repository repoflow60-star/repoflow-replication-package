+++ b/pycurl.py
@@ -0,0 +1,62 @@
+from __future__ import annotations
+
+from urllib.error import HTTPError
+from urllib.request import Request, urlopen
+
+URL = 1
+WRITEDATA = 2
+FOLLOWLOCATION = 3
+HTTPHEADER = 4
+POST = 5
+POSTFIELDS = 6
+RESPONSE_CODE = 7
+
+
+class error(Exception):
+    pass
+
+
+class Curl:
+    def __init__(self):
+        self._opts = {}
+        self._response_code = None
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        self.close()
+
+    def setopt(self, option, value):
+        self._opts[option] = value
+
+    def perform(self):
+        url = self._opts.get(URL)
+        if not url:
+            raise error('URL not set')
+        method = 'POST' if self._opts.get(POST) else 'GET'
+        headers = {}
+        for header in self._opts.get(HTTPHEADER, []) or []:
+            name, _, value = header.partition(':')
+            headers[name.strip()] = value.strip()
+        data = self._opts.get(POSTFIELDS)
+        if data is not None and not isinstance(data, (bytes, bytearray)):
+            data = str(data).encode('utf-8')
+        request = Request(url, data=data if method == 'POST' else None,
+                          headers=headers, method=method)
+        try:
+            response = urlopen(request)
+        except HTTPError as exc:
+            response = exc
+        self._response_code = response.getcode()
+        writer = self._opts.get(WRITEDATA)
+        if writer is not None:
+            writer.write(response.read())
+
+    def getinfo(self, info):
+        if info != RESPONSE_CODE:
+            raise error(f'Unsupported info option: {info}')
+        return self._response_code
+
+    def close(self):
+        return None
