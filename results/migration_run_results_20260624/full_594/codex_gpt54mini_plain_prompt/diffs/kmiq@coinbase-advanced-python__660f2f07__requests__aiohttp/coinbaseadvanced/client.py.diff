+class _AiohttpResponse:
+    """
+    Lightweight response adapter exposing the subset of the requests API
+    consumed by the model layer.
+    """
+
+    def __init__(self, status: int, text: str, headers: Optional[dict] = None) -> None:
+        self.status_code = status
+        self.text = text
+        self.headers = headers or {}
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status_code < 400
+
+    def json(self):
+        return json.loads(self.text)
+
+
+class _AiohttpRequestsShim:
+    """
+    requests-like shim backed by aiohttp.
+
+    The client continues to call `requests.get/post/...` so existing tests that
+    patch those symbols still work, while the implementation uses aiohttp under
+    the hood.
+    """
+
+    def _request(self, method: str, url: str, *, headers: dict, timeout: int,
+                 json_payload=None) -> _AiohttpResponse:
+        async def _call():
+            client_timeout = aiohttp.ClientTimeout(total=timeout)
+            async with aiohttp.ClientSession(timeout=client_timeout) as session:
+                async with session.request(
+                    method,
+                    url,
+                    headers=headers,
+                    json=json_payload,
+                ) as response:
+                    text = await response.text()
+                    return _AiohttpResponse(response.status, text, dict(response.headers))
+
+        return asyncio.run(_call())
+
+    def get(self, url, headers=None, timeout=None):
+        return self._request("GET", url, headers=headers or {}, timeout=timeout or 10)
+
+    def post(self, url, json=None, headers=None, timeout=None):
+        return self._request("POST", url, headers=headers or {}, timeout=timeout or 10,
+                             json_payload=json)
+
+    def put(self, url, json=None, headers=None, timeout=None):
+        return self._request("PUT", url, headers=headers or {}, timeout=timeout or 10,
+                             json_payload=json)
+
+    def delete(self, url, json=None, headers=None, timeout=None):
+        return self._request("DELETE", url, headers=headers or {}, timeout=timeout or 10,
+                             json_payload=json)
+
+
+requests = _AiohttpRequestsShim()
