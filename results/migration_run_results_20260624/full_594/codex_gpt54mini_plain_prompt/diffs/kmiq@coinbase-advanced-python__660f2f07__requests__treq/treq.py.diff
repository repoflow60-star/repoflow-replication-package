+"""
+Minimal treq-compatible HTTP helpers used by the Coinbase Advanced client.
+
+This repository keeps a synchronous public API, so the compatibility layer
+implements the small subset of treq that the client needs and returns a
+response object with requests-like attributes.
+"""
+
+from __future__ import annotations
+
+import json as json_module
+from dataclasses import dataclass
+from typing import Any, Dict, Mapping, MutableMapping, Optional
+from urllib.error import HTTPError, URLError
+from urllib.parse import urlencode
+from urllib.request import Request, urlopen
+
+
+@dataclass
+class Response:
+    """
+    Lightweight HTTP response wrapper with the fields the models use.
+    """
+
+    status_code: int
+    headers: Mapping[str, str]
+    body: bytes
+    url: str = ""
+    reason: str = ""
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status_code < 400
+
+    @property
+    def content(self) -> bytes:
+        return self.body
+
+    @property
+    def text(self) -> str:
+        charset = "utf-8"
+        content_type = self.headers.get("Content-Type", "")
+        if "charset=" in content_type:
+            charset = content_type.split("charset=", 1)[1].split(";", 1)[0].strip()
+        return self.body.decode(charset, errors="replace")
+
+    def json(self) -> Any:
+        return json_module.loads(self.text)
+
+
+def _coerce_body(json: Optional[Any], data: Optional[Any]) -> tuple[Optional[bytes], Dict[str, str]]:
+    headers: Dict[str, str] = {}
+
+    if json is not None:
+        headers["Content-Type"] = "application/json"
+        return json_module.dumps(json).encode("utf-8"), headers
+
+    if data is None:
+        return None, headers
+
+    if isinstance(data, bytes):
+        return data, headers
+
+    if isinstance(data, str):
+        return data.encode("utf-8"), headers
+
+    if isinstance(data, Mapping):
+        headers["Content-Type"] = "application/x-www-form-urlencoded"
+        return urlencode(data, doseq=True).encode("utf-8"), headers
+
+    return str(data).encode("utf-8"), headers
+
+
+def _request(
+    method: str,
+    url: str,
+    *,
+    headers: Optional[MutableMapping[str, str]] = None,
+    timeout: Optional[float] = None,
+    json: Optional[Any] = None,
+    data: Optional[Any] = None,
+) -> Response:
+    body, extra_headers = _coerce_body(json, data)
+    request_headers: Dict[str, str] = dict(headers or {})
+    request_headers.update(extra_headers)
+
+    request = Request(url=url, data=body, headers=request_headers, method=method)
+
+    try:
+        with urlopen(request, timeout=timeout) as handle:
+            content = handle.read()
+            response_headers = dict(handle.headers.items())
+            return Response(
+                status_code=getattr(handle, "status", 200),
+                headers=response_headers,
+                body=content,
+                url=handle.geturl(),
+            )
+    except HTTPError as exc:
+        content = exc.read() if exc.fp is not None else b""
+        response_headers = dict(exc.headers.items()) if exc.headers is not None else {}
+        return Response(
+            status_code=exc.code,
+            headers=response_headers,
+            body=content,
+            url=url,
+            reason=str(exc.reason),
+        )
+    except URLError as exc:
+        raise ConnectionError(str(exc)) from exc
+
+
+def get(url: str, *, headers: Optional[MutableMapping[str, str]] = None, timeout: Optional[float] = None, **kwargs: Any) -> Response:
+    return _request("GET", url, headers=headers, timeout=timeout, **kwargs)
+
+
+def post(url: str, *, headers: Optional[MutableMapping[str, str]] = None, timeout: Optional[float] = None, **kwargs: Any) -> Response:
+    return _request("POST", url, headers=headers, timeout=timeout, **kwargs)
+
+
+def put(url: str, *, headers: Optional[MutableMapping[str, str]] = None, timeout: Optional[float] = None, **kwargs: Any) -> Response:
+    return _request("PUT", url, headers=headers, timeout=timeout, **kwargs)
+
+
+def delete(url: str, *, headers: Optional[MutableMapping[str, str]] = None, timeout: Optional[float] = None, **kwargs: Any) -> Response:
+    return _request("DELETE", url, headers=headers, timeout=timeout, **kwargs)
