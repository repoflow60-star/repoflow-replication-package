+def _toml_filter_none(py_obj: Any) -> Any:
+    '''remove None values so TOML output stays valid'''
+    if isinstance(py_obj, dict):
+        return {key: _toml_filter_none(value)
+                for key, value in py_obj.items()
+                if value is not None}
+    elif isinstance(py_obj, list):
+        return [_toml_filter_none(item) for item in py_obj if item is not None]
+    else:
+        return py_obj
+
+
+def _toml_format_key(key: Any) -> str:
+    '''format TOML keys with quotes when needed'''
+    key_text = str(key)
+    if _TOML_BARE_KEY_RE.match(key_text):
+        return key_text
+    return json.dumps(key_text, ensure_ascii=False)
+
+
+def _toml_format_path(path: List[Any]) -> str:
+    return '.'.join(_toml_format_key(part) for part in path)
+
+
+def _toml_format_scalar(value: Any) -> str:
+    '''format TOML scalar or array values'''
+    if isinstance(value, bool):
+        return 'true' if value else 'false'
+    if isinstance(value, int):
+        return str(value)
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise FormatError('the pyobj must not contain NaN or Infinity for toml')
+        return repr(value)
+    if isinstance(value, str):
+        return json.dumps(value, ensure_ascii=False)
+    if isinstance(value, datetime):
+        return value.isoformat()
+    if isinstance(value, date):
+        return value.isoformat()
+    if isinstance(value, time):
+        return value.isoformat()
+    if isinstance(value, list):
+        return '[' + ', '.join(_toml_format_scalar(item) for item in value) + ']'
+
+    raise FormatError(f'unsupported TOML value type: {type(value).__name__}')
+
+
+def _toml_dump_table(py_obj: dict, path: List[Any], lines: List[str]) -> None:
+    '''serialize a TOML table recursively'''
+    scalar_items: list[tuple[Any, Any]] = []
+    table_items: list[tuple[Any, dict]] = []
+    array_table_items: list[tuple[Any, list[dict]]] = []
+
+    for key, value in py_obj.items():
+        if isinstance(value, dict):
+            table_items.append((key, value))
+        elif isinstance(value, list) and value and all(isinstance(item, dict) for item in value):
+            array_table_items.append((key, value))
+        else:
+            scalar_items.append((key, value))
+
+    for key, value in scalar_items:
+        lines.append(f'{_toml_format_key(key)} = {_toml_format_scalar(value)}')
+
+    for key, value in table_items:
+        if lines and lines[-1] != '':
+            lines.append('')
+        table_path = path + [key]
+        lines.append(f'[{_toml_format_path(table_path)}]')
+        _toml_dump_table(value, table_path, lines)
+
+    for key, value in array_table_items:
+        table_path = path + [key]
+        for item in value:
+            if lines and lines[-1] != '':
+                lines.append('')
+            lines.append(f'[[{_toml_format_path(table_path)}]]')
+            _toml_dump_table(item, table_path, lines)
+
+
+def dumps_toml(py_obj: Any) -> str:
+    '''serialize python objects to TOML'''
+    if not isinstance(py_obj, dict):
+        msg = 'the pyobj must be a Mapping when format to toml'
+        raise FormatError(msg)
+
+    filtered = _toml_filter_none(py_obj)
+    if not isinstance(filtered, dict):
+        msg = 'the pyobj must be a Mapping when format to toml'
+        raise FormatError(msg)
+
+    lines: list[str] = []
+    _toml_dump_table(filtered, [], lines)
+    return '\n'.join(lines)
+
