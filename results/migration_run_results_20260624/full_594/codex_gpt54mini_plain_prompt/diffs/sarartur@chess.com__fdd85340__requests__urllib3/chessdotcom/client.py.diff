+class _Urllib3ResponseAdapter:
+    def __init__(self, response) -> None:
+        self.status_code = response.status
+        self.text = response.data.decode("utf-8") if response.data is not None else ""
+        self.headers = dict(response.headers)
+
+
+class _Urllib3RequestsShim:
+    def get(self, url, headers=None, timeout=30, **kwargs):
+        options = dict(_SYNC_REQUEST_OPTIONS)
+        verify = kwargs.pop("verify", options.pop("verify", True))
+
+        # The sync client only uses a small subset of the requests API. Any
+        # unsupported options are intentionally ignored for compatibility.
+        options.pop("verify_ssl", None)
+        options.pop("headers", None)
+
+        pool = urllib3.PoolManager(
+            cert_reqs=ssl.CERT_REQUIRED if verify else ssl.CERT_NONE
+        )
+        response = pool.request(
+            "GET",
+            url,
+            headers=headers or {},
+            timeout=timeout,
+            **kwargs,
+        )
+        return _Urllib3ResponseAdapter(response)
+
+
+requests = _Urllib3RequestsShim()
+
