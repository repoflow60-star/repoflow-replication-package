+"""Lightweight ``treq`` compatibility layer.
+
+This repository historically used ``requests``. The public client still uses a
+``Session`` object with ``get`` and ``post`` methods, so this module provides a
+small synchronous adapter that preserves that API while avoiding the external
+``requests`` dependency.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from http.cookies import SimpleCookie
+from http.cookiejar import CookieJar
+import json
+from typing import Any
+from urllib.error import HTTPError
+from urllib.parse import urlencode, urlsplit, urlunsplit, parse_qsl
+from urllib.request import HTTPCookieProcessor, Request, build_opener
+
+
+def _merge_query_params(url: str, params: dict[str, Any] | None) -> str:
+    """Return ``url`` with ``params`` merged into the query string."""
+
+    if not params:
+        return url
+
+    scheme, netloc, path, query, fragment = urlsplit(url)
+    query_params = list(parse_qsl(query, keep_blank_values=True))
+    query_params.extend((key, str(value)) for key, value in params.items())
+    return urlunsplit((scheme, netloc, path, urlencode(query_params), fragment))
+
+
+def _encode_body(
+    data: Any = None,
+    json_body: Any = None,
+) -> tuple[bytes | None, dict[str, str]]:
+    """Convert request payloads into a byte body and content headers."""
+
+    headers: dict[str, str] = {}
+
+    if json_body is not None:
+        headers["Content-Type"] = "application/json"
+        return json.dumps(json_body).encode("utf-8"), headers
+
+    if data is None:
+        return None, headers
+
+    if isinstance(data, bytes):
+        return data, headers
+
+    if isinstance(data, str):
+        return data.encode("utf-8"), headers
+
+    if isinstance(data, dict):
+        headers["Content-Type"] = "application/x-www-form-urlencoded"
+        return urlencode(data).encode("utf-8"), headers
+
+    return str(data).encode("utf-8"), headers
+
+
+def _extract_cookies(headers: Any, jar: CookieJar) -> dict[str, str]:
+    """Collect cookies from response headers and the session cookie jar."""
+
+    cookies: dict[str, str] = {}
+
+    if headers is not None:
+        for header in headers.get_all("Set-Cookie", []):
+            parsed_cookie = SimpleCookie()
+            parsed_cookie.load(header)
+            for key, morsel in parsed_cookie.items():
+                cookies[key] = morsel.value
+
+    for cookie in jar:
+        cookies[cookie.name] = cookie.value
+
+    return cookies
+
+
+@dataclass
+class Response:
+    """Minimal response object mirroring the parts of ``requests.Response`` used."""
+
+    status_code: int
+    content: bytes
+    headers: Any
+    cookies: dict[str, str]
+
+    def json(self) -> Any:
+        """Parse the response body as JSON."""
+
+        return json.loads(self.content.decode("utf-8"))
+
+    @property
+    def text(self) -> str:
+        """Return the decoded response body."""
+
+        return self.content.decode("utf-8")
+
+
+class Session:
+    """Synchronous session adapter built on top of ``urllib``."""
+
+    def __init__(self):
+        self._cookie_jar = CookieJar()
+        self._opener = build_opener(HTTPCookieProcessor(self._cookie_jar))
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        return False
+
+    def request(self, method, url, data=None, headers=None, params=None, json=None):
+        """Perform an HTTP request."""
+
+        request_headers = dict(headers or {})
+        body, encoded_headers = _encode_body(data=data, json_body=json)
+        request_headers.update(encoded_headers)
+        request_url = _merge_query_params(url, params)
+        request = Request(
+            request_url,
+            data=body,
+            headers=request_headers,
+            method=method.upper(),
+        )
+
+        try:
+            with self._opener.open(request) as response:
+                content = response.read()
+                response_headers = response.headers
+                status_code = response.getcode()
+        except HTTPError as error:
+            content = error.read()
+            response_headers = error.headers
+            status_code = error.code
+
+        return Response(
+            status_code=status_code,
+            content=content,
+            headers=response_headers,
+            cookies=_extract_cookies(response_headers, self._cookie_jar),
+        )
+
+    def get(self, url, **kwargs):
+        """Perform a GET request."""
+
+        return self.request("GET", url, **kwargs)
+
+    def post(self, url, **kwargs):
+        """Perform a POST request."""
+
+        return self.request("POST", url, **kwargs)
+
+
+def request(method, url, **kwargs):
+    """Perform a one-shot HTTP request."""
+
+    with Session() as session:
+        return session.request(method, url, **kwargs)
+
+
+def get(url, **kwargs):
+    """Perform a one-shot GET request."""
+
+    return request("GET", url, **kwargs)
+
+
+def post(url, **kwargs):
+    """Perform a one-shot POST request."""
+
+    return request("POST", url, **kwargs)
