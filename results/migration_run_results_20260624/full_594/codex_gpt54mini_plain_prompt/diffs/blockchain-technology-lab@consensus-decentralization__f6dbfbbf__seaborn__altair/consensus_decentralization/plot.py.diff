+import argparse
+import logging
+import numpy as np
+import consensus_decentralization.helper as hlp
+import colorcet as cc
+import pandas as pd
+
+
+def _get_altair():
+    import altair as alt
+
+    try:
+        alt.data_transformers.disable_max_rows()
+    except Exception:
+        pass
+
+    return alt
+
+
+def _palette(num_colors):
+    base_palette = list(cc.glasbey)
+    return [base_palette[i % len(base_palette)] for i in range(num_colors)]
+
+
+def _save_chart(chart, path, filename):
+    path.mkdir(parents=True, exist_ok=True)
+    chart.save(str(path / filename))
+
+
+def _build_long_form_frame(data, value_name='value'):
+    return data.melt(id_vars=['timeframe'], var_name='series', value_name=value_name).dropna(subset=[value_name])
+
+
+def plot_animated_lines(df, x_label, y_label, filename, path, colors):
+    alt = _get_altair()
+    plot_df = df.copy()
+    plot_df['timeframe'] = pd.to_datetime(plot_df['timeframe'])
+    plot_df['frame'] = range(len(plot_df))
+    long_df = plot_df.melt(id_vars=['timeframe', 'frame'], var_name='series', value_name='value').dropna(subset=['value'])
+    max_frame = int(plot_df['frame'].max()) if len(plot_df) > 0 else 0
+    slider = alt.param(
+        name='Time step',
+        value=max_frame,
+        bind=alt.binding_range(min=0, max=max_frame, step=1)
+    )
+    chart = (
+        alt.Chart(long_df)
+        .add_params(slider)
+        .transform_filter(alt.datum.frame <= slider)
+        .mark_line(point=True)
+        .encode(
+            x=alt.X('timeframe:T', title=x_label, axis=alt.Axis(labelAngle=-45)),
+            y=alt.Y('value:Q', title=y_label),
+            color=alt.Color(
+                'series:N',
+                scale=alt.Scale(domain=list(df.columns[1:]), range=colors),
+                legend=alt.Legend(title=None)
+            ),
+            order=alt.Order('series:N')
+        )
+        .properties(width=700, height=400)
+    )
+    _save_chart(chart, path, f'{filename}.html')
+
+
+def plot_lines(data, x_label, y_label, filename, path, xtick_labels, colors, title=''):
+    alt = _get_altair()
+    plot_df = data.copy()
+    plot_df['timeframe'] = pd.to_datetime(plot_df['timeframe'])
+    long_df = _build_long_form_frame(plot_df)
+    chart = (
+        alt.Chart(long_df)
+        .mark_line(point=True)
+        .encode(
+            x=alt.X('timeframe:T', title=x_label, axis=alt.Axis(labelAngle=-45)),
+            y=alt.Y('value:Q', title=y_label),
+            color=alt.Color(
+                'series:N',
+                scale=alt.Scale(domain=list(data.columns[1:]), range=colors),
+                legend=alt.Legend(title=None)
+            ),
+            order=alt.Order('series:N')
+        )
+        .properties(width=700, height=400)
+    )
+    if title:
+        chart = chart.properties(title=title)
+    _save_chart(chart, path, f'{filename}.html')
+
+
+def _stack_area_frame(values, tick_labels, legend_labels):
+    rows = []
+    for entity_idx, entity_label in enumerate(legend_labels):
+        for frame_idx, tick_label in enumerate(tick_labels):
+            rows.append({
+                'frame': frame_idx,
+                'timeframe': tick_label,
+                'entity': entity_label,
+                'value': values[entity_idx][frame_idx]
+            })
+    return pd.DataFrame(rows)
+
+
+def plot_stack_area_chart(values, execution_id, path, ylabel, legend_labels, tick_labels, legend):
+    """
+
+    :param values: the data to be plotted. numpy array of shape (number of total entities, number of time steps)
+    :param path: the path to save the figure to
+    """
+    alt = _get_altair()
+    long_df = _stack_area_frame(values, tick_labels, legend_labels)
+    palette = _palette(len(legend_labels))
+    visible_legend_labels = [label for label in legend_labels if not label.startswith('_')]
+    legend_encoding = None if not legend or len(visible_legend_labels) == 0 else alt.Legend(title=None, values=visible_legend_labels)
+    chart = (
+        alt.Chart(long_df)
+        .mark_area()
+        .encode(
+            x=alt.X('timeframe:N', title='Time', sort=list(tick_labels)),
+            y=alt.Y('value:Q', title=ylabel, stack='zero'),
+            color=alt.Color(
+                'entity:N',
+                scale=alt.Scale(domain=legend_labels, range=palette),
+                legend=legend_encoding
+            ),
+            order=alt.Order('entity:N')
+        )
+        .properties(width=700, height=400)
+    )
+    _save_chart(chart, path, f'poolDynamics-{execution_id}.html')
+
+
+def plot_animated_stack_area_chart(values, execution_id, path, ylabel, legend_labels, tick_labels, legend):
+    """
+
+    :param values: the data to be plotted. numpy array of shape (number of total entities, number of time steps)
+    :param path: the path to save the figure to
+    """
+    alt = _get_altair()
+    long_df = _stack_area_frame(values, tick_labels, legend_labels)
+    palette = _palette(len(legend_labels))
+    visible_legend_labels = [label for label in legend_labels if not label.startswith('_')]
+    legend_encoding = None if not legend or len(visible_legend_labels) == 0 else alt.Legend(title=None, values=visible_legend_labels)
+    max_frame = len(tick_labels) - 1 if len(tick_labels) > 0 else 0
+    slider = alt.param(
+        name='Time step',
+        value=max_frame,
+        bind=alt.binding_range(min=0, max=max_frame, step=1)
+    )
+    chart = (
+        alt.Chart(long_df)
+        .add_params(slider)
+        .transform_filter(alt.datum.frame <= slider)
+        .mark_area()
+        .encode(
+            x=alt.X('timeframe:N', title='Time', sort=list(tick_labels)),
+            y=alt.Y('value:Q', title=ylabel, stack='zero'),
+            color=alt.Color(
+                'entity:N',
+                scale=alt.Scale(domain=legend_labels, range=palette),
+                legend=legend_encoding
+            ),
+            order=alt.Order('entity:N')
+        )
+        .properties(width=700, height=400)
+    )
+    _save_chart(chart, path, f'poolDynamics-{execution_id}.html')
 
 
