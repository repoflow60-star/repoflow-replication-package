+"""Compatibility alias for the local treq shim.
+
+The existing test suite imports and patches ``requests`` symbols directly, so
+this package forwards that import surface to :mod:`treq` while the application
+code uses ``treq`` explicitly.
+"""
+
+from __future__ import annotations
+
+import sys
+
+import treq as _treq
+
+auth = _treq.auth
+delete = _treq.delete
+get = _treq.get
+post = _treq.post
+put = _treq.put
+request = _treq.request
+Request = _treq.Request
+Response = _treq.Response
+HTTPError = _treq.HTTPError
+JSONDecodeError = _treq.JSONDecodeError
+
+sys.modules[__name__] = _treq
+sys.modules[__name__ + ".auth"] = _treq.auth
