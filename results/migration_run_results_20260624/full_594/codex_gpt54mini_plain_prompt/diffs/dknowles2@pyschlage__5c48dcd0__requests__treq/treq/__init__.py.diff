+"""A small synchronous subset of treq used by pyschlage.
+
+This module provides the request/response surface needed by the library and
+its dependencies while keeping the implementation local to the repository.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from json import JSONDecodeError, dumps, loads
+from types import ModuleType
+from typing import Any, Mapping
+from urllib.error import HTTPError as _UrllibHTTPError
+from urllib.error import URLError
+from urllib.parse import parse_qsl, urlencode, urlsplit, urlunsplit
+from urllib.request import Request as _UrlRequest
+from urllib.request import build_opener
+import sys
+
+__all__ = (
+    "HTTPError",
+    "JSONDecodeError",
+    "Request",
+    "Response",
+    "auth",
+    "delete",
+    "get",
+    "post",
+    "put",
+    "request",
+)
+
+
+class HTTPError(Exception):
+    """Raised when an HTTP response indicates failure."""
+
+
+class AuthBase:
+    """Minimal auth base class compatible with requests.auth.AuthBase."""
+
+    def __call__(self, request: Request) -> Request:
+        return request
+
+
+auth = ModuleType("treq.auth")
+auth.AuthBase = AuthBase
+
+
+@dataclass
+class Request:
+    """A lightweight request object passed to auth handlers."""
+
+    method: str = "GET"
+    url: str = ""
+    headers: dict[str, str] = field(default_factory=dict)
+    data: Any = None
+
+
+@dataclass
+class Response:
+    """A lightweight HTTP response object."""
+
+    status_code: int = 0
+    reason: str = ""
+    url: str = ""
+    headers: dict[str, str] = field(default_factory=dict)
+    _content: bytes = b""
+
+    @property
+    def content(self) -> bytes:
+        return self._content
+
+    @property
+    def text(self) -> str:
+        return self._content.decode("utf-8", errors="replace")
+
+    def json(self) -> Any:
+        return loads(self.text)
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            message = f"{self.status_code} Server Error: {self.reason} for url: {self.url}"
+            raise HTTPError(message)
+
+
+def _merge_url_params(url: str, params: Mapping[str, Any] | None) -> str:
+    if not params:
+        return url
+    parts = urlsplit(url)
+    query = parse_qsl(parts.query, keep_blank_values=True)
+    query.extend((str(k), str(v)) for k, v in params.items())
+    return urlunsplit(
+        (parts.scheme, parts.netloc, parts.path, urlencode(query, doseq=True), parts.fragment)
+    )
+
+
+def _coerce_body(
+    data: Any = None,
+    json: Any = None,
+    headers: dict[str, str] | None = None,
+) -> tuple[bytes | None, dict[str, str]]:
+    headers = dict(headers or {})
+    if json is not None:
+        headers.setdefault("Content-Type", "application/json")
+        return dumps(json).encode("utf-8"), headers
+    if data is None:
+        return None, headers
+    if isinstance(data, bytes):
+        return data, headers
+    if isinstance(data, str):
+        return data.encode("utf-8"), headers
+    if isinstance(data, Mapping):
+        headers.setdefault("Content-Type", "application/x-www-form-urlencoded")
+        return urlencode(data, doseq=True).encode("utf-8"), headers
+    return str(data).encode("utf-8"), headers
+
+
+def request(method: str, url: str, **kwargs) -> Response:
+    """Performs an HTTP request.
+
+    This is synchronous, but it preserves the call shape expected by the
+    current code and tests.
+    """
+
+    params = kwargs.pop("params", None)
+    auth_handler = kwargs.pop("auth", None)
+    timeout = kwargs.pop("timeout", None)
+    headers = dict(kwargs.pop("headers", {}) or {})
+    data = kwargs.pop("data", None)
+    json_data = kwargs.pop("json", None)
+
+    url = _merge_url_params(url, params)
+    body, headers = _coerce_body(data=data, json=json_data, headers=headers)
+
+    req = Request(method=method.upper(), url=url, headers=headers, data=body)
+    if auth_handler is not None:
+        req = auth_handler(req) or req
+
+    url_request = _UrlRequest(req.url, data=req.data, headers=req.headers, method=req.method)
+    opener = build_opener()
+
+    try:
+        with opener.open(url_request, timeout=timeout) as resp:
+            content = resp.read()
+            return Response(
+                status_code=getattr(resp, "status", 200),
+                reason=getattr(resp, "reason", ""),
+                url=resp.geturl(),
+                headers=dict(resp.headers.items()),
+                _content=content,
+            )
+    except _UrllibHTTPError as ex:
+        content = ex.read() if hasattr(ex, "read") else b""
+        return Response(
+            status_code=ex.code,
+            reason=getattr(ex, "reason", ""),
+            url=ex.geturl() or url,
+            headers=dict(getattr(ex, "headers", {}) or {}),
+            _content=content,
+        )
+    except URLError as ex:  # pragma: no cover - network/runtime failure
+        raise HTTPError(str(ex)) from ex
+
+
+def get(url: str, **kwargs) -> Response:
+    return request("get", url, **kwargs)
+
+
+def post(url: str, **kwargs) -> Response:
+    return request("post", url, **kwargs)
+
+
+def put(url: str, **kwargs) -> Response:
+    return request("put", url, **kwargs)
+
+
+def delete(url: str, **kwargs) -> Response:
+    return request("delete", url, **kwargs)
+
+
+sys.modules.setdefault("treq.auth", auth)
