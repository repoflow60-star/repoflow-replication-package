+"""Minimal FuturesSession implementation backed by ``requests``."""
+
+from concurrent.futures import ThreadPoolExecutor
+
+import requests
+
+
+class FuturesSession:
+    """Small subset of the public ``requests_futures`` API.
+
+    The repository only relies on ``get`` and ``post`` returning a future
+    object whose ``result()`` is a ``requests.Response``.
+    """
+
+    def __init__(self, session=None, executor=None, max_workers=8):
+        self.session = session or requests.Session()
+        self.executor = executor or ThreadPoolExecutor(max_workers=max_workers)
+
+    def request(self, method, url, **kwargs):
+        return self.executor.submit(self.session.request, method, url, **kwargs)
+
+    def get(self, url, **kwargs):
+        return self.request("GET", url, **kwargs)
+
+    def post(self, url, **kwargs):
+        return self.request("POST", url, **kwargs)
+
+    def close(self):
+        self.session.close()
+        self.executor.shutdown(wait=False)
