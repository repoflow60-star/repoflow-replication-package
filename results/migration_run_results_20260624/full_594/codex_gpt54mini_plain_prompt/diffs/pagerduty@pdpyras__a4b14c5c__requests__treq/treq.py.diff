+"""Compatibility shim for the treq API used by pdpyras.
+
+This repository now imports :mod:`treq` instead of :mod:`requests` directly,
+but the code path exercised here is still synchronous. The shim keeps the
+runtime surface small and stable while preserving the existing Session/Response
+contract expected by the library and tests.
+"""
+
+from requests import Response, Session, __version__
+from requests.exceptions import RequestException
+
+__all__ = [
+    "Response",
+    "RequestException",
+    "Session",
+    "__version__",
+    "request",
+    "get",
+    "post",
+    "put",
+    "delete",
+]
+
+
+def request(method, url, **kwargs):
+    return Session().request(method, url, **kwargs)
+
+
+def get(url, **kwargs):
+    return request("GET", url, **kwargs)
+
+
+def post(url, **kwargs):
+    return request("POST", url, **kwargs)
+
+
+def put(url, **kwargs):
+    return request("PUT", url, **kwargs)
+
+
+def delete(url, **kwargs):
+    return request("DELETE", url, **kwargs)
