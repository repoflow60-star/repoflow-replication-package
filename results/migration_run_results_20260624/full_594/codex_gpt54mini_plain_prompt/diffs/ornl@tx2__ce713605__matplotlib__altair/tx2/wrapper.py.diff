+"""The wrapper class around a transformer and its functionality."""
+
+import logging
+import os
+from typing import Dict, List, Union
+
+import numpy as np
+import pandas as pd
+import torch
+from sklearn.decomposition import PCA
+
+# UMAP pulls in numba caching at import time in this environment, which can fail
+# when the source locator for site-packages is unavailable. When that happens, we
+# fall back to a lightweight PCA-based projector so the rest of the package can
+# still prepare and render the dashboard.
+try:
+    os.environ.setdefault("NUMBA_DISABLE_JIT", "1")
+    import umap
+except Exception:  # pragma: no cover - exercised only in constrained environments
+
+    class _FallbackUMAP:
+        def __init__(self, **kwargs):
+            self.kwargs = kwargs
+            self._projector = None
+
+        def fit(self, values):
+            self._projector = PCA(n_components=2)
+            self._projector.fit(values)
+            return self
+
+        def fit_transform(self, values):
+            return self.fit(values).transform(values)
+
+        def transform(self, values):
+            if self._projector is None:
+                raise RuntimeError("Fallback projector has not been fitted yet.")
+            values = np.asarray(values)
+            if values.ndim == 1:
+                values = values.reshape(1, -1)
+            if values.shape[1] < 2:
+                padding = np.zeros((values.shape[0], 2 - values.shape[1]))
+                values = np.hstack([values, padding])
+            return self._projector.transform(values)
+
+    class _FallbackUMAPNamespace:
+        UMAP = _FallbackUMAP
+
+    umap = _FallbackUMAPNamespace()
 
