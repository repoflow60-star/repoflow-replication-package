+def _build_embedding_chart(text: str, dashboard, prediction=None):
+    testing_embeddings = np.array(dashboard.transformer_wrapper.projections_testing)
+    testing_labels = np.array(dashboard.transformer_wrapper.test_labels)
+    testing_predictions = np.array(dashboard.transformer_wrapper.predictions)
+    label_lookup = {
+        int(value): key for key, value in dashboard.transformer_wrapper.encodings.items()
+    }
+    testing_df = _point_dataframe(
+        testing_embeddings,
+        dashboard.colors,
+        labels=testing_labels,
+        label_lookup=label_lookup,
+        indices=list(range(len(testing_embeddings))),
+        predictions=testing_predictions,
+    )
+    testing_df["correct"] = testing_df["prediction"] == testing_df["category"]
+
+    layers = []
+
+    if not dashboard.chk_focus_errors.value:
+        layers.append(_scatter_layer(testing_df, dashboard, opacity=0.8, size=dashboard.point_size))
+    else:
+        incorrect_df = testing_df[~testing_df.correct]
+        correct_df = testing_df[testing_df.correct]
+        layers.append(_scatter_layer(incorrect_df, dashboard, opacity=0.8, size=dashboard.point_size))
+        layers.append(
+            _scatter_layer(
+                correct_df, dashboard, opacity=0.1, size=dashboard.unfocused_point_size
+            )
+        )
+
+    if dashboard.chk_show_train.value:
+        training_embeddings = np.array(dashboard.transformer_wrapper.projections_training)
+        training_labels = np.array(dashboard.transformer_wrapper.train_labels)
+        training_df = _point_dataframe(
+            training_embeddings,
+            dashboard.colors,
+            labels=training_labels,
+            label_lookup=label_lookup,
+            indices=list(range(len(training_embeddings))),
+        )
+        layers.append(
+            _scatter_layer(
+                training_df, dashboard, opacity=0.1, size=dashboard.unfocused_point_size
+            )
+        )
+
+    if len(dashboard.highlight_indices) > 0:
+        highlight_df = testing_df[testing_df["index"].isin(dashboard.highlight_indices)]
+        layers.append(
+            _highlight_layer(
+                highlight_df, dashboard, size=dashboard.highlighted_point_size, stroke="red"
+            )
+        )
+
+    if dashboard.prior_reference_point is not None:
+        layers.append(
+            _reference_point_layer(
+                dashboard.prior_reference_point[0][0],
+                dashboard.prior_reference_point[0][1],
+                dashboard.prior_reference_point[1],
+                dashboard.highlighted_point_size,
+            )
+        )
+
+    if dashboard.prior_reference_point is None or dashboard.prior_reference_text != text:
+        text_projection = dashboard.transformer_wrapper.project([text])[0]
+        if prediction is None:
+            classification = dashboard.transformer_wrapper.classify([text])[0]
+            pred_color = dashboard.colors[classification]
+        else:
+            pred_color = dashboard.colors[prediction]
+        layers.append(
+            _reference_point_layer(
+                text_projection[0],
+                text_projection[1],
+                pred_color,
+                dashboard.highlighted_point_size,
+            )
+        )
+
+        if dashboard.prior_reference_point is not None and dashboard.prior_reference_text != text:
+            previous = dashboard.prior_reference_point[0]
+            arrow_frame = pd.DataFrame(
+                {
+                    "x": [previous[0]],
+                    "y": [previous[1]],
+                    "x2": [text_projection[0]],
+                    "y2": [text_projection[1]],
+                }
+            )
+            layers.append(
+                alt.Chart(arrow_frame)
+                .mark_rule(color="black")
+                .encode(x="x:Q", y="y:Q", x2="x2:Q", y2="y2:Q")
+            )
+
+    if dashboard.chk_show_cluster_labels.value:
+        cluster_layer = _cluster_labels_layer(dashboard.transformer_wrapper.cluster_labels)
+        if cluster_layer is not None:
+            layers.append(cluster_layer)
+
+    chart = alt.layer(*[layer for layer in layers if layer is not None]).properties(
+        width=800, height=600, title="UMAP Embedding Graph"
+    )
+
+    if hasattr(chart, "interactive"):
+        chart = chart.interactive()
+    return chart
+
