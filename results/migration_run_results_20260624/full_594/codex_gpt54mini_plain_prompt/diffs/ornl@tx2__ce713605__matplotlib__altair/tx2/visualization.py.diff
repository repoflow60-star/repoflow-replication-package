+
+def _cluster_stacked_chart(
+    cluster: str,
+    cluster_words_classified: Dict[str, Dict[str, Dict[str, int]]],
+    encodings: Dict[str, int],
+    colors: List[str],
+):
+    words = list(cluster_words_classified.get(cluster, {}).keys())[:10]
+    if len(words) == 0:
+        frame = pd.DataFrame({"message": ["No data"]})
+        return alt.Chart(frame).mark_text().encode(text="message:N").properties(
+            title=str(cluster)
+        )
+
+    rows = []
+    ordered_labels = _sorted_encoding_labels(encodings)
+    for rank, word in enumerate(words):
+        word_freq = cluster_words_classified[cluster][word]
+        for label in ordered_labels:
+            class_index = encodings[label]
+            rows.append(
+                {
+                    "cluster": str(cluster),
+                    "word": word[:20],
+                    "count": int(word_freq.get(str(class_index), 0)),
+                    "class": label,
+                    "rank": rank,
+                }
+            )
+
+    color_scale = alt.Scale(domain=ordered_labels, range=colors[: len(ordered_labels)])
+
+    return (
+        alt.Chart(pd.DataFrame(rows))
+        .mark_bar()
+        .encode(
+            y=alt.Y(
+                "word:N",
+                sort=alt.SortField(field="rank", order="ascending"),
+                title=None,
+            ),
+            x=alt.X("count:Q", title="Count"),
+            color=alt.Color("class:N", scale=color_scale, legend=alt.Legend(title="Class")),
+            tooltip=["word:N", "class:N", "count:Q"],
+        )
+        .properties(title=str(cluster), width=220, height=max(100, 18 * len(words)))
+    )
+
