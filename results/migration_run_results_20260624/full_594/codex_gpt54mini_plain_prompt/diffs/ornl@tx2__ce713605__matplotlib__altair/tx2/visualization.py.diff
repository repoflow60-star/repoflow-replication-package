+def _point_dataframe(
+    embeddings: np.ndarray,
+    colors: List[str],
+    labels: Union[np.ndarray, pd.Series] = None,
+    label_lookup: Dict[int, str] = None,
+    indices: List[int] = None,
+    predictions: Union[np.ndarray, pd.Series] = None,
+):
+    if len(embeddings) == 0:
+        return pd.DataFrame(columns=["x", "y", "category", "index"])
+
+    frame = pd.DataFrame(
+        {
+            "x": embeddings[:, 0],
+            "y": embeddings[:, 1],
+            "index": list(range(len(embeddings))) if indices is None else indices,
+        }
+    )
+    if labels is None:
+        frame["category"] = [0] * len(frame)
+    else:
+        frame["category"] = list(labels)
+        if label_lookup is not None:
+            frame["label"] = [label_lookup[int(item)] for item in frame["category"]]
+    if predictions is not None:
+        frame["prediction"] = list(predictions)
+    frame["color"] = [colors[int(item)] for item in frame["category"]]
+    return frame
+
+
+def _scatter_layer(frame: pd.DataFrame, dashboard, opacity: float, size: int):
+    if len(frame) == 0:
+        return None
+
+    color_scale = alt.Scale(
+        domain=_sorted_encoding_labels(dashboard.transformer_wrapper.encodings),
+        range=dashboard.colors[: len(dashboard.transformer_wrapper.encodings)],
+    )
+    return (
+        alt.Chart(frame)
+        .mark_circle(opacity=opacity, size=size)
+        .encode(
+            x=alt.X("x:Q", title=None),
+            y=alt.Y("y:Q", title=None),
+            color=alt.Color(
+                "label:N",
+                scale=color_scale,
+                legend=alt.Legend(title="Class"),
+            ),
+            tooltip=["index:Q", "label:N"],
+        )
+    )
+
+
+def _highlight_layer(frame: pd.DataFrame, dashboard, size: int, stroke: str):
+    if len(frame) == 0:
+        return None
+    color_scale = alt.Scale(
+        domain=_sorted_encoding_labels(dashboard.transformer_wrapper.encodings),
+        range=dashboard.colors[: len(dashboard.transformer_wrapper.encodings)],
+    )
+    return (
+        alt.Chart(frame)
+        .mark_circle(size=size, stroke=stroke, strokeWidth=2)
+        .encode(
+            x=alt.X("x:Q", title=None),
+            y=alt.Y("y:Q", title=None),
+            color=alt.Color("label:N", scale=color_scale, legend=None),
+            tooltip=["index:Q", "label:N"],
+        )
+    )
+
+
+def _reference_point_layer(x: float, y: float, color: str, size: int):
+    frame = pd.DataFrame({"x": [x], "y": [y]})
+    return (
+        alt.Chart(frame)
+        .mark_circle(size=size, stroke="black", strokeWidth=2, color=color)
+        .encode(
+            x=alt.X("x:Q", title=None),
+            y=alt.Y("y:Q", title=None),
+        )
+    )
+
+
+def _cluster_labels_layer(cluster_labels):
+    if len(cluster_labels) == 0:
+        return None
+    frame = pd.DataFrame(cluster_labels, columns=["x", "y", "label"])
+    return (
+        alt.Chart(frame)
+        .mark_text(dx=0, dy=-8, fontSize=11, color="#111")
+        .encode(x="x:Q", y="y:Q", text="label:N")
+    )
