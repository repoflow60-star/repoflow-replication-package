+def _cluster_bar_chart(cluster: str, freq: List[Any]):
+    if len(freq) == 0:
+        frame = pd.DataFrame({"message": ["No data"]})
+        return alt.Chart(frame).mark_text().encode(text="message:N").properties(
+            title=str(cluster)
+        )
+
+    frame = pd.DataFrame(
+        {
+            "word": [item[0][:20] for item in freq[:10]],
+            "value": [item[1] for item in freq[:10]],
+            "rank": list(range(min(10, len(freq)))),
+            "cluster": [str(cluster)] * min(10, len(freq)),
+        }
+    )
+    return (
+        alt.Chart(frame)
+        .mark_bar(color="#1f77b4")
+        .encode(
+            y=alt.Y(
+                "word:N",
+                sort=alt.SortField(field="rank", order="ascending"),
+                title=None,
+            ),
+            x=alt.X("value:Q", title="Count"),
+            tooltip=["word:N", "value:Q"],
+        )
+        .properties(title=str(cluster), width=220, height=max(100, 18 * len(frame)))
+    )
