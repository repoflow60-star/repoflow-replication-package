+def _chart_to_html_obj(renderable: Any) -> HTML:
+    if isinstance(renderable, HTML):
+        return renderable
+    if hasattr(renderable, "to_html"):
+        return HTML(renderable.to_html())
+    return HTML(str(renderable))
+
+
+def _renderable_to_widget_outputs(renderable: Any):
+    html_obj = _chart_to_html_obj(renderable)
+    data, metadata = InteractiveShell.instance().display_formatter.format(html_obj)
+    return (
+        {
+            "output_type": "display_data",
+            "data": data,
+            "metadata": metadata,
+        },
+    )
