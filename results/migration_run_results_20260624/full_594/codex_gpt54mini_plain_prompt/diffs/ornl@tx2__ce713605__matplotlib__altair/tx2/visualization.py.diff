+"""Helper functions for constructing visualizations."""
+
+import base64
+import io
+import itertools
+import math
+from html import escape
+from typing import Any, Dict, List, Union
+
+import numpy as np
+import pandas as pd
+from IPython.core.interactiveshell import InteractiveShell
+from IPython.display import HTML
+from sklearn.metrics import confusion_matrix
+from wordcloud import WordCloud
+
+import tx2.wrapper
+from tx2 import STOPWORDS, calc, utils
+
+try:
+    import altair as alt
+except ModuleNotFoundError:  # pragma: no cover - exercised in lightweight environments
+
+    class _FallbackMark:
+        def __init__(self, kind: str, kwargs: Dict[str, Any] = None):
+            self.kind = kind
+            self.kwargs = kwargs or {}
+
+    class _FallbackEncoding:
+        def __init__(self, kind: str, *args, **kwargs):
+            self.kind = kind
+            self.args = args
+            self.kwargs = kwargs
+
+    class _FallbackChart:
+        def __init__(
+            self,
+            data=None,
+            kind: str = "chart",
+            children=None,
+            title: str = None,
+            orientation: str = None,
+        ):
+            self.data = data
+            self.kind = kind
+            self.children = list(children or [])
+            self.title = title
+            self.orientation = orientation
+            self.mark = None
+            self.encoding = {}
+            self.properties_kwargs = {}
+
+        def _clone(self):
+            clone = _FallbackChart(
+                data=self.data,
+                kind=self.kind,
+                children=self.children,
+                title=self.title,
+                orientation=self.orientation,
+            )
+            clone.mark = self.mark
+            clone.encoding = dict(self.encoding)
+            clone.properties_kwargs = dict(self.properties_kwargs)
+            return clone
+
+        def mark_bar(self, **kwargs):
+            self.mark = _FallbackMark("bar", kwargs)
+            return self
+
+        def mark_circle(self, **kwargs):
+            self.mark = _FallbackMark("circle", kwargs)
+            return self
+
+        def mark_rect(self, **kwargs):
+            self.mark = _FallbackMark("rect", kwargs)
+            return self
+
+        def mark_text(self, **kwargs):
+            self.mark = _FallbackMark("text", kwargs)
+            return self
+
+        def mark_rule(self, **kwargs):
+            self.mark = _FallbackMark("rule", kwargs)
+            return self
+
+        def encode(self, **kwargs):
+            self.encoding.update(kwargs)
+            return self
+
+        def properties(self, **kwargs):
+            self.properties_kwargs.update(kwargs)
+            if "title" in kwargs:
+                self.title = kwargs["title"]
+            return self
+
+        def resolve_scale(self, **kwargs):
+            self.properties_kwargs.setdefault("resolve_scale", {}).update(kwargs)
+            return self
+
+        def facet(self, **kwargs):
+            self.properties_kwargs.setdefault("facet", {}).update(kwargs)
+            return self
+
+        def interactive(self):
+            self.properties_kwargs["interactive"] = True
+            return self
+
+        def configure_view(self, **kwargs):
+            self.properties_kwargs.setdefault("view", {}).update(kwargs)
+            return self
+
+        def configure_axis(self, **kwargs):
+            self.properties_kwargs.setdefault("axis", {}).update(kwargs)
+            return self
+
+        def configure_legend(self, **kwargs):
+            self.properties_kwargs.setdefault("legend", {}).update(kwargs)
+            return self
+
+        def to_html(self):
+            if self.kind == "concat":
+                heading = f"<h3>{escape(str(self.title))}</h3>" if self.title else ""
+                body = "".join(child.to_html() for child in self.children)
+                direction = "column" if self.orientation == "v" else "row"
+                return (
+                    f"{heading}<div style='display:flex; flex-direction:{direction}; "
+                    f"gap: 12px; align-items:flex-start;'>{body}</div>"
+                )
+
+            heading = f"<h3>{escape(str(self.title))}</h3>" if self.title else ""
+            if isinstance(self.data, pd.DataFrame):
+                preview = self.data.head(20).to_html(index=False)
+            elif self.data is None:
+                preview = "<em>No data</em>"
+            else:
+                preview = f"<pre>{escape(str(self.data))}</pre>"
+
+            mark = self.mark.kind if self.mark is not None else "chart"
+            return (
+                f"<div style='border:1px solid #ddd; padding: 8px; margin: 4px; "
+                f"border-radius: 6px; background: white;'>"
+                f"{heading}<div><b>Fallback {escape(mark)}</b></div>{preview}</div>"
+            )
+
+        def save(self, path):
+            with open(path, "w", encoding="utf-8") as outfile:
+                outfile.write(self.to_html())
+
+        def __add__(self, other):
+            return _FallbackAltairNamespace.layer(self, other)
+
+    class _FallbackAltairNamespace:
+        Chart = _FallbackChart
+
+        @staticmethod
+        def layer(*charts):
+            return _FallbackChart(kind="concat", children=list(charts))
+
+        @staticmethod
+        def hconcat(*charts):
+            return _FallbackChart(kind="concat", children=list(charts), orientation="h")
+
+        @staticmethod
+        def vconcat(*charts):
+            return _FallbackChart(kind="concat", children=list(charts), orientation="v")
+
+        @staticmethod
+        def value(value):
+            return value
+
+        @staticmethod
+        def Scale(**kwargs):
+            return kwargs
+
+        @staticmethod
+        def SortField(**kwargs):
+            return kwargs
+
+        @staticmethod
+        def Legend(**kwargs):
+            return kwargs
+
+        @staticmethod
+        def Axis(**kwargs):
+            return kwargs
+
+        @staticmethod
+        def X(*args, **kwargs):
+            return _FallbackEncoding("X", *args, **kwargs)
+
+        @staticmethod
+        def Y(*args, **kwargs):
+            return _FallbackEncoding("Y", *args, **kwargs)
+
+        @staticmethod
+        def Color(*args, **kwargs):
+            return _FallbackEncoding("Color", *args, **kwargs)
+
+        @staticmethod
+        def Text(*args, **kwargs):
+            return _FallbackEncoding("Text", *args, **kwargs)
+
+    alt = _FallbackAltairNamespace()
+
+
+def _sorted_encoding_labels(encodings: Dict[str, int]) -> List[str]:
+    return [key for key, _ in sorted(encodings.items(), key=lambda item: item[1])]
