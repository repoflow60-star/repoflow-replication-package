+class _PlotlyObject:
+    def __init__(self, **kwargs):
+        self._props = {}
+        self._set_props(kwargs)
+
+    def _set_props(self, kwargs):
+        for key, value in kwargs.items():
+            setattr(self, key, value)
+            self._props[key] = value
+
+    def to_dict(self):
+        return dict(self._props)
+
+    def __repr__(self):
+        return f"{self.__class__.__name__}({self._props!r})"
+
+
+class Scatter(_PlotlyObject):
+    pass
+
+
+class Bar(_PlotlyObject):
+    pass
+
+
+class Heatmap(_PlotlyObject):
+    pass
+
+
+class Contour(_PlotlyObject):
+    pass
+
+
+class Figure:
+    def __init__(self, data=None, layout=None):
+        self.data = list(data) if data is not None else []
+        self.layout = dict(layout) if layout is not None else {}
+
+    def add_trace(self, trace, secondary_y=None):
+        if secondary_y is not None:
+            trace.secondary_y = secondary_y
+        self.data.append(trace)
+        return self
+
+    def update_layout(self, **kwargs):
+        self.layout.update(kwargs)
+        return self
+
+    def update_xaxes(self, **kwargs):
+        self.layout.setdefault("xaxis", {}).update(kwargs)
+        return self
+
+    def update_yaxes(self, **kwargs):
+        secondary_y = kwargs.pop("secondary_y", None)
+        key = "yaxis2" if secondary_y else "yaxis"
+        self.layout.setdefault(key, {}).update(kwargs)
+        return self
+
+    def show(self):
+        return self
+
+    def to_dict(self):
+        return {
+            "data": [trace.to_dict() for trace in self.data],
+            "layout": dict(self.layout),
+        }
+
+    def __repr__(self):
+        return f"Figure(data={self.data!r}, layout={self.layout!r})"
