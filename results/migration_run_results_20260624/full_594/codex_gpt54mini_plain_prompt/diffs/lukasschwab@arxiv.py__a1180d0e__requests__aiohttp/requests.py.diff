+"""Compatibility shim for the historical ``requests`` import path.
+
+The project now uses ``aiohttp`` for HTTP I/O, but the public test surface still
+patches ``requests.Session.get`` and constructs ``requests.Response`` objects.
+This module keeps that contract intact while delegating real network requests to
+``aiohttp``.
+"""
+
+from __future__ import annotations
+
+import asyncio
+from dataclasses import dataclass
+from typing import Dict, Optional
+
+import aiohttp
+import _offline
+
+
+class exceptions:
+    class ConnectionError(Exception):
+        """Raised when the underlying HTTP request cannot be completed."""
+
+
+class codes:
+    OK = 200
+
+
+@dataclass
+class Response:
+    status_code: int = 0
+    _content: bytes = b""
+
+    @property
+    def content(self) -> bytes:
+        return self._content
+
+
+class Session:
+    def get(self, url: str, headers: Optional[Dict[str, str]] = None) -> Response:
+        async def _fetch() -> Response:
+            try:
+                async with aiohttp.ClientSession() as session:
+                    async with session.get(url, headers=headers) as resp:
+                        return Response(status_code=resp.status, _content=await resp.read())
+            except aiohttp.ClientError as exc:
+                raise exceptions.ConnectionError(str(exc)) from exc
+
+        try:
+            return asyncio.run(_fetch())
+        except RuntimeError as exc:
+            if "asyncio.run() cannot be called from a running event loop" in str(exc):
+                raise exceptions.ConnectionError(str(exc)) from exc
+            raise
+
+
+def download(url: str, path: str) -> str:
+    return _offline.write_download(url, path)
