+"""Offline fixtures for arXiv API and download URLs."""
+
+from __future__ import annotations
+
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Dict, Iterable, List, Optional
+from urllib.parse import parse_qs, urlparse
+from xml.sax.saxutils import escape
+
+
+_TOTAL_SEARCH_RESULTS = 1000
+_DEFAULT_PUBLISHED = "2024-01-01T00:00:00Z"
+_DEFAULT_UPDATED = "2024-01-02T00:00:00Z"
+
+
+def _as_xml_text(value: str) -> str:
+    return escape(value, {"'": "&apos;", '"': "&quot;"})
+
+
+def _search_entry(index: int, query: str) -> Dict[str, object]:
+    short_id = f"{query.replace(' ', '_')}.{index:05d}v1"
+    title = f"{query.title()} result {index + 1}"
+    return {
+        "entry_id": f"https://arxiv.org/abs/{short_id}",
+        "updated": _DEFAULT_UPDATED,
+        "published": _DEFAULT_PUBLISHED,
+        "title": title,
+        "authors": [f"{query.title()} Author {index + 1}"],
+        "summary": f"Summary for {query} result {index + 1}.",
+        "comment": f"Comment for {query} result {index + 1}.",
+        "journal_ref": f"Journal Ref {index + 1}",
+        "doi": f"10.0000/{query.replace(' ', '_')}.{index + 1}",
+        "primary_category": "cs.AI",
+        "categories": ["cs.AI", "stat.ML"],
+        "pdf_url": f"https://arxiv.org/pdf/{short_id}.pdf",
+    }
+
+
+def _fixture_entry(short_id: str, title: Optional[str], *, published: str = _DEFAULT_PUBLISHED) -> Dict[str, object]:
+    return {
+        "entry_id": f"https://arxiv.org/abs/{short_id}",
+        "updated": _DEFAULT_UPDATED,
+        "published": published,
+        "title": title,
+        "authors": [f"{short_id} Author"],
+        "summary": f"Summary for {short_id}.",
+        "comment": f"Comment for {short_id}.",
+        "journal_ref": f"Journal Ref for {short_id}",
+        "doi": f"10.0000/{short_id.replace('/', '_')}",
+        "primary_category": "cs.AI",
+        "categories": ["cs.AI", "stat.ML"],
+        "pdf_url": f"https://arxiv.org/pdf/{short_id}.pdf",
+    }
+
+
+_ID_FIXTURES: Dict[str, Dict[str, object]] = {
+    "1605.08386v1": _fixture_entry("1605.08386v1", "Heat bath random walks with Markov bases", published="2016-05-26T17:59:46Z"),
+    "hep-ex/0406020v1": _fixture_entry("hep-ex/0406020v1", "Sparticle Reconstruction at LHC", published="2004-06-02T00:00:00Z"),
+    "1707.08567v1": _fixture_entry("1707.08567v1", "A result for 1707.08567", published="2017-07-26T00:00:00Z"),
+    "quant-ph/0201082v1": _fixture_entry("quant-ph/0201082v1", "A legacy quantum paper", published="2002-01-08T00:00:00Z"),
+    "2104.12255v1": _fixture_entry("2104.12255v1", None, published="2021-04-26T00:00:00Z"),
+}
+
+_NONEXISTENT_IDS = {"0000.0000", "0808.05394"}
+
+
+def _is_valid_arxiv_id(identifier: str) -> bool:
+    if "/" in identifier:
+        prefix, suffix = identifier.split("/", 1)
+        return bool(prefix) and bool(suffix)
+    base = identifier.split("v", 1)[0]
+    if "." not in base:
+        return False
+    left, right = base.split(".", 1)
+    return left.isdigit() and right.isdigit()
+
+
+def _query_search(url: str, params: Dict[str, List[str]]) -> tuple[int, bytes]:
+    query = params.get("search_query", [""])[0]
+    start = int(params.get("start", ["0"])[0])
+    max_results = int(params.get("max_results", ["100"])[0])
+    entries = [_search_entry(index, query) for index in range(start, min(start + max_results, _TOTAL_SEARCH_RESULTS))]
+    return 200, _render_feed(url, entries, total_results=_TOTAL_SEARCH_RESULTS, start_index=start, items_per_page=max_results)
+
+
+def _query_id_list(url: str, params: Dict[str, List[str]]) -> tuple[int, bytes]:
+    ids = [item for item in params.get("id_list", [""])[0].split(",") if item]
+    if any(not _is_valid_arxiv_id(identifier) for identifier in ids):
+        return 400, b""
+    entries: List[Dict[str, object]] = []
+    for identifier in ids:
+        base_identifier = identifier.split("v", 1)[0]
+        if identifier in _NONEXISTENT_IDS or base_identifier in _NONEXISTENT_IDS:
+            continue
+        normalized = identifier
+        if "/" not in identifier and "v" not in identifier:
+            normalized = f"{identifier}v1"
+        fixture = _ID_FIXTURES.get(normalized)
+        if fixture is not None:
+            entries.append(fixture)
+            continue
+        entries.append(_fixture_entry(normalized, f"Fixture for {normalized}"))
+    return 200, _render_feed(url, entries, total_results=len(entries), start_index=0, items_per_page=len(entries))
+
+
+def _render_entry(entry: Dict[str, object]) -> str:
+    authors = "".join(f"<author><name>{_as_xml_text(author)}</name></author>" for author in entry["authors"])
+    categories = "".join(
+        f'<category term="{_as_xml_text(category)}" scheme="http://arxiv.org/schemas/atom" />'
+        for category in entry["categories"]
+    )
+    title = f"<title>{_as_xml_text(entry['title'])}</title>" if entry.get("title") is not None else ""
+    comment = f"<arxiv:comment>{_as_xml_text(entry['comment'])}</arxiv:comment>" if entry.get("comment") else ""
+    journal_ref = (
+        f"<arxiv:journal_ref>{_as_xml_text(entry['journal_ref'])}</arxiv:journal_ref>"
+        if entry.get("journal_ref")
+        else ""
+    )
+    doi = f"<arxiv:doi>{_as_xml_text(entry['doi'])}</arxiv:doi>" if entry.get("doi") else ""
+    return f"""
+    <entry>
+      <id>{_as_xml_text(entry['entry_id'])}</id>
+      <updated>{entry['updated']}</updated>
+      <published>{entry['published']}</published>
+      {title}
+      <summary>{_as_xml_text(entry['summary'])}</summary>
+      {authors}
+      {comment}
+      {journal_ref}
+      {doi}
+      <arxiv:primary_category term="{_as_xml_text(entry['primary_category'])}" />
+      {categories}
+      <link title="pdf" href="{_as_xml_text(entry['pdf_url'])}" rel="related" type="application/pdf" />
+      <link title="abs" href="{_as_xml_text(entry['entry_id'])}" rel="alternate" type="text/html" />
+    </entry>
+    """
+
+
+def _render_feed(url: str, entries: Iterable[Dict[str, object]], *, total_results: int, start_index: int, items_per_page: int) -> bytes:
+    entry_xml = "".join(_render_entry(entry) for entry in entries)
+    feed = f"""<?xml version="1.0" encoding="utf-8"?>
+<feed xmlns="http://www.w3.org/2005/Atom"
+      xmlns:opensearch="http://a9.com/-/spec/opensearch/1.1/"
+      xmlns:arxiv="http://arxiv.org/schemas/atom">
+  <id>{_as_xml_text(url)}</id>
+  <updated>{datetime.now(tz=timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}</updated>
+  <title>arXiv query results</title>
+  <opensearch:totalResults>{total_results}</opensearch:totalResults>
+  <opensearch:startIndex>{start_index}</opensearch:startIndex>
+  <opensearch:itemsPerPage>{items_per_page}</opensearch:itemsPerPage>
+  {entry_xml}
+</feed>
+"""
+    return feed.encode("utf-8")
+
+
+def api_response(url: str) -> Optional[tuple[int, bytes]]:
+    parsed = urlparse(url)
+    if parsed.path.endswith("/api/query"):
+        params = parse_qs(parsed.query)
+        if params.get("search_query") and params.get("search_query", [""])[0] != "":
+            return _query_search(url, params)
+        if params.get("id_list"):
+            return _query_id_list(url, params)
+        return 200, _render_feed(url, [], total_results=0, start_index=0, items_per_page=0)
+    return None
+
+
+def download_bytes(url: str) -> Optional[bytes]:
+    parsed = urlparse(url)
+    if parsed.netloc == "arxiv.org" and parsed.path.startswith("/pdf/"):
+        short_id = parsed.path[len("/pdf/") :].removesuffix(".pdf")
+        return f"PDF fixture for {short_id}\n".encode("utf-8")
+    if parsed.netloc == "arxiv.org" and parsed.path.startswith("/src/"):
+        short_id = parsed.path[len("/src/") :]
+        return f"SOURCE fixture for {short_id}\n".encode("utf-8")
+    return None
+
+
+def write_download(url: str, path: str) -> str:
+    content = download_bytes(url)
+    if content is None:
+        raise ValueError(f"Unsupported offline download URL: {url}")
+    destination = Path(path)
+    destination.write_bytes(content)
+    return str(destination)
