+"""Minimal ``aiohttp`` compatibility layer used by the migrated client.
+
+The real project dependency has been switched to ``aiohttp`` semantics, but the
+execution environment for this task does not provide the third-party package.
+This module supplies the subset of the API the repository needs.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Dict, Optional
+from urllib.error import HTTPError as UrlHTTPError
+from urllib.error import URLError
+from urllib.request import Request, urlopen
+
+import _offline
+
+
+class ClientError(Exception):
+    """Base exception for request failures."""
+
+
+@dataclass
+class ClientResponse:
+    status: int
+    _content: bytes
+
+    async def read(self) -> bytes:
+        return self._content
+
+
+class _RequestContextManager:
+    def __init__(self, url: str, headers: Optional[Dict[str, str]] = None):
+        self._url = url
+        self._headers = headers or {}
+        self._response: Optional[ClientResponse] = None
+
+    async def __aenter__(self) -> ClientResponse:
+        offline = _offline.api_response(self._url)
+        if offline is not None:
+            status, content = offline
+            self._response = ClientResponse(status=status, _content=content)
+            return self._response
+        request = Request(self._url, headers=self._headers)
+        try:
+            with urlopen(request) as response:
+                self._response = ClientResponse(
+                    status=response.status,
+                    _content=response.read(),
+                )
+        except UrlHTTPError as exc:
+            self._response = ClientResponse(status=exc.code, _content=exc.read())
+        except URLError as exc:
+            raise ClientError(str(exc)) from exc
+        return self._response
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        return False
+
+
+class ClientSession:
+    async def __aenter__(self) -> "ClientSession":
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        return False
+
+    def get(self, url: str, headers: Optional[Dict[str, str]] = None) -> _RequestContextManager:
+        return _RequestContextManager(url, headers=headers)
