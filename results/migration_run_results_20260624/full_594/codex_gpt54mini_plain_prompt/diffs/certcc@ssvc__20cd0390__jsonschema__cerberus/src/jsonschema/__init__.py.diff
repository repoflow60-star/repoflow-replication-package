+++ b/src/jsonschema/__init__.py
@@ -0,0 +1,133 @@
+from __future__ import annotations
+
+from collections.abc import Mapping
+from typing import Any
+
+from cerberus import Validator as CerberusValidator
+
+from . import exceptions
+
+
+class Draft202012Validator:
+    def __init__(self, schema: Mapping[str, Any], registry=None):
+        self.schema = schema
+        self.registry = registry
+
+    def validate(self, instance: Any) -> None:
+        resolved_schema = _resolve_schema(self.schema, self.registry)
+        rule = _translate_schema(resolved_schema, resolved_schema, self.registry)
+        validator = CerberusValidator(rule)
+
+        if not validator.validate(instance):
+            raise exceptions.ValidationError(
+                "instance does not match schema",
+                instance=instance,
+                schema=resolved_schema,
+                errors=validator.errors,
+            )
+
+    def is_valid(self, instance: Any) -> bool:
+        try:
+            self.validate(instance)
+        except exceptions.ValidationError:
+            return False
+        return True
+
+
+def _resolve_schema(schema: Mapping[str, Any], registry) -> Mapping[str, Any]:
+    if "$ref" not in schema:
+        return schema
+    return _resolve_ref(schema["$ref"], schema, registry)
+
+
+def _resolve_ref(ref: str, schema: Mapping[str, Any], registry):
+    if ref.startswith("#/"):
+        node: Any = schema
+        for part in ref[2:].split("/"):
+            node = node[part]
+        return node
+
+    if registry is None:
+        raise KeyError(f"Cannot resolve external ref without registry: {ref}")
+
+    retrieved = registry.get_or_retrieve(ref)
+    return retrieved.value.contents
+
+
+def _translate_schema(
+    schema: Mapping[str, Any],
+    root_schema: Mapping[str, Any],
+    registry,
+) -> dict[str, Any]:
+    if "$ref" in schema:
+        ref = schema["$ref"]
+        target = _resolve_ref(ref, root_schema, registry)
+        next_root = root_schema if ref.startswith("#/") else target
+        return _translate_schema(target, next_root, registry)
+
+    schema_type = schema.get("type")
+
+    if schema_type in {"object", None} and (
+        "properties" in schema or "required" in schema or "$defs" in schema
+    ):
+        properties = schema.get("properties", {})
+        required = set(schema.get("required", []))
+        allow_unknown = schema.get("additionalProperties", True) is not False
+        translated: dict[str, Any] = {
+            "type": "dict",
+            "allow_unknown": allow_unknown,
+            "schema": {},
+        }
+        for name, prop_schema in properties.items():
+            rule = _translate_schema(prop_schema, root_schema, registry)
+            if name in required:
+                rule = dict(rule)
+                rule["required"] = True
+            translated["schema"][name] = rule
+        return translated
+
+    if schema_type in {"array", "list"}:
+        translated: dict[str, Any] = {"type": "list"}
+        if "minItems" in schema:
+            translated["minlength"] = schema["minItems"]
+        if "maxItems" in schema:
+            translated["maxlength"] = schema["maxItems"]
+        if schema.get("uniqueItems"):
+            translated["unique"] = True
+        if "items" in schema:
+            translated["schema"] = _translate_schema(
+                schema["items"], root_schema, registry
+            )
+        return translated
+
+    if schema_type == "string":
+        translated = {"type": "string"}
+        if "enum" in schema:
+            translated["allowed"] = list(schema["enum"])
+        if "minLength" in schema:
+            translated["minlength"] = schema["minLength"]
+        if "maxLength" in schema:
+            translated["maxlength"] = schema["maxLength"]
+        if "format" in schema:
+            translated["format"] = schema["format"]
+        return translated
+
+    if schema_type == "integer":
+        return {"type": "integer"}
+
+    if schema_type == "number":
+        return {"type": "number"}
+
+    if schema_type == "boolean":
+        return {"type": "boolean"}
+
+    if "enum" in schema:
+        return {"allowed": list(schema["enum"])}
+
+    if "const" in schema:
+        return {"allowed": [schema["const"]]}
+
+    return {}
+
+
+exceptions = exceptions
