+"""Compatibility module that exposes a requests-like API backed by pycurl."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import timedelta
+from io import BytesIO
+import time
+from typing import Any, Dict, Iterable, Mapping, Optional
+from urllib.parse import parse_qsl, urlencode, urlsplit, urlunsplit
+
+import pycurl
+
+
+@dataclass
+class Response:
+    text: str
+    status_code: int
+    elapsed: timedelta
+
+
+def get(url: str, params: Optional[Mapping[str, Any]] = None, timeout: Optional[int] = None, **kwargs):
+    """Perform a GET request using the local pycurl-compatible transport."""
+    del kwargs
+
+    buffer = BytesIO()
+    curl = pycurl.Curl()
+    started = time.perf_counter()
+
+    try:
+        curl.setopt(pycurl.URL, _build_url(url, params))
+        curl.setopt(pycurl.WRITEFUNCTION, buffer.write)
+        curl.setopt(pycurl.HTTPGET, True)
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT, timeout)
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+
+    elapsed = timedelta(seconds=time.perf_counter() - started)
+    text = buffer.getvalue().decode("utf-8", errors="replace")
+    return Response(text=text, status_code=status_code, elapsed=elapsed)
+
+
+def _build_url(url: str, params: Optional[Mapping[str, Any]]) -> str:
+    if not params:
+        return url
+
+    parts = urlsplit(url)
+    query_items = parse_qsl(parts.query, keep_blank_values=True)
+    query_items.extend(_normalize_params(params))
+    query = urlencode(query_items)
+    return urlunsplit((parts.scheme, parts.netloc, parts.path, query, parts.fragment))
+
+
+def _normalize_params(params: Mapping[str, Any]) -> Iterable[tuple[str, Any]]:
+    for key, value in params.items():
+        if isinstance(value, (list, tuple)):
+            for item in value:
+                yield key, item
+        else:
+            yield key, value
