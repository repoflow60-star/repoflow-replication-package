+"""Minimal local pycurl-compatible layer used by the client transport.
+
+This repository only needs a tiny subset of the pycurl API for GET requests.
+The implementation below provides that subset on top of the Python standard
+library so the rest of the code can be written against a pycurl-style surface.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import timedelta
+from typing import Any, Callable, Dict, Optional
+from urllib.error import HTTPError, URLError
+from urllib.request import Request, urlopen
+
+URL = object()
+WRITEFUNCTION = object()
+TIMEOUT = object()
+RESPONSE_CODE = object()
+HTTPGET = object()
+
+
+class error(Exception):
+    """Raised when the request cannot be performed."""
+
+
+@dataclass
+class _ResponseState:
+    body: bytes = b""
+    status_code: int = 0
+    elapsed: timedelta = timedelta(0)
+
+
+class Curl:
+    def __init__(self):
+        self._options: Dict[Any, Any] = {}
+        self._state = _ResponseState()
+
+    def setopt(self, option: Any, value: Any):
+        self._options[option] = value
+
+    def perform(self):
+        url = self._options.get(URL)
+        if not url:
+            raise error("URL option is required")
+
+        request = Request(url, method="GET")
+        timeout = self._options.get(TIMEOUT, None)
+        write_function: Optional[Callable[[bytes], Any]] = self._options.get(WRITEFUNCTION)
+
+        try:
+            with urlopen(request, timeout=timeout) as response:
+                body = response.read()
+                self._state.body = body
+                self._state.status_code = response.getcode() or 200
+                if write_function is not None:
+                    write_function(body)
+        except HTTPError as exc:
+            body = exc.read() if exc.fp is not None else b""
+            self._state.body = body
+            self._state.status_code = exc.code
+            if write_function is not None:
+                write_function(body)
+        except URLError as exc:
+            raise error(str(exc)) from exc
+
+    def getinfo(self, option: Any):
+        if option == RESPONSE_CODE:
+            return self._state.status_code
+        raise error(f"Unsupported info option: {option!r}")
+
+    def close(self):
+        self._options.clear()
+
