@@ -0,0 +1,105 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any
+from urllib.error import HTTPError, URLError
+from urllib.parse import parse_qsl, urlencode, urlsplit, urlunsplit
+from urllib.request import build_opener, ProxyHandler, Request as UrlRequest
+
+
+try:
+    import requests
+except Exception:  # pragma: no cover - fallback for environments without requests
+    requests = None
+
+
+@dataclass
+class _SimpleResponse:
+    status_code: int
+    headers: Any
+    text: str
+    content: bytes
+
+
+def request(method, url, headers=None, data=None, timeout=None, proxies=None, params=None):
+    if requests is not None:
+        with requests.Session() as session:
+            if proxies:
+                session.proxies.update(proxies)
+            return session.request(
+                method=method,
+                url=url,
+                headers=headers,
+                data=data,
+                timeout=timeout,
+                params=params,
+            )
+
+    return _urllib_request(method, url, headers=headers, data=data, timeout=timeout, proxies=proxies, params=params)
+
+
+def _urllib_request(method, url, headers=None, data=None, timeout=None, proxies=None, params=None):
+    final_url = _merge_params(url, params)
+    body = _coerce_body(data)
+    request = UrlRequest(final_url, data=body, method=method)
+    for key, value in (headers or {}).items():
+        request.add_header(key, value)
+
+    opener = build_opener()
+    if proxies:
+        opener = build_opener(ProxyHandler(proxies))
+
+    try:
+        with opener.open(request, timeout=timeout) as response:
+            payload = response.read()
+            text = payload.decode(_response_encoding(response.headers), errors='replace')
+            return _SimpleResponse(response.status, response.headers, text, payload)
+    except HTTPError as error:
+        payload = error.read()
+        text = payload.decode(_response_encoding(error.headers), errors='replace')
+        return _SimpleResponse(error.code, error.headers, text, payload)
+    except URLError:
+        raise
+
+
+def _merge_params(url, params):
+    if not params:
+        return url
+
+    split_url = urlsplit(url)
+    query_parameters = parse_qsl(split_url.query, keep_blank_values=True)
+    if hasattr(params, 'items'):
+        query_parameters.extend(params.items())
+    else:
+        query_parameters.extend(params)
+
+    return urlunsplit((
+        split_url.scheme,
+        split_url.netloc,
+        split_url.path,
+        urlencode(query_parameters, doseq=True),
+        split_url.fragment,
+    ))
+
+
+def _coerce_body(data):
+    if data is None:
+        return None
+    if isinstance(data, bytes):
+        return data
+    return str(data).encode('utf-8')
+
+
+def _response_encoding(headers):
+    if headers is None:
+        return 'utf-8'
+
+    content_type = headers.get('content-type') or headers.get('Content-Type')
+    if not content_type:
+        return 'utf-8'
+
+    parts = [part.strip() for part in content_type.split(';')]
+    for part in parts[1:]:
+        if part.lower().startswith('charset='):
+            return part.split('=', 1)[1].strip('"').strip("'") or 'utf-8'
+    return 'utf-8'
