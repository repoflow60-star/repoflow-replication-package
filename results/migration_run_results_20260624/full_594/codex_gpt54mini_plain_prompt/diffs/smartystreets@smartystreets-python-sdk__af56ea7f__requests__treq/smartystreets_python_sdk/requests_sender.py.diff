+def build_url(url_prefix, parameters):
+    split_url = urlsplit(url_prefix)
+    query_parameters = parse_qsl(split_url.query, keep_blank_values=True)
+    for key, value in parameters.items():
+        query_parameters.append((key, value))
+
+    return urlunsplit((
+        split_url.scheme,
+        split_url.netloc,
+        split_url.path,
+        urlencode(query_parameters, doseq=True),
+        split_url.fragment,
+    ))
