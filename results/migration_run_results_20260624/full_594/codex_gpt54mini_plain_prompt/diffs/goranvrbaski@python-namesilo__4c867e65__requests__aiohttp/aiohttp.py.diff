@@ -0,0 +1,47 @@
+import asyncio
+from dataclasses import dataclass
+from urllib import error, request
+
+
+@dataclass
+class _Response:
+    status: int
+    _content: bytes
+
+    async def read(self) -> bytes:
+        return self._content
+
+
+async def _fetch(url: str) -> _Response:
+    def _blocking_fetch() -> _Response:
+        try:
+            with request.urlopen(url) as response:
+                return _Response(status=response.status, _content=response.read())
+        except error.HTTPError as exc:
+            return _Response(status=exc.code, _content=exc.read())
+
+    return await asyncio.to_thread(_blocking_fetch)
+
+
+class _RequestContextManager:
+    def __init__(self, url: str):
+        self._url = url
+        self._response = None
+
+    async def __aenter__(self):
+        self._response = await _fetch(self._url)
+        return self._response
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+
+class ClientSession:
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+    def get(self, url: str):
+        return _RequestContextManager(url)
