+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Callable, Mapping, Optional
+from urllib.error import HTTPError
+from urllib.parse import urlencode, urlsplit, urlunsplit
+from urllib.request import Request, build_opener, HTTPSHandler
+import ssl
+
+
+def _normalize_headers(headers: Optional[Mapping[str, object]]) -> dict[str, str]:
+    if not headers:
+        return {}
+    normalized: dict[str, str] = {}
+    for key, value in headers.items():
+        if isinstance(value, (list, tuple)):
+            normalized[str(key)] = ", ".join(str(item) for item in value)
+        else:
+            normalized[str(key)] = str(value)
+    return normalized
+
+
+def _add_params(url: str, params) -> str:
+    if not params:
+        return url
+    parts = list(urlsplit(url))
+    query = parts[3]
+    extra = urlencode(params, doseq=True)
+    parts[3] = "&".join(filter(None, [query, extra]))
+    return urlunsplit(parts)
+
+
+@dataclass
+class Response:
+    _body: object
+    code: int
+    headers: dict[str, str]
+    phrase: str
+
+    def iter_content(self, chunk_size: int = 1024):
+        while True:
+            chunk = self._body.read(chunk_size)
+            if not chunk:
+                break
+            yield chunk
+
+    def close(self) -> None:
+        close = getattr(self._body, "close", None)
+        if close is not None:
+            close()
+
+    def collect(self, collector: Callable[[bytes], None]) -> None:
+        collect(self, collector)
+
+    def content(self) -> bytes:
+        return content(self)
+
+    def text(self, encoding: str = "ISO-8859-1") -> str:
+        return text_content(self, encoding=encoding)
+
+    def raise_for_status(self) -> None:
+        if self.code >= 400:
+            raise RuntimeError(f"HTTP error {self.code}")
+
+
+def request(
+    method: str,
+    url: str,
+    headers: Optional[Mapping[str, object]] = None,
+    params=None,
+    unbuffered: bool = False,
+    **kwargs,
+) -> Response:
+    del unbuffered, kwargs
+    url = _add_params(url, params)
+    req = Request(url, method=method.upper(), headers=_normalize_headers(headers))
+    context = ssl._create_unverified_context()
+    opener = build_opener(HTTPSHandler(context=context))
+    try:
+        body = opener.open(req)
+    except HTTPError as exc:
+        body = exc
+    response_headers = {
+        str(key): str(value) for key, value in body.headers.items()
+    }
+    code = getattr(body, "status", None)
+    if code is None:
+        code = getattr(body, "code", None)
+    if code is None:
+        code = getattr(body, "getcode")()
+    phrase = getattr(body, "reason", "")
+    return Response(body, int(code), response_headers, str(phrase))
+
+
+def get(url: str, headers=None, **kwargs) -> Response:
+    return request("GET", url, headers=headers, **kwargs)
+
+
+def collect(response: Response, collector: Callable[[bytes], None]) -> None:
+    try:
+        for chunk in response.iter_content(1024):
+            collector(chunk)
+    finally:
+        response.close()
+
+
+def content(response: Response) -> bytes:
+    chunks = []
+    collect(response, chunks.append)
+    return b"".join(chunks)
+
+
+def text_content(response: Response, encoding: str = "ISO-8859-1") -> str:
+    return content(response).decode(encoding)
+
+
+def json_content(response: Response, **kwargs):
+    import json
+
+    return json.loads(text_content(response, encoding="utf-8"), **kwargs)
