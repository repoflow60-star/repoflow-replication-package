+"""Compatibility shim for the httpx API.
+
+The repository now targets ``httpx``. This module keeps the code runnable in
+environments where the dependency is not installed by falling back to
+``requests`` with a thin response wrapper.
+"""
+
+try:
+    import httpx as httpx
+except ImportError:  # pragma: no cover - exercised only when httpx is absent
+    import requests
+
+    class _ResponseWrapper:
+        def __init__(self, response):
+            self._response = response
+
+        def __getattr__(self, name):
+            return getattr(self._response, name)
+
+        @property
+        def status_code(self):
+            return self._response.status_code
+
+        @property
+        def headers(self):
+            return self._response.headers
+
+        @property
+        def content(self):
+            return self._response.content
+
+        @property
+        def is_redirect(self):
+            return self._response.is_redirect
+
+        def json(self):
+            return self._response.json()
+
+        def raise_for_status(self):
+            return self._response.raise_for_status()
+
+        def iter_bytes(self, chunk_size=8192):
+            return self._response.iter_content(chunk_size)
+
+        def iter_content(self, chunk_size=8192):
+            return self._response.iter_content(chunk_size)
+
+        def close(self):
+            return self._response.close()
+
+    class _CompatClient:
+        @staticmethod
+        def get(*args, **kwargs):
+            return _ResponseWrapper(requests.get(*args, **kwargs))
+
+        @staticmethod
+        def post(*args, **kwargs):
+            return _ResponseWrapper(requests.post(*args, **kwargs))
+
+        @staticmethod
+        def head(*args, **kwargs):
+            return _ResponseWrapper(requests.head(*args, **kwargs))
+
+    httpx = _CompatClient()
