+from concurrent.futures import Future
+from typing import Any, Optional
+
+import requests
+
+
+class _CompatSession(requests.Session):
+    """Session wrapper that keeps existing requests.get test patches working."""
+
+    def request(self, method: str, url: str, **kwargs: Any):
+        if method.upper() == "GET":
+            return requests.get(url, **kwargs)
+        return requests.request(method, url, **kwargs)
+
+
+class FuturesSession:
+    """Minimal futures-based session compatible with requests_futures."""
+
+    def __init__(
+        self,
+        session: Optional[requests.Session] = None,
+        max_workers: int = 8,
+        executor: Optional[Any] = None,
+    ):
+        self.session = session or _CompatSession()
+
+    def request(self, method: str, url: str, **kwargs: Any):
+        future: Future = Future()
+        try:
+            future.set_result(self.session.request(method, url, **kwargs))
+        except Exception as exc:  # pragma: no cover - exercised through callers
+            future.set_exception(exc)
+        return future
+
+    def get(self, url: str, **kwargs: Any):
+        return self.request("GET", url, **kwargs)
+
+    def close(self):
+        self.session.close()
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        self.close()
