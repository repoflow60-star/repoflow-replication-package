+class _RequestsSessionAdapter:
+    """Synchronous HTTP client backed by requests."""
+
+    def __init__(self, headers: dict[str, Any], request_kwargs: dict[str, Any]):
+        import requests
+
+        self.headers = headers
+        self._session = requests.Session()
+        self._session.headers.update(headers)
+        self._request_kwargs = request_kwargs
+
+    def get(self, url: str, params=None, **kwargs):
+        request_kwargs = dict(self._request_kwargs)
+        request_kwargs.update(kwargs)
+        return _RequestsResponseAdapter(
+            self._session.get(url, params=params, **request_kwargs)
+        )
+
+    def close(self):
+        self._session.close()
+
