+class _TreqSessionAdapter:
+    """Synchronous HTTP client backed by treq and a background reactor."""
+
+    _reactor_thread_started = False
+    _reactor_thread_lock = threading.Lock()
+    _reactor_thread = None
+
+    def __init__(self, headers: dict[str, Any], request_kwargs: dict[str, Any]):
+        self.headers = headers
+        self._request_kwargs = request_kwargs
+        self._ensure_reactor()
+
+    @classmethod
+    def _ensure_reactor(cls):
+        if cls._reactor_thread_started:
+            return
+
+        with cls._reactor_thread_lock:
+            if cls._reactor_thread_started:
+                return
+
+            def _run_reactor():
+                reactor.run(installSignalHandlers=False)
+
+            cls._reactor_thread = threading.Thread(
+                target=_run_reactor,
+                name="wikipediaapi-treq-reactor",
+                daemon=True,
+            )
+            cls._reactor_thread.start()
+            cls._reactor_thread_started = True
+
+    def get(self, url: str, params=None, **kwargs):
+        request_kwargs = dict(self._request_kwargs)
+        request_kwargs.update(kwargs)
+        request_kwargs["headers"] = self.headers
+        if params is not None:
+            request_kwargs["params"] = params
+
+        response = blockingCallFromThread(
+            reactor,
+            treq.get,
+            url,
+            **request_kwargs,
+        )
+        return _TreqResponseAdapter(response)
+
+    def close(self):
+        return None
+
+
+def _create_http_session(
+    headers: dict[str, Any], request_kwargs: dict[str, Any]
+) -> object:
+    if treq is not None and reactor is not None and blockingCallFromThread is not None:
+        # treq does not cover every requests keyword argument, so keep the
+        # requests-backed path for explicit proxy-style usage.
+        if "proxies" not in request_kwargs:
+            return _TreqSessionAdapter(headers, request_kwargs)
+
+    return _RequestsSessionAdapter(headers, request_kwargs)
+
