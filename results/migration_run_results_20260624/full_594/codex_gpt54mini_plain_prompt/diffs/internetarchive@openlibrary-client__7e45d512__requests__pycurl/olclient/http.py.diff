+from __future__ import annotations
+
+import json
+from http.cookiejar import CookieJar
+from typing import Any, Dict, Mapping, Optional
+
+import pycurl
+
+
+class RequestException(Exception):
+    def __init__(self, message: str = "", response: Optional["Response"] = None):
+        super().__init__(message)
+        self.response = response
+
+
+class HTTPError(RequestException):
+    pass
+
+
+class Response:
+    def __init__(
+        self,
+        status_code: int,
+        headers: Mapping[str, str],
+        content: bytes,
+        url: str,
+    ):
+        self.status_code = status_code
+        self.headers = dict(headers)
+        self.content = content
+        self.url = url
+
+    @property
+    def text(self) -> str:
+        charset = "utf-8"
+        content_type = self.headers.get("Content-Type", "")
+        if "charset=" in content_type:
+            charset = content_type.split("charset=", 1)[1].split(";", 1)[0].strip()
+        return self.content.decode(charset, errors="replace")
+
+    def json(self) -> Any:
+        return json.loads(self.text)
+
+    def raise_for_status(self) -> None:
+        if 400 <= self.status_code:
+            raise HTTPError(f"HTTP {self.status_code}", response=self)
+
+
+class _Exceptions:
+    RequestException = RequestException
+    HTTPError = HTTPError
+
+
+exceptions = _Exceptions()
+
+
+class Session:
+    def __init__(self):
+        self._cookie_jar = CookieJar()
+
+    @property
+    def cookies(self):
+        return {cookie.name: cookie.value for cookie in self._cookie_jar}
+
+    def _request(
+        self,
+        method: str,
+        url: str,
+        data: Any = None,
+        headers: Optional[Mapping[str, str]] = None,
+        files: Optional[Mapping[str, Any]] = None,
+        params: Optional[Mapping[str, Any]] = None,
+        timeout: Optional[float] = None,
+        json: Any = None,
+    ) -> Response:
+        request_data = data
+        request_headers = dict(headers or {})
+        if json is not None:
+            request_data = json_dumps(json)
+            if not any(k.lower() == "content-type" for k in request_headers):
+                request_headers["Content-Type"] = "application/json"
+
+        transport_response = pycurl.request(
+            method,
+            url,
+            headers=request_headers,
+            data=request_data,
+            files=files,
+            params=params,
+            cookies=self._cookie_jar,
+            timeout=timeout,
+        )
+        return Response(
+            status_code=transport_response.status_code,
+            headers=transport_response.headers,
+            content=transport_response.content,
+            url=transport_response.url,
+        )
+
+    def get(
+        self,
+        url: str,
+        params: Optional[Mapping[str, Any]] = None,
+        headers: Optional[Mapping[str, str]] = None,
+        timeout: Optional[float] = None,
+    ) -> Response:
+        return self._request("GET", url, params=params, headers=headers, timeout=timeout)
+
+    def post(
+        self,
+        url: str,
+        data: Any = None,
+        headers: Optional[Mapping[str, str]] = None,
+        files: Optional[Mapping[str, Any]] = None,
+        params: Optional[Mapping[str, Any]] = None,
+        timeout: Optional[float] = None,
+        json: Any = None,
+    ) -> Response:
+        return self._request(
+            "POST",
+            url,
+            data=data,
+            headers=headers,
+            files=files,
+            params=params,
+            timeout=timeout,
+            json=json,
+        )
+
+    def put(
+        self,
+        url: str,
+        data: Any = None,
+        headers: Optional[Mapping[str, str]] = None,
+        params: Optional[Mapping[str, Any]] = None,
+        timeout: Optional[float] = None,
+        json: Any = None,
+    ) -> Response:
+        return self._request(
+            "PUT",
+            url,
+            data=data,
+            headers=headers,
+            params=params,
+            timeout=timeout,
+            json=json,
+        )
+
+    def delete(
+        self,
+        url: str,
+        data: Any = None,
+        headers: Optional[Mapping[str, str]] = None,
+        params: Optional[Mapping[str, Any]] = None,
+        timeout: Optional[float] = None,
+    ) -> Response:
+        return self._request(
+            "DELETE",
+            url,
+            data=data,
+            headers=headers,
+            params=params,
+            timeout=timeout,
+        )
+
+
+def json_dumps(value: Any) -> str:
+    return json.dumps(value)
+
