+++ b/pycurl/__init__.py
@@ -0,0 +1,139 @@
+from __future__ import annotations
+
+import mimetypes
+import urllib.error
+import urllib.parse
+import urllib.request
+import uuid
+from dataclasses import dataclass
+from http.cookiejar import CookieJar
+from typing import Any, Dict, Iterable, Mapping, MutableMapping, Optional, Tuple, Union
+
+
+@dataclass
+class TransportResponse:
+    status_code: int
+    headers: Dict[str, str]
+    content: bytes
+    url: str
+
+
+def _encode_multipart(fields: Mapping[str, Any]) -> Tuple[bytes, str]:
+    boundary = uuid.uuid4().hex
+    chunks = []
+
+    def add_line(line: Union[str, bytes]) -> None:
+        if isinstance(line, str):
+            chunks.append(line.encode("utf-8"))
+        else:
+            chunks.append(line)
+        chunks.append(b"\r\n")
+
+    for name, value in fields.items():
+        if isinstance(value, tuple):
+            filename = value[0]
+            content = value[1] if len(value) > 1 else b""
+            mime_type = value[2] if len(value) > 2 and value[2] else None
+            if filename is None:
+                add_line(f"--{boundary}")
+                add_line(f'Content-Disposition: form-data; name="{name}"')
+                add_line("")
+                add_line("" if content is None else str(content))
+                continue
+            if mime_type is None and filename:
+                mime_type = mimetypes.guess_type(filename)[0]
+            mime_type = mime_type or "application/octet-stream"
+            add_line(f"--{boundary}")
+            add_line(
+                f'Content-Disposition: form-data; name="{name}"; filename="{filename}"'
+            )
+            add_line(f"Content-Type: {mime_type}")
+            add_line("")
+            if isinstance(content, str):
+                add_line(content)
+            else:
+                chunks.append(content)
+                chunks.append(b"\r\n")
+            continue
+
+        add_line(f"--{boundary}")
+        add_line(f'Content-Disposition: form-data; name="{name}"')
+        add_line("")
+        add_line("" if value is None else str(value))
+
+    add_line(f"--{boundary}--")
+    body = b"".join(chunks)
+    return body, f"multipart/form-data; boundary={boundary}"
+
+
+def _prepare_body(
+    data: Any = None,
+    files: Optional[Mapping[str, Any]] = None,
+) -> Tuple[Optional[bytes], Optional[str]]:
+    if files:
+        return _encode_multipart(files)
+
+    if data is None:
+        return None, None
+
+    if isinstance(data, bytes):
+        return data, None
+
+    if isinstance(data, str):
+        return data.encode("utf-8"), None
+
+    if isinstance(data, Mapping):
+        return urllib.parse.urlencode(data, doseq=True).encode("utf-8"), (
+            "application/x-www-form-urlencoded"
+        )
+
+    return str(data).encode("utf-8"), None
+
+
+def request(
+    method: str,
+    url: str,
+    *,
+    headers: Optional[Mapping[str, str]] = None,
+    data: Any = None,
+    files: Optional[Mapping[str, Any]] = None,
+    params: Optional[Mapping[str, Any]] = None,
+    cookies: Optional[CookieJar] = None,
+    timeout: Optional[float] = None,
+) -> TransportResponse:
+    if params:
+        query = urllib.parse.urlencode(params, doseq=True)
+        parsed = urllib.parse.urlsplit(url)
+        existing_query = "&".join(filter(None, [parsed.query, query]))
+        url = urllib.parse.urlunsplit(
+            (parsed.scheme, parsed.netloc, parsed.path, existing_query, parsed.fragment)
+        )
+
+    body, content_type = _prepare_body(data=data, files=files)
+    request_headers: Dict[str, str] = dict(headers or {})
+    if content_type and not any(k.lower() == "content-type" for k in request_headers):
+        request_headers["Content-Type"] = content_type
+
+    req = urllib.request.Request(
+        url,
+        data=body if method.upper() not in {"GET", "HEAD"} else None,
+        headers=request_headers,
+        method=method.upper(),
+    )
+
+    cookie_jar = cookies or CookieJar()
+    opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cookie_jar))
+
+    try:
+        response = opener.open(req, timeout=timeout)
+    except urllib.error.HTTPError as error:
+        response = error
+
+    content = response.read()
+    response_headers = {k: v for k, v in response.headers.items()}
+    return TransportResponse(
+        status_code=getattr(response, "code", 200),
+        headers=response_headers,
+        content=content,
+        url=response.geturl(),
+    )
