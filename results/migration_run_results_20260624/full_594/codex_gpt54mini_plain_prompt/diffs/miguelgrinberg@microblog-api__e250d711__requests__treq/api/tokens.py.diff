+async def _maybe_await(value):
+    if inspect.isawaitable(value):
+        return await value
+    return value
+
+
+def _response_status(response):
+    return getattr(response, 'status_code', getattr(response, 'code', None))
+
+
+async def _response_json(response):
+    json = getattr(response, 'json', None)
+    if callable(json):
+        return await _maybe_await(json())
+    return await _maybe_await(treq.json_content(response))
