+from __future__ import annotations
+
+import json
+from typing import Any
+
+import urllib3
+
+
+_HTTP = urllib3.PoolManager()
+
+
+class HTTPError(Exception):
+    def __init__(self, message: str = "", response: Any = None):
+        super().__init__(message)
+        self.response = response
+
+
+class Response:
+    def __init__(self, *, status_code: int, content: bytes):
+        self.status_code = status_code
+        self.content = content
+
+    def json(self):
+        return json.loads(self.content.decode("utf-8"))
+
+    def raise_for_status(self):
+        http_error_msg = ""
+        if 400 <= self.status_code < 500:
+            http_error_msg = f"{self.status_code} Client Error"
+        elif 500 <= self.status_code < 600:
+            http_error_msg = f"{self.status_code} Server Error"
+
+        if http_error_msg:
+            raise HTTPError(http_error_msg, response=self)
+
+
+def get(url: str) -> Response:
+    response = _HTTP.request("GET", url, preload_content=True)
+    content = response.data if response.data is not None else b""
+    return Response(status_code=response.status, content=content)
