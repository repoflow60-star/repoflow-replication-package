+@dataclass
+class _HTTPResponse:
+    status_code: int
+    content: bytes
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status_code < 400
+
+    @property
+    def status(self) -> int:
+        return self.status_code
+
+
+def _run_coroutine(coro):
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coro)
+
+    from threading import Thread
+
+    result = {}
+    error = {}
+
+    def _runner():
+        try:
+            result['value'] = asyncio.run(coro)
+        except BaseException as exc:  # pragma: no cover - defensive threading bridge
+            error['exc'] = exc
+
+    thread = Thread(target=_runner)
+    thread.start()
+    thread.join()
+    if error:
+        raise error['exc']
+    return result['value']
+
+
+async def _aiohttp_post_request(request_url: str, data: dict, **kwargs) -> _HTTPResponse:
+    timeout = kwargs.pop('timeout', 10)
+    headers = kwargs.pop('headers', None)
+    allow_redirects = kwargs.pop('allow_redirects', True)
+    verify = kwargs.pop('verify', True)
+
+    session_kwargs = {}
+    if timeout is not None:
+        session_kwargs['timeout'] = aiohttp.ClientTimeout(total=timeout)
+    if headers is not None:
+        session_kwargs['headers'] = headers
+
+    request_kwargs = dict(kwargs)
+    request_kwargs['allow_redirects'] = allow_redirects
+    if verify is False:
+        request_kwargs['ssl'] = False
+    elif verify is not True:
+        request_kwargs['ssl'] = verify
+
+    async with aiohttp.ClientSession(**session_kwargs) as session:
+        async with session.post(request_url, data=json.dumps(data), **request_kwargs) as response:
+            content = await response.read()
+            return _HTTPResponse(status_code=response.status, content=content)
+
+
+def _urllib_post_request(request_url: str, data: dict, **kwargs) -> _HTTPResponse:
+    timeout = kwargs.pop('timeout', 10)
+    headers = dict(kwargs.pop('headers', {}) or {})
+    kwargs.pop('allow_redirects', None)
+    verify = kwargs.pop('verify', True)
+    headers.setdefault('Content-Type', 'application/json')
+
+    request = Request(request_url, data=json.dumps(data).encode('utf-8'), headers=headers, method='POST')
+    context = None
+    if verify is False and request_url.startswith('https://'):
+        context = ssl._create_unverified_context()
+
+    try:
+        with urlopen(request, timeout=timeout, context=context) as response:
+            return _HTTPResponse(status_code=response.getcode(), content=response.read())
+    except HTTPError as exc:
+        return _HTTPResponse(status_code=exc.code, content=exc.read())
+
+
+def _post_request(request_url: str, data: dict, **kwargs) -> _HTTPResponse:
+    if aiohttp is not None:
+        return _run_coroutine(_aiohttp_post_request(request_url, data, **kwargs))
+    return _urllib_post_request(request_url, data, **kwargs)
