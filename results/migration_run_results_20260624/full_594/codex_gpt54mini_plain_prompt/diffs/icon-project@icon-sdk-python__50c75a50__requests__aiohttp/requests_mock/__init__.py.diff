+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+from types import SimpleNamespace
+from typing import Any, Dict, Optional
+
+
+@dataclass
+class _RecordedRequest:
+    method: str
+    url: str
+    text: str
+    headers: Dict[str, Any]
+
+
+@dataclass
+class _RegisteredResponse:
+    method: str
+    matcher: Any
+    payload: Any
+    status_code: int
+    headers: Dict[str, Any]
+
+
+class _Response:
+    def __init__(self, payload: Any, status_code: int, headers: Optional[Dict[str, Any]] = None):
+        if isinstance(payload, (bytes, bytearray)):
+            content = bytes(payload)
+        elif isinstance(payload, str):
+            content = payload.encode("utf-8")
+        else:
+            content = json.dumps(payload).encode("utf-8")
+        self.content = content
+        self.status_code = status_code
+        self.ok = 200 <= status_code < 400
+        self.headers = headers or {}
+
+    @property
+    def status(self) -> int:
+        return self.status_code
+
+    @property
+    def text(self) -> str:
+        return self.content.decode("utf-8")
+
+
+def _matches(matcher: Any, url: str) -> bool:
+    if hasattr(matcher, "search"):
+        return matcher.search(url) is not None
+    if hasattr(matcher, "match"):
+        return matcher.match(url) is not None
+    return matcher == url
+
+
+class Mocker:
+    def __init__(self):
+        self._routes = []
+        self._original_post_request = None
+        self._adapter = SimpleNamespace(last_request=None)
+
+    def __enter__(self):
+        from iconsdk.providers import http_provider
+
+        self._original_post_request = http_provider._post_request
+
+        def _mock_post_request(request_url: str, data: dict, **kwargs):
+            body = json.dumps(data)
+            self._adapter.last_request = _RecordedRequest(
+                method="POST",
+                url=request_url,
+                text=body,
+                headers=dict(kwargs.get("headers", {}) or {}),
+            )
+            for route in self._routes:
+                if route.method == "POST" and _matches(route.matcher, request_url):
+                    return _Response(route.payload, route.status_code, route.headers)
+            raise AssertionError(f"Unexpected POST request to {request_url}")
+
+        http_provider._post_request = _mock_post_request
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        from iconsdk.providers import http_provider
+
+        if self._original_post_request is not None:
+            http_provider._post_request = self._original_post_request
+        return False
+
+    def post(self, matcher, json=None, status_code: int = 200, headers: Optional[Dict[str, Any]] = None, text=None):
+        payload = json if json is not None else text
+        self._routes.append(
+            _RegisteredResponse(
+                method="POST",
+                matcher=matcher,
+                payload=payload,
+                status_code=status_code,
+                headers=headers or {},
+            )
+        )
+
+
+from . import contrib  # noqa: E402,F401
+
