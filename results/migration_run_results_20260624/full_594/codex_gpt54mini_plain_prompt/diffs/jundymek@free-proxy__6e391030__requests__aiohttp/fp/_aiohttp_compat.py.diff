+++ b/fp/_aiohttp_compat.py
@@ -0,0 +1,99 @@
+"""Minimal aiohttp compatibility layer for environments without aiohttp installed."""
+
+import asyncio
+import urllib.error
+import urllib.parse
+import urllib.request
+
+
+class ClientError(Exception):
+    """Fallback aiohttp-style client exception."""
+
+
+class ClientTimeout:
+    def __init__(self, total=None):
+        self.total = total
+
+
+class _Transport:
+    def __init__(self, peername):
+        self._peername = peername
+
+    def get_extra_info(self, name):
+        if name == 'peername':
+            return self._peername
+        return None
+
+
+class _Connection:
+    def __init__(self, peername):
+        self.transport = _Transport(peername)
+
+
+class _Response:
+    def __init__(self, body, peername):
+        self._body = body
+        self.connection = _Connection(peername) if peername else None
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+    async def read(self):
+        return self._body
+
+    async def text(self):
+        return self._body.decode('utf-8', errors='replace')
+
+
+class _RequestContextManager:
+    def __init__(self, url, timeout, proxy):
+        self._url = url
+        self._timeout = timeout
+        self._proxy = proxy
+        self._response = None
+
+    async def __aenter__(self):
+        loop = asyncio.get_running_loop()
+        body, peername = await loop.run_in_executor(
+            None, self._request)
+        self._response = _Response(body, peername)
+        return self._response
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+    def _request(self):
+        request = urllib.request.Request(self._url, headers={'User-Agent': 'Mozilla/5.0'})
+        handlers = []
+        peername = None
+        if self._proxy:
+            parsed = urllib.parse.urlparse(self._proxy)
+            if parsed.hostname and parsed.port:
+                peername = (parsed.hostname, parsed.port)
+            handlers.append(urllib.request.ProxyHandler({
+                'http': self._proxy,
+                'https': self._proxy,
+            }))
+        opener = urllib.request.build_opener(*handlers)
+        try:
+            with opener.open(request, timeout=self._timeout.total if self._timeout else None) as response:
+                return response.read(), peername
+        except (urllib.error.URLError, OSError) as exc:
+            raise ClientError(str(exc)) from exc
+
+
+class ClientSession:
+    def __init__(self, timeout=None):
+        self._timeout = timeout
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+    def get(self, url, proxy=None):
+        return _RequestContextManager(url, self._timeout, proxy)
