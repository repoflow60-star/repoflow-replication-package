+def _normalize_color(color):
+    shorthand = {
+        "k": "black",
+        "w": "white",
+        "r": "red",
+        "g": "green",
+        "b": "blue",
+        "c": "cyan",
+        "m": "magenta",
+        "y": "yellow",
+    }
+    if isinstance(color, str):
+        return shorthand.get(color, color)
+    return color
+
+
+def _force_color(value: float) -> str:
+    """Map a normalized force value to a red-gray-blue color."""
+
+    value = float(numpy.clip(value, 0.0, 1.0))
+    low = numpy.array([255, 0, 0], dtype=float)
+    mid = numpy.array([204, 204, 204], dtype=float)
+    high = numpy.array([0, 0, 255], dtype=float)
+    if value <= 0.5:
+        rgb = low + (mid - low) * (value / 0.5)
+    else:
+        rgb = mid + (high - mid) * ((value - 0.5) / 0.5)
+    rgb = numpy.clip(numpy.rint(rgb), 0, 255).astype(int)
+    return f"rgb({rgb[0]}, {rgb[1]}, {rgb[2]})"
+
+
+def _member_color(
+    member,
+    mode: Optional[Union[Literal["fos", "force"], PlotlyColor]],
+    force_scale: float,
+    fos_threshold: float,
+):
+    if mode == "fos":
+        return (
+            "green"
+            if numpy.min([member.fos_buckling, member.fos_yielding]) > fos_threshold
+            else "red"
+        )
+    if mode == "force":
+        return _force_color(member.force / (2 * force_scale) + 0.5)
+    return _normalize_color(mode)
 
 
