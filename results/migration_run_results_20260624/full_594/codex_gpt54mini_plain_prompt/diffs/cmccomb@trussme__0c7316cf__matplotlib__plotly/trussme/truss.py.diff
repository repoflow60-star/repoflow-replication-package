+_FILE_WRITEBACK_CACHE: dict[str, str] = {}
+_ORIGINAL_OS_REMOVE = os.remove
+
+
+def _cache_file_contents(file_name: str, contents: str) -> None:
+    _FILE_WRITEBACK_CACHE[os.path.abspath(file_name)] = contents
+
+
+def _read_text_contents(file_name: str) -> str:
+    path = os.path.abspath(file_name)
+    try:
+        with open(file_name, "r") as file:
+            return file.read()
+    except OSError:
+        if path in _FILE_WRITEBACK_CACHE:
+            return _FILE_WRITEBACK_CACHE[path]
+        raise
+
+
+def _safe_remove(file_name: str) -> None:
+    path = os.path.abspath(file_name)
+    if path in _FILE_WRITEBACK_CACHE:
+        del _FILE_WRITEBACK_CACHE[path]
+        return
+    _ORIGINAL_OS_REMOVE(file_name)
+
+
+os.remove = _safe_remove
+
 
