+        y0 = member.begin_joint.coordinates[1] + exaggeration_factor * member.begin_joint.deflections[1]
+        x1 = member.end_joint.coordinates[0] + exaggeration_factor * member.end_joint.deflections[0]
+        y1 = member.end_joint.coordinates[1] + exaggeration_factor * member.end_joint.deflections[1]
+    else:
+        x0 = member.begin_joint.coordinates[0]
+        y0 = member.begin_joint.coordinates[1]
+        x1 = member.end_joint.coordinates[0]
+        y1 = member.end_joint.coordinates[1]
+
+    return pandas.DataFrame(
+        {
+            "x": [x0, x1],
+            "y": [y0, y1],
+            "order": [0, 1],
+        }
+    )
 
 
