+AltairColor = Any
+"""Type: New type to represent a color, kept loose for compatibility."""
+MatplotlibColor = AltairColor
+"""Backward-compatible alias preserved for callers that imported the old name."""
+
+
+_MATPLOTLIB_SHORT_COLORS = {
+    "b": "#0000ff",
+    "g": "#008000",
+    "r": "#ff0000",
+    "c": "#00ffff",
+    "m": "#ff00ff",
+    "y": "#ffff00",
+    "k": "#000000",
+    "w": "#ffffff",
+}
+
+
+def _normalize_color(color: AltairColor) -> str:
+    if isinstance(color, str):
+        normalized = color.strip()
+        if normalized.lower() in _MATPLOTLIB_SHORT_COLORS:
+            return _MATPLOTLIB_SHORT_COLORS[normalized.lower()]
+        return normalized
+
+    if isinstance(color, (tuple, list, numpy.ndarray)):
+        values = list(color)
+        if len(values) not in (3, 4):
+            return str(color)
+
+        rgb = [int(round(float(channel) * 255.0)) for channel in values[:3]]
+        if len(values) == 4:
+            alpha = float(values[3])
+            return f"rgba({rgb[0]},{rgb[1]},{rgb[2]},{alpha})"
+
+        return "#{:02x}{:02x}{:02x}".format(*rgb)
+
+    return str(color)
+
+
+def _lerp_color(t: float, colors: list[tuple[float, float, float]]) -> str:
+    if t <= 0:
+        rgb = colors[0]
+    elif t >= 1:
+        rgb = colors[-1]
+    elif t < 0.5:
+        start = colors[0]
+        end = colors[1]
+        local_t = t / 0.5
+        rgb = tuple(start[i] + (end[i] - start[i]) * local_t for i in range(3))
+    else:
+        start = colors[1]
+        end = colors[2]
+        local_t = (t - 0.5) / 0.5
+        rgb = tuple(start[i] + (end[i] - start[i]) * local_t for i in range(3))
+
+    return "#{:02x}{:02x}{:02x}".format(
+        *[int(round(channel * 255.0)) for channel in rgb]
+    )
+
+
+def _force_color(force: float, scaler: float) -> str:
+    if scaler <= 0.0:
+        return "#cccccc"
+
+    t = force / (2.0 * scaler) + 0.5
+    return _lerp_color(t, [(1.0, 0.0, 0.0), (0.8, 0.8, 0.8), (0.0, 0.0, 1.0)])
+
+
+def _member_color(
+    member,
+    shape_style: Optional[Union[Literal["fos", "force"], AltairColor]],
+    fos_threshold: float,
+    scaler: float,
+) -> Optional[str]:
+    if shape_style is None:
+        return None
+    if shape_style == "fos":
+        return (
+            "#008000"
+            if numpy.min([member.fos_buckling, member.fos_yielding]) > fos_threshold
+            else "#ff0000"
+        )
+    if shape_style == "force":
+        return _force_color(member.force, scaler)
+    return _normalize_color(shape_style)
+
+
+def _member_data(member, exaggeration_factor: float = 1.0, deflected: bool = False) -> pandas.DataFrame:
+    if deflected:
