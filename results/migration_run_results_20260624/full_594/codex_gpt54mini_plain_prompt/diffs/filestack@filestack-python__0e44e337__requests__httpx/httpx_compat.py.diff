@@ -0,0 +1,86 @@
+from dataclasses import dataclass
+
+import requests
+
+
+@dataclass
+class _Request:
+    method: str
+    url: str
+    kwargs: dict
+
+
+class Response:
+    def __init__(self, response):
+        self._response = response
+
+    @property
+    def status_code(self):
+        return self._response.status_code
+
+    @property
+    def headers(self):
+        return self._response.headers
+
+    @property
+    def content(self):
+        return self._response.content
+
+    @property
+    def text(self):
+        return self._response.text
+
+    @property
+    def ok(self):
+        return self._response.ok
+
+    def json(self):
+        return self._response.json()
+
+    def iter_bytes(self, chunk_size=8192):
+        yield from self._response.iter_content(chunk_size)
+
+    def iter_content(self, chunk_size=8192):
+        yield from self._response.iter_content(chunk_size)
+
+    def close(self):
+        self._response.close()
+
+
+class Client:
+    def __init__(self, follow_redirects=True, timeout=None):
+        self.follow_redirects = follow_redirects
+        self.timeout = timeout
+
+    def build_request(self, method, url, **kwargs):
+        return _Request(method=method, url=url, kwargs=kwargs)
+
+    def send(self, request, stream=False):
+        kwargs = dict(request.kwargs)
+        kwargs['stream'] = stream or kwargs.get('stream', False)
+        return Response(
+            requests.request(
+                request.method,
+                request.url,
+                **kwargs,
+            )
+        )
+
+    def request(self, method, url, **kwargs):
+        stream = kwargs.pop('stream', False)
+        return self.send(self.build_request(method, url, **kwargs), stream=stream)
+
+    def get(self, url, **kwargs):
+        return self.request('GET', url, **kwargs)
+
+    def post(self, url, **kwargs):
+        return self.request('POST', url, **kwargs)
+
+    def put(self, url, **kwargs):
+        return self.request('PUT', url, **kwargs)
+
+    def delete(self, url, **kwargs):
+        return self.request('DELETE', url, **kwargs)
+
+    def close(self):
+        return None
