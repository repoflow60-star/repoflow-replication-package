+class AiohttpSession:
+    # Keep one loop/session alive so aiohttp can reuse connections like requests.Session did.
+    def __init__(self) -> None:
+        self._loop = asyncio.new_event_loop()
+        self._session: aiohttp.ClientSession | None = None
+        self._session_proxy_url: str | None = None
+        atexit.register(self.close)
+
+    def _proxy_url(self, proxies: dict[str, str] | None) -> str | None:
+        if not proxies:
+            return None
+        return proxies.get('https') or proxies.get('http')
+
+    def _connector(self, proxy_url: str | None) -> Any:
+        if not proxy_url or not proxy_url.startswith('socks'):
+            return None
+        if ProxyConnector is None:
+            raise RuntimeError(
+                'SOCKS proxy support requires aiohttp_socks to be installed',
+            )
+        return ProxyConnector.from_url(proxy_url)
+
+    async def _create_session(self, proxy_url: str | None) -> aiohttp.ClientSession:
+        connector = self._connector(proxy_url)
+        timeout = aiohttp.ClientTimeout(total=None)
+        return aiohttp.ClientSession(
+            connector=connector,
+            timeout=timeout,
+        )
+
+    def _ensure_session(self, proxies: dict[str, str] | None) -> None:
+        proxy_url = self._proxy_url(proxies)
+        if (
+            self._session is not None
+            and not self._session.closed
+            and proxy_url == self._session_proxy_url
+        ):
+            return
+
+        if self._session is not None and not self._session.closed:
+            self._loop.run_until_complete(self._session.close())
+
+        self._session_proxy_url = proxy_url
+        self._session = self._loop.run_until_complete(
+            self._create_session(proxy_url),
+        )
+
+    async def _request(
