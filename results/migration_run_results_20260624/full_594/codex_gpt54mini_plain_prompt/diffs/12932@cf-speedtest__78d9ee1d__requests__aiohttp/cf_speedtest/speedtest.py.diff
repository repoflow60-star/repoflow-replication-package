+        url: str,
+        *,
+        data: Any = None,
+        headers: dict[str, str] | None = None,
+        verify: bool = True,
+    ) -> AiohttpResponse:
+        request_kwargs: dict[str, Any] = {}
+        if data is not None:
+            request_kwargs['data'] = data
+        if headers is not None:
+            request_kwargs['headers'] = headers
