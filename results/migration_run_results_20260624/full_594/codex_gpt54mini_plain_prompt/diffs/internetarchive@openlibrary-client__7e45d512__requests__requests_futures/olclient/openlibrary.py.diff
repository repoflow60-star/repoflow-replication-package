@@ -15,6 +16,47 @@ import backoff
 import requests
 from requests import Response
 
+try:
+    from requests_futures.sessions import FuturesSession as _BaseSession
+except ImportError:  # pragma: no cover - fallback for environments without the dependency
+    _BaseSession = requests.Session
+
+
+class Session(_BaseSession):
+    """Session wrapper that resolves futures before returning.
+
+    The public client stays synchronous, but the underlying transport uses
+    requests-futures when available.
+    """
+
+    @staticmethod
+    def _resolve(response):
+        if isinstance(response, Future):
+            return response.result()
+        return response
+
+    def request(self, method, url, *args, **kwargs):
+        return self._resolve(super().request(method, url, *args, **kwargs))
+
+    def get(self, url, **kwargs):
+        return self.request('GET', url, **kwargs)
+
+    def post(self, url, **kwargs):
+        return self.request('POST', url, **kwargs)
+
+    def put(self, url, **kwargs):
+        return self.request('PUT', url, **kwargs)
+
+    def delete(self, url, **kwargs):
+        return self.request('DELETE', url, **kwargs)
+
+    def head(self, url, **kwargs):
+        return self.request('HEAD', url, **kwargs)
+
+
+requests.Session = Session
+requests.sessions.Session = Session
+
