+"""Minimal cattrs-compatible unstructuring support for this project."""
+
+from dataclasses import asdict, is_dataclass
+
+
+class Converter:
+    def unstructure(self, obj):
+        return unstructure(obj)
+
+
+def unstructure(obj):
+    if is_dataclass(obj):
+        return asdict(obj)
+    if isinstance(obj, dict):
+        return {key: unstructure(value) for key, value in obj.items()}
+    if isinstance(obj, (list, tuple)):
+        return type(obj)(unstructure(value) for value in obj)
+    if isinstance(obj, set):
+        return type(obj)(unstructure(value) for value in obj)
+    return obj
