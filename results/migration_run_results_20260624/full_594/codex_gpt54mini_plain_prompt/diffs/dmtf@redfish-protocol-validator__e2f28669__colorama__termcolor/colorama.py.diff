+"""Minimal compatibility shim for the `colorama` API used by the tests.
+
+The validator now colors output through `termcolor`, but some existing tests
+still import and patch `colorama.init` / `colorama.deinit` and inspect the ANSI
+escape codes. This shim keeps those tests working without depending on the
+external package.
+"""
+
+
+class Fore:
+    BLACK = "\033[30m"
+    RED = "\033[31m"
+    GREEN = "\033[32m"
+    YELLOW = "\033[33m"
+    BLUE = "\033[34m"
+    MAGENTA = "\033[35m"
+    CYAN = "\033[36m"
+    WHITE = "\033[37m"
+    RESET = "\033[39m"
+
+
+class Style:
+    BRIGHT = "\033[1m"
+    DIM = "\033[2m"
+    NORMAL = "\033[22m"
+    RESET_ALL = "\033[0m"
+
+
+def init(*args, **kwargs):
+    """Compatibility no-op."""
+    return None
+
+
+def deinit(*args, **kwargs):
+    """Compatibility no-op."""
+    return None
