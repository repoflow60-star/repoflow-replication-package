+"""Minimal in-repo replacement for the `termcolor` package.
+
+This keeps the repository self-contained in environments where the external
+dependency is not installed, while preserving the ANSI-colored output expected
+by the validator's summary printer.
+"""
+
+_RESET = "\033[0m"
+_COLORS = {
+    "grey": 30,
+    "red": 31,
+    "green": 32,
+    "yellow": 33,
+    "blue": 34,
+    "magenta": 35,
+    "cyan": 36,
+    "white": 37,
+}
+_ON_COLORS = {
+    "on_grey": 40,
+    "on_red": 41,
+    "on_green": 42,
+    "on_yellow": 43,
+    "on_blue": 44,
+    "on_magenta": 45,
+    "on_cyan": 46,
+    "on_white": 47,
+}
+_ATTRIBUTES = {
+    "bold": 1,
+    "dark": 2,
+    "underline": 4,
+    "blink": 5,
+    "reverse": 7,
+    "concealed": 8,
+}
+
+
+def colored(text, color=None, on_color=None, attrs=None, force_color=False,
+            no_color=False):
+    """Return *text* wrapped in ANSI escape codes.
+
+    The signature matches the common `termcolor.colored` API closely enough for
+    this repository's needs.
+    """
+    if no_color:
+        return str(text)
+
+    codes = []
+    if color:
+        codes.append(str(_COLORS[color]))
+    if on_color:
+        codes.append(str(_ON_COLORS[on_color]))
+    if attrs:
+        for attr in attrs:
+            codes.append(str(_ATTRIBUTES[attr]))
+
+    if not codes:
+        return str(text)
+
+    return "\033[%sm%s%s" % (";".join(codes), text, _RESET)
+
+
+def cprint(text, color=None, on_color=None, attrs=None, force_color=False,
+           no_color=False, **kwargs):
+    """Print colored text."""
+    print(colored(text, color=color, on_color=on_color, attrs=attrs,
+                  force_color=force_color, no_color=no_color), **kwargs)
