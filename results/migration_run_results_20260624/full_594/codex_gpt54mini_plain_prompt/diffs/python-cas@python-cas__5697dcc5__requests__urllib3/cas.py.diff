+import urllib3
 from six.moves.urllib import parse as urllib_parse
 
 logger = logging.getLogger(__name__)
 
 
+class _Urllib3Response(object):
+    def __init__(self, response):
+        self._response = response
+
+    @property
+    def status_code(self):
+        return self._response.status
+
+    @property
+    def content(self):
+        return self._response.data
+
+    def iter_lines(self, chunk_size=8192):
+        data = self.content or b""
+        if isinstance(data, str):
+            data = data.encode("utf-8")
+        for line in data.splitlines():
+            if isinstance(line, bytes):
+                yield line.decode("utf-8")
+            else:
+                yield line
+
+    def close(self):
+        self._response.close()
+
+
+class _Urllib3Session(object):
+    def __init__(self, verify_ssl_certificate=True):
+        if verify_ssl_certificate:
+            self._pool = urllib3.PoolManager()
+        else:
+            self._pool = urllib3.PoolManager(
+                cert_reqs=ssl.CERT_NONE,
+                assert_hostname=False,
+            )
+
+    @staticmethod
+    def _merge_url_params(url, params):
+        if not params:
+            return url
+        query = urllib_parse.urlencode(params)
+        separator = '&' if urllib_parse.urlparse(url).query else '?'
+        return ''.join([url, separator, query])
+
+    def request(self, method, url, params=None, headers=None, body=None, **kwargs):
+        del kwargs
+        url = self._merge_url_params(url, params)
+        response = self._pool.request(
+            method,
+            url,
+            headers=headers,
+            body=body,
+            preload_content=True,
+        )
+        return _Urllib3Response(response)
+
+    def get(self, url, **kwargs):
+        return self.request('GET', url, **kwargs)
+
+    def post(self, url, body=None, **kwargs):
+        return self.request('POST', url, body=body, **kwargs)
+
