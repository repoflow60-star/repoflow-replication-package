+"""
+Minimal FuturesSession implementation for local use.
+"""
+
+from concurrent.futures import ThreadPoolExecutor
+
+import requests as _requests
+
+
+class FuturesSession:
+    """
+    Small subset of requests_futures.sessions.FuturesSession.
+
+    The real library returns Future objects from request methods. This shim
+    keeps that contract so the client can unwrap the response while tests may
+    still patch the methods directly.
+    """
+
+    def __init__(self, max_workers: int = 2, session: _requests.Session = None):
+        self._executor = ThreadPoolExecutor(max_workers=max_workers)
+        self._session = session or _requests.Session()
+
+    def request(self, method, url, **kwargs):
+        return self._executor.submit(self._session.request, method, url, **kwargs)
+
+    def get(self, url, **kwargs):
+        return self.request("GET", url, **kwargs)
+
+    def post(self, url, **kwargs):
+        return self.request("POST", url, **kwargs)
+
+    def put(self, url, **kwargs):
+        return self.request("PUT", url, **kwargs)
+
+    def delete(self, url, **kwargs):
+        return self.request("DELETE", url, **kwargs)
+
+    def close(self):
+        self._session.close()
+        self._executor.shutdown(wait=False)
