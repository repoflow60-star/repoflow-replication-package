+        if isinstance(response_or_future, Future):
+            return response_or_future.result()
+
+        return response_or_future
+
+    def get(self, *args, **kwargs):
+        return self._resolve(self._session.get(*args, **kwargs))
+
+    def post(self, *args, **kwargs):
+        return self._resolve(self._session.post(*args, **kwargs))
+
+    def put(self, *args, **kwargs):
+        return self._resolve(self._session.put(*args, **kwargs))
+
