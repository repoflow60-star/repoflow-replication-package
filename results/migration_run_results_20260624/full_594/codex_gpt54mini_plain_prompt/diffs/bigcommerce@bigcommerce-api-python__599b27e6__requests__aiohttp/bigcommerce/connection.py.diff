+class _ResponseAdapter(object):
+    def __init__(self, status_code, reason, headers, content):
+        self.status_code = status_code
+        self.reason = reason
+        self.headers = headers
+        self.content = content
+
+    def json(self):
+        return loads(self.content.decode())
+
+
+class _SessionAdapter(object):
+    def __init__(self, auth=None, headers=None):
+        self.auth = auth
+        self.headers = dict(headers or {})
+
+    @staticmethod
+    def _basic_auth_header(auth):
+        if not auth:
+            return None
+        user, password = auth
+        token = base64.b64encode(("%s:%s" % (user, password)).encode()).decode()
+        return "Basic %s" % token
+
+    @staticmethod
+    def _normalize_headers(headers):
+        return dict(headers or {})
+
+    @staticmethod
+    def _encode_body(data, headers):
+        if data is None:
+            return None
+        if isinstance(data, (bytes, bytearray)):
+            return bytes(data)
+        if isinstance(data, str):
+            return data.encode()
+
+        content_type = headers.get("Content-Type", "")
+        if isinstance(data, dict):
+            if content_type.startswith("application/x-www-form-urlencoded"):
+                return urllib_urlencode(data).encode()
+            return dumps(data).encode()
+
+        return str(data).encode()
+
+    @staticmethod
+    def _run_async(coro):
+        try:
+            loop = asyncio.get_event_loop()
+        except RuntimeError:
+            loop = asyncio.new_event_loop()
+            asyncio.set_event_loop(loop)
+
+        if loop.is_running():
+            new_loop = asyncio.new_event_loop()
+            try:
+                return new_loop.run_until_complete(coro)
+            finally:
+                new_loop.close()
+
+        return loop.run_until_complete(coro)
+
+    def _request_with_aiohttp(self, method, url, data=None, timeout=None, headers=None):
+        headers = self._normalize_headers(headers)
+        merged_headers = dict(self.headers)
+        merged_headers.update(headers)
+        body = self._encode_body(data, merged_headers)
+        auth = self.auth
+        if aiohttp and auth and not isinstance(auth, aiohttp.BasicAuth):
+            auth = aiohttp.BasicAuth(*auth)
+
+        async def _do_request():
+            client_timeout = aiohttp.ClientTimeout(total=timeout) if timeout else None
+            async with aiohttp.ClientSession(headers=merged_headers, auth=auth, timeout=client_timeout) as session:
+                async with session.request(method, url, data=body) as response:
+                    content = await response.read()
+                    return _ResponseAdapter(response.status, response.reason, dict(response.headers), content)
+
+        return self._run_async(_do_request())
+
+    def _request_with_urllib(self, method, url, data=None, timeout=None, headers=None):
+        headers = self._normalize_headers(headers)
+        merged_headers = dict(self.headers)
+        merged_headers.update(headers)
+        body = self._encode_body(data, merged_headers)
+        if body is not None and "Content-Length" not in merged_headers:
+            merged_headers["Content-Length"] = str(len(body))
+
+        auth_header = self._basic_auth_header(self.auth)
+        if auth_header and "Authorization" not in merged_headers:
+            merged_headers["Authorization"] = auth_header
+
+        request = Request(url, data=body, headers=merged_headers, method=method)
+        try:
+            with urlopen(request, timeout=timeout) as response:
+                content = response.read()
+                return _ResponseAdapter(response.status, response.reason, dict(response.headers), content)
+        except HTTPError as exc:
+            content = exc.read()
+            return _ResponseAdapter(exc.code, exc.reason, dict(exc.headers), content)
+        except URLError:
+            raise
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        if aiohttp is not None:
+            return self._request_with_aiohttp(method, url, data=data, timeout=timeout, headers=headers)
+        return self._request_with_urllib(method, url, data=data, timeout=timeout, headers=headers)
+
