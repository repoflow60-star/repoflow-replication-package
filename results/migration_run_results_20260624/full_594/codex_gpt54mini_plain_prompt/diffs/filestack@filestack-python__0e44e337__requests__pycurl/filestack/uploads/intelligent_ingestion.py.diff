+def _post_with_retry(url, payload, headers, attempts=7, backoff_factor=0.2):
+    delay = backoff_factor
+    response = None
+
+    for attempt in range(attempts + 1):
+        response = requests.post(url, json=payload, headers=headers)
+        if response.status_code != 202:
+            return response
+        if attempt < attempts:
+            time.sleep(delay)
+            delay *= 2
+
+    return response
+
