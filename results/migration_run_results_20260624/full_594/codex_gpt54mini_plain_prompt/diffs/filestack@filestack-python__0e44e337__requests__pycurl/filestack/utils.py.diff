+def _default_headers():
+    headers = dict(config.HEADERS)
+    headers['Filestack-Trace-Id'] = '{}-{}'.format(int(time.time()), unique_id())
+    headers['Filestack-Trace-Span'] = 'pythonsdk-{}'.format(unique_id())
+    return headers
+
+
+def _append_params(url, params):
+    if not params:
+        return url
+
+    split_url = urlsplit(url)
+    query_params = parse_qsl(split_url.query, keep_blank_values=True)
+    query_params.extend([(key, value) for key, value in params.items() if value is not None])
+    query = urlencode(query_params, doseq=True)
+    return urlunsplit((split_url.scheme, split_url.netloc, split_url.path, query, split_url.fragment))
+
+
+def _read_body_value(value):
+    if hasattr(value, 'read'):
+        return value.read()
+    return value
+
+
+def _build_multipart_body(data, files):
+    boundary = '----FilestackBoundary{}'.format(unique_id(24))
+    body = io.BytesIO()
+
+    def write_line(line):
+        if isinstance(line, str):
+            line = line.encode('utf-8')
+        body.write(line)
+
+    for name, value in (data or {}).items():
+        write_line('--{}\r\n'.format(boundary))
+        write_line('Content-Disposition: form-data; name="{}"\r\n\r\n'.format(name))
+        if isinstance(value, bytes):
+            body.write(value)
+        else:
+            write_line(str(value))
+        write_line('\r\n')
+
+    for field_name, field_value in (files or {}).items():
+        filename = field_name
+        content_type = 'application/octet-stream'
+        file_value = field_value
+
+        if isinstance(field_value, tuple):
+            if len(field_value) >= 1:
+                filename = field_value[0]
+            if len(field_value) >= 2:
+                file_value = field_value[1]
+            if len(field_value) >= 3 and field_value[2] is not None:
+                content_type = field_value[2]
+
+        file_content = _read_body_value(file_value)
+        if isinstance(file_content, str):
+            file_content = file_content.encode('utf-8')
+
+        write_line('--{}\r\n'.format(boundary))
+        write_line(
+            'Content-Disposition: form-data; name="{}"; filename="{}"\r\n'.format(field_name, filename)
+        )
+        write_line('Content-Type: {}\r\n\r\n'.format(content_type))
+        body.write(file_content)
+        write_line('\r\n')
+
+    write_line('--{}--\r\n'.format(boundary))
+    return body.getvalue(), 'multipart/form-data; boundary={}'.format(boundary)
+
+
+def _build_request_body(kwargs, headers):
+    json_payload = kwargs.pop('json', None)
+    data = kwargs.pop('data', None)
+    files = kwargs.pop('files', None)
+
+    if json_payload is not None:
+        headers.setdefault('Content-Type', 'application/json')
+        return json.dumps(json_payload).encode('utf-8')
+
+    if files is not None:
+        body, content_type = _build_multipart_body(data if isinstance(data, dict) else {}, files)
+        headers.setdefault('Content-Type', content_type)
+        return body
+
+    if data is None:
+        return b''
+
+    if isinstance(data, dict):
+        headers.setdefault('Content-Type', 'application/x-www-form-urlencoded')
+        return urlencode(data, doseq=True).encode('utf-8')
+
+    if isinstance(data, str):
+        return data.encode('utf-8')
+
+    if isinstance(data, bytes):
+        return data
+
+    body = _read_body_value(data)
+    if isinstance(body, str):
+        return body.encode('utf-8')
+    if body is None:
+        return b''
+    return body
+
+
+def _parse_response_headers(raw_headers):
+    header_block = raw_headers.decode('iso-8859-1', errors='replace')
+    headers = CaseInsensitiveHeaders()
+    for line in header_block.splitlines():
+        if not line or line.startswith('HTTP/'):
+            continue
+        if ':' not in line:
+            continue
+        key, value = line.split(':', 1)
+        headers[key.strip()] = value.strip()
+    return headers
+
+
+def _perform_pycurl_request(method, url, headers, body, stream=False):
+    if pycurl is None:
+        raise RuntimeError('pycurl is required for the pycurl transport backend')
+
+    buffer = io.BytesIO()
+    header_buffer = io.BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url.encode('utf-8'))
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.NOSIGNAL, 1)
+        curl.setopt(pycurl.WRITEFUNCTION, buffer.write)
+        curl.setopt(pycurl.HEADERFUNCTION, header_buffer.write)
+        curl.setopt(pycurl.CUSTOMREQUEST, method)
+        if headers:
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                ['{}: {}'.format(key, value) for key, value in headers.items()]
+            )
+        if body is not None:
+            curl.setopt(pycurl.POSTFIELDS, body)
+            curl.setopt(pycurl.POSTFIELDSIZE, len(body))
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        effective_url = curl.getinfo(pycurl.EFFECTIVE_URL) or url
+    finally:
+        curl.close()
+
+    response_headers = _parse_response_headers(header_buffer.getvalue())
+    return PycurlResponse(effective_url, status_code, response_headers, buffer.getvalue())
