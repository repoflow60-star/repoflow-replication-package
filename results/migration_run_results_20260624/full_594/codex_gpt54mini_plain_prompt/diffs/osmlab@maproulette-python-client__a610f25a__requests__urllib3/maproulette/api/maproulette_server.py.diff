+        self.session = requests.Session()
+        self.session.headers = self.headers
+        self.session.verify = self.verify
+        self.session.cert = self.certs
+
+    @staticmethod
+    def _status_code(response):
+        status = getattr(response, "status_code", None)
+        return status if isinstance(status, int) else None
+
+    @staticmethod
+    def _is_connection_exception(exception):
+        return exception.__class__.__name__ in {
+            "ConnectionError",
+            "ConnectTimeout",
+            "ReadTimeout",
+            "Timeout",
+            "TimeoutError",
+        }
+
+    @staticmethod
+    def _is_http_exception(exception):
+        return exception.__class__.__name__ == "HTTPError" or getattr(exception, "response", None) is not None
+
+    @staticmethod
+    def _response_message(response):
+        if response is None:
+            return None
+        try:
+            text = getattr(response, "text", "")
+            if not isinstance(text, str):
+                text = str(text)
+            return json.loads(text)["message"]
+        except (TypeError, ValueError, KeyError):
+            return None
+
+    def _raise_connection_error(self, exception, response=None):
+        response = response or getattr(exception, "response", None)
+        raise ConnectionUnavailableError(
+            message=self._response_message(response) or str(exception) or None,
+            status=self._status_code(response),
+        ) from None
+
+    def _raise_http_error(self, response):
+        status = self._status_code(response)
+        message = self._response_message(response)
+        if status == 400:
+            raise InvalidJsonError(message=message, status=status) from None
+        if status == 401:
+            raise UnauthorizedError(message=message, status=status) from None
+        if status == 404:
+            raise NotFoundError(message=message, status=status) from None
+        raise HttpError(message=message, status=status) from None
+
+    def _request(self, request_func, *args, **kwargs):
+        try:
+            response = request_func(*args, **kwargs)
+        except Exception as exception:
+            if self._is_connection_exception(exception):
+                self._raise_connection_error(exception)
+            raise
+
+        try:
+            response.raise_for_status()
+        except Exception as exception:
+            if self._is_connection_exception(exception):
+                self._raise_connection_error(exception, response=response)
+            if self._is_http_exception(exception):
+                self._raise_http_error(getattr(exception, "response", None) or response)
+            raise
+
+        return response
 
