index 0000000..543aa3f
--- /dev/null
+++ b/maproulette/api/requests_compat.py
@@ -0,0 +1,193 @@
+"""Compatibility helpers that expose a requests-like API backed by urllib3."""
+
+import json
+import ssl
+from types import SimpleNamespace
+from urllib.parse import urlencode
+
+import urllib3
+from urllib3 import exceptions as u3_exc
+
+
+class Response:
+    """Small wrapper that mirrors the parts of ``requests.Response`` that this package uses."""
+
+    def __init__(self, raw_response):
+        self._raw_response = raw_response
+        self.status_code = getattr(raw_response, "status", None)
+        self.reason = getattr(raw_response, "reason", None)
+        self.headers = dict(getattr(raw_response, "headers", {}) or {})
+
+    @property
+    def ok(self):
+        return self.status_code is not None and self.status_code < 400
+
+    @property
+    def text(self):
+        data = getattr(self._raw_response, "data", b"")
+        if data is None:
+            return ""
+        if isinstance(data, bytes):
+            return data.decode("utf-8", errors="replace")
+        return str(data)
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if self.ok:
+            return None
+        raise HTTPError(response=self)
+
+
+class HTTPError(Exception):
+    def __init__(self, message=None, response=None):
+        super().__init__(message)
+        self.response = response
+
+
+class ConnectionError(Exception):
+    pass
+
+
+class Timeout(Exception):
+    pass
+
+
+exceptions = SimpleNamespace(
+    HTTPError=HTTPError,
+    ConnectionError=ConnectionError,
+    Timeout=Timeout,
+)
+
+
+def _build_pool_manager(verify=True, cert=None):
+    cert_reqs = ssl.CERT_REQUIRED if verify else ssl.CERT_NONE
+    pool_kwargs = {"cert_reqs": cert_reqs}
+    if cert:
+        if isinstance(cert, tuple):
+            if len(cert) > 0:
+                pool_kwargs["cert_file"] = cert[0]
+            if len(cert) > 1:
+                pool_kwargs["key_file"] = cert[1]
+        else:
+            pool_kwargs["cert_file"] = cert
+    return urllib3.PoolManager(**pool_kwargs)
+
+
+def _normalize_params(params):
+    if not params:
+        return ""
+    return urlencode(params, doseq=True)
+
+
+def _append_params(url, params):
+    query_string = _normalize_params(params)
+    if not query_string:
+        return url
+    separator = "&" if "?" in url else "?"
+    return f"{url}{separator}{query_string}"
+
+
+def _wrap_urllib3_error(exc):
+    if isinstance(exc, (u3_exc.ConnectTimeoutError, u3_exc.ReadTimeoutError, u3_exc.TimeoutError)):
+        return Timeout(str(exc))
+    return ConnectionError(str(exc))
+
+
+class Session:
+    def __init__(self):
+        self.headers = {}
+        self.verify = True
+        self.cert = None
+
+    def _request(self, method, url, params=None, json_body=None, fields=None):
+        manager = _build_pool_manager(verify=self.verify, cert=self.cert)
+        request_headers = dict(self.headers or {})
+        body = None
+
+        if json_body is not None:
+            request_headers.setdefault("Content-Type", "application/json")
+            body = json.dumps(json_body).encode("utf-8")
+
+        request_url = _append_params(url, params)
+
+        try:
+            raw_response = manager.request(
+                method=method,
+                url=request_url,
+                body=body,
+                fields=fields,
+                headers=request_headers or None,
+                preload_content=True,
+            )
+        except (u3_exc.ConnectTimeoutError, u3_exc.ReadTimeoutError, u3_exc.TimeoutError) as exc:
+            raise Timeout(str(exc)) from exc
+        except (
+            u3_exc.MaxRetryError,
+            u3_exc.NewConnectionError,
+            u3_exc.ProtocolError,
+            u3_exc.NameResolutionError,
+            u3_exc.SSLError,
+            u3_exc.LocationParseError,
+            u3_exc.LocationValueError,
+            u3_exc.ProxyError,
+            u3_exc.ClosedPoolError,
+            u3_exc.EmptyPoolError,
+            u3_exc.FullPoolError,
+            u3_exc.PoolError,
+            u3_exc.ConnectionError,
+            u3_exc.HTTPError,
+        ) as exc:
+            raise _wrap_urllib3_error(exc) from exc
+
+        return Response(raw_response)
+
+    def request(self, method, url, params=None, json=None, files=None):
+        return self._request(method, url, params=params, json_body=json, fields=files)
+
+    def get(self, url, params=None):
+        return self._request("GET", url, params=params)
+
+    def post(self, url, params=None, json=None):
+        return self._request("POST", url, params=params, json_body=json)
+
+    def put(self, url, params=None, json=None, files=None):
+        if files is not None:
+            return self._request("PUT", url, params=params, fields=files)
+        return self._request("PUT", url, params=params, json_body=json)
+
+    def delete(self, url, params=None):
+        return self._request("DELETE", url, params=params)
+
+
+def get(url, headers=None, verify=True, cert=None):
+    session = Session()
+    session.headers = headers or {}
+    session.verify = verify
+    session.cert = cert
+    return session.get(url)
+
+
+def post(url, headers=None, verify=True, cert=None, params=None, json=None):
+    session = Session()
+    session.headers = headers or {}
+    session.verify = verify
+    session.cert = cert
+    return session.post(url, params=params, json=json)
+
+
+def put(url, headers=None, verify=True, cert=None, params=None, json=None, files=None):
+    session = Session()
+    session.headers = headers or {}
+    session.verify = verify
+    session.cert = cert
+    return session.put(url, params=params, json=json, files=files)
+
+
+def delete(url, headers=None, verify=True, cert=None, params=None):
+    session = Session()
+    session.headers = headers or {}
+    session.verify = verify
+    session.cert = cert
+    return session.delete(url, params=params)
