+    def _response_from_raw(
+        self, status_code: int, header_lines: List[str], body: bytes
+    ) -> _Response:
+        headers: Dict[str, str] = {}
+        for line in header_lines:
+            stripped = line.strip()
+            if not stripped:
+                continue
+            if stripped.startswith("HTTP/"):
+                headers = {}
+                continue
+            if ":" not in stripped:
+                continue
+            name, value = stripped.split(":", 1)
+            headers[name.strip().lower()] = value.strip()
+
+        content_type = headers.get("content-type", "")
+        text = body.decode(self._response_encoding(content_type), errors="replace")
+        return _Response(status_code=status_code, headers=headers, text=text)
