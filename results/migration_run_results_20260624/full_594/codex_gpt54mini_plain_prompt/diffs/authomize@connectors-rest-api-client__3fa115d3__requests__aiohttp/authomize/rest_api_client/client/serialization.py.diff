+import inspect
+from functools import wraps
+from typing import Any, Callable, Dict, Optional, Tuple, Type, Union, get_type_hints
+
+from pydantic import BaseModel, parse_obj_as
+
+
+def serialize_response(schema: Optional[Type[BaseModel]] = None) -> Callable:
+    def decorator(func: Callable) -> Callable:
+        nonlocal schema
+        if not schema:
+            schema = get_type_hints(func).get('return')
+
+        @wraps(func)
+        async def async_wrap(*args: Tuple[Any], **kwargs: Dict[str, Any]) -> Union[BaseModel, Any]:
+            response = await func(*args, **kwargs)
+            if isinstance(response, (list, dict, tuple, set)) and schema:
+                return parse_obj_as(schema, response)
+            return response
+
+        @wraps(func)
+        def sync_wrap(*args: Tuple[Any], **kwargs: Dict[str, Any]) -> Union[BaseModel, Any]:
+            response = func(*args, **kwargs)
+            if inspect.isawaitable(response):
+                async def _await_response():
+                    awaited = await response
+                    if isinstance(awaited, (list, dict, tuple, set)) and schema:
+                        return parse_obj_as(schema, awaited)
+                    return awaited
+
+                return _await_response()
+            if isinstance(response, (list, dict, tuple, set)) and schema:
+                return parse_obj_as(schema, response)
+            return response
+
+        return async_wrap if inspect.iscoroutinefunction(func) else sync_wrap
+
+    return decorator
+
+
+def serialize_all_methods(decorator=serialize_response):
+    def decorate(cls):
+        for attr, value in vars(cls).items():
+            if not attr.startswith('_') and (inspect.ismethod(value) or inspect.isfunction(value)):
+                setattr(cls, attr, decorator()(value))
+        return cls
+
+    return decorate
