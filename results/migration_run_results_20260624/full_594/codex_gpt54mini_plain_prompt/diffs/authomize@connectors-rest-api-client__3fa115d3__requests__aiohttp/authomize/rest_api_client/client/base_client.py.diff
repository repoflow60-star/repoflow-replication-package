+class _FallbackClientResponse:
+    def __init__(self, status: int, headers: Dict[str, str], body: bytes, url: str):
+        self.status = status
+        self.headers = headers
+        self._body = body
+        self.url = url
+        self.reason = ''
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status < 300
+
+    @property
+    def content(self) -> bytes:
+        return self._body
+
+    @property
+    def content_type(self) -> str:
+        return self.headers.get('content-type', '')
+
+    async def text(self) -> str:
+        charset = 'utf-8'
+        content_type = self.headers.get('content-type', '')
+        if 'charset=' in content_type:
+            charset = content_type.split('charset=', 1)[1].split(';', 1)[0].strip()
+        return self._body.decode(charset, errors='replace')
+
+    async def json(self, content_type=None):
+        return json.loads(await self.text())
+
+    def raise_for_status(self):
+        if not self.ok:
+            raise urllib_error.HTTPError(
+                url=self.url,
+                code=self.status,
+                msg=self.reason or 'HTTP error',
+                hdrs=None,
+                fp=None,
+            )
+
+
+class _FallbackRequestContextManager:
+    def __init__(self, method: str, url: str, *, params=None, headers=None, data=None):
+        self.method = method
+        self.url = url
+        self.params = params
+        self.headers = headers or {}
+        self.data = data
+        self._response = None
+
+    def _perform(self):
+        request_url = self.url
+        if self.params is not None:
+            query = urllib_parse.urlencode(self.params, doseq=True)
+            if query:
+                separator = '&' if urllib_parse.urlparse(request_url).query else '?'
+                request_url = f'{request_url}{separator}{query}'
+
+        payload = self.data
+        if isinstance(payload, str):
+            payload = payload.encode('utf-8')
+        request = urllib_request.Request(
+            request_url,
+            data=payload,
+            method=self.method,
+            headers=self.headers,
+        )
+
+        try:
+            with urllib_request.urlopen(request) as response:
+                body = response.read()
+                headers = dict(response.headers.items())
+                return _FallbackClientResponse(
+                    status=response.status,
+                    headers=headers,
+                    body=body,
+                    url=response.geturl(),
+                )
+        except urllib_error.HTTPError as exc:
+            body = exc.read() if exc.fp else b''
+            headers = dict(exc.headers.items()) if exc.headers else {}
+            return _FallbackClientResponse(
+                status=exc.code,
+                headers=headers,
+                body=body,
+                url=exc.geturl() or request_url,
+            )
+
+    async def __aenter__(self):
+        self._response = await asyncio.to_thread(self._perform)
+        return self._response
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+
+class _FallbackClientSession:
