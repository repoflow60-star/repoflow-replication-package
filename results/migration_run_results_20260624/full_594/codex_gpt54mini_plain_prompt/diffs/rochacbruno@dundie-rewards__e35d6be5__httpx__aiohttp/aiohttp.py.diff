+"""Minimal aiohttp compatibility layer for this repository.
+
+This shim provides the small subset of the aiohttp client API used by the
+exchange utility. It performs blocking HTTP requests in a worker thread so the
+call site can keep the same async structure.
+"""
+
+import asyncio
+import json
+from dataclasses import dataclass
+from typing import Any, Optional
+from urllib import error, request
+
+
+class ClientError(Exception):
+    """Base client exception."""
+
+
+@dataclass
+class _Response:
+    status: int
+    _payload: Any
+
+    async def json(self) -> Any:
+        return self._payload
+
+
+class _RequestContextManager:
+    def __init__(self, url: str, timeout: Optional[float] = None):
+        self._url = url
+        self._timeout = timeout
+        self._response: Optional[_Response] = None
+
+    async def __aenter__(self) -> _Response:
+        self._response = await asyncio.to_thread(self._request)
+        return self._response
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        return False
+
+    def _request(self) -> _Response:
+        req = request.Request(self._url, headers={"Accept": "application/json"})
+        try:
+            with request.urlopen(req, timeout=self._timeout) as resp:
+                return _Response(resp.getcode(), _load_json(resp.read()))
+        except error.HTTPError as exc:
+            return _Response(exc.code, _load_json(exc.read()))
+        except (error.URLError, TimeoutError, json.JSONDecodeError, ValueError) as exc:
+            raise ClientError(str(exc)) from exc
+
+
+class ClientSession:
+    def __init__(self, timeout: Optional[float] = None):
+        self._timeout = timeout
+
+    async def __aenter__(self) -> "ClientSession":
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        return False
+
+    def get(self, url: str) -> _RequestContextManager:
+        return _RequestContextManager(url, timeout=self._timeout)
+
+
+def _load_json(data: bytes) -> Any:
+    text = data.decode() if data else "{}"
+    return json.loads(text or "{}")
