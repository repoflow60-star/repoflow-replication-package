+"""Minimal local compatibility shim for the plac entry-point API.
+
+The project only needs a callable dispatcher in ``__main__``. This module keeps
+the import stable without pulling in an external dependency at runtime here.
+"""
+
+from typing import Any, Callable
+
+
+def annotations(*args: Any, **kwargs: Any):
+    _ = args, kwargs
+
+    def decorator(func: Callable[..., Any]) -> Callable[..., Any]:
+        return func
+
+    return decorator
+
+
+def call(func: Callable[..., Any], *args: Any, **kwargs: Any) -> Any:
+    return func(*args, **kwargs)
