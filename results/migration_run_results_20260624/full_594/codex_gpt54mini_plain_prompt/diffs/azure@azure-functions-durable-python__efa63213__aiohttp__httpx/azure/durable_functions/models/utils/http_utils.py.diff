+def _parse_response_body(response: httpx.Response) -> Any:
+    """Parse a response body as JSON when possible, otherwise as text."""
+    if not response.content:
+        return ""
+
+    try:
+        data = response.json()
+    except (json.JSONDecodeError, ValueError):
+        return response.text
+
+    if data is None:
+        return ""
+
+    return data
 
 
