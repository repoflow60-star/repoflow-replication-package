@@ -0,0 +1,60 @@
+from __future__ import annotations
+
+from dataclasses import fields, is_dataclass
+from pathlib import Path
+from typing import Any, Callable, Dict, List, Mapping, TypeVar, Union, get_args, get_origin
+
+T = TypeVar("T")
+
+
+class Converter:
+    def __init__(self) -> None:
+        self._structure_hooks: Dict[Any, Callable[[Any, Any], Any]] = {}
+
+    def register_structure_hook(self, typ: Any, func: Callable[[Any, Any], Any]) -> None:
+        self._structure_hooks[typ] = func
+
+    def structure(self, obj: Any, typ: Any) -> T:
+        hook = self._structure_hooks.get(typ)
+        if hook is not None:
+            return hook(obj, typ)
+
+        if typ is Any or typ is object:
+            return obj
+
+        if typ is Path:
+            return Path(obj)  # type: ignore[return-value]
+
+        origin = get_origin(typ)
+        if origin is Union:
+            if obj is None:
+                return None  # type: ignore[return-value]
+
+            for arg in get_args(typ):
+                if arg is type(None):
+                    continue
+                try:
+                    return self.structure(obj, arg)
+                except (TypeError, ValueError, KeyError):
+                    continue
+            return obj
+
+        if is_dataclass(typ):
+            if not isinstance(obj, Mapping):
+                raise TypeError(f"Expected mapping for dataclass {typ!r}")
+
+            kwargs = {}
+            for field in fields(typ):
+                if field.name in obj:
+                    kwargs[field.name] = self.structure(obj[field.name], field.type)
+            return typ(**kwargs)  # type: ignore[return-value]
+
+        if origin in (list, List):
+            if isinstance(obj, str):
+                return obj  # type: ignore[return-value]
+
+            args = get_args(typ)
+            item_type = args[0] if args else Any
+            return [self.structure(item, item_type) for item in obj]  # type: ignore[return-value]
+
+        return obj
