+"""Compatibility implementation of :mod:`requests_futures.sessions`."""
+
+from concurrent.futures import ThreadPoolExecutor
+
+import requests
+
+
+class FuturesSession(requests.Session):
+    """A requests.Session that submits requests to a thread pool."""
+
+    def __init__(self, executor=None, session=None, max_workers=8, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.executor = executor or ThreadPoolExecutor(max_workers=max_workers)
+        if session is not None:
+            self.headers.update(session.headers)
+            self.cookies.update(session.cookies)
+            self.auth = session.auth
+            self.proxies = session.proxies.copy()
+            self.hooks = session.hooks.copy()
+            self.params = session.params.copy()
+            self.verify = session.verify
+            self.cert = session.cert
+            self.trust_env = session.trust_env
+
+    def request(self, method, url, *args, **kwargs):
+        """Return a future for the request rather than a response."""
+        return self.executor.submit(super().request, method, url, *args, **kwargs)
+
+    def close(self):
+        """Close the session and release the executor."""
+        try:
+            super().close()
+        finally:
+            if self.executor is not None:
+                try:
+                    self.executor.shutdown(wait=False, cancel_futures=True)
+                except TypeError:
+                    self.executor.shutdown(wait=False)
