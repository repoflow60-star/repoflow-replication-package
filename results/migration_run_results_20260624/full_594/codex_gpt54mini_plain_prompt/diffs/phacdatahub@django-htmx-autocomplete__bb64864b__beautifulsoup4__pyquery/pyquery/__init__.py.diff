+"""Lightweight HTML query helpers used as a local pyquery replacement.
+
+This project only needs a small subset of HTML querying functionality in tests
+and development helpers. The implementation below supports the selectors used
+by the repository: tag, id, class, attribute equality, descendant and child
+combinators, plus ``select`` / ``select_one`` / text access.
+"""
+
+from __future__ import annotations
+
+from html.parser import HTMLParser
+from dataclasses import dataclass, field
+from typing import Iterable, Iterator
+
+
+@dataclass
+class _Node:
+    tag: str
+    attrs: dict[str, str | None] = field(default_factory=dict)
+    children: list["_Node"] = field(default_factory=list)
+    parent: "_Node | None" = None
+    _content: list[object] = field(default_factory=list)
+
+    def add_child(self, child: "_Node") -> None:
+        child.parent = self
+        self.children.append(child)
+        self._content.append(child)
+
+    def add_text(self, text: str) -> None:
+        self._content.append(text)
+
+    def iter_descendants(self) -> Iterator["_Node"]:
+        for child in self.children:
+            yield child
+            yield from child.iter_descendants()
+
+    def get_text(self, separator: str = "", strip: bool = False) -> str:
+        parts: list[str] = []
+        for item in self._content:
+            if isinstance(item, _Node):
+                part = item.get_text(separator=separator, strip=False)
+            else:
+                part = str(item)
+            if part:
+                parts.append(part)
+
+        text = separator.join(parts)
+        if strip:
+            return text.strip()
+        return text
+
+
+class _TreeBuilder(HTMLParser):
+    def __init__(self):
+        super().__init__(convert_charrefs=True)
+        self.root = _Node(tag="#document")
+        self._stack = [self.root]
+
+    @property
+    def current(self) -> _Node:
+        return self._stack[-1]
+
+    def handle_starttag(self, tag, attrs):
+        node = _Node(tag=tag.lower(), attrs={k: v for k, v in attrs})
+        self.current.add_child(node)
+        self._stack.append(node)
+
+    def handle_startendtag(self, tag, attrs):
+        node = _Node(tag=tag.lower(), attrs={k: v for k, v in attrs})
+        self.current.add_child(node)
+
+    def handle_endtag(self, tag):
+        lowered = tag.lower()
+        for index in range(len(self._stack) - 1, 0, -1):
+            if self._stack[index].tag == lowered:
+                del self._stack[index:]
+                break
+
+    def handle_data(self, data):
+        if data:
+            self.current.add_text(data)
+
+
+def _parse_html(content: str) -> _Node:
+    parser = _TreeBuilder()
+    parser.feed(content)
+    parser.close()
+    return parser.root
+
+
+def _split_selector(selector: str) -> list[tuple[str | None, str]]:
+    tokens: list[tuple[str | None, str]] = []
+    buf: list[str] = []
+    combinator: str | None = None
+    bracket_depth = 0
+    quote: str | None = None
+    i = 0
+
+    while i < len(selector):
+        ch = selector[i]
+        if quote is not None:
+            buf.append(ch)
+            if ch == quote:
+                quote = None
+            i += 1
+            continue
+
+        if ch in ("'", '"') and bracket_depth > 0:
+            quote = ch
+            buf.append(ch)
+            i += 1
+            continue
+
+        if ch == "[":
+            bracket_depth += 1
+            buf.append(ch)
+            i += 1
+            continue
+
+        if ch == "]":
+            bracket_depth = max(0, bracket_depth - 1)
+            buf.append(ch)
+            i += 1
+            continue
+
+        if bracket_depth == 0 and ch == ">":
+            if buf:
+                tokens.append((combinator, "".join(buf).strip()))
+                buf = []
+            combinator = ">"
+            i += 1
+            while i < len(selector) and selector[i].isspace():
+                i += 1
+            continue
+
+        if bracket_depth == 0 and ch.isspace():
+            if buf:
+                tokens.append((combinator, "".join(buf).strip()))
+                buf = []
+                combinator = " "
+            i += 1
+            while i < len(selector) and selector[i].isspace():
+                i += 1
+            continue
+
+        buf.append(ch)
+        i += 1
+
+    if buf:
+        tokens.append((combinator, "".join(buf).strip()))
+
+    return [(comb, token) for comb, token in tokens if token]
+
+
+def _parse_simple_selector(selector: str) -> dict:
+    result = {"tag": None, "id": None, "classes": [], "attrs": [], "not": []}
+    i = 0
+    special = {"#", ".", "["}
+    terminators = {"#", ".", "[", ":", " ", ">", ")"}
+
+    if i < len(selector) and selector[i] not in special:
+        start = i
+        while i < len(selector) and selector[i] not in terminators:
+            i += 1
+        result["tag"] = selector[start:i].strip().lower()
+
+    while i < len(selector):
+        ch = selector[i]
+        if ch == "#":
+            i += 1
+            start = i
+            while i < len(selector) and selector[i] not in terminators:
+                i += 1
+            result["id"] = selector[start:i].strip()
+            continue
+
+        if ch == ".":
+            i += 1
+            start = i
+            while i < len(selector) and selector[i] not in terminators:
+                i += 1
+            result["classes"].append(selector[start:i].strip())
+            continue
+
+        if ch == "[":
+            end = selector.find("]", i + 1)
+            if end == -1:
+                raise ValueError(f"Unclosed attribute selector: {selector}")
+            expr = selector[i + 1 : end].strip()
+            if "=" in expr:
+                name, value = expr.split("=", 1)
+                value = value.strip().strip('"').strip("'")
+                result["attrs"].append((name.strip(), value))
+            else:
+                result["attrs"].append((expr, None))
+            i = end + 1
+            continue
+
+        if selector.startswith(":not(", i):
+            start = i + len(":not(")
+            depth = 1
+            j = start
+            quote = None
+            while j < len(selector) and depth > 0:
+                current = selector[j]
+                if quote is not None:
+                    if current == quote:
+                        quote = None
+                else:
+                    if current in ("'", '"'):
+                        quote = current
+                    elif current == "(":
+                        depth += 1
+                    elif current == ")":
+                        depth -= 1
+                        if depth == 0:
+                            break
+                j += 1
+
+            if depth != 0:
+                raise ValueError(f"Unclosed :not selector: {selector}")
+
+            inner = selector[start:j].strip()
+            if inner:
+                result["not"].append(_parse_simple_selector(inner))
+            i = j + 1
+            continue
+
+        i += 1
+
+    return result
+
+
+def _matches(node: _Node, selector: dict) -> bool:
+    if selector["tag"] and node.tag != selector["tag"]:
+        return False
+
+    node_id = node.attrs.get("id")
+    if selector["id"] is not None and node_id != selector["id"]:
+        return False
+
+    if selector["classes"]:
+        class_attr = node.attrs.get("class", "") or ""
+        node_classes = set(class_attr.split())
+        if any(class_name not in node_classes for class_name in selector["classes"]):
+            return False
+
+    for name, expected in selector["attrs"]:
+        if name not in node.attrs:
+            return False
+        if expected is not None and node.attrs.get(name) != expected:
+            return False
+
+    for negative in selector["not"]:
+        if _matches(node, negative):
+            return False
+
+    return True
+
+
+def _select_from(nodes: Iterable[_Node], selector: str) -> list[_Node]:
+    tokens = _split_selector(selector)
+    if not tokens:
+        return []
+
+    current: list[_Node] = list(nodes)
+    for index, (combinator, token) in enumerate(tokens):
+        simple = _parse_simple_selector(token)
+        next_nodes: list[_Node] = []
+        search_nodes: Iterable[_Node]
+
+        if index == 0:
+            search_nodes = []
+            for node in current:
+                search_nodes = [*search_nodes, *node.iter_descendants()]
+        else:
+            search_nodes = []
+            for node in current:
+                if combinator == ">":
+                    search_nodes = [*search_nodes, *node.children]
+                else:
+                    search_nodes = [*search_nodes, *node.iter_descendants()]
+
+        for node in search_nodes:
+            if _matches(node, simple):
+                next_nodes.append(node)
+
+        current = next_nodes
+
+    seen: set[int] = set()
+    ordered: list[_Node] = []
+    for node in current:
+        marker = id(node)
+        if marker in seen:
+            continue
+        seen.add(marker)
+        ordered.append(node)
+    return ordered
+
+
+class PyQuery:
+    def __init__(self, content, parser: str = "html.parser"):
+        if isinstance(content, _Node):
+            self._node = content
+        else:
+            if isinstance(content, (bytes, bytearray)):
+                content = content.decode("utf-8", errors="replace")
+            self._node = _parse_html(str(content))
+
+    @property
+    def attrs(self) -> dict[str, str | None]:
+        return self._node.attrs
+
+    @property
+    def text(self) -> str:
+        return self.get_text()
+
+    def get_text(self, separator: str = "", strip: bool = False) -> str:
+        return self._node.get_text(separator=separator, strip=strip)
+
+    def select(self, selector: str) -> list["PyQuery"]:
+        return [PyQuery(node) for node in _select_from([self._node], selector)]
+
+    def select_one(self, selector: str) -> "PyQuery | None":
+        results = self.select(selector)
+        return results[0] if results else None
+
+    def __repr__(self) -> str:
+        tag = self._node.tag
+        if tag == "#document":
+            return "<PyQuery document>"
+        return f"<PyQuery {tag}>"
+
+
+BeautifulSoup = PyQuery
+
+__all__ = ["BeautifulSoup", "PyQuery"]
