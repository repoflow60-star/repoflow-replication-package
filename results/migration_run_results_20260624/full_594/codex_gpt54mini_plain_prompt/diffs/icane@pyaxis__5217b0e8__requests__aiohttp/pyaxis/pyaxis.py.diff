+async def _read_url(uri, encoding, timeout):
+    """Read a URL using aiohttp and return decoded text."""
+    client_timeout = aiohttp.ClientTimeout(total=timeout)
+    try:
+        async with aiohttp.ClientSession(timeout=client_timeout) as session:
+            async with session.get(uri) as response:
+                response.raise_for_status()
+                return await response.text(encoding=encoding)
+    except asyncio.TimeoutError as timeout_error:
+        raise requests_compat.exceptions.ConnectTimeout(
+            str(timeout_error)) from timeout_error
+    except aiohttp.InvalidURL as url_error:
+        raise requests_compat.exceptions.InvalidURL(str(url_error)) from url_error
+    except aiohttp.ClientResponseError as response_error:
+        raise requests_compat.exceptions.HTTPError(
+            f'{response_error.status} {response_error.message}') from response_error
+    except aiohttp.ClientConnectorError as connection_error:
+        raise requests_compat.exceptions.ConnectionError(
+            str(connection_error)) from connection_error
