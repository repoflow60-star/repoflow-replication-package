+"""Lightweight compatibility layer for a subset of `treq`.
+
+This project only needs a blocking HTTP GET that returns a response object with
+`status_code` and `content`, plus a connection-error type for retries.
+"""
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional
+
+import requests
+
+ConnectionError = requests.exceptions.ConnectionError
+
+_session = requests.Session()
+
+
+def get(url: str, headers: Optional[Mapping[str, str]] = None, **kwargs: Any):
+    return _session.get(url, headers=headers, **kwargs)
+
+
+def content(response: Any) -> bytes:
+    return response.content
