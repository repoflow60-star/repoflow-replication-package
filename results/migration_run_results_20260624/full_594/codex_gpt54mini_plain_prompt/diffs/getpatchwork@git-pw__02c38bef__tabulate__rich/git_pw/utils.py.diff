+def tabulate(
+    output: ty.List[ty.Tuple[str, ty.Any]],
+    headers: ty.List[str],
+    tablefmt: str = 'psql',
+) -> str:
+    """Render a table using rich when available.
+
+    Keep a local ``tabulate`` symbol so existing call sites and tests can
+    continue to patch it.
+    """
+    if Table is None:
+        return _legacy_tabulate(output, headers, tablefmt=tablefmt)
+
+    table = Table(
+        box=box.ASCII if tablefmt == 'psql' else box.SIMPLE,
+        show_header=True,
+        show_lines=False,
+        pad_edge=False,
+        expand=False,
+        header_style='',
+    )
+
+    for header in headers:
+        table.add_column(ensure_str(header), no_wrap=True)
+
+    for row in output:
+        table.add_row(*(ensure_str(item) for item in row))
+
+    console = Console(
+        width=10_000,
+        force_terminal=False,
+        color_system=None,
+        highlight=False,
+    )
+
+    with console.capture() as capture:
+        console.print(table)
+
+    return capture.get().rstrip('\n')
+
+
+def _legacy_tabulate(
+    output: ty.List[ty.Tuple[str, ty.Any]],
+    headers: ty.List[str],
+    tablefmt: str,
+) -> str:
+    """Render a plain text table without rich.
+
+    This is only used when rich is unavailable, and keeps the command-line
+    output usable in constrained environments.
+    """
+    rows = [[ensure_str(cell) for cell in headers]]
+    rows.extend([[ensure_str(cell) for cell in row] for row in output])
+
+    if not rows:
+        return ''
+
+    widths = [max(len(row[idx]) for row in rows) for idx in range(len(headers))]
+
+    def format_row(row: ty.List[str]) -> str:
+        return '| ' + ' | '.join(
+            row[idx].ljust(widths[idx]) for idx in range(len(headers))
+        ) + ' |'
+
+    if tablefmt == 'simple':
+        header = '  '.join(
+            rows[0][idx].ljust(widths[idx]) for idx in range(len(headers))
+        )
+        separator = '  '.join('-' * width for width in widths)
+        lines = [header, separator]
+        lines.extend(
+            '  '.join(
+                row[idx].ljust(widths[idx]) for idx in range(len(headers))
+            )
+            for row in rows[1:]
+        )
+        return '\n'.join(lines)
+
+    border = '+-' + '-+-'.join('-' * width for width in widths) + '-+'
+    header_border = '+=' + '=+='.join('=' * width for width in widths) + '=+'
+    lines = [border, format_row(rows[0]), header_border]
+    lines.extend(format_row(row) for row in rows[1:])
+    lines.append(border)
+    return '\n'.join(lines)
+
