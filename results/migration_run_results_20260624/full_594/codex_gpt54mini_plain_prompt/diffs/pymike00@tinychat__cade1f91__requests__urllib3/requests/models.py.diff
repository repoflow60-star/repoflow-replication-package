+from __future__ import annotations
+
+import json as json_module
+from typing import Iterator
+
+from urllib3.response import HTTPResponse
+
+
+class Response:
+    """A small requests.Response-compatible wrapper around urllib3.HTTPResponse."""
+
+    def __init__(self, raw_response: HTTPResponse):
+        self.raw = raw_response
+        self.status_code = raw_response.status
+        self.headers = raw_response.headers
+        self.reason = getattr(raw_response, "reason", None)
+        self.url = raw_response.geturl() if hasattr(raw_response, "geturl") else None
+        self.encoding = None
+        self._content: bytes | None = None
+
+    @property
+    def status(self) -> int:
+        return self.status_code
+
+    def __iter__(self) -> Iterator[bytes]:
+        return self.iter_content()
+
+    def iter_content(self, chunk_size: int = 8192) -> Iterator[bytes]:
+        yield from self.raw.stream(chunk_size, decode_content=True)
+
+    def close(self) -> None:
+        self.raw.close()
+
+    @property
+    def content(self) -> bytes:
+        if self._content is None:
+            self._content = b"".join(self.iter_content())
+        return self._content
+
+    def json(self):
+        return json_module.loads(self.content.decode(self.encoding or "utf-8"))
