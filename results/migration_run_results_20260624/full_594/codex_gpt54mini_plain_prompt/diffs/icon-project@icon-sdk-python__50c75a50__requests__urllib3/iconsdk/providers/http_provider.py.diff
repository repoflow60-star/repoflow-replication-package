+            'headers': request_headers,
+            'cert_reqs': ssl.CERT_REQUIRED if verify else ssl.CERT_NONE,
+            'retries': retries,
+            'timeout': timeout,
+        }
+
+        http = PoolManager(**pool_kwargs)
+        return http.request(
+            'POST',
+            request_url,
+            body=json.dumps(data).encode('utf-8'),
+            redirect=allow_redirects,
+        )
 
