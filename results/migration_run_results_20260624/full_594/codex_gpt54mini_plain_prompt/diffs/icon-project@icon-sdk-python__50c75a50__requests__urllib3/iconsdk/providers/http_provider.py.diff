+        verify = kwargs.pop('verify', True)
+        allow_redirects = kwargs.pop('allow_redirects', True)
+        retries = kwargs.pop('retries', False)
+
+        request_headers = {'Content-Type': 'application/json'}
+        request_headers.update(headers)
+
