diff --git /dev/null b/requests/transport.py
new file mode 100644
index 0000000..1985c21
--- /dev/null
+++ b/requests/transport.py
@@ -0,0 +1,95 @@
+from __future__ import annotations
+
+import io
+import json
+from urllib.parse import urlencode
+
+from .exceptions import RequestException
+from .response import Response
+
+
+def get(url: str, headers: dict | None = None, auth: tuple | None = None, timeout: int | float | None = None) -> Response:
+    return _request('GET', url, headers=headers, auth=auth, timeout=timeout)
+
+
+def post(
+    url: str,
+    data: dict | str | None = None,
+    json: dict | list | None = None,
+    headers: dict | None = None,
+    auth: tuple | None = None,
+    timeout: int | float | None = None,
+) -> Response:
+    return _request('POST', url, data=data, json=json, headers=headers, auth=auth, timeout=timeout)
+
+
+def _request(
+    method: str,
+    url: str,
+    data: dict | str | None = None,
+    json: dict | list | None = None,
+    headers: dict | None = None,
+    auth: tuple | None = None,
+    timeout: int | float | None = None,
+) -> Response:
+    try:
+        import pycurl
+    except ImportError as exc:
+        raise RequestException('pycurl is required for HTTP requests') from exc
+
+    buffer = io.BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEFUNCTION, buffer.write)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.NOSIGNAL, True)
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT, timeout)
+
+        if headers:
+            curl.setopt(pycurl.HTTPHEADER, [f'{key}: {value}' for key, value in headers.items()])
+
+        if auth is not None:
+            curl.setopt(pycurl.USERPWD, f'{auth[0]}:{auth[1]}')
+            curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+
+        if method == 'GET':
+            curl.setopt(pycurl.HTTPGET, True)
+        elif method == 'POST':
+            curl.setopt(pycurl.POST, True)
+            body = _serialize_body(data=data, json_data=json, headers=headers)
+            body_bytes = body.encode('utf-8')
+            curl.setopt(pycurl.POSTFIELDS, body_bytes)
+            curl.setopt(pycurl.POSTFIELDSIZE, len(body_bytes))
+        else:
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+        curl.perform()
+        status_code = int(curl.getinfo(pycurl.RESPONSE_CODE))
+        effective_url = str(curl.getinfo(pycurl.EFFECTIVE_URL))
+        body = buffer.getvalue().decode('utf-8')
+        return Response(status_code=status_code, url=effective_url, body=body)
+    except pycurl.error as exc:
+        raise RequestException(str(exc)) from exc
+    finally:
+        curl.close()
+
+
+def _serialize_body(
+    data: dict | str | None,
+    json_data: dict | list | None,
+    headers: dict | None,
+) -> str:
+    if json_data is not None:
+        return json.dumps(json_data)
+    if data is None:
+        return ''
+    if isinstance(data, str):
+        return data
+    content_type = ''
+    if headers:
+        content_type = str(headers.get('Content-Type', '')).lower()
+    if 'application/x-www-form-urlencoded' in content_type:
+        return urlencode(data)
+    return json.dumps(data)
