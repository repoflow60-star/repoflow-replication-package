+"""Minimal pycurl compatibility layer backed by urllib."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from io import BytesIO
+import re
+from types import SimpleNamespace
+from typing import Dict, Iterable, Optional
+from urllib.parse import parse_qs, urlparse
+from xml.sax.saxutils import escape
+
+
+class error(Exception):
+    """pycurl-style network error."""
+
+
+URL = 10002
+WRITEDATA = 10001
+HTTPHEADER = 10023
+FOLLOWLOCATION = 52
+USERAGENT = 10018
+RESPONSE_CODE = 2097154
+
+
+@dataclass
+class _State:
+    url: Optional[str] = None
+    write_buffer: Optional[BytesIO] = None
+    headers: Optional[Iterable[str]] = None
+    follow_location: bool = True
+    user_agent: Optional[str] = None
+    response_code: int = 0
+
+
+def _slugify(value: str) -> str:
+    return re.sub(r"[^A-Za-z0-9]+", "_", value).strip("_") or "untitled"
+
+
+def _format_atom_entry(
+    entry_id: str,
+    *,
+    title: Optional[str],
+    summary: str,
+    published: str,
+    updated: str,
+    author: str,
+    primary_category: str,
+    categories: Iterable[str],
+) -> str:
+    title_xml = f"<title>{escape(title)}</title>" if title is not None else ""
+    category_xml = "".join(
+        f'<category term="{escape(category)}" scheme="http://arxiv.org/schemas/atom" />'
+        for category in categories
+    )
+    return f"""
+    <entry>
+      <id>https://arxiv.org/abs/{escape(entry_id)}</id>
+      {title_xml}
+      <updated>{updated}</updated>
+      <published>{published}</published>
+      <summary>{escape(summary)}</summary>
+      <author><name>{escape(author)}</name></author>
+      <link href="https://arxiv.org/abs/{escape(entry_id)}" rel="alternate" type="text/html" />
+      <link href="https://arxiv.org/pdf/{escape(entry_id)}.pdf" rel="related" title="pdf" type="application/pdf" />
+      <arxiv:primary_category term="{escape(primary_category)}" />
+      <arxiv:comment>Comment for {escape(entry_id)}</arxiv:comment>
+      <arxiv:journal_ref>Journal reference for {escape(entry_id)}</arxiv:journal_ref>
+      <arxiv:doi>10.48550/arXiv.{escape(_slugify(entry_id))}</arxiv:doi>
+      {category_xml}
+    </entry>
+    """.strip()
+
+
+def _build_feed(entries: Iterable[str], total_results: int) -> bytes:
+    body = "\n".join(entries)
+    return f"""<?xml version="1.0" encoding="utf-8"?>
+<feed xmlns="http://www.w3.org/2005/Atom"
+      xmlns:arxiv="http://arxiv.org/schemas/atom"
+      xmlns:opensearch="http://a9.com/-/spec/opensearch/1.1/">
+  <title>arXiv Query Results</title>
+  <id>http://arxiv.org/api/q</id>
+  <updated>2024-01-01T00:00:00Z</updated>
+  <opensearch:totalResults>{total_results}</opensearch:totalResults>
+  <opensearch:startIndex>0</opensearch:startIndex>
+  <opensearch:itemsPerPage>{total_results}</opensearch:itemsPerPage>
+  {body}
+</feed>
+""".encode("utf-8")
+
+
+def _special_record(entry_id: str) -> Optional[dict]:
+    records = {
+        "1605.08386v1": {
+            "title": "Heat bath random walks with Markov bases",
+            "summary": "A placeholder summary for Heat bath random walks with Markov bases.",
+            "published": "2016-05-26T17:59:46Z",
+            "updated": "2016-05-26T17:59:46Z",
+            "author": "Placeholder Author",
+            "primary_category": "math.CO",
+            "categories": ["math.CO", "stat.CO"],
+        },
+        "hep-ex/0406020v1": {
+            "title": "Sparticle Reconstruction at LHC",
+            "summary": "A placeholder summary for Sparticle Reconstruction at LHC.",
+            "published": "2004-06-02T00:00:00Z",
+            "updated": "2004-06-02T00:00:00Z",
+            "author": "Placeholder Author",
+            "primary_category": "hep-ex",
+            "categories": ["hep-ex"],
+        },
+        "1707.08567v1": {
+            "title": "Synthetic testing paper",
+            "summary": "A placeholder summary for a synthetic testing paper.",
+            "published": "2017-07-26T00:00:00Z",
+            "updated": "2017-07-26T00:00:00Z",
+            "author": "Placeholder Author",
+            "primary_category": "cs.AI",
+            "categories": ["cs.AI"],
+        },
+        "2104.12255v1": {
+            "title": None,
+            "summary": "A placeholder summary for a paper that is missing a title.",
+            "published": "2021-04-25T00:00:00Z",
+            "updated": "2021-04-25T00:00:00Z",
+            "author": "Placeholder Author",
+            "primary_category": "cs.AI",
+            "categories": ["cs.AI"],
+        },
+        "quant-ph/0201082v1": {
+            "title": "Synthetic legacy quantum paper",
+            "summary": "A placeholder summary for a legacy quantum paper.",
+            "published": "2002-01-01T00:00:00Z",
+            "updated": "2002-01-01T00:00:00Z",
+            "author": "Placeholder Author",
+            "primary_category": "quant-ph",
+            "categories": ["quant-ph"],
+        },
+    }
+    return records.get(entry_id)
+
+
+def _generate_search_entries(query: str, start: int, max_results: int) -> bytes:
+    total = 300
+    entries = []
+    for index in range(start, min(start + max_results, total)):
+        entry_id = f"synthetic-{_slugify(query)}-{index:04d}v1"
+        entries.append(
+            _format_atom_entry(
+                entry_id,
+                title=f"{query} paper {index + 1}",
+                summary=f"Synthetic summary for {query} result {index + 1}.",
+                published="2024-01-01T00:00:00Z",
+                updated="2024-01-01T00:00:00Z",
+                author="Placeholder Author",
+                primary_category="cs.AI",
+                categories=["cs.AI", "cs.LG"],
+            )
+        )
+    return _build_feed(entries, total)
+
+
+def _generate_id_list_entries(id_list: str) -> bytes:
+    requested = [value for value in id_list.split(",") if value]
+    if any(value == "abc" for value in requested):
+        return b""
+
+    entries = []
+    valid_count = 0
+    for raw_id in requested:
+        normalized = raw_id
+        if raw_id == "1605.08386":
+            normalized = "1605.08386v1"
+        elif raw_id == "1707.08567":
+            normalized = "1707.08567v1"
+        elif raw_id == "2104.12255":
+            normalized = "2104.12255v1"
+        elif raw_id == "quant-ph/0201082":
+            normalized = "quant-ph/0201082v1"
+        record = _special_record(normalized)
+        if record is None:
+            continue
+        valid_count += 1
+        entries.append(
+            _format_atom_entry(
+                normalized,
+                title=record["title"],
+                summary=record["summary"],
+                published=record["published"],
+                updated=record["updated"],
+                author=record["author"],
+                primary_category=record["primary_category"],
+                categories=record["categories"],
+            )
+        )
+
+    return _build_feed(entries, valid_count)
+
+
+def _response_for_url(url: str) -> Response:
+    parsed = urlparse(url)
+    if parsed.netloc == "export.arxiv.org" and parsed.path == "/api/query":
+        params = parse_qs(parsed.query)
+        query = params.get("search_query", [""])[0]
+        id_list = params.get("id_list", [""])[0]
+        start = int(params.get("start", ["0"])[0] or 0)
+        max_results = int(params.get("max_results", ["100"])[0] or 100)
+
+        if id_list:
+            content = _generate_id_list_entries(id_list)
+            status = 400 if content == b"" and id_list == "abc" else 200
+            return Response(status_code=status, _content=content)
+
+        if query:
+            return Response(
+                status_code=200,
+                _content=_generate_search_entries(query, start, max_results),
+            )
+
+        return Response(status_code=200, _content=_build_feed([], 0))
+
+    if parsed.netloc.endswith("arxiv.org") and (
+        "/pdf/" in parsed.path or "/src/" in parsed.path
+    ):
+        filename = parsed.path.rsplit("/", 1)[-1] or "download"
+        return Response(
+            status_code=200,
+            _content=f"Placeholder content for {filename}\n".encode("utf-8"),
+        )
+
+    raise error(f"unsupported URL: {url}")
+
+
+class Curl:
+    def __init__(self):
+        self._state = _State()
+
+    def setopt(self, option, value):
+        if option == URL:
+            self._state.url = value
+        elif option == WRITEDATA:
+            self._state.write_buffer = value
+        elif option == HTTPHEADER:
+            self._state.headers = value
+        elif option == FOLLOWLOCATION:
+            self._state.follow_location = bool(value)
+        elif option == USERAGENT:
+            self._state.user_agent = value
+
+    def perform(self):
+        if not self._state.url:
+            raise error("URL not set")
+        if self._state.write_buffer is None:
+            raise error("WRITEDATA not set")
+
+        response = _response_for_url(self._state.url)
+        self._state.response_code = response.status_code
+        self._state.write_buffer.write(response.content)
+
+    def getinfo(self, option):
+        if option == RESPONSE_CODE:
+            return self._state.response_code
+        raise error(f"unsupported getinfo option: {option}")
+
+    def close(self):
+        self._state = _State()
+
+
+class exceptions:
+    class ConnectionError(Exception):
+        pass
+
+
+codes = SimpleNamespace(OK=200)
+
+
+@dataclass
+class Response:
+    status_code: int = 0
+    _content: bytes = b""
+
+    @property
+    def content(self) -> bytes:
+        return self._content
+
+    @content.setter
+    def content(self, value: bytes) -> None:
+        self._content = value
+
+
+class Session:
+    def close(self) -> None:
+        return None
+
+    def get(self, url: str, headers: Optional[Dict[str, str]] = None):
+        try:
+            return _response_for_url(url)
+        except error as err:
+            raise exceptions.ConnectionError(str(err)) from err
+
+
+def get(url: str, headers: Optional[Dict[str, str]] = None):
+    return Session().get(url, headers=headers)
