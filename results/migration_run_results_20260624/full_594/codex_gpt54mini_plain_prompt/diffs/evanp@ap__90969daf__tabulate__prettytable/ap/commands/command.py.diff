--- a/ap/commands/command.py
+++ b/ap/commands/command.py
@@ -9,6 +9,37 @@ import re
 from typing import Generator, Dict
 from ap.version import __version__
 
+try:
+    from prettytable import PrettyTable
+except ModuleNotFoundError:
+    class PrettyTable:
+        def __init__(self):
+            self.field_names = []
+            self._rows = []
+
+        def add_row(self, row):
+            self._rows.append(list(row))
+
+        def __str__(self):
+            if not self.field_names:
+                return ""
+
+            widths = [len(str(name)) for name in self.field_names]
+            for row in self._rows:
+                for idx, cell in enumerate(row):
+                    widths[idx] = max(widths[idx], len("" if cell is None else str(cell)))
+
+            def render_row(row):
+                return " | ".join(
+                    str("" if cell is None else cell).ljust(widths[idx])
+                    for idx, cell in enumerate(row)
+                )
+
+            header = render_row(self.field_names)
+            separator = "-+-".join("-" * width for width in widths)
+            body = [render_row(row) for row in self._rows]
+            return "\n".join([header, separator, *body]) if body else "\n".join([header, separator])
+
 USER_AGENT = f"ap/{__version__}"
 BASE_HEADERS = {
     "Accept": "application/ld+json,application/activity+json,application/json",
@@ -252,3 +283,10 @@ class Command:
 
     def collection_slice(self, coll: dict, offset: int, limit: int):
         return itertools.islice(self.items(coll), offset, offset + limit)
+
+    def print_table(self, rows: list[list], headers: list[str]):
+        table = PrettyTable()
+        table.field_names = headers
+        for row in rows:
+            table.add_row(row)
+        print(table)
