+def render_syntax(text: str, fmt: str) -> str:
+    '''render colored syntax using rich'''
+    if fmt not in {'json', 'toml', 'xml', 'yaml'}:
+        raise KeyError(fmt)
+    buffer = io.StringIO()
+    console = Console(
+        file=buffer,
+        force_terminal=True,
+        color_system='standard',
+        width=get_terminal_size().columns,
+    )
+    syntax = Syntax(text.rstrip('\n'), fmt, theme=RICH_SYNTAX_THEME,
+                    word_wrap=False)
+    console.print(syntax, end='')
+    rendered = buffer.getvalue()
+    if not rendered.endswith('\n'):
+        rendered += '\n'
+    return rendered
+
