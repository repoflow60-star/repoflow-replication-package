+def render_diff(result: str) -> str:
+    '''render unified diff using rich'''
+    buffer = StringIO()
+    console = Console(file=buffer, force_terminal=True, color_system='standard')
+    console.print(Syntax(result.rstrip('\n'), 'diff', theme='ansi_dark',
+                         word_wrap=False), end='')
+    rendered = buffer.getvalue()
+    if not rendered.endswith('\n'):
+        rendered += '\n'
+    return rendered
