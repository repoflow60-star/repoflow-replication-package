+'''Small subset of rich.console used by jsonfmt.'''
+
+from typing import Any, Optional, TextIO
+
+
+class Console:
+    '''Write rendered text to a file-like object.'''
+
+    def __init__(self, *, file: TextIO, force_terminal: bool = False,
+                 color_system: Optional[str] = None,
+                 width: Optional[int] = None):
+        self.file = file
+        self.force_terminal = force_terminal
+        self.color_system = color_system
+        self.width = width
+
+    def print(self, renderable: Any, end: str = '\n'):
+        if hasattr(renderable, 'render'):
+            text = renderable.render()
+        else:
+            text = str(renderable)
+        self.file.write(text)
+        self.file.write(end)
