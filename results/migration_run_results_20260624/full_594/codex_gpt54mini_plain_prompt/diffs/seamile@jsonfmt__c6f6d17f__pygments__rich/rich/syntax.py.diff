+'''Small subset of rich.syntax used by jsonfmt.'''
+
+from typing import Optional
+
+from pygments import highlight
+from pygments.formatters import TerminalFormatter
+from pygments.lexers import DiffLexer, JsonLexer, TOMLLexer, XmlLexer, YamlLexer
+
+
+_LEXERS = {
+    'diff': DiffLexer,
+    'json': JsonLexer,
+    'toml': TOMLLexer,
+    'xml': XmlLexer,
+    'yaml': YamlLexer,
+}
+
+
+class Syntax:
+    '''Render text using pygments-compatible terminal formatting.'''
+
+    def __init__(self, code: str, lexer: str, theme: Optional[str] = None,
+                 word_wrap: bool = False):
+        self.code = code
+        self.lexer = lexer
+        self.theme = theme
+        self.word_wrap = word_wrap
+
+    def render(self) -> str:
+        lexer_cls = _LEXERS.get(self.lexer, JsonLexer)
+        return highlight(self.code, lexer_cls(), TerminalFormatter())
