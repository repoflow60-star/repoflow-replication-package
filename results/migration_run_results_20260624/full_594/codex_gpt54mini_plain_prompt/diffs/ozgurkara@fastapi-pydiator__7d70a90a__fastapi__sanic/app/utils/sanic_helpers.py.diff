+from __future__ import annotations
+
+from json import JSONDecodeError
+from typing import Any, Iterable, Type, TypeVar
+
+from pydantic import BaseModel
+
+from app.utils.error.error_models import ErrorInfoContainer, ErrorResponseModel
+from sanic.response import json as sanic_json
+from sanic.response import text as sanic_text
+
+T = TypeVar("T", bound=BaseModel)
+
+
+def _serialize(value: Any):
+    if isinstance(value, BaseModel):
+        return value.dict()
+    if isinstance(value, list):
+        return [_serialize(item) for item in value]
+    if isinstance(value, tuple):
+        return [_serialize(item) for item in value]
+    if isinstance(value, dict):
+        return {key: _serialize(item) for key, item in value.items()}
+    return value
+
+
+async def get_request_json(request):
+    json_attr = getattr(request, "json", None)
+    if callable(json_attr):
+        try:
+            return await json_attr()
+        except JSONDecodeError:
+            return None
+    return json_attr
+
+
+def build_model(model_cls: Type[T], payload: Any) -> T:
+    if payload is None:
+        payload = {}
+    return model_cls.parse_obj(payload)
+
+def validation_error_response(error_detail):
+    return json_response(
+        ErrorResponseModel(
+            error_code=ErrorInfoContainer.model_validation_error.code,
+            error_message=ErrorInfoContainer.model_validation_error.message,
+            error_detail=error_detail,
+        ).dict(),
+        status=422,
+    )
+
+
+def prefix_validation_errors(errors: Iterable[dict], prefix: str):
+    prefixed_errors = []
+    for error in errors:
+        prefixed_error = dict(error)
+        loc = list(prefixed_error.get("loc", []))
+        prefixed_error["loc"] = [prefix, *loc]
+        prefixed_errors.append(prefixed_error)
+    return prefixed_errors
+
+
+async def build_model_from_request(model_cls: Type[T], request) -> T:
+    return build_model(model_cls, await get_request_json(request))
+
+
+def json_response(content: Any, status: int = 200):
+    return sanic_json(_serialize(content), status=status)
+
+
+def text_response(content: str, status: int = 200):
+    return sanic_text(content, status=status)
