+from __future__ import annotations
+
+from dataclasses import dataclass
+from types import SimpleNamespace
+from typing import Any, Awaitable, Callable, Dict, List, Optional, Sequence, Tuple, Type
+
+from starlette.applications import Starlette
+from starlette.requests import Request
+from starlette.routing import Route
+
+
+Handler = Callable[..., Awaitable[Any]]
+
+
+def _normalize_path(prefix: str, path: str) -> str:
+    prefix = prefix.rstrip("/")
+    if not prefix:
+        prefix = ""
+
+    if path in {"", "/"}:
+        return prefix or "/"
+
+    route_path = path if path.startswith("/") else f"/{path}"
+    return f"{prefix}{route_path}"
+
+
+def _convert_sanic_path(path: str) -> str:
+    converted = path
+    converted = converted.replace("<", "{").replace(">", "}")
+    return converted
+
+
+@dataclass
+class _RouteDefinition:
+    path: str
+    methods: Sequence[str]
+    handler: Handler
+
+
+class Blueprint:
+    def __init__(self, name: str, url_prefix: str = ""):
+        self.name = name
+        self.url_prefix = url_prefix
+        self._routes: List[_RouteDefinition] = []
+
+    def route(self, path: str, methods: Sequence[str], **_kwargs):
+        def decorator(handler: Handler):
+            self._routes.append(_RouteDefinition(path=path, methods=methods, handler=handler))
+            return handler
+
+        return decorator
+
+    def get(self, path: str, **kwargs):
+        return self.route(path, methods=["GET"], **kwargs)
+
+    def post(self, path: str, **kwargs):
+        return self.route(path, methods=["POST"], **kwargs)
+
+    def put(self, path: str, **kwargs):
+        return self.route(path, methods=["PUT"], **kwargs)
+
+    def delete(self, path: str, **kwargs):
+        return self.route(path, methods=["DELETE"], **kwargs)
+
+
+class Sanic:
+    def __init__(self, name: str):
+        self.name = name
+        self.config = SimpleNamespace()
+        self.ctx = SimpleNamespace()
+        self._routes: List[Route] = []
+        self._exception_handlers: Dict[Type[BaseException], Handler] = {}
+        self._app = Starlette(debug=False)
+        self._built = False
+
+    def route(self, path: str, methods: Sequence[str], **_kwargs):
+        def decorator(handler: Handler):
+            self._routes.append(Route(_convert_sanic_path(path), handler, methods=list(methods)))
+            self._built = False
+            return handler
+
+        return decorator
+
+    def get(self, path: str, **kwargs):
+        return self.route(path, methods=["GET"], **kwargs)
+
+    def post(self, path: str, **kwargs):
+        return self.route(path, methods=["POST"], **kwargs)
+
+    def put(self, path: str, **kwargs):
+        return self.route(path, methods=["PUT"], **kwargs)
+
+    def delete(self, path: str, **kwargs):
+        return self.route(path, methods=["DELETE"], **kwargs)
+
+    def blueprint(self, blueprint: Blueprint):
+        for route_def in blueprint._routes:
+            full_path = _normalize_path(blueprint.url_prefix, route_def.path)
+            self._routes.append(
+                Route(_convert_sanic_path(full_path), route_def.handler, methods=list(route_def.methods))
+            )
+        self._built = False
+
+    def exception(self, *exceptions: Type[BaseException]):
+        def decorator(handler: Handler):
+            for exc in exceptions:
+                self._exception_handlers[exc] = handler
+            self._built = False
+            return handler
+
+        return decorator
+
+    def _build(self):
+        self._app = Starlette(debug=False, routes=self._routes, exception_handlers=self._exception_handlers)
+        self._built = True
+
+    async def __call__(self, scope, receive, send):
+        if not self._built:
+            self._build()
+        await self._app(scope, receive, send)
+
+
+__all__ = ["Blueprint", "Request", "Sanic"]
