+from __future__ import annotations
+
+from typing import Any, Mapping, Optional
+
+from starlette.responses import JSONResponse as _JSONResponse
+from starlette.responses import PlainTextResponse as _PlainTextResponse
+
+
+def json(content: Any, status: int = 200, headers: Optional[Mapping[str, str]] = None):
+    return _JSONResponse(content=content, status_code=status, headers=dict(headers or {}))
+
+
+def text(content: str, status: int = 200, headers: Optional[Mapping[str, str]] = None, content_type: str = "text/plain"):
+    return _PlainTextResponse(content=content, status_code=status, headers=dict(headers or {}), media_type=content_type)
