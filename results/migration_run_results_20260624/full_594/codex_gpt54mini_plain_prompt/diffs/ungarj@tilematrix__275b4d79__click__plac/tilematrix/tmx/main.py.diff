+class TmxCLI:
+    """Lightweight CLI object compatible with Click's test runner."""
+
+    name = "tmx"
+
+    def __init__(self):
+        self._parser = self._build_parser()
+
+    def _build_parser(self):
+        parser = argparse.ArgumentParser(prog=self.name, add_help=True)
+        parser.add_argument(
+            "--version",
+            action="version",
+            version=tilematrix.__version__,
+        )
+        parser.add_argument(
+            "--pixelbuffer",
+            "-p",
+            type=int,
+            default=0,
+            help="Tile bounding box buffer in pixels. (default: 0)",
+        )
+        parser.add_argument(
+            "--tile_size",
+            "-s",
+            type=int,
+            default=256,
+            help="Tile size in pixels. (default: 256)",
+        )
+        parser.add_argument(
+            "--metatiling",
+            "-m",
+            type=int,
+            default=1,
+            help="TilePyramid metatile size. (default: 1)",
+        )
+        parser.add_argument(
+            "--grid",
+            "-g",
+            choices=["geodetic", "mercator"],
+            default="geodetic",
+            help="TilePyramid base grid. (default: geodetic)",
+        )
+        parser.add_argument(
+            "--output_format",
+            "-f",
+            choices=["Tile", "WKT", "GeoJSON"],
+            default="Tile",
+            help="Print Tile ID or Tile bounding box as WKT or GeoJSON. (default: Tile)",
+        )
+
+        subparsers = parser.add_subparsers(dest="command", required=True)
+
+        bounds = subparsers.add_parser("bounds", help="Tile bounds.")
+        bounds.add_argument("tile", nargs=3, type=int)
+        bounds.set_defaults(func=_bounds_command)
+
+        bbox = subparsers.add_parser("bbox", help="Tile bounding box.")
+        bbox.add_argument("tile", nargs=3, type=int)
+        bbox.set_defaults(func=_bbox_command)
+
+        tile = subparsers.add_parser("tile", help="Tile from point.")
+        tile.add_argument("zoom", type=int)
+        tile.add_argument("point", nargs=2, type=float)
+        tile.set_defaults(func=_tile_command)
+
+        tiles = subparsers.add_parser("tiles", help="Tiles from bounds.")
+        tiles.add_argument("zoom", type=int)
+        tiles.add_argument("bounds", nargs=4, type=float)
+        tiles.set_defaults(func=_tiles_command)
+
+        snap_bounds = subparsers.add_parser(
+            "snap-bounds", help="Snap bounds to tile grid."
+        )
+        snap_bounds.add_argument("zoom", type=int)
+        snap_bounds.add_argument("bounds", nargs=4, type=float)
+        snap_bounds.set_defaults(func=_snap_bounds_command)
+
+        snap_bbox = subparsers.add_parser(
+            "snap-bbox", help="Snap bbox to tile grid."
+        )
+        snap_bbox.add_argument("zoom", type=int)
+        snap_bbox.add_argument("bounds", nargs=4, type=float)
+        snap_bbox.set_defaults(func=_snap_bbox_command)
+
+        return parser
+
+    def main(
+        self,
+        args=None,
+        prog_name=None,
+        complete_var=None,
+        standalone_mode=True,
+        windows_expand_args=True,
+        **extra,
+    ):
+        namespace = self._parser.parse_args(list(args) if args is not None else None)
+        namespace.func(namespace)
+
+
+tmx = plac.Command(TmxCLI())
