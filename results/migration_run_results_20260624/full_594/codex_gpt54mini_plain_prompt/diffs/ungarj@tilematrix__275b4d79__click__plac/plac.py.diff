@@ -0,0 +1,14 @@
+"""Minimal local compatibility layer for plac-style CLI wrapping."""
+
+
+class Command:
+    def __init__(self, command):
+        self.command = command
+        self.name = getattr(command, "name", None)
+
+    def main(self, *args, **kwargs):
+        return self.command.main(*args, **kwargs)
+
+
+def call(command, *args, **kwargs):
+    return Command(command).main(*args, **kwargs)
