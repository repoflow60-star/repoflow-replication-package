+import builtins
+
+from redfish_protocol_validator.color_support import ansi_wrap
+
+from .text import Text
+
+
+class Console:
+    def __init__(self, *args, **kwargs):
+        pass
+
+    def print(self, *objects, sep=" ", end="\n", style=None):
+        rendered = []
+        for obj in objects:
+            if isinstance(obj, Text):
+                rendered.append(str(obj))
+            else:
+                rendered.append(ansi_wrap(obj, style))
+        builtins.print(sep.join(rendered), end=end)
