+
+"""Shared ANSI color helpers used by the rich migration."""
+
+
+class Fore:
+    GREEN = "\033[32m"
+    YELLOW = "\033[33m"
+    RED = "\033[31m"
+
+
+class Style:
+    RESET_ALL = "\033[0m"
+
+
+_STYLE_TO_ANSI = {
+    "green": Fore.GREEN,
+    "yellow": Fore.YELLOW,
+    "red": Fore.RED,
+    "reset": Style.RESET_ALL,
+    "bold": "\033[1m",
+}
+
+
+def ansi_wrap(text, style):
+    if not style:
+        return str(text)
+    if hasattr(style, "render"):
+        return style.render(str(text))
+    if isinstance(style, str):
+        codes = [_STYLE_TO_ANSI[token] for token in style.split()
+                 if token in _STYLE_TO_ANSI]
+        if codes:
+            return "{}{}{}".format("".join(codes), text, Style.RESET_ALL)
+    return str(text)
+
+
+class _ColoramaCompat:
+    Fore = Fore
+    Style = Style
+
+    def init(self, *args, **kwargs):
+        return None
+
+    def deinit(self, *args, **kwargs):
+        return None
+
+
+def make_colorama_compat():
+    return _ColoramaCompat()
