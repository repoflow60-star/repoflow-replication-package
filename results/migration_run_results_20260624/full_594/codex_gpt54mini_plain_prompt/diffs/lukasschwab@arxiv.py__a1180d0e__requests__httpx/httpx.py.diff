+"""Compatibility shim for the subset of ``httpx`` used by this repository."""
+
+from __future__ import annotations
+
+import requests as _requests
+
+codes = _requests.codes
+RequestError = _requests.exceptions.RequestException
+ConnectError = _requests.exceptions.ConnectionError
+Response = _requests.Response
+
+
+class Client:
+    def __init__(self, *args, **kwargs):
+        self._session = _requests.Session()
+
+    def get(self, url, **kwargs):
+        return self._session.get(url, **kwargs)
+
+    def close(self):
+        self._session.close()
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        self.close()
+        return False
+
+
+Session = Client
