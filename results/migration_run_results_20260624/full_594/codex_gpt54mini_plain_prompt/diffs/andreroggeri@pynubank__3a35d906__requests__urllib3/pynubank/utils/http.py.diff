+import json as json_module
+import tempfile
+import ssl
+from pathlib import Path
+
+import urllib3
+from cryptography.hazmat.primitives import serialization
+from cryptography.hazmat.primitives.serialization.pkcs12 import load_key_and_certificates
 
 from pynubank import NuRequestException
 
 
+class HttpResponse:
+    def __init__(self, response: urllib3.response.HTTPResponse):
+        self._response = response
+        self.status_code = response.status
+        self.status = response.status
+        self.url = response.url
+        self.headers = response.headers
+
+    @property
+    def data(self):
+        return self._response.data
+
+    def json(self):
+        if not self._response.data:
+            return {}
+
+        return json_module.loads(self._response.data.decode())
+
+
+def _build_pool_manager(pkcs12_data: bytes = None, pkcs12_password: str = '') -> urllib3.PoolManager:
+    if not pkcs12_data:
+        return urllib3.PoolManager()
+
+    password = pkcs12_password.encode() if isinstance(pkcs12_password, str) else pkcs12_password
+    key, cert, additional_certs = load_key_and_certificates(pkcs12_data, password)
+    if key is None or cert is None:
+        raise ValueError('Invalid PKCS#12 certificate data')
+
+    with tempfile.TemporaryDirectory() as tempdir:
+        tempdir_path = Path(tempdir)
+        key_path = tempdir_path / 'client.key'
+        cert_path = tempdir_path / 'client.crt'
+
+        key_path.write_bytes(
+            key.private_bytes(
+                encoding=serialization.Encoding.PEM,
+                format=serialization.PrivateFormat.TraditionalOpenSSL,
+                encryption_algorithm=serialization.NoEncryption(),
+            )
+        )
+
+        cert_bytes = [cert.public_bytes(serialization.Encoding.PEM)]
+        if additional_certs:
+            cert_bytes.extend(extra_cert.public_bytes(serialization.Encoding.PEM) for extra_cert in additional_certs)
+        cert_path.write_bytes(b''.join(cert_bytes))
+
+        ssl_context = ssl.create_default_context()
+        ssl_context.load_cert_chain(certfile=str(cert_path), keyfile=str(key_path))
+
+        return urllib3.PoolManager(ssl_context=ssl_context)
+
+
+def get(url: str, headers: dict = None, pkcs12_data: bytes = None, pkcs12_password: str = '') -> HttpResponse:
+    response = _build_pool_manager(pkcs12_data, pkcs12_password).request('GET', url, headers=headers)
+    return HttpResponse(response)
+
+
+def post(url: str, json: dict, headers: dict = None, pkcs12_data: bytes = None, pkcs12_password: str = '') -> HttpResponse:
+    body = json_module.dumps(json).encode('utf-8')
+    response = _build_pool_manager(pkcs12_data, pkcs12_password).request('POST', url, body=body, headers=headers)
+    return HttpResponse(response)
+
+
