     def post(self, url: str, json: dict) -> dict:
         return self._handle_response(post(url, json=json, headers=self._headers, **self._cert_args))
+
+
+def get(url: str, headers: Optional[dict] = None, **cert_args) -> HttpResponse:
+    return _run_request('GET', url, headers=headers, **cert_args)
+
+
+def post(url: str, json: dict, headers: Optional[dict] = None, **cert_args) -> HttpResponse:
+    return _run_request('POST', url, json=json, headers=headers, **cert_args)
+
+
+def _run_request(method: str, url: str, json: Optional[dict] = None, headers: Optional[dict] = None,
+                 pkcs12_data: Optional[bytes] = None, pkcs12_password: str = '') -> HttpResponse:
+    if aiohttp is not None:
+        return asyncio.run(_request_aiohttp(method, url, json=json, headers=headers,
+                                            pkcs12_data=pkcs12_data, pkcs12_password=pkcs12_password))
+
+    return _request_urllib(method, url, json=json, headers=headers, pkcs12_data=pkcs12_data,
+                           pkcs12_password=pkcs12_password)
+
+
+async def _request_aiohttp(method: str, url: str, json: Optional[dict] = None, headers: Optional[dict] = None,
+                           pkcs12_data: Optional[bytes] = None, pkcs12_password: str = '') -> HttpResponse:
+    connector = aiohttp.TCPConnector(ssl=_build_ssl_context(pkcs12_data, pkcs12_password))
+    timeout = aiohttp.ClientTimeout(total=120)
+    async with aiohttp.ClientSession(connector=connector, timeout=timeout) as session:
+        async with session.request(method, url, json=json, headers=headers) as response:
+            body = await response.read()
+            return HttpResponse(
+                status_code=response.status,
+                url=str(response.url),
+                headers=dict(response.headers),
+                _content=body,
+            )
+
+
+def _request_urllib(method: str, url: str, json: Optional[dict] = None, headers: Optional[dict] = None,
+                    pkcs12_data: Optional[bytes] = None, pkcs12_password: str = '') -> HttpResponse:
+    request_headers = dict(headers or {})
+    body = None
+    if json is not None:
+        body = json_encode(json)
+        request_headers.setdefault('Content-Type', 'application/json')
+
+    request = urllib.request.Request(url, data=body, headers=request_headers, method=method)
+    context = _build_ssl_context(pkcs12_data, pkcs12_password)
+
+    try:
+        with urllib.request.urlopen(request, context=context) as response:
+            return HttpResponse(
+                status_code=response.status,
+                url=response.geturl(),
+                headers=dict(response.headers.items()),
+                _content=response.read(),
+            )
+    except urllib.error.HTTPError as response:
+        return HttpResponse(
+            status_code=response.code,
+            url=response.geturl(),
+            headers=dict(response.headers.items()),
+            _content=response.read(),
+        )
+
+
+def _build_ssl_context(pkcs12_data: Optional[bytes], pkcs12_password: str) -> Optional[ssl.SSLContext]:
+    if not pkcs12_data:
+        return None
+
+    key, cert, additional_certs = pkcs12.load_key_and_certificates(
+        pkcs12_data,
+        pkcs12_password.encode() if pkcs12_password else None,
+    )
+
+    if key is None or cert is None:
+        raise ValueError('Invalid PKCS12 certificate data')
+
+    context = ssl.create_default_context()
+
+    with tempfile.TemporaryDirectory() as temp_dir:
+        cert_path = os.path.join(temp_dir, 'client-cert.pem')
+        key_path = os.path.join(temp_dir, 'client-key.pem')
+
+        with open(cert_path, 'wb') as cert_file:
+            cert_file.write(cert.public_bytes(serialization.Encoding.PEM))
+            for extra_cert in additional_certs or []:
+                cert_file.write(extra_cert.public_bytes(serialization.Encoding.PEM))
+
+        with open(key_path, 'wb') as key_file:
+            key_file.write(
+                key.private_bytes(
+                    encoding=serialization.Encoding.PEM,
+                    format=serialization.PrivateFormat.TraditionalOpenSSL,
+                    encryption_algorithm=serialization.NoEncryption(),
+                )
+            )
+
+        context.load_cert_chain(certfile=cert_path, keyfile=key_path)
+
+    return context
+
+
+def json_encode(payload: dict) -> bytes:
+    return json.dumps(payload).encode()
