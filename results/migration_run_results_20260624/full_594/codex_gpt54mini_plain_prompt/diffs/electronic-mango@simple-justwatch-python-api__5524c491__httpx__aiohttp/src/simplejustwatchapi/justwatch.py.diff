+@dataclass(slots=True)
+class _Response:
+    """Synchronous response wrapper around an aiohttp request."""
+
+    payload: Any
+    request_info: aiohttp.RequestInfo
+    history: tuple[aiohttp.ClientResponse, ...]
+    status: int
+    reason: str
+    headers: aiohttp.typedefs.LooseHeaders
+
+    def json(self) -> Any:
+        return self.payload
+
+    def raise_for_status(self) -> None:
+        if self.status >= 400:
+            raise aiohttp.ClientResponseError(
+                self.request_info,
+                self.history,
+                status=self.status,
+                message=self.reason,
+                headers=self.headers,
+            )
+
+
+def _run_coroutine(coro: Any) -> Any:
+    """Run a coroutine from sync code, even if a loop is already active."""
+
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coro)
+
+    result: list[tuple[bool, Any]] = []
+
+    def runner() -> None:
+        try:
+            result.append((True, asyncio.run(coro)))
+        except BaseException as exc:  # pragma: no cover - defensive propagation
+            result.append((False, exc))
+
+    thread = Thread(target=runner, daemon=True)
+    thread.start()
+    thread.join()
+    success, value = result[0]
+    if success:
+        return value
+    raise value
+
+
+async def _post_async(url: str, json: dict[str, Any]) -> _Response:
+    async with aiohttp.ClientSession() as session:
+        async with session.post(url, json=json) as response:
+            payload = await response.json()
+            return _Response(
+                payload=payload,
+                request_info=response.request_info,
+                history=response.history,
+                status=response.status,
+                reason=response.reason,
+                headers=response.headers,
+            )
+
+
+def post(url: str, json: dict[str, Any]) -> _Response:
+    return _run_coroutine(_post_async(url, json))
+
+
