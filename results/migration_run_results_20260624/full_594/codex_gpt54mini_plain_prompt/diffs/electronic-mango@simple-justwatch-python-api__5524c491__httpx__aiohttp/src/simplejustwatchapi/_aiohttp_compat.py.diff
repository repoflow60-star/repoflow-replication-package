+++ b/src/simplejustwatchapi/_aiohttp_compat.py
@@ -0,0 +1,108 @@
+"""Minimal aiohttp compatibility layer used when the real dependency is unavailable."""
+
+from __future__ import annotations
+
+import json as _json
+from dataclasses import dataclass
+from typing import Any
+from urllib import error as _urlerror
+from urllib import request as _urlrequest
+
+
+@dataclass(slots=True)
+class RequestInfo:
+    url: str
+
+
+class ClientResponseError(Exception):
+    def __init__(
+        self,
+        request_info: RequestInfo | None,
+        history: tuple[Any, ...],
+        *,
+        status: int,
+        message: str = "",
+        headers: Any = None,
+    ) -> None:
+        super().__init__(f"{status}, message={message!r}, url={getattr(request_info, 'url', None)!r}")
+        self.request_info = request_info
+        self.history = history
+        self.status = status
+        self.message = message
+        self.headers = headers
+
+
+class ClientResponse:
+    def __init__(self, url: str, payload: Any, status: int, reason: str, headers: Any) -> None:
+        self.request_info = RequestInfo(url)
+        self.history: tuple[Any, ...] = ()
+        self.status = status
+        self.reason = reason
+        self.headers = headers
+        self._payload = payload
+
+    async def json(self) -> Any:
+        return self._payload
+
+    def raise_for_status(self) -> None:
+        if self.status >= 400:
+            raise ClientResponseError(
+                self.request_info,
+                self.history,
+                status=self.status,
+                message=self.reason,
+                headers=self.headers,
+            )
+
+
+class _ResponseContextManager:
+    def __init__(self, url: str, payload: dict[str, Any]) -> None:
+        self._url = url
+        self._payload = payload
+        self._response: ClientResponse | None = None
+
+    async def __aenter__(self) -> ClientResponse:
+        data = _json.dumps(self._payload).encode("utf-8")
+        req = _urlrequest.Request(
+            self._url,
+            data=data,
+            headers={"Content-Type": "application/json"},
+            method="POST",
+        )
+        try:
+            with _urlrequest.urlopen(req) as response:
+                body = response.read().decode("utf-8")
+                parsed = _json.loads(body)
+                self._response = ClientResponse(
+                    url=self._url,
+                    payload=parsed,
+                    status=getattr(response, "status", response.getcode()),
+                    reason=getattr(response, "reason", ""),
+                    headers=dict(response.headers.items()),
+                )
+        except _urlerror.HTTPError as exc:
+            body = exc.read().decode("utf-8")
+            parsed = _json.loads(body) if body else None
+            self._response = ClientResponse(
+                url=self._url,
+                payload=parsed,
+                status=exc.code,
+                reason=exc.reason or "",
+                headers=dict(exc.headers.items()) if exc.headers else {},
+            )
+        return self._response
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        return False
+
+
+class ClientSession:
+    async def __aenter__(self) -> "ClientSession":
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        return False
+
+    def post(self, url: str, json: dict[str, Any]) -> _ResponseContextManager:
+        return _ResponseContextManager(url, json)
+
