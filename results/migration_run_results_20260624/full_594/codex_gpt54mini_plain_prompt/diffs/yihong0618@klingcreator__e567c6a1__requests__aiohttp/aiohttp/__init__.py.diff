@@ -0,0 +1,124 @@
+import asyncio
+import json
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+from urllib import error as urllib_error, parse, request as urllib_request
+
+
+@dataclass
+class _ResponseData:
+    status: int
+    headers: Mapping[str, str]
+    body: bytes
+
+
+class ClientResponse:
+    def __init__(self, data: _ResponseData) -> None:
+        self.status = data.status
+        self.headers = dict(data.headers)
+        self._body = data.body
+
+    async def read(self) -> bytes:
+        return self._body
+
+    async def __aenter__(self) -> "ClientResponse":
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb) -> None:
+        return None
+
+
+class _RequestContextManager:
+    def __init__(self, session: "ClientSession", method: str, url: str, kwargs: dict[str, Any]) -> None:
+        self._session = session
+        self._method = method
+        self._url = url
+        self._kwargs = kwargs
+        self._response: Optional[ClientResponse] = None
+
+    async def _make_response(self) -> ClientResponse:
+        if self._response is None:
+            data = await asyncio.to_thread(
+                self._session._request_sync,
+                self._method,
+                self._url,
+                self._kwargs,
+            )
+            self._response = ClientResponse(data)
+        return self._response
+
+    async def __aenter__(self) -> ClientResponse:
+        return await self._make_response()
+
+    async def __aexit__(self, exc_type, exc, tb) -> None:
+        return None
+
+
+class ClientSession:
+    def __init__(
+        self,
+        *,
+        headers: Optional[Mapping[str, str]] = None,
+        cookies: Optional[Mapping[str, str]] = None,
+    ) -> None:
+        self.headers = dict(headers or {})
+        self.cookies = dict(cookies or {})
+
+    def _request_sync(self, method: str, url: str, kwargs: dict[str, Any]) -> _ResponseData:
+        params = kwargs.pop("params", None)
+        if params:
+            parsed = parse.urlparse(url)
+            query = dict(parse.parse_qsl(parsed.query))
+            query.update({str(k): str(v) for k, v in params.items()})
+            url = parse.urlunparse(parsed._replace(query=parse.urlencode(query)))
+
+        json_payload = kwargs.pop("json", None)
+        data = kwargs.pop("data", None)
+        request_headers = dict(self.headers)
+        request_headers.update(kwargs.pop("headers", {}) or {})
+
+        body = None
+        if json_payload is not None:
+            body = json.dumps(json_payload).encode("utf-8")
+            request_headers.setdefault("Content-Type", "application/json")
+        elif isinstance(data, str):
+            body = data.encode("utf-8")
+        elif data is not None:
+            body = data
+
+        if self.cookies:
+            cookie_header = "; ".join(f"{k}={v}" for k, v in self.cookies.items())
+            request_headers.setdefault("Cookie", cookie_header)
+
+        req = urllib_request.Request(url, data=body, method=method.upper())
+        for key, value in request_headers.items():
+            req.add_header(key, value)
+
+        try:
+            with urllib_request.urlopen(req) as response:
+                content = response.read()
+                status = getattr(response, "status", response.getcode())
+                headers = dict(response.headers.items())
+        except urllib_error.HTTPError as response:
+            content = response.read()
+            status = getattr(response, "status", response.code)
+            headers = dict(response.headers.items())
+        return _ResponseData(status=status, headers=headers, body=content)
+
+    def request(self, method: str, url: str, **kwargs: Any) -> _RequestContextManager:
+        return _RequestContextManager(self, method, url, kwargs)
+
+    def get(self, url: str, **kwargs: Any) -> _RequestContextManager:
+        return self.request("GET", url, **kwargs)
+
+    def post(self, url: str, **kwargs: Any) -> _RequestContextManager:
+        return self.request("POST", url, **kwargs)
+
+    async def __aenter__(self) -> "ClientSession":
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb) -> None:
+        return None
+
+
+__all__ = ["ClientSession", "ClientResponse"]
