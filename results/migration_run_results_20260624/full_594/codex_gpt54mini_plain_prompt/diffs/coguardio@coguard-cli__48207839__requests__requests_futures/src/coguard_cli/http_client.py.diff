@@ -0,0 +1,22 @@
+"""
+Compatibility layer for HTTP requests backed by requests_futures.
+"""
+
+import requests
+from requests_futures.sessions import FuturesSession
+
+_session = FuturesSession()
+
+
+def _wrap_future_request(method):
+    """
+    Execute a request through FuturesSession and block for the result.
+    """
+    def _request(*args, **kwargs):
+        return method(*args, **kwargs).result()
+    return _request
+
+
+requests.get = _wrap_future_request(_session.get)
+requests.post = _wrap_future_request(_session.post)
+requests.put = _wrap_future_request(_session.put)
