+"""
+Minimal FuturesSession implementation used by the CLI.
+"""
+
+from concurrent.futures import ThreadPoolExecutor
+
+import requests
+
+
+class FuturesSession(requests.Session):
+    """
+    A small subset of requests_futures.sessions.FuturesSession.
+    """
+
+    def __init__(self, executor=None, max_workers=8, session=None, adapter_kwargs=None):
+        super().__init__()
+        self._executor = executor or ThreadPoolExecutor(max_workers=max_workers)
+        self._wrapped_session = session
+        self._adapter_kwargs = adapter_kwargs
+
+    def request(self, method, url, **kwargs):
+        """
+        Submit the HTTP request to the executor and return a Future.
+        """
+        request_target = (
+            self._wrapped_session.request
+            if self._wrapped_session
+            else super().request
+        )
+        return self._executor.submit(request_target, method, url, **kwargs)
+
+    def close(self):
+        """
+        Close the underlying session and executor.
+        """
+        try:
+            super().close()
+        finally:
+            self._executor.shutdown(wait=False)
