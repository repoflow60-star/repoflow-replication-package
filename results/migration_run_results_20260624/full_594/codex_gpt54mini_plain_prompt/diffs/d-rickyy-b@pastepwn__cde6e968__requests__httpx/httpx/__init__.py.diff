index 0000000..1494fea
--- /dev/null
+++ b/httpx/__init__.py
@@ -0,0 +1,274 @@
+from __future__ import annotations
+
+import json
+import socket
+import urllib.error
+import urllib.parse
+import urllib.request
+from dataclasses import dataclass
+from typing import Any
+
+
+class HTTPError(Exception):
+    def __init__(self, message: str = "", *, request: Request | None = None):
+        super().__init__(message)
+        self.request = request
+
+
+class RequestError(HTTPError):
+    pass
+
+
+class TimeoutException(RequestError):
+    pass
+
+
+class ConnectTimeout(TimeoutException):
+    pass
+
+
+class ReadTimeout(TimeoutException):
+    pass
+
+
+class WriteTimeout(TimeoutException):
+    pass
+
+
+class PoolTimeout(TimeoutException):
+    pass
+
+
+class ProxyError(RequestError):
+    pass
+
+
+class UnsupportedProtocol(RequestError):
+    pass
+
+
+class DecodingError(HTTPError):
+    pass
+
+
+class TooManyRedirects(RequestError):
+    pass
+
+
+class HTTPStatusError(HTTPError):
+    def __init__(self, message: str, *, request: Request | None = None, response: Response | None = None):
+        super().__init__(message, request=request)
+        self.response = response
+
+
+@dataclass
+class Request:
+    method: str
+    url: str
+    headers: dict[str, str]
+    content: bytes | None
+
+
+class Response:
+    def __init__(
+        self,
+        *,
+        status_code: int,
+        content: bytes,
+        headers: dict[str, str] | None = None,
+        request: Request | None = None,
+        encoding: str = "utf-8",
+    ):
+        self.status_code = status_code
+        self.content = content
+        self.headers = headers or {}
+        self.request = request
+        self.encoding = encoding
+
+    @property
+    def text(self) -> str:
+        return self.content.decode(self.encoding)
+
+    def json(self) -> Any:
+        return json.loads(self.text)
+
+    def raise_for_status(self) -> None:
+        if 400 <= self.status_code:
+            raise HTTPStatusError(f"HTTP {self.status_code}", request=self.request, response=self)
+
+
+class HTTPTransport:
+    def __init__(self, *, proxy: str | None = None):
+        self.proxy = proxy
+
+
+class Timeout:
+    def __init__(self, timeout: float = 5.0, *, connect: float | None = None, read: float | None = None, write: float | None = None, pool: float | None = None):
+        self.timeout = timeout
+        self.connect = connect
+        self.read = read
+        self.write = write
+        self.pool = pool
+
+
+_DEFAULT_TIMEOUT = object()
+
+
+def _normalize_headers(headers: dict[str, str] | None) -> dict[str, str]:
+    return {str(key): str(value) for key, value in (headers or {}).items()}
+
+
+def _scheme_for_url(url: str) -> str:
+    parsed = urllib.parse.urlsplit(url)
+    if parsed.scheme:
+        return f"{parsed.scheme}://"
+    raise UnsupportedProtocol(f"Unsupported URL: {url}")
+
+
+def _build_proxy_map(proxy: str | None = None, mounts: dict[str, HTTPTransport | None] | None = None, url: str | None = None) -> dict[str, str]:
+    if mounts is not None and url is not None:
+        scheme = _scheme_for_url(url)
+        transport = mounts.get(scheme)
+        if transport is None:
+            return {}
+        if transport.proxy is None:
+            return {}
+        return {"http": transport.proxy, "https": transport.proxy}
+
+    if proxy is not None:
+        return {"http": proxy, "https": proxy}
+
+    return {}
+
+
+def _proxy_from_environment(url: str) -> dict[str, str]:
+    parsed = urllib.parse.urlsplit(url)
+    hostname = parsed.hostname
+    if hostname and urllib.request.proxy_bypass(hostname):
+        return {}
+
+    proxies = urllib.request.getproxies()
+    if parsed.scheme == "http":
+        proxy_url = proxies.get("http") or proxies.get("all")
+    elif parsed.scheme == "https":
+        proxy_url = proxies.get("https") or proxies.get("all")
+    else:
+        proxy_url = proxies.get(parsed.scheme)
+
+    if not proxy_url:
+        return {}
+
+    return {"http": proxy_url, "https": proxy_url}
+
+
+class Client:
+    def __init__(
+        self,
+        *,
+        headers: dict[str, str] | None = None,
+        trust_env: bool = True,
+        timeout: Timeout | float | int | None = 5.0,
+        proxy: str | None = None,
+        mounts: dict[str, HTTPTransport | None] | None = None,
+        **_: Any,
+    ):
+        self.headers = _normalize_headers(headers)
+        self.trust_env = trust_env
+        self.timeout = timeout
+        self.proxy = proxy
+        self.mounts = mounts or {}
+
+    def close(self) -> None:
+        return None
+
+    def __enter__(self) -> Client:
+        return self
+
+    def __exit__(self, exc_type, exc, tb) -> None:
+        self.close()
+
+    def request(
+        self,
+        method: str,
+        url: str,
+        *,
+        headers: dict[str, str] | None = None,
+        data: Any = None,
+        timeout: Timeout | float | int | None | object = _DEFAULT_TIMEOUT,
+        **_: Any,
+    ) -> Response:
+        request_headers = self.headers.copy()
+        request_headers.update(_normalize_headers(headers))
+
+        body: bytes | None
+        if data is None:
+            body = None
+        elif isinstance(data, bytes):
+            body = data
+        elif isinstance(data, bytearray):
+            body = bytes(data)
+        elif isinstance(data, str):
+            body = data.encode("utf-8")
+        elif isinstance(data, dict):
+            body = urllib.parse.urlencode(data, doseq=True).encode("utf-8")
+            request_headers.setdefault("Content-Type", "application/x-www-form-urlencoded")
+        else:
+            body = str(data).encode("utf-8")
+
+        proxy_map = _build_proxy_map(proxy=self.proxy, mounts=self.mounts, url=url)
+        if not proxy_map and self.trust_env:
+            proxy_map = _proxy_from_environment(url)
+
+        handlers = []
+        if proxy_map:
+            handlers.append(urllib.request.ProxyHandler(proxy_map))
+
+        opener = urllib.request.build_opener(*handlers) if handlers else urllib.request.build_opener()
+        request = urllib.request.Request(url, data=body, headers=request_headers, method=method)
+
+        timeout_value: float | None
+        if timeout is _DEFAULT_TIMEOUT:
+            timeout = self.timeout
+
+        if isinstance(timeout, Timeout):
+            timeout_value = timeout.timeout
+        elif timeout is None:
+            timeout_value = None
+        else:
+            timeout_value = float(timeout)
+
+        try:
+            with opener.open(request, timeout=timeout_value) as response:
+                content = response.read()
+                status_code = getattr(response, "status", response.getcode())
+                response_headers = dict(response.headers.items())
+        except urllib.error.HTTPError as exc:
+            content = exc.read()
+            status_code = exc.code
+            response_headers = dict(exc.headers.items()) if exc.headers else {}
+        except (TimeoutError, socket.timeout) as exc:
+            raise TimeoutException(str(exc), request=Request(method=method, url=url, headers=request_headers, content=body)) from exc
+        except urllib.error.URLError as exc:
+            reason = exc.reason
+            if isinstance(reason, (TimeoutError, socket.timeout)):
+                raise TimeoutException(str(reason), request=Request(method=method, url=url, headers=request_headers, content=body)) from exc
+            raise RequestError(str(exc), request=Request(method=method, url=url, headers=request_headers, content=body)) from exc
+
+        return Response(
+            status_code=status_code,
+            content=content,
+            headers=response_headers,
+            request=Request(method=method, url=url, headers=request_headers, content=body),
+        )
+
+    def get(self, url: str, **kwargs: Any) -> Response:
+        return self.request("GET", url, **kwargs)
+
+    def post(self, url: str, **kwargs: Any) -> Response:
+        return self.request("POST", url, **kwargs)
+
+    def put(self, url: str, **kwargs: Any) -> Response:
+        return self.request("PUT", url, **kwargs)
+
+    def delete(self, url: str, **kwargs: Any) -> Response:
+        return self.request("DELETE", url, **kwargs)
