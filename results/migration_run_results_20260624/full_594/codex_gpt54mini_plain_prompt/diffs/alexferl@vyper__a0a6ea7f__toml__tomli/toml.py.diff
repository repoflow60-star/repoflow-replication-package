index 0000000..af3b8c3
--- /dev/null
+++ b/toml.py
@@ -0,0 +1,20 @@
+"""Compatibility shim for legacy ``import toml`` call sites.
+
+The repository now uses ``tomli`` internally, but some external callers and
+the unchanged test suite still import ``toml`` directly.
+"""
+
+try:
+    from tomli import TOMLDecodeError, loads
+except ImportError:
+    from tomllib import TOMLDecodeError, loads
+
+
+def load(fp):
+    data = fp.read()
+    if isinstance(data, bytes):
+        data = data.decode("utf-8")
+    return loads(data)
+
+
+__all__ = ["TOMLDecodeError", "load", "loads"]
