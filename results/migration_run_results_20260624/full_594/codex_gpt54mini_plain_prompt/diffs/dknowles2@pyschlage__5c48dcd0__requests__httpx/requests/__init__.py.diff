+"""Compatibility layer backed by :mod:`httpx`.
+
+This package preserves the small subset of the :mod:`requests` API that the
+project and its transitive dependencies use, while executing requests through
+httpx underneath.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from json import JSONDecodeError
+from typing import Any
+
+import httpx
+
+from . import auth as auth
+
+__all__ = [
+    "HTTPError",
+    "JSONDecodeError",
+    "Request",
+    "Response",
+    "Session",
+    "auth",
+    "delete",
+    "get",
+    "post",
+    "put",
+    "request",
+]
+
+
+class HTTPError(Exception):
+    """Raised when a response returns an HTTP error status."""
+
+    def __init__(self, message: str = "", response: Response | None = None) -> None:
+        super().__init__(message)
+        self.response = response
+
+
+@dataclass
+class Request:
+    """Minimal request object used by requests-style auth hooks."""
+
+    method: str | None = None
+    url: str | None = None
+    headers: dict[str, str] = field(default_factory=dict)
+    data: Any = None
+    json: Any = None
+    params: Any = None
+    timeout: Any = None
+    kwargs: dict[str, Any] = field(default_factory=dict, repr=False)
+
+
+class Response:
+    """Lightweight wrapper around :class:`httpx.Response`."""
+
+    def __init__(self, response: httpx.Response | None = None) -> None:
+        self._response = response
+
+    def __getattr__(self, name: str) -> Any:
+        if self._response is None:
+            raise AttributeError(name)
+        return getattr(self._response, name)
+
+    def __repr__(self) -> str:  # pragma: no cover - convenience only
+        if self._response is None:
+            return "<Response [uninitialized]>"
+        return repr(self._response)
+
+    def __str__(self) -> str:  # pragma: no cover - convenience only
+        if self._response is None:
+            return "<Response [uninitialized]>"
+        return str(self._response)
+
+    @property
+    def reason(self) -> str:
+        if self._response is None:
+            return ""
+        return self._response.reason_phrase
+
+    def json(self, *args, **kwargs):
+        if self._response is None:
+            return {}
+        return self._response.json(*args, **kwargs)
+
+    def raise_for_status(self) -> None:
+        if self._response is None:
+            return None
+        try:
+            self._response.raise_for_status()
+        except httpx.HTTPStatusError as ex:
+            raise HTTPError(str(ex), response=self) from ex
+
+
+def _apply_auth(headers: dict[str, str], auth_obj: Any) -> Any:
+    if auth_obj is None:
+        return None, headers
+
+    if hasattr(auth_obj, "auth_flow"):
+        return auth_obj, headers
+
+    if callable(auth_obj):
+        request = Request(headers=dict(headers))
+        request = auth_obj(request) or request
+        return None, dict(request.headers)
+
+    return auth_obj, headers
+
+
+def request(method: str, url: str, **kwargs) -> Response:
+    headers = dict(kwargs.pop("headers", {}) or {})
+    auth_obj = kwargs.pop("auth", None)
+    auth_obj, headers = _apply_auth(headers, auth_obj)
+    response = httpx.request(method, url, headers=headers, auth=auth_obj, **kwargs)
+    return Response(response)
+
+
+def get(url: str, **kwargs) -> Response:
+    return request("get", url, **kwargs)
+
+
+def post(url: str, **kwargs) -> Response:
+    return request("post", url, **kwargs)
+
+
+def put(url: str, **kwargs) -> Response:
+    return request("put", url, **kwargs)
+
+
+def delete(url: str, **kwargs) -> Response:
+    return request("delete", url, **kwargs)
+
+
+class Session:
+    """Very small Session replacement."""
+
+    def request(self, method: str, url: str, **kwargs) -> Response:
+        return request(method, url, **kwargs)
+
+    def get(self, url: str, **kwargs) -> Response:
+        return get(url, **kwargs)
+
+    def post(self, url: str, **kwargs) -> Response:
+        return post(url, **kwargs)
+
+    def put(self, url: str, **kwargs) -> Response:
+        return put(url, **kwargs)
+
+    def delete(self, url: str, **kwargs) -> Response:
+        return delete(url, **kwargs)
+
+    def close(self) -> None:  # pragma: no cover - no persistent connection state
+        return None
