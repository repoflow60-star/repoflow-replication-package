 from collections import OrderedDict
+from urllib.parse import urlencode, urlsplit, urlunsplit
 
 
 class Request:
-    def __init__(self):
-        self.parameters = OrderedDict()
+    def __init__(self, url=None, params=None):
+        self.parameters = OrderedDict(params or [])
+        self.params = self.parameters
         self.payload = None
-        self.url_prefix = None
+        self.url_prefix = url
+        self.url = url
         self.url_components = None
         self.referer = None
         self.content_type = 'application/json'
+        self.headers = OrderedDict()
+        self.data = None
+        self.method = 'GET'
+
+    def putparameter(self, name, value):
+        if not name or value is None:
+            return
+
+        self.parameters[name] = value
+
+    def geturl(self):
+        base_url = self.url_prefix or self.url or ''
+        parts = urlsplit(base_url)
+
+        query_parts = []
+        if parts.query:
+            query_parts.append(parts.query)
+        if self.parameters:
+            query_parts.append(urlencode(list(self.parameters.items()), doseq=True))
+
+        query = '&'.join(part for part in query_parts if part)
+        if not query and base_url.endswith('?'):
+            return base_url
+
+        return urlunsplit((parts.scheme, parts.netloc, parts.path, query, parts.fragment))
+
+    @property
+    def body(self):
+        if self.data is not None:
+            return self.data
+        return self.payload
