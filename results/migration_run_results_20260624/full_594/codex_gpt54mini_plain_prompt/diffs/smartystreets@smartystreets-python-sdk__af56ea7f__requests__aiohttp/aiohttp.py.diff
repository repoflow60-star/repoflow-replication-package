@@ -0,0 +1,93 @@
+from urllib.error import HTTPError
+from urllib.request import ProxyHandler, build_opener, Request as UrlRequest
+
+
+from smartystreets_python_sdk.request import Request
+
+
+def _encode_body(body):
+    if body is None:
+        return None
+    if isinstance(body, bytes):
+        return body
+    return str(body).encode('utf-8')
+
+
+def _decode_body(response):
+    payload = response.read()
+    charset = None
+    headers = getattr(response, 'headers', None)
+    if headers is not None:
+        charset = headers.get_content_charset()
+    if charset is None:
+        charset = 'utf-8'
+    return payload.decode(charset, errors='replace')
+
+
+class ClientResponse:
+    def __init__(self, text, status_code, headers=None, error=None):
+        self.text = text
+        self.status_code = status_code
+        self.headers = headers or {}
+        self.error = error
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, traceback):
+        return False
+
+    def json(self):
+        import json
+
+        return json.loads(self.text)
+
+
+class ClientSession:
+    def prepare_request(self, request):
+        if hasattr(request, 'geturl'):
+            request.url = request.geturl()
+        return request
+
+    def merge_environment_settings(self, url, proxies, stream, verify, cert):
+        return {'proxies': proxies or {}}
+
+    def send(self, request, timeout=None, **kwargs):
+        proxies = kwargs.get('proxies') or {}
+
+        url = request.geturl() if hasattr(request, 'geturl') else getattr(request, 'url', None)
+        if url is None:
+            url = getattr(request, 'url_prefix', None)
+
+        method = getattr(request, 'method', 'GET') or 'GET'
+        headers = dict(getattr(request, 'headers', {}) or {})
+
+        content_type = getattr(request, 'content_type', None)
+        if content_type and 'Content-Type' not in headers:
+            headers['Content-Type'] = content_type
+
+        referer = getattr(request, 'referer', None)
+        if referer and 'Referer' not in headers:
+            headers['Referer'] = referer
+
+        body = _encode_body(getattr(request, 'body', None))
+        if body is None:
+            body = _encode_body(getattr(request, 'payload', None))
+        if body is None:
+            body = _encode_body(getattr(request, 'data', None))
+
+        url_request = UrlRequest(url=url, data=body, headers=headers, method=method)
+        opener = build_opener(ProxyHandler(proxies)) if proxies else build_opener()
+
+        try:
+            response = opener.open(url_request, timeout=timeout)
+        except HTTPError as error:
+            text = _decode_body(error)
+            return ClientResponse(text, error.code, dict(error.headers.items()), error)
+
+        with response:
+            text = _decode_body(response)
+            status = getattr(response, 'status', None)
+            if status is None:
+                status = getattr(response, 'code', None)
+            return ClientResponse(text, status, dict(response.headers.items()))
