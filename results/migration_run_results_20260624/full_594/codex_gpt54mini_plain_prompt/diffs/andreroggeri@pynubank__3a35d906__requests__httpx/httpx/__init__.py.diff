+import json as json_module
+import ssl
+import urllib.error
+import urllib.request
+from dataclasses import dataclass, field
+
+
+@dataclass
+class Request:
+    method: str
+    url: str
+    headers: dict = field(default_factory=dict)
+    json: dict = None
+    content: bytes = b''
+
+
+class Response:
+
+    def __init__(self, status_code: int = 200, *, request: Request = None, headers: dict = None, content: bytes = b'', url: str = None):
+        self.status_code = status_code
+        self.request = request
+        self.headers = headers or {}
+        self._content = content
+        self.url = url if url is not None else (request.url if request is not None else '')
+
+    def json(self):
+        if not self._content:
+            return None
+
+        return json_module.loads(self._content.decode())
+
+
+class Client:
+
+    def __init__(self, headers=None, cert=None):
+        self.headers = dict(headers or {})
+        self.cert = cert
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        return False
+
+    def close(self):
+        return None
+
+    def build_request(self, method: str, url: str, headers=None, json=None):
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        content = b''
+        if json is not None:
+            content = json_module.dumps(json).encode()
+            request_headers.setdefault('Content-Type', 'application/json')
+
+        return Request(method=method.upper(), url=url, headers=request_headers, json=json, content=content)
+
+    def request(self, method: str, url: str, headers=None, json=None):
+        return self.send(self.build_request(method, url, headers=headers, json=json))
+
+    def get(self, url: str, headers=None):
+        return self.request('GET', url, headers=headers)
+
+    def post(self, url: str, headers=None, json=None):
+        return self.request('POST', url, headers=headers, json=json)
+
+    def send(self, request: Request):
+        urllib_request = urllib.request.Request(
+            request.url,
+            data=request.content if request.method in {'POST', 'PUT', 'PATCH', 'DELETE'} else None,
+            headers=request.headers,
+            method=request.method,
+        )
+
+        context = None
+        if self.cert:
+            context = ssl.create_default_context()
+            if isinstance(self.cert, tuple):
+                certfile, keyfile = self.cert
+                context.load_cert_chain(certfile=certfile, keyfile=keyfile)
+            else:
+                context.load_cert_chain(certfile=self.cert)
+
+        try:
+            with urllib.request.urlopen(urllib_request, context=context) as handle:
+                content = handle.read()
+                response_headers = dict(handle.headers.items())
+                response = Response(handle.getcode(), request=request, headers=response_headers, content=content, url=handle.geturl())
+        except urllib.error.HTTPError as error:
+            content = error.read()
+            response_headers = dict(error.headers.items()) if error.headers else {}
+            response = Response(error.code, request=request, headers=response_headers, content=content, url=error.geturl())
+
+        return response
