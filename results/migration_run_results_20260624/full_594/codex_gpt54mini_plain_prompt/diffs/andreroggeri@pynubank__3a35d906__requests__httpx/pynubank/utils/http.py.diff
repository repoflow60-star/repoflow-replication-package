+def _request(method: str, url: str, headers=None, cert=None, json=None):
+    client_kwargs = {}
+    if cert:
+        client_kwargs['cert'] = cert
+
+    with httpx.Client(**client_kwargs) as client:
+        request = client.build_request(method, url, headers=headers, json=json)
+        return client.send(request)
+
+
+def get(url: str, headers=None, cert=None):
+    return _request('GET', url, headers=headers, cert=cert)
+
+
+def post(url: str, json: dict, headers=None, cert=None):
+    return _request('POST', url, headers=headers, cert=cert, json=json)
