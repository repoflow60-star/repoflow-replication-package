+class _TransportSession:
+
+    def __init__(self, headers=None):
+        self.headers = headers or {}
+        self._mounted_adapters = {}
+
+    def mount(self, prefix, adapter):
+        self._mounted_adapters[prefix] = adapter
+
+    def _select_adapter(self, url):
+        matching = [
+            (prefix, adapter)
+            for prefix, adapter in self._mounted_adapters.items()
+            if url.startswith(prefix)
+        ]
+        if not matching:
+            return None
+        matching.sort(key=lambda item: len(item[0]), reverse=True)
+        return matching[0][1]
+
+    async def request(self, method, url, params=None, data=None, headers=None):
+        adapter = self._select_adapter(url)
+        if adapter is not None:
+            return self._request_via_requests(
+                adapter, method, url, params=params, data=data, headers=headers
+            )
+        return await self._request_via_aiohttp(
+            method, url, params=params, data=data, headers=headers
+        )
+
+    def _request_via_requests(self, adapter, method, url, params=None, data=None, headers=None):
+        import requests
+
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+        with requests.Session() as session:
+            request = requests.Request(
+                method=method,
+                url=url,
+                params=params,
+                data=data,
+                headers=request_headers,
+            )
+            prepared = session.prepare_request(request)
+            response = adapter.send(prepared)
+        try:
+            return response.json()
+        except (ValueError, json.decoder.JSONDecodeError) as exc:
+            raise errors.PluginError("no JSON in API response") from exc
+
+    async def _request_via_aiohttp(self, method, url, params=None, data=None, headers=None):
+        try:
+            import aiohttp as _aiohttp
+        except ImportError as exc:
+            raise errors.PluginError("aiohttp is required for live API requests") from exc
+
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+        async with _aiohttp.ClientSession(headers=request_headers) as session:
+            async with session.request(
+                method,
+                url,
+                params=params,
+                data=data,
+            ) as response:
+                try:
+                    return await response.json(content_type=None)
+                except (_aiohttp.ContentTypeError, json.decoder.JSONDecodeError, ValueError) as exc:
+                    raise errors.PluginError("no JSON in API response") from exc
