--- /dev/null
+++ b/httpx.py
@@ -0,0 +1,123 @@
+import json as _json
+import sys as _sys
+from urllib.error import HTTPError
+import urllib.parse as _urlparse
+import urllib.request as _urlrequest
+from typing import Any, Mapping, Optional
+
+
+class Response:
+    def __init__(self, status_code: int, content: bytes, headers: Mapping[str, str], url: str):
+        self.status_code = status_code
+        self.content = content
+        self.headers = dict(headers)
+        self.url = url
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status_code < 400
+
+    @property
+    def text(self) -> str:
+        return self.content.decode("utf-8", errors="replace")
+
+    def json(self) -> Any:
+        return _json.loads(self.text)
+
+    def __repr__(self) -> str:
+        return f"<Response [{self.status_code}]>"
+
+
+class Session:
+    def __init__(self) -> None:
+        self.headers: dict[str, str] = {}
+        self.cookies: dict[str, str] | Any = {}
+        self.timeout: Optional[float] = None
+
+    def request(
+        self,
+        method: str,
+        url: str,
+        *,
+        params: Optional[Mapping[str, Any]] = None,
+        data: Any = None,
+        json: Any = None,
+        headers: Optional[Mapping[str, str]] = None,
+        timeout: Optional[float] = None,
+    ) -> Response:
+        request_url = self._merge_params(url, params)
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+        cookie_header = self._cookie_header(self.cookies)
+        if cookie_header and "Cookie" not in request_headers and "cookie" not in request_headers:
+            request_headers["Cookie"] = cookie_header
+        body = self._encode_body(data=data, json=json, headers=request_headers)
+        request = _urlrequest.Request(request_url, data=body, method=method.upper())
+        for key, value in request_headers.items():
+            request.add_header(key, value)
+        opener = _urlrequest.build_opener(_urlrequest.HTTPCookieProcessor(self.cookies))
+        try:
+            response = opener.open(request, timeout=timeout if timeout is not None else self.timeout)
+        except HTTPError as response:
+            pass
+        content = response.read()
+        close = getattr(response, "close", None)
+        if callable(close):
+            close()
+        return Response(
+            status_code=getattr(response, "status", response.getcode()),
+            content=content,
+            headers=response.headers,
+            url=response.geturl(),
+        )
+
+    def get(self, url: str, **kwargs: Any) -> Response:
+        return self.request("GET", url, **kwargs)
+
+    def post(self, url: str, **kwargs: Any) -> Response:
+        return self.request("POST", url, **kwargs)
+
+    @staticmethod
+    def _merge_params(url: str, params: Optional[Mapping[str, Any]]) -> str:
+        if not params:
+            return url
+        parts = _urlparse.urlsplit(url)
+        query = _urlparse.parse_qsl(parts.query, keep_blank_values=True)
+        query.extend((str(key), str(value)) for key, value in params.items())
+        return _urlparse.urlunsplit(
+            (parts.scheme, parts.netloc, parts.path, _urlparse.urlencode(query), parts.fragment)
+        )
+
+    @staticmethod
+    def _cookie_header(cookies: Any) -> str:
+        if not cookies:
+            return ""
+        if isinstance(cookies, Mapping):
+            return "; ".join(f"{key}={value}" for key, value in cookies.items())
+        cookie_items = []
+        for cookie in cookies:
+            name = getattr(cookie, "name", None)
+            value = getattr(cookie, "value", None)
+            if name is not None and value is not None:
+                cookie_items.append(f"{name}={value}")
+        return "; ".join(cookie_items)
+
+    @staticmethod
+    def _encode_body(*, data: Any, json: Any, headers: Optional[dict[str, str]]) -> Optional[bytes]:
+        if json is not None:
+            if headers is not None and not any(k.lower() == "content-type" for k in headers):
+                headers["Content-Type"] = "application/json"
+            return _json.dumps(json).encode("utf-8")
+        if data is None:
+            return None
+        if isinstance(data, bytes):
+            return data
+        if isinstance(data, str):
+            return data.encode("utf-8")
+        if isinstance(data, Mapping):
+            return _urlparse.urlencode(data).encode("utf-8")
+        return data
+
+
+_sys.modules.setdefault("requests", _sys.modules[__name__])
