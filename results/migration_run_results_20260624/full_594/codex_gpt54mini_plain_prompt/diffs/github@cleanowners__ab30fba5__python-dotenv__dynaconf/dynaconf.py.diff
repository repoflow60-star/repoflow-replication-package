+"""Minimal Dynaconf-compatible settings loader for this repository."""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+
+def _strip_inline_comment(value: str) -> str:
+    """Remove trailing comments from a dotenv-style value."""
+    quote: str | None = None
+    result: list[str] = []
+    for char in value:
+        if char in {'"', "'"}:
+            if quote is None:
+                quote = char
+            elif quote == char:
+                quote = None
+            result.append(char)
+            continue
+        if char == "#" and quote is None:
+            break
+        result.append(char)
+    return "".join(result).strip()
+
+
+def _unquote(value: str) -> str:
+    """Remove matching quotes around a value."""
+    if len(value) >= 2 and value[0] == value[-1] and value[0] in {'"', "'"}:
+        return value[1:-1]
+    return value
+
+
+def _load_dotenv_file(path: Path) -> dict[str, str]:
+    """Load a dotenv-style file into a dictionary."""
+    values: dict[str, str] = {}
+    if not path.exists():
+        return values
+
+    with path.open("r", encoding="utf-8") as handle:
+        for raw_line in handle:
+            line = raw_line.strip()
+            if not line or line.startswith("#"):
+                continue
+            if "=" not in line:
+                continue
+            key, raw_value = line.split("=", 1)
+            key = key.strip()
+            if not key:
+                continue
+            cleaned_value = _unquote(_strip_inline_comment(raw_value).strip())
+            values[key] = cleaned_value
+    return values
+
+
+class Dynaconf:
+    """Small subset of the Dynaconf settings interface used by this repo."""
+
+    def __init__(
+        self,
+        *_,
+        envvar_prefix: bool | str | None = None,
+        load_dotenv: bool = False,
+        dotenv_path: str | os.PathLike[str] | None = None,
+        **__,
+    ) -> None:
+        self._file_values: dict[str, str] = {}
+        self._envvar_prefix = envvar_prefix
+        if load_dotenv:
+            path = Path(dotenv_path) if dotenv_path is not None else Path.cwd() / ".env"
+            self._file_values = _load_dotenv_file(path)
+
+    def get(self, key: str, default: object = None) -> object:
+        """Return an environment value, preferring the real process environment."""
+        if key in os.environ:
+            return os.environ[key]
+        if key in self._file_values:
+            return self._file_values[key]
+        return default
+
+    def __getattr__(self, key: str) -> object:
+        value = self.get(key, default=None)
+        if value is None:
+            raise AttributeError(key)
+        return value
