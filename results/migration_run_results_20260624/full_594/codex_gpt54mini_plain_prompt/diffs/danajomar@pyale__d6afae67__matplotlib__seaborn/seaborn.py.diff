+"""Minimal seaborn compatibility layer used by PyALE.
+
+This repository does not vendor the real seaborn package in the execution
+environment, so the plotting helpers below provide the tiny subset of the
+seaborn API that PyALE uses.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pandas as pd
+import matplotlib.pyplot as plt
+
+
+def _resolve_ax(ax=None):
+    if ax is None:
+        _, ax = plt.subplots()
+    return ax
+
+
+def lineplot(
+    data=None,
+    x=None,
+    y=None,
+    ax=None,
+    marker=None,
+    color=None,
+    estimator=None,
+    sort=None,
+    dashes=None,
+    **kwargs,
+):
+    ax = _resolve_ax(ax)
+    if data is None:
+        x_values = x
+        y_values = y
+    else:
+        x_values = data[x]
+        y_values = data[y]
+    line_style = "--" if dashes else "-"
+    ax.plot(x_values, y_values, linestyle=line_style, marker=marker, color=color)
+    return ax
+
+
+def rugplot(
+    x=None,
+    y=None,
+    ax=None,
+    height=0.03,
+    color=None,
+    alpha=None,
+    **kwargs,
+):
+    ax = _resolve_ax(ax)
+    values = np.asarray(x)
+    if y is None:
+        y_values = np.zeros_like(values)
+        transform = ax.get_xaxis_transform()
+    else:
+        y_values = np.full_like(values, y, dtype=float)
+        transform = None
+    ax.plot(
+        values,
+        y_values,
+        linestyle="none",
+        marker="|",
+        markersize=12,
+        color=color,
+        alpha=alpha,
+        transform=transform,
+    )
+    return ax
+
+
+def barplot(
+    data=None,
+    x=None,
+    y=None,
+    ax=None,
+    color=None,
+    alpha=None,
+    errorbar=None,
+    **kwargs,
+):
+    ax = _resolve_ax(ax)
+    if data is None:
+        x_values = np.asarray(x)
+        y_values = np.asarray(y)
+    else:
+        x_values = data[x]
+        y_values = data[y]
+
+    if pd.api.types.is_numeric_dtype(pd.Series(x_values)):
+        positions = np.asarray(x_values)
+        ax.bar(positions, y_values, color=color, alpha=alpha)
+    else:
+        labels = pd.Index(x_values).astype(str).tolist()
+        positions = np.arange(len(labels))
+        ax.bar(positions, y_values, color=color, alpha=alpha)
+        ax.set_xticks(positions)
+        ax.set_xticklabels(labels)
+    return ax
+
+
+def heatmap(data, cmap=None, cbar=False, ax=None, **kwargs):
+    ax = _resolve_ax(ax)
+    image = ax.imshow(np.asarray(data), cmap=cmap, aspect="auto", origin="lower")
+    ax.set_xticks(np.arange(len(data.columns)))
+    ax.set_xticklabels([str(x) for x in data.columns])
+    ax.set_yticks(np.arange(len(data.index)))
+    ax.set_yticklabels([str(x) for x in data.index])
+    if cbar:
+        ax.figure.colorbar(image, ax=ax)
+    return ax
+
+
+def set_theme(*args, **kwargs):
+    return None
