 T = TypeVar("T")
 
+_EVENT_LOOP: Optional[asyncio.AbstractEventLoop] = None
+_EVENT_LOOP_THREAD: Optional[threading.Thread] = None
+
+
+@dataclass
+class _Response:
+    status_code: int
+    headers: Dict[str, str]
+    _body: bytes
+
+    @property
+    def text(self) -> str:
+        charset = _charset_from_content_type(self.headers.get("content-type"))
+        try:
+            return self._body.decode(charset)
+        except LookupError:
+            return self._body.decode("utf-8")
+
+    def json(self) -> Any:
+        return json.loads(self.text)
+
+
+def _charset_from_content_type(content_type: Optional[str]) -> str:
+    if not content_type:
+        return "utf-8"
+
+    parts = [part.strip() for part in content_type.split(";")]
+    for part in parts[1:]:
+        if part.lower().startswith("charset="):
+            charset = part.split("=", 1)[1].strip().strip("'\"")
+            if charset:
+                return charset
+    return "utf-8"
+
+
+def _normalize_headers(raw_headers: Any) -> Dict[str, str]:
+    headers: Dict[str, str] = {}
+
+    for name, values in raw_headers.getAllRawHeaders():
+        if isinstance(name, bytes):
+            key = name.decode("latin-1").lower()
+        else:
+            key = str(name).lower()
+        headers[key] = ", ".join(
+            value.decode("latin-1") if isinstance(value, bytes) else str(value)
+            for value in values
+        )
+    return headers
+
+
+def _ensure_event_loop() -> asyncio.AbstractEventLoop:
+    global _EVENT_LOOP
+    global _EVENT_LOOP_THREAD
+
+    if _EVENT_LOOP is not None:
+        return _EVENT_LOOP
+
+    loop = asyncio.new_event_loop()
+
+    try:
+        from twisted.internet import asyncioreactor
+
+        asyncioreactor.install(loop)
+    except Exception:
+        # If Twisted has already installed a reactor, we leave it alone and still
+        # use the dedicated asyncio loop for blocking treq calls.
+        pass
+
+    def _run_loop() -> None:
+        asyncio.set_event_loop(loop)
+        loop.run_forever()
+
+    thread = threading.Thread(
+        target=_run_loop,
+        name="resend-treq-event-loop",
+        daemon=True,
+    )
+    thread.start()
+
+    _EVENT_LOOP = loop
+    _EVENT_LOOP_THREAD = thread
+    return loop
+
+
+def _run_on_event_loop(coro: Awaitable[Any]) -> Any:
+    loop = _ensure_event_loop()
+    future = asyncio.run_coroutine_threadsafe(coro, loop)
+    return future.result()
+
 
