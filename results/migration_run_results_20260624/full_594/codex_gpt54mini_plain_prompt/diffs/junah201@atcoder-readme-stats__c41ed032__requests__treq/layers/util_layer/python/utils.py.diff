+_reactor_started = False
+_reactor_start_lock = threading.Lock()
+_reactor_ready = threading.Event()
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor_running():
+    if treq is None:
+        return
+
+    global _reactor_started
+
+    if reactor.running:
+        return
+
+    with _reactor_start_lock:
+        if _reactor_started or reactor.running:
+            return
+
+        _reactor_started = True
+        threading.Thread(target=_run_reactor, daemon=True).start()
+
+    _reactor_ready.wait()
+
+
+def _fetch_html(url: str) -> str:
+    if treq is None:
+        request = Request(url, headers={"User-Agent": "atcoder-readme-stats"})
+
+        try:
+            with urlopen(request) as response:
+                return response.read().decode("utf-8", errors="replace")
+        except HTTPError as exc:
+            return exc.read().decode("utf-8", errors="replace")
+        except URLError as exc:
+            raise exc
+
+    _ensure_reactor_running()
+
+    def _get_html():
+        def _decode(response):
+            return treq.content(response).addCallback(
+                lambda body: body.decode("utf-8", errors="replace")
+            )
+
+        return treq.get(url).addCallback(_decode)
+
+    return blockingCallFromThread(reactor, _get_html)
+
