+def _pycurl_get(url):
+    response = SimpleNamespace(status_code=0, content=b"")
+    buffer = bytearray()
+    curl = pycurl.Curl()
+
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEFUNCTION, buffer.extend)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.NOSIGNAL, 1)
+        curl.perform()
+        response.status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        response.content = bytes(buffer)
+        return response
+    finally:
+        curl.close()
+
+
+requests = SimpleNamespace(get=_pycurl_get)
