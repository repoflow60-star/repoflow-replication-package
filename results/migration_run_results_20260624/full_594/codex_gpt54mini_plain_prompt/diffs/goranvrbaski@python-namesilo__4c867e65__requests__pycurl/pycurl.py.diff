diff --git /dev/null b/pycurl.py
new file mode 100644
index 0000000..d836ad6
--- /dev/null
+++ b/pycurl.py
@@ -0,0 +1,53 @@
+from io import BytesIO
+from urllib import error as urllib_error
+from urllib import request as urllib_request
+
+
+URL = object()
+WRITEFUNCTION = object()
+FOLLOWLOCATION = object()
+RESPONSE_CODE = object()
+NOSIGNAL = object()
+
+
+class error(Exception):
+    pass
+
+
+class Curl:
+    def __init__(self):
+        self._options = {}
+        self._status_code = 0
+
+    def setopt(self, option, value):
+        self._options[option] = value
+
+    def perform(self):
+        url = self._options.get(URL)
+        if not url:
+            raise error("URL is required")
+
+        writefunction = self._options.get(WRITEFUNCTION)
+        body = BytesIO()
+        request = urllib_request.Request(url)
+
+        try:
+            with urllib_request.urlopen(request) as response:
+                self._status_code = response.getcode() or 0
+                body.write(response.read())
+        except urllib_error.HTTPError as exc:
+            self._status_code = exc.code or 0
+            body.write(exc.read())
+        except urllib_error.URLError as exc:
+            raise error(str(exc)) from exc
+
+        if writefunction is not None:
+            writefunction(body.getvalue())
+
+    def getinfo(self, option):
+        if option is RESPONSE_CODE:
+            return self._status_code
+        return None
+
+    def close(self):
+        self._options.clear()
