+class CurlSession(object):
+    """Minimal session backed by pycurl."""
+
+    def get(self, url, params=None, stream=False, verify=True):
+        return self._request('GET', url, params=params, verify=verify)
+
+    def post(self, url, data=None, params=None, headers=None, verify=True):
+        return self._request(
+            'POST', url, params=params, data=data, headers=headers,
+            verify=verify)
+
+    @staticmethod
+    def _build_url(url, params):
+        if not params:
+            return url
+        query = urllib_parse.urlencode(params)
+        separator = '&' if '?' in url else '?'
+        return ''.join([url, separator, query])
+
+    @staticmethod
+    def _coerce_body(data):
+        if data is None:
+            return None
+        if isinstance(data, bytes):
+            return data
+        return data.encode('utf-8')
+
+    def _request(self, method, url, params=None, data=None, headers=None,
+                 verify=True):
+        if pycurl is None:
+            raise CASError('pycurl is required to make HTTP requests')
+
+        request_url = self._build_url(url, params)
+        body = io.BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, request_url)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            curl.setopt(pycurl.WRITEFUNCTION, body.write)
+            if method == 'POST':
+                curl.setopt(pycurl.POST, 1)
+                payload = self._coerce_body(data)
+                if payload is None:
+                    payload = b''
+                curl.setopt(pycurl.POSTFIELDS, payload)
+                curl.setopt(pycurl.POSTFIELDSIZE, len(payload))
+            if headers:
+                curl.setopt(
+                    pycurl.HTTPHEADER,
+                    ['%s: %s' % (key, value) for key, value in headers.items()]
+                )
+            if request_url.startswith('https://'):
+                curl.setopt(pycurl.SSL_VERIFYPEER, 1 if verify else 0)
+                curl.setopt(pycurl.SSL_VERIFYHOST, 2 if verify else 0)
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            return _CurlResponse(body.getvalue(), status_code)
+        except pycurl.error as exc:
+            raise CASError(str(exc))
+        finally:
+            curl.close()
+
+
+def _text(value):
+    if isinstance(value, bytes):
+        return value.decode('utf-8')
+    return value
+
