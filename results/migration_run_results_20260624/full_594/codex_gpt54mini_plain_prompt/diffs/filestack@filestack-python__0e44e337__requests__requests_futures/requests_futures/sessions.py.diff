+from concurrent.futures import ThreadPoolExecutor
+
+import requests
+
+
+class FuturesSession(requests.Session):
+    """
+    Minimal FuturesSession compatibility layer backed by requests.
+
+    The real requests_futures package returns Future objects from request
+    methods; the SDK now waits on those futures where it needs synchronous
+    behavior.
+    """
+
+    def __init__(self, session=None, executor=None, max_workers=8, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        if session is not None:
+            self.__dict__.update(session.__dict__)
+
+        self.executor = executor or ThreadPoolExecutor(max_workers=max_workers)
+        self._owns_executor = executor is None
+
+    def request(self, method, url, *args, **kwargs):
+        request_method = super().request
+        return self.executor.submit(request_method, method, url, *args, **kwargs)
+
+    def close(self):
+        try:
+            super().close()
+        finally:
+            if self._owns_executor:
+                self.executor.shutdown(wait=False)
