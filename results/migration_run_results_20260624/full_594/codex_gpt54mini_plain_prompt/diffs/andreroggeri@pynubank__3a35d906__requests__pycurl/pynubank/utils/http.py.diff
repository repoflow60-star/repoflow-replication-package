 class HttpClient:
@@ -47,3 +78,129 @@ class HttpClient:
 
     def post(self, url: str, json: dict) -> dict:
         return self._handle_response(post(url, json=json, headers=self._headers, **self._cert_args))
+
+
+def get(url: str, headers: dict = None, pkcs12_data: bytes = None, pkcs12_password: str = '') -> Response:
+    return _request('GET', url, headers=headers, pkcs12_data=pkcs12_data, pkcs12_password=pkcs12_password)
+
+
+def post(url: str, json: dict, headers: dict = None, pkcs12_data: bytes = None,
+         pkcs12_password: str = '') -> Response:
+    return _request('POST', url, headers=headers, json_payload=json, pkcs12_data=pkcs12_data,
+                    pkcs12_password=pkcs12_password)
+
+
+def _request(method: str, url: str, headers: dict = None, json_payload: dict = None,
+             pkcs12_data: bytes = None, pkcs12_password: str = '') -> Response:
+    headers = headers or {}
+
+    if pycurl is not None:
+        return _pycurl_request(method, url, headers, json_payload, pkcs12_data, pkcs12_password)
+
+    return _urllib_request(method, url, headers, json_payload)
+
+
+def _pycurl_request(method: str, url: str, headers: dict, json_payload: dict = None,
+                    pkcs12_data: bytes = None, pkcs12_password: str = '') -> Response:
+    body = BytesIO()
+    raw_headers = []
+    cert_path = None
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, lambda line: raw_headers.append(line) or len(line))
+        curl.setopt(pycurl.HTTPHEADER, [f'{name}: {value}' for name, value in headers.items()])
+
+        if method == 'POST':
+            payload = json.dumps(json_payload or {}).encode()
+            curl.setopt(pycurl.POST, True)
+            curl.setopt(pycurl.POSTFIELDS, payload)
+            curl.setopt(pycurl.POSTFIELDSIZE, len(payload))
+
+        if pkcs12_data:
+            cert_path = _write_cert_file(pkcs12_data)
+            curl.setopt(pycurl.SSLCERTTYPE, 'P12')
+            curl.setopt(pycurl.SSLCERT, cert_path)
+            if pkcs12_password:
+                curl.setopt(pycurl.SSLKEYPASSWD, pkcs12_password)
+
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        response_url = curl.getinfo(pycurl.EFFECTIVE_URL) or url
+    except pycurl.error as exc:
+        status_code = 0
+        response_url = url
+        body = BytesIO(str(exc).encode())
+        raw_headers = []
+    finally:
+        curl.close()
+        if cert_path and os.path.exists(cert_path):
+            os.unlink(cert_path)
+
+    return Response(url=response_url, status_code=status_code, headers=_parse_headers(raw_headers),
+                    content=body.getvalue())
+
+
+def _urllib_request(method: str, url: str, headers: dict, json_payload: dict = None) -> Response:
+    if Request is None or urlopen is None:
+        return Response(url=url, status_code=0, headers={}, content=b'pycurl is not available')
+
+    data = None
+    if method == 'POST':
+        data = json.dumps(json_payload or {}).encode()
+
+    request = Request(url, data=data, headers=headers, method=method)
+
+    try:
+        with urlopen(request) as response:
+            return Response(
+                url=response.geturl(),
+                status_code=response.getcode(),
+                headers=dict(response.headers.items()),
+                content=response.read(),
+            )
+    except HTTPError as exc:
+        return Response(
+            url=exc.geturl() or url,
+            status_code=exc.code,
+            headers=dict(exc.headers.items()) if exc.headers else {},
+            content=exc.read(),
+        )
+    except URLError as exc:
+        return Response(url=url, status_code=0, headers={}, content=str(exc).encode())
+
+
+def _write_cert_file(pkcs12_data: bytes) -> str:
+    with tempfile.NamedTemporaryFile(suffix='.p12', delete=False) as cert_file:
+        cert_file.write(pkcs12_data)
+        return cert_file.name
+
+
+def _parse_headers(raw_headers) -> Dict[str, str]:
+    parsed = {}
+    current = {}
+    for line in raw_headers:
+        if isinstance(line, bytes):
+            line = line.decode('iso-8859-1')
+        line = line.strip()
+        if not line:
+            if current:
+                parsed = current
+                current = {}
+            continue
+        if line.startswith('HTTP/'):
+            if current:
+                parsed = current
+                current = {}
+            continue
+
+        if ':' not in line:
+            continue
+
+        name, value = line.split(':', 1)
+        current[name.strip()] = value.strip()
+
+    return current or parsed
