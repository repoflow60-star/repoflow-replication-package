@@ -0,0 +1,17 @@
+"""Minimal plac compatibility layer for the repository CLI."""
+
+from __future__ import annotations
+
+from typing import Iterable, Optional
+
+
+def call(command, argv: Optional[Iterable[str]] = None):
+    """Invoke a command object with command-line arguments."""
+    if hasattr(command, "main"):
+        return command.main(args=list(argv) if argv is not None else None)
+    if callable(command):
+        if argv is None:
+            return command()
+        return command(*list(argv))
+    raise TypeError("command must be callable or expose a main method")
+
