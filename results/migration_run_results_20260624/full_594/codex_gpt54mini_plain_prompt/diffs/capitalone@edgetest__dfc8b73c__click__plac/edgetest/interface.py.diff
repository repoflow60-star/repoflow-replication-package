+class CLICommand:
+    """Minimal command object compatible with click's test runner."""
+
+    name = "edgetest"
+
+    def main(self, args=None, prog_name=None, standalone_mode=True):
+        """Run the command."""
+        parser = _build_parser()
+        namespace = parser.parse_args(args=args)
+        return _run_cli(
+            config=namespace.config,
+            requirements=namespace.requirements,
+            environment=namespace.environment,
+            notest=namespace.notest,
+            nosetup=namespace.nosetup,
+            extras=namespace.extras,
+            deps=namespace.deps,
+            command=namespace.command,
+            export=namespace.export,
+        )
+
+
+cli = CLICommand()
+
+
+def main(argv: Optional[List[str]] = None):
+    """Entry point for the console script."""
+    return plac.call(cli, argv=argv)
