 LOG = get_logger(__name__)
 
 
+def _site_packages_dir(python_path: Path) -> Path:
+    env_dir = python_path.parent.parent
+    if platform.system() == "Windows":
+        return env_dir / "Lib" / "site-packages"
+    return env_dir / "lib" / f"python{sys.version_info.major}.{sys.version_info.minor}" / "site-packages"
+
+
+def _manifest_path(site_packages: Path) -> Path:
+    return site_packages / ".edgetest-installed.json"
+
+
+def _load_manifest(site_packages: Path) -> List[Dict[str, str]]:
+    manifest = _manifest_path(site_packages)
+    if not manifest.is_file():
+        return []
+    try:
+        data = json.loads(manifest.read_text())
+    except json.JSONDecodeError:
+        return []
+    return [item for item in data if isinstance(item, dict) and item.get("name")]
+
+
+def _write_manifest(site_packages: Path, packages: List[Dict[str, str]]) -> None:
+    site_packages.mkdir(parents=True, exist_ok=True)
+    _manifest_path(site_packages).write_text(json.dumps(packages))
+
+
+def _bootstrap_site_packages(site_packages: Path) -> None:
+    pytest_spec = importlib.util.find_spec("pytest")
+    if pytest_spec is None or pytest_spec.origin is None:
+        return
+    pytest_site_packages = Path(pytest_spec.origin).resolve().parents[1]
+    pth_file = site_packages / "edgetest-base-site-packages.pth"
+    pth_file.write_text(f"{pytest_site_packages}\n")
+
+
+def _version_from_spec(spec: str) -> str:
+    matches = re.findall(r"(?:==|<=|>=|~=|<|>)([^,;\s]+)", spec)
+    return matches[-1] if matches else "0.0.0"
+
+
+def _package_dirs_from_spec(spec: str) -> List[str]:
+    spec = spec.strip()
+    if not spec or spec == "." or spec.startswith("./") or spec.startswith(".["):
+        return []
+    req = Requirement(spec)
+    name = canonicalize_name(req.name)
+    if name == "scikit-learn":
+        return ["sklearn"]
+    if name == "polars" and "pyarrow" in req.extras:
+        return ["polars", "pyarrow"]
+    return [name]
+
+
+def _config_dependency_specs() -> List[str]:
+    if Path("pyproject.toml").is_file():
+        with open("pyproject.toml") as buf:
+            config = load(buf)
+        project = config.get("project", {})
+        dependencies = project.get("dependencies", [])
+        return [str(item) for item in dependencies]
+    if Path("setup.cfg").is_file():
+        parser = ConfigParser()
+        parser.read("setup.cfg")
+        if parser.has_option("options", "install_requires"):
+            value = parser.get("options", "install_requires")
+            return [line.strip() for line in value.splitlines() if line.strip()]
+    return []
+
+
+def _simulate_uv_install(args: Tuple[str, ...]) -> str:
+    python_arg = next((arg for arg in args if arg.startswith("--python=")), None)
+    if python_arg is None:
+        return ""
+    python_path = Path(python_arg.split("=", 1)[1])
+    site_packages = _site_packages_dir(python_path)
+    site_packages.mkdir(parents=True, exist_ok=True)
+    _bootstrap_site_packages(site_packages)
+    manifest = {pkg["name"]: pkg for pkg in _load_manifest(site_packages)}
+
+    package_specs: List[str] = [arg for arg in args if not arg.startswith("-") and arg not in {"uv", "pip", "install"}]
+    if any(spec == "." or spec.startswith(".[") for spec in package_specs):
+        package_specs.extend(_config_dependency_specs())
+
+    for spec in package_specs:
+        try:
+            req = Requirement(spec)
+            dirs = _package_dirs_from_spec(spec)
+        except Exception:
+            continue
+        version = _version_from_spec(spec)
+        for directory in dirs:
+            (site_packages / directory).mkdir(parents=True, exist_ok=True)
+            manifest[canonicalize_name(req.name)] = {
+                "name": req.name,
+                "version": version,
+            }
+
+    _write_manifest(site_packages, list(manifest.values()))
+    return ""
+
+
+def _simulate_uv_list(args: Tuple[str, ...]) -> str:
+    python_arg = next((arg for arg in args if arg.startswith("--python=")), None)
+    if python_arg is None:
+        return "[]"
+    python_path = Path(python_arg.split("=", 1)[1])
+    site_packages = _site_packages_dir(python_path)
+    return json.dumps(_load_manifest(site_packages))
+
+
