+"""Minimal click.testing compatibility for the repository test suite."""
+
+from __future__ import annotations
+
+import contextlib
+import io
+import os
+import shutil
+import tempfile
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Optional
+
+
+@dataclass
+class Result:
+    """Container for command execution results."""
+
+    exit_code: int
+    output: str
+    stdout: str = ""
+    stderr: str = ""
+    exception: Optional[BaseException] = None
+    return_value: object = None
+
+
+class CliRunner:
+    """Small subset of :class:`click.testing.CliRunner`."""
+
+    def invoke(self, cli, args=None, **kwargs):
+        """Invoke a command object and capture its output."""
+        argv = [] if args is None else list(args)
+        stdout = io.StringIO()
+        stderr = io.StringIO()
+        exception = None
+        return_value = None
+
+        try:
+            with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
+                if hasattr(cli, "main"):
+                    return_value = cli.main(
+                        args=argv,
+                        prog_name=getattr(cli, "name", None),
+                        standalone_mode=False,
+                    )
+                else:
+                    return_value = cli(*argv)
+        except SystemExit as exc:
+            code = exc.code if isinstance(exc.code, int) else 1
+            stdout_value = stdout.getvalue()
+            stderr_value = stderr.getvalue()
+            return Result(
+                exit_code=code,
+                output=stdout_value + stderr_value,
+                stdout=stdout_value,
+                stderr=stderr_value,
+                exception=exc,
+            )
+        except BaseException as exc:  # pragma: no cover - mirrored runner behavior
+            exception = exc
+            stdout_value = stdout.getvalue()
+            stderr_value = stderr.getvalue()
+            return Result(
+                exit_code=1,
+                output=stdout_value + stderr_value,
+                stdout=stdout_value,
+                stderr=stderr_value,
+                exception=exception,
+            )
+
+        stdout_value = stdout.getvalue()
+        stderr_value = stderr.getvalue()
+        return Result(
+            exit_code=0,
+            output=stdout_value + stderr_value,
+            stdout=stdout_value,
+            stderr=stderr_value,
+            exception=exception,
+            return_value=return_value,
+        )
+
+    @contextlib.contextmanager
+    def isolated_filesystem(self):
+        """Run in an isolated temporary working directory."""
+        old_cwd = Path.cwd()
+        tmpdir = tempfile.mkdtemp(prefix="click-")
+        try:
+            os.chdir(tmpdir)
+            yield tmpdir
+        finally:
+            os.chdir(old_cwd)
+            shutil.rmtree(tmpdir, ignore_errors=True)
