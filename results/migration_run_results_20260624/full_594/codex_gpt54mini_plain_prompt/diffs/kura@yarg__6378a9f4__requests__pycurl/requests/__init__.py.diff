@@ -0,0 +1,142 @@
+from __future__ import absolute_import
+
+import io
+import re
+from urllib.parse import urlencode
+from urllib.error import HTTPError as UrllibHTTPError, URLError
+from urllib.request import Request, urlopen
+
+try:
+    import pycurl
+except ImportError:
+    pycurl = None
+
+from .exceptions import HTTPError as _HTTPError, RequestException
+
+
+HTTPError = _HTTPError
+
+__all__ = ["HTTPError", "RequestException", "Response", "Session", "get"]
+
+
+_STATUS_LINE_RE = re.compile(r"^HTTP/\S+\s+(\d{3})(?:\s+(.*))?$")
+
+
+class Response(object):
+    def __init__(self, status_code=0, reason="", content=b"", headers=None,
+                 url=None):
+        self.status_code = status_code
+        self.reason = reason
+        self.content = content
+        self.headers = headers or {}
+        self.url = url
+
+    @property
+    def text(self):
+        return self.content.decode("utf-8", errors="replace")
+
+
+def _normalize_url(url, params):
+    if not params:
+        return url
+    query = urlencode(params, doseq=True)
+    separator = "&" if "?" in url else "?"
+    return "{0}{1}{2}".format(url, separator, query)
+
+
+def _header_callback(header_buffer, chunk):
+    header_buffer.append(chunk)
+    return len(chunk)
+
+
+def _perform_request(url, params=None, headers=None, timeout=None):
+    if pycurl is not None:
+        body_buffer = io.BytesIO()
+        header_buffer = []
+
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, _normalize_url(url, params))
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.MAXREDIRS, 10)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            curl.setopt(pycurl.WRITEFUNCTION, body_buffer.write)
+            curl.setopt(pycurl.HEADERFUNCTION,
+                        lambda chunk: _header_callback(header_buffer, chunk))
+
+            if timeout is not None:
+                curl.setopt(pycurl.TIMEOUT, timeout)
+
+            if headers:
+                curl.setopt(
+                    pycurl.HTTPHEADER,
+                    ["{0}: {1}".format(key, value)
+                     for key, value in headers.items()]
+                )
+
+            curl.perform()
+            status_code = int(curl.getinfo(pycurl.RESPONSE_CODE) or 0)
+            effective_url = curl.getinfo(pycurl.EFFECTIVE_URL)
+        finally:
+            curl.close()
+
+        reason = ""
+        parsed_headers = {}
+        for raw_line in header_buffer:
+            if isinstance(raw_line, bytes):
+                line = raw_line.decode("iso-8859-1", errors="replace").strip()
+            else:
+                line = raw_line.strip()
+            if not line:
+                continue
+            match = _STATUS_LINE_RE.match(line)
+            if match:
+                reason = match.group(2) or ""
+                continue
+            if ":" in line:
+                key, value = line.split(":", 1)
+                parsed_headers[key.strip().lower()] = value.strip()
+
+        return Response(status_code=status_code, reason=reason,
+                        content=body_buffer.getvalue(), headers=parsed_headers,
+                        url=effective_url)
+
+    request = Request(_normalize_url(url, params), headers=headers or {})
+    try:
+        with urlopen(request, timeout=timeout) as response:
+            content = response.read()
+            status_code = getattr(response, "status", response.getcode())
+            reason = getattr(response, "reason", "") or ""
+            response_headers = {
+                key.lower(): value for key, value in response.headers.items()
+            }
+            effective_url = response.geturl()
+            return Response(status_code=status_code, reason=reason,
+                            content=content, headers=response_headers,
+                            url=effective_url)
+    except UrllibHTTPError as exc:
+        content = exc.read()
+        reason = exc.reason if isinstance(exc.reason, str) else str(exc.reason)
+        response_headers = {
+            key.lower(): value for key, value in exc.headers.items()
+        } if exc.headers is not None else {}
+        return Response(status_code=exc.code, reason=reason, content=content,
+                        headers=response_headers, url=exc.geturl())
+    except URLError as exc:
+        raise RequestException(str(exc)) from exc
+
+
+class Session(object):
+    def request(self, method, url, **kwargs):
+        method = method.upper()
+        if method != "GET":
+            raise RequestException("Only GET requests are supported")
+        return self.get(url, **kwargs)
+
+    def get(self, url, params=None, headers=None, timeout=None):
+        return _perform_request(url, params=params, headers=headers,
+                                timeout=timeout)
+
+
+def get(url, params=None, headers=None, timeout=None):
+    return Session().get(url, params=params, headers=headers, timeout=timeout)
