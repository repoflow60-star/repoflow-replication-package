index 0000000..62cfe1b
--- /dev/null
+++ b/encrypt_decrypt_fields/orm/sqlobject_fields.py
@@ -0,0 +1,44 @@
+from __future__ import annotations
+
+from typing import Any
+
+from encrypt_decrypt_fields.services import Crypto
+
+try:
+    from sqlobject import BLOBCol
+except ImportError:  # pragma: no cover - fallback for environments without sqlobject installed
+    class BLOBCol:  # type: ignore[too-many-ancestors]
+        def __init__(self, name: str | None = None, **kwargs: Any):
+            self.name = name
+            self.kwargs = kwargs
+            self.validator = kwargs.get("validator")
+
+
+class _EncryptedBinaryValidator:
+    def __init__(self, crypto: Crypto):
+        self.crypto = crypto
+
+    def from_python(self, value: Any, state: Any = None) -> Any:  # noqa: ARG002
+        if not value or isinstance(value, (bytes, memoryview)):
+            return value
+
+        return self.crypto.encrypt(str(value))
+
+    def to_python(self, value: Any, state: Any = None) -> Any:  # noqa: ARG002
+        if isinstance(value, memoryview):
+            return value.tobytes()
+
+        return value
+
+
+class EncryptedSQLObjectBinaryField(BLOBCol):
+    """Store encrypted binary data in SQLObject models."""
+
+    def __init__(self, name: str | None = None, *, key: str, **kwargs: Any):
+        self.key = key
+        self.crypto = Crypto(self.key)
+        kwargs.setdefault("validator", _EncryptedBinaryValidator(self.crypto))
+        super().__init__(name, **kwargs)
+
+
+EncryptedAlchemyBinaryField = EncryptedSQLObjectBinaryField
