+    def _query_pycurl(self, url: str) -> dict[str, Any]:
+        """Executes a GET request using pycurl."""
+        buffer = io.BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEDATA, buffer)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.MAXREDIRS, 10)
+            curl.setopt(pycurl.HTTPGET, 1)
+            curl.setopt(pycurl.ACCEPT_ENCODING, "")
+
+            header_lines = [f"{k}: {v}" for k, v in self._session.headers.items()]
+            if header_lines:
+                curl.setopt(pycurl.HTTPHEADER, header_lines)
+
+            timeout = self._request_kwargs.get("timeout")
+            if timeout is not None:
+                curl.setopt(pycurl.TIMEOUT_MS, int(float(timeout) * 1000))
+
+            if not self._request_kwargs.get("verify", True):
+                curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+                curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+
+            proxies = self._request_kwargs.get("proxies")
+            if proxies:
+                self._configure_proxy(curl, proxies)
+
+            curl.perform()
+            body = buffer.getvalue().decode("utf-8")
+            return json.loads(body)
+        finally:
+            curl.close()
+
+    def _configure_proxy(self, curl, proxies: dict[str, str]) -> None:
+        """Applies proxy settings from HTTP client kwargs."""
+        proxy_url = proxies.get("https") or proxies.get("http")
+        if not proxy_url:
+            return
+
+        parsed = parse.urlparse(proxy_url)
+        proxy_host = parsed.hostname or parsed.path
+        if not proxy_host:
+            return
+        if parsed.port is not None:
+            proxy_host = f"{proxy_host}:{parsed.port}"
+
+        curl.setopt(pycurl.PROXY, proxy_host)
+
+        if parsed.username or parsed.password:
+            curl.setopt(
+                pycurl.PROXYUSERPWD,
+                f"{parsed.username or ''}:{parsed.password or ''}",
+            )
+
+        if parsed.scheme in {"http", "https", ""}:
+            curl.setopt(pycurl.PROXYTYPE, pycurl.PROXYTYPE_HTTP)
+            curl.setopt(pycurl.HTTPPROXYTUNNEL, 1)
+        elif parsed.scheme == "socks5":
+            curl.setopt(pycurl.PROXYTYPE, pycurl.PROXYTYPE_SOCKS5)
+        elif parsed.scheme == "socks4":
+            curl.setopt(pycurl.PROXYTYPE, pycurl.PROXYTYPE_SOCKS4)
+
+    def _query_urllib(self, url: str) -> dict[str, Any]:
+        """Fallback GET implementation used when pycurl is unavailable."""
+        headers = dict(self._session.headers)
+        req = request.Request(url, headers=headers, method="GET")
+        timeout = self._request_kwargs.get("timeout")
+        proxies = self._request_kwargs.get("proxies")
+
+        handlers = []
+        if proxies:
+            handlers.append(request.ProxyHandler(proxies))
+
+        opener = request.build_opener(*handlers)
+        try:
+            with opener.open(req, timeout=timeout) as resp:
+                encoding = resp.headers.get_content_charset() or "utf-8"
+                body = resp.read().decode(encoding)
+        except error.URLError as exc:  # pragma: no cover - network failure path
+            raise exc
+
+        return json.loads(body)
 
