+    def _normalize_headers(self, headers):
+        if headers is None:
+            return {}
+
+        if hasattr(headers, "items"):
+            return dict(headers)
+
+        if hasattr(headers, "getAllRawHeaders"):
+            normalized = {}
+            for key, values in headers.getAllRawHeaders():
+                key = key.decode("latin-1") if isinstance(key, bytes) else key
+                normalized[key] = ", ".join(
+                    value.decode("latin-1") if isinstance(value, bytes) else value
+                    for value in values
+                )
+            return normalized
+
+        return headers
+
+    def _ensure_reactor_thread(self):
+        if reactor is None or blockingCallFromThread is None:
+            raise RuntimeError("treq is not available")
+
+        if reactor.running:
+            return
+
+        if self.__class__._reactor_thread is not None:
+            return
+
+        def run_reactor():
+            reactor.run(installSignalHandlers=False)
+
+        self.__class__._reactor_thread = threading.Thread(
+            target=run_reactor, name="chessdotcom-treq-reactor", daemon=True
+        )
+        self.__class__._reactor_thread.start()
+
+        while not reactor.running:
