@@ -0,0 +1,80 @@
+"""Minimal httpx compatibility layer for offline environments."""
+
+from contextlib import contextmanager
+from urllib.parse import urlsplit
+
+import requests
+
+
+class RequestError(Exception):
+    """Compatibility exception matching httpx.RequestError."""
+
+
+class _NetworkStream:
+    def __init__(self, sock):
+        self._sock = sock
+
+    def get_extra_info(self, name):
+        if name == 'socket':
+            return self._sock
+        return None
+
+
+class _ResponseWrapper:
+    def __init__(self, response):
+        self._response = response
+        sock = None
+        try:
+            sock = response.raw.connection.sock
+        except Exception:
+            sock = None
+        self.extensions = {'network_stream': _NetworkStream(sock)}
+
+    @property
+    def content(self):
+        return self._response.content
+
+    def close(self):
+        self._response.close()
+
+
+def _proxies(proxy, url):
+    if proxy is None:
+        return None
+    scheme = urlsplit(url).scheme
+    return {scheme: proxy}
+
+
+def get(url, *, timeout=None, follow_redirects=False, proxy=None, **kwargs):
+    try:
+        return requests.get(
+            url,
+            timeout=timeout,
+            allow_redirects=follow_redirects,
+            proxies=_proxies(proxy, url),
+            **kwargs,
+        )
+    except requests.RequestException as exc:  # pragma: no cover - exercised via callers
+        raise RequestError(str(exc)) from exc
+
+
+@contextmanager
+def stream(method, url, *, proxy=None, timeout=None, follow_redirects=False, **kwargs):
+    if method.upper() != 'GET':
+        raise ValueError('Only GET is supported by the compatibility layer.')
+    try:
+        response = requests.get(
+            url,
+            timeout=timeout,
+            stream=True,
+            allow_redirects=follow_redirects,
+            proxies=_proxies(proxy, url),
+            **kwargs,
+        )
+        wrapped = _ResponseWrapper(response)
+        try:
+            yield wrapped
+        finally:
+            wrapped.close()
+    except requests.RequestException as exc:  # pragma: no cover - exercised via callers
+        raise RequestError(str(exc)) from exc
