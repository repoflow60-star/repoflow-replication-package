+def _clamp_rgb_component(value):
+    if value < 0.0:
+        value = 0.0
+    elif value > 255.0:
+        value = 255.0
+    return int(round(value))
+
+
+def _hex_to_rgb_triplet(value):
+    value = value.lstrip("#")
+    if len(value) == 3:
+        value = "".join(channel * 2 for channel in value)
+    if len(value) != 6:
+        raise ValueError(f"Invalid hex color {value}")
+    return tuple(int(value[i : i + 2], 16) for i in (0, 2, 4))
+
+
+def _string_to_rgb_triplet(color):
+    if color.startswith("#"):
+        return _hex_to_rgb_triplet(color)
+
+    if color.startswith("rgb(") or color.startswith("rgba("):
+        payload = color[color.index("(") + 1 : color.rindex(")")]
+        channels = [part.strip() for part in payload.split(",")]
+        if len(channels) < 3:
+            raise ValueError(f"Invalid rgb color {color}")
+        rgb = []
+        for channel in channels[:3]:
+            if channel.endswith("%"):
+                rgb.append(float(channel[:-1]) * 2.55)
+            else:
+                rgb.append(float(channel))
+        return tuple(_clamp_rgb_component(channel) for channel in rgb)
+
+    raise ValueError(f"Unsupported color string {color}")
+
+
+def to_rgb(color):
+    """Convert a color specification into an RGB float triple."""
+    if isinstance(color, str):
+        red, green, blue = _string_to_rgb_triplet(color)
+        return red / 255.0, green / 255.0, blue / 255.0
 
+    if hasattr(color, "__len__") and len(color) in (3, 4):
+        channels = asarray(color[:3], dtype=float32)
+        if any(isinstance(channel, (int, integer)) for channel in color[:3]) or max(
+            channels
+        ) > 1.0:
+            channels = channels / 255.0
+        channels = clip(channels, 0.0, 1.0)
+        return tuple(float(channel) for channel in channels)
 
