+class _SyncResponse:
+    def __init__(self, status_code, content):
+        self.status_code = status_code
+        self.content = content
+
+
+class _StdlibRequestsClient:
+    def get(self, url):
+        try:
+            with urlopen(url) as response:
+                return _SyncResponse(response.getcode(), response.read())
+        except HTTPError as error:
+            return _SyncResponse(error.code, error.read())
+
+
+def _build_requests_client():
+    """
+    Prefer treq, but keep a synchronous facade for the existing API.
+    """
+    try:
+        import treq
+    except Exception:
+        return _StdlibRequestsClient()
+
+    try:
+        from twisted.internet import asyncioreactor
+    except Exception:
+        return _StdlibRequestsClient()
+
+    event_loop = asyncio.new_event_loop()
+    try:
+        asyncioreactor.install(event_loop)
+    except Exception:
+        event_loop.close()
+        return _StdlibRequestsClient()
+
+    class _TreqRequestsClient:
+        def __init__(self, loop):
+            self._loop = loop
+
+        async def _get_async(self, url):
+            response = await treq.get(url)
+            content = await treq.content(response)
+            return _SyncResponse(response.code, content)
+
+        def get(self, url):
+            return self._loop.run_until_complete(self._get_async(url))
+
+    return _TreqRequestsClient(event_loop)
+
+
+requests = _build_requests_client()
+
