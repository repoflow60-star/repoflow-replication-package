+"""Compatibility wrapper that exposes a requests-like API backed by httpx."""
+
+from typing import Any
+
+import httpx
+
+Response = httpx.Response
+
+
+def get(url: str, params: Any = None, timeout: Any = None) -> Response:
+    return httpx.get(url, params=params, timeout=timeout)
