+"""Minimal httpx-compatible shim used by the client and tests.
+
+This project only needs a synchronous ``get`` call and the response fields
+``status_code``, ``text``, and ``elapsed``. The implementation uses the Python
+standard library so the repository remains self-contained in environments where
+the real ``httpx`` package is not installed.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import timedelta
+from typing import Any, Mapping, MutableMapping, Optional
+from urllib.error import HTTPError, URLError
+from urllib.parse import urlencode
+from urllib.request import Request, urlopen
+
+
+@dataclass
+class Response:
+    status_code: int
+    text: str
+    elapsed: timedelta = timedelta(0)
+
+
+def get(url: str, params: Optional[Mapping[str, Any]] = None, timeout: Any = None) -> Response:
+    request_url = _build_url(url, params)
+    request = Request(request_url, method="GET")
+
+    try:
+        with urlopen(request, timeout=timeout) as response:
+            body = response.read().decode("utf-8")
+            status_code = response.getcode() or 0
+    except HTTPError as exc:
+        body = exc.read().decode("utf-8", errors="replace")
+        status_code = exc.code
+    except URLError as exc:
+        raise OSError(str(exc)) from exc
+
+    return Response(status_code=status_code, text=body, elapsed=timedelta(0))
+
+
+def _build_url(url: str, params: Optional[Mapping[str, Any]]) -> str:
+    if not params:
+        return url
+
+    query = urlencode(_normalize_params(params), doseq=True)
+    separator = "&" if "?" in url else "?"
+    return f"{url}{separator}{query}"
+
+
+def _normalize_params(params: Mapping[str, Any]) -> MutableMapping[str, Any]:
+    normalized: MutableMapping[str, Any] = {}
+    for key, value in params.items():
+        normalized[key] = value
+    return normalized
