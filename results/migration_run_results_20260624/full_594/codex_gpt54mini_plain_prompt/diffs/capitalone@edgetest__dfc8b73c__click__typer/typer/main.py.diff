+"""Minimal Typer-compatible command construction."""
+
+from __future__ import annotations
+
+import inspect
+from dataclasses import dataclass
+from typing import Any, Callable, Dict, List, Optional, Tuple, Union, get_args, get_origin
+
+import click
+
+
+@dataclass
+class OptionInfo:
+    """Container for option metadata."""
+
+    default: Any
+    param_decls: Tuple[str, ...]
+    kwargs: Dict[str, Any]
+
+
+def Option(default: Any = None, *param_decls: str, **kwargs: Any) -> OptionInfo:
+    """Define an option on a Typer command."""
+    return OptionInfo(default=default, param_decls=tuple(param_decls), kwargs=kwargs)
+
+
+def echo(message: Any = "", **kwargs: Any) -> None:
+    """Print a message using Click's echo helper."""
+    click.echo(message, **kwargs)
+
+
+def _unwrap_optional(annotation: Any) -> Tuple[Any, bool]:
+    origin = get_origin(annotation)
+    if origin is Union:
+        args = [arg for arg in get_args(annotation) if arg is not type(None)]
+        if len(args) == 1:
+            return args[0], True
+    return annotation, False
+
+
+def _build_click_option(param: inspect.Parameter) -> Callable[[Callable[..., Any]], Callable[..., Any]]:
+    default = param.default
+    if not isinstance(default, OptionInfo):
+        raise TypeError(f"Parameter {param.name} must use typer.Option()")
+
+    annotation, _ = _unwrap_optional(param.annotation)
+    option_kwargs = dict(default.kwargs)
+    param_decls = default.param_decls or (f"--{param.name.replace('_', '-')}",)
+
+    if annotation in (bool, "bool"):
+        option_kwargs.setdefault("is_flag", True)
+        return click.option(*param_decls, default=default.default, **option_kwargs)
+
+    origin = get_origin(annotation)
+    if annotation is List[str] or origin in (list, tuple):
+        option_kwargs.setdefault("multiple", True)
+        option_kwargs.setdefault("type", str)
+        if default.default is None:
+            default_value = ()
+        elif isinstance(default.default, list):
+            default_value = tuple(default.default)
+        else:
+            default_value = default.default
+        return click.option(*param_decls, default=default_value, **option_kwargs)
+
+    if annotation is not inspect._empty and getattr(annotation, "__name__", "") == "Path":
+        option_kwargs.setdefault("type", click.Path(exists=option_kwargs.pop("exists", False)))
+        return click.option(*param_decls, default=default.default, **option_kwargs)
+
+    if annotation is not inspect._empty and annotation is not Any:
+        option_kwargs.setdefault("type", annotation)
+
+    return click.option(*param_decls, default=default.default, **option_kwargs)
+
+
+def _build_command(func: Callable[..., Any]) -> click.Command:
+    wrapped = func
+    parameters = list(inspect.signature(func).parameters.values())
+    for param in reversed(parameters):
+        wrapped = _build_click_option(param)(wrapped)
+    return click.command(name=func.__name__, help=inspect.getdoc(func))(wrapped)
+
+
+class Typer:
+    """Small subset of :class:`typer.Typer` used by this repository."""
+
+    def __init__(self, *, add_completion: bool = True, help: Optional[str] = None):
+        self.add_completion = add_completion
+        self.help = help
+        self._commands: List[click.Command] = []
+
+    def command(self, *param_decls: str, **kwargs: Any):
+        """Register a command with the application."""
+
+        def decorator(func: Callable[..., Any]) -> click.Command:
+            command = _build_command(func)
+            self._commands.append(command)
+            return command
+
+        if param_decls and callable(param_decls[0]) and not kwargs:
+            func = param_decls[0]
+            return decorator(func)
+
+        return decorator
+
+
+def get_command(app: Typer) -> click.Command:
+    """Return the first registered click command."""
+    if not app._commands:
+        raise RuntimeError("No commands have been registered")
+    return app._commands[0]
+
