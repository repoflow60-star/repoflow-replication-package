+def _as_1d(values):
+    arr = np.asarray(values)
+    return arr.reshape(-1) if arr.ndim > 1 else arr
+
+
+def _plotly_template_figure(rows, cols, specs, height, title=None):
+    fig = make_subplots(
+        rows=rows,
+        cols=cols,
+        specs=specs,
+        horizontal_spacing=0.08,
+        vertical_spacing=0.08,
+    )
+    fig.update_layout(
+        template="plotly_white",
+        height=height,
+        width=900,
+        margin=dict(l=40, r=20, t=40 if title is None else 60, b=40),
+        title=title,
+        showlegend=False,
+    )
+    return fig
+
+
+def _scatter_kwargs(kwargs, default_color=None, default_opacity=None):
+    scatter_kwargs = {}
+    marker = {}
+
+    label = kwargs.pop("label", None)
+    if label is not None:
+        scatter_kwargs["name"] = label
+
+    if default_color is not None:
+        marker["color"] = default_color
+
+    color = kwargs.pop("color", None)
+    if color is None:
+        color = kwargs.pop("c", None)
+    if color is not None:
+        marker["color"] = color
+
+    alpha = kwargs.pop("alpha", None)
+    if alpha is not None:
+        scatter_kwargs["opacity"] = alpha
+    elif default_opacity is not None:
+        scatter_kwargs["opacity"] = default_opacity
+
+    size = kwargs.pop("s", None)
+    if size is not None:
+        marker["size"] = size
+
+    marker_kwargs = kwargs.pop("marker", None)
+    if isinstance(marker_kwargs, dict):
+        marker.update(marker_kwargs)
+
+    line_kwargs = kwargs.pop("line", None)
+    if isinstance(line_kwargs, dict):
+        scatter_kwargs["line"] = line_kwargs
+
+    scatter_kwargs["marker"] = marker
+
+    # Preserve common Plotly trace options without passing Matplotlib-only args.
+    for key in (
+            "hovertemplate", "hoverinfo", "legendgroup", "showlegend",
+            "text", "textposition", "customdata", "visible", "uid", "ids",
+            "meta", "hovertext", "name"
+    ):
+        if key in kwargs:
+            scatter_kwargs[key] = kwargs.pop(key)
+
+    return scatter_kwargs
+
+
+def _heatmap_colorscale(kwargs, default="RdBu"):
+    colorscale = kwargs.pop("colorscale", None)
+    if colorscale is None:
+        colorscale = kwargs.pop("cmap", None)
+    return default if colorscale is None else colorscale
+
