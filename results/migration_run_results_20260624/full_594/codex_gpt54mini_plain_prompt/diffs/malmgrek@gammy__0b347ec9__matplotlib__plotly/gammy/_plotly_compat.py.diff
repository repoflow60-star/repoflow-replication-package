+"""Minimal Plotly-compatible fallback used when Plotly is unavailable.
+"""
+
+from types import SimpleNamespace
+
+
+class _Trace:
+    def __init__(self, *args, **kwargs):
+        self.args = args
+        self.__dict__.update(kwargs)
+
+
+class Figure:
+    def __init__(self, *args, **kwargs):
+        self.args = args
+        self.kwargs = kwargs
+        self.data = []
+        self.layout = {}
+        self.annotations = []
+        self.axes = {}
+
+    def add_trace(self, trace, row=None, col=None):
+        self.data.append({"trace": trace, "row": row, "col": col})
+        return self
+
+    def update_layout(self, **kwargs):
+        self.layout.update(kwargs)
+        return self
+
+    def update_xaxes(self, **kwargs):
+        self.axes.setdefault("x", []).append(kwargs)
+        return self
+
+    def update_yaxes(self, **kwargs):
+        self.axes.setdefault("y", []).append(kwargs)
+        return self
+
+    def update_annotations(self, **kwargs):
+        self.layout.setdefault("annotation_updates", []).append(kwargs)
+        return self
+
+    def add_annotation(self, **kwargs):
+        self.annotations.append(kwargs)
+        return self
+
+    def show(self, *args, **kwargs):
+        return self
+
+
+def make_subplots(*args, **kwargs):
+    return Figure(*args, **kwargs)
+
+
+graph_objects = SimpleNamespace(
+    Figure=Figure,
+    Scatter=_Trace,
+    Heatmap=_Trace,
+    Surface=_Trace,
+)
