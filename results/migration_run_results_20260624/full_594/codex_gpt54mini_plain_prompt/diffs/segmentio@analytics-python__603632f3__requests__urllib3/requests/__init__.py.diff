+"""Minimal requests-compatible shim backed by urllib3.
+
+This package exists so the library and tests can keep the small surface area
+they use from ``requests`` while the actual HTTP implementation comes from
+urllib3.
+"""
+
+from . import auth
+from . import exceptions
+from . import sessions
+
+Session = sessions.Session
+ReadTimeout = exceptions.ReadTimeout
+
+__all__ = ["Session", "ReadTimeout", "auth", "exceptions", "sessions"]
