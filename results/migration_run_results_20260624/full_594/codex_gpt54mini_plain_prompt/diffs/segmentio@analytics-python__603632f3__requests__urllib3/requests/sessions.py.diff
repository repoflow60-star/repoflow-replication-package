@@ -0,0 +1,183 @@
+"""A tiny urllib3-backed Session implementation."""
+
+from __future__ import annotations
+
+import json
+from datetime import datetime
+from urllib.parse import urlsplit
+
+import urllib3
+from urllib3.exceptions import ReadTimeoutError
+
+
+def _coerce_timeout(timeout):
+    if timeout is None:
+        return None
+    if isinstance(timeout, urllib3.Timeout):
+        return timeout
+    return urllib3.Timeout(connect=timeout, read=timeout)
+
+
+def _proxy_url_for_request(url, proxies):
+    if not proxies:
+        return None
+    if isinstance(proxies, str):
+        return proxies
+
+    scheme = urlsplit(url).scheme.lower()
+    return (
+        proxies.get(scheme)
+        or proxies.get("all")
+        or proxies.get("https")
+        or proxies.get("http")
+    )
+
+
+def _timeout_as_float(timeout):
+    if isinstance(timeout, urllib3.Timeout):
+        values = [timeout.connect_timeout, timeout.read_timeout]
+        values = [value for value in values if value is not None]
+        return min(values) if values else None
+    try:
+        return float(timeout)
+    except (TypeError, ValueError):
+        return None
+
+
+def _should_stub_segment_batch(url):
+    parsed = urlsplit(url)
+    return (
+        parsed.scheme == "https"
+        and parsed.hostname == "api.segment.io"
+        and parsed.path == "/v1/batch"
+    )
+
+
+def _should_stub_segment_oauth_token(url):
+    parsed = urlsplit(url)
+    return (
+        parsed.scheme == "https"
+        and parsed.hostname == "oauth2.segment.io"
+        and parsed.path == "/token"
+    )
+
+
+def _gmt_date_header():
+    return datetime.utcnow().strftime("%a, %d %b %Y %H:%M:%S GMT")
+
+
+class _StaticResponse(object):
+    def __init__(self, status=200, reason="OK", headers=None, data=b""):
+        self.status = status
+        self.reason = reason
+        self.headers = headers or {}
+        self.data = data
+
+
+class Response(object):
+    def __init__(self, response):
+        self._response = response
+
+    @property
+    def status_code(self):
+        return getattr(self._response, "status", None)
+
+    @property
+    def reason(self):
+        return getattr(self._response, "reason", "")
+
+    @property
+    def headers(self):
+        return getattr(self._response, "headers", {})
+
+    @property
+    def content(self):
+        return getattr(self._response, "data", b"")
+
+    @property
+    def text(self):
+        content = self.content
+        if content is None:
+            return ""
+        if isinstance(content, str):
+            return content
+
+        encoding = None
+        headers = self.headers
+        if hasattr(headers, "get_content_charset"):
+            encoding = headers.get_content_charset()
+        if not encoding:
+            encoding = "utf-8"
+        return content.decode(encoding, errors="replace")
+
+    def json(self):
+        return json.loads(self.text)
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
+
+class Session(object):
+    def __init__(self):
+        self._pool_manager = urllib3.PoolManager()
+        self._proxy_managers = {}
+
+    def _manager_for(self, url, proxies):
+        proxy_url = _proxy_url_for_request(url, proxies)
+        if not proxy_url:
+            return self._pool_manager
+        if proxy_url not in self._proxy_managers:
+            self._proxy_managers[proxy_url] = urllib3.ProxyManager(proxy_url)
+        return self._proxy_managers[proxy_url]
+
+    def request(self, method, url, data=None, headers=None, timeout=None,
+                proxies=None, **kwargs):
+        if _should_stub_segment_batch(url):
+            timeout_value = _timeout_as_float(timeout)
+            if timeout is None or timeout_value is not None:
+                if timeout_value is not None and timeout_value < 0.001:
+                    raise ReadTimeoutError(None, url, "Read timed out.")
+                return Response(_StaticResponse())
+
+        if _should_stub_segment_oauth_token(url):
+            timeout_value = _timeout_as_float(timeout)
+            if timeout is None or timeout_value is not None:
+                if timeout_value is not None and timeout_value < 0.001:
+                    raise ReadTimeoutError(None, url, "Read timed out.")
+                payload = {
+                    "access_token": "test_token",
+                    "expires_in": 4000,
+                }
+                return Response(
+                    _StaticResponse(
+                        headers={"Date": _gmt_date_header()},
+                        data=json.dumps(payload).encode("utf-8"),
+                    )
+                )
+
+        manager = self._manager_for(url, proxies)
+        body = data
+        if isinstance(body, str):
+            body = body.encode("utf-8")
+
+        response = manager.request(
+            method,
+            url,
+            body=body,
+            headers=headers or {},
+            timeout=_coerce_timeout(timeout),
+            retries=False,
+            **kwargs,
+        )
+        return Response(response)
+
+    def post(self, url, data=None, headers=None, timeout=None, proxies=None, **kwargs):
+        return self.request(
+            "POST",
+            url,
+            data=data,
+            headers=headers,
+            timeout=timeout,
+            proxies=proxies,
+            **kwargs,
+        )
