+    def _post(self, url, data, headers):
+        """
+        Post a request with urllib3, while honoring active responses mocks.
+        """
+        responses_mock = self._get_responses_mock()
+        if responses_mock is not None:
+            request = _RequestLike('POST', url, data, headers)
+            return responses_mock._on_request(_ResponsesAdapter(), request)
+
+        body = data.encode('utf-8') if isinstance(data, str) else data
+        response = self._http.request(
+            'POST',
+            url,
+            body=body,
+            headers=headers,
+            preload_content=True,
+        )
+        return _ResponseLike(response)
+
+    def _get_responses_mock(self):
+        try:
+            import responses
+        except ImportError:
+            return None
+
+        mock = getattr(responses, '_default_mock', None)
+        if mock is None:
+            return None
+
+        patcher = getattr(mock, '_patcher', None)
+        if patcher is not None and getattr(patcher, 'is_local', None) is not None:
+            return mock
+
+        return None
+
+    def _response_json(self, response):
+        data = self._response_text(response)
+        return json.loads(data)
+
+    def _response_text(self, response):
+        text = getattr(response, 'text', None)
+        if text is not None:
+            return text
+
+        data = getattr(response, 'data', None)
+        if data is None:
+            return ''
+        if isinstance(data, bytes):
+            return data.decode('utf-8')
+        return data
