+########################################################################
+# Internal HTTP helpers
+########################################################################
+
+
+class _CaseInsensitiveHeaders(dict):
+    """Minimal case-insensitive header mapping."""
+
+    def __setitem__(self, key, value):
+        super().__setitem__(str(key).lower(), value)
+
+    def __getitem__(self, key):
+        return super().__getitem__(str(key).lower())
+
+    def get(self, key, default=None):
+        return super().get(str(key).lower(), default)
+
+
+class _HTTPResponse:
+    """Lightweight response wrapper shared by the HTTP helpers."""
+
+    def __init__(self, url, status_code, headers=None, content=b""):
+        self.url = url
+        self.status_code = status_code
+        self.headers = _CaseInsensitiveHeaders(headers or {})
+        self.content = content or b""
+
+    @property
+    def is_redirect(self):
+        return 300 <= self.status_code < 400 and self.headers.get("location") is not None
+
+    def json(self):
+        return json.loads(self.content.decode("utf-8"))
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise HXLIOException(
+                "HTTP {} for {}".format(self.status_code, self.url),
+                url=self.url,
+            )
+
+
+def _normalize_header_name(name):
+    if isinstance(name, bytes):
+        return name.decode("latin1")
+    return str(name)
+
+
+def _normalize_header_value(value):
+    if isinstance(value, bytes):
+        return value.decode("latin1")
+    return str(value)
+
+
+def _headers_from_treq(raw_headers):
+    headers = _CaseInsensitiveHeaders()
+    if hasattr(raw_headers, "getAllRawHeaders"):
+        for key, values in raw_headers.getAllRawHeaders():
+            headers[_normalize_header_name(key)] = ", ".join(
+                _normalize_header_value(value) for value in values
+            )
+    else:
+        for key, value in dict(raw_headers).items():
+            headers[_normalize_header_name(key)] = _normalize_header_value(value)
+    return headers
+
+
+def _join_url_params(url, params):
+    if not params:
+        return url
+    parsed = urllib.parse.urlsplit(url)
+    query = urllib.parse.urlencode(params, doseq=True)
+    if parsed.query:
+        query = parsed.query + "&" + query
+    return urllib.parse.urlunsplit((parsed.scheme, parsed.netloc, parsed.path, query, parsed.fragment))
+
+
+def _encode_request_data(data):
+    if data is None:
+        return None
+    if isinstance(data, (bytes, bytearray)):
+        return bytes(data)
+    if isinstance(data, str):
+        return data.encode("utf-8")
+    return urllib.parse.urlencode(data, doseq=True).encode("utf-8")
+
+
+async def _request_with_treq(method, url, verify_ssl=True, timeout=None, headers=None, params=None, data=None):
+    request_url = _join_url_params(url, params)
+    request_kwargs = {}
+    if headers:
+        request_kwargs["headers"] = headers
+    if timeout is not None:
+        request_kwargs["timeout"] = timeout
+    request_data = _encode_request_data(data)
+    if request_data is not None:
+        request_kwargs["data"] = request_data
+    response = await treq.request(method, request_url, **request_kwargs)
+    body = b""
+    if method.upper() != "HEAD":
+        body = await treq.content(response)
+    return _HTTPResponse(
+        request_url,
+        getattr(response, "code", getattr(response, "status", None)),
+        _headers_from_treq(response.headers),
+        body,
+    )
+
+
+def _request(method, url, verify_ssl=True, timeout=None, headers=None, params=None, data=None):
+    if treq is not None and _HTTP_LOOP is not None and verify_ssl is not False:
+        return _HTTP_LOOP.run_until_complete(
+            _request_with_treq(
+                method,
+                url,
+                verify_ssl=verify_ssl,
+                timeout=timeout,
+                headers=headers,
+                params=params,
+                data=data,
+            )
+        )
+
+    if _requests is None:
+        raise HXLIOException("No HTTP client available")
+
+    request_url = _join_url_params(url, params)
+    response = _requests.request(
+        method,
+        request_url,
+        stream=(method.upper() != "HEAD"),
+        verify=verify_ssl,
+        timeout=timeout,
+        headers=headers,
+        data=data,
+    )
+    return _HTTPResponse(request_url, response.status_code, response.headers, response.content)
+
+
+def _get_json(url, verify_ssl=True, timeout=None, headers=None, params=None, data=None):
+    return _request("GET", url, verify_ssl=verify_ssl, timeout=timeout, headers=headers, params=params, data=data).json()
+
+
