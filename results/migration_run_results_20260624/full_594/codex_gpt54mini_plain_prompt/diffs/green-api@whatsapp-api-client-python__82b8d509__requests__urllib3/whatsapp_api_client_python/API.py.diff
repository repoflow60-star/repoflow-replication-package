+    def __prepare_json_request(self, payload: Optional[dict]) -> tuple:
+        if payload is None:
+            return None, None
+
+        return json.dumps(payload).encode("utf-8"), {
+            "Content-Type": "application/json"
+        }
+
+    def __prepare_multipart_fields(
+            self,
+            payload: Optional[dict],
+            files: Optional[dict]
+    ) -> dict:
+        fields = dict(payload or {})
+
+        for field_name, file_value in (files or {}).items():
+            filename, file_data, content_type = file_value
+
+            if hasattr(file_data, "read"):
+                file_data = file_data.read()
+
+            fields[field_name] = (
+                filename,
+                file_data,
+                content_type or "application/octet-stream"
+            )
+
+        return fields
+
+    def __normalize_body(self, data: Any) -> Any:
+        if isinstance(data, str):
+            return data.encode("utf-8")
+
+        return data
+
+    def __merge_headers(
+            self,
+            headers: Optional[dict],
+            extra_headers: dict
+    ) -> dict:
+        merged_headers = dict(headers or {})
+        merged_headers.update(extra_headers)
+        return merged_headers
+
+    def __get_response_text(self, response: HTTPResponse) -> str:
+        if hasattr(response, "text"):
+            return response.text
+
+        data = response.data
+        if isinstance(data, bytes):
+            return data.decode("utf-8", errors="replace")
+
+        return str(data)
+
+    def __get_status_code(self, response: HTTPResponse) -> Optional[int]:
+        status_code = getattr(response, "status_code", None)
+        if isinstance(status_code, int):
+            return status_code
+
+        status = getattr(response, "status", None)
+        if isinstance(status, int):
+            return status
+
+        return None
+
+    def __prepare_timeout(self, timeout: float) -> Timeout:
+        return Timeout(connect=timeout, read=timeout)
