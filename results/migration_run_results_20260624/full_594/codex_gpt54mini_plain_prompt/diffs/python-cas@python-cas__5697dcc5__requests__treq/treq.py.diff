+"""Small synchronous compatibility layer with a treq-like API.
+
+The project historically used ``requests`` and the public code paths expect a
+blocking session object with ``get`` and ``post`` methods.  This module keeps
+that shape while avoiding a hard dependency on ``requests``.
+"""
+
+from __future__ import absolute_import
+
+from urllib.error import HTTPError
+from urllib.parse import parse_qsl, urlencode, urlsplit, urlunsplit
+from urllib.request import Request, urlopen
+
+try:
+    from ssl import create_default_context
+except ImportError:  # pragma: no cover - Python 2 compatibility
+    create_default_context = None
+
+
+def _build_url(url, params=None):
+    if not params:
+        return url
+
+    split_url = urlsplit(url)
+    query = parse_qsl(split_url.query, keep_blank_values=True)
+    if isinstance(params, dict):
+        query.extend(params.items())
+    else:
+        query.extend(params)
+    return urlunsplit(split_url._replace(query=urlencode(query, doseq=True)))
+
+
+def _ssl_context(verify):
+    if verify:
+        return create_default_context() if create_default_context else None
+
+    if create_default_context is None:
+        return None
+
+    context = create_default_context()
+    context.check_hostname = False
+    try:
+        from ssl import CERT_NONE
+    except ImportError:  # pragma: no cover - Python 2 compatibility
+        CERT_NONE = 0
+    context.verify_mode = CERT_NONE
+    return context
+
+
+class Response(object):
+    def __init__(self, status_code, content):
+        self.status_code = status_code
+        self.content = content
+
+    def iter_lines(self, chunk_size=8192):
+        data = self.content or b""
+        if isinstance(data, str):
+            data = data.encode("utf-8")
+        for line in data.splitlines():
+            yield line.decode("utf-8")
+
+    def close(self):
+        return None
+
+
+class Session(object):
+    def get(self, url, params=None, verify=True, stream=False, headers=None):
+        return self._request("GET", url, params=params, verify=verify, headers=headers)
+
+    def post(self, url, data=None, params=None, verify=True, headers=None):
+        return self._request(
+            "POST",
+            url,
+            data=data,
+            params=params,
+            verify=verify,
+            headers=headers,
+        )
+
+    def _request(self, method, url, data=None, params=None, verify=True, headers=None):
+        full_url = _build_url(url, params=params)
+        body = data
+        if isinstance(body, str):
+            body = body.encode("utf-8")
+
+        request = Request(full_url, data=body, headers=headers or {}, method=method)
+        context = _ssl_context(verify)
+        try:
+            if context is None:
+                with urlopen(request) as response:
+                    return Response(response.getcode(), response.read())
+            with urlopen(request, context=context) as response:
+                return Response(response.getcode(), response.read())
+        except HTTPError as error:
+            return Response(error.code, error.read())
+
+
+def get(url, **kwargs):
+    return Session().get(url, **kwargs)
+
+
+def post(url, **kwargs):
+    return Session().post(url, **kwargs)
