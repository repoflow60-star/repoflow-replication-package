+def _get_treq_loop() -> asyncio.AbstractEventLoop:
+    global _TREQ_LOOP
+    if _TREQ_LOOP is None:
+        loop = asyncio.new_event_loop()
+        asyncio.set_event_loop(loop)
+        asyncioreactor.install(loop)
+        _TREQ_LOOP = loop
+    return _TREQ_LOOP
+
+
+def _get_treq_agent() -> Any:
+    global _TREQ_AGENT
+    if _TREQ_AGENT is None:
+        from twisted.internet import reactor
+        from twisted.internet.ssl import ClientContextFactory
+        from twisted.web.client import Agent
+
+        _TREQ_AGENT = Agent(reactor, ClientContextFactory())
+    return _TREQ_AGENT
 
 
