+++ b/smartystreets_python_sdk/httpx_compat.py
@@ -0,0 +1,144 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Dict, Optional
+from urllib.parse import parse_qsl, urlencode, urlsplit, urlunsplit
+from urllib.request import ProxyHandler, Request as UrlRequest, build_opener
+from urllib.error import HTTPError, URLError
+
+try:
+    import httpx as _httpx  # type: ignore
+except ImportError:  # pragma: no cover - fallback for the sandbox
+    _httpx = None
+
+
+def _merge_url_and_params(url: Optional[str], params: Optional[Dict[str, Any]]) -> str:
+    url = url or ""
+    if not params:
+        return url
+
+    parts = urlsplit(url)
+    query_items = parse_qsl(parts.query, keep_blank_values=True)
+    for key, value in params.items():
+        if value is None:
+            continue
+        query_items.append((key, value))
+
+    return urlunsplit((parts.scheme, parts.netloc, parts.path, urlencode(query_items, doseq=True), parts.fragment))
+
+
+@dataclass
+class Request:
+    url: Optional[str] = None
+    params: Optional[Dict[str, Any]] = None
+    headers: Optional[Dict[str, str]] = None
+    data: Optional[Any] = None
+    method: str = 'GET'
+
+    def __post_init__(self):
+        self.params = dict(self.params or {})
+        self.headers = dict(self.headers or {})
+
+    @property
+    def body(self):
+        return self.data
+
+
+class _ResponseAdapter:
+    def __init__(self, payload, status_code, headers=None):
+        self.text = payload
+        self.status_code = status_code
+        self.headers = headers or {}
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        return False
+
+
+class Session:
+    def __init__(self):
+        self._client = None
+
+    def prepare_request(self, request: Request):
+        prepared = Request(
+            url=_merge_url_and_params(request.url, request.params),
+            params={},
+            headers=request.headers,
+            data=request.data,
+            method=request.method,
+        )
+        return prepared
+
+    def merge_environment_settings(self, url, proxies, stream, verify, cert):
+        return {
+            'proxies': proxies or {},
+            'stream': stream,
+            'verify': verify,
+            'cert': cert,
+        }
+
+    def send(self, request: Request, timeout=None, **kwargs):
+        if _httpx is not None:
+            return self._send_with_httpx(request, timeout, **kwargs)
+        return self._send_with_urllib(request, timeout, **kwargs)
+
+    def _send_with_httpx(self, request: Request, timeout=None, **kwargs):
+        request_kwargs = {
+            'method': request.method,
+            'url': request.url,
+            'headers': request.headers,
+        }
+        if request.data is not None:
+            request_kwargs['content'] = request.data
+        if timeout is not None:
+            request_kwargs['timeout'] = timeout
+
+        proxy_config = kwargs.get('proxies') or {}
+        request_func = getattr(_httpx, 'request')
+
+        if proxy_config:
+            import inspect
+
+            parameters = inspect.signature(request_func).parameters
+            if 'proxies' in parameters:
+                request_kwargs['proxies'] = proxy_config
+            elif 'proxy' in parameters:
+                proxy_value = None
+                if isinstance(proxy_config, dict):
+                    proxy_value = proxy_config.get('https') or proxy_config.get('http')
+                else:
+                    proxy_value = proxy_config
+                if proxy_value is not None:
+                    request_kwargs['proxy'] = proxy_value
+
+        return request_func(**request_kwargs)
+
+    def _send_with_urllib(self, request: Request, timeout=None, **kwargs):
+        url = request.url
+        data = request.data
+        headers = dict(request.headers or {})
+        proxy_config = kwargs.get('proxies') or {}
+
+        opener = build_opener()
+        if proxy_config:
+            proxy_handler = ProxyHandler(proxy_config)
+            opener = build_opener(proxy_handler)
+
+        if data is not None and not isinstance(data, (bytes, bytearray)):
+            data = str(data).encode('utf-8')
+
+        urllib_request = UrlRequest(url=url, data=data, headers=headers, method=request.method)
+
+        try:
+            with opener.open(urllib_request, timeout=timeout) as response:
+                payload = response.read().decode('utf-8')
+                response_headers = dict(response.headers.items())
+                return _ResponseAdapter(payload, response.getcode(), response_headers)
+        except HTTPError as error:
+            payload = error.read().decode('utf-8') if error.fp else ''
+            response_headers = dict(error.headers.items()) if error.headers else {}
+            return _ResponseAdapter(payload, error.code, response_headers)
+        except URLError as error:
+            raise error
