+"""Compatibility layer backed by urllib3.
+
+The historical code in this repository imports ``requests`` and the tests
+patch those symbols directly.  This module keeps that surface area intact while
+delegating the real HTTP work to urllib3.
+"""
+
+from urllib3 import PoolManager
+
+
+_default_pool = PoolManager()
+
+
+class Response(object):
+    def __init__(self, status_code, reason, content, headers=None, url=None):
+        self.status_code = status_code
+        self.reason = reason
+        self.content = content
+        self.headers = headers or {}
+        self.url = url
+
+    @property
+    def data(self):
+        return self.content
+
+
+class Session(object):
+    def __init__(self, pool_manager=None):
+        self._pool_manager = pool_manager or PoolManager()
+
+    def get(self, url, **kwargs):
+        return _request(self._pool_manager, url, **kwargs)
+
+
+def _coerce_reason(response):
+    reason = getattr(response, "reason", "") or ""
+    if isinstance(reason, bytes):
+        return reason.decode("latin-1", "replace")
+    return reason
+
+
+def _request(pool_manager, url, **kwargs):
+    response = pool_manager.request("GET", url, **kwargs)
+    return Response(status_code=response.status,
+                    reason=_coerce_reason(response),
+                    content=response.data,
+                    headers=dict(response.headers),
+                    url=getattr(response, "geturl", lambda: None)())
+
+
+def get(url, **kwargs):
+    return _request(_default_pool, url, **kwargs)
