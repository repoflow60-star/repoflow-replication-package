+"""Minimal pycurl compatibility layer for this repository.
+
+The repository only needs a tiny subset of the real pycurl API for fetching
+JSON data. This module provides that surface using urllib so the code can run
+in environments where the binary pycurl package is unavailable.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any
+from urllib import error as urllib_error, request
+
+URL = object()
+WRITEFUNCTION = object()
+CONNECTTIMEOUT = object()
+TIMEOUT = object()
+FOLLOWLOCATION = object()
+RESPONSE_CODE = object()
+
+
+class error(Exception):
+    """Compatibility exception matching pycurl.error."""
+
+
+@dataclass
+class Curl:
+    """Very small subset of pycurl.Curl used by this project."""
+
+    _options: dict[Any, Any] = field(default_factory=dict)
+    _response_code: int = 0
+
+    def setopt(self, option: Any, value: Any) -> None:
+        self._options[option] = value
+
+    def perform(self) -> None:
+        url = self._options.get(URL)
+        writefunction = self._options.get(WRITEFUNCTION)
+        timeout = self._options.get(TIMEOUT)
+        if timeout is None:
+            timeout = self._options.get(CONNECTTIMEOUT)
+        if not url:
+            raise error("URL option is required")
+        if writefunction is None:
+            raise error("WRITEFUNCTION option is required")
+
+        req = request.Request(url)
+        try:
+            with request.urlopen(req, timeout=timeout) as response:
+                self._response_code = response.getcode()
+                writefunction(response.read())
+        except urllib_error.HTTPError as exc:
+            self._response_code = exc.code
+            writefunction(exc.read())
+        except urllib_error.URLError as exc:
+            raise error(str(exc)) from exc
+
+    def getinfo(self, option: Any) -> Any:
+        if option is RESPONSE_CODE:
+            return self._response_code
+        raise error(f"Unsupported getinfo option: {option!r}")
+
+    def close(self) -> None:
+        self._options.clear()
