@@ -20,6 +23,39 @@ _VERSION_REGEX = re.compile("^[^v]*")
 logger = logging.getLogger(__name__)
 
 
+class _CurlResponse:
+    """Small response object used by the pycurl-backed fetch helper."""
+
+    def __init__(self, status_code: int, body: bytes) -> None:
+        self.status_code = status_code
+        self._body = body
+
+    def json(self) -> dict:
+        """Parse the response body as JSON."""
+        return json.loads(self._body.decode("utf-8"))
+
+
+def _pycurl_get(url: str, timeout: int = 10) -> _CurlResponse:
+    """Fetch a URL with pycurl and return a requests-like response object."""
+    body = BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.CONNECTTIMEOUT, timeout)
+        curl.setopt(pycurl.TIMEOUT, timeout)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+    return _CurlResponse(status_code=status_code, body=body.getvalue())
+
+
+# Preserve the old patch target used by tests, but back it with pycurl.
+requests = SimpleNamespace(get=_pycurl_get)
+
+
 def fetch_json_data() -> dict:
     """Fetch data from JSON on Github and return as dict."""
     fetched_data = requests.get(JSON_DATA_SOURCE, timeout=10)
