index 0000000..10d3077
--- /dev/null
+++ b/finsec/http.py
@@ -0,0 +1,36 @@
+from io import BytesIO
+from urllib.request import Request, urlopen
+
+try:
+    import pycurl
+except ImportError:  # pragma: no cover - fallback for environments without pycurl
+    pycurl = None
+
+
+def get_text(url, headers):
+    """Fetch a URL and return the response body as text.
+
+    The primary implementation uses pycurl. A small stdlib fallback keeps the
+    package importable in environments where pycurl is not available.
+    """
+    if pycurl is not None:
+        buffer = BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEDATA, buffer)
+            curl.setopt(pycurl.FOLLOWLOCATION, True)
+            curl.setopt(pycurl.ACCEPT_ENCODING, "")
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                [f"{key}: {value}" for key, value in headers.items()],
+            )
+            curl.perform()
+            body = buffer.getvalue()
+        finally:
+            curl.close()
+        return body.decode("utf-8", errors="replace")
+
+    request = Request(url, headers=headers)
+    with urlopen(request) as response:
+        return response.read().decode("utf-8", errors="replace")
