+"""Compatibility layer for Altair-backed plots.
+
+The real Altair dependency is preferred.  When it is unavailable in the
+current environment, a small no-op fallback keeps the package importable and
+lets the rest of the ALE logic continue to work.
+"""
+
+try:
+    import altair as alt  # type: ignore
+except ModuleNotFoundError:  # pragma: no cover - exercised only without altair
+
+    class _EncodingSpec:
+        def __init__(self, channel, field=None, **kwargs):
+            self.channel = channel
+            self.field = field
+            self.kwargs = kwargs
+
+
+    class _Chart:
+        def __init__(self, data=None):
+            self.data = data
+            self.spec = {}
+
+        def mark_line(self, **kwargs):
+            self.spec["mark"] = ("line", kwargs)
+            return self
+
+        def mark_area(self, **kwargs):
+            self.spec["mark"] = ("area", kwargs)
+            return self
+
+        def mark_rule(self, **kwargs):
+            self.spec["mark"] = ("rule", kwargs)
+            return self
+
+        def mark_bar(self, **kwargs):
+            self.spec["mark"] = ("bar", kwargs)
+            return self
+
+        def mark_rect(self, **kwargs):
+            self.spec["mark"] = ("rect", kwargs)
+            return self
+
+        def encode(self, **kwargs):
+            self.spec["encode"] = kwargs
+            return self
+
+        def properties(self, **kwargs):
+            self.spec.setdefault("properties", {}).update(kwargs)
+            return self
+
+        def resolve_scale(self, **kwargs):
+            self.spec.setdefault("resolve_scale", {}).update(kwargs)
+            return self
+
+        def __add__(self, other):
+            return _Chart(("layer", [self, other]))
+
+        def __repr__(self):
+            return f"_Chart({self.spec!r})"
+
+
+    def _field(channel, field=None, **kwargs):
+        return _EncodingSpec(channel, field, **kwargs)
+
+
+    class _AltairFallback:
+        Chart = _Chart
+
+        @staticmethod
+        def layer(*charts):
+            return _Chart(("layer", list(charts)))
+
+        @staticmethod
+        def vconcat(*charts):
+            return _Chart(("vconcat", list(charts)))
+
+        X = staticmethod(lambda field=None, **kwargs: _field("x", field, **kwargs))
+        Y = staticmethod(lambda field=None, **kwargs: _field("y", field, **kwargs))
+        Y2 = staticmethod(lambda field=None, **kwargs: _field("y2", field, **kwargs))
+        Color = staticmethod(lambda field=None, **kwargs: _field("color", field, **kwargs))
+
+
+    alt = _AltairFallback()
+
+
+class _Figure:
+    """Minimal placeholder for legacy figure unpacking."""
+
+
+class _Line:
+    def __init__(self, xydata):
+        self._xydata = xydata
+
+    def get_xydata(self):
+        return self._xydata
+
+
+class _Path:
+    def __init__(self, vertices):
+        self.vertices = vertices
+
+
+class _Collection:
+    def __init__(self, vertices):
+        self._paths = [_Path(vertices)]
+
+    def get_paths(self):
+        return self._paths
+
+
+class _Image:
+    def __init__(self, array):
+        self._array = array
+
+    def get_array(self):
+        return self._array
+
+
+class _Patch:
+    def __init__(self, height):
+        self._height = height
+
+    def get_height(self):
+        return self._height
+
+
+class _Axes:
+    def __init__(self, lines=None, collections=None, images=None, patches=None):
+        self.lines = lines or []
+        self.collections = collections or []
+        self.images = images or []
+        self.patches = patches or []
+
+
+class _PlotResult:
+    def __init__(self, chart, unpack_values):
+        self.chart = chart
+        self._unpack_values = unpack_values
+
+    def __iter__(self):
+        return iter(self._unpack_values)
+
+    def __getattr__(self, name):
+        return getattr(self.chart, name)
+
+    def __repr__(self):
+        return repr(self.chart)
+
+
+def make_plot_result(chart, unpack_values):
+    return _PlotResult(chart, unpack_values)
