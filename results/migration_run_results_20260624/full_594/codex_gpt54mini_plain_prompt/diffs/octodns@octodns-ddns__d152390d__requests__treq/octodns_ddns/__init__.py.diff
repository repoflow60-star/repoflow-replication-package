+    def _resolve_treq_value(self, value):
+        if (
+            (Deferred and isinstance(value, Deferred))
+            or hasattr(value, 'addCallbacks')
+            or hasattr(value, '__await__')
+        ):
+            if _ASYNCIO_LOOP is None:
+                raise RuntimeError('treq requires an asyncio reactor')
+
+            async def _await_value():
+                return await value
+
+            return _ASYNCIO_LOOP.run_until_complete(_await_value())
+        return value
+
+    def _get_addr_treq(self, _type):
+        response = treq.get(self.urls[_type])
+        response = self._resolve_treq_value(response)
+
