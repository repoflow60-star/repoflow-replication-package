+def _render_table_rows(rows: list[list[str]], widths: list[int],
+                       alignments: list[str]) -> str:
+    """Render table rows with Rich using fixed column widths."""
+    table = Table(
+        show_header=False,
+        box=None,
+        pad_edge=False,
+        expand=False,
+        show_lines=False,
+        leading=0,
+        padding=(0, 0),
+        collapse_padding=True,
+    )
+    for width, alignment in zip(widths, alignments):
+        table.add_column(justify=alignment, width=width, no_wrap=True)
+
+    for row in rows:
+        table.add_row(*row)
+
+    console = Console(
+        file=StringIO(),
+        force_terminal=False,
+        highlight=False,
+        width=max(sum(widths) + max(len(widths) - 1, 0), 1),
+    )
+    console.print(table)
+    return console.file.getvalue().rstrip("\n")
+
+
+def _render_tabular_text(headers: list[str], rows: list[list[object]],
+                         colalign: Optional[str] = None) -> str:
+    """Render a plain text table using Rich for row layout.
+
+    The output preserves the existing whitespace-delimited format used by the
+    repository, while replacing the previous table formatting dependency.
+    """
+    header_values = [str(value) for value in headers]
+    row_values = [[str(value) for value in row] for row in rows]
+    alignments = [colalign or "right"] * len(header_values)
+    widths = [
+        max(len(header_values[index]),
+            *(len(row[index]) for row in row_values))
+        for index in range(len(header_values))
+    ]
+    header_line = "  ".join(
+        f"{header_values[index]:>{widths[index]}}"
+        if alignments[index] == "right"
+        else f"{header_values[index]:<{widths[index]}}"
+        for index in range(len(header_values))
+    )
+    separator_line = "  ".join("-" * width for width in widths)
+    body = _render_table_rows(row_values, widths, alignments)
+    if body:
+        return "\n".join([header_line, separator_line, body])
+    return "\n".join([header_line, separator_line])
+
