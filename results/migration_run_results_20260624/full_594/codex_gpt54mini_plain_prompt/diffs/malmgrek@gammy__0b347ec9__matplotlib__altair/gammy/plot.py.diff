+def _to_python(value):
+    if isinstance(value, np.generic):
+        return value.item()
+    if isinstance(value, np.ndarray):
+        return value.tolist()
+    return value
+
+
+def _records_from_columns(**columns):
+    arrays = {name: np.asarray(values) for name, values in columns.items()}
+    length = len(next(iter(arrays.values())))
+    records = []
+    for i in range(length):
+        records.append({
+            name: _to_python(values[i])
+            for (name, values) in arrays.items()
+        })
+    return records
+
+
+def _line_band_chart(
+        x,
+        mean,
+        lower,
+        upper,
+        *,
+        x_title=None,
+        y_title=None,
+        title=None,
+        color="black",
+        height=180,
+        width=320
+):
+    records = _records_from_columns(
+        x=x,
+        mean=mean,
+        lower=lower,
+        upper=upper
+    )
+    base = alt.Chart({"values": records})
+    band = base.mark_area(opacity=0.25, color=color).encode(
+        x=alt.X("x:Q", title=x_title),
+        y=alt.Y("lower:Q", title=y_title),
+        y2="upper:Q"
+    )
+    line = base.mark_line(color=color).encode(
+        x="x:Q",
+        y="mean:Q"
+    )
+    return alt.layer(band, line).properties(
+        title=title,
+        width=width,
+        height=height
+    )
+
+
+def _scatter_chart(
+        x,
+        y,
+        *,
+        x_title=None,
+        y_title=None,
+        title=None,
+        color="red",
+        opacity=0.3,
+        height=180,
+        width=320,
+        **kwargs
+):
+    records = _records_from_columns(x=x, y=y)
+    point_kwargs = {
+        key: kwargs[key]
+        for key in ("size", "filled", "shape", "stroke", "strokeWidth")
+        if key in kwargs
+    }
+    chart = alt.Chart({"values": records}).mark_point(
+        color=color,
+        opacity=opacity,
+        **point_kwargs
+    ).encode(
+        x=alt.X("x:Q", title=x_title),
+        y=alt.Y("y:Q", title=y_title)
+    )
+    return chart.properties(title=title, width=width, height=height)
+
+
+def _heatmap_chart(
+        x,
+        y,
+        value,
+        *,
+        x_title=None,
+        y_title=None,
+        color_title=None,
+        title=None,
+        height=180,
+        width=320,
+        scheme="viridis"
+):
+    records = _records_from_columns(x=x, y=y, value=value)
+    return alt.Chart({"values": records}).mark_rect().encode(
+        x=alt.X("x:Q", title=x_title),
+        y=alt.Y("y:Q", title=y_title),
+        color=alt.Color(
+            "value:Q",
+            title=color_title,
+            scale=alt.Scale(scheme=scheme)
+        ),
+        tooltip=["x:Q", "y:Q", "value:Q"]
+    ).properties(title=title, width=width, height=height)
+
