+def _build_aiohttp_request_options(options, default_timeout=30):
+    """
+    Convert request options from the legacy requests-style shape to aiohttp kwargs.
+    """
+
+    options = copy.deepcopy(options)
+
+    timeout = options.pop("timeout", default_timeout)
+    if not isinstance(timeout, ClientTimeout):
+        timeout = ClientTimeout(total=timeout)
+
+    ssl = options.pop("verify", options.pop("verify_ssl", None))
+
+    session_kwargs = {"timeout": timeout}
+    if ssl is not None:
+        session_kwargs["connector"] = TCPConnector(ssl=ssl)
+
+    return session_kwargs, options
+
+
+class _AiohttpRequestsCompat:
+    """
+    Small compatibility layer that preserves the old requests.get call shape
+    while executing the request with aiohttp under the hood.
+    """
+
+    def get(self, url, **kwargs):
+        return asyncio.run(self._get(url, **kwargs))
+
+    async def _get(self, url, **kwargs):
+        session_kwargs, request_kwargs = _build_aiohttp_request_options(kwargs)
+
+        async with ClientSession(**session_kwargs) as session:
+            async with session.get(url=url, **request_kwargs) as response:
+                text = await response.text()
+                return SimpleNamespace(
+                    status_code=response.status,
+                    text=text,
+                    headers=dict(response.headers),
+                )
+
+
+requests = _AiohttpRequestsCompat()
+
+
