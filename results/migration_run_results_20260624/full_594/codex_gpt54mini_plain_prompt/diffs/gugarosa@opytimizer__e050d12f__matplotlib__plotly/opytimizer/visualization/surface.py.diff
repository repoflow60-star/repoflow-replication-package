+        "hot": pc.get_colorscale("Hot"),
+        "viridis": pc.get_colorscale("Viridis"),
+        "plasma": pc.get_colorscale("Plasma"),
+        "inferno": pc.get_colorscale("Inferno"),
+        "magma": pc.get_colorscale("Magma"),
+        "cividis": pc.get_colorscale("Cividis"),
+        "turbo": pc.get_colorscale("Turbo"),
+        "jet": [
+            [0.0, "rgb(0, 0, 131)"],
+            [0.35, "rgb(0, 60, 170)"],
+            [0.5, "rgb(5, 255, 255)"],
+            [0.65, "rgb(255, 255, 0)"],
+            [1.0, "rgb(128, 0, 0)"],
+        ],
+    }
+
+    return matplotlib_style_map.get(style, "Viridis")
 
 
