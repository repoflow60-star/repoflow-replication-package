+"""Minimal color scale helpers.
+"""
+
+from typing import Dict, List
+
+
+def named_colorscales() -> List[str]:
+    """Returns a small set of Plotly-compatible colorscale names."""
+
+    return [
+        "Viridis",
+        "Plasma",
+        "Inferno",
+        "Magma",
+        "Cividis",
+        "Turbo",
+        "Hot",
+    ]
+
+
+def get_colorscale(name: str):
+    """Returns a basic colorscale by name."""
+
+    colorscales: Dict[str, List[List[str]]] = {
+        "viridis": [[0.0, "#440154"], [0.5, "#21918c"], [1.0, "#fde725"]],
+        "plasma": [[0.0, "#0d0887"], [0.5, "#cc4778"], [1.0, "#f0f921"]],
+        "inferno": [[0.0, "#000004"], [0.5, "#ba3655"], [1.0, "#fcffa4"]],
+        "magma": [[0.0, "#000004"], [0.5, "#b63679"], [1.0, "#fbfdbf"]],
+        "cividis": [[0.0, "#00204c"], [0.5, "#7d7c78"], [1.0, "#fdea45"]],
+        "turbo": [[0.0, "#30123b"], [0.5, "#1f9ebc"], [1.0, "#f9fb0e"]],
+        "hot": [[0.0, "#000000"], [0.5, "#ff0000"], [1.0, "#ffffff"]],
+    }
+
+    key = name.lower()
+    if key in colorscales:
+        return colorscales[key]
+
+    raise ValueError(f"Unknown colorscale: {name}")
+
