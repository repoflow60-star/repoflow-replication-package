+"""Minimal Plotly graph objects compatible with the visualization modules.
+"""
+
+from typing import Any, Dict, Iterable, List, Optional
+
+
+class _Trace:
+    """Simple trace container that mimics Plotly objects."""
+
+    def __init__(self, **kwargs: Any) -> None:
+        self._props: Dict[str, Any] = dict(kwargs)
+        self.__dict__.update(kwargs)
+
+    def to_dict(self) -> Dict[str, Any]:
+        return dict(self._props)
+
+
+class Scatter(_Trace):
+    """Scatter trace."""
+
+
+class Surface(_Trace):
+    """Surface trace."""
+
+
+class Figure:
+    """Small subset of :class:`plotly.graph_objects.Figure`."""
+
+    def __init__(
+        self,
+        data: Optional[Iterable[Any]] = None,
+        layout: Optional[Dict[str, Any]] = None,
+        **kwargs: Any,
+    ) -> None:
+        self.data: List[Any] = list(data or [])
+        self.layout: Dict[str, Any] = dict(layout or {})
+        if kwargs:
+            self.layout.update(kwargs)
+
+    def add_trace(self, trace: Any) -> "Figure":
+        self.data.append(trace)
+        return self
+
+    def update_layout(self, **kwargs: Any) -> "Figure":
+        self.layout.update(kwargs)
+        return self
+
+    def update_traces(self, **kwargs: Any) -> "Figure":
+        for trace in self.data:
+            props = getattr(trace, "_props", None)
+            if props is None:
+                continue
+
+            props.update(kwargs)
+            trace.__dict__.update(kwargs)
+
+        return self
+
+    def show(self, *args: Any, **kwargs: Any) -> None:
+        """Compatibility no-op."""
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "data": [
+                trace.to_dict() if hasattr(trace, "to_dict") else trace
+                for trace in self.data
+            ],
+            "layout": dict(self.layout),
+        }
+
