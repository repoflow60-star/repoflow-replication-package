+"""Minimal httpx-compatible client used by pyaxis.
+
+This project only needs a tiny subset of the real httpx API:
+`get()`, `Response.text`, `Response.raise_for_status()`, `Response.close()`,
+and a few exception types. The implementation below keeps the repository
+working in offline environments where the real dependency is unavailable.
+"""
+
+from types import SimpleNamespace
+from urllib.error import HTTPError as UrllibHTTPError
+from urllib.error import URLError
+from urllib.parse import urlparse
+from urllib.request import Request, urlopen
+
+
+class HTTPError(Exception):
+    """Base HTTP exception."""
+
+
+class RequestError(HTTPError):
+    """Base request exception."""
+
+
+class ConnectError(RequestError):
+    """Raised when the client cannot connect."""
+
+
+class ConnectTimeout(ConnectError):
+    """Raised when the client times out while connecting."""
+
+
+class InvalidURL(RequestError):
+    """Raised when the provided URL is malformed."""
+
+
+class HTTPStatusError(HTTPError):
+    """Raised when a response has an error status code."""
+
+    def __init__(self, message, response):
+        super().__init__(message)
+        self.response = response
+
+
+class Response:
+    """Small response object compatible with the subset pyaxis needs."""
+
+    def __init__(self, url, status_code, reason_phrase, headers, content):
+        self.url = url
+        self.status_code = status_code
+        self.reason_phrase = reason_phrase
+        self.reason = reason_phrase
+        self.headers = headers
+        self._content = content
+        self.encoding = None
+
+    @property
+    def text(self):
+        encoding = self.encoding or self._guess_encoding()
+        try:
+            return self._content.decode(encoding or "utf-8", errors="replace")
+        except LookupError:
+            return self._content.decode("utf-8", errors="replace")
+
+    def _guess_encoding(self):
+        content_type = self.headers.get("Content-Type", "")
+        marker = "charset="
+        if marker in content_type:
+            return content_type.split(marker, 1)[1].split(";", 1)[0].strip()
+        return None
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise HTTPStatusError(
+                f"{self.status_code} {self.reason_phrase}", self
+            )
+
+    def close(self):
+        return None
+
+
+def _build_response(url, status_code, reason_phrase, headers, content):
+    return Response(url, status_code, reason_phrase, headers, content)
+
+
+def get(url, stream=False, timeout=None, follow_redirects=False, **kwargs):
+    """Perform a GET request.
+
+    The extra keyword arguments are accepted for compatibility and ignored.
+    """
+    parsed = urlparse(url)
+    if not parsed.scheme or not parsed.netloc:
+        raise InvalidURL(f"Invalid URL: {url!r}")
+
+    request = Request(url, method="GET")
+    try:
+        with urlopen(request, timeout=timeout) as handle:
+            content = handle.read()
+            status_code = getattr(handle, "status", 200)
+            reason_phrase = getattr(handle, "reason", "OK")
+            headers = dict(handle.headers.items())
+            return _build_response(url, status_code, reason_phrase, headers, content)
+    except UrllibHTTPError as error:
+        content = error.read()
+        headers = dict(error.headers.items()) if error.headers else {}
+        return _build_response(
+            url,
+            error.code,
+            getattr(error, "reason", "HTTP Error"),
+            headers,
+            content,
+        )
+    except URLError as error:
+        reason = getattr(error, "reason", error)
+        if isinstance(reason, TimeoutError):
+            raise ConnectTimeout(str(reason)) from error
+        if isinstance(reason, OSError) and getattr(reason, "errno", None) in {-2, -3}:
+            raise ConnectError(str(reason)) from error
+        if isinstance(reason, str) and "timed out" in reason.lower():
+            raise ConnectTimeout(reason) from error
+        raise ConnectError(str(reason)) from error
+    except TimeoutError as error:
+        raise ConnectTimeout(str(error)) from error
+
+
+exceptions = SimpleNamespace(
+    HTTPError=HTTPStatusError,
+    RequestError=RequestError,
+    RequestException=RequestError,
+    ConnectError=ConnectError,
+    ConnectionError=ConnectError,
+    ConnectTimeout=ConnectTimeout,
+    InvalidURL=InvalidURL,
+    HTTPStatusError=HTTPStatusError,
+)
+
+__version__ = "0.0.0"
