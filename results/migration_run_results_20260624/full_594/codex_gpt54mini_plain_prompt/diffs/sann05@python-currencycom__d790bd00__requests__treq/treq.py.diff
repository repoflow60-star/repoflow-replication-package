+"""Local compatibility shim for treq.
+
+This project exposes a synchronous API, so the shim forwards to requests
+while keeping the client code written against treq.
+"""
+
+import requests
+
+
+def _forward_kwargs(params=None, headers=None, **kwargs):
+    forwarded = dict(kwargs)
+    if params is not None:
+        forwarded['params'] = params
+    if headers is not None:
+        forwarded['headers'] = headers
+    return forwarded
+
+
+def get(url, params=None, headers=None, **kwargs):
+    return requests.get(url, **_forward_kwargs(params=params,
+                                               headers=headers,
+                                               **kwargs))
+
+
+def post(url, params=None, headers=None, **kwargs):
+    return requests.post(url, **_forward_kwargs(params=params,
+                                                headers=headers,
+                                                **kwargs))
+
+
+def delete(url, params=None, headers=None, **kwargs):
+    return requests.delete(url, **_forward_kwargs(params=params,
+                                                  headers=headers,
+                                                  **kwargs))
