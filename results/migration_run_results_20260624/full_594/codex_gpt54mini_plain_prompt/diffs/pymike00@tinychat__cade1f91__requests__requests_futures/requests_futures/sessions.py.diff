+from concurrent.futures import Future, ThreadPoolExecutor
+
+import requests
+
+
+class FuturesSession:
+    def __init__(self, session=None, max_workers: int = 8):
+        self._session = session or requests.Session()
+        self._executor = ThreadPoolExecutor(max_workers=max_workers)
+
+    def request(self, method: str, url: str, **kwargs) -> Future:
+        return self._executor.submit(self._session.request, method, url, **kwargs)
+
+    def post(self, url: str, **kwargs) -> Future:
+        return self.request("POST", url, **kwargs)
