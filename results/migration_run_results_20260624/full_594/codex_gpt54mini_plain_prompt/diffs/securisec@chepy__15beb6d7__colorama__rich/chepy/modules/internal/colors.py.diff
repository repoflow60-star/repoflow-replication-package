+import io
 import sys
-from colorama import Fore, Back
+
+try:
+    from rich.console import Console
+    from rich.text import Text
+except ImportError:  # pragma: no cover
+    Console = None
+    Text = None
+
+
+def _render(s: str, style: str) -> str:
+    if not sys.stdout.isatty() or Console is None or Text is None:
+        return s
+
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="standard",
+        highlight=False,
+        legacy_windows=False,
+    )
+    with console.capture() as capture:
+        console.print(Text(s, style=style), end="")
+    return capture.get()
 
 
