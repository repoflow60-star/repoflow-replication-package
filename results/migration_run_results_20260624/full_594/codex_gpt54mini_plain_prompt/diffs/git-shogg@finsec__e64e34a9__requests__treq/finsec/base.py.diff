+_HTTP_LOOP = None
+
+
+def _ensure_http_runtime():
+    global _HTTP_LOOP
+    if _HTTP_LOOP is not None:
+        return _HTTP_LOOP
+
+    from twisted.internet import asyncioreactor
+
+    _HTTP_LOOP = asyncio.new_event_loop()
+    asyncio.set_event_loop(_HTTP_LOOP)
+    try:
+        asyncioreactor.install(_HTTP_LOOP)
+    except Exception:
+        # The reactor may already be installed by the host process.
+        pass
+    return _HTTP_LOOP
+
+
+# treq is asynchronous, so this helper runs it on a dedicated event loop and
+# keeps the public Filing API synchronous.
+def _http_get_text(url, headers):
+    loop = _ensure_http_runtime()
+    import treq
+
+    async def _fetch():
+        response = await treq.get(url, headers=headers)
+        return await treq.text_content(response)
+
+    return loop.run_until_complete(_fetch())
