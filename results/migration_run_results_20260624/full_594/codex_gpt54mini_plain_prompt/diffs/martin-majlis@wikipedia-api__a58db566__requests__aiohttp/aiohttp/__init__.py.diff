+"""Minimal aiohttp-compatible client used by the Wikipedia API wrapper.
+
+This repository is exercised in an offline environment where the real
+``aiohttp`` package is not available. The code in ``wikipediaapi`` uses only a
+small subset of the client API, so this module provides that subset on top of
+the Python standard library.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from dataclasses import dataclass
+from typing import Any, Optional
+from urllib import error as urllib_error
+from urllib import parse, request as urllib_request
+
+
+@dataclass
+class ClientTimeout:
+    total: Optional[float] = None
+
+
+class ClientResponseError(Exception):
+    def __init__(self, *, status: int, message: str, url: str) -> None:
+        super().__init__(message)
+        self.status = status
+        self.message = message
+        self.url = url
+
+
+class ClientResponse:
+    def __init__(
+        self,
+        *,
+        url: str,
+        status: int,
+        headers: dict[str, str],
+        body: bytes,
+    ) -> None:
+        self.url = url
+        self.status = status
+        self.headers = headers
+        self._body = body
+
+    def raise_for_status(self) -> None:
+        if self.status >= 400:
+            raise ClientResponseError(
+                status=self.status,
+                message=f"HTTP {self.status}",
+                url=self.url,
+            )
+
+    async def json(self) -> Any:
+        return json.loads(self._body.decode("utf-8"))
+
+    async def text(self) -> str:
+        return self._body.decode("utf-8")
+
+    async def read(self) -> bytes:
+        return self._body
+
+
+class _RequestContextManager:
+    def __init__(
+        self,
+        session: "ClientSession",
+        method: str,
+        url: str,
+        *,
+        params: Optional[dict[str, Any]] = None,
+        proxy: Optional[str] = None,
+        headers: Optional[dict[str, str]] = None,
+        timeout: Optional[float | ClientTimeout] = None,
+        kwargs: dict[str, Any],
+    ) -> None:
+        self._session = session
+        self._method = method
+        self._url = url
+        self._params = params
+        self._proxy = proxy
+        self._headers = headers
+        self._timeout = timeout
+        self._kwargs = kwargs
+        self._response: Optional[ClientResponse] = None
+
+    async def __aenter__(self) -> ClientResponse:
+        self._response = await self._session._request(
+            self._method,
+            self._url,
+            params=self._params,
+            proxy=self._proxy,
+            headers=self._headers,
+            timeout=self._timeout,
+            **self._kwargs,
+        )
+        return self._response
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        return False
+
+
+class ClientSession:
+    def __init__(
+        self,
+        *,
+        headers: Optional[dict[str, str]] = None,
+        timeout: Optional[float | ClientTimeout] = None,
+    ) -> None:
+        self.headers = dict(headers or {})
+        self.timeout = timeout
+        self._closed = False
+
+    async def __aenter__(self) -> "ClientSession":
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        self.close()
+        return False
+
+    def close(self) -> None:
+        self._closed = True
+
+    def get(
+        self,
+        url: str,
+        *,
+        params: Optional[dict[str, Any]] = None,
+        proxy: Optional[str] = None,
+        headers: Optional[dict[str, str]] = None,
+        timeout: Optional[float | ClientTimeout] = None,
+        **kwargs: Any,
+    ) -> _RequestContextManager:
+        return _RequestContextManager(
+            self,
+            "GET",
+            url,
+            params=params,
+            proxy=proxy,
+            headers=headers,
+            timeout=timeout,
+            kwargs=kwargs,
+        )
+
+    async def _request(
+        self,
+        method: str,
+        url: str,
+        *,
+        params: Optional[dict[str, Any]] = None,
+        proxy: Optional[str] = None,
+        headers: Optional[dict[str, str]] = None,
+        timeout: Optional[float | ClientTimeout] = None,
+        **kwargs: Any,
+    ) -> ClientResponse:
+        if self._closed:
+            raise RuntimeError("Session is closed")
+
+        request_url = _merge_query_params(url, params)
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        request_timeout = _coerce_timeout(timeout, self.timeout)
+        return await asyncio.to_thread(
+            _perform_request,
+            method,
+            request_url,
+            request_headers,
+            proxy,
+            request_timeout,
+            kwargs,
+        )
+
+
+def _coerce_timeout(
+    timeout: Optional[float | ClientTimeout],
+    default_timeout: Optional[float | ClientTimeout],
+) -> Optional[float]:
+    value: Optional[float | ClientTimeout] = timeout
+    if value is None:
+        value = default_timeout
+    if isinstance(value, ClientTimeout):
+        return value.total
+    return value
+
+
+def _merge_query_params(url: str, params: Optional[dict[str, Any]]) -> str:
+    if not params:
+        return url
+
+    parsed = parse.urlsplit(url)
+    query_pairs = parse.parse_qsl(parsed.query, keep_blank_values=True)
+    query_pairs.extend((key, str(value)) for key, value in params.items())
+    new_query = parse.urlencode(query_pairs)
+    return parse.urlunsplit(
+        (
+            parsed.scheme,
+            parsed.netloc,
+            parsed.path,
+            new_query,
+            parsed.fragment,
+        )
+    )
+
+
+def _perform_request(
+    method: str,
+    url: str,
+    headers: dict[str, str],
+    proxy: Optional[str],
+    timeout: Optional[float],
+    kwargs: dict[str, Any],
+) -> ClientResponse:
+    if kwargs:
+        # Accept extra aiohttp-style kwargs without failing, but ignore the ones
+        # this compatibility layer cannot map onto urllib.
+        kwargs = dict(kwargs)
+
+    request = urllib_request.Request(url, method=method)
+    for key, value in headers.items():
+        request.add_header(key, value)
+
+    handlers = []
+    if proxy:
+        handlers.append(
+            urllib_request.ProxyHandler(
+                {
+                    "http": proxy,
+                    "https": proxy,
+                }
+            )
+        )
+
+    opener = urllib_request.build_opener(*handlers)
+    try:
+        with opener.open(request, timeout=timeout) as response:
+            body = response.read()
+            status = getattr(response, "status", response.getcode())
+            response_headers = dict(response.headers.items())
+            final_url = response.geturl()
+    except urllib_error.HTTPError as exc:
+        body = exc.read()
+        status = exc.code
+        response_headers = dict(exc.headers.items()) if exc.headers else {}
+        final_url = exc.geturl()
+
+    return ClientResponse(
+        url=final_url,
+        status=status,
+        headers=response_headers,
+        body=body,
+    )
