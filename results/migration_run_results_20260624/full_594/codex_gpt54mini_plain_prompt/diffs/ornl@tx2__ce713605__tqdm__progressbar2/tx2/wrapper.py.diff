+import numpy as np
+import pandas as pd
+import torch
+
+try:
+    import umap
+except Exception:  # pragma: no cover - fallback when umap cannot import cleanly
+    umap = None
+
+from torch.utils.data import DataLoader
+
+try:
+    import progressbar
+except ImportError:  # pragma: no cover - fallback for environments without the dependency
+    progressbar = None
+
+from tx2 import calc, dataset, utils
+from tx2.cache import check, read, write
+
+
+def _progress(iterable, total=None):
+    """Wrap an iterable with a progress bar when the dependency is available."""
+    if progressbar is None:
+        return iterable
+
+    if total is None:
+        total = len(iterable)
+
+    return progressbar.progressbar(iterable, max_value=total)
 
 
