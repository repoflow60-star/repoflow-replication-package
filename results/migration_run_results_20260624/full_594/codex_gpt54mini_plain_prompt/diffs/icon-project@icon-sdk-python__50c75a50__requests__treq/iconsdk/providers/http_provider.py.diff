+try:
+    _TREQ_LOOP = None
+    from twisted.internet import asyncioreactor
+    _TREQ_LOOP = asyncio.new_event_loop()
+    asyncioreactor.install(eventloop=_TREQ_LOOP)
+    import treq
+except Exception:  # pragma: no cover - exercised when treq/twisted is unavailable.
+    if _TREQ_LOOP is not None:
+        _TREQ_LOOP.close()
+    _TREQ_LOOP = None
+    treq = None
+
+
+@dataclass
+class _HTTPResponse:
+    content: bytes
+    status_code: int
+    ok: bool
+
+
+class _TreqRuntime:
+    def __init__(self):
+        self.available = treq is not None and _TREQ_LOOP is not None
+
+    def post(self, request_url: str, data: dict, **kwargs) -> _HTTPResponse:
+        timeout = kwargs.pop('timeout', 10)
+        headers = kwargs.pop('headers', {})
+        if self.available:
+            return self._post_with_treq(request_url, data, headers=headers, timeout=timeout)
+        return self._post_with_requests(request_url, data, headers=headers, timeout=timeout, **kwargs)
+
+    @staticmethod
+    def _post_with_treq(request_url: str, data: dict, headers: dict, timeout: float) -> _HTTPResponse:
+        body = json.dumps(data).encode()
+        deferred = treq.post(request_url, data=body, headers=headers)
+        if timeout is not None:
+            deferred.addTimeout(timeout, _TREQ_LOOP)
+        response = _TREQ_LOOP.run_until_complete(deferred.asFuture(_TREQ_LOOP))
+        content = _TREQ_LOOP.run_until_complete(treq.content(response).asFuture(_TREQ_LOOP))
+        code = getattr(response, 'code', 200)
+        return _HTTPResponse(content=content, status_code=code, ok=200 <= code < 400)
+
+    @staticmethod
+    def _post_with_requests(request_url: str, data: dict, headers: dict, timeout: float, **kwargs) -> _HTTPResponse:
+        import requests
+
+        kwargs.setdefault('timeout', timeout)
+        request_kwargs = dict(kwargs)
+        request_kwargs['headers'] = headers
+        with requests.Session() as session:
+            response = session.post(url=request_url, data=json.dumps(data), **request_kwargs)
+        return _HTTPResponse(content=response.content, status_code=response.status_code, ok=response.ok)
+
+
+_TREQ_RUNTIME = _TreqRuntime()
+
 
