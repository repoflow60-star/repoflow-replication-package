+++ b/Crypto/Hash/_hash.py
@@ -0,0 +1,31 @@
+import hashlib
+
+
+class _Hash:
+    def __init__(self, name: str, constructor, data: bytes = b""):
+        self._name = name
+        self._hash = constructor()
+        if data:
+            self._hash.update(data)
+
+    @property
+    def digest_size(self) -> int:
+        return self._hash.digest_size
+
+    @property
+    def algorithm(self) -> str:
+        return self._name
+
+    def update(self, data: bytes) -> None:
+        self._hash.update(data)
+
+    def digest(self) -> bytes:
+        return self._hash.digest()
+
+    def hexdigest(self) -> str:
+        return self._hash.hexdigest()
+
+
+def _new(name: str, constructor, data: bytes = b""):
+    return _Hash(name, constructor, data=data)
+
