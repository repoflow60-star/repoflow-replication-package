diff --git /dev/null b/Crypto/Signature/pkcs1_15.py
new file mode 100644
index 0000000..1f428e4
--- /dev/null
+++ b/Crypto/Signature/pkcs1_15.py
@@ -0,0 +1,24 @@
+from cryptography.exceptions import InvalidSignature
+from cryptography.hazmat.primitives.asymmetric import padding, utils
+
+from ._common import _hash_algorithm
+
+
+class _PKCS115Verifier:
+    def __init__(self, key):
+        self._key = key
+
+    def verify(self, hash_obj, signature):
+        try:
+            self._key.public_key.verify(
+                signature,
+                hash_obj.digest(),
+                padding.PKCS1v15(),
+                utils.Prehashed(_hash_algorithm(hash_obj)),
+            )
+        except InvalidSignature as exc:
+            raise ValueError("Signature could not be verified") from exc
+
+
+def new(key):
+    return _PKCS115Verifier(key)
