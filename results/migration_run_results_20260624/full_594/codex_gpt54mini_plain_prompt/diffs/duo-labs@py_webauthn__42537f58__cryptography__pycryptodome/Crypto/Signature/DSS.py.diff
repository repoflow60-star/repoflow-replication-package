index 0000000..a45e15c
--- /dev/null
+++ b/Crypto/Signature/DSS.py
@@ -0,0 +1,24 @@
+from cryptography.exceptions import InvalidSignature
+from cryptography.hazmat.primitives.asymmetric import ec, utils
+
+from ._common import _hash_algorithm
+
+
+class _DSSVerifier:
+    def __init__(self, key, mode, encoding="binary"):
+        self._key = key
+        self._encoding = encoding
+
+    def verify(self, hash_obj, signature):
+        try:
+            self._key.public_key.verify(
+                signature,
+                hash_obj.digest(),
+                ec.ECDSA(utils.Prehashed(_hash_algorithm(hash_obj))),
+            )
+        except InvalidSignature as exc:
+            raise ValueError("Signature could not be verified") from exc
+
+
+def new(key, mode, encoding="binary"):
+    return _DSSVerifier(key, mode, encoding=encoding)
