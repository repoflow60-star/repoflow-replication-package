+++ b/Crypto/Signature/pss.py
@@ -0,0 +1,28 @@
+from cryptography.exceptions import InvalidSignature
+from cryptography.hazmat.primitives.asymmetric import padding, utils
+
+from ._common import _hash_algorithm
+
+
+class _PSSVerifier:
+    def __init__(self, key, salt_bytes=None):
+        self._key = key
+        self._salt_bytes = salt_bytes
+
+    def verify(self, hash_obj, signature):
+        try:
+            self._key.public_key.verify(
+                signature,
+                hash_obj.digest(),
+                padding.PSS(
+                    mgf=padding.MGF1(_hash_algorithm(hash_obj)),
+                    salt_length=self._salt_bytes if self._salt_bytes is not None else hash_obj.digest_size,
+                ),
+                utils.Prehashed(_hash_algorithm(hash_obj)),
+            )
+        except InvalidSignature as exc:
+            raise ValueError("Signature could not be verified") from exc
+
+
+def new(key, salt_bytes=None):
+    return _PSSVerifier(key, salt_bytes=salt_bytes)
