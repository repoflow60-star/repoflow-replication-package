+++ b/Crypto/PublicKey/ECC.py
@@ -0,0 +1,28 @@
+from cryptography.hazmat.primitives import serialization
+from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey
+from cryptography.hazmat.primitives.asymmetric.ec import EllipticCurvePublicKey
+
+
+class EccKey:
+    def __init__(self, public_key):
+        self._public_key = public_key
+
+    @property
+    def curve(self):
+        if isinstance(self._public_key, EllipticCurvePublicKey):
+            return self._public_key.curve.name
+        return "Ed25519"
+
+    @property
+    def public_key(self):
+        return self._public_key
+
+
+def import_key(key_data: bytes) -> EccKey:
+    public_key = serialization.load_der_public_key(key_data)
+    if not isinstance(public_key, (EllipticCurvePublicKey, Ed25519PublicKey)):
+        public_key = serialization.load_pem_public_key(key_data)
+    if not isinstance(public_key, (EllipticCurvePublicKey, Ed25519PublicKey)):
+        raise ValueError("Not an ECC public key")
+    return EccKey(public_key)
+
