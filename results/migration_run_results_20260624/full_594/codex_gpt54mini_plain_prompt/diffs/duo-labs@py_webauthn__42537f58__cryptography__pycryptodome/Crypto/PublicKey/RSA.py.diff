diff --git /dev/null b/Crypto/PublicKey/RSA.py
new file mode 100644
index 0000000..282306f
--- /dev/null
+++ b/Crypto/PublicKey/RSA.py
@@ -0,0 +1,25 @@
+from cryptography.hazmat.primitives import serialization
+from cryptography.hazmat.primitives.asymmetric.rsa import RSAPublicKey
+
+
+class RsaKey:
+    def __init__(self, public_key: RSAPublicKey):
+        self._public_key = public_key
+
+    @property
+    def key_size(self) -> int:
+        return self._public_key.key_size
+
+    @property
+    def public_key(self) -> RSAPublicKey:
+        return self._public_key
+
+
+def import_key(key_data: bytes) -> RsaKey:
+    public_key = serialization.load_der_public_key(key_data)
+    if not isinstance(public_key, RSAPublicKey):
+        public_key = serialization.load_pem_public_key(key_data)
+    if not isinstance(public_key, RSAPublicKey):
+        raise ValueError("Not an RSA public key")
+    return RsaKey(public_key)
+
