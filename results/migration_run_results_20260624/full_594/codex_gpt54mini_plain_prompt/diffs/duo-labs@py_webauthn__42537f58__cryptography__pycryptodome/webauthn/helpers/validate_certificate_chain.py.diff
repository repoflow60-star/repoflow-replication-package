+def _import_public_key(cert: x509.Certificate):
+    public_key_der = certificate_public_key_info(cert).dump()
+    try:
+        return RSA.import_key(public_key_der)
+    except (ValueError, IndexError, TypeError):
+        return ECC.import_key(public_key_der)
+
+
+def _verify_certificate_signature(cert: x509.Certificate, issuer: x509.Certificate) -> None:
+    signature_algorithm = certificate_signature_algorithm(cert)
+    signature = certificate_signature_bytes(cert)
+    tbs_certificate = certificate_tbs_bytes(cert)
+    issuer_public_key = _import_public_key(issuer)
+
+    if signature_algorithm == "sha1_rsa":
+        pkcs1_15.new(issuer_public_key).verify(SHA1.new(data=tbs_certificate), signature)
+    elif signature_algorithm == "sha256_rsa":
+        pkcs1_15.new(issuer_public_key).verify(SHA256.new(data=tbs_certificate), signature)
+    elif signature_algorithm == "sha384_rsa":
+        pkcs1_15.new(issuer_public_key).verify(SHA384.new(data=tbs_certificate), signature)
+    elif signature_algorithm == "sha512_rsa":
+        pkcs1_15.new(issuer_public_key).verify(SHA512.new(data=tbs_certificate), signature)
+    elif signature_algorithm == "sha256_ecdsa":
+        DSS.new(issuer_public_key, "fips-186-3", encoding="der").verify(
+            SHA256.new(data=tbs_certificate),
+            signature,
+        )
+    elif signature_algorithm == "sha384_ecdsa":
+        DSS.new(issuer_public_key, "fips-186-3", encoding="der").verify(
+            SHA384.new(data=tbs_certificate),
+            signature,
+        )
+    elif signature_algorithm == "sha512_ecdsa":
+        DSS.new(issuer_public_key, "fips-186-3", encoding="der").verify(
+            SHA512.new(data=tbs_certificate),
+            signature,
+        )
+    elif signature_algorithm == "ed25519":
+        eddsa.new(issuer_public_key, mode="rfc8032").verify(tbs_certificate, signature)
+    else:
+        raise InvalidCertificateChain(f"Unsupported certificate signature algorithm {signature_algorithm}")
 
 
