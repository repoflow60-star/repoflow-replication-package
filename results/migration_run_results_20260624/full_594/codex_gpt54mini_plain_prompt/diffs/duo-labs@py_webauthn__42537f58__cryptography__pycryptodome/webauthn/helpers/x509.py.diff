diff --git /dev/null b/webauthn/helpers/x509.py
new file mode 100644
index 0000000..f88d9e7
--- /dev/null
+++ b/webauthn/helpers/x509.py
@@ -0,0 +1,65 @@
+from typing import Optional
+
+from asn1crypto import pem, x509
+from Crypto.PublicKey import ECC, RSA
+
+
+def load_der_x509_certificate(cert: bytes) -> x509.Certificate:
+    return x509.Certificate.load(cert)
+
+
+def load_pem_x509_certificate(cert: bytes) -> x509.Certificate:
+    _, _, der_bytes = pem.unarmor(cert)
+    return x509.Certificate.load(der_bytes)
+
+
+def certificate_public_key_info(cert: x509.Certificate) -> x509.PublicKeyInfo:
+    return cert.public_key
+
+
+def certificate_public_key(cert: x509.Certificate):
+    public_key_der = certificate_public_key_info(cert).dump()
+    try:
+        return RSA.import_key(public_key_der)
+    except (ValueError, IndexError, TypeError):
+        return ECC.import_key(public_key_der)
+
+
+def certificate_subject_common_name(cert: x509.Certificate) -> Optional[str]:
+    return cert.subject.native.get("common_name")
+
+
+def certificate_extension_value(cert: x509.Certificate, oid: str):
+    extensions = cert["tbs_certificate"]["extensions"]
+    if extensions.native is None:
+        raise KeyError(oid)
+
+    for extension in extensions:
+        if extension["extn_id"].dotted == oid:
+            return extension["extn_value"].native
+
+    raise KeyError(oid)
+
+
+def certificate_signature_algorithm(cert: x509.Certificate) -> str:
+    return cert["signature_algorithm"]["algorithm"].native
+
+
+def certificate_tbs_bytes(cert: x509.Certificate) -> bytes:
+    return cert["tbs_certificate"].dump()
+
+
+def certificate_signature_bytes(cert: x509.Certificate) -> bytes:
+    return cert["signature_value"].native
+
+
+def certificate_subject_native(cert: x509.Certificate):
+    return cert.subject.native
+
+
+def certificate_issuer_native(cert: x509.Certificate):
+    return cert.issuer.native
+
+
+def certificate_public_key_native(cert: x509.Certificate):
+    return cert.public_key.native
