+"""Shared helpers for running treq requests synchronously."""
+
+import asyncio
+from contextlib import suppress
+
+from twisted.internet import asyncioreactor
+
+_HTTP_LOOP = asyncio.new_event_loop()
+asyncio.set_event_loop(_HTTP_LOOP)
+with suppress(Exception):
+    asyncioreactor.install(_HTTP_LOOP)
+
+
+def run(coro):
+    if _HTTP_LOOP.is_running():
+        return asyncio.run_coroutine_threadsafe(coro, _HTTP_LOOP).result()
+    return _HTTP_LOOP.run_until_complete(coro)
