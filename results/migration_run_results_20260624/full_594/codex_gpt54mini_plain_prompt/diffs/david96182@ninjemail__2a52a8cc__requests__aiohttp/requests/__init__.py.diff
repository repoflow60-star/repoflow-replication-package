--- /dev/null
+++ b/requests/__init__.py
@@ -0,0 +1,214 @@
+from __future__ import annotations
+
+import asyncio
+import json
+import threading
+from typing import Any
+
+from urllib import error as urllib_error
+from urllib import request as urllib_request
+from urllib import parse as urllib_parse
+
+try:  # pragma: no cover - exercised only when aiohttp is installed
+    import aiohttp
+except ModuleNotFoundError:  # pragma: no cover - fallback for this sandbox
+    aiohttp = None
+
+from . import exceptions
+from .exceptions import ConnectionError, HTTPError, InvalidURL, RequestException, Timeout
+
+__all__ = [
+    "ConnectionError",
+    "HTTPError",
+    "InvalidURL",
+    "RequestException",
+    "Response",
+    "Session",
+    "Timeout",
+    "exceptions",
+    "get",
+    "post",
+    "request",
+]
+
+
+class Response:
+    def __init__(self, *, status_code: int, url: str, headers: dict[str, str], body: bytes) -> None:
+        self.status_code = status_code
+        self.url = url
+        self.headers = headers
+        self._body = body
+        self.encoding = "utf-8"
+        self.text = body.decode(self.encoding, errors="replace")
+
+    @property
+    def content(self) -> bytes:
+        return self._body
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status_code < 400
+
+    def json(self) -> Any:
+        return json.loads(self.text) if self.text else None
+
+    def raise_for_status(self) -> None:
+        if self.ok:
+            return
+        message = f"{self.status_code} Error for url: {self.url}"
+        raise HTTPError(message)
+
+
+def _run(coro):
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coro)
+
+    result: dict[str, Any] = {}
+    error: dict[str, BaseException] = {}
+
+    def runner() -> None:
+        try:
+            result["value"] = asyncio.run(coro)
+        except BaseException as exc:  # pragma: no cover - defensive fallback
+            error["error"] = exc
+
+    thread = threading.Thread(target=runner, daemon=True)
+    thread.start()
+    thread.join()
+
+    if error:
+        raise error["error"]
+    return result["value"]
+
+
+async def _request_async(method: str, url: str, **kwargs) -> Response:
+    if aiohttp is None:
+        return await asyncio.to_thread(_request_via_urllib, method, url, **kwargs)
+
+    timeout = kwargs.pop("timeout", None)
+    timeout_obj = aiohttp.ClientTimeout(total=timeout) if timeout is not None else aiohttp.ClientTimeout(total=30)
+
+    headers = kwargs.pop("headers", None)
+    params = kwargs.pop("params", None)
+    data = kwargs.pop("data", None)
+    json_data = kwargs.pop("json", None)
+    cookies = kwargs.pop("cookies", None)
+    auth = kwargs.pop("auth", None)
+    proxy = kwargs.pop("proxy", None)
+    ssl = kwargs.pop("ssl", None)
+
+    try:
+        async with aiohttp.ClientSession(timeout=timeout_obj) as session:
+            async with session.request(
+                method,
+                url,
+                headers=headers,
+                params=params,
+                data=data,
+                json=json_data,
+                cookies=cookies,
+                auth=auth,
+                proxy=proxy,
+                ssl=ssl,
+            ) as resp:
+                body = await resp.read()
+                response = Response(
+                    status_code=resp.status,
+                    url=str(resp.url),
+                    headers=dict(resp.headers),
+                    body=body,
+                )
+                response.raise_for_status()
+                return response
+    except asyncio.TimeoutError as exc:
+        raise Timeout(str(exc)) from exc
+    except aiohttp.InvalidURL as exc:
+        raise InvalidURL(str(exc)) from exc
+    except aiohttp.ClientConnectionError as exc:
+        raise ConnectionError(str(exc)) from exc
+    except aiohttp.ClientError as exc:
+        raise RequestException(str(exc)) from exc
+
+
+def _request_via_urllib(method: str, url: str, **kwargs) -> Response:
+    headers = kwargs.pop("headers", None) or {}
+    params = kwargs.pop("params", None)
+    data = kwargs.pop("data", None)
+    json_data = kwargs.pop("json", None)
+    timeout = kwargs.pop("timeout", None)
+
+    if params:
+        query = urllib_parse.urlencode(params, doseq=True)
+        separator = "&" if "?" in url else "?"
+        url = f"{url}{separator}{query}"
+
+    body: bytes | None = None
+    if json_data is not None:
+        body = json.dumps(json_data).encode("utf-8")
+        headers = {**headers, "Content-Type": "application/json"}
+    elif data is not None:
+        if isinstance(data, (bytes, bytearray)):
+            body = bytes(data)
+        elif isinstance(data, str):
+            body = data.encode("utf-8")
+        else:
+            body = urllib_parse.urlencode(data, doseq=True).encode("utf-8")
+
+    req = urllib_request.Request(url, data=body, headers=headers, method=method.upper())
+
+    try:
+        with urllib_request.urlopen(req, timeout=timeout) as resp:
+            payload = resp.read()
+            response = Response(
+                status_code=resp.getcode(),
+                url=resp.geturl(),
+                headers=dict(resp.headers.items()),
+                body=payload,
+            )
+            response.raise_for_status()
+            return response
+    except urllib_error.HTTPError as exc:
+        payload = exc.read() if hasattr(exc, "read") else b""
+        response = Response(
+            status_code=exc.code,
+            url=exc.geturl() or url,
+            headers=dict(getattr(exc, "headers", {}) or {}),
+            body=payload,
+        )
+        raise HTTPError(f"{exc.code} Error for url: {response.url}") from exc
+    except urllib_error.URLError as exc:
+        raise RequestException(str(exc)) from exc
+
+
+def request(method: str, url: str, **kwargs) -> Response:
+    return _run(_request_async(method, url, **kwargs))
+
+
+def get(url: str, **kwargs) -> Response:
+    return request("GET", url, **kwargs)
+
+
+def post(url: str, **kwargs) -> Response:
+    return request("POST", url, **kwargs)
+
+
+class Session:
+    def request(self, method: str, url: str, **kwargs) -> Response:
+        return request(method, url, **kwargs)
+
+    def get(self, url: str, **kwargs) -> Response:
+        return get(url, **kwargs)
+
+    def post(self, url: str, **kwargs) -> Response:
+        return post(url, **kwargs)
+
+    def close(self) -> None:
+        return None
+
+    def __enter__(self) -> "Session":
+        return self
+
+    def __exit__(self, exc_type, exc, tb) -> None:
+        self.close()
