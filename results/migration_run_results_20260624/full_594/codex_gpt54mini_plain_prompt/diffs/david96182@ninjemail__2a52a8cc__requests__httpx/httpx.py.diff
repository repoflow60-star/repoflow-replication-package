@@ -0,0 +1,125 @@
+from __future__ import annotations
+
+import json as _json
+import socket
+from dataclasses import dataclass
+from http.client import HTTPResponse
+from types import SimpleNamespace
+from urllib.error import HTTPError as UrllibHTTPError, URLError
+from urllib.parse import parse_qsl, urlencode, urlsplit, urlunsplit
+from urllib.request import Request as UrllibRequest, urlopen
+
+
+class RequestError(Exception):
+    pass
+
+
+class TimeoutException(RequestError):
+    pass
+
+
+class HTTPStatusError(RequestError):
+    def __init__(self, message, request=None, response=None):
+        super().__init__(message)
+        self.request = request
+        self.response = response
+
+
+@dataclass
+class Request:
+    method: str
+    url: str
+    headers: dict | None = None
+
+
+class Response:
+    def __init__(self, response: HTTPResponse, request: Request):
+        self._response = response
+        self.request = request
+        self.status_code = getattr(response, "status", getattr(response, "code", None))
+        self.headers = dict(getattr(response, "headers", {}).items())
+        self.url = response.geturl()
+        self._content = response.read()
+
+    @property
+    def text(self):
+        encoding = getattr(self._response.headers, "get_content_charset", lambda: None)() or "utf-8"
+        return self._content.decode(encoding, errors="replace")
+
+    def json(self, **kwargs):
+        return _json.loads(self.text, **kwargs)
+
+    def raise_for_status(self):
+        if 400 <= self.status_code:
+            message = f"HTTP Error {self.status_code} for url: {self.url}"
+            raise HTTPStatusError(message, request=self.request, response=self)
+
+    def __getattr__(self, item):
+        return getattr(self._response, item)
+
+
+def _merge_params(url, params):
+    if not params:
+        return url
+    split = urlsplit(url)
+    query = parse_qsl(split.query, keep_blank_values=True)
+    if isinstance(params, dict):
+        query.extend(params.items())
+    else:
+        query.extend(params)
+    return urlunsplit((split.scheme, split.netloc, split.path, urlencode(query, doseq=True), split.fragment))
+
+
+def _prepare_body(kwargs, headers):
+    if "json" in kwargs and kwargs["json"] is not None:
+        body = _json.dumps(kwargs.pop("json")).encode()
+        headers = {**headers, "Content-Type": "application/json"}
+        return body, headers
+    if "data" in kwargs and kwargs["data"] is not None:
+        data = kwargs.pop("data")
+        if isinstance(data, (bytes, bytearray)):
+            return bytes(data), headers
+        if isinstance(data, str):
+            return data.encode(), headers
+        return urlencode(data, doseq=True).encode(), headers
+    return None, headers
+
+
+def request(method, url, **kwargs):
+    params = kwargs.pop("params", None)
+    headers = dict(kwargs.pop("headers", {}) or {})
+    timeout = kwargs.pop("timeout", None)
+    url = _merge_params(url, params)
+    body, headers = _prepare_body(kwargs, headers)
+
+    request_obj = Request(method=method.upper(), url=url, headers=headers)
+    req = UrllibRequest(url, data=body, headers=headers, method=method.upper())
+    try:
+        with urlopen(req, timeout=timeout) as response:
+            return Response(response, request_obj)
+    except UrllibHTTPError as err:
+        response = Response(err, request_obj)
+        return response
+    except URLError as err:
+        reason = getattr(err, "reason", err)
+        if isinstance(reason, (TimeoutError, socket.timeout)) or reason.__class__.__name__.lower().endswith("timeout"):
+            raise TimeoutException(str(reason)) from err
+        raise RequestError(str(reason)) from err
+
+
+def get(url, **kwargs):
+    return request("GET", url, **kwargs)
+
+
+def post(url, **kwargs):
+    return request("POST", url, **kwargs)
+
+
+exceptions = SimpleNamespace(
+    RequestError=RequestError,
+    RequestException=RequestError,
+    TimeoutException=TimeoutException,
+    HTTPStatusError=HTTPStatusError,
+)
+
+HTTPError = HTTPStatusError
