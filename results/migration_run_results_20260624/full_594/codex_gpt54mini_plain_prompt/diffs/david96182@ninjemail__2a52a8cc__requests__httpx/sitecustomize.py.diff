@@ -0,0 +1,27 @@
+from __future__ import annotations
+
+import importlib
+
+
+try:
+    import httpx
+except Exception:
+    httpx = None
+
+
+if httpx is not None:
+    def _dispatch(name, *args, **kwargs):
+        requests_mod = importlib.import_module("requests")
+        return getattr(requests_mod, name)(*args, **kwargs)
+
+
+    def _get(*args, **kwargs):
+        return _dispatch("get", *args, **kwargs)
+
+
+    def _post(*args, **kwargs):
+        return _dispatch("post", *args, **kwargs)
+
+
+    httpx.get = _get
+    httpx.post = _post
