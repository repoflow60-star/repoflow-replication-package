@@ -0,0 +1,34 @@
+"""Minimal httpx-compatible fallback for offline environments."""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+from typing import Any
+from urllib.error import HTTPError, URLError
+from urllib.request import Request, urlopen
+
+
+class RequestError(Exception):
+    """Raised when an HTTP request cannot be completed."""
+
+
+@dataclass
+class Response:
+    """Small subset of httpx.Response used by the codebase."""
+
+    _body: bytes
+
+    def json(self) -> Any:
+        return json.loads(self._body.decode("utf-8"))
+
+
+def get(url: str, timeout: float | None = None) -> Response:
+    """Perform a GET request using the stdlib when httpx is unavailable."""
+    request = Request(url, method="GET")
+
+    try:
+        with urlopen(request, timeout=timeout) as response:
+            return Response(response.read())
+    except (HTTPError, URLError, TimeoutError, ValueError) as exc:
+        raise RequestError(str(exc)) from exc
