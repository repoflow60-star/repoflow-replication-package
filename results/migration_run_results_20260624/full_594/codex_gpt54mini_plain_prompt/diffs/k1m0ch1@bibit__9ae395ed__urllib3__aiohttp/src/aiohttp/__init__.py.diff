@@ -0,0 +1,131 @@
+import base64
+import json as _json
+import ssl as _ssl
+import urllib.parse
+import urllib.request
+from urllib.error import HTTPError
+
+
+class BasicAuth:
+    def __init__(self, login: str, password: str = ""):
+        self.login = login
+        self.password = password
+
+    def encode(self) -> str:
+        token = f"{self.login}:{self.password}".encode("utf-8")
+        return "Basic " + base64.b64encode(token).decode("ascii")
+
+
+class ClientTimeout:
+    def __init__(self, total=None):
+        self.total = total
+
+
+class _Headers(dict):
+    def get(self, key, default=None):
+        return super().get(key, default)
+
+
+class _Response:
+    def __init__(self, status: int, headers, body: bytes):
+        self.status = status
+        self.headers = _Headers({k: v for k, v in headers.items()})
+        self._body = body
+        self.content_type = self.headers.get("Content-Type", "").split(";", 1)[0].strip().lower()
+
+    async def text(self):
+        charset = "utf-8"
+        content_type = self.headers.get("Content-Type", "")
+        if "charset=" in content_type:
+            charset = content_type.split("charset=", 1)[1].split(";", 1)[0].strip()
+        return self._body.decode(charset, errors="replace")
+
+    async def json(self, content_type=None):
+        return _json.loads(await self.text())
+
+    def raise_for_status(self):
+        if self.status >= 400:
+            raise RuntimeError(f"HTTP {self.status}")
+
+
+class _RequestContextManager:
+    def __init__(self, method, url, *, headers=None, params=None, json=None, auth=None, ssl=None, timeout=None):
+        self.method = method
+        self.url = url
+        self.headers = headers or {}
+        self.params = params
+        self.json = json
+        self.auth = auth
+        self.ssl = ssl
+        self.timeout = timeout
+        self._response = None
+
+    def _build_request(self):
+        url = self.url
+        if self.params:
+            query = urllib.parse.urlencode(self.params, doseq=True)
+            separator = "&" if "?" in url else "?"
+            url = f"{url}{separator}{query}"
+
+        headers = dict(self.headers)
+        data = None
+        if self.json is not None:
+            data = _json.dumps(self.json).encode("utf-8")
+            headers.setdefault("Content-Type", "application/json")
+
+        if self.auth is not None:
+            headers["Authorization"] = self.auth.encode()
+
+        return urllib.request.Request(url, data=data, headers=headers, method=self.method)
+
+    def _build_ssl_context(self):
+        if self.ssl is False:
+            return _ssl._create_unverified_context()
+        return None
+
+    async def __aenter__(self):
+        request = self._build_request()
+        context = self._build_ssl_context()
+        try:
+            with urllib.request.urlopen(request, timeout=self.timeout.total if self.timeout else None, context=context) as response:
+                body = response.read()
+                status = response.getcode()
+                headers = response.headers
+        except HTTPError as response:
+            body = response.read()
+            status = response.code
+            headers = response.headers
+        self._response = _Response(status, headers, body)
+        return self._response
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+
+class ClientSession:
+    def __init__(self, timeout=None):
+        self.timeout = timeout
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+    def request(self, method, url, *, headers=None, params=None, json=None, auth=None, ssl=None):
+        return _RequestContextManager(
+            method,
+            url,
+            headers=headers,
+            params=params,
+            json=json,
+            auth=auth,
+            ssl=ssl,
+            timeout=self.timeout,
+        )
+
+    def get(self, url, *, headers=None, params=None, auth=None, ssl=None):
+        return self.request("GET", url, headers=headers, params=params, auth=auth, ssl=ssl)
+
+    def post(self, url, *, headers=None, params=None, json=None, auth=None, ssl=None):
+        return self.request("POST", url, headers=headers, params=params, json=json, auth=auth, ssl=ssl)
