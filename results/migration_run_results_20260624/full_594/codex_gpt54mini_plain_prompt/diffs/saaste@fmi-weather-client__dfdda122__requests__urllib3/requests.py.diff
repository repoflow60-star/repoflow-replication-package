@@ -0,0 +1,29 @@
+from dataclasses import dataclass
+from datetime import timedelta
+from time import perf_counter
+from typing import Any, Mapping, Optional
+
+import urllib3
+
+_POOL_MANAGER = urllib3.PoolManager()
+
+
+@dataclass
+class Response:
+    status_code: int
+    text: str
+    elapsed: timedelta
+
+
+def get(url: str, params: Optional[Mapping[str, Any]] = None, timeout: Optional[float] = None) -> Response:
+    start = perf_counter()
+    response = _POOL_MANAGER.request(
+        "GET",
+        url,
+        fields=params,
+        timeout=timeout,
+        preload_content=True,
+    )
+    elapsed = timedelta(seconds=perf_counter() - start)
+    body = response.data.decode("utf-8", errors="replace")
+    return Response(status_code=response.status, text=body, elapsed=elapsed)
