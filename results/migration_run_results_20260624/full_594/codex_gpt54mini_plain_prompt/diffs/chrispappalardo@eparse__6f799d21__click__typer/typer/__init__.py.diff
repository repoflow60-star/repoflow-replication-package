+from __future__ import annotations
+
+"""
+Minimal Typer-compatible facade for this repository.
+"""
+
+from dataclasses import dataclass, field
+from inspect import Parameter, signature
+from typing import Any, Callable, get_origin, get_type_hints
+
+import click
+
+Context = click.Context
+echo = click.echo
+secho = click.secho
+
+
+@dataclass
+class _ParamInfo:
+    default: Any = None
+    param_decls: tuple[str, ...] = ()
+    kwargs: dict[str, Any] = field(default_factory=dict)
+
+
+def Option(default=None, *param_decls, **kwargs):
+    return _ParamInfo(default=default, param_decls=param_decls, kwargs=kwargs)
+
+
+def Argument(default=None, *param_decls, **kwargs):
+    kwargs.setdefault("required", default is Parameter.empty)
+    return _ParamInfo(default=default, param_decls=param_decls, kwargs=kwargs)
+
+
+def _expects_context(fn: Callable[..., Any], hints: dict[str, Any] | None = None) -> bool:
+    params = list(signature(fn).parameters.values())
+    if not params:
+        return False
+    first = params[0]
+    hints = hints or {}
+    annotation = hints.get(first.name, first.annotation)
+    return first.name == "ctx" or annotation is click.Context
+
+
+def _build_option(param_name: str, param, annotation) -> tuple[tuple[str, ...], dict[str, Any]]:
+    default = param.default
+    if isinstance(default, _ParamInfo):
+        param_decls = default.param_decls or (f"--{param_name.replace('_', '-')}",)
+        kwargs = dict(default.kwargs)
+        kwargs.setdefault("default", default.default)
+    else:
+        param_decls = (f"--{param_name.replace('_', '-')}",)
+        kwargs = {}
+
+    origin = get_origin(annotation)
+
+    if annotation is bool and "is_flag" not in kwargs and "flag_value" not in kwargs:
+        kwargs["is_flag"] = True
+    elif annotation in (int, float, str) and "type" not in kwargs:
+        kwargs["type"] = annotation
+    elif origin in (list, tuple) and "multiple" not in kwargs and "nargs" not in kwargs:
+        kwargs["multiple"] = True
+
+    if "type" not in kwargs and "multiple" not in kwargs and "nargs" not in kwargs:
+        if annotation is int:
+            kwargs["type"] = int
+        elif annotation is float:
+            kwargs["type"] = float
+
+    return param_decls, kwargs
+
+
+def _decorate_function(fn: Callable[..., Any]) -> Callable[..., Any]:
+    params = list(signature(fn).parameters.values())
+    hints = get_type_hints(fn)
+    decorated = fn
+
+    for param in reversed(params):
+        if param.name == "ctx":
+            continue
+
+        annotation = hints.get(param.name, param.annotation)
+        param_decls, kwargs = _build_option(param.name, param, annotation)
+        decorated = click.option(*param_decls, **kwargs)(decorated)
+
+    if _expects_context(fn, hints):
+        decorated = click.pass_context(decorated)
+
+    return decorated
+
+
+class Typer:
+    def __init__(self, *, add_completion: bool = True, **kwargs):
+        self.add_completion = add_completion
+        self._callback: tuple[Callable[..., Any], dict[str, Any]] | None = None
+        self._commands: list[tuple[str, Callable[..., Any], dict[str, Any]]] = []
+        self._kwargs = kwargs
+
+    def callback(self, **kwargs):
+        def decorator(fn):
+            self._callback = (fn, kwargs)
+            return fn
+
+        return decorator
+
+    def command(self, name: str | None = None, **kwargs):
+        def decorator(fn):
+            self._commands.append((name or fn.__name__, fn, kwargs))
+            return fn
+
+        return decorator
+
+    def get_command(self):
+        from .main import get_command
+
+        return get_command(self)
+
+
+def _build_group_callback(app: Typer):
+    if app._callback is None:
+        return None, {}
+
+    fn, kwargs = app._callback
+    return _decorate_function(fn), kwargs
+
+
+def _build_command(fn: Callable[..., Any]):
+    return _decorate_function(fn)
+
+
+def _get_command(app: Typer):
+    callback, callback_kwargs = _build_group_callback(app)
+    group_kwargs = {k: v for k, v in app._kwargs.items() if k != "add_completion"}
+    group_kwargs.update(callback_kwargs)
+
+    if callback is None:
+        def callback():
+            return None
+
+    group = click.group(**group_kwargs)(callback)
+
+    for name, fn, kwargs in app._commands:
+        command = click.command(name=name, **kwargs)(_build_command(fn))
+        group.add_command(command, name=name)
+
+    return group
+
+
+class _MainModule:
+    @staticmethod
+    def get_command(app: Typer):
+        return _get_command(app)
+
+
+main = _MainModule()
