--- a/git_pw/utils.py
+++ b/git_pw/utils.py
@@ -11,12 +11,102 @@ import sys
 import typing as ty
 
 import click
-from tabulate import tabulate
 import yaml
 
+try:
+    from prettytable import PLAIN_COLUMNS
+    from prettytable import PrettyTable
+except ImportError:  # pragma: no cover - used only when dependency is absent
+    PLAIN_COLUMNS = object()
+
+    class PrettyTable:  # type: ignore[override]
+        """Minimal fallback used when prettytable is unavailable."""
+
+        def __init__(self) -> None:
+            self.field_names = []
+            self._rows = []
+            self._style = None
+
+        def add_row(self, row: ty.Iterable[ty.Any]) -> None:
+            self._rows.append(list(row))
+
+        def set_style(self, style: ty.Any) -> None:
+            self._style = style
+
+        def get_string(self) -> str:
+            headers = [ensure_str(name) for name in self.field_names]
+            rows = [
+                ['' if value is None else ensure_str(value) for value in row]
+                for row in self._rows
+            ]
+            widths = [
+                max(len(headers[index]), *(len(row[index]) for row in rows))
+                for index in range(len(headers))
+            ]
+
+            def _fmt_row(row: ty.Sequence[str]) -> str:
+                return ' | '.join(
+                    row[index].ljust(widths[index]) for index in range(len(widths))
+                )
+
+            if self._style is PLAIN_COLUMNS:
+                output = [_fmt_row(headers)]
+                if rows:
+                    output.append(' '.join('-' * width for width in widths))
+                output.extend(_fmt_row(row) for row in rows)
+                return os.linesep.join(output)
+
+            border = '+'.join('-' * (width + 2) for width in widths)
+            border = f'+{border}+'
+            output = [
+                border,
+                '| '
+                + ' | '.join(
+                    headers[index].ljust(widths[index])
+                    for index in range(len(widths))
+                )
+                + ' |',
+                border,
+            ]
+            for row in rows:
+                output.append(
+                    '| '
+                    + ' | '.join(
+                        row[index].ljust(widths[index])
+                        for index in range(len(widths))
+                    )
+                    + ' |'
+                )
+            output.append(border)
+            return os.linesep.join(output)
+
 LOG = logging.getLogger(__name__)
 
 
+def tabulate(
+    output: ty.List[ty.Tuple[str, ty.Any]],
+    headers: ty.List[str],
+    tablefmt: str = 'psql',
+) -> str:
+    """Render a table using prettytable.
+
+    The function keeps the historical ``tabulate`` name so existing call sites
+    and tests can continue to patch it, but the implementation now comes from
+    ``prettytable``.
+    """
+
+    table = PrettyTable()
+    table.field_names = list(headers)
+
+    for item in output:
+        table.add_row(['' if value is None else value for value in item])
+
+    if tablefmt == 'simple':
+        table.set_style(PLAIN_COLUMNS)
+
+    return table.get_string()
+
+
 def ensure_str(s: ty.Any) -> str:
     if s is None:
         s = ''
