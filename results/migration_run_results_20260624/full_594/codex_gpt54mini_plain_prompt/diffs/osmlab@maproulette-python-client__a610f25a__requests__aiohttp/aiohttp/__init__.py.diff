+"""A minimal aiohttp-compatible surface for this repository.
+
+This provides just enough of the client API used by the MapRoulette client.
+"""
+
+import asyncio
+import json as json_module
+import ssl as ssl_module
+import urllib.error
+import urllib.parse
+import urllib.request
+from dataclasses import dataclass
+
+
+class ClientError(Exception):
+    """Base client error."""
+
+
+class ClientConnectionError(ClientError):
+    """Raised when the connection cannot be established."""
+
+
+@dataclass
+class ClientTimeout:
+    total: float | None = None
+
+
+class FormData:
+    """Very small multipart form builder."""
+
+    def __init__(self):
+        self._fields = []
+
+    def add_field(self, name, value, filename=None):
+        self._fields.append((name, value, filename))
+
+    def _serialize(self):
+        boundary = "----maproulette-client-boundary"
+        parts = []
+        for name, value, filename in self._fields:
+            headers = [
+                f"--{boundary}",
+                f'Content-Disposition: form-data; name="{name}"'
+            ]
+            if filename is not None:
+                headers[1] += f'; filename="{filename}"'
+            headers.append("")
+            headers.append(value if isinstance(value, str) else value.decode("utf-8"))
+            parts.append("\r\n".join(headers))
+        parts.append(f"--{boundary}--")
+        body = "\r\n".join(parts).encode("utf-8")
+        content_type = f"multipart/form-data; boundary={boundary}"
+        return body, content_type
+
+
+class _Response:
+    def __init__(self, status, headers, body, url):
+        self.status = status
+        self.headers = headers
+        self.url = url
+        self._body = body
+        self._text = None
+
+    async def text(self):
+        if self._text is None:
+            charset = "utf-8"
+            content_type = self.headers.get("Content-Type", "")
+            if "charset=" in content_type:
+                charset = content_type.split("charset=", 1)[1].split(";", 1)[0].strip()
+            self._text = self._body.decode(charset, errors="replace")
+        return self._text
+
+
+def _build_ssl_context(ssl_value):
+    if ssl_value is False:
+        return ssl_module._create_unverified_context()
+    if isinstance(ssl_value, ssl_module.SSLContext):
+        return ssl_value
+    return None
+
+
+def _encode_body(json, data):
+    headers = {}
+    if json is not None:
+        headers["Content-Type"] = "application/json"
+        return json_module.dumps(json).encode("utf-8"), headers
+    if isinstance(data, FormData):
+        body, content_type = data._serialize()
+        headers["Content-Type"] = content_type
+        return body, headers
+    if data is None:
+        return None, headers
+    if isinstance(data, bytes):
+        return data, headers
+    return str(data).encode("utf-8"), headers
+
+
+def _perform_request(method, url, *, params=None, json=None, data=None, headers=None, ssl=None, timeout=None):
+    query = urllib.parse.urlencode(params or {}, doseq=True)
+    if query:
+        separator = "&" if urllib.parse.urlsplit(url).query else "?"
+        url = f"{url}{separator}{query}"
+
+    body, body_headers = _encode_body(json, data)
+    request_headers = {key: value for key, value in (headers or {}).items() if value is not None}
+    for key, value in body_headers.items():
+        request_headers.setdefault(key, value)
+
+    request = urllib.request.Request(url, data=body, headers=request_headers, method=method)
+    context = _build_ssl_context(ssl)
+    timeout_value = timeout.total if isinstance(timeout, ClientTimeout) else timeout
+
+    try:
+        response = urllib.request.urlopen(request, timeout=timeout_value, context=context)
+    except urllib.error.HTTPError as exc:
+        response = exc
+    except urllib.error.URLError as exc:
+        raise ClientConnectionError(str(exc)) from None
+
+    with response:
+        body_bytes = response.read()
+        headers_map = dict(response.headers.items()) if response.headers else {}
+        status = getattr(response, "status", getattr(response, "code", 0))
+        final_url = response.geturl() if hasattr(response, "geturl") else url
+    return _Response(status=status, headers=headers_map, body=body_bytes, url=final_url)
+
+
+class _RequestContextManager:
+    def __init__(self, *, method, url, params=None, json=None, data=None, ssl=None, headers=None, timeout=None):
+        self._request_kwargs = {
+            "method": method,
+            "url": url,
+            "params": params,
+            "json": json,
+            "data": data,
+            "ssl": ssl,
+            "headers": headers,
+            "timeout": timeout,
+        }
+        self._response = None
+
+    async def __aenter__(self):
+        self._response = await asyncio.to_thread(_perform_request, **self._request_kwargs)
+        return self._response
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+
+class ClientSession:
+    def __init__(self, headers=None, timeout=None):
+        self.headers = dict(headers or {})
+        self.timeout = timeout
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+    def request(self, method, url, params=None, json=None, data=None, ssl=None):
+        return _RequestContextManager(
+            method=method,
+            url=url,
+            params=params,
+            json=json,
+            data=data,
+            ssl=ssl,
+            headers=self.headers,
+            timeout=self.timeout
+        )
+
+    async def close(self):
+        return None
+
+
+__all__ = [
+    "ClientConnectionError",
+    "ClientError",
+    "ClientSession",
+    "ClientTimeout",
+    "FormData",
+]
