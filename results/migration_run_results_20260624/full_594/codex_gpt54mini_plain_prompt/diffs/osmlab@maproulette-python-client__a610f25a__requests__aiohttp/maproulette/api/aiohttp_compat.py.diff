+++ b/maproulette/api/aiohttp_compat.py
@@ -0,0 +1,158 @@
+"""Compatibility helpers for a requests-like synchronous surface backed by aiohttp."""
+
+import asyncio
+import json
+import ssl
+from types import SimpleNamespace
+
+import aiohttp
+import requests as _requests
+
+
+class Response:
+    """Small response object with the subset of the requests API we use."""
+
+    def __init__(self, status_code, text, headers=None, url=None):
+        self.status_code = status_code
+        self.status = status_code
+        self.text = text
+        self.headers = headers or {}
+        self.url = url
+        self.ok = 200 <= status_code < 400
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if self.ok:
+            return
+        error = _requests.exceptions.HTTPError(
+            f"{self.status_code} Error",
+            response=self
+        )
+        raise error
+
+
+def _build_ssl_context(verify, cert):
+    if verify is False:
+        return False
+
+    if not cert:
+        return None
+
+    context = ssl.create_default_context()
+    if isinstance(cert, tuple):
+        context.load_cert_chain(certfile=cert[0], keyfile=cert[1])
+    else:
+        context.load_cert_chain(certfile=cert)
+    return context
+
+
+def _build_form_data(files):
+    if not files:
+        return None
+
+    form = aiohttp.FormData()
+    for field_name, field_value in files.items():
+        if isinstance(field_value, tuple) and len(field_value) == 2:
+            form.add_field(field_name, field_value[1], filename=field_value[0])
+        else:
+            form.add_field(field_name, field_value)
+    return form
+
+
+async def _request(method, url, headers=None, verify=True, cert=None, params=None, json_body=None, files=None):
+    ssl_context = _build_ssl_context(verify, cert)
+    data = _build_form_data(files)
+
+    try:
+        async with aiohttp.ClientSession(headers=headers) as session:
+            async with session.request(
+                method=method,
+                url=url,
+                params=params,
+                json=json_body,
+                data=data,
+                ssl=ssl_context
+            ) as response:
+                text = await response.text()
+                return Response(
+                    status_code=response.status,
+                    text=text,
+                    headers=dict(response.headers),
+                    url=str(response.url)
+                )
+    except asyncio.TimeoutError as exc:
+        raise _requests.exceptions.Timeout(str(exc)) from None
+    except aiohttp.ClientConnectionError as exc:
+        raise _requests.exceptions.ConnectionError(str(exc)) from None
+    except aiohttp.ClientError as exc:
+        raise _requests.exceptions.ConnectionError(str(exc)) from None
+
+
+def _run(coro):
+    try:
+        return asyncio.run(coro)
+    except RuntimeError as exc:
+        if "asyncio.run() cannot be called from a running event loop" not in str(exc):
+            raise
+        loop = asyncio.new_event_loop()
+        try:
+            return loop.run_until_complete(coro)
+        finally:
+            loop.close()
+
+
+class Session:
+    """A minimal requests.Session lookalike backed by aiohttp."""
+
+    def __init__(self):
+        self.headers = {}
+        self.verify = True
+        self.cert = None
+
+    def _perform(self, method, url, params=None, json=None, files=None):
+        return _run(
+            _request(
+                method=method,
+                url=url,
+                headers=self.headers,
+                verify=self.verify,
+                cert=self.cert,
+                params=params,
+                json_body=json,
+                files=files
+            )
+        )
+
+    def get(self, url, params=None):
+        return self._perform("GET", url, params=params)
+
+    def post(self, url, params=None, json=None):
+        return self._perform("POST", url, params=params, json=json)
+
+    def put(self, url, params=None, json=None, files=None):
+        return self._perform("PUT", url, params=params, json=json, files=files)
+
+    def delete(self, url, params=None):
+        return self._perform("DELETE", url, params=params)
+
+    def close(self):
+        return None
+
+
+def get(url, headers=None, verify=True, cert=None):
+    return _run(_request("GET", url, headers=headers, verify=verify, cert=cert))
+
+
+exceptions = _requests.exceptions
+ConnectionError = _requests.exceptions.ConnectionError
+Timeout = _requests.exceptions.Timeout
+
+requests = SimpleNamespace(
+    Session=Session,
+    get=get,
+    exceptions=exceptions,
+    ConnectionError=ConnectionError,
+    Timeout=Timeout,
+)
