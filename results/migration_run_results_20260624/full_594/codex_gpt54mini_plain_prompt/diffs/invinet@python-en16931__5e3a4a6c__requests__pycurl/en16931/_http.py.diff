+"""Shared HTTP helpers for external service integrations."""
+
+from io import BytesIO
+import ssl
+
+try:
+    import pycurl  # type: ignore
+except ImportError:  # pragma: no cover - exercised only when pycurl is absent.
+    pycurl = None
+
+from urllib.error import HTTPError, URLError
+from urllib.request import Request, urlopen
+
+
+def perform_request(method, url, headers=None, body=None, verify=True):
+    """Perform an HTTP request and return ``(status_code, response_text)``."""
+    headers = headers or {}
+    if isinstance(body, str):
+        body = body.encode("utf-8")
+
+    if pycurl is not None:
+        return _perform_request_pycurl(method, url, headers, body, verify)
+    return _perform_request_urllib(method, url, headers, body, verify)
+
+
+def _perform_request_pycurl(method, url, headers, body, verify):
+    response_buffer = BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEDATA, response_buffer)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.NOSIGNAL, True)
+        curl.setopt(pycurl.HTTPHEADER, ["{}: {}".format(key, value) for key, value in headers.items()])
+        if not verify:
+            curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+            curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+        if method.upper() == "POST":
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, body or b"")
+            curl.setopt(pycurl.POSTFIELDSIZE, len(body or b""))
+        elif method.upper() != "GET":
+            curl.setopt(pycurl.CUSTOMREQUEST, method.upper())
+            if body is not None:
+                curl.setopt(pycurl.POSTFIELDS, body)
+                curl.setopt(pycurl.POSTFIELDSIZE, len(body))
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        response_text = response_buffer.getvalue().decode("utf-8", errors="replace")
+        return status_code, response_text
+    except pycurl.error as exc:  # pragma: no cover - depends on transport failure.
+        raise RuntimeError(str(exc)) from exc
+    finally:
+        curl.close()
+
+
+def _perform_request_urllib(method, url, headers, body, verify):
+    request = Request(url, data=body if method.upper() != "GET" else None, headers=headers, method=method.upper())
+    context = None
+    if url.startswith("https") and not verify:
+        context = ssl._create_unverified_context()
+    try:
+        with urlopen(request, context=context) as response:
+            status_code = response.getcode()
+            response_text = response.read().decode("utf-8", errors="replace")
+            return status_code, response_text
+    except HTTPError as exc:
+        response_text = exc.read().decode("utf-8", errors="replace")
+        return exc.code, response_text
+    except URLError as exc:  # pragma: no cover - depends on transport failure.
+        raise RuntimeError(str(exc)) from exc
