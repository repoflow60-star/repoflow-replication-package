diff --git /dev/null b/aiohttp.py
new file mode 100644
index 0000000..20ca1d6
--- /dev/null
+++ b/aiohttp.py
@@ -0,0 +1,189 @@
+import asyncio
+import base64
+import json
+from urllib import error as urllib_error
+from urllib import request as urllib_request
+
+
+class ClientError(Exception):
+    pass
+
+
+class ClientResponseError(ClientError):
+    def __init__(self, status, message="", headers=None):
+        super().__init__(message or "HTTP response error")
+        self.status = status
+        self.message = message or "HTTP response error"
+        self.headers = headers or {}
+
+
+class _Headers(dict):
+    def __getitem__(self, key):
+        return super().__getitem__(key.lower())
+
+    def get(self, key, default=None):
+        return super().get(key.lower(), default)
+
+    def __contains__(self, key):
+        return super().__contains__(key.lower())
+
+
+def _parse_links(link_header):
+    links = {}
+    if not link_header:
+        return links
+
+    parts = []
+    current = []
+    in_quotes = False
+    for char in link_header:
+        if char == '"':
+            in_quotes = not in_quotes
+        if char == ',' and not in_quotes:
+            parts.append("".join(current).strip())
+            current = []
+            continue
+        current.append(char)
+    if current:
+        parts.append("".join(current).strip())
+
+    for part in parts:
+        if not part.startswith("<") or ">" not in part:
+            continue
+        url, remainder = part[1:].split(">", 1)
+        attributes = {}
+        for item in remainder.split(";"):
+            item = item.strip()
+            if not item or "=" not in item:
+                continue
+            key, value = item.split("=", 1)
+            attributes[key.strip()] = value.strip().strip('"')
+        rel = attributes.get("rel")
+        if rel:
+            links[rel] = {"url": url}
+    return links
+
+
+class ClientResponse:
+    def __init__(self, status, headers, body):
+        self.status = status
+        self.headers = _Headers(headers)
+        self._body = body or b""
+        self.links = _parse_links(self.headers.get("link"))
+
+    def raise_for_status(self):
+        if self.status >= 400:
+            raise ClientResponseError(self.status, headers=dict(self.headers))
+
+    async def text(self):
+        if isinstance(self._body, str):
+            return self._body
+        content_type = self.headers.get("content-type", "")
+        encoding = "utf-8"
+        for part in content_type.split(";")[1:]:
+            part = part.strip()
+            if part.lower().startswith("charset="):
+                encoding = part.split("=", 1)[1].strip()
+                break
+        return self._body.decode(encoding, errors="replace")
+
+    async def json(self, content_type=None):
+        return json.loads(await self.text())
+
+
+class _RequestContextManager:
+    def __init__(self, session, method, url, kwargs):
+        self._session = session
+        self._method = method
+        self._url = url
+        self._kwargs = kwargs
+        self._response = None
+
+    def __await__(self):
+        return self._coro().__await__()
+
+    async def _coro(self):
+        return await self._session._request(
+            self._method, self._url, **self._kwargs)
+
+    async def __aenter__(self):
+        self._response = await self._coro()
+        return self._response
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+
+class ClientSession:
+    def __init__(self, **kwargs):
+        self._kwargs = kwargs
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+    def head(self, url, **kwargs):
+        return _RequestContextManager(self, "HEAD", url, kwargs)
+
+    def get(self, url, **kwargs):
+        return _RequestContextManager(self, "GET", url, kwargs)
+
+    def options(self, url, **kwargs):
+        return _RequestContextManager(self, "OPTIONS", url, kwargs)
+
+    def post(self, url, **kwargs):
+        return _RequestContextManager(self, "POST", url, kwargs)
+
+    async def _request(self, method, url, **kwargs):
+        return await asyncio.to_thread(self._sync_request, method, url, kwargs)
+
+    def _sync_request(self, method, url, kwargs):
+        headers = dict(kwargs.pop("headers", {}) or {})
+        data = kwargs.pop("data", None)
+        auth = kwargs.pop("auth", None)
+        if auth and "authorization" not in {key.lower() for key in headers}:
+            username, password = auth
+            token = base64.b64encode(
+                f"{username}:{password}".encode("utf-8")
+            ).decode("ascii")
+            headers["Authorization"] = f"Basic {token}"
+
+        body = None
+        if data is not None:
+            if isinstance(data, str):
+                body = data.encode("utf-8")
+            elif isinstance(data, (bytes, bytearray)):
+                body = bytes(data)
+            else:
+                body = str(data).encode("utf-8")
+
+        request = urllib_request.Request(
+            url,
+            data=body,
+            headers=headers,
+            method=method,
+        )
+
+        try:
+            with urllib_request.urlopen(request) as response:
+                return ClientResponse(
+                    response.getcode(),
+                    dict(response.headers.items()),
+                    response.read(),
+                )
+        except urllib_error.HTTPError as exc:
+            return ClientResponse(
+                exc.code,
+                dict(exc.headers.items()) if exc.headers else {},
+                exc.read(),
+            )
+
+
+__all__ = [
+    "ClientError",
+    "ClientResponse",
+    "ClientResponseError",
+    "ClientSession",
+]
