+"""Minimal plac-compatible helpers used by beanquery.
+
+This repository only needs the annotation decorator to keep the CLI
+definition declarative. The actual command-line parsing is handled by the
+wrapper in ``beanquery.shell``.
+"""
+
+
+def annotations(**kwargs):
+    def decorator(func):
+        func.__plac_annotations__ = kwargs
+        return func
+
+    return decorator
+
