@@ -0,0 +1,42 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from io import BytesIO
+
+import pycurl
+
+
+class HTTPError(RuntimeError):
+    pass
+
+
+@dataclass
+class Response:
+    content: bytes
+    status_code: int
+    url: str
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            raise HTTPError(f"HTTP {self.status_code} for url: {self.url}")
+
+
+def get(url: str) -> Response:
+    buffer = BytesIO()
+    curl = pycurl.Curl()
+
+    try:
+        curl.setopt(pycurl.URL, url.encode("utf-8"))
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.MAXREDIRS, 10)
+        curl.setopt(pycurl.ACCEPT_ENCODING, "")
+        curl.setopt(pycurl.NOSIGNAL, 1)
+        curl.setopt(pycurl.WRITEFUNCTION, buffer.write)
+        curl.perform()
+        status_code = int(curl.getinfo(pycurl.RESPONSE_CODE))
+    except pycurl.error as exc:
+        raise HTTPError(f"Failed to fetch {url}: {exc}") from exc
+    finally:
+        curl.close()
+
+    return Response(content=buffer.getvalue(), status_code=status_code, url=url)
