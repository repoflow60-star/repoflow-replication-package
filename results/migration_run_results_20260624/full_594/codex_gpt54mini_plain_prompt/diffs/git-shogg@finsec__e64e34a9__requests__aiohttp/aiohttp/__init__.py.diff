+"""Minimal aiohttp-compatible shim for HTTP GET requests.
+
+This project only needs a tiny subset of aiohttp's API:
+
+- ClientTimeout(total=...)
+- ClientSession(headers=..., timeout=...)
+- async context manager support for ClientSession
+- session.get(url) returning an async context manager
+- response.text()
+
+The implementation uses the Python standard library so the package can run
+in environments where the real aiohttp distribution is unavailable.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import gzip
+from dataclasses import dataclass
+from typing import Any, Dict, Optional
+from urllib import request as urllib_request
+from urllib.error import HTTPError, URLError
+import zlib
+
+
+@dataclass
+class ClientTimeout:
+    total: Optional[float] = None
+
+
+class _Response:
+    def __init__(self, url: str, headers: Dict[str, str], timeout: ClientTimeout):
+        self._url = url
+        self._headers = headers
+        self._timeout = timeout
+        self.status: int = 0
+        self.headers: Dict[str, Any] = {}
+        self._body: bytes = b""
+
+    def _load(self) -> None:
+        req = urllib_request.Request(self._url, headers=self._headers)
+        try:
+            with urllib_request.urlopen(req, timeout=self._timeout.total) as resp:
+                self.status = getattr(resp, "status", 200)
+                self.headers = dict(resp.headers.items())
+                body = resp.read()
+        except HTTPError as exc:
+            self.status = exc.code
+            self.headers = dict(exc.headers.items()) if exc.headers is not None else {}
+            body = exc.read()
+        except URLError:
+            raise
+
+        content_encoding = self.headers.get("Content-Encoding", "").lower()
+        if content_encoding == "gzip":
+            body = gzip.decompress(body)
+        elif content_encoding == "deflate":
+            try:
+                body = zlib.decompress(body)
+            except zlib.error:
+                body = zlib.decompress(body, -zlib.MAX_WBITS)
+
+        self._body = body
+
+    async def __aenter__(self) -> "_Response":
+        await asyncio.to_thread(self._load)
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb) -> None:
+        return None
+
+    async def text(self) -> str:
+        if not self._body:
+            await asyncio.to_thread(self._load)
+        charset = "utf-8"
+        content_type = self.headers.get("Content-Type", "")
+        if "charset=" in content_type:
+            charset = content_type.split("charset=", 1)[1].split(";", 1)[0].strip()
+        return self._body.decode(charset, errors="replace")
+
+
+class _RequestContextManager:
+    def __init__(self, response: _Response):
+        self._response = response
+
+    async def __aenter__(self) -> _Response:
+        return await self._response.__aenter__()
+
+    async def __aexit__(self, exc_type, exc, tb) -> None:
+        return await self._response.__aexit__(exc_type, exc, tb)
+
+
+class ClientSession:
+    def __init__(self, *, headers: Optional[Dict[str, str]] = None, timeout: Optional[ClientTimeout] = None):
+        self._headers = dict(headers or {})
+        self._timeout = timeout or ClientTimeout()
+
+    async def __aenter__(self) -> "ClientSession":
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb) -> None:
+        return None
+
+    def get(self, url: str) -> _RequestContextManager:
+        return _RequestContextManager(_Response(url, self._headers, self._timeout))
