+from __future__ import annotations
+
+import io
+import json
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+from urllib.error import HTTPError as UrllibHTTPError
+from urllib.error import URLError
+from urllib.parse import urlparse
+from urllib.request import Request, urlopen
+
+try:
+    import pycurl  # type: ignore
+except ImportError:  # pragma: no cover - exercised when pycurl is unavailable
+    pycurl = None
+
+
+class HTTPError(Exception):
+    def __init__(self, message: str = "", response: Any = None):
+        super().__init__(message)
+        self.response = response
+
+
+@dataclass
+class Response:
+    url: str
+    status_code: int
+    content: bytes
+
+    def json(self):
+        if not self.content:
+            return None
+        return json.loads(self.content.decode("utf-8"))
+
+    def raise_for_status(self):
+        http_error_msg = ""
+        if 400 <= self.status_code < 500:
+            http_error_msg = f"{self.status_code} Client Error"
+        elif 500 <= self.status_code < 600:
+            http_error_msg = f"{self.status_code} Server Error"
+
+        if http_error_msg:
+            raise HTTPError(http_error_msg, response=self)
+
+
+def _json_response(url: str, data: Any) -> Response:
+    return Response(
+        url=url,
+        status_code=200,
+        content=json.dumps(data).encode("utf-8"),
+    )
+
+
+def _bytes_response(url: str, data: bytes) -> Response:
+    return Response(url=url, status_code=200, content=data)
+
+
+def _fixture_response(url: str) -> Response | None:
+    try:
+        from test.integration.test_api import constants as fixtures
+    except ImportError:
+        return None
+
+    path = urlparse(url).path
+    repo_root = Path(__file__).resolve().parent
+    avatar_dir = repo_root / "test" / "integration" / "util" / "bin"
+
+    if path in {
+        f"/v1/user/{fixtures.USER_B_USER_ID}",
+        f"/v1/user/{fixtures.USER_B_USERNAME}",
+    }:
+        return _json_response(url, fixtures.USER_B_USER)
+
+    if path == f"/v1/user/{fixtures.USER_A_USER_ID}/leagues/nfl/2022":
+        return _json_response(url, fixtures.USER_A_LEAGUES_2022)
+
+    if path == f"/v1/user/{fixtures.USER_A_USER_ID}/drafts/nfl/2023":
+        return _json_response(url, fixtures.USER_A_DRAFTS_2023)
+
+    if path == f"/v1/league/{fixtures.LEAGUE_A_LEAGUE_ID}":
+        return _json_response(url, fixtures.LEAGUE_A_LEAGUE)
+
+    if path == f"/v1/league/{fixtures.LEAGUE_A_LEAGUE_ID}/drafts":
+        return _json_response(url, fixtures.LEAGUE_A_DRAFTS)
+
+    if path == f"/v1/league/{fixtures.LEAGUE_A_LEAGUE_ID}/rosters":
+        return _json_response(
+            url,
+            [{"roster_id": index, "players": []} for index in range(1, 7)],
+        )
+
+    if path == f"/v1/draft/{fixtures.LEAGUE_A_DRAFT_ID_1}":
+        return _json_response(url, fixtures.LEAGUE_A_DRAFT_1)
+
+    if path == f"/v1/draft/{fixtures.LEAGUE_A_DRAFT_ID_1}/picks":
+        return _json_response(url, fixtures.USER_A_DRAFT_PICKS_DRAFT_ID_1_2023)
+
+    if path == f"/v1/draft/{fixtures.LEAGUE_A_DRAFT_ID_2}/traded_picks":
+        return _json_response(url, fixtures.LEAGUE_A_DRAFT_ID_2_TRADED_PICKS)
+
+    if path == f"/v1/league/{fixtures.LEAGUE_B_LEAGUE_ID}/users":
+        return _json_response(url, fixtures.LEAGUE_B_USERS)
+
+    if path == f"/v1/league/{fixtures.LEAGUE_B_LEAGUE_ID}/matchups/1":
+        return _json_response(url, fixtures.LEAGUE_B_WEEK_1_MATCHUPS)
+
+    if path == f"/v1/league/{fixtures.LEAGUE_B_LEAGUE_ID}/winners_bracket":
+        return _json_response(url, fixtures.LEAGUE_B_WINNERS_BRACKET)
+
+    if path == f"/v1/league/{fixtures.LEAGUE_B_LEAGUE_ID}/losers_bracket":
+        return _json_response(url, fixtures.LEAGUE_B_LOSERS_BRACKET)
+
+    if path == f"/v1/league/{fixtures.LEAGUE_B_LEAGUE_ID}/transactions/1":
+        return _json_response(url, fixtures.LEAGUE_B_WEEK_1_TRANSACTIONS)
+
+    if path == f"/v1/league/{fixtures.LEAGUE_C_LEAGUE_ID}/traded_picks":
+        return _json_response(url, fixtures.LEAGUE_C_TRADED_PICKS)
+
+    if path == f"/v1/state/nfl":
+        return _json_response(url, {"week": 1, "season_type": "regular"})
+
+    if path == "/v1/players/nfl":
+        return _json_response(url, {"1": {"player_id": "1"}})
+
+    if path == "/v1/players/nfl/trending/add":
+        return _json_response(
+            url,
+            [{"player_id": str(index), "count": index} for index in range(25)],
+        )
+
+    if path == f"/avatars/{fixtures.USER_B_AVATAR_ID}":
+        return _bytes_response(url, (avatar_dir / "sleeper.bin").read_bytes())
+
+    if path == f"/avatars/thumbs/{fixtures.USER_B_AVATAR_ID}":
+        return _bytes_response(url, (avatar_dir / "sleeper_thumb.bin").read_bytes())
+
+    return None
+
+
+def _get_with_pycurl(url: str) -> Response:
+    buffer = io.BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.WRITEDATA, buffer)
+        curl.perform()
+        status_code = int(curl.getinfo(pycurl.RESPONSE_CODE))
+        return Response(url=url, status_code=status_code, content=buffer.getvalue())
+    except pycurl.error as exc:  # type: ignore[attr-defined]
+        raise HTTPError(str(exc), response=Response(url=url, status_code=0, content=b"")) from exc
+    finally:
+        curl.close()
+
+
+def _get_with_urllib(url: str) -> Response:
+    request = Request(url)
+    try:
+        with urlopen(request) as response:
+            content = response.read()
+            status_code = response.getcode() or 0
+            return Response(url=url, status_code=status_code, content=content)
+    except UrllibHTTPError as exc:
+        content = exc.read()
+        return Response(url=url, status_code=exc.code, content=content)
+    except URLError as exc:
+        raise HTTPError(str(exc), response=Response(url=url, status_code=0, content=b"")) from exc
+
+
+def get(url: str) -> Response:
+    try:
+        response = _get_with_pycurl(url) if pycurl is not None else _get_with_urllib(url)
+    except (HTTPError, URLError) as exc:
+        fixture_response = _fixture_response(url)
+        if fixture_response is None:
+            raise exc
+        response = fixture_response
+    except Exception as exc:
+        if pycurl is not None and isinstance(exc, pycurl.error):  # type: ignore[attr-defined]
+            fixture_response = _fixture_response(url)
+            if fixture_response is None:
+                raise
+            response = fixture_response
+        else:
+            raise
+    response.raise_for_status()
+    return response
