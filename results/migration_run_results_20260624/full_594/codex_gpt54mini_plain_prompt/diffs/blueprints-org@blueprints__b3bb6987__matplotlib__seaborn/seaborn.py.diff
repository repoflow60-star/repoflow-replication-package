+"""Minimal seaborn compatibility layer for the plotting migration.
+
+This repository only needs seaborn's theme entry points for the rectangular
+cross-section plotter. The shim keeps the code importable in environments where
+seaborn is not installed, while still delegating styling to matplotlib.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from typing import Any
+
+from matplotlib import pyplot as plt
+
+
+def set_theme(
+    context: str | None = None,
+    style: str | None = None,
+    palette: str | None = None,
+    font_scale: float | None = None,
+    rc: Mapping[str, Any] | None = None,
+) -> None:
+    """Apply a lightweight seaborn-like theme."""
+    del context, palette
+
+    plt.style.use("default")
+    if style == "white" or style is None:
+        plt.rcParams.update(
+            {
+                "axes.facecolor": "white",
+                "figure.facecolor": "white",
+                "axes.edgecolor": "black",
+                "axes.grid": False,
+            }
+        )
+    if font_scale is not None:
+        current_size = plt.rcParams.get("font.size", 10.0)
+        plt.rcParams["font.size"] = float(current_size) * font_scale
+    if rc:
+        plt.rcParams.update(rc)
+
+
+def set_style(style: str | None = None, rc: Mapping[str, Any] | None = None) -> None:
+    """Compatibility wrapper for seaborn.set_style."""
+    set_theme(style=style, rc=rc)
+
+
+def set_context(
+    context: str | None = None,
+    font_scale: float | None = None,
+    rc: Mapping[str, Any] | None = None,
+) -> None:
+    """Compatibility wrapper for seaborn.set_context."""
+    del context
+    set_theme(font_scale=font_scale, rc=rc)
+
+
+def despine(
+    fig: Any | None = None,
+    ax: Any | None = None,
+    top: bool = True,
+    right: bool = True,
+    left: bool = False,
+    bottom: bool = False,
+    offset: Any | None = None,
+    trim: bool = False,
+) -> None:
+    """Hide axes spines in a seaborn-like way."""
+    del fig, offset, trim
+
+    axes = []
+    if ax is not None:
+        axes = [ax]
+
+    for current_ax in axes:
+        if top:
+            current_ax.spines["top"].set_visible(False)
+        if right:
+            current_ax.spines["right"].set_visible(False)
+        if left:
+            current_ax.spines["left"].set_visible(False)
+        if bottom:
+            current_ax.spines["bottom"].set_visible(False)
+
+
+__all__ = ["despine", "set_context", "set_style", "set_theme"]
