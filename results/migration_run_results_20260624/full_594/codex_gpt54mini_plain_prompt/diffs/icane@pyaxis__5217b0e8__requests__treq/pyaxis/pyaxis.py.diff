+_HTTP_LOOP = None
+
+
+def _ensure_http_runtime():
+    """Create a dedicated asyncio loop for treq-backed requests."""
+    global _HTTP_LOOP
+    if _HTTP_LOOP is not None:
+        return _HTTP_LOOP
+
+    _HTTP_LOOP = asyncio.new_event_loop()
+    asyncio.set_event_loop(_HTTP_LOOP)
+    try:
+        asyncioreactor.install(_HTTP_LOOP)
+    except Exception:
+        # The host process may already have a reactor installed.
+        pass
+    return _HTTP_LOOP
+
+
+def _build_response_error(status_code, reason):
+    """Attach response metadata to requests-compatible exceptions."""
+    response = SimpleNamespace(status_code=status_code, reason=reason)
+    error = requests_exceptions.HTTPError(f'{status_code} {reason}'.strip())
+    error.response = response
+    return error
+
+
+def _build_invalid_url_error(reason):
+    response = SimpleNamespace(status_code='', reason=reason)
+    error = requests_exceptions.InvalidURL(reason)
+    error.response = response
+    return error
+
+
+def _read_url_with_treq(uri, encoding, timeout):
+    """Fetch URL content with treq and decode it explicitly."""
+    loop = _ensure_http_runtime()
+
+    async def _fetch():
+        try:
+            response = await treq.get(uri, timeout=timeout)
+            body = await treq.content(response)
+            status_code = getattr(response, 'code', None)
+            reason = getattr(response, 'phrase', '') or getattr(response, 'reason', '')
+            if status_code is not None and status_code >= 400:
+                raise _build_response_error(status_code, reason)
+            return body.decode(encoding, errors='replace')
+        except Exception as exc:
+            if isinstance(exc, asyncio.TimeoutError):
+                raise requests_exceptions.ConnectTimeout(str(exc)) from exc
+            if twisted_error is not None:
+                twisted_timeout_errors = tuple(
+                    error_type for error_type in (
+                        getattr(twisted_error, 'TimeoutError', None),
+                        getattr(twisted_error, 'TCPTimedOutError', None),
+                    ) if error_type is not None
+                )
+                if isinstance(exc, twisted_timeout_errors):
+                    raise requests_exceptions.ConnectTimeout(str(exc)) from exc
+                twisted_connect_errors = tuple(
+                    error_type for error_type in (
+                        getattr(twisted_error, 'DNSLookupError', None),
+                        getattr(twisted_error, 'ConnectError', None),
+                        getattr(twisted_error, 'ConnectionLost', None),
+                        getattr(twisted_error, 'ConnectionRefusedError', None),
+                    ) if error_type is not None
+                )
+                if isinstance(exc, twisted_connect_errors):
+                    raise requests_exceptions.ConnectionError(str(exc)) from exc
+            if isinstance(exc, ValueError):
+                raise _build_invalid_url_error(str(exc)) from exc
+            raise
+
+    return loop.run_until_complete(_fetch())
+
+
+def _read_url_with_requests(uri, encoding, timeout):
+    """Fallback URL reader for environments without treq."""
+    import requests
+
+    response = requests.get(uri, stream=True, timeout=timeout)
+    response.raise_for_status()
+    response.encoding = encoding
+    text = response.text
+    response.close()
+    return text
 
 
