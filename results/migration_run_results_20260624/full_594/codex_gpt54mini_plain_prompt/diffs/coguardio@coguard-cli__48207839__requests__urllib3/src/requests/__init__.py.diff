+"""
+Minimal requests-compatible wrapper implemented on top of urllib3.
+
+The repository still uses the ``requests`` module name in tests and call sites,
+but the actual HTTP transport comes from urllib3.
+"""
+
+from __future__ import annotations
+
+import json as _json
+from typing import Any, Dict, Iterator, Optional
+
+import urllib3
+
+from .exceptions import HTTPError
+
+_POOL = urllib3.PoolManager()
+
+
+class Response:
+    """
+    Small subset of ``requests.Response`` used by the project tests and code.
+    """
+
+    def __init__(
+        self,
+        raw: Optional[urllib3.response.HTTPResponse] = None,
+        status_code: int = 200,
+        reason: str = "",
+        headers: Optional[Dict[str, str]] = None,
+        url: str = "",
+    ):
+        self._raw = raw
+        self.status_code = raw.status if raw is not None else status_code
+        self.reason = getattr(raw, "reason", reason) if raw is not None else reason
+        self.headers = dict(getattr(raw, "headers", {}) or headers or {})
+        self.url = url or getattr(raw, "url", "")
+        self._content = None
+
+    @property
+    def content(self) -> bytes:
+        if self._raw is not None and self._content is None:
+            self._content = self._raw.read()
+        if self._content is None:
+            return b""
+        return self._content
+
+    @content.setter
+    def content(self, value: bytes) -> None:
+        self._content = value
+
+    @property
+    def text(self) -> str:
+        data = self.content
+        if not data:
+            return ""
+        return data.decode("utf-8", errors="replace")
+
+    @text.setter
+    def text(self, value: str) -> None:
+        self._content = value.encode("utf-8")
+
+    def json(self) -> Any:
+        return _json.loads(self.text)
+
+    def iter_content(self, chunk_size: int = 1) -> Iterator[bytes]:
+        if self._raw is not None:
+            for chunk in self._raw.stream(chunk_size, decode_content=True):
+                if chunk:
+                    yield chunk
+            return
+
+        data = self.content
+        for start in range(0, len(data), chunk_size):
+            yield data[start:start + chunk_size]
+
+    def raise_for_status(self) -> None:
+        if 400 <= int(self.status_code):
+            raise HTTPError(f"{self.status_code} {self.reason}".strip())
+
+    def close(self) -> None:
+        if self._raw is not None:
+            self._raw.close()
+
+    def __enter__(self) -> "Response":
+        return self
+
+    def __exit__(self, exc_type, exc, tb) -> None:
+        self.close()
+
+
+def request(
+    method: str,
+    url: str,
+    headers: Optional[Dict[str, str]] = None,
+    data: Any = None,
+    json: Any = None,
+    timeout: Optional[float] = None,
+    stream: bool = False,
+) -> Response:
+    request_headers = dict(headers or {})
+    body = data
+    if json is not None:
+        body = _json.dumps(json).encode("utf-8")
+        request_headers.setdefault("Content-Type", "application/json")
+    if isinstance(body, str):
+        body = body.encode("utf-8")
+
+    raw = _POOL.request(
+        method.upper(),
+        url,
+        headers=request_headers or None,
+        body=body,
+        timeout=timeout,
+        preload_content=not stream,
+    )
+    return Response(raw=raw)
+
+
+def get(
+    url: str,
+    headers: Optional[Dict[str, str]] = None,
+    data: Any = None,
+    json: Any = None,
+    timeout: Optional[float] = None,
+    stream: bool = False,
+) -> Response:
+    return request(
+        "GET",
+        url,
+        headers=headers,
+        data=data,
+        json=json,
+        timeout=timeout,
+        stream=stream,
+    )
+
+
+def post(
+    url: str,
+    headers: Optional[Dict[str, str]] = None,
+    data: Any = None,
+    json: Any = None,
+    timeout: Optional[float] = None,
+    stream: bool = False,
+) -> Response:
+    return request(
+        "POST",
+        url,
+        headers=headers,
+        data=data,
+        json=json,
+        timeout=timeout,
+        stream=stream,
+    )
+
+
+def put(
+    url: str,
+    headers: Optional[Dict[str, str]] = None,
+    data: Any = None,
+    json: Any = None,
+    timeout: Optional[float] = None,
+    stream: bool = False,
+) -> Response:
+    return request(
+        "PUT",
+        url,
+        headers=headers,
+        data=data,
+        json=json,
+        timeout=timeout,
+        stream=stream,
+    )
