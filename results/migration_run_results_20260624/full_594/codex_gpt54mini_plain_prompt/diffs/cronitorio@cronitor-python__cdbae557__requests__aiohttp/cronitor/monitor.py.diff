+def _build_requests_compat():
+    module = types.ModuleType('requests')
+    default_session = _RetrySession(retries=3)
+
+    class Session(_RetrySession):
+        pass
+
+    def get(url, **kwargs):
+        return default_session.get(url, **kwargs)
+
+    def put(url, **kwargs):
+        return default_session.put(url, **kwargs)
+
+    def delete(url, **kwargs):
+        return default_session.delete(url, **kwargs)
+
+    module.Session = Session
+    module.get = get
+    module.put = put
+    module.delete = delete
+    module.__dict__['__all__'] = ['Session', 'get', 'put', 'delete']
+    return module
+
+
+requests = _build_requests_compat()
+sys.modules['requests'] = requests
+
