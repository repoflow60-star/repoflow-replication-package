+class _RetrySession:
+    def __init__(self, retries=3, backoff_factor=0.3):
+        self.retries = retries
+        self.backoff_factor = backoff_factor
+
+    def get(self, url, **kwargs):
+        return self._request('GET', url, **kwargs)
+
+    def put(self, url, **kwargs):
+        return self._request('PUT', url, **kwargs)
+
+    def delete(self, url, **kwargs):
+        return self._request('DELETE', url, **kwargs)
+
+    def _request(self, method, url, auth=None, headers=None, timeout=None, params=None, data=None):
+        return asyncio.run(self._request_async(method, url, auth=auth, headers=headers, timeout=timeout, params=params, data=data))
+
+    async def _request_async(self, method, url, auth=None, headers=None, timeout=None, params=None, data=None):
+        last_error = None
+        for attempt in range(self.retries + 1):
+            try:
+                return await self._request_once(method, url, auth=auth, headers=headers, timeout=timeout, params=params, data=data)
+            except Exception as exc:  # pragma: no cover - retry path is exercised only on transient failures
+                last_error = exc
+                if attempt >= self.retries:
+                    raise
+                await asyncio.sleep(self.backoff_factor * (2 ** attempt))
+        raise last_error
+
+    async def _request_once(self, method, url, auth=None, headers=None, timeout=None, params=None, data=None):
+        headers = _clean_mapping(headers or {})
+        params = _clean_mapping(params or {})
+
+        if aiohttp is not None:
+            client_timeout = aiohttp.ClientTimeout(total=timeout) if timeout is not None else None
+            auth_obj = aiohttp.BasicAuth(*auth) if auth else None
+            request_kwargs = {
+                'auth': auth_obj,
+                'headers': headers,
+                'params': params or None,
+                'data': data,
+            }
+            if client_timeout is not None:
+                request_kwargs['timeout'] = client_timeout
+
+            async with aiohttp.ClientSession() as session:
+                async with session.request(method, url, **request_kwargs) as resp:
+                    text = await resp.text()
+                    return _Response(resp.status, text, dict(resp.headers))
+
+        return self._stdlib_request(method, url, auth=auth, headers=headers, timeout=timeout, params=params, data=data)
+
+    def _stdlib_request(self, method, url, auth=None, headers=None, timeout=None, params=None, data=None):
+        headers = dict(headers or {})
+        if auth:
+            token = base64.b64encode(('%s:%s' % auth).encode('utf-8')).decode('ascii')
+            headers['Authorization'] = 'Basic %s' % token
+
+        if params:
+            separator = '&' if '?' in url else '?'
+            url = '%s%s%s' % (url, separator, urlencode(params))
+
+        body = data.encode('utf-8') if isinstance(data, str) else data
+        request = Request(url, data=body, headers=headers, method=method)
+
+        try:
+            with urlopen(request, timeout=timeout) as response:
+                raw = response.read()
+                text = raw.decode('utf-8') if raw else ''
+                return _Response(getattr(response, 'status', response.getcode()), text, dict(response.headers))
+        except HTTPError as exc:
+            raw = exc.read()
+            text = raw.decode('utf-8') if raw else ''
+            return _Response(exc.code, text, dict(exc.headers or {}))
+
+
