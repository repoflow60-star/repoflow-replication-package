 import loman
 from loman.consts import NodeAttributes, States
 
+DEFAULT_TIMING_COLORS = ['#15b01a', '#ffff14', '#e50000']
+DEFAULT_TIMING_CMAP = alt.Scale(range=DEFAULT_TIMING_COLORS) if alt is not None else DEFAULT_TIMING_COLORS
+
+
+def _hex_to_rgb(color):
+    color = color.lstrip('#')
+    if len(color) == 3:
+        color = ''.join(ch * 2 for ch in color)
+    return tuple(int(color[i:i + 2], 16) for i in (0, 2, 4))
+
+
+def _rgb_to_hex(rgb):
+    return '#{:02x}{:02x}{:02x}'.format(*rgb)
+
+
+def _blend_colors(left, right, ratio):
+    return tuple(
+        int(round(left_channel + (right_channel - left_channel) * ratio))
+        for left_channel, right_channel in zip(left, right)
+    )
+
+
+def _normalize_color_stops(cmap):
+    if cmap is None:
+        return DEFAULT_TIMING_COLORS
+
+    if hasattr(cmap, 'to_dict'):
+        cmap = cmap.to_dict()
+
+    if isinstance(cmap, dict):
+        color_range = cmap.get('range')
+        if color_range:
+            return list(color_range)
+
+    if isinstance(cmap, str):
+        return [cmap]
+
+    if isinstance(cmap, (list, tuple)):
+        return list(cmap)
+
+    return DEFAULT_TIMING_COLORS
+
+
+def _interpolate_color(stops, value):
+    if not stops:
+        return '#FFFFFF'
+    if len(stops) == 1:
+        return stops[0]
+
+    value = float(np.clip(value, 0.0, 1.0))
+    scaled = value * (len(stops) - 1)
+    index = min(int(scaled), len(stops) - 2)
+    blend = scaled - index
+    left = _hex_to_rgb(stops[index])
+    right = _hex_to_rgb(stops[index + 1])
+    return _rgb_to_hex(_blend_colors(left, right, blend))
+
 
