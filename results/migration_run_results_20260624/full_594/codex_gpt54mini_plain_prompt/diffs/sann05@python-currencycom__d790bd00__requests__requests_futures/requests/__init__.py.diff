@@ -0,0 +1,35 @@
+import os
+
+from _compat_requests import load_real_requests
+from requests_futures.sessions import FuturesSession
+
+
+_real_requests = load_real_requests()
+
+__path__ = [os.path.dirname(__file__)] + list(getattr(_real_requests, '__path__', []))
+
+for _name in dir(_real_requests):
+    if _name.startswith('_'):
+        continue
+    if _name in {'delete', 'get', 'post', 'request'}:
+        continue
+    globals()[_name] = getattr(_real_requests, _name)
+
+_session = FuturesSession()
+
+
+def request(method, url, **kwargs):
+    return _session.request(method, url, **kwargs).result()
+
+
+def get(url, **kwargs):
+    return _session.get(url, **kwargs).result()
+
+
+def post(url, **kwargs):
+    return _session.post(url, **kwargs).result()
+
+
+def delete(url, **kwargs):
+    return _session.delete(url, **kwargs).result()
+
