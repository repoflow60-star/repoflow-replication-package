--- /dev/null
+++ b/_compat_requests.py
@@ -0,0 +1,59 @@
+import importlib.util
+import os
+import sys
+
+
+_REAL_REQUESTS_MODULE = '_requests_real'
+
+
+def _candidate_requests_init():
+    repo_root = os.path.abspath(os.path.dirname(__file__))
+    local_init = os.path.join(repo_root, 'requests', '__init__.py')
+
+    for entry in sys.path:
+        if not entry:
+            continue
+
+        candidate = os.path.join(entry, 'requests', '__init__.py')
+        if not os.path.isfile(candidate):
+            continue
+
+        if os.path.abspath(candidate) == local_init:
+            continue
+
+        return candidate
+
+    raise ImportError('Unable to locate the installed requests package')
+
+
+def load_real_requests():
+    module = sys.modules.get(_REAL_REQUESTS_MODULE)
+    if module is not None:
+        return module
+
+    init_path = _candidate_requests_init()
+    package_dir = os.path.dirname(init_path)
+
+    spec = importlib.util.spec_from_file_location(
+        _REAL_REQUESTS_MODULE,
+        init_path,
+        submodule_search_locations=[package_dir],
+    )
+    if spec is None or spec.loader is None:
+        raise ImportError('Unable to load the installed requests package')
+
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[_REAL_REQUESTS_MODULE] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def load_real_requests_submodule(name):
+    load_real_requests()
+
+    module_name = f'{_REAL_REQUESTS_MODULE}.{name}'
+    module = sys.modules.get(module_name)
+    if module is not None:
+        return module
+
+    return __import__(module_name, fromlist=['*'])
