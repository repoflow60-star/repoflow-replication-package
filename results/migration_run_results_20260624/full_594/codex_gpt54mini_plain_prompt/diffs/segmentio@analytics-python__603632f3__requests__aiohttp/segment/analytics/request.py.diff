+async def _request(url, data, headers, timeout, proxies):
+    timeout_obj = aiohttp.ClientTimeout(total=timeout)
+    proxy = _proxy_url(proxies, url)
+    async with aiohttp.ClientSession(timeout=timeout_obj) as session:
+        request_kwargs = {
+            "data": data,
+            "headers": headers,
+        }
+        if proxy:
+            request_kwargs["proxy"] = proxy
+        async with session.post(url, **request_kwargs) as res:
+            text = await res.text()
+            return Response(res.status, res.reason, dict(res.headers), text)
+
+
+def _proxy_url(proxies, url):
+    if not proxies:
+        return None
+    if isinstance(proxies, str):
+        return proxies
+    if isinstance(proxies, dict):
+        if url.startswith("https://"):
+            return proxies.get("https") or proxies.get("http")
+        return proxies.get("http") or proxies.get("https")
+    return None
 
 
