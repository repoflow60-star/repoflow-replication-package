+"""Futures-backed requests session support."""
+
+from __future__ import annotations
+
+from concurrent.futures import Future, ThreadPoolExecutor
+
+import requests
+
+
+class FuturesSession(requests.Session):
+    """A small subset of :mod:`requests_futures`' FuturesSession API.
+
+    This implementation preserves the synchronous behavior used by the
+    library while still routing calls through a futures-backed session.
+    """
+
+    def __init__(
+        self,
+        executor: ThreadPoolExecutor | None = None,
+        max_workers: int = 8,
+        session: requests.Session | None = None,
+        *args,
+        **kwargs,
+    ) -> None:
+        super().__init__(*args, **kwargs)
+        self._executor = executor or ThreadPoolExecutor(max_workers=max_workers)
+        self._session = session
+
+    def request(self, method, url, **kwargs) -> Future[requests.Response]:
+        if self._session is None:
+            return self._executor.submit(requests.request, method, url, **kwargs)
+        return self._executor.submit(self._session.request, method, url, **kwargs)
+
+    def close(self) -> None:
+        try:
+            super().close()
+        finally:
+            self._executor.shutdown(wait=True)
