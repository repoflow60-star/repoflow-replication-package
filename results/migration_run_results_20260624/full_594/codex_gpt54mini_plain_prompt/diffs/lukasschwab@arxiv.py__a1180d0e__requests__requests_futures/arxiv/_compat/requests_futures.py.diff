+from __future__ import annotations
+
+from concurrent.futures import Future, ThreadPoolExecutor
+
+import requests
+
+
+class FuturesSession(requests.Session):
+    """
+    Minimal `requests_futures` compatible session used when the real dependency
+    is unavailable.
+    """
+
+    def __init__(self, executor=None, max_workers: int = 8, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.executor = executor or ThreadPoolExecutor(max_workers=max_workers)
+
+    def get(self, *args, **kwargs) -> Future:
+        return self.executor.submit(requests.Session.get, self, *args, **kwargs)
