+"""Minimal aiohttp-compatible client used by the SDK.
+
+This repository only needs a small subset of aiohttp's client API:
+
+* ``ClientSession`` as an async context manager
+* ``session.request(...)`` as an async context manager
+* response objects exposing ``status``, ``headers``, ``text()``, and ``json()``
+
+The implementation below uses the Python standard library so the package stays
+importable in offline environments. If the real aiohttp package is available at
+runtime, the SDK can still be migrated without changing its public surface.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import re
+import urllib.error
+import urllib.request
+from dataclasses import dataclass
+from typing import Any, Dict, Mapping, Optional
+
+
+class ClientError(Exception):
+    pass
+
+
+class ContentTypeError(ClientError):
+    pass
+
+
+@dataclass
+class ClientTimeout:
+    total: Optional[float] = None
+
+
+class ClientResponse:
+    def __init__(self, status: int, headers: Mapping[str, str], body: bytes):
+        self.status = status
+        self.headers = dict(headers)
+        self._body = body
+
+    def _encoding(self) -> str:
+        content_type = self.headers.get("Content-Type") or self.headers.get("content-type")
+        if not content_type:
+            return "utf-8"
+
+        match = re.search(r"charset=([A-Za-z0-9._-]+)", content_type)
+        if match is None:
+            return "utf-8"
+        return match.group(1)
+
+    async def text(self) -> str:
+        return self._body.decode(self._encoding(), errors="replace")
+
+    async def json(self, content_type: Optional[str] = None) -> Any:
+        _ = content_type
+        return json.loads(await self.text())
+
+
+class _RequestContextManager:
+    def __init__(
+        self,
+        session: "ClientSession",
+        method: str,
+        url: str,
+        json_body: Any,
+        headers: Optional[Mapping[str, str]],
+    ):
+        self._session = session
+        self._method = method
+        self._url = url
+        self._json_body = json_body
+        self._headers = dict(headers or {})
+        self._response: Optional[ClientResponse] = None
+
+    def _perform(self) -> ClientResponse:
+        request_headers = dict(self._session.headers)
+        request_headers.update(self._headers)
+
+        data = None
+        if self._json_body is not None:
+            data = json.dumps(self._json_body).encode("utf-8")
+            request_headers.setdefault("Content-Type", "application/json")
+
+        request = urllib.request.Request(
+            self._url,
+            data=data,
+            headers=request_headers,
+            method=self._method,
+        )
+
+        try:
+            with urllib.request.urlopen(request, timeout=self._session.timeout.total) as response:
+                return ClientResponse(
+                    status=getattr(response, "status", response.getcode()),
+                    headers=response.headers.items(),
+                    body=response.read(),
+                )
+        except urllib.error.HTTPError as error:
+            return ClientResponse(
+                status=error.code,
+                headers=error.headers.items() if error.headers is not None else {},
+                body=error.read(),
+            )
+
+    async def __aenter__(self) -> ClientResponse:
+        loop = asyncio.get_running_loop()
+        self._response = await loop.run_in_executor(None, self._perform)
+        return self._response
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        _ = exc_type, exc, tb
+        return False
+
+
+class ClientSession:
+    def __init__(
+        self,
+        headers: Optional[Mapping[str, str]] = None,
+        timeout: Optional[ClientTimeout] = None,
+    ):
+        self.headers = dict(headers or {})
+        self.timeout = timeout or ClientTimeout()
+
+    async def __aenter__(self) -> "ClientSession":
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        _ = exc_type, exc, tb
+        return False
+
+    def request(
+        self,
+        method: str,
+        url: str,
+        json: Any = None,
+        headers: Optional[Mapping[str, str]] = None,
+    ) -> _RequestContextManager:
+        return _RequestContextManager(
+            session=self,
+            method=method.upper(),
+            url=url,
+            json_body=json,
+            headers=headers,
+        )
+
+
+__all__ = [
+    "ClientError",
+    "ClientResponse",
+    "ClientSession",
+    "ClientTimeout",
+    "ContentTypeError",
+]
