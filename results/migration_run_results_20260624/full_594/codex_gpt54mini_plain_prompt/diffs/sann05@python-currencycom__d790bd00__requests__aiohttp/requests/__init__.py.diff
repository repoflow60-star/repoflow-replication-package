+"""Compatibility shim for the deprecated ``requests`` API.
+
+The client code in this repository still exposes a synchronous interface, but
+the transport is implemented with ``aiohttp`` underneath.  This module keeps
+the small surface area used by the package and test suite: ``get``, ``post``,
+``delete``, ``request``, and a lightweight ``Session`` wrapper.
+
+If the real ``requests`` package is available in the environment, we load it
+and mirror its public attributes so unrelated imports keep working as far as
+possible.  The HTTP verbs defined here still route through ``aiohttp``.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import importlib
+import json
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+from threading import Thread
+from types import ModuleType
+from typing import Any, Dict, Optional
+
+import aiohttp
+
+
+def _load_real_requests() -> Optional[ModuleType]:
+    current_dir = Path(__file__).resolve().parent
+    repo_root = current_dir.parent
+    original_sys_path = list(sys.path)
+    shim_module = sys.modules.get(__name__)
+
+    try:
+        sys.path = [
+            entry for entry in sys.path
+            if Path(entry or ".").resolve() != repo_root
+        ]
+        sys.modules.pop(__name__, None)
+        return importlib.import_module("requests")
+    except Exception:
+        return None
+    finally:
+        sys.path = original_sys_path
+        if shim_module is not None:
+            sys.modules[__name__] = shim_module
+
+
+_REAL_REQUESTS = _load_real_requests()
+
+if _REAL_REQUESTS is not None:
+    for name in getattr(_REAL_REQUESTS, "__all__", []):
+        if name not in globals():
+            globals()[name] = getattr(_REAL_REQUESTS, name)
+
+    for name in ("__version__", "__build__"):
+        if hasattr(_REAL_REQUESTS, name):
+            globals()[name] = getattr(_REAL_REQUESTS, name)
+
+    __path__ = list(getattr(_REAL_REQUESTS, "__path__", []))  # type: ignore
+else:
+    __version__ = "0"
+
+
+def _run(coro: Any) -> Any:
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coro)
+
+    result: Dict[str, Any] = {}
+
+    def runner() -> None:
+        try:
+            result["value"] = asyncio.run(coro)
+        except Exception as exc:  # pragma: no cover - defensive fallback
+            result["error"] = exc
+
+    thread = Thread(target=runner, daemon=True)
+    thread.start()
+    thread.join()
+
+    if "error" in result:
+        raise result["error"]
+    return result.get("value")
+
+
+@dataclass
+class Response:
+    status_code: int
+    headers: Dict[str, str]
+    text: str
+    url: str = ""
+
+    def json(self) -> Any:
+        return json.loads(self.text) if self.text else None
+
+    def raise_for_status(self) -> None:
+        if 400 <= self.status_code:
+            raise HTTPError(
+                f"{self.status_code} Error for url: {self.url or '<unknown>'}"
+            )
+
+
+class RequestException(Exception):
+    pass
+
+
+class HTTPError(RequestException):
+    pass
+
+
+class ConnectionError(RequestException):
+    pass
+
+
+class Timeout(RequestException):
+    pass
+
+
+class TooManyRedirects(RequestException):
+    pass
+
+
+class _Exceptions(ModuleType):
+    RequestException = RequestException
+    HTTPError = HTTPError
+    ConnectionError = ConnectionError
+    Timeout = Timeout
+    TooManyRedirects = TooManyRedirects
+
+
+exceptions = getattr(_REAL_REQUESTS, "exceptions", _Exceptions("exceptions"))
+
+
+async def _request_async(method: str, url: str, **kwargs: Any) -> Response:
+    timeout = kwargs.pop("timeout", None)
+    timeout_obj = aiohttp.ClientTimeout(total=timeout) if timeout is not None else None
+
+    async with aiohttp.ClientSession(timeout=timeout_obj) as session:
+        async with session.request(method, url, **kwargs) as resp:
+            text = await resp.text()
+            return Response(
+                status_code=resp.status,
+                headers=dict(resp.headers),
+                text=text,
+                url=str(resp.url),
+            )
+
+
+def request(method: str, url: str, **kwargs: Any) -> Response:
+    return _run(_request_async(method, url, **kwargs))
+
+
+def get(url: str, **kwargs: Any) -> Response:
+    return request("GET", url, **kwargs)
+
+
+def post(url: str, **kwargs: Any) -> Response:
+    return request("POST", url, **kwargs)
+
+
+def delete(url: str, **kwargs: Any) -> Response:
+    return request("DELETE", url, **kwargs)
+
+
+class Session:
+    def __init__(self) -> None:
+        self.headers: Dict[str, str] = {}
+
+    def request(self, method: str, url: str, **kwargs: Any) -> Response:
+        headers = dict(self.headers)
+        headers.update(kwargs.pop("headers", {}) or {})
+        return request(method, url, headers=headers, **kwargs)
+
+    def get(self, url: str, **kwargs: Any) -> Response:
+        return self.request("GET", url, **kwargs)
+
+    def post(self, url: str, **kwargs: Any) -> Response:
+        return self.request("POST", url, **kwargs)
+
+    def delete(self, url: str, **kwargs: Any) -> Response:
+        return self.request("DELETE", url, **kwargs)
+
+    def close(self) -> None:
+        return None
+
+    def __enter__(self) -> "Session":
+        return self
+
+    def __exit__(self, exc_type, exc, tb) -> None:
+        self.close()
+
+
+def __getattr__(name: str) -> Any:
+    if _REAL_REQUESTS is not None and hasattr(_REAL_REQUESTS, name):
+        return getattr(_REAL_REQUESTS, name)
+    raise AttributeError(name)
+
+
+__all__ = [
+    "ConnectionError",
+    "HTTPError",
+    "RequestException",
+    "Response",
+    "Session",
+    "Timeout",
+    "TooManyRedirects",
+    "delete",
+    "exceptions",
+    "get",
+    "post",
+    "request",
+]
