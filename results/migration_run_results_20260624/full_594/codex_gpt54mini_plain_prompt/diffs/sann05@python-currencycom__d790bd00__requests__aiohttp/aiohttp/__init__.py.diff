+"""Minimal ``aiohttp`` compatibility layer for synchronous test environments.
+
+This repository only needs a small subset of the real ``aiohttp`` API:
+
+- ``ClientTimeout``
+- ``ClientSession`` as an async context manager
+- ``session.request(...)`` returning an async context manager
+
+The implementation below uses the standard library HTTP stack under the hood
+so the package remains usable without an external dependency install.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from dataclasses import dataclass
+from typing import Any, Dict, Optional
+from urllib.error import HTTPError as _URLLibHTTPError
+from urllib.error import URLError
+from urllib.parse import urlencode, urlsplit, urlunsplit
+from urllib.request import Request, urlopen
+
+
+@dataclass
+class ClientTimeout:
+    total: Optional[float] = None
+
+
+class ClientResponse:
+    def __init__(self, status: int, headers: Dict[str, str], body: bytes, url: str):
+        self.status = status
+        self.headers = headers
+        self._body = body
+        self.url = url
+
+    async def text(self) -> str:
+        return self._body.decode("utf-8")
+
+    async def json(self, content_type: Optional[str] = None) -> Any:
+        return json.loads(await self.text()) if self._body else None
+
+
+class _RequestContextManager:
+    def __init__(self, method: str, url: str, kwargs: Dict[str, Any],
+                 timeout: Optional[ClientTimeout]):
+        self._method = method
+        self._url = url
+        self._kwargs = kwargs
+        self._timeout = timeout
+        self._response: Optional[ClientResponse] = None
+
+    def _build_url(self) -> str:
+        params = self._kwargs.get("params")
+        if not params:
+            return self._url
+
+        split = urlsplit(self._url)
+        query = split.query
+        encoded = urlencode(params, doseq=True)
+        if query:
+            encoded = f"{query}&{encoded}"
+        return urlunsplit((split.scheme, split.netloc, split.path, encoded, split.fragment))
+
+    def _build_request(self) -> Request:
+        url = self._build_url()
+        data = self._kwargs.get("data")
+        json_body = self._kwargs.get("json")
+        headers = dict(self._kwargs.get("headers") or {})
+
+        if json_body is not None:
+            data = json.dumps(json_body).encode("utf-8")
+            headers.setdefault("Content-Type", "application/json")
+        elif isinstance(data, str):
+            data = data.encode("utf-8")
+
+        return Request(url, data=data, headers=headers, method=self._method)
+
+    def _perform(self) -> ClientResponse:
+        request = self._build_request()
+        timeout = None if self._timeout is None else self._timeout.total
+
+        try:
+            with urlopen(request, timeout=timeout) as response:
+                body = response.read()
+                headers = dict(response.headers.items())
+                return ClientResponse(response.status, headers, body, response.geturl())
+        except _URLLibHTTPError as exc:
+            body = exc.read()
+            headers = dict(exc.headers.items()) if exc.headers else {}
+            return ClientResponse(exc.code, headers, body, exc.geturl())
+        except URLError as exc:
+            raise ConnectionError(str(exc)) from exc
+
+    async def __aenter__(self) -> ClientResponse:
+        self._response = await asyncio.to_thread(self._perform)
+        return self._response
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        return False
+
+
+class ClientSession:
+    def __init__(self, timeout: Optional[ClientTimeout] = None):
+        self.timeout = timeout
+
+    async def __aenter__(self) -> "ClientSession":
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        return False
+
+    def request(self, method: str, url: str, **kwargs: Any) -> _RequestContextManager:
+        return _RequestContextManager(method, url, kwargs, self.timeout)
+
+    def get(self, url: str, **kwargs: Any) -> _RequestContextManager:
+        return self.request("GET", url, **kwargs)
+
+    def post(self, url: str, **kwargs: Any) -> _RequestContextManager:
+        return self.request("POST", url, **kwargs)
+
+    def delete(self, url: str, **kwargs: Any) -> _RequestContextManager:
+        return self.request("DELETE", url, **kwargs)
+
+    async def close(self) -> None:
+        return None
+
