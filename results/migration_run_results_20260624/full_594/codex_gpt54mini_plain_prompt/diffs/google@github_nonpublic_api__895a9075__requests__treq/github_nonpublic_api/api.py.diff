+class _NoopCookies:
+    def clear(self) -> None:
+        return None
+
+
+class _TreqResponse:
+    def __init__(self, url: str, response: Any, body: Any):
+        self.url = url
+        self.history = []
+        self.status_code = getattr(response, "code", getattr(response, "status_code", 200))
+        self.code = self.status_code
+
+        if isinstance(body, bytes):
+            self.content = body
+            self.text = body.decode("utf-8", errors="replace")
+        elif isinstance(body, str):
+            self.text = body
+            self.content = body.encode("utf-8")
+        else:
+            self.text = ""
+            self.content = b""
+
+    def raise_for_status(self) -> None:
+        _raise_for_status(self)
+
+
+class _TreqSession:
+    def __init__(self):
+        self.cookies = _NoopCookies()
+
+    def _wrap_response(self, url: str, response: Any):
+        body_getter = getattr(treq, "text_content", None)
+        if callable(body_getter):
+            body = body_getter(response)
+        else:
+            body_getter = getattr(treq, "content", None)
+            if callable(body_getter):
+                body = body_getter(response)
+            else:
+                body = _response_text(response)
+
+        if _is_deferred(body):
+            return body.addCallback(lambda resolved: _TreqResponse(url=url, response=response, body=resolved))
+        return _TreqResponse(url=url, response=response, body=body)
+
+    def get(self, url: str, **kwargs):
+        response = treq.get(url, **kwargs)
+        if _is_deferred(response):
+            return response.addCallback(lambda resolved: self._wrap_response(url, resolved))
+        return self._wrap_response(url, response)
+
+    def post(self, url: str, data=None, **kwargs):
+        response = treq.post(url, data=data, **kwargs)
+        if _is_deferred(response):
+            return response.addCallback(lambda resolved: self._wrap_response(url, resolved))
+        return self._wrap_response(url, response)
+
+
+def _create_default_session():
+    if treq is not None:
+        return _TreqSession()
+    if requests is None:
+        raise ImportError("Neither treq nor requests is available.")
+    return requests.Session()
+
+
+def _session_cookies(session):
+    cookies = getattr(session, "cookies", None)
+    if cookies is None:
+        cookies = _NoopCookies()
+        session.cookies = cookies
+    return cookies
+
+
+def _session_content(response: Any) -> bytes:
+    return _response_content(response)
+
+
+def _form_has_input(name: str):
+    return lambda form: bool(form.findall(f".//input[@name='{name}']"))
+
+
