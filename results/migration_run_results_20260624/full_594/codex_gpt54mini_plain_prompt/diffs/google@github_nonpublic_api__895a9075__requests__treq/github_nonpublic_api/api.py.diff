+def _handle_fetched_form(session, url: str, response, data_callback=None, form_matcher=lambda form: True):
+    _raise_for_status(response)
+    _log_redirects(response)
+    doc = html5lib.parse(_response_text(response), namespaceHTMLElements=False)
+    form = _find_matching_form(doc, form_matcher)
+    return _submit_form(session=session, url=url, form=form, data_callback=data_callback)
