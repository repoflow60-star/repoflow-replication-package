+def _is_deferred(value: Any) -> bool:
+    value_type = type(value)
+    return (
+        value_type.__module__.startswith("twisted.")
+        and value_type.__name__ == "Deferred"
+    )
+
+
+def _raise_for_status(response: Any) -> None:
+    raise_for_status = getattr(response, "raise_for_status", None)
+    if callable(raise_for_status):
+        raise_for_status()
+        return
+
+    status_code = getattr(response, "status_code", getattr(response, "code", None))
+    if status_code is not None and int(status_code) >= 400:
+        raise RuntimeError(f"HTTP {status_code}")
+
+
+def _response_text(response: Any) -> str:
+    text = getattr(response, "text", None)
+    if isinstance(text, str):
+        return text
+
+    content = getattr(response, "content", None)
+    if isinstance(content, bytes):
+        return content.decode("utf-8", errors="replace")
+    if isinstance(content, str):
+        return content
+
+    return ""
+
+
+def _response_content(response: Any) -> bytes:
+    content = getattr(response, "content", None)
+    if isinstance(content, bytes):
+        return content
+    if isinstance(content, str):
+        return content.encode("utf-8")
+
+    text = _response_text(response)
+    return text.encode("utf-8")
 
