+def _get_and_submit_form(session, url: str, data_callback=None, form_matcher=lambda form: True):
+    logging.info("Fetching URL %s", url)
+    response = session.get(url)
+    if _is_deferred(response):
+        return response.addCallback(
+            lambda fetched: _handle_fetched_form(
+                session=session,
+                url=url,
+                response=fetched,
+                data_callback=data_callback,
+                form_matcher=form_matcher,
+            )
+        )
+    return _handle_fetched_form(
+        session=session,
+        url=url,
+        response=response,
+        data_callback=data_callback,
+        form_matcher=form_matcher,
+    )
