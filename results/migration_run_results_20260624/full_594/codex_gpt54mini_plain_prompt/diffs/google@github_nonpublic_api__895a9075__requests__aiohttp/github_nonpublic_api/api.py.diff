+@dataclass
+class _Redirect:
+    url: str
+
+
+@dataclass
+class _CookieStore:
+    cookies: dict[str, str] = field(default_factory=dict)
+
+    def clear(self):
+        self.cookies.clear()
+
+    def update_from_cookie_jar(self, cookie_jar):
+        for name, morsel in cookie_jar.items():
+            self.cookies[name] = morsel.value
+
+
+@dataclass
+class _AiohttpResponse:
+    url: str
+    text: str
+    content: bytes
+    history: list[_Redirect]
+    status: int
+    reason: str
+
+    def raise_for_status(self):
+        if self.status >= 400:
+            raise RuntimeError(
+                f"HTTP {self.status} {self.reason} while fetching {self.url}"
+            )
+
+
+class _AiohttpSession:
+    def __init__(self):
+        self.cookies = _CookieStore()
+
+    def get(self, url: str, **kwargs):
+        return asyncio.run(self._request("GET", url, **kwargs))
+
+    def post(self, url: str, **kwargs):
+        return asyncio.run(self._request("POST", url, **kwargs))
+
+    async def _request(self, method: str, url: str, **kwargs):
+        cookie_jar = aiohttp.CookieJar()
+        if self.cookies.cookies:
+            cookie_jar.update_cookies(self.cookies.cookies)
+
+        async with aiohttp.ClientSession(cookie_jar=cookie_jar) as session:
+            async with session.request(method, url, **kwargs) as response:
+                content = await response.read()
+                text = content.decode(response.charset or "utf-8", errors="replace")
+                self.cookies.update_from_cookie_jar(
+                    session.cookie_jar.filter_cookies(response.url)
+                )
+                return _AiohttpResponse(
+                    url=str(response.url),
+                    text=text,
+                    content=content,
+                    history=[_Redirect(url=str(item.url)) for item in response.history],
+                    status=response.status,
+                    reason=response.reason,
+                )
+
