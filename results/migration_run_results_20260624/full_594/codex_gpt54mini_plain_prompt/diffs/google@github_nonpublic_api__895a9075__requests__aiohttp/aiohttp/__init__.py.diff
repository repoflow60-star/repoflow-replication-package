@@ -0,0 +1,179 @@
+"""Minimal local aiohttp compatibility layer for this repository."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from http.cookies import SimpleCookie
+from typing import Any, Optional
+from urllib import error as urllib_error
+from urllib import parse as urllib_parse
+from urllib import request as urllib_request
+
+__version__ = "local"
+
+
+class ClientResponseError(RuntimeError):
+    pass
+
+
+class CookieJar:
+    def __init__(self):
+        self._cookies: dict[str, str] = {}
+
+    def clear(self):
+        self._cookies.clear()
+
+    def update_cookies(self, cookies):
+        if cookies is None:
+            return
+
+        items = cookies.items() if hasattr(cookies, "items") else cookies
+        for name, value in items:
+            if hasattr(value, "value"):
+                value = value.value
+            self._cookies[name] = str(value)
+
+    def filter_cookies(self, url=None):
+        cookie = SimpleCookie()
+        for name, value in self._cookies.items():
+            cookie[name] = value
+        return cookie
+
+
+@dataclass
+class _ResponseInfo:
+    real_url: str
+
+
+class _Response:
+    def __init__(
+        self,
+        url: str,
+        status: int,
+        reason: str,
+        headers: Any,
+        body: bytes,
+    ):
+        self.url = url
+        self.status = status
+        self.reason = reason
+        self.headers = headers
+        self.content = body
+        self.charset = self._resolve_charset(headers)
+        self.history = []
+        self.cookies = SimpleCookie()
+        self.request_info = _ResponseInfo(real_url=url)
+        self._set_cookies(headers)
+
+    @staticmethod
+    def _resolve_charset(headers):
+        content_type = headers.get("Content-Type", "")
+        for part in content_type.split(";"):
+            part = part.strip()
+            if part.lower().startswith("charset="):
+                return part.split("=", 1)[1].strip()
+        return "utf-8"
+
+    def _set_cookies(self, headers):
+        set_cookie_headers = []
+        if hasattr(headers, "get_all"):
+            set_cookie_headers = headers.get_all("Set-Cookie", [])
+        elif hasattr(headers, "get"):
+            value = headers.get("Set-Cookie")
+            if value:
+                set_cookie_headers = [value]
+
+        for header in set_cookie_headers:
+            parsed = SimpleCookie()
+            parsed.load(header)
+            for name, morsel in parsed.items():
+                self.cookies[name] = morsel.value
+
+    async def read(self):
+        return self.content
+
+    async def text(self):
+        return self.content.decode(self.charset or "utf-8", errors="replace")
+
+    def raise_for_status(self):
+        if self.status >= 400:
+            raise ClientResponseError(f"HTTP {self.status} {self.reason} for {self.url}")
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+
+class _RequestContextManager:
+    def __init__(self, response: _Response):
+        self._response = response
+
+    async def __aenter__(self):
+        return self._response
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+
+class ClientSession:
+    def __init__(self, cookie_jar: Optional[CookieJar] = None):
+        self.cookie_jar = cookie_jar or CookieJar()
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+    def close(self):
+        return None
+
+    def _build_request(self, method: str, url: str, **kwargs):
+        data = kwargs.get("data")
+        headers = dict(kwargs.get("headers", {}))
+        if self.cookie_jar._cookies:
+            headers["Cookie"] = "; ".join(
+                f"{name}={value}" for name, value in self.cookie_jar._cookies.items()
+            )
+
+        body = None
+        if data is not None:
+            if isinstance(data, (bytes, bytearray)):
+                body = bytes(data)
+            elif isinstance(data, str):
+                body = data.encode("utf-8")
+            else:
+                body = urllib_parse.urlencode(data).encode("utf-8")
+            headers.setdefault(
+                "Content-Type", "application/x-www-form-urlencoded"
+            )
+
+        request = urllib_request.Request(url, data=body, headers=headers, method=method)
+        return request
+
+    def request(self, method: str, url: str, **kwargs):
+        request = self._build_request(method, url, **kwargs)
+        try:
+            response = urllib_request.urlopen(request)
+            body = response.read()
+            status = response.getcode()
+            reason = getattr(response, "reason", "OK")
+            headers = response.headers
+            final_url = response.geturl()
+        except urllib_error.HTTPError as error:
+            body = error.read()
+            status = error.code
+            reason = error.reason
+            headers = error.headers
+            final_url = error.geturl()
+        response_obj = _Response(
+            url=final_url,
+            status=status,
+            reason=reason,
+            headers=headers,
+            body=body,
+        )
+        self.cookie_jar.update_cookies(response_obj.cookies.items())
+        return _RequestContextManager(response_obj)
