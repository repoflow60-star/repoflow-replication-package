@@ -0,0 +1,58 @@
+"""Compatibility exceptions for the migrated HTTP client."""
+
+from types import ModuleType
+
+from urllib3.exceptions import HTTPError as Urllib3HTTPError
+
+
+class RequestException(Urllib3HTTPError):
+    """Base compatibility exception for request failures."""
+
+
+class HTTPError(RequestException):
+    """Compatibility HTTP error with a requests-like response payload."""
+
+    def __init__(self, response=None, message=None):
+        self.response = response
+        if message is None and response is not None:
+            message = f'{response.status_code} {response.reason}'
+        super().__init__(message)
+
+
+class ConnectionError(RequestException):
+    """Compatibility connection error."""
+
+
+class Timeout(RequestException):
+    """Compatibility timeout error."""
+
+
+class ConnectTimeout(Timeout, ConnectionError):
+    """Compatibility connect timeout error."""
+
+
+class InvalidURL(RequestException):
+    """Compatibility invalid URL error."""
+
+
+def build_requests_shim():
+    """Build a minimal requests module shim used by the tests."""
+    requests_module = ModuleType('requests')
+    exceptions_module = ModuleType('requests.exceptions')
+
+    exceptions_module.RequestException = RequestException
+    exceptions_module.HTTPError = HTTPError
+    exceptions_module.ConnectionError = ConnectionError
+    exceptions_module.Timeout = Timeout
+    exceptions_module.ConnectTimeout = ConnectTimeout
+    exceptions_module.InvalidURL = InvalidURL
+
+    requests_module.exceptions = exceptions_module
+    requests_module.RequestException = RequestException
+    requests_module.HTTPError = HTTPError
+    requests_module.ConnectionError = ConnectionError
+    requests_module.Timeout = Timeout
+    requests_module.ConnectTimeout = ConnectTimeout
+    requests_module.InvalidURL = InvalidURL
+
+    return requests_module, exceptions_module
