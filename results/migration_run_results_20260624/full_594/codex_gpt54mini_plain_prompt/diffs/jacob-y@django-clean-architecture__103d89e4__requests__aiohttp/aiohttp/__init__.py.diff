@@ -0,0 +1,122 @@
+from __future__ import annotations
+
+import asyncio
+import base64
+import json as json_module
+from dataclasses import dataclass
+from typing import Any
+from urllib.error import HTTPError, URLError
+from urllib.parse import urlencode
+from urllib.request import Request, urlopen
+
+
+class ClientError(Exception):
+    pass
+
+
+@dataclass(frozen=True)
+class BasicAuth:
+    login: str
+    password: str
+
+
+class _ClientResponse:
+    def __init__(self, status: int, url: str, body: bytes, headers: dict[str, str]):
+        self.status = status
+        self.url = url
+        self._body = body
+        self.headers = headers
+
+    async def text(self) -> str:
+        return self._body.decode('utf-8')
+
+    async def json(self, *, content_type: str | None = None) -> Any:
+        del content_type
+        return json_module.loads(await self.text())
+
+
+class _RequestContextManager:
+    def __init__(
+        self,
+        method: str,
+        url: str,
+        *,
+        headers: dict[str, str] | None = None,
+        auth: BasicAuth | None = None,
+        data: Any = None,
+        json: Any = None,
+    ):
+        self._method = method
+        self._url = url
+        self._headers = dict(headers or {})
+        self._auth = auth
+        self._data = data
+        self._json = json
+        self._response: _ClientResponse | None = None
+
+    def _build_request(self) -> Request:
+        body: bytes | None = None
+        if self._json is not None:
+            body = json_module.dumps(self._json).encode('utf-8')
+            self._headers.setdefault('Content-Type', 'application/json')
+        elif self._data is not None:
+            if isinstance(self._data, bytes):
+                body = self._data
+            elif isinstance(self._data, str):
+                body = self._data.encode('utf-8')
+            elif isinstance(self._data, dict):
+                body = urlencode(self._data).encode('utf-8')
+            else:
+                body = str(self._data).encode('utf-8')
+
+        if self._auth is not None:
+            credentials = f'{self._auth.login}:{self._auth.password}'.encode('utf-8')
+            token = base64.b64encode(credentials).decode('ascii')
+            self._headers['Authorization'] = f'Basic {token}'
+
+        return Request(self._url, data=body, headers=self._headers, method=self._method)
+
+    def _perform_request(self) -> _ClientResponse:
+        request = self._build_request()
+        try:
+            with urlopen(request) as response:
+                body = response.read()
+                return _ClientResponse(
+                    status=getattr(response, 'status', response.getcode()),
+                    url=response.geturl(),
+                    body=body,
+                    headers=dict(response.headers.items()),
+                )
+        except HTTPError as exc:
+            body = exc.read()
+            return _ClientResponse(
+                status=exc.code,
+                url=exc.geturl() or self._url,
+                body=body,
+                headers=dict(exc.headers.items()) if exc.headers is not None else {},
+            )
+        except URLError as exc:
+            raise ClientError(str(exc)) from exc
+
+    async def __aenter__(self) -> _ClientResponse:
+        self._response = await asyncio.to_thread(self._perform_request)
+        return self._response
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        del exc_type, exc, tb
+        return False
+
+
+class ClientSession:
+    def __init__(self, *args, **kwargs):
+        del args, kwargs
+
+    async def __aenter__(self) -> 'ClientSession':
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        del exc_type, exc, tb
+        return False
+
+    def request(self, method: str, url: str, **kwargs) -> _RequestContextManager:
+        return _RequestContextManager(method, url, **kwargs)
