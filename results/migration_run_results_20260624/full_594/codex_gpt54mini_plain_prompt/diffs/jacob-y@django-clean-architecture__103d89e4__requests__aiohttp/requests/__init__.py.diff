+from __future__ import annotations
+
+import asyncio
+import threading
+from typing import Any
+
+from aiohttp import BasicAuth, ClientError, ClientSession
+
+from .exceptions import RequestException
+
+
+class Response:
+    def __init__(self, json_data: Any, status_code: int, url: str):
+        self.json_data = json_data
+        self.status_code = status_code
+        self.url = url
+
+    def json(self):
+        return self.json_data
+
+
+def _run(coro):
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coro)
+
+    result: list[Any] = []
+    error: list[BaseException] = []
+
+    def runner():
+        try:
+            result.append(asyncio.run(coro))
+        except BaseException as exc:  # pragma: no cover - propagated to caller
+            error.append(exc)
+
+    thread = threading.Thread(target=runner, daemon=True)
+    thread.start()
+    thread.join()
+    if error:
+        raise error[0]
+    return result[0]
+
+
+async def _request(method: str, url: str, **kwargs) -> Response:
+    headers = kwargs.get('headers')
+    auth = kwargs.get('auth')
+    data = kwargs.get('data')
+    json_data = kwargs.get('json')
+
+    aio_auth = BasicAuth(*auth) if auth is not None else None
+
+    try:
+        async with ClientSession() as session:
+            async with session.request(
+                method,
+                url,
+                headers=headers,
+                auth=aio_auth,
+                data=data,
+                json=json_data,
+            ) as response:
+                try:
+                    parsed = await response.json(content_type=None)
+                except Exception:
+                    parsed = None
+                return Response(parsed, response.status, response.url)
+    except ClientError as exc:
+        raise RequestException(str(exc)) from exc
+
+
+def get(url: str, **kwargs) -> Response:
+    return _run(_request('GET', url, **kwargs))
+
+
+def post(url: str, **kwargs) -> Response:
+    return _run(_request('POST', url, **kwargs))
