+"""Compatibility shim for the subset of the requests API this project uses.
+
+This package is intentionally small: it keeps the existing call sites and test
+patch targets working while routing HTTP traffic through urllib3.
+"""
+
+from __future__ import annotations
+
+import json as _json
+from dataclasses import dataclass
+from typing import Any, Mapping, MutableMapping, Optional
+from urllib.parse import parse_qsl, urlencode, urlsplit, urlunsplit
+
+import urllib3
+
+from .utils import cookiejar_from_dict
+
+
+def _cookie_header(cookies: Any) -> str:
+    if not cookies:
+        return ""
+    if isinstance(cookies, Mapping):
+        items = cookies.items()
+    else:
+        items = getattr(cookies, "items", lambda: [])()
+    return "; ".join(f"{key}={value}" for key, value in items)
+
+
+def _merge_params(url: str, params: Optional[Mapping[str, Any]]) -> str:
+    if not params:
+        return url
+    parts = urlsplit(url)
+    query = parse_qsl(parts.query, keep_blank_values=True)
+    query.extend(params.items())
+    return urlunsplit(
+        (
+            parts.scheme,
+            parts.netloc,
+            parts.path,
+            urlencode(query, doseq=True),
+            parts.fragment,
+        )
+    )
+
+
+def _decode_content_type(content_type: str) -> str:
+    for part in content_type.split(";"):
+        part = part.strip()
+        if part.startswith("charset="):
+            return part.split("=", 1)[1].strip("\"'")
+    return "utf-8"
+
+
+@dataclass
+class Response:
+    _raw: urllib3.response.HTTPResponse
+
+    @property
+    def status_code(self) -> int:
+        return int(self._raw.status)
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status_code < 400
+
+    @property
+    def content(self) -> bytes:
+        data = self._raw.data
+        return data if isinstance(data, bytes) else bytes(data or b"")
+
+    @property
+    def text(self) -> str:
+        content_type = self._raw.headers.get("content-type", "")
+        encoding = _decode_content_type(content_type)
+        return self.content.decode(encoding, errors="replace")
+
+    def json(self) -> Any:
+        return _json.loads(self.text)
+
+    def __str__(self) -> str:
+        return f"<Response [{self.status_code}]>"
+
+
+class Session:
+    def __init__(self) -> None:
+        self.headers: MutableMapping[str, str] = {}
+        self.cookies: MutableMapping[str, str] = {}
+        self._pool = urllib3.PoolManager()
+
+    def request(
+        self,
+        method: str,
+        url: str,
+        params: Optional[Mapping[str, Any]] = None,
+        data: Any = None,
+        json: Any = None,
+        headers: Optional[Mapping[str, str]] = None,
+        timeout: Any = None,
+        retries: Any = False,
+        **kwargs: Any,
+    ) -> Response:
+        del kwargs
+        request_url = _merge_params(url, params)
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+        cookie_header = _cookie_header(self.cookies)
+        if cookie_header and "Cookie" not in request_headers:
+            request_headers["Cookie"] = cookie_header
+
+        body = data
+        if json is not None:
+            body = _json.dumps(json).encode("utf-8")
+            request_headers.setdefault("Content-Type", "application/json")
+        elif isinstance(body, str):
+            body = body.encode("utf-8")
+
+        response = self._pool.request(
+            method.upper(),
+            request_url,
+            body=body,
+            headers=request_headers,
+            timeout=timeout,
+            retries=retries,
+            preload_content=True,
+        )
+        return Response(response)
+
+    def get(self, url: str, **kwargs: Any) -> Response:
+        return self.request("GET", url, **kwargs)
+
+    def post(self, url: str, **kwargs: Any) -> Response:
+        return self.request("POST", url, **kwargs)
+
+    def close(self) -> None:
+        self._pool.clear()
+
+
+__all__ = ["Session", "Response", "cookiejar_from_dict"]
