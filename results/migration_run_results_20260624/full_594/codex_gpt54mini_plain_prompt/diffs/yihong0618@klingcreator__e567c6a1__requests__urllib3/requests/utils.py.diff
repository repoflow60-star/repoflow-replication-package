+from __future__ import annotations
+
+from typing import Any, MutableMapping, Optional
+
+
+def cookiejar_from_dict(
+    cookie_dict: Optional[MutableMapping[str, str]] = None,
+    cookiejar: Optional[MutableMapping[str, str]] = None,
+    overwrite: bool = True,
+    **_: Any,
+):
+    jar: MutableMapping[str, str]
+    if cookiejar is None:
+        jar = {}
+    else:
+        jar = cookiejar
+
+    if not cookie_dict:
+        return jar
+
+    for key, value in cookie_dict.items():
+        if overwrite or key not in jar:
+            jar[key] = value
+    return jar
