+from concurrent.futures import ThreadPoolExecutor
+
+import requests
+
+
+class FuturesSession:
+    """Minimal futures-backed session compatible with requests_futures usage."""
+
+    def __init__(self, session=None, executor=None, max_workers=1):
+        self.session = session or requests.Session()
+        self.executor = executor or ThreadPoolExecutor(max_workers=max_workers)
+
+    def request(self, method, url, **kwargs):
+        return self.executor.submit(self.session.request, method, url, **kwargs)
+
+    def get(self, url, **kwargs):
+        return self.request("GET", url, **kwargs)
+
+    def post(self, url, **kwargs):
+        return self.request("POST", url, **kwargs)
+
+    def close(self):
+        self.session.close()
+        self.executor.shutdown(wait=False, cancel_futures=True)
