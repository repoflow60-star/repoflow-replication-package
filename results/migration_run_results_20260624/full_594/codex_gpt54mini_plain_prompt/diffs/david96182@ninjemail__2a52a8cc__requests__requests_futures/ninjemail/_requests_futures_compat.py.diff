@@ -0,0 +1,28 @@
+"""Compatibility helpers for routing requests calls through requests_futures."""
+
+from requests_futures.sessions import FuturesSession
+import requests as _requests
+
+_session = FuturesSession()
+
+
+def _result(call, *args, **kwargs):
+    return call(*args, **kwargs).result()
+
+
+def _get(*args, **kwargs):
+    return _result(_session.get, *args, **kwargs)
+
+
+def _post(*args, **kwargs):
+    return _result(_session.post, *args, **kwargs)
+
+
+def install():
+    """Patch the imported requests module to use FuturesSession-backed calls."""
+    if getattr(_requests, "_ninjemail_futures_installed", False):
+        return
+
+    _requests.get = _get
+    _requests.post = _post
+    _requests._ninjemail_futures_installed = True
