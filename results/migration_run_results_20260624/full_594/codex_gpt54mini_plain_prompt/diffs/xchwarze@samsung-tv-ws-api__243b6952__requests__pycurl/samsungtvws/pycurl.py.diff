+"""
+Minimal pycurl-compatible adapter used when the real library is unavailable.
+
+This keeps the REST client working in environments where pycurl is not
+installed, while preserving the pycurl-style call sites in the codebase.
+"""
+
+from __future__ import annotations
+
+import ssl
+import urllib.error
+import urllib.request
+from typing import Any, Dict, Optional
+
+URL = object()
+WRITEFUNCTION = object()
+SSL_VERIFYPEER = object()
+SSL_VERIFYHOST = object()
+TIMEOUT_MS = object()
+POST = object()
+CUSTOMREQUEST = object()
+
+
+class error(Exception):
+    """Compatibility exception matching pycurl.error."""
+
+
+class Curl:
+    def __init__(self) -> None:
+        self._options: Dict[object, Any] = {}
+
+    def setopt(self, option: object, value: Any) -> None:
+        self._options[option] = value
+
+    def perform(self) -> None:
+        url = self._options.get(URL)
+        if not url:
+            raise error("URL not set")
+
+        method = "GET"
+        if CUSTOMREQUEST in self._options:
+            method = str(self._options[CUSTOMREQUEST])
+        elif self._options.get(POST):
+            method = "POST"
+
+        request_data = b"" if method == "POST" else None
+        request = urllib.request.Request(url, data=request_data, method=method)
+
+        timeout_ms = self._options.get(TIMEOUT_MS)
+        timeout: Optional[float] = None
+        if timeout_ms is not None:
+            timeout = float(timeout_ms) / 1000.0
+
+        context: Optional[ssl.SSLContext] = None
+        if str(url).startswith("https://"):
+            context = ssl.create_default_context()
+            verify_peer = bool(self._options.get(SSL_VERIFYPEER, True))
+            verify_host = bool(self._options.get(SSL_VERIFYHOST, True))
+            if not verify_peer or not verify_host:
+                context.check_hostname = False
+                context.verify_mode = ssl.CERT_NONE
+
+        try:
+            with urllib.request.urlopen(
+                request,
+                timeout=timeout,
+                context=context,
+            ) as response:
+                body = response.read()
+        except urllib.error.HTTPError as err:
+            body = err.read()
+        except (urllib.error.URLError, OSError) as err:
+            raise error(str(err)) from err
+
+        write_function = self._options.get(WRITEFUNCTION)
+        if write_function is None:
+            return
+        if not callable(write_function):
+            raise error("WRITEFUNCTION must be callable")
+        write_function(body)
+
+    def close(self) -> None:
+        self._options.clear()
