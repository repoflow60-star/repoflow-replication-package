+"""Compatibility shim for the subset of jsonschema used by this repo."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Dict, Optional
+
+from . import exceptions
+
+
+@dataclass
+class RefResolver:
+    """Minimal stand-in for jsonschema.RefResolver.
+
+    The test suite only instantiates this object; it does not call into the
+    resolver implementation, so we only preserve the constructor surface.
+    """
+
+    base_uri: str
+    referrer: Dict[str, Any]
+
+
+class Draft4Validator:
+    """Minimal validator wrapper that delegates to Cerberus-backed checks."""
+
+    def __init__(self, schema: Dict[str, Any], resolver: Optional[RefResolver] = None):
+        self.schema = schema
+        self.resolver = resolver
+
+    def validate(self, document: Dict[str, Any]) -> None:
+        from olclient.validation import validate_document
+
+        schema_name = {
+            "Open Library Import Schema": "import.schema.json",
+        }.get(self.schema.get("title"))
+
+        if schema_name is None:
+            raise NotImplementedError(
+                "This compatibility shim only supports the import schema used by tests"
+            )
+
+        return validate_document(document, schema_name)
+
+
+ValidationError = exceptions.ValidationError
+
