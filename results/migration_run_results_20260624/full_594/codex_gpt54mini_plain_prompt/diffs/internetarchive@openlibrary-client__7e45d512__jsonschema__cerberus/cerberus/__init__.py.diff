+"""Minimal Cerberus-compatible validator used by this repository."""
+
+from __future__ import annotations
+
+import re
+from typing import Any, Dict, List, Tuple
+
+
+def _is_number(value: Any) -> bool:
+    return isinstance(value, (int, float)) and not isinstance(value, bool)
+
+
+class Validator:
+    def __init__(self, schema: Dict[str, Any], allow_unknown: bool = False):
+        self.schema = schema
+        self.allow_unknown = allow_unknown
+        self.errors: Dict[str, Any] = {}
+
+    def validate(self, document: Dict[str, Any]) -> bool:
+        self.errors = {}
+        self._validate_dict(document, self.schema, self.allow_unknown, self.errors)
+        return not self.errors
+
+    def _validate_dict(
+        self,
+        document: Any,
+        schema: Dict[str, Any],
+        allow_unknown: bool,
+        errors: Dict[str, Any],
+    ) -> None:
+        if not isinstance(document, dict):
+            errors.setdefault("_schema", []).append("must be a dict")
+            return
+
+        for field_name, field_rule in schema.items():
+            if field_name not in document:
+                if field_rule.get("required"):
+                    errors.setdefault(field_name, []).append("required field")
+                continue
+            field_errors = self._validate_value(document[field_name], field_rule)
+            if field_errors:
+                errors[field_name] = field_errors
+
+        if not allow_unknown:
+            unknown_fields = [key for key in document.keys() if key not in schema]
+            if unknown_fields:
+                errors.setdefault("_unknown", []).extend(
+                    [f"unknown field: {key}" for key in unknown_fields]
+                )
+
+        keysrules = schema.get("keysrules")
+        valuesrules = schema.get("valuesrules")
+        if keysrules is not None or valuesrules is not None:
+            for key, value in document.items():
+                if keysrules is not None:
+                    key_errors = self._validate_value(key, keysrules)
+                    if key_errors:
+                        errors.setdefault("_keys", {})[key] = key_errors
+                if valuesrules is not None:
+                    value_errors = self._validate_value(value, valuesrules)
+                    if value_errors:
+                        errors.setdefault("_values", {})[key] = value_errors
+
+    def _validate_value(self, value: Any, rule: Dict[str, Any]) -> Any:
+        errors: Any = []
+
+        expected_type = rule.get("type")
+        if expected_type == "string":
+            if not isinstance(value, str):
+                return ["must be of string type"]
+        elif expected_type == "number":
+            if not _is_number(value):
+                return ["must be of number type"]
+        elif expected_type == "list":
+            if not isinstance(value, list):
+                return ["must be of list type"]
+        elif expected_type == "dict":
+            if not isinstance(value, dict):
+                return ["must be of dict type"]
+        elif expected_type is not None:
+            return [f"unsupported type: {expected_type}"]
+
+        allowed = rule.get("allowed")
+        if allowed is not None and value not in allowed:
+            return [f"unallowed value: {value!r}"]
+
+        regex = rule.get("regex")
+        if regex is not None and isinstance(value, str):
+            if re.fullmatch(regex, value) is None:
+                return [f"value does not match regex: {regex}"]
+
+        if expected_type == "list":
+            minimum = rule.get("min")
+            maximum = rule.get("max")
+            if minimum is not None and len(value) < minimum:
+                errors.append(f"min length is {minimum}")
+            if maximum is not None and len(value) > maximum:
+                errors.append(f"max length is {maximum}")
+            item_rule = rule.get("schema")
+            if item_rule is not None:
+                item_errors: Dict[str, Any] = {}
+                for index, item in enumerate(value):
+                    nested_errors = self._validate_value(item, item_rule)
+                    if nested_errors:
+                        item_errors[str(index)] = nested_errors
+                if item_errors:
+                    errors.append(item_errors)
+
+        if expected_type == "dict":
+            nested_schema = rule.get("schema")
+            allow_unknown = rule.get("allow_unknown", False)
+            if nested_schema is not None:
+                nested_errors: Dict[str, Any] = {}
+                self._validate_dict(value, nested_schema, allow_unknown, nested_errors)
+                if nested_errors:
+                    errors.append(nested_errors)
+            elif not allow_unknown and not (rule.get("keysrules") or rule.get("valuesrules")) and value:
+                errors.append("unknown keys are not allowed")
+
+            keysrules = rule.get("keysrules")
+            valuesrules = rule.get("valuesrules")
+            if keysrules is not None or valuesrules is not None:
+                kv_errors: Dict[str, Any] = {}
+                for key, item in value.items():
+                    if keysrules is not None:
+                        key_errors = self._validate_value(key, keysrules)
+                        if key_errors:
+                            kv_errors.setdefault("_keys", {})[key] = key_errors
+                    if valuesrules is not None:
+                        item_errors = self._validate_value(item, valuesrules)
+                        if item_errors:
+                            kv_errors.setdefault("_values", {})[key] = item_errors
+                if kv_errors:
+                    errors.append(kv_errors)
+
+        if errors:
+            return errors
+        return []
