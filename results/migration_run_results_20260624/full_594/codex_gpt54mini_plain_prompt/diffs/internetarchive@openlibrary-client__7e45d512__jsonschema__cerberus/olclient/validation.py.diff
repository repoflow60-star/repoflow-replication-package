+"""Cerberus-backed validation for Open Library documents."""
+
+from __future__ import annotations
+
+import copy
+from typing import Any, Dict
+
+from cerberus import Validator
+from jsonschema.exceptions import ValidationError
+
+
+def _dict_rule(
+    schema: Dict[str, Any] | None = None,
+    *,
+    allow_unknown: bool = False,
+) -> Dict[str, Any]:
+    rule: Dict[str, Any] = {"type": "dict"}
+    if schema is not None:
+        rule["schema"] = schema
+    if allow_unknown:
+        rule["allow_unknown"] = True
+    return rule
+
+
+def _list_rule(item_rule: Dict[str, Any] | None = None, *, min_items: int | None = None, max_items: int | None = None) -> Dict[str, Any]:
+    rule: Dict[str, Any] = {"type": "list"}
+    if item_rule is not None:
+        rule["schema"] = item_rule
+    if min_items is not None:
+        rule["min"] = min_items
+    if max_items is not None:
+        rule["max"] = max_items
+    return rule
+
+
+STRING_RULE: Dict[str, Any] = {"type": "string"}
+NUMBER_RULE: Dict[str, Any] = {"type": "number"}
+
+TEXT_BLOCK_RULE: Dict[str, Any] = _dict_rule(
+    {
+        "type": {"type": "string", "allowed": ["/type/text"], "required": True},
+        "value": {"type": "string", "required": True},
+    }
+)
+
+INTERNAL_DATETIME_RULE: Dict[str, Any] = _dict_rule(
+    {
+        "type": {"type": "string", "allowed": ["/type/datetime"], "required": True},
+        "value": {"type": "string", "required": True},
+    }
+)
+
+LINK_RULE: Dict[str, Any] = _dict_rule(
+    {
+        "url": {"type": "string", "required": True},
+        "title": {"type": "string", "required": True},
+        "type": _dict_rule(
+            {
+                "key": {
+                    "type": "string",
+                    "allowed": ["/type/link"],
+                    "required": True,
+                }
+            }
+        ),
+    }
+)
+
+AUTHOR_RULE: Dict[str, Any] = _dict_rule(
+    {
+        "key": {
+            "type": "string",
+            "regex": r"^/authors/OL[0-9]+A$",
+            "required": True,
+        }
+    }
+)
+
+WORK_KEY_RULE: Dict[str, Any] = {"type": "string", "regex": r"^/works/OL[0-9]+W$"}
+EDITION_KEY_RULE: Dict[str, Any] = {"type": "string", "regex": r"^/books/OL[0-9]+M$"}
+
+STRING_ARRAY_RULE: Dict[str, Any] = _list_rule(STRING_RULE)
+
+LC_CLASSIFICATION_RULE: Dict[str, Any] = {
+    "type": "string",
+}
+
+PUBLISH_COUNTRY_RULE: Dict[str, Any] = {
+    "type": "string",
+    "regex": r"^[a-z]{2,3}$",
+}
+
+LANGUAGE_CODE_RULE: Dict[str, Any] = {
+    "type": "string",
+    "regex": r"^[a-z]{3}$",
+}
+
+
+WORK_SCHEMA: Dict[str, Any] = {
+    "key": {**WORK_KEY_RULE, "required": True},
+    "title": {**STRING_RULE, "required": True},
+    "subtitle": STRING_RULE,
+    "type": {**_dict_rule(
+        {
+            "key": {
+                "type": "string",
+                "allowed": ["/type/work"],
+                "required": True,
+            }
+        }
+    ), "required": True},
+    "authors": _list_rule(
+        _dict_rule(
+            {
+                "type": {
+                    "type": "dict",
+                    "required": True,
+                    "schema": {
+                        "key": {
+                            "type": "string",
+                            "allowed": ["/type/author_role"],
+                            "required": True,
+                        }
+                    },
+                },
+                "author": {
+                    "type": "dict",
+                    "required": True,
+                    "schema": {"key": AUTHOR_RULE["schema"]["key"]},
+                },
+                "role": STRING_RULE,
+                "as": STRING_RULE,
+            }
+        )
+    ),
+    "covers": _list_rule(NUMBER_RULE),
+    "links": _list_rule(LINK_RULE),
+    "id": NUMBER_RULE,
+    "lc_classifications": STRING_ARRAY_RULE,
+    "subjects": STRING_ARRAY_RULE,
+    "first_publish_date": STRING_RULE,
+    "description": TEXT_BLOCK_RULE,
+    "notes": TEXT_BLOCK_RULE,
+    "revision": {**NUMBER_RULE, "required": True},
+    "latest_revision": NUMBER_RULE,
+    "created": INTERNAL_DATETIME_RULE,
+    "last_modified": {**INTERNAL_DATETIME_RULE, "required": True},
+}
+
+
+EDITION_SCHEMA: Dict[str, Any] = {
+    "key": {**EDITION_KEY_RULE, "required": True},
+    "title": {**STRING_RULE, "required": True},
+    "subtitle": STRING_RULE,
+    "type": {**_dict_rule(
+        {
+            "key": {
+                "type": "string",
+                "allowed": ["/type/edition"],
+                "required": True,
+            }
+        }
+    ), "required": True},
+    "authors": _list_rule(_dict_rule({"key": {"type": "string", "regex": r"^/authors/OL[0-9]+A$", "required": True}})),
+    "works": {**_list_rule(
+        _dict_rule({"key": {"type": "string", "regex": r"^/works/OL[0-9]+W$", "required": True}})
+    , min_items=1, max_items=1), "required": True},
+    "identifiers": {"type": "dict"},
+    "isbn_10": _list_rule({"type": "string", "regex": r"^([0-9][- ]*){9}[0-9X]$"}),
+    "isbn_13": _list_rule({"type": "string", "regex": r"^([0-9][- ]*){13}$"}),
+    "lccn": _list_rule({"type": "string", "regex": r"^[a-z]{,3}[0-9]+$"}),
+    "ocaid": {"type": "string", "regex": r"^[^ ]{,50}$"},
+    "oclc_numbers": _list_rule({"type": "string", "regex": r"^[0-9]+$"}),
+    "local_id": STRING_ARRAY_RULE,
+    "covers": _list_rule(NUMBER_RULE),
+    "links": _list_rule(LINK_RULE),
+    "languages": _list_rule(_dict_rule({"key": {"type": "string", "regex": r"^/languages/[a-z]{3}$", "required": True}})),
+    "translated_from": _list_rule(
+        _dict_rule({"key": {"type": "string", "regex": r"^/languages/[a-z]{3}$", "required": True}})
+    ),
+    "translation_of": STRING_RULE,
+    "by_statement": STRING_RULE,
+    "weight": STRING_RULE,
+    "edition_name": STRING_RULE,
+    "number_of_pages": NUMBER_RULE,
+    "pagination": STRING_RULE,
+    "physical_dimensions": STRING_RULE,
+    "physical_format": STRING_RULE,
+    "copyright_date": STRING_RULE,
+    "publish_country": PUBLISH_COUNTRY_RULE,
+    "publish_date": STRING_RULE,
+    "publish_places": STRING_ARRAY_RULE,
+    "publishers": STRING_ARRAY_RULE,
+    "contributions": STRING_ARRAY_RULE,
+    "dewey_decimal_class": STRING_ARRAY_RULE,
+    "genres": STRING_ARRAY_RULE,
+    "lc_classifications": _list_rule(LC_CLASSIFICATION_RULE),
+    "other_titles": STRING_ARRAY_RULE,
+    "series": STRING_ARRAY_RULE,
+    "source_records": STRING_ARRAY_RULE,
+    "subjects": STRING_ARRAY_RULE,
+    "work_titles": STRING_ARRAY_RULE,
+    "table_of_contents": {"type": "list"},
+    "description": TEXT_BLOCK_RULE,
+    "first_sentence": TEXT_BLOCK_RULE,
+    "notes": TEXT_BLOCK_RULE,
+    "revision": {**NUMBER_RULE, "required": True},
+    "latest_revision": NUMBER_RULE,
+    "created": INTERNAL_DATETIME_RULE,
+    "last_modified": {**INTERNAL_DATETIME_RULE, "required": True},
+}
+
+
+AUTHOR_SCHEMA: Dict[str, Any] = {
+    "key": {**AUTHOR_RULE["schema"]["key"], "required": True},
+    "name": {**STRING_RULE, "required": True},
+    "type": {**_dict_rule(
+        {
+            "key": {
+                "type": "string",
+                "allowed": ["/type/author"],
+                "required": True,
+            }
+        }
+    ), "required": True},
+    "alternate_names": STRING_ARRAY_RULE,
+    "bio": TEXT_BLOCK_RULE,
+    "birth_date": STRING_RULE,
+    "death_date": STRING_RULE,
+    "location": STRING_RULE,
+    "date": STRING_RULE,
+    "entity_type": {"type": "string", "allowed": ["person", "org", "event"]},
+    "fuller_name": STRING_RULE,
+    "personal_name": STRING_RULE,
+    "title": STRING_RULE,
+    "photos": _list_rule(NUMBER_RULE),
+    "links": _list_rule(LINK_RULE),
+    "remote_ids": _dict_rule(
+        {
+            "wikidata": {"type": "string", "regex": r"^Q[0-9]+$"},
+            "viaf": {"type": "string", "regex": r"^[0-9]+$"},
+        },
+        allow_unknown=True,
+    ),
+    "wikipedia": STRING_RULE,
+    "revision": {**NUMBER_RULE, "required": True},
+    "latest_revision": NUMBER_RULE,
+    "created": INTERNAL_DATETIME_RULE,
+    "last_modified": {**INTERNAL_DATETIME_RULE, "required": True},
+}
+
+
+IMPORT_SCHEMA: Dict[str, Any] = {
+    "title": {**STRING_RULE, "required": True},
+    "subtitle": STRING_RULE,
+    "source_records": {**STRING_ARRAY_RULE, "required": True},
+    "publishers": {**STRING_ARRAY_RULE, "required": True},
+    "authors": {**_list_rule(
+        _dict_rule(
+            {
+                "name": {"type": "string", "required": True},
+                "personal_name": STRING_RULE,
+                "birth_date": STRING_RULE,
+                "death_date": STRING_RULE,
+                "entity_type": {"type": "string", "allowed": ["person", "org", "event"]},
+                "title": STRING_RULE,
+            }
+        )
+    ), "required": True},
+    "contributor": _list_rule(
+        _dict_rule(
+            {
+                "role": STRING_RULE,
+                "name": {"type": "string", "required": True},
+            }
+        )
+    ),
+    "publish_date": {**STRING_RULE, "required": True},
+    "publish_places": STRING_ARRAY_RULE,
+    "number_of_pages": NUMBER_RULE,
+    "pagination": STRING_RULE,
+    "by_statement": STRING_RULE,
+    "description": STRING_RULE,
+    "publish_country": PUBLISH_COUNTRY_RULE,
+    "languages": _list_rule(LANGUAGE_CODE_RULE),
+    "translated_from": _list_rule(LANGUAGE_CODE_RULE),
+    "translation_of": STRING_RULE,
+    "isbn_10": _list_rule({"type": "string", "regex": r"^([0-9][- ]*){9}[0-9X]$"}),
+    "isbn_13": _list_rule({"type": "string", "regex": r"^([0-9][- ]*){13}$"}),
+    "oclc_numbers": STRING_ARRAY_RULE,
+    "lccn": STRING_ARRAY_RULE,
+    "lc_classifications": _list_rule(LC_CLASSIFICATION_RULE),
+    "dewey_decimal_class": STRING_ARRAY_RULE,
+    "notes": STRING_RULE,
+    "edition_name": STRING_RULE,
+    "table_of_contents": {"type": "list"},
+    "series": STRING_ARRAY_RULE,
+    "subjects": STRING_ARRAY_RULE,
+    "subject_times": STRING_ARRAY_RULE,
+    "subject_people": STRING_ARRAY_RULE,
+    "subject_places": STRING_ARRAY_RULE,
+    "contributions": STRING_ARRAY_RULE,
+    "work_titles": STRING_ARRAY_RULE,
+    "other_titles": STRING_ARRAY_RULE,
+    "links": _list_rule(LINK_RULE),
+    "physical_format": STRING_RULE,
+    "physical_dimensions": STRING_RULE,
+    "weight": STRING_RULE,
+    "identifiers": {
+        "type": "dict",
+        "keysrules": {"type": "string", "regex": r"^\w+"},
+        "valuesrules": _list_rule(STRING_RULE),
+        "required": False,
+    },
+    "cover": STRING_RULE,
+}
+
+
+SCHEMAS: Dict[str, Dict[str, Any]] = {
+    "work.schema.json": WORK_SCHEMA,
+    "edition.schema.json": EDITION_SCHEMA,
+    "author.schema.json": AUTHOR_SCHEMA,
+    "import.schema.json": IMPORT_SCHEMA,
+}
+
+
+ROOT_ALLOW_UNKNOWN = {
+    "work.schema.json": True,
+    "edition.schema.json": False,
+    "author.schema.json": False,
+    "import.schema.json": False,
+}
+
+
+def validate_document(document: Dict[str, Any], schema_name: str) -> None:
+    """Validate a document dict using the named Cerberus schema."""
+    if schema_name not in SCHEMAS:
+        raise KeyError(f"Unknown schema: {schema_name}")
+
+    validator = Validator(copy.deepcopy(SCHEMAS[schema_name]), allow_unknown=ROOT_ALLOW_UNKNOWN[schema_name])
+    if validator.validate(document):
+        return None
+
+    raise ValidationError(f"{schema_name} validation failed: {validator.errors}")
