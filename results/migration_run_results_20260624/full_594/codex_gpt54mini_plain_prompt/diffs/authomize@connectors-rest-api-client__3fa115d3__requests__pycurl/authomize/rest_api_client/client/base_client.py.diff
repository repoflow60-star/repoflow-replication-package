+    def _build_url(self, url: str, params=None) -> str:
+        full_url = self.base_url.rstrip('/') + url
+        if not params:
+            return full_url
+
+        encoded_params = []
+        for key, value in params.items():
+            if value is None:
+                continue
+            if isinstance(value, (list, tuple, set)):
+                encoded_params.extend(
+                    (key, pydantic_encoder(item)) for item in value
+                )
+                continue
+            encoded_params.append((key, pydantic_encoder(value)))
+
+        query = urlencode(encoded_params, doseq=True)
+        parts = urlsplit(full_url)
+        return urlunsplit((parts.scheme, parts.netloc, parts.path, query, parts.fragment))
+
