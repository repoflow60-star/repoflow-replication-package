+                curl.setopt(pycurl.CUSTOMREQUEST, 'PATCH')
+                payload = self._encode_body(body)
+                curl.setopt(pycurl.POSTFIELDS, payload)
+                curl.setopt(pycurl.POSTFIELDSIZE, len(payload))
+            elif method == 'DELETE':
+                curl.setopt(pycurl.HTTPHEADER, [f'Authorization: {self.authorization_header}'])
+                curl.setopt(pycurl.CUSTOMREQUEST, 'DELETE')
