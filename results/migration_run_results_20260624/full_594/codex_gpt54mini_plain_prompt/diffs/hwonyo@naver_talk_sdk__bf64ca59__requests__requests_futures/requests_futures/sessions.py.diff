+"""Minimal FuturesSession compatibility wrapper."""
+
+from concurrent.futures import ThreadPoolExecutor
+
+import requests
+
+
+class FuturesSession(object):
+    """Small subset of requests_futures.sessions.FuturesSession.
+
+    The repository only needs ``post(...).result()`` semantics, so this
+    wrapper keeps the public API expected by the migrated code while
+    delegating the actual HTTP work to ``requests``.
+    """
+
+    def __init__(self, session=None, executor=None, max_workers=2):
+        self.session = session or requests.Session()
+        self.executor = executor or ThreadPoolExecutor(max_workers=max_workers)
+
+    def request(self, method, url, **kwargs):
+        return self.executor.submit(self.session.request, method, url, **kwargs)
+
+    def get(self, url, **kwargs):
+        return self.request("GET", url, **kwargs)
+
+    def post(self, url, **kwargs):
+        return self.request("POST", url, **kwargs)
+
