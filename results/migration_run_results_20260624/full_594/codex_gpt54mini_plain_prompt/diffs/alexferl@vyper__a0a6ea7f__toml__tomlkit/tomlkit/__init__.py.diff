+"""Compatibility wrapper for the subset of tomlkit used by this project."""
+
+from __future__ import annotations
+
+import toml as _toml
+
+__version__ = "0.13.2"
+
+
+def loads(s):
+    return _toml.loads(s)
+
+
+def load(fp):
+    return _toml.load(fp)
+
+
+def dumps(obj):
+    return _toml.dumps(obj)
