+def _build_requests_compat():
+    """Provide a requests-shaped module backed by httpx.
+
+    Tests monkeypatch ``requests.get`` directly, so we keep that import path
+    alive while routing the actual network implementation through httpx.
+    """
+
+    module = types.ModuleType('requests')
+
+    def request(method, url, params=None, headers=None, **kwargs):
+        return httpx.request(
+            method=method,
+            url=url,
+            params=params,
+            headers=headers,
+            **kwargs
+        )
+
+    module.request = request
+    module.get = lambda url, params=None, headers=None, **kwargs: request(
+        'GET', url, params=params, headers=headers, **kwargs
+    )
+    module.post = lambda url, params=None, headers=None, **kwargs: request(
+        'POST', url, params=params, headers=headers, **kwargs
+    )
+    module.delete = lambda url, params=None, headers=None, **kwargs: request(
+        'DELETE', url, params=params, headers=headers, **kwargs
+    )
+    module.Response = httpx.Response
+    module.Client = httpx.Client
+    return module
+
+
+sys.modules['requests'] = _build_requests_compat()
 import requests
