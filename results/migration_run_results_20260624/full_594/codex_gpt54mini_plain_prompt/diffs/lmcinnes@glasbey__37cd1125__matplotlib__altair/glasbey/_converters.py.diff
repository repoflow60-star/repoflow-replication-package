+def _hex_to_rgb(color):
+    color = color.lstrip("#")
+    if len(color) == 3:
+        color = "".join(ch * 2 for ch in color)
+    if len(color) != 6:
+        raise ValueError(f"Invalid hex color {color!r}")
+    return tuple(int(color[i : i + 2], 16) / 255.0 for i in range(0, 6, 2))
+
+
+def to_rgb(color):
+    if isinstance(color, str):
+        if color.startswith("#"):
+            return _hex_to_rgb(color)
+        palette = _NAMED_PALETTES.get(_PALETTE_ALIASES.get(color.lower(), color))
+        if palette is not None and len(palette) == 1:
+            return _hex_to_rgb(palette[0])
+        raise ValueError(f"Unrecognized color {color!r}")
+
+    if hasattr(color, "__len__") and len(color) in (3, 4):
+        rgb = asarray(color[:3], dtype=float32)
+        if max(rgb) > 1.0 or any(isinstance(channel, (int, integer)) for channel in color[:3]):
+            rgb = rgb / 255.0
+        return tuple(float(channel) for channel in rgb)
+
+    raise ValueError(f"Unrecognized color {color!r}")
+
+
+def rgb2hex(color):
+    rgb = to_rgb(color)
+    return "#" + "".join(f"{int(round(channel * 255)):02x}" for channel in rgb)
+
+
+def get_named_palette(name, max_colors=12):
+    palette_name = _PALETTE_ALIASES.get(name.lower(), name)
+    try:
+        colors = _NAMED_PALETTES[palette_name]
+    except KeyError as exc:
+        raise ValueError(f"Unrecognized palette name {name}") from exc
+
+    if len(colors) <= max_colors:
+        return array([_hex_to_rgb(color) for color in colors], dtype=float32, order="C")
+    return array([_hex_to_rgb(color) for color in colors[:max_colors]], dtype=float32, order="C")
 
 
