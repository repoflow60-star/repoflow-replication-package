+++ b/fmi_weather_client/_requests_compat.py
@@ -0,0 +1,76 @@
+from dataclasses import dataclass
+from types import SimpleNamespace
+from typing import Any, Dict, Optional
+import asyncio
+import time
+
+try:
+    from twisted.internet import asyncioreactor
+
+    _REQUEST_LOOP = asyncio.new_event_loop()
+    try:
+        asyncioreactor.install(_REQUEST_LOOP)
+    except Exception:
+        pass
+
+    import treq
+except Exception:  # pragma: no cover - exercised only when treq is unavailable locally
+    treq = None
+    _REQUEST_LOOP = None
+
+
+@dataclass
+class Response:
+    text: str
+    status_code: int
+    elapsed: Any
+
+
+def get(url: str, params: Optional[Dict[str, Any]] = None, timeout: Optional[int] = None, **kwargs):
+    if treq is not None:
+        return _run_blocking(_treq_get(url, params=params, timeout=timeout, **kwargs))
+
+    return _urllib_get(url, params=params, timeout=timeout)
+
+
+async def _treq_get(url: str, params: Optional[Dict[str, Any]] = None, timeout: Optional[int] = None, **kwargs):
+    start = time.perf_counter()
+    response = await treq.get(url, params=params, timeout=timeout, **kwargs)
+    text = await treq.text_content(response)
+    elapsed = SimpleNamespace(microseconds=int((time.perf_counter() - start) * 1_000_000))
+    return Response(text=text, status_code=response.code, elapsed=elapsed)
+
+
+def _run_blocking(coro):
+    loop = _REQUEST_LOOP
+    if loop is None:
+        loop = asyncio.new_event_loop()
+        try:
+            asyncio.set_event_loop(loop)
+            return loop.run_until_complete(coro)
+        finally:
+            loop.close()
+
+    return loop.run_until_complete(coro)
+
+
+def _urllib_get(url: str, params: Optional[Dict[str, Any]] = None, timeout: Optional[int] = None):
+    from urllib.error import HTTPError
+    from urllib.parse import urlencode
+    from urllib.request import Request, urlopen
+
+    query = urlencode(params or {})
+    full_url = f"{url}?{query}" if query else url
+    request = Request(full_url, method="GET")
+    start = time.perf_counter()
+
+    try:
+        with urlopen(request, timeout=timeout) as response:
+            body = response.read().decode(response.headers.get_content_charset() or "utf-8", errors="replace")
+            status_code = response.status
+    except HTTPError as error:
+        body = error.read().decode(error.headers.get_content_charset() or "utf-8", errors="replace")
+        status_code = error.code
+
+    elapsed = SimpleNamespace(microseconds=int((time.perf_counter() - start) * 1_000_000))
+    return Response(text=body, status_code=status_code, elapsed=elapsed)
