+class _AiohttpResponse(object):
+    def __init__(self, status_code, content, encoding='utf-8'):
+        self.status_code = status_code
+        self.content = content
+        self.encoding = encoding or 'utf-8'
+
+    def iter_lines(self, chunk_size=8192):
+        for line in self.content.splitlines():
+            if isinstance(line, bytes):
+                yield line.decode(self.encoding)
+            else:
+                yield line
+
+    def close(self):
+        return None
+
+
+class _AiohttpSession(object):
+    def __init__(self, verify_ssl_certificate=True):
+        self.verify_ssl_certificate = verify_ssl_certificate
+
+    def get(self, url, **kwargs):
+        return self._request('GET', url, **kwargs)
+
+    def post(self, url, data=None, **kwargs):
+        return self._request('POST', url, data=data, **kwargs)
+
+    def _request(self, method, url, data=None, **kwargs):
+        return asyncio.run(self._request_async(method, url, data=data, **kwargs))
+
+    async def _request_async(self, method, url, data=None, **kwargs):
+        import aiohttp
+
+        params = kwargs.pop('params', None)
+        headers = kwargs.pop('headers', None)
+        verify = kwargs.pop('verify', self.verify_ssl_certificate)
+        kwargs.pop('stream', None)
+        kwargs.pop('timeout', None)
+        if kwargs:
+            raise TypeError('Unsupported keyword arguments: %s' % ', '.join(sorted(kwargs)))
+
+        request_kwargs = {}
+        if params is not None:
+            request_kwargs['params'] = params
+        if headers is not None:
+            request_kwargs['headers'] = headers
+        if data is not None:
+            request_kwargs['data'] = data
+        if not verify:
+            request_kwargs['ssl'] = False
+
+        async with aiohttp.ClientSession() as client_session:
+            async with client_session.request(method, url, **request_kwargs) as response:
+                content = await response.read()
+                return _AiohttpResponse(
+                    response.status,
+                    content,
+                    encoding=response.charset,
+                )
+
+
