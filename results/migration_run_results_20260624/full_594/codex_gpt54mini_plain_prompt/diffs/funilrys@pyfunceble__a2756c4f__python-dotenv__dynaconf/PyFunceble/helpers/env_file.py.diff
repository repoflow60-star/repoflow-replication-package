+"""Utilities to read and write simple ``.env`` style files."""
+
+from __future__ import annotations
+
+import ast
+import json
+import os
+import re
+from pathlib import Path
+from typing import Dict, Iterable, Optional
+
+
+_LINE_RE = re.compile(
+    r"^\s*(?:export\s+)?(?P<key>[A-Za-z_][A-Za-z0-9_\.]*)\s*=\s*(?P<value>.*)\s*$"
+)
+
+
+def _unquote(value: str) -> str:
+    """
+    Remove shell-style quoting from a value.
+    """
+
+    value = value.strip()
+
+    if not value:
+        return value
+
+    if value[0] in {'"', "'"} and value[-1] == value[0]:
+        try:
+            return ast.literal_eval(value)
+        except (ValueError, SyntaxError):
+            return value[1:-1]
+
+    if " #" in value:
+        value = value[: value.find(" #")].rstrip()
+
+    if value and value[0] == "#" and value.strip() == "#":
+        return ""
+
+    return value
+
+
+def _format_value(value: str) -> str:
+    """
+    Format a value for storage in a ``.env`` file.
+    """
+
+    return json.dumps(value)
+
+
+def read_env_file(path: Optional[str]) -> Dict[str, str]:
+    """
+    Parse a ``.env``-style file into a dictionary.
+    """
+
+    if not path or not os.path.exists(path):
+        return {}
+
+    result: Dict[str, str] = {}
+
+    with open(path, "r", encoding="utf-8") as file_stream:
+        for line in file_stream:
+            stripped = line.strip()
+
+            if not stripped or stripped.startswith("#"):
+                continue
+
+            match = _LINE_RE.match(line)
+
+            if not match:
+                continue
+
+            key = match.group("key")
+            value = _unquote(match.group("value"))
+            result[key] = value
+
+    return result
+
+
+def load_env_file(path: Optional[str], *, override: bool = False) -> None:
+    """
+    Load values from a ``.env``-style file into ``os.environ``.
+    """
+
+    for key, value in read_env_file(path).items():
+        if override or key not in os.environ:
+            os.environ[key] = value
+
+
+def load_env_files(paths: Iterable[Optional[str]], *, override: bool = False) -> None:
+    """
+    Load values from a series of ``.env``-style files.
+    """
+
+    for path in paths:
+        load_env_file(path, override=override)
+
+
+def write_env_file(path: Optional[str], key: str, value: str) -> None:
+    """
+    Set or update a value in a ``.env``-style file.
+    """
+
+    if not path:
+        return
+
+    file_path = Path(path)
+    file_path.parent.mkdir(parents=True, exist_ok=True)
+
+    lines = []
+    found = False
+    target = f"{key}={_format_value(value)}\n"
+    key_pattern = re.compile(rf"^\s*(?:export\s+)?{re.escape(key)}\s*=.*$")
+
+    if file_path.exists():
+        with file_path.open("r", encoding="utf-8") as file_stream:
+            lines = file_stream.readlines()
+
+    for index, line in enumerate(lines):
+        if key_pattern.match(line):
+            lines[index] = target
+            found = True
+            break
+
+    if not found:
+        if lines and not lines[-1].endswith("\n"):
+            lines[-1] = f"{lines[-1]}\n"
+        lines.append(target)
+
+    with file_path.open("w", encoding="utf-8") as file_stream:
+        file_stream.writelines(lines)
+
+
+def unset_env_file_key(path: Optional[str], key: str) -> None:
+    """
+    Remove a value from a ``.env``-style file.
+    """
+
+    if not path:
+        return
+
+    file_path = Path(path)
+
+    if not file_path.exists():
+        return
+
+    key_pattern = re.compile(rf"^\s*(?:export\s+)?{re.escape(key)}\s*=.*$")
+
+    with file_path.open("r", encoding="utf-8") as file_stream:
+        lines = file_stream.readlines()
+
+    lines = [line for line in lines if not key_pattern.match(line)]
+
+    with file_path.open("w", encoding="utf-8") as file_stream:
+        file_stream.writelines(lines)
