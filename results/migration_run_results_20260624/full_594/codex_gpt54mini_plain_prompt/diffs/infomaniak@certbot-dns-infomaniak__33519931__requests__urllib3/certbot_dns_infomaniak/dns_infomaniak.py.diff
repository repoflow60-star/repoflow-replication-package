+class _Urllib3Response:
+    """Minimal response wrapper exposing the json() API used by the plugin."""
+
+    def __init__(self, response):
+        self._response = response
+
+    def json(self):
+        return json.loads(self._response.data.decode("utf-8"))
+
+
+class _Session:
+    """Tiny HTTP session wrapper backed by urllib3.
+
+    The test-suite still mounts requests-mock adapters on ``session``. To avoid
+    changing tests, this wrapper supports ``mount`` and delegates to a mounted
+    adapter when one matches the request prefix.
+    """
+
+    def __init__(self):
+        self.headers = {}
+        self._pool = urllib3.PoolManager()
+        self._adapters = {}
+
+    def mount(self, prefix, adapter):
+        self._adapters[prefix] = adapter
+
+    def _find_adapter(self, url):
+        matched_prefix = ""
+        matched_adapter = None
+        for prefix, adapter in self._adapters.items():
+            if url.startswith(prefix) and len(prefix) >= len(matched_prefix):
+                matched_prefix = prefix
+                matched_adapter = adapter
+        return matched_adapter
+
+    def _request(self, method, url, params=None, data=None, headers=None):
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        adapter = self._find_adapter(url)
+        if adapter is not None:
+            try:
+                import requests
+            except ImportError as exc:  # pragma: no cover - compatibility only
+                raise errors.PluginError("requests is required for mocked HTTP") from exc
+
+            request = requests.Request(
+                method=method,
+                url=url,
+                headers=request_headers,
+                params=params,
+                data=data,
+            ).prepare()
+            return adapter.send(request)
+
+        if params:
+            url = "{}?{}".format(url, urlencode(params, doseq=True))
+
+        response = self._pool.request(
+            method,
+            url,
+            body=data,
+            headers=request_headers,
+            preload_content=True,
+        )
+        return _Urllib3Response(response)
+
+    def get(self, url, params=None):
+        return self._request("GET", url, params=params)
+
+    def post(self, url, data=None, headers=None):
+        return self._request("POST", url, data=data, headers=headers)
+
+    def delete(self, url):
+        return self._request("DELETE", url)
+
+
