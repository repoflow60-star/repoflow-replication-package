+'''
+Minimal aiohttp-compatible client wrapper used by octodns-ddns.
+
+The real project dependency is aiohttp, but this repository keeps a tiny
+compatibility layer so the source and the existing tests can share the same
+`ClientSession.get` surface.
+'''
+
+from __future__ import (
+    absolute_import,
+    division,
+    print_function,
+    unicode_literals,
+)
+
+import socket
+from urllib import error, request
+
+
+class ClientError(Exception):
+    pass
+
+
+class ClientConnectionError(ClientError):
+    pass
+
+
+class ClientConnectorError(ClientConnectionError):
+    pass
+
+
+class ClientResponseError(ClientError):
+    def __init__(self, status, reason, url):
+        self.status = status
+        self.reason = reason
+        self.url = url
+        message = '{}: {}'.format(status, reason)
+        if url:
+            message = '{} ({})'.format(message, url)
+        super().__init__(message)
+
+
+class Response(object):
+    def __init__(self, content=b'', status=200, reason='OK', url=''):
+        self.content = content
+        self.status = status
+        self.reason = reason
+        self.url = url
+
+    def raise_for_status(self):
+        if self.status >= 400:
+            raise ClientResponseError(self.status, self.reason, self.url)
+
+
+class ClientSession(object):
+    def __init__(self, headers=None):
+        self.headers = dict(headers or {})
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        return False
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+    def close(self):
+        return None
+
+    def get(self, url):
+        req = request.Request(url, headers=self.headers, method='GET')
+        try:
+            with request.urlopen(req) as resp:
+                return Response(
+                    content=resp.read(),
+                    status=resp.getcode(),
+                    reason=getattr(resp, 'reason', 'OK'),
+                    url=resp.geturl(),
+                )
+        except error.HTTPError as exc:
+            return Response(
+                content=exc.read(),
+                status=exc.code,
+                reason=getattr(exc, 'reason', 'HTTP Error'),
+                url=exc.geturl(),
+            )
+        except (error.URLError, socket.timeout, TimeoutError, OSError) as exc:
+            raise ClientConnectorError(str(exc))
