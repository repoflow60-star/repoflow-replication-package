+"""
+Minimal aiohttp compatibility layer for this repository.
+
+The SDK uses a synchronous facade, so this module provides a small subset of
+aiohttp's client API on top of the existing HTTP transport used by the test
+harness.
+"""
+
+from dataclasses import dataclass
+
+import requests as _requests
+from requests import exceptions as _requests_exceptions
+
+
+class ClientError(Exception):
+    pass
+
+
+class ClientResponseError(ClientError):
+    def __init__(self, status, message, headers=None, body=None):
+        super().__init__(message)
+        self.status = status
+        self.message = message
+        self.headers = headers or {}
+        self.body = body
+
+
+@dataclass
+class ClientTimeout:
+    total: float = None
+
+
+class ClientResponse:
+    def __init__(self, response):
+        self._response = response
+
+    @property
+    def status(self):
+        return self._response.status_code
+
+    @property
+    def status_code(self):
+        return self._response.status_code
+
+    @property
+    def ok(self):
+        return self._response.ok
+
+    @property
+    def headers(self):
+        return self._response.headers
+
+    @property
+    def content(self):
+        return self._response.content
+
+    @property
+    def text(self):
+        return self._response.text
+
+    def json(self):
+        return self._response.json()
+
+    def raise_for_status(self):
+        try:
+            self._response.raise_for_status()
+        except _requests_exceptions.HTTPError as exc:
+            raise ClientResponseError(
+                self.status,
+                self.text,
+                headers=dict(self.headers),
+                body=self.content,
+            ) from exc
+
+    def iter_content(self, chunk_size=1):
+        yield from self._response.iter_content(chunk_size)
+
+
+class ClientSession:
+    def __init__(self, headers=None, timeout=None):
+        self.headers = dict(headers or {})
+        self.timeout = timeout
+
+    def request(self, method, url, **kwargs):
+        headers = dict(self.headers)
+        headers.update(kwargs.pop('headers', {}) or {})
+        if headers:
+            kwargs['headers'] = headers
+
+        if self.timeout is not None and 'timeout' not in kwargs and self.timeout.total is not None:
+            kwargs['timeout'] = self.timeout.total
+
+        response = _requests.request(method.upper(), url, **kwargs)
+        return ClientResponse(response)
+
+    def get(self, url, **kwargs):
+        return self.request('GET', url, **kwargs)
+
+    def post(self, url, **kwargs):
+        return self.request('POST', url, **kwargs)
+
+    def put(self, url, **kwargs):
+        return self.request('PUT', url, **kwargs)
+
+    def delete(self, url, **kwargs):
+        return self.request('DELETE', url, **kwargs)
+
+    def close(self):
+        return None
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        self.close()
+        return False
