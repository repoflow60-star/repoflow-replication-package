+"""
+Small aiohttp helpers for synchronous call sites.
+"""
+
+import asyncio
+from typing import Any, Dict, Optional, Tuple
+
+import aiohttp
+
+
+def run(coro):
+    """
+    Execute an async coroutine from synchronous code.
+    """
+    return asyncio.run(coro)
+
+
+async def request_json(
+        method: str,
+        url: str,
+        *,
+        headers: Optional[Dict[str, str]] = None,
+        data: Any = None,
+        json_data: Any = None,
+        timeout: int = 300) -> Tuple[int, str, Any]:
+    """
+    Perform an HTTP request and decode the response body as JSON.
+    """
+    client_timeout = aiohttp.ClientTimeout(total=timeout)
+    async with aiohttp.ClientSession(timeout=client_timeout) as session:
+        async with session.request(
+                method,
+                url,
+                headers=headers,
+                data=data,
+                json=json_data) as response:
+            return response.status, response.reason, await response.json(content_type=None)
+
+
+async def request_text(
+        method: str,
+        url: str,
+        *,
+        headers: Optional[Dict[str, str]] = None,
+        data: Any = None,
+        json_data: Any = None,
+        timeout: int = 300) -> Tuple[int, str, str]:
+    """
+    Perform an HTTP request and decode the response body as text.
+    """
+    client_timeout = aiohttp.ClientTimeout(total=timeout)
+    async with aiohttp.ClientSession(timeout=client_timeout) as session:
+        async with session.request(
+                method,
+                url,
+                headers=headers,
+                data=data,
+                json=json_data) as response:
+            return response.status, response.reason, await response.text()
+
+
+async def request_bytes(
+        method: str,
+        url: str,
+        *,
+        headers: Optional[Dict[str, str]] = None,
+        data: Any = None,
+        json_data: Any = None,
+        timeout: int = 300) -> Tuple[int, str, bytes]:
+    """
+    Perform an HTTP request and return the raw response body.
+    """
+    client_timeout = aiohttp.ClientTimeout(total=timeout)
+    async with aiohttp.ClientSession(timeout=client_timeout) as session:
+        async with session.request(
+                method,
+                url,
+                headers=headers,
+                data=data,
+                json=json_data) as response:
+            return response.status, response.reason, await response.read()
+
+
+async def download_to_file(
+        url: str,
+        *,
+        headers: Optional[Dict[str, str]] = None,
+        timeout: int = 300,
+        location: str) -> None:
+    """
+    Stream a response body to a local file.
+    """
+    client_timeout = aiohttp.ClientTimeout(total=timeout)
+    async with aiohttp.ClientSession(timeout=client_timeout) as session:
+        async with session.get(url, headers=headers) as response:
+            response.raise_for_status()
+            with open(location, 'wb') as write_stream:
+                async for chunk in response.content.iter_chunked(8192):
+                    write_stream.write(chunk)
