@@ -0,0 +1,27 @@
+from dataclasses import dataclass
+from urllib.error import HTTPError, URLError
+from urllib.request import urlopen
+
+
+@dataclass
+class Response:
+    status_code: int
+    content: bytes
+
+
+def get(url, **kwargs):
+    """
+    Minimal fallback for local environments where httpx is unavailable.
+
+    The client only relies on status_code and content, so this keeps the
+    package runnable in the sandbox without changing the public API surface.
+    """
+    timeout = kwargs.get("timeout")
+
+    try:
+        with urlopen(url, timeout=timeout) as response:
+            return Response(status_code=response.status, content=response.read())
+    except HTTPError as error:
+        return Response(status_code=error.code, content=error.read())
+    except URLError as error:
+        raise error
