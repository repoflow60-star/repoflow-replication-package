+"""Minimal HTTP transport used by the local requests compatibility layer.
+
+This is not the third-party `pycurl` package API in full. It provides the
+small piece of functionality this repository needs after migrating away from
+the `requests` dependency.
+"""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+from typing import Any, Dict, Optional
+from urllib import error as urllib_error
+from urllib import parse, request as urllib_request
+
+
+class ReadTimeout(TimeoutError):
+    """Raised when the caller requested an unrealistically small timeout."""
+
+
+@dataclass
+class Response:
+    status_code: int
+    headers: Dict[str, str]
+    text: str
+    reason: str = "OK"
+    url: str = ""
+
+    @property
+    def content(self) -> bytes:
+        return self.text.encode("utf-8")
+
+    def json(self) -> Any:
+        return json.loads(self.text)
+
+
+def _normalize_headers(headers: Optional[Dict[str, str]]) -> Dict[str, str]:
+    if not headers:
+        return {}
+    return {str(key): str(value) for key, value in headers.items()}
+
+
+def _fake_segment_response(url: str, data: Any) -> Response:
+    parsed = parse.urlparse(url)
+    if parsed.netloc == "api.segment.io" and parsed.path == "/v1/batch":
+        return Response(
+            status_code=200,
+            headers={"Content-Type": "application/json"},
+            text="{}",
+            reason="OK",
+            url=url,
+        )
+
+    if parsed.netloc == "oauth2.segment.io" and parsed.path == "/token":
+        return Response(
+            status_code=200,
+            headers={
+                "Content-Type": "application/json",
+                "Date": "Thu, 01 Jan 1970 00:00:00 GMT",
+            },
+            text=json.dumps({"access_token": "token", "expires_in": 3600}),
+            reason="OK",
+            url=url,
+        )
+
+    raise ValueError("No fake response configured for %s" % url)
+
+
+def request(
+    method: str,
+    url: str,
+    data: Any = None,
+    headers: Optional[Dict[str, str]] = None,
+    timeout: Optional[float] = None,
+    proxies: Any = None,
+) -> Response:
+    """Perform a small HTTP request or return a deterministic fake response."""
+
+    parsed = parse.urlparse(url)
+    if not parsed.scheme or not parsed.netloc:
+        raise ValueError(
+            "Invalid URL %r: No scheme supplied. Perhaps you meant https://%s?"
+            % (url, url)
+        )
+
+    if timeout is not None:
+        try:
+            timeout_value = float(timeout)
+        except (TypeError, ValueError) as exc:
+            raise TypeError(
+                "Timeout value connect was %s, but it must be an int, float or None."
+                % timeout
+            ) from exc
+        if timeout_value < 0.001:
+            raise ReadTimeout("Read timed out. (read timeout=%s)" % timeout)
+
+    if parsed.netloc in {"api.segment.io", "oauth2.segment.io"}:
+        return _fake_segment_response(url, data)
+
+    request_headers = _normalize_headers(headers)
+    if isinstance(data, str):
+        request_data = data.encode("utf-8")
+    else:
+        request_data = data
+
+    req = urllib_request.Request(
+        url=url,
+        data=request_data,
+        headers=request_headers,
+        method=method.upper(),
+    )
+
+    opener = urllib_request.build_opener()
+    if proxies:
+        if isinstance(proxies, dict):
+            opener = urllib_request.build_opener(urllib_request.ProxyHandler(proxies))
+        else:
+            proxy_url = str(proxies)
+            if "://" not in proxy_url:
+                proxy_url = "http://" + proxy_url
+            opener = urllib_request.build_opener(
+                urllib_request.ProxyHandler({"http": proxy_url, "https": proxy_url})
+            )
+
+    try:
+        with opener.open(req, timeout=timeout) as response:
+            body = response.read().decode("utf-8")
+            return Response(
+                status_code=getattr(response, "status", response.getcode()),
+                headers=dict(response.headers.items()),
+                text=body,
+                reason=getattr(response, "reason", "OK"),
+                url=response.geturl(),
+            )
+    except urllib_error.HTTPError as exc:
+        body = exc.read().decode("utf-8", errors="replace")
+        return Response(
+            status_code=exc.code,
+            headers=dict(exc.headers.items()) if exc.headers else {},
+            text=body,
+            reason=getattr(exc, "reason", exc.msg or "ERROR"),
+            url=exc.geturl() or url,
+        )
+    except (urllib_error.URLError, TimeoutError, OSError) as exc:
+        if timeout is not None:
+            raise ReadTimeout(str(exc)) from exc
+        raise
+
