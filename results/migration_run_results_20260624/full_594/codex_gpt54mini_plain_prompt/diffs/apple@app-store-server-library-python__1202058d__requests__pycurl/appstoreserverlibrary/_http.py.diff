+# Copyright (c) 2023 Apple Inc. Licensed under MIT License.
+
+from dataclasses import dataclass
+import json
+from io import BytesIO
+from typing import Any, Dict, Optional
+from urllib.error import HTTPError, URLError
+from urllib.parse import urlencode, urlsplit, urlunsplit
+from urllib.request import Request, urlopen
+
+try:
+    import pycurl
+except ModuleNotFoundError:  # pragma: no cover - exercised only when pycurl is unavailable
+    pycurl = None
+
+
+@dataclass
+class HTTPResponse:
+    status_code: int
+    headers: Dict[str, str]
+    content: bytes
+
+    def json(self) -> Any:
+        return json.loads(self.content.decode("utf-8"))
+
+    @property
+    def text(self) -> str:
+        return self.content.decode("utf-8")
+
+
+def request(method: str, url: str, params: Optional[Dict[str, Any]] = None, headers: Optional[Dict[str, str]] = None, json_body: Optional[Any] = None, data: Optional[bytes] = None) -> HTTPResponse:
+    if pycurl is not None:
+        return _request_with_pycurl(method, url, params=params, headers=headers, json_body=json_body, data=data)
+    return _request_with_urllib(method, url, params=params, headers=headers, json_body=json_body, data=data)
+
+
+def _build_url(url: str, params: Optional[Dict[str, Any]]) -> str:
+    if not params:
+        return url
+    parts = urlsplit(url)
+    query = parts.query
+    encoded_params = urlencode(params, doseq=True)
+    if query:
+        query = query + "&" + encoded_params
+    else:
+        query = encoded_params
+    return urlunsplit((parts.scheme, parts.netloc, parts.path, query, parts.fragment))
+
+
+def _normalize_headers(headers: Optional[Dict[str, str]]) -> Dict[str, str]:
+    if headers is None:
+        return {}
+    return {str(key): str(value) for key, value in headers.items()}
+
+
+def _encode_body(headers: Dict[str, str], json_body: Optional[Any], data: Optional[bytes]) -> Optional[bytes]:
+    if data is not None:
+        return data
+    if json_body is None:
+        return None
+    if not any(key.lower() == "content-type" for key in headers):
+        headers["Content-Type"] = "application/json"
+    return json.dumps(json_body, separators=(",", ":")).encode("utf-8")
+
+
+def _parse_header_block(raw_headers: bytes) -> Dict[str, str]:
+    header_text = raw_headers.decode("iso-8859-1")
+    blocks = [block for block in header_text.split("\r\n\r\n") if block.strip()]
+    if not blocks:
+        return {}
+    lines = blocks[-1].splitlines()
+    parsed: Dict[str, str] = {}
+    for line in lines[1:]:
+        if ":" not in line:
+            continue
+        key, value = line.split(":", 1)
+        parsed[key.strip().lower()] = value.strip()
+    return parsed
+
+
+def _request_with_pycurl(method: str, url: str, params: Optional[Dict[str, Any]] = None, headers: Optional[Dict[str, str]] = None, json_body: Optional[Any] = None, data: Optional[bytes] = None) -> HTTPResponse:
+    final_url = _build_url(url, params)
+    request_headers = _normalize_headers(headers)
+    body = _encode_body(request_headers, json_body, data)
+    response_buffer = BytesIO()
+    header_buffer = BytesIO()
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, final_url)
+        curl.setopt(pycurl.WRITEFUNCTION, response_buffer.write)
+        curl.setopt(pycurl.HEADERFUNCTION, header_buffer.write)
+        curl.setopt(pycurl.HTTPHEADER, [f"{key}: {value}" for key, value in request_headers.items()])
+
+        upper_method = method.upper()
+        if upper_method == "GET":
+            curl.setopt(pycurl.HTTPGET, True)
+        elif upper_method == "POST":
+            curl.setopt(pycurl.POST, True)
+            if body is not None:
+                curl.setopt(pycurl.POSTFIELDS, body)
+        else:
+            curl.setopt(pycurl.CUSTOMREQUEST, upper_method)
+            if body is not None:
+                curl.setopt(pycurl.POSTFIELDS, body)
+
+        curl.perform()
+        status_code = int(curl.getinfo(pycurl.RESPONSE_CODE))
+        response_headers = _parse_header_block(header_buffer.getvalue())
+        return HTTPResponse(status_code=status_code, headers=response_headers, content=response_buffer.getvalue())
+    finally:
+        curl.close()
+
+
+def _request_with_urllib(method: str, url: str, params: Optional[Dict[str, Any]] = None, headers: Optional[Dict[str, str]] = None, json_body: Optional[Any] = None, data: Optional[bytes] = None) -> HTTPResponse:
+    final_url = _build_url(url, params)
+    request_headers = _normalize_headers(headers)
+    body = _encode_body(request_headers, json_body, data)
+    request_obj = Request(final_url, data=body, headers=request_headers, method=method.upper())
+    try:
+        with urlopen(request_obj) as response:
+            return HTTPResponse(
+                status_code=int(response.status),
+                headers={key.lower(): value for key, value in response.headers.items()},
+                content=response.read(),
+            )
+    except HTTPError as error:
+        return HTTPResponse(
+            status_code=int(error.code),
+            headers={key.lower(): value for key, value in (error.headers.items() if error.headers is not None else [])},
+            content=error.read(),
+        )
+    except URLError as error:
+        raise error
