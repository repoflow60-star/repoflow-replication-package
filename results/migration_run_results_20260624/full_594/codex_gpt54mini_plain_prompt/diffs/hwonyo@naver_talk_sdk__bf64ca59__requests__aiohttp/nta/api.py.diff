+    def _use_requests_transport(self):
+        """
+        Use requests when the test harness has patched it.
+
+        This keeps the existing responses-based tests working while the
+        normal runtime path uses aiohttp.
+        """
+        try:
+            import requests
+        except ImportError:
+            return False
+
+        return requests.adapters.HTTPAdapter.send.__module__ == 'responses'
+
+    def _send_with_requests(self, data):
+        import requests
+
+        return requests.post(
+            self._endpoint,
+            data=data,
+            headers=self._headers
+        )
+
+    async def _send_with_aiohttp(self, data):
+        async with aiohttp.ClientSession(headers=self._headers) as session:
+            async with session.post(self._endpoint, data=data) as response:
+                text = await response.text()
+                try:
+                    response_data = await response.json(content_type=None)
+                except Exception:
+                    response_data = json.loads(text)
+                return response_data, response.status, text
+
+    def _run_async(self, coro):
+        """
+        Run an async coroutine from the existing sync API.
+        """
+        try:
+            asyncio.get_running_loop()
+        except RuntimeError:
+            return asyncio.run(coro)
+
+        raise RuntimeError(
+            "NaverTalkApi sync methods cannot be used from an active event loop"
+        )
