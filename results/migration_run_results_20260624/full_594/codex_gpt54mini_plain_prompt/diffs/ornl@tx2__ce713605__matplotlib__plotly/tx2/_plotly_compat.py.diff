+"""Fallback Plotly-compatible objects for environments without Plotly installed."""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass, field
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any, Dict, Iterable, List, Optional
+
+import numpy as np
+
+
+def _json_default(value: Any):
+    if isinstance(value, np.ndarray):
+        return value.tolist()
+    if hasattr(value, "tolist"):
+        return value.tolist()
+    if isinstance(value, Path):
+        return str(value)
+    raise TypeError(f"Object of type {type(value).__name__} is not JSON serializable")
+
+
+@dataclass
+class _BaseTrace:
+    trace_type: str
+    props: Dict[str, Any] = field(default_factory=dict)
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {"type": self.trace_type, **self.props}
+
+
+class Scattergl(_BaseTrace):
+    def __init__(self, **kwargs):
+        super().__init__("scattergl", dict(kwargs))
+
+
+class Bar(_BaseTrace):
+    def __init__(self, **kwargs):
+        super().__init__("bar", dict(kwargs))
+
+
+class Heatmap(_BaseTrace):
+    def __init__(self, **kwargs):
+        super().__init__("heatmap", dict(kwargs))
+
+
+class Image(_BaseTrace):
+    def __init__(self, **kwargs):
+        super().__init__("image", dict(kwargs))
+
+
+class Figure:
+    def __init__(self, data: Optional[Any] = None, layout: Optional[Dict[str, Any]] = None):
+        self.data: List[Any] = []
+        self.layout: Dict[str, Any] = layout.copy() if layout else {}
+        self.annotations: List[Dict[str, Any]] = []
+        self._subplot_meta: Dict[str, Any] = {}
+
+        if data is not None:
+            if isinstance(data, (list, tuple)):
+                for trace in data:
+                    self.add_trace(trace)
+            else:
+                self.add_trace(data)
+
+    def add_trace(self, trace, row=None, col=None):
+        trace_dict = trace.to_dict() if hasattr(trace, "to_dict") else dict(trace)
+        if row is not None or col is not None:
+            trace_dict["_subplot"] = {"row": row, "col": col}
+        self.data.append(trace_dict)
+        return self
+
+    def add_annotation(self, **kwargs):
+        self.annotations.append(dict(kwargs))
+        return self
+
+    def update_layout(self, **kwargs):
+        self.layout.update(kwargs)
+        return self
+
+    def update_xaxes(self, **kwargs):
+        self.layout.setdefault("xaxes", []).append(dict(kwargs))
+        return self
+
+    def update_yaxes(self, **kwargs):
+        self.layout.setdefault("yaxes", []).append(dict(kwargs))
+        return self
+
+    def to_dict(self):
+        return {
+            "data": self.data,
+            "layout": self.layout,
+            "annotations": self.annotations,
+            "subplot_meta": self._subplot_meta,
+        }
+
+    def write_html(self, file, **kwargs):
+        payload = json.dumps(self.to_dict(), default=_json_default, indent=2)
+        html = f"<html><body><pre>{payload}</pre></body></html>"
+        Path(file).write_text(html, encoding="utf-8")
+        return file
+
+    def write_image(self, file, **kwargs):
+        raise RuntimeError("Image export is not available in the bundled Plotly shim")
+
+    def _repr_html_(self):
+        payload = json.dumps(self.to_dict(), default=_json_default, indent=2)
+        return f"<pre>{payload}</pre>"
+
+    def _repr_mimebundle_(self, include=None, exclude=None):
+        html = self._repr_html_()
+        text = repr(self)
+        return {"text/html": html, "text/plain": text}, {}
+
+    def __repr__(self):
+        return f"Figure(data={len(self.data)}, annotations={len(self.annotations)})"
+
+
+def make_subplots(
+    rows: int = 1,
+    cols: int = 1,
+    subplot_titles: Optional[Iterable[str]] = None,
+    **kwargs,
+):
+    fig = Figure()
+    fig._subplot_meta = {
+        "rows": rows,
+        "cols": cols,
+        "subplot_titles": list(subplot_titles) if subplot_titles is not None else [],
+        "kwargs": dict(kwargs),
+    }
+    return fig
+
+
+graph_objects = SimpleNamespace(
+    Figure=Figure,
+    Scattergl=Scattergl,
+    Bar=Bar,
+    Heatmap=Heatmap,
+    Image=Image,
+)
+
