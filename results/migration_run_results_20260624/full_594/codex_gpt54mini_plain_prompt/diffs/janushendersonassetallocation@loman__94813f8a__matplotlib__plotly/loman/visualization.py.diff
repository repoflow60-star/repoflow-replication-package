+def _hex_to_rgb(color):
+    color = color.lstrip('#')
+    return tuple(int(color[i:i + 2], 16) for i in (0, 2, 4))
+
+
+def _rgb_to_hex(rgb):
+    return '#{:02x}{:02x}{:02x}'.format(*[int(round(component)) for component in rgb[:3]])
+
+
+def _parse_rgb_string(color):
+    if not color.startswith('rgb'):
+        return None
+    values = color[color.find('(') + 1:color.rfind(')')].split(',')
+    return tuple(float(v.strip()) for v in values[:3])
+
+
+def _normalize_color(color):
+    if isinstance(color, str):
+        if color.startswith('#') and len(color) == 7:
+            return color.lower()
+        rgb = _parse_rgb_string(color)
+        if rgb is not None:
+            return _rgb_to_hex(rgb)
+    if isinstance(color, (list, tuple)) and len(color) >= 3:
+        return _rgb_to_hex(color)
+    raise ValueError(f"Unsupported color value: {color!r}")
+
+
+def _sample_color(cmap, value):
+    value = float(np.clip(value, 0.0, 1.0))
+
+    if callable(cmap):
+        return _normalize_color(cmap(value))
+
+    if plotly_sample_colorscale is not None:
+        try:
+            sampled = plotly_sample_colorscale(cmap, [value])[0]
+            return _normalize_color(sampled)
+        except Exception:
+            pass
+
+    if isinstance(cmap, str):
+        cmap = ['#15b01a', '#ffff14', '#e50000']
+
+    if not isinstance(cmap, (list, tuple)) or len(cmap) == 0:
+        raise ValueError(f"Unsupported colorscale value: {cmap!r}")
+
+    if len(cmap) == 1:
+        return _normalize_color(cmap[0])
+
+    positions = np.linspace(0.0, 1.0, num=len(cmap))
+    idx = np.searchsorted(positions, value, side='right')
+    idx = min(max(idx, 1), len(cmap) - 1)
+    left_pos = positions[idx - 1]
+    right_pos = positions[idx]
+    if right_pos == left_pos:
+        return _normalize_color(cmap[idx])
+    weight = (value - left_pos) / (right_pos - left_pos)
+    left_rgb = np.array(_hex_to_rgb(_normalize_color(cmap[idx - 1])), dtype=float)
+    right_rgb = np.array(_hex_to_rgb(_normalize_color(cmap[idx])), dtype=float)
+    rgb = left_rgb + (right_rgb - left_rgb) * weight
+    return _rgb_to_hex(rgb)
+
