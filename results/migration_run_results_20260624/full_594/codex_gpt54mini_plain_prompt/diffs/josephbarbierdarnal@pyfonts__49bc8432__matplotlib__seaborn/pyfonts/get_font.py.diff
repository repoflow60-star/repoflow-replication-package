+def _local_font_path_from_url(font_location: str) -> Path | None:
+    """
+    Map a supported GitHub font URL back to a local repository path when possible.
+    """
+    parsed = urlparse(font_location)
+    parts = [part for part in parsed.path.split("/") if part]
+
+    if parsed.netloc == "github.com":
+        if len(parts) < 5 or parts[2] not in {"blob", "raw"}:
+            return None
+        return Path(*parts[4:])
+
+    if parsed.netloc == "raw.githubusercontent.com":
+        if len(parts) < 5:
+            return None
+        return Path(*parts[4:])
+
+    return None
