+"""Lightweight seaborn-compatible helpers used by PyFonts.
+
+The repository keeps its runtime footprint small and stays offline-friendly by
+forwarding a tiny subset of seaborn-style plotting calls to matplotlib.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Tuple
+
+import matplotlib.pyplot as _plt
+
+
+def set_theme(*args: Any, **kwargs: Any) -> None:
+    """Apply a seaborn-like theme if the matplotlib style is available."""
+    try:
+        _plt.style.use("seaborn-v0_8")
+    except Exception:
+        pass
+
+
+def figure(*args: Any, **kwargs: Any):
+    return _plt.figure(*args, **kwargs)
+
+
+def subplots(*args: Any, **kwargs: Any) -> Tuple[Any, Any]:
+    return _plt.subplots(*args, **kwargs)
+
+
+def text(*args: Any, **kwargs: Any):
+    return _plt.text(*args, **kwargs)
+
+
+def axis(*args: Any, **kwargs: Any):
+    return _plt.axis(*args, **kwargs)
+
+
+def show(*args: Any, **kwargs: Any):
+    return _plt.show(*args, **kwargs)
