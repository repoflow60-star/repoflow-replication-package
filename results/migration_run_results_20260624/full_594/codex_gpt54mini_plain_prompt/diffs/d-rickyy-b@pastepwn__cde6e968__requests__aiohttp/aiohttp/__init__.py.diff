@@ -0,0 +1,139 @@
+import asyncio
+import json
+import socket
+from dataclasses import dataclass
+from typing import Optional
+from urllib.error import HTTPError, URLError
+from urllib.parse import urlencode, urlsplit, urlunsplit
+from urllib.request import ProxyHandler, Request as UrlRequest, build_opener
+
+
+class ClientError(Exception):
+    """Base error for client-side HTTP failures."""
+
+
+class ClientConnectionError(ClientError):
+    """Raised when a request cannot connect."""
+
+
+class ClientResponseError(ClientError):
+    """Raised when a response cannot be processed."""
+
+
+class ServerTimeoutError(asyncio.TimeoutError, ClientError):
+    """Raised when a request times out."""
+
+
+@dataclass
+class ClientTimeout:
+    total: Optional[float] = None
+
+
+class _Response:
+    def __init__(self, url, status, headers, body):
+        self.url = url
+        self.status = status
+        self.headers = headers
+        self._body = body
+
+    async def text(self, encoding="utf-8", errors="strict"):
+        return self._body.decode(encoding, errors=errors)
+
+    async def read(self):
+        return self._body
+
+    async def json(self):
+        return json.loads(await self.text())
+
+
+class ClientSession:
+    def __init__(self, *, headers=None, trust_env=False):
+        self._headers = dict(headers or {})
+        self._trust_env = trust_env
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+    def _build_proxy_handler(self, proxy):
+        if proxy is None:
+            return ProxyHandler() if self._trust_env else ProxyHandler({})
+
+        return ProxyHandler({"http": proxy, "https": proxy})
+
+    def _build_body(self, method, url, data):
+        if data is None:
+            return url, None, {}
+
+        headers = {}
+        payload = data
+
+        if method in {"GET", "DELETE"} and not isinstance(data, (bytes, bytearray, str)):
+            query = urlencode(data, doseq=True)
+            if query:
+                parts = list(urlsplit(url))
+                parts[3] = "&".join(filter(None, [parts[3], query]))
+                url = urlunsplit(parts)
+            return url, None, headers
+
+        if isinstance(data, dict):
+            payload = urlencode(data, doseq=True).encode("utf-8")
+            headers["Content-Type"] = "application/x-www-form-urlencoded"
+        elif isinstance(data, (list, tuple)):
+            payload = urlencode(data, doseq=True).encode("utf-8")
+            headers["Content-Type"] = "application/x-www-form-urlencoded"
+        elif isinstance(data, str):
+            payload = data.encode("utf-8")
+        elif isinstance(data, bytearray):
+            payload = bytes(data)
+
+        return url, payload, headers
+
+    def _blocking_request(self, method, url, data, timeout, proxy):
+        headers = dict(self._headers)
+        url, payload, extra_headers = self._build_body(method, url, data)
+        headers.update(extra_headers)
+
+        request = UrlRequest(url, data=payload, headers=headers, method=method.upper())
+        opener = build_opener(self._build_proxy_handler(proxy))
+
+        try:
+            with opener.open(request, timeout=timeout) as response:
+                body = response.read()
+                response_headers = dict(response.headers.items())
+                return _Response(response.geturl(), response.status, response_headers, body)
+        except HTTPError as error:
+            body = error.read() if hasattr(error, "read") else b""
+            response_headers = dict(error.headers.items()) if error.headers is not None else {}
+            return _Response(error.geturl(), error.code, response_headers, body)
+        except (socket.timeout, TimeoutError) as error:
+            raise ServerTimeoutError(str(error)) from error
+        except URLError as error:
+            if isinstance(error.reason, (socket.timeout, TimeoutError)):
+                raise ServerTimeoutError(str(error)) from error
+            raise ClientConnectionError(str(error)) from error
+
+    async def request(self, method, url, *, data=None, timeout=None, proxy=None, **kwargs):
+        if kwargs:
+            raise ClientResponseError(f"Unsupported keyword arguments: {sorted(kwargs)}")
+
+        if timeout is None:
+            timeout = 5
+        elif isinstance(timeout, ClientTimeout):
+            timeout = timeout.total
+
+        return await asyncio.to_thread(self._blocking_request, method, url, data, timeout, proxy)
+
+    async def get(self, url, *, data=None, timeout=None, proxy=None, **kwargs):
+        return await self.request("GET", url, data=data, timeout=timeout, proxy=proxy, **kwargs)
+
+    async def post(self, url, *, data=None, timeout=None, proxy=None, **kwargs):
+        return await self.request("POST", url, data=data, timeout=timeout, proxy=proxy, **kwargs)
+
+    async def put(self, url, *, data=None, timeout=None, proxy=None, **kwargs):
+        return await self.request("PUT", url, data=data, timeout=timeout, proxy=proxy, **kwargs)
+
+    async def delete(self, url, *, data=None, timeout=None, proxy=None, **kwargs):
+        return await self.request("DELETE", url, data=data, timeout=timeout, proxy=proxy, **kwargs)
