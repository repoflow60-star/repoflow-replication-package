+def _merge_params(url, params):
+    if not params:
+        return url
+
+    separator = '&' if '?' in url else '?'
+    return '{}{}{}'.format(url, separator, urlencode(params, doseq=True))
+
+
+def _prepare_headers(headers=None, add_trace_headers=False):
+    if headers is None:
+        headers = dict(config.HEADERS)
+        if add_trace_headers:
+            headers['Filestack-Trace-Id'] = '{}-{}'.format(int(time.time()), unique_id())
+            headers['Filestack-Trace-Span'] = 'pythonsdk-{}'.format(unique_id())
+        return headers
+
+    return dict(headers)
+
+
+def _responses_active():
+    try:
+        import responses
+    except ImportError:
+        return False
+
+    return getattr(responses._default_mock, '_patcher', None) is not None
+
+
+def _as_text(data, headers=None):
+    if data is None:
+        return ''
+
+    if isinstance(data, str):
+        return data
+
+    charset = 'utf-8'
+    if headers is not None:
+        content_type = headers.get('content-type') or headers.get('Content-Type')
+        if content_type and 'charset=' in content_type:
+            charset = content_type.split('charset=', 1)[1].split(';', 1)[0].strip()
+
+    return data.decode(charset, errors='replace')
+
+
+def _normalize_multipart_fields(fields):
+    normalized = {}
+
+    for key, value in fields.items():
+        if isinstance(value, tuple) and len(value) >= 2 and hasattr(value[1], 'read'):
+            file_obj = value[1]
+            file_data = file_obj.read()
+            if len(value) == 2:
+                normalized[key] = (value[0], file_data)
+            else:
+                normalized[key] = (value[0], file_data, *value[2:])
+            continue
+
+        if hasattr(value, 'read'):
+            normalized[key] = value.read()
+            continue
+
+        normalized[key] = value
+
+    return normalized
+
