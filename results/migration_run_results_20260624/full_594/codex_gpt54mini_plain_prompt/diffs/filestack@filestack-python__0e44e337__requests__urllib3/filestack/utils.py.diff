+class ResponseWrapper:
+    def __init__(self, response, url, stream=False):
+        self._response = response
+        self.url = url
+        self._stream = stream
+
+    @property
+    def status_code(self):
+        return self._response.status
+
+    @property
+    def ok(self):
+        return 200 <= self.status_code < 400
+
+    @property
+    def headers(self):
+        return self._response.headers
+
+    @property
+    def content(self):
+        if self._stream:
+            return self._response.read()
+        return self._response.data
+
+    @property
+    def text(self):
+        return _as_text(self.content, self.headers)
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if not self.ok:
+            raise Urllib3HTTPError('HTTP {}'.format(self.status_code))
+
+    def iter_content(self, chunk_size):
+        if self._stream:
+            yield from self._response.stream(chunk_size)
+            return
+
+        content = self.content or b''
+        for start in range(0, len(content), chunk_size):
+            yield content[start:start + chunk_size]
+
+    def close(self):
+        self._response.close()
+
