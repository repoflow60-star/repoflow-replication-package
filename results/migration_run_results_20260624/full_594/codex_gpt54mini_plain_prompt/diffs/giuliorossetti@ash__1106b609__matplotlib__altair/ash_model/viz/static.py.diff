 from ash_model.measures import *
 
 
+def _mark_kwargs(kwargs: Dict[str, Any]) -> Dict[str, Any]:
+    allowed = {
+        "color",
+        "opacity",
+        "size",
+        "filled",
+        "shape",
+        "stroke",
+        "strokeWidth",
+        "strokeDash",
+        "point",
+        "line",
+        "interpolate",
+    }
+    return {k: v for k, v in kwargs.items() if k in allowed}
+
+
+def _properties_kwargs(kwargs: Dict[str, Any]) -> Dict[str, Any]:
+    allowed = {"title", "width", "height"}
+    return {k: v for k, v in kwargs.items() if k in allowed}
+
+
+def _log_safe_frame(frame: pd.DataFrame) -> pd.DataFrame:
+    if frame.empty:
+        return frame
+    return frame[(frame["x"] > 0) & (frame["y"] > 0)]
+
+
+def _series_frame(
+    x_values: Iterable[Any], y_values: Iterable[Any], series_name: str
+) -> pd.DataFrame:
+    return pd.DataFrame(
+        {
+            "x": list(x_values),
+            "y": list(y_values),
+            "series": series_name,
+        }
+    )
+
