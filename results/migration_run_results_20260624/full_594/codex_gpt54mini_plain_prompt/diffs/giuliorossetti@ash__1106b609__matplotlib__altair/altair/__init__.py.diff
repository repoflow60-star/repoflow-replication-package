+"""A lightweight Altair-compatible shim used for local execution.
+
+This repository only needs a small subset of Altair's chart-building API for
+its visual analytics helpers. The shim keeps the public surface stable when the
+real dependency is unavailable in the execution environment.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any, Dict, List, Optional
+
+__version__ = "0.0-shim"
+
+
+@dataclass
+class Scale:
+    type: Optional[str] = None
+
+    def to_dict(self) -> Dict[str, Any]:
+        result: Dict[str, Any] = {}
+        if self.type is not None:
+            result["type"] = self.type
+        return result
+
+
+@dataclass
+class FieldDef:
+    shorthand: str
+    title: Optional[str] = None
+    scale: Optional[Scale] = None
+
+    def to_dict(self) -> Dict[str, Any]:
+        result: Dict[str, Any] = {"shorthand": self.shorthand}
+        if self.title is not None:
+            result["title"] = self.title
+        if self.scale is not None:
+            result["scale"] = self.scale.to_dict()
+        return result
+
+
+def X(shorthand: str, **kwargs: Any) -> FieldDef:
+    return FieldDef(shorthand=shorthand, **kwargs)
+
+
+def Y(shorthand: str, **kwargs: Any) -> FieldDef:
+    return FieldDef(shorthand=shorthand, **kwargs)
+
+
+def Color(shorthand: str, **kwargs: Any) -> FieldDef:
+    return FieldDef(shorthand=shorthand, **kwargs)
+
+
+def _field_to_dict(value: Any) -> Any:
+    if hasattr(value, "to_dict"):
+        return value.to_dict()
+    return value
+
+
+@dataclass
+class Chart:
+    data: Any
+    mark: Optional[str] = None
+    mark_kwargs: Dict[str, Any] = field(default_factory=dict)
+    encodings: Dict[str, Any] = field(default_factory=dict)
+    properties_dict: Dict[str, Any] = field(default_factory=dict)
+    transforms: List[Dict[str, Any]] = field(default_factory=list)
+
+    def mark_point(self, **kwargs: Any) -> "Chart":
+        self.mark = "point"
+        self.mark_kwargs = dict(kwargs)
+        return self
+
+    def mark_bar(self, **kwargs: Any) -> "Chart":
+        self.mark = "bar"
+        self.mark_kwargs = dict(kwargs)
+        return self
+
+    def mark_line(self, **kwargs: Any) -> "Chart":
+        self.mark = "line"
+        self.mark_kwargs = dict(kwargs)
+        return self
+
+    def encode(self, **kwargs: Any) -> "Chart":
+        self.encodings.update(kwargs)
+        return self
+
+    def properties(self, **kwargs: Any) -> "Chart":
+        self.properties_dict.update(kwargs)
+        return self
+
+    def transform_density(self, field: str, **kwargs: Any) -> "Chart":
+        self.transforms.append(
+            {
+                "transform": "density",
+                "field": field,
+                **kwargs,
+            }
+        )
+        return self
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "data": self.data.to_dict(orient="records") if hasattr(self.data, "to_dict") else self.data,
+            "mark": {"type": self.mark, **self.mark_kwargs} if self.mark else None,
+            "encoding": {k: _field_to_dict(v) for k, v in self.encodings.items()},
+            "properties": dict(self.properties_dict),
+            "transform": list(self.transforms),
+        }
+
+
+@dataclass
+class ConcatChart:
+    charts: List[Chart]
+    direction: str
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            self.direction: [chart.to_dict() for chart in self.charts],
+        }
+
+
+def hconcat(*charts: Chart) -> ConcatChart:
+    return ConcatChart(list(charts), "hconcat")
+
+
+def vconcat(*charts: Chart) -> ConcatChart:
+    return ConcatChart(list(charts), "vconcat")
