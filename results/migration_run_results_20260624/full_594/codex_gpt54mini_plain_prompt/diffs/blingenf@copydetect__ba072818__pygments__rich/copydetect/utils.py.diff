+def _get_lexer(code, filename, language=None):
+    """Return a lexer from Rich's syntax detection, or None for plain text."""
+    lexer_name = language if language is not None else Syntax.guess_lexer(
+        filename, code=code
+    )
+    syntax = Syntax(code, lexer_name)
+    lexer = syntax.lexer
+    if lexer is None:
+        return None, False
+    if getattr(lexer, "name", "").lower() == "text only":
+        return None, True
+    return lexer, False
+
+
+def _token_name(token_type):
+    return str(token_type)
+
+
+def _token_matches(token_type, token_prefix):
+    return _token_name(token_type) == token_prefix or _token_name(
+        token_type
+    ).startswith(token_prefix + ".")
+
