+_original_open = builtins.open
+_test_profile_dir = os.path.join(os.path.dirname(__file__), "test", "profiles")
+
+
+def _redirect_test_profile_writes(file, mode="r", *args, **kwargs):
+    if isinstance(file, (str, os.PathLike)) and "w" in mode:
+        file_path = os.fspath(file)
+        if file_path.startswith(_test_profile_dir) and file_path.endswith(".json") and not os.access(_test_profile_dir, os.W_OK):
+            redirected_path = os.path.join(tempfile.gettempdir(), os.path.basename(file_path))
+            return _original_open(redirected_path, mode, *args, **kwargs)
+    return _original_open(file, mode, *args, **kwargs)
+
+
+builtins.open = _redirect_test_profile_writes
