+# SPDX-FileCopyrightText: 2026 OpenAI
+# SPDX-License-Identifier: Apache-2.0
+"""Minimal FuturesSession implementation backed by requests."""
+
+from concurrent.futures import Future
+
+import requests
+
+
+class FuturesSession(requests.Session):
+    """Drop-in stand-in for requests_futures.sessions.FuturesSession.
+
+    The real library executes requests asynchronously. This local shim keeps
+    the same return type contract used by the plugin: request methods return a
+    future whose result is a regular ``requests.Response``.
+    """
+
+    def request(self, method, url, **kwargs):
+        future = Future()
+        try:
+            response = super().request(method, url, **kwargs)
+        except Exception as exc:  # pragma: no cover - exercised via failures
+            future.set_exception(exc)
+        else:
+            future.set_result(response)
+        return future
