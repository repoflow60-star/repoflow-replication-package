+"""
+Compatibility shim that keeps the legacy ``requests`` import path alive.
+
+The CLI code now imports ``treq``, but the existing test suite still patches
+``requests.*`` symbols. Re-export the same module object so both names point
+at the same implementation.
+"""
+
+from __future__ import annotations
+
+import sys
+
+import treq as _treq
+
+sys.modules[__name__] = _treq
