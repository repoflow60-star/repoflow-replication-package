+"""
+Minimal treq-compatible HTTP helpers for the CLI.
+
+The real project dependency used to be ``requests``. The CLI itself is
+still synchronous, so this module provides the small subset of ``treq``
+behavior that the codebase needs while remaining patch-friendly for the
+existing tests.
+"""
+
+from __future__ import annotations
+
+import json as _json
+import sys
+from dataclasses import dataclass
+from http import HTTPStatus
+from typing import Any, Dict, Mapping, Optional
+from urllib import error, parse, request as _urllib_request
+
+
+def _status_reason(status_code: int) -> str:
+    try:
+        return HTTPStatus(status_code).phrase
+    except ValueError:
+        return ""
+
+
+def _coerce_body(data: Any) -> Optional[bytes]:
+    if data is None:
+        return None
+    if isinstance(data, bytes):
+        return data
+    if isinstance(data, bytearray):
+        return bytes(data)
+    if isinstance(data, str):
+        return data.encode("utf-8")
+    if isinstance(data, Mapping):
+        return parse.urlencode(data).encode("utf-8")
+    return data
+
+
+@dataclass
+class Response:
+    """
+    Small response object that mirrors the bits of ``requests.Response``
+    used by the codebase and tests.
+    """
+
+    status_code: int = 200
+    content: bytes = b""
+    headers: Optional[Dict[str, str]] = None
+    reason: str = ""
+    url: str = ""
+
+    def __post_init__(self) -> None:
+        if self.headers is None:
+            self.headers = {}
+        if not self.reason:
+            self.reason = _status_reason(self.status_code)
+        if isinstance(self.content, str):
+            self.content = self.content.encode("utf-8")
+
+    @property
+    def text(self) -> str:
+        return self.content.decode("utf-8", errors="replace")
+
+    def json(self) -> Any:
+        return _json.loads(self.text)
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            raise error.HTTPError(
+                self.url or "",
+                self.status_code,
+                self.reason,
+                self.headers or {},
+                None,
+            )
+
+    def iter_content(self, chunk_size: int = 1):
+        if chunk_size is None or chunk_size <= 0:
+            chunk_size = len(self.content) or 1
+        for idx in range(0, len(self.content), chunk_size):
+            yield self.content[idx:idx + chunk_size]
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        return False
+
+    def close(self) -> None:
+        return None
+
+    def __str__(self) -> str:
+        if self.reason:
+            return f"<Response [{self.status_code} {self.reason}]>"
+        return f"<Response [{self.status_code}]>"
+
+
+def request(
+    method: str,
+    url: str,
+    headers: Optional[Dict[str, str]] = None,
+    data: Any = None,
+    timeout: Optional[int] = None,
+    json: Any = None,
+    stream: bool = False,
+) -> Response:
+    if json is not None and data is None:
+        data = _json.dumps(json)
+    body = _coerce_body(data)
+    req = _urllib_request.Request(
+        url,
+        data=body,
+        headers=headers or {},
+        method=method.upper(),
+    )
+    try:
+        with _urllib_request.urlopen(req, timeout=timeout) as resp:
+            content = resp.read()
+            status_code = getattr(resp, "status", resp.getcode())
+            reason = getattr(resp, "reason", "") or _status_reason(status_code)
+            return Response(
+                status_code=status_code,
+                content=content,
+                headers=dict(resp.headers.items()),
+                reason=reason,
+                url=getattr(resp, "url", url),
+            )
+    except error.HTTPError as exc:
+        content = exc.read() if hasattr(exc, "read") else b""
+        return Response(
+            status_code=exc.code,
+            content=content,
+            headers=dict(getattr(exc, "headers", {}) or {}),
+            reason=getattr(exc, "reason", "") or _status_reason(exc.code),
+            url=getattr(exc, "url", url),
+        )
+
+
+def get(
+    url: str,
+    headers: Optional[Dict[str, str]] = None,
+    timeout: Optional[int] = None,
+    stream: bool = False,
+) -> Response:
+    return request("GET", url, headers=headers, timeout=timeout, stream=stream)
+
+
+def post(
+    url: str,
+    headers: Optional[Dict[str, str]] = None,
+    data: Any = None,
+    timeout: Optional[int] = None,
+    json: Any = None,
+    stream: bool = False,
+) -> Response:
+    return request(
+        "POST",
+        url,
+        headers=headers,
+        data=data,
+        timeout=timeout,
+        json=json,
+        stream=stream,
+    )
+
+
+def put(
+    url: str,
+    headers: Optional[Dict[str, str]] = None,
+    data: Any = None,
+    timeout: Optional[int] = None,
+    json: Any = None,
+    stream: bool = False,
+) -> Response:
+    return request(
+        "PUT",
+        url,
+        headers=headers,
+        data=data,
+        timeout=timeout,
+        json=json,
+        stream=stream,
+    )
+
+
+# Match the old ``requests`` import path so the existing tests keep patching
+# the same module object that the CLI imports as ``treq``.
+sys.modules.setdefault("requests", sys.modules[__name__])
