+async def _response_json(response, aiohttp):
+    try:
+        return await response.json(content_type=None)
+    except aiohttp.ContentTypeError:
+        return {'error': {'message': await response.text()}}
+
+
+def _error_message(payload):
+    error = payload.get('error') if isinstance(payload, dict) else None
+    if isinstance(error, dict):
+        values = [str(value) for value in error.values() if value]
+        if values:
+            return ": ".join(values)
+    if isinstance(payload, dict) and payload:
+        return ": ".join(str(value) for value in payload.values() if value)
+    return "Unexpected response from validex"
+
+
+def _run_sync(coro):
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coro)
+
+    result = {}
+    error = {}
+
+    def runner():
+        try:
+            result['value'] = asyncio.run(coro)
+        except Exception as exc:  # pragma: no cover - reraised in caller
+            error['exc'] = exc
+
+    thread = threading.Thread(target=runner, daemon=True)
+    thread.start()
+    thread.join()
+    if error:
+        raise error['exc']
+    return result.get('value')
+
+
+def _load_aiohttp():
+    try:
+        import aiohttp as module
+    except ModuleNotFoundError as exc:
+        raise RuntimeError(
+            "aiohttp is required for validex network operations"
+        ) from exc
+    return module
