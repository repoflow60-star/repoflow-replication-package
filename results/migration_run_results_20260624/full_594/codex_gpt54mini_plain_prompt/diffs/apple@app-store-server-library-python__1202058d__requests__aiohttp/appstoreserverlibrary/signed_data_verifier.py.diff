+OCSP_REQUEST_TIMEOUT_SECONDS = 2
+
+
+def _perform_urllib_ocsp_request(url: str, data: bytes) -> tuple[int, bytes]:
+    request = urllib.request.Request(url, headers={"Content-Type": "application/ocsp-request"}, data=data, method="POST")
+    try:
+        with urllib.request.urlopen(request, timeout=OCSP_REQUEST_TIMEOUT_SECONDS) as response:
+            return response.status, response.read()
+    except urllib.error.HTTPError as error:
+        return error.code, error.read() if error.fp is not None else b""
+
+
+async def _perform_ocsp_request(url: str, data: bytes) -> tuple[int, bytes]:
+    if aiohttp is None:
+        raise RuntimeError("aiohttp is not available")
+    timeout = aiohttp.ClientTimeout(total=OCSP_REQUEST_TIMEOUT_SECONDS)
+    async with aiohttp.ClientSession(timeout=timeout) as session:
+        async with session.post(url, headers={"Content-Type": "application/ocsp-request"}, data=data) as response:
+            return response.status, await response.read()
