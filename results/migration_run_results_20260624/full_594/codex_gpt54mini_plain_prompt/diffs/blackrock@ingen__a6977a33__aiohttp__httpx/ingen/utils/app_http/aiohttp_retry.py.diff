+async def _read_response(url, response):
+    logger.info(f"awaiting response for {url}")
+
+    try:
+        status = getattr(response, 'status', getattr(response, 'status_code', None))
+        headers = _normalize_headers(getattr(response, 'headers', {}))
+
+        content_type = headers.get('Content-Type', headers.get('content-type', ''))
+        if content_type and 'application/json' in content_type:
+            data = response.json()
+            if inspect.isawaitable(data):
+                data = await data
+        else:
+            data = getattr(response, 'text', None)
+            if callable(data):
+                data = data()
+            if inspect.isawaitable(data):
+                data = await data
+            elif not isinstance(data, (str, bytes, type(None))):
+                raise TypeError(f"Unexpected response text type: {type(data)!r}")
+    except Exception as e:
+        raise ConnectionError(f"Error occurred while getting response from url {url}: {e}")
+
+    return HTTPResponse(status, headers, data)
+
+
+def _normalize_headers(headers):
+    if headers is None:
+        return {}
+
+    if isinstance(headers, dict):
+        return headers
+
+    try:
+        return dict(headers)
+    except Exception:
+        return {}
