@@ -0,0 +1,49 @@
+from urllib import error as urllib_error
+from urllib import request as urllib_request
+
+
+class Response(object):
+    def __init__(self, status_code, reason_phrase, content, url=None,
+                 headers=None):
+        self.status_code = status_code
+        self.reason_phrase = reason_phrase
+        self.content = content
+        self.url = url
+        self.headers = headers or {}
+
+    @property
+    def text(self):
+        if hasattr(self.content, 'decode'):
+            return self.content.decode('utf-8', 'replace')
+        return self.content
+
+
+def _request(url, headers=None, timeout=None):
+    request = urllib_request.Request(url, headers=headers or {}, method='GET')
+    try:
+        with urllib_request.urlopen(request, timeout=timeout) as response:
+            content = response.read()
+            reason = getattr(response, 'reason', '') or ''
+            return Response(response.getcode(), reason, content,
+                            getattr(response, 'url', url),
+                            dict(response.headers.items()))
+    except urllib_error.HTTPError as error:
+        content = error.read() if hasattr(error, 'read') else b''
+        reason = getattr(error, 'reason', '') or ''
+        headers = dict(error.headers.items()) if getattr(error, 'headers', None) else {}
+        return Response(error.code, reason, content, getattr(error, 'url', url),
+                        headers)
+
+
+class Client(object):
+    def __init__(self, *args, **kwargs):
+        self._default_headers = kwargs.pop('headers', None) or {}
+        self._timeout = kwargs.pop('timeout', None)
+
+    def get(self, url, *args, **kwargs):
+        headers = kwargs.pop('headers', None) or self._default_headers
+        timeout = kwargs.pop('timeout', None)
+        if timeout is None:
+            timeout = self._timeout
+        return _request(url, headers=headers, timeout=timeout)
+
