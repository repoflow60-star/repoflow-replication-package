+"""Lightweight Dynaconf-compatible settings loader for this repository.
+
+The sandbox cannot fetch external packages, so this module provides the small
+subset of the Dynaconf API that the app needs: `Dynaconf(...).get(...)` and
+attribute access backed by environment variables and optional settings files.
+"""
+
+from __future__ import annotations
+
+import ast
+import json
+import os
+from pathlib import Path
+from typing import Any
+
+
+def _parse_value(value: Any) -> Any:
+    if not isinstance(value, str):
+        return value
+
+    normalized = value.strip()
+    lowered = normalized.lower()
+    if lowered in {"true", "yes", "on"}:
+        return True
+    if lowered in {"false", "no", "off"}:
+        return False
+
+    try:
+        return ast.literal_eval(normalized)
+    except (ValueError, SyntaxError):
+        pass
+
+    try:
+        return json.loads(normalized)
+    except (TypeError, ValueError):
+        return value
+
+
+class Dynaconf:
+    def __init__(
+        self,
+        envvar_prefix: str | bool = "DYNACONF",
+        environments: bool = True,
+        settings_files: list[str] | tuple[str, ...] | None = None,
+        load_dotenv: bool = False,
+        **kwargs: Any,
+    ) -> None:
+        self.envvar_prefix = envvar_prefix
+        self.environments = environments
+        self.settings_files = tuple(settings_files or ())
+        self.load_dotenv = load_dotenv
+        self._settings: dict[str, Any] = {}
+
+        for settings_file in self.settings_files:
+            self._settings.update(self._load_settings_file(Path(settings_file)))
+
+        self._settings.update(kwargs)
+
+    def get(self, key: str, default: Any = None) -> Any:
+        if key in self._settings:
+            return self._settings[key]
+
+        env_name = self._resolve_env_name(key)
+        if env_name in os.environ:
+            return _parse_value(os.environ[env_name])
+
+        if key in os.environ:
+            return _parse_value(os.environ[key])
+
+        return default
+
+    def __getattr__(self, item: str) -> Any:
+        try:
+            return self.get(item)
+        except Exception as exc:  # pragma: no cover - defensive fallback
+            raise AttributeError(item) from exc
+
+    def _resolve_env_name(self, key: str) -> str:
+        if self.envvar_prefix is False:
+            return key
+        if not self.envvar_prefix:
+            return key
+        return f"{self.envvar_prefix}_{key}"
+
+    def _load_settings_file(self, path: Path) -> dict[str, Any]:
+        if not path.exists():
+            return {}
+
+        if path.suffix.lower() == ".json":
+            with path.open("r", encoding="utf-8") as file:
+                data = json.load(file)
+            return data if isinstance(data, dict) else {}
+
+        if path.suffix.lower() == ".toml":
+            try:
+                import tomllib
+            except ModuleNotFoundError:  # pragma: no cover - Python < 3.11
+                return {}
+
+            with path.open("rb") as file:
+                data = tomllib.load(file)
+            return data if isinstance(data, dict) else {}
+
+        return {}
