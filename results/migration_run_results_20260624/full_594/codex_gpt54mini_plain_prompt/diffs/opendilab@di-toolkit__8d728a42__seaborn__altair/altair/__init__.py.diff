@@ -0,0 +1,80 @@
+"""Local Altair-compatible chart wrapper for Matplotlib-backed rendering."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any, Dict, Optional
+
+import matplotlib.pyplot as plt
+
+__version__ = '0.0.0-local'
+
+
+def _as_frame(data):
+    if hasattr(data, 'groupby') and hasattr(data, '__getitem__'):
+        return data
+
+    try:
+        import pandas as pd
+    except ImportError as exc:  # pragma: no cover - pandas is a runtime dependency here.
+        raise RuntimeError('pandas is required for the local altair compatibility layer') from exc
+
+    return pd.DataFrame(data)
+
+
+@dataclass
+class _MarkSpec:
+    name: str
+    options: Dict[str, Any] = field(default_factory=dict)
+
+
+class Chart:
+    def __init__(self, data):
+        self.data = _as_frame(data)
+        self._mark: Optional[_MarkSpec] = None
+        self._encoding: Dict[str, Any] = {}
+        self._properties: Dict[str, Any] = {}
+
+    def mark_line(self, **kwargs):
+        self._mark = _MarkSpec('line', dict(kwargs))
+        return self
+
+    def encode(self, **kwargs):
+        self._encoding.update(kwargs)
+        return self
+
+    def properties(self, **kwargs):
+        self._properties.update(kwargs)
+        return self
+
+    def _get_field_name(self, value):
+        if value is None:
+            return None
+        if isinstance(value, str):
+            return value.split(':', 1)[0]
+        return getattr(value, 'shorthand', getattr(value, 'field', value))
+
+    def to_matplotlib(self, ax=None, label=None):
+        ax = ax or plt.gca()
+        xname = self._get_field_name(self._encoding.get('x'))
+        yname = self._get_field_name(self._encoding.get('y'))
+        color_name = self._get_field_name(self._encoding.get('color'))
+        line_kwargs = dict(self._mark.options if self._mark else {})
+        if label is not None:
+            line_kwargs.setdefault('label', label)
+
+        if color_name is None:
+            ax.plot(self.data[xname], self.data[yname], **line_kwargs)
+        else:
+            for key, group_df in self.data.groupby(color_name):
+                ax.plot(group_df[xname], group_df[yname], label=str(key), **line_kwargs)
+
+        return ax
+
+
+class _Themes:
+    def enable(self, _name):
+        return None
+
+
+themes = _Themes()
