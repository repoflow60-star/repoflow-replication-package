+class Command:
+    def __init__(
+        self,
+        name: str,
+        handler: Callable[..., object],
+        parser_factory: Callable[[str], argparse.ArgumentParser],
+    ):
+        self.name = name
+        self._handler = handler
+        self._parser_factory = parser_factory
+
+    def __call__(self, *args, **kwargs):
+        return self._handler(*args, **kwargs)
+
+    def main(
+        self,
+        args: list[str] | tuple[str, ...] | str | None = None,
+        prog_name: str | None = None,
+        standalone_mode: bool = True,
+        **kwargs,
+    ):
+        parsed_args = _normalize_args(args)
+        parser = self._parser_factory(prog_name or self.name)
+        namespace = parser.parse_args(parsed_args)
+        return self._handler(**vars(namespace))
+
+
+class GroupCommand:
+    def __init__(self, name: str, commands: Mapping[str, Command]):
+        self.name = name
+        self._commands = dict(commands)
+
+    def __call__(self, *args, **kwargs):
+        return self.main(*args, **kwargs)
+
+    def _help_text(self, prog_name: str) -> str:
+        lines = [
+            f"Usage: {prog_name} [OPTIONS] COMMAND [ARGS]...",
+            "",
+            "Commands:",
+        ]
+        for name in sorted(self._commands):
+            lines.append(f"  {name}")
+        lines.extend(
+            [
+                "",
+                "Options:",
+                "  --version  Show the version and exit.",
+                "  -h, --help Show this message and exit.",
+            ]
+        )
+        return "\n".join(lines)
+
+    def main(
+        self,
+        args: list[str] | tuple[str, ...] | str | None = None,
+        prog_name: str | None = None,
+        standalone_mode: bool = True,
+        **kwargs,
+    ):
+        parsed_args = _normalize_args(args)
+        prog_name = prog_name or self.name
+
+        if not parsed_args or parsed_args[0] in {"-h", "--help"}:
+            print(self._help_text(prog_name))
+            return 0
+
+        if parsed_args[0] in {"--version", "-V"}:
+            print(_version())
+            return 0
+
+        command_name, *command_args = parsed_args
+        command = self._commands.get(command_name)
+        if command is None:
+            print(f"No such command '{command_name}'.")
+            return 2
+
+        return command.main(
+            command_args, prog_name=f"{prog_name} {command_name}"
+        )
+
+
