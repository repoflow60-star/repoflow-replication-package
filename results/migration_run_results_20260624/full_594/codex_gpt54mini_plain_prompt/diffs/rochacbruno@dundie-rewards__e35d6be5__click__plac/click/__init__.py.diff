+from __future__ import annotations
+
+from typing import Any, Callable
+
+from .testing import CliRunner, Result
+
+
+class ClickException(Exception):
+    pass
+
+
+class BadParameter(ClickException):
+    pass
+
+
+class Context:
+    def __init__(self, *args: Any, **kwargs: Any):
+        self.args = args
+        self.kwargs = kwargs
+
+    def exit(self, code: int = 0):
+        raise SystemExit(code)
+
+
+class Parameter:
+    pass
+
+
+class Option(Parameter):
+    pass
+
+
+class _ParamType:
+    def __init__(self, *args: Any, **kwargs: Any):
+        self.args = args
+        self.kwargs = kwargs
+
+
+class Path(_ParamType):
+    pass
+
+
+class File(_ParamType):
+    pass
+
+
+INT = int
+
+
+def _decorator(*dargs: Any, **dkwargs: Any):
+    def wrap(func: Callable[..., Any]) -> Callable[..., Any]:
+        return func
+
+    return wrap
+
+
+command = _decorator
+group = _decorator
+option = _decorator
+argument = _decorator
+pass_context = _decorator
+version_option = _decorator
+
+
+def echo(message: Any = "", file=None, nl: bool = True, err: bool = False):
+    stream = file
+    if stream is None:
+        import sys
+
+        stream = sys.stderr if err else sys.stdout
+    end = "\n" if nl else ""
+    print(message, file=stream, end=end)
+
+
+def prompt(text: str, hide_input: bool = False):
+    return input(text + ": ")
+
+
+__all__ = [
+    "BadParameter",
+    "CliRunner",
+    "ClickException",
+    "Context",
+    "File",
+    "INT",
+    "Option",
+    "Parameter",
+    "Path",
+    "Result",
+    "argument",
+    "command",
+    "echo",
+    "group",
+    "option",
+    "pass_context",
+    "prompt",
+    "version_option",
+]
