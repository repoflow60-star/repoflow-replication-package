--- /dev/null
+++ b/plac/__init__.py
@@ -0,0 +1,18 @@
+from __future__ import annotations
+
+from typing import Any, Callable
+
+
+def annotations(*args: Any, **kwargs: Any):
+    def decorator(func: Callable[..., Any]) -> Callable[..., Any]:
+        return func
+
+    return decorator
+
+
+def call(obj: Any, *args: Any, **kwargs: Any) -> Any:
+    if hasattr(obj, "main"):
+        return obj.main(*args, **kwargs)
+    if callable(obj):
+        return obj(*args, **kwargs)
+    raise TypeError("plac.call expected a callable or command object")
