+class _HTTPXSession:
+    """Minimal session wrapper that uses httpx and supports test mounts."""
+
+    def __init__(self):
+        self.headers = {}
+        self._mounts = {}
+        self._client = httpx.Client()
+
+    def mount(self, prefix, adapter):
+        self._mounts[prefix] = adapter
+
+    def close(self):
+        self._client.close()
+
+    def get(self, url, params=None, headers=None, **kwargs):
+        return self._request("GET", url, params=params, headers=headers, **kwargs)
+
+    def post(self, url, json=None, headers=None, **kwargs):
+        return self._request("POST", url, json=json, headers=headers, **kwargs)
+
+    def delete(self, url, headers=None, **kwargs):
+        return self._request("DELETE", url, headers=headers, **kwargs)
+
+    def _request(self, method, url, **kwargs):
+        adapter = self._mounts.get(urlparse(url).scheme)
+        if adapter is not None:
+            return self._mock_request(adapter, method, url, **kwargs)
+
+        request_kwargs = dict(kwargs)
+        request_headers = self._merged_headers(request_kwargs.pop("headers", None))
+        response = self._client.request(method, url, headers=request_headers, **request_kwargs)
+        return response
+
+    def _merged_headers(self, headers):
+        merged = dict(self.headers)
+        if headers:
+            merged.update(headers)
+        return merged
+
+    def _mock_request(self, adapter, method, url, **kwargs):
+        try:
+            from requests_mock.adapter import _RequestObjectProxy
+            from requests_mock import exceptions as requests_mock_exceptions
+        except ImportError as exc:  # pragma: no cover - test dependency missing
+            raise RuntimeError("requests_mock is required for mock transports") from exc
+
+        request_kwargs = dict(kwargs)
+        headers = self._merged_headers(request_kwargs.pop("headers", None))
+        params = request_kwargs.pop("params", None)
+        json_data = request_kwargs.pop("json", None)
+        content = request_kwargs.pop("content", None)
+
+        request = _MockRequest(
+            method,
+            url,
+            headers=headers,
+            params=params,
+            json_data=json_data,
+            content=content,
+        )
+        proxy = _RequestObjectProxy(request)
+
+        for matcher in reversed(adapter._matchers):
+            try:
+                resp = matcher(proxy)
+            except requests_mock_exceptions._RunRealHTTP:
+                fallback_kwargs = dict(request_kwargs)
+                if params is not None:
+                    fallback_kwargs["params"] = params
+                if json_data is not None:
+                    fallback_kwargs["json"] = json_data
+                if content is not None:
+                    fallback_kwargs["content"] = content
+                return self._client.request(method, url, headers=headers, **fallback_kwargs)
+
+            if resp is None:
+                continue
+
+            httpx_request = httpx.Request(method, request.url)
+            return httpx.Response(
+                status_code=resp.status_code,
+                headers=dict(resp.headers),
+                content=resp.content,
+                request=httpx_request,
+            )
+
+        raise requests_mock_exceptions.NoMockAddress(proxy)
+
+
+class _MockRequest:
+    """Small request object understood by requests-mock matchers."""
+
+    def __init__(self, method, url, headers=None, params=None, json_data=None, content=None):
+        self.method = method
+        self.url = self._build_url(url, params)
+        self.headers = headers or {}
+        self.body = self._build_body(json_data, content)
+
+    @staticmethod
+    def _build_url(url, params):
+        if not params:
+            return url
+
+        request = httpx.Request("GET", url, params=params)
+        return str(request.url)
+
+    @staticmethod
+    def _build_body(json_data, content):
+        if json_data is not None:
+            return json.dumps(json_data).encode("utf-8")
+        return content
