+def __kde_curve(values, num_points=200):
+    """
+    Build a smooth density curve for plotting.
+
+    :param values: sample values
+    :param num_points: number of evaluation points used for the curve
+    :return: dataframe with x/y coordinates for the density curve
+    """
+    series = pd.Series(values, dtype="float64").dropna()
+    if series.empty:
+        return pd.DataFrame(columns=["value", "density"])
+
+    if series.nunique() == 1:
+        center = float(series.iloc[0])
+        width = max(abs(center) * 0.1, 0.1)
+        x = np.linspace(center - width, center + width, num_points)
+        sigma = max(width / 3.0, 1e-3)
+        y = np.exp(-0.5 * ((x - center) / sigma) ** 2) / (
+            sigma * np.sqrt(2.0 * np.pi)
+        )
+        return pd.DataFrame({"value": x, "density": y})
+
+    kde = gaussian_kde(series.to_numpy())
+    spread = float(series.std(ddof=0))
+    if not np.isfinite(spread) or spread == 0:
+        spread = max(float(series.max() - series.min()), 1.0) * 0.1
+    padding = max(spread * 0.5, 0.1)
+    x = np.linspace(float(series.min()) - padding, float(series.max()) + padding, num_points)
+    y = kde(x)
+    return pd.DataFrame({"value": x, "density": y})
+
+
+def __build_consistency_chart(curves):
+    """
+    Build an Altair chart for the consistency density curves when Altair is available.
+
+    :param curves: mapping of attribute name to density dataframe
+    :return: Altair chart or None when Altair is unavailable
+    """
+    if alt is None:
+        return None
+
+    chart_data = pd.concat(
+        [curve.assign(attribute=attr_name) for attr_name, curve in curves.items()],
+        ignore_index=True,
+    )
+    if chart_data.empty:
+        return None
+
+    return (
+        alt.Chart(chart_data)
+        .mark_line()
+        .encode(
+            x=alt.X("value:Q", title="Consistency"),
+            y=alt.Y("density:Q", title="Density"),
+            color=alt.Color("attribute:N", title="Attribute"),
+        )
+    )
+
