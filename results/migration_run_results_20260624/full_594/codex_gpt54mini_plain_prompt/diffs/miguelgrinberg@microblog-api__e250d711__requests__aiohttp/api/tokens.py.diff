+class _OAuth2Response:
+    def __init__(self, status_code, payload):
+        self.status_code = status_code
+        self._payload = payload or {}
+
+    def json(self):
+        return self._payload
+
+
+class _OAuth2Requests:
+    @staticmethod
+    def post(url, data=None, headers=None):
+        return _oauth2_request('POST', url, data=data, headers=headers)
+
+    @staticmethod
+    def get(url, headers=None):
+        return _oauth2_request('GET', url, headers=headers)
+
+
+def _oauth2_request(method, url, data=None, headers=None):
+    try:
+        import aiohttp
+    except ImportError:
+        return _oauth2_request_urllib(method, url, data=data, headers=headers)
+    return asyncio.run(_oauth2_request_aiohttp(
+        method, url, data=data, headers=headers, aiohttp=aiohttp))
+
+
+async def _oauth2_request_aiohttp(method, url, data=None, headers=None,
+                                  aiohttp=None):
+    timeout = aiohttp.ClientTimeout(total=10)
+    async with aiohttp.ClientSession(timeout=timeout) as session:
+        async with session.request(method, url, data=data, headers=headers) \
+                as response:
+            if response.status != 200:
+                return _OAuth2Response(response.status, None)
+            return _OAuth2Response(
+                response.status, await response.json(content_type=None))
+
+
+def _oauth2_request_urllib(method, url, data=None, headers=None):
+    request = Request(url, data=_encode_body(data), headers=headers or {},
+                      method=method)
+    try:
+        with urlopen(request) as response:
+            payload = response.read().decode('utf-8')
+            return _OAuth2Response(response.status, loads(payload))
+    except HTTPError as error:
+        return _OAuth2Response(error.code, None)
+
+
+def _encode_body(data):
+    if data is None:
+        return None
+    if isinstance(data, bytes):
+        return data
+    if isinstance(data, str):
+        return data.encode('utf-8')
+    return urlencode(data).encode('utf-8')
+
+
+requests = _OAuth2Requests()
+
