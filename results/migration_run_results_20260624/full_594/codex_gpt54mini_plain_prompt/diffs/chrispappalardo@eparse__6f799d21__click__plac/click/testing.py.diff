+"""
+Minimal click.testing compatibility layer.
+"""
+
+from __future__ import annotations
+
+from contextlib import redirect_stderr, redirect_stdout
+from dataclasses import dataclass
+from io import StringIO
+
+
+@dataclass
+class Result:
+    exit_code: int
+    output: str
+    exception: Exception | None = None
+
+
+class CliRunner:
+    def invoke(self, cli, args=None, obj=None, catch_exceptions=True, **kwargs):
+        stream = StringIO()
+        args = list(args or [])
+        obj = {} if obj is None else obj
+
+        try:
+            with redirect_stdout(stream), redirect_stderr(stream):
+                rv = cli(argv=args, obj=obj)
+        except SystemExit as exc:
+            code = exc.code if isinstance(exc.code, int) else 1
+            return Result(exit_code=code, output=stream.getvalue(), exception=exc)
+        except Exception as exc:
+            if catch_exceptions:
+                return Result(exit_code=1, output=stream.getvalue(), exception=exc)
+            raise
+
+        if rv is None:
+            rv = 0
+
+        return Result(exit_code=rv, output=stream.getvalue())
+
