+"""
+Minimal plac compatibility layer for this project.
+"""
+
+from __future__ import annotations
+
+import sys
+
+
+def annotations(**kwargs):
+    def decorator(func):
+        return func
+
+    return decorator
+
+
+def pos(*args, **kwargs):
+    return annotations(**kwargs)
+
+
+def opt(*args, **kwargs):
+    return annotations(**kwargs)
+
+
+def flg(*args, **kwargs):
+    return annotations(**kwargs)
+
+
+def call(func, arglist=None, commentchar="#", split=None, stdin=None, prompt="i> ", verbose=False):
+    if arglist is None:
+        arglist = sys.argv[1:]
+    return func(arglist)
+
+
+class Interpreter:
+    def __init__(self, obj):
+        self.obj = obj
+
+    @classmethod
+    def call(
+        cls,
+        factory,
+        arglist=None,
+        commentchar="#",
+        split=None,
+        stdin=None,
+        prompt="i> ",
+        verbose=False,
+    ):
+        if arglist is None:
+            arglist = sys.argv[1:]
+        return call(factory, arglist=arglist, commentchar=commentchar, split=split, stdin=stdin, prompt=prompt, verbose=verbose)
