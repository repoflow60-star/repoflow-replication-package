+def main(argv=None, obj=None):
+    """
+    excel parser
+    """
+
+    if argv is None:
+        argv = sys.argv[1:]
+
+    if not argv or argv[0] in ("-h", "--help"):
+        print(_usage())
+        return 0
+
+    global_options, command, rest = _parse_global(list(argv))
+
+    if command is None:
+        print(_usage())
+        return 0
+
+    ctx = _ctx(obj)
+    _set_global_options(ctx, global_options)
+
+    if command == "scan":
+        options = _parse_scan(rest)
+        if options is None:
+            return 0
+        _run_scan(ctx, options["number"], options["sheet"], options["tables"])
+        return 0
+
+    if command == "parse":
+        options = _parse_parse(rest)
+        if options is None:
+            return 0
+        _run_parse(
+            ctx,
+            options["sheet"],
+            options["serialize"],
+            options["table"],
+            options["nacount"],
+        )
+        return 0
+
+    if command == "query":
+        options = _parse_query(rest)
+        if options is None:
+            return 0
+        _run_query(ctx, options["filter"], options["method"], options["serialize"])
+        return 0
+
+    if command == "migrate":
+        options = _parse_migrate(rest)
+        if options is None:
+            return 0
+        _run_migrate(ctx, options["migration"])
+        return 0
+
+    print(_usage())
+    return 1
+
+
