+def _format_table(rows: list, headers: list, show_header: bool = True) -> str:
+    table = PrettyTable()
+    table.field_names = headers
+    table.header = show_header
+    table.border = False
+    table.hrules = NONE
+    table.vrules = NONE
+    table.padding_width = 1
+    table.align = "r"
+    for row in rows:
+        table.add_row(row)
+
+    return table.get_string()
