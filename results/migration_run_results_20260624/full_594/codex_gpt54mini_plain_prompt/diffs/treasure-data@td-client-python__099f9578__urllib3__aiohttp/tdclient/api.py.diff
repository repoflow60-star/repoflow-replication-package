+class _Proxy:
+    def __init__(self, url):
+        self.url = url
+
+
+class _Response:
+    def __init__(self, status, headers, body):
+        self.status = status
+        self.data = body
+        self._headers = dict(headers)
+        self._offset = 0
+        self._closed = False
+
+    def read(self, size=None):
+        if size is None or size < 0:
+            size = len(self.data) - self._offset
+        start = self._offset
+        end = min(len(self.data), start + size)
+        self._offset = end
+        return self.data[start:end]
+
+    def stream(self, size=None):
+        size = 1024 if size is None else size
+        while True:
+            chunk = self.read(size)
+            if not chunk:
+                break
+            yield chunk
+
+    def getheaders(self):
+        return list(self._headers.items())
+
+    def close(self):
+        self._closed = True
+
+
+class _AiohttpTransport:
+    def __init__(
+        self,
+        timeout=60,
+        ca_certs=None,
+        proxy=None,
+        proxy_auth=None,
+        **kwargs,
+    ):
+        self._timeout = timeout
+        self._ca_certs = ca_certs
+        self.proxy = _Proxy(proxy) if proxy is not None else None
+        self.proxy_headers = {}
+        if proxy_auth is not None:
+            self.proxy_headers["proxy-authorization"] = proxy_auth.encode()
+        self._proxy = proxy
+        self._proxy_auth = proxy_auth
+
+    def clear(self):
+        return None
+
+    def close(self):
+        return None
+
+    def request(self, method, url, fields=None, body=None, headers=None, **kwargs):
+        return asyncio.run(
+            self._request(method, url, fields=fields, body=body, headers=headers, **kwargs)
+        )
+
+    def urlopen(self, method, url, body=None, headers=None, **kwargs):
+        return self.request(method, url, body=body, headers=headers, **kwargs)
+
+    async def _request(self, method, url, fields=None, body=None, headers=None, **kwargs):
+        request_kwargs = {}
+        if headers is not None:
+            request_kwargs["headers"] = headers
+        if self._proxy is not None:
+            request_kwargs["proxy"] = self._proxy
+        if self._proxy_auth is not None:
+            request_kwargs["proxy_auth"] = self._proxy_auth
+
+        if fields is not None:
+            if method.upper() in {"GET", "DELETE"}:
+                request_kwargs["params"] = fields
+            else:
+                request_kwargs["data"] = fields
+
+        if body is not None:
+            if hasattr(body, "read"):
+                body = body.read()
+            elif isinstance(body, array):
+                body = body.tobytes()
+            elif isinstance(body, bytearray):
+                body = bytes(body)
+            elif isinstance(body, memoryview):
+                body = body.tobytes()
+            request_kwargs["data"] = body
+
+        if self._ca_certs is not None:
+            ssl_context = ssl.create_default_context(cafile=self._ca_certs)
+        else:
+            ssl_context = None
+
+        timeout = aiohttp.ClientTimeout(total=self._timeout)
+        connector = aiohttp.TCPConnector(ssl=ssl_context)
+        async with aiohttp.ClientSession(timeout=timeout, connector=connector) as session:
+            async with session.request(method, url, **request_kwargs) as response:
+                body = await response.read()
+                return _Response(response.status, response.headers, body)
+
+
