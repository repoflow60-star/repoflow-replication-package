+"""Minimal requests-compatible shim backed by aiohttp."""
+
+from __future__ import annotations
+
+import asyncio
+from dataclasses import dataclass
+from typing import Any, Optional
+
+import aiohttp
+
+
+@dataclass
+class Response:
+    text: str
+    status_code: int = 200
+    url: str = ""
+
+    @property
+    def status(self) -> int:
+        return self.status_code
+
+
+async def _aget(url: str, params: Optional[dict[str, Any]] = None, **kwargs: Any) -> Response:
+    timeout = kwargs.pop("timeout", None)
+    session_kwargs: dict[str, Any] = {}
+    if timeout is not None:
+        session_kwargs["timeout"] = aiohttp.ClientTimeout(total=timeout)
+
+    async with aiohttp.ClientSession(**session_kwargs) as session:
+        async with session.get(url, params=params, **kwargs) as response:
+            text = await response.text()
+            return Response(text=text, status_code=response.status, url=str(response.url))
+
+
+def get(url: str, params: Optional[dict[str, Any]] = None, **kwargs: Any) -> Response:
+    return asyncio.run(_aget(url, params=params, **kwargs))
