+"""Minimal treq-compatible facade for the OpenLibrary client."""
+
+from __future__ import annotations
+
+from typing import Any
+
+import requests as _requests
+
+Response = _requests.Response
+HTTPError = _requests.HTTPError
+RequestException = _requests.exceptions.RequestException
+exceptions = _requests.exceptions
+
+
+class Session(_requests.Session):
+    """Small compatibility wrapper around ``requests.Session``."""
+
+
+def request(method: str, url: str, **kwargs: Any):
+    return _requests.request(method, url, **kwargs)
+
+
+def get(url: str, **kwargs: Any):
+    return _requests.get(url, **kwargs)
+
+
+def post(url: str, **kwargs: Any):
+    return _requests.post(url, **kwargs)
+
+
+def put(url: str, **kwargs: Any):
+    return _requests.put(url, **kwargs)
+
+
+def delete(url: str, **kwargs: Any):
+    return _requests.delete(url, **kwargs)
