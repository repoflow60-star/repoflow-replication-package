+def get_settings():
+    """Build a Dynaconf settings object for the local repo root.
+
+    Dynaconf loads the `.env` file in the project root and exposes plain
+    environment variables when `ENVVAR_PREFIX_FOR_DYNACONF` is disabled.
+    """
+    return Dynaconf(
+        ENVVAR_PREFIX_FOR_DYNACONF=False,
+        DOTENV_PATH_FOR_DYNACONF=join(dirname(__file__), ".env"),
+    )
+
+
+def split_csv_setting(value):
+    """Normalize a comma-separated config value into a list."""
+    if not value:
+        return []
+    if isinstance(value, str):
+        return [item for item in value.replace(" ", "").split(",") if item]
+    if isinstance(value, (list, tuple, set)):
+        return [str(item).strip() for item in value if str(item).strip()]
+    text = str(value).strip()
+    return [text] if text else []
 
 
