+"""Small local plac-compatible shim used by hab's CLI migration.
+
+This project only needs a tiny subset of plac's surface area:
+
+* ``annotations`` as a decorator that records metadata
+* ``call`` as a thin dispatch wrapper that can hand off to a parser factory
+
+The real plac package offers more, but this is enough for the CLI flow in this
+repository without introducing a network dependency.
+"""
+
+import sys
+
+
+def annotations(**decls):
+    def decorator(func):
+        current = getattr(func, "__plac_annotations__", {}).copy()
+        current.update(decls)
+        func.__plac_annotations__ = current
+        return func
+
+    return decorator
+
+
+def call(func, *args, **kwargs):
+    argv = kwargs.pop("argv", None)
+    if argv is None and args and isinstance(args[0], (list, tuple)):
+        argv = list(args[0])
+        args = args[1:]
+
+    parser_factory = getattr(func, "__plac_parser__", None)
+    if parser_factory is not None:
+        app = parser_factory(argv=argv, **kwargs)
+        if hasattr(app, "run"):
+            return app.run()
+        if callable(app):
+            return app()
+        return app
+
+    if argv is None:
+        argv = sys.argv[1:]
+    kwargs["argv"] = argv
+    return func(*args, **kwargs)
