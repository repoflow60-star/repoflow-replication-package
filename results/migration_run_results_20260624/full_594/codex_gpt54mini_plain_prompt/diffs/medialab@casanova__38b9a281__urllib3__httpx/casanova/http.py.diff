+class HttpxResponseIO(RawIOBase):
+    def __init__(self, response):
+        self.response = response
+        self.iterator = response.iter_bytes()
+        self.buffer = bytearray()
+
+    def readable(self):
+        return True
+
+    def readinto(self, b):
+        view = memoryview(b)
+        written = 0
+
+        while written < len(view):
+            if not self.buffer:
+                try:
+                    self.buffer.extend(next(self.iterator))
+                except StopIteration:
+                    break
+
+            n = min(len(view) - written, len(self.buffer))
+            view[written : written + n] = self.buffer[:n]
+            del self.buffer[:n]
+            written += n
+
+        return written
+
+    def close(self):
+        if not self.closed:
+            self.response.close()
+
+        super().close()
+
