+"""
+Minimal local httpx compatibility layer.
+
+The codebase only relies on a small surface area of httpx:
+top-level verb helpers and a response object with status, text, json, and ok.
+This module keeps those contracts available in offline test environments.
+"""
+
+from __future__ import annotations
+
+import json as _json
+from dataclasses import dataclass
+from typing import Any, Mapping, MutableMapping, Optional
+from urllib import error as _urlerror
+from urllib import parse as _urlparse
+from urllib import request as _urlrequest
+
+
+@dataclass
+class Response:
+    status_code: int
+    content: bytes = b""
+    headers: MutableMapping[str, str] | None = None
+    url: str = ""
+    encoding: str = "utf-8"
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status_code < 400
+
+    @property
+    def text(self) -> str:
+        return self.content.decode(self.encoding or "utf-8", errors="replace")
+
+    def json(self) -> Any:
+        return _json.loads(self.text)
+
+    def raise_for_status(self) -> None:
+        if self.ok:
+            return
+        raise HTTPStatusError(f"HTTP {self.status_code}", response=self)
+
+
+class HTTPStatusError(Exception):
+    def __init__(self, message: str, response: Response) -> None:
+        super().__init__(message)
+        self.response = response
+
+
+def _prepare_body(
+    *,
+    json: Any = None,
+    data: Any = None,
+    headers: Optional[Mapping[str, str]] = None,
+) -> tuple[bytes | None, dict[str, str]]:
+    request_headers = dict(headers or {})
+
+    if json is not None:
+        body = _json.dumps(json).encode("utf-8")
+        request_headers.setdefault("Content-Type", "application/json")
+        return body, request_headers
+
+    if data is None:
+        return None, request_headers
+
+    if isinstance(data, bytes):
+        return data, request_headers
+
+    if isinstance(data, str):
+        return data.encode("utf-8"), request_headers
+
+    return _json.dumps(data).encode("utf-8"), request_headers
+
+
+def _request(
+    method: str,
+    url: str,
+    *,
+    params: Any = None,
+    headers: Optional[Mapping[str, str]] = None,
+    json: Any = None,
+    data: Any = None,
+    timeout: Optional[float] = None,
+) -> Response:
+    if params is not None:
+        if isinstance(params, Mapping):
+            query = _urlparse.urlencode(params, doseq=True)
+        else:
+            query = str(params)
+        parts = _urlparse.urlsplit(url)
+        query_string = parts.query
+        if query_string:
+            query = f"{query_string}&{query}"
+        url = _urlparse.urlunsplit(
+            (parts.scheme, parts.netloc, parts.path, query, parts.fragment)
+        )
+
+    body, request_headers = _prepare_body(json=json, data=data, headers=headers)
+    request = _urlrequest.Request(url, data=body, method=method, headers=request_headers)
+
+    try:
+        with _urlrequest.urlopen(request, timeout=timeout) as result:
+            content = result.read()
+            response_headers = dict(result.headers.items())
+            return Response(
+                status_code=result.getcode(),
+                content=content,
+                headers=response_headers,
+                url=result.geturl(),
+            )
+    except _urlerror.HTTPError as exc:
+        content = exc.read()
+        response_headers = dict(exc.headers.items()) if exc.headers is not None else {}
+        return Response(
+            status_code=exc.code,
+            content=content,
+            headers=response_headers,
+            url=exc.geturl() or url,
+        )
+
+
+def get(url: str, **kwargs: Any) -> Response:
+    return _request("GET", url, **kwargs)
+
+
+def post(url: str, **kwargs: Any) -> Response:
+    return _request("POST", url, **kwargs)
+
+
+def put(url: str, **kwargs: Any) -> Response:
+    return _request("PUT", url, **kwargs)
+
+
+def delete(url: str, **kwargs: Any) -> Response:
+    return _request("DELETE", url, **kwargs)
