+def load_pfx_x509_cert(pfx_value: bytes, password: Union[str, None]) -> X509Cert:
+    """
+    Load the certificate embedded in a PKCS#12/PFX container.
+
+    The certificate is extracted via the platform ``openssl`` command so the
+    runtime code does not depend on that library directly.
+    """
+    if not isinstance(pfx_value, bytes):
+        raise TypeError("Value must be bytes.")
+
+    with tempfile.NamedTemporaryFile(suffix='.pfx') as tmp_pfx_file:
+        tmp_pfx_file.write(pfx_value)
+        tmp_pfx_file.flush()
+
+        passin_arg = f'pass:{password or ""}'
+        try:
+            proc = subprocess.run(
+                [
+                    'openssl',
+                    'pkcs12',
+                    '-in',
+                    tmp_pfx_file.name,
+                    '-clcerts',
+                    '-nokeys',
+                    '-passin',
+                    passin_arg,
+                    '-out',
+                    '/dev/stdout',
+                ],
+                check=True,
+                capture_output=True,
+            )
+        except subprocess.CalledProcessError as exc:
+            stderr = exc.stderr.decode('utf-8', errors='replace').strip()
+            raise ValueError(stderr or 'Unable to load PKCS#12 certificate.') from exc
+
+    return load_pem_x509_cert(proc.stdout)
+
