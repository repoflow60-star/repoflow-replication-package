-        return self.response.close()
+def _request(method, url, input_options, params=None, data=None, allow_redirects=True):
+    return _run_async(_request_async(method, url, input_options, params=params, data=data, allow_redirects=allow_redirects))
+
+
+def fetch_json(url, verify_ssl=True, headers=None, timeout=None, params=None, data=None, method="GET", allow_redirects=True):
+    """Fetch JSON from a URL using aiohttp-compatible semantics."""
+
+    input_options = InputOptions(
+        verify_ssl=verify_ssl,
+        http_headers=headers,
+        timeout=timeout,
+    )
+    response = _request(method, url, input_options, params=params, data=data, allow_redirects=allow_redirects)
+    if response.status == 403:
+        raise HXLAuthorizationException("Access not authorized", url=url)
+    if response.status >= 400:
+        raise HXLIOException("Unable to fetch JSON: HTTP {}".format(response.status), url=url)
+
+    try:
+        return json.loads(response.body.decode(response.charset or "utf-8"))
+    except Exception as exc:
+        raise HXLIOException("Unable to parse JSON from {}".format(url), url=url) from exc
 
 
