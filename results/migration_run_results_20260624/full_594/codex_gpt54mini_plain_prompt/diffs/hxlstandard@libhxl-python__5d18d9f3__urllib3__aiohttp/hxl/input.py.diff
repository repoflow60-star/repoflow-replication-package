+async def _request_async(method, url, input_options, params=None, data=None, allow_redirects=True):
+    timeout = None
+    if input_options.timeout is not None:
+        timeout = aiohttp.ClientTimeout(total=input_options.timeout)
+
+    async with aiohttp.ClientSession(timeout=timeout) as session:
+        return await session.request(
+            method,
+            url,
+            headers=input_options.http_headers,
+            params=params,
+            data=data,
+            ssl=False if not input_options.verify_ssl else None,
+            allow_redirects=allow_redirects,
+        )
 
