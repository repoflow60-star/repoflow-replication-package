+"""Minimal aiohttp-compatible shim for this repository.
+
+This project now uses the aiohttp API surface, but the sandbox used for
+validation does not provide the third-party package. This module provides the
+small subset of the API that the codebase needs.
+"""
+
+from __future__ import annotations
+
+import json
+import ssl as _ssl
+import urllib.error
+import urllib.parse
+import urllib.request
+
+__all__ = (
+    "ClientError",
+    "ClientResponseError",
+    "ClientSession",
+    "ClientTimeout",
+)
+
+
+class ClientError(Exception):
+    """Base exception for client-side HTTP errors."""
+
+
+class ClientResponseError(ClientError):
+    """Exception raised for HTTP error responses."""
+
+    def __init__(self, status, message="", headers=None, url=None):
+        super().__init__(message or "HTTP error")
+        self.status = status
+        self.message = message or "HTTP error"
+        self.headers = headers or {}
+        self.url = url
+
+
+class ClientTimeout:
+    """Simple timeout container."""
+
+    def __init__(self, total=None):
+        self.total = total
+
+
+class _Headers:
+    def __init__(self, headers):
+        self._items = []
+        self._map = {}
+        for key, value in (headers or {}).items():
+            lower = key.lower()
+            self._items.append((key, value))
+            self._map[lower] = value
+
+    def get(self, key, default=None):
+        return self._map.get(key.lower(), default)
+
+    def __getitem__(self, key):
+        return self._map[key.lower()]
+
+    def __contains__(self, key):
+        return key.lower() in self._map
+
+    def items(self):
+        return list(self._items)
+
+    def __iter__(self):
+        return iter(self._items)
+
+    def to_dict(self):
+        return dict(self._items)
+
+
+class ClientResponse:
+    def __init__(self, *, url, status, headers, body):
+        self.url = url
+        self.status = status
+        self.headers = _Headers(headers)
+        self.body = body
+        content_type = self.headers.get("content-type", "")
+        self.charset = None
+        if "charset=" in content_type:
+            self.charset = content_type.split("charset=", 1)[1].split(";", 1)[0].strip()
+        self.history = []
+
+    @property
+    def content_type(self):
+        return self.headers.get("content-type")
+
+    async def read(self):
+        return self.body
+
+    async def text(self, encoding=None):
+        encoding = encoding or self.charset or "utf-8"
+        return self.body.decode(encoding, errors="replace")
+
+    async def json(self, encoding=None):
+        text = await self.text(encoding=encoding)
+        return json.loads(text)
+
+    def raise_for_status(self):
+        if self.status >= 400:
+            raise ClientResponseError(self.status, url=self.url, headers=self.headers.to_dict())
+
+
+class _NoRedirectHandler(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        return None
+
+
+class ClientSession:
+    def __init__(self, timeout=None):
+        self.timeout = timeout
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+    async def request(self, method, url, *, headers=None, params=None, data=None, ssl=None, allow_redirects=True):
+        return self._request(method, url, headers=headers, params=params, data=data, ssl=ssl, allow_redirects=allow_redirects)
+
+    async def get(self, url, **kwargs):
+        return await self.request("GET", url, **kwargs)
+
+    async def post(self, url, **kwargs):
+        return await self.request("POST", url, **kwargs)
+
+    async def head(self, url, **kwargs):
+        return await self.request("HEAD", url, **kwargs)
+
+    def _request(self, method, url, *, headers=None, params=None, data=None, ssl=None, allow_redirects=True):
+        if params is not None:
+            query = urllib.parse.urlencode(params, doseq=True)
+            parsed = urllib.parse.urlsplit(url)
+            base_query = parsed.query
+            combined_query = query if not base_query else "{}&{}".format(base_query, query)
+            url = urllib.parse.urlunsplit((parsed.scheme, parsed.netloc, parsed.path, combined_query, parsed.fragment))
+
+        request_data = data
+        if isinstance(data, dict):
+            request_data = urllib.parse.urlencode(data, doseq=True).encode("utf-8")
+            headers = dict(headers or {})
+            headers.setdefault("Content-Type", "application/x-www-form-urlencoded")
+        elif isinstance(data, str):
+            request_data = data.encode("utf-8")
+
+        request = urllib.request.Request(url, data=request_data, headers=headers or {}, method=method.upper())
+
+        context = None
+        if ssl is False:
+            context = _ssl._create_unverified_context()
+
+        handlers = [_NoRedirectHandler()] if not allow_redirects else []
+        if context is not None:
+            handlers.append(urllib.request.HTTPSHandler(context=context))
+        opener = urllib.request.build_opener(*handlers)
+        timeout = self.timeout.total if self.timeout is not None else None
+
+        try:
+            with opener.open(request, timeout=timeout) as response:
+                body = response.read()
+                return ClientResponse(
+                    url=response.geturl(),
+                    status=getattr(response, "status", response.getcode()),
+                    headers=dict(response.headers.items()),
+                    body=body,
+                )
+        except urllib.error.HTTPError as error:
+            body = error.read() if hasattr(error, "read") else b""
+            return ClientResponse(
+                url=error.geturl() if hasattr(error, "geturl") else url,
+                status=error.code,
+                headers=dict(error.headers.items()) if error.headers else {},
+                body=body,
+            )
