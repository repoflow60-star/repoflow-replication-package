+def _build_url(url: str, params: ty.Optional[Filters]) -> str:
+    if not params:
+        return url
+
+    query = urllib_parse.urlencode(params, doseq=True)
+    delimiter = '&' if '?' in url else '?'
+    return url + delimiter + query
+
+
+def _build_headers() -> ty.List[str]:
+    return [
+        'User-Agent: git-pw ({})'.format(git_pw.__version__),
+    ]
+
+
+def _auth_header(auth: ty.Optional[ty.Tuple[str, ...]]) -> ty.Optional[str]:
+    if not auth:
+        return None
+
+    if auth[0] == 'token':
+        return 'Authorization: Token {}'.format(auth[1])
+
+    user = auth[1]
+    password = auth[2]
+    token = base64.b64encode(
+        '{}:{}'.format(user, password).encode('utf-8')
+    ).decode('ascii')
+    return 'Authorization: Basic {}'.format(token)
+
+
+def _perform_request(
+    method: str,
+    url: str,
+    auth: ty.Optional[ty.Tuple[str, ...]] = None,
+    params: ty.Optional[Filters] = None,
+    data: ty.Optional[ty.List[ty.Tuple[str, ty.Any]]] = None,
+) -> _Response:
+    if pycurl is not None:
+        return _perform_request_pycurl(method, url, auth, params, data)
+
+    return _perform_request_urllib(method, url, auth, params, data)
+
+
+def _perform_request_pycurl(
+    method: str,
+    url: str,
+    auth: ty.Optional[ty.Tuple[str, ...]] = None,
+    params: ty.Optional[Filters] = None,
+    data: ty.Optional[ty.List[ty.Tuple[str, ty.Any]]] = None,
+) -> _Response:
+    curl = pycurl.Curl()
+    body = io.BytesIO()
+    header_lines: ty.List[bytes] = []
+    response_headers: ty.Dict[str, str] = {}
+
+    final_url = _build_url(url, params)
+    encoded_data = (
+        urllib_parse.urlencode(data, doseq=True).encode('utf-8')
+        if data is not None
+        else None
+    )
+
+    def collect_headers(chunk: bytes) -> int:
+        header_lines.append(chunk)
+        return len(chunk)
+
+    try:
+        curl.setopt(pycurl.URL, final_url)
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, collect_headers)
+        headers = _build_headers()
+        auth_header = _auth_header(auth)
+        if auth_header and auth and auth[0] == 'token':
+            headers.append(auth_header)
+        curl.setopt(pycurl.HTTPHEADER, headers)
+
+        if auth and auth[0] == 'basic':
+            curl.setopt(pycurl.USERPWD, '{}:{}'.format(auth[1], auth[2]))
+            curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+
+        if method == 'GET':
+            curl.setopt(pycurl.HTTPGET, 1)
+        elif method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, encoded_data or b'')
+        elif method == 'PATCH':
+            curl.setopt(pycurl.CUSTOMREQUEST, 'PATCH')
+            curl.setopt(pycurl.POSTFIELDS, encoded_data or b'')
+        elif method == 'DELETE':
+            curl.setopt(pycurl.CUSTOMREQUEST, 'DELETE')
+        else:
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            if encoded_data is not None:
+                curl.setopt(pycurl.POSTFIELDS, encoded_data)
+
+        curl.perform()
+        status_code = int(curl.getinfo(pycurl.RESPONSE_CODE))
+    except pycurl.error as exc:
+        raise _RequestException(str(exc)) from exc
+    finally:
+        curl.close()
+
+    for line in header_lines:
+        line = line.strip()
+        if not line or line.startswith(b'HTTP/'):
+            continue
+        if b':' not in line:
+            continue
+        key, value = line.split(b':', 1)
+        response_headers[key.decode('iso-8859-1').strip().lower()] = (
+            value.decode('iso-8859-1').strip()
+        )
+
+    response = _Response(status_code, response_headers, body.getvalue())
+    if status_code >= 400:
+        raise _RequestException('HTTP %s' % status_code, response=response)
+
+    return response
+
+
+def _perform_request_urllib(
+    method: str,
+    url: str,
+    auth: ty.Optional[ty.Tuple[str, ...]] = None,
+    params: ty.Optional[Filters] = None,
+    data: ty.Optional[ty.List[ty.Tuple[str, ty.Any]]] = None,
+) -> _Response:
+    final_url = _build_url(url, params)
+    headers = {'User-Agent': 'git-pw ({})'.format(git_pw.__version__)}
+    if auth:
+        header = _auth_header(auth)
+        if header:
+            key, value = header.split(': ', 1)
+            headers[key] = value
+
+    payload = (
+        urllib_parse.urlencode(data, doseq=True).encode('utf-8')
+        if data is not None
+        else None
+    )
+    request = urllib_request.Request(
+        final_url,
+        data=payload,
+        headers=headers,
+        method=method,
+    )
+
+    try:
+        with urllib_request.urlopen(request) as response:
+            content = response.read()
+            response_headers = {
+                key.lower(): value
+                for key, value in response.headers.items()
+            }
+            status_code = response.getcode()
+    except urllib_error.HTTPError as exc:
+        content = exc.read()
+        response_headers = {
+            key.lower(): value for key, value in exc.headers.items()
+        }
+        status_code = exc.code
+    except urllib_error.URLError as exc:
+        raise _RequestException(str(exc)) from exc
+
+    response = _Response(status_code, response_headers, content)
+    if status_code >= 400:
+        raise _RequestException('HTTP %s' % status_code, response=response)
+
+    return response
+
