+from __future__ import annotations
+
+import inspect
+from contextlib import contextmanager
+from typing import Any, Callable, Iterator
+
+from pydantic import ValidationError
+
+from src.sanic import json as sanic_json
+
+
+@contextmanager
+def dependency_context(app, dependency: Callable[[], Any]) -> Iterator[Any]:
+    factory = app.dependency_overrides.get(dependency, dependency)
+    value = factory()
+    if inspect.isgenerator(value):
+        yielded = next(value)
+        try:
+            yield yielded
+        finally:
+            try:
+                next(value)
+            except StopIteration:
+                pass
+            _close_resource(yielded)
+        return
+
+    try:
+        yield value
+    finally:
+        _close_resource(value)
+
+
+def _close_resource(value: Any) -> None:
+    for name in ("shutdown", "close"):
+        callback = getattr(value, name, None)
+        if callable(callback):
+            try:
+                callback()
+            except TypeError:
+                callback(wait=True)
+            except Exception:
+                pass
+            break
+
+
+def validation_error_response(exc: ValidationError):
+    detail = []
+    for error in exc.errors():
+        item = {key: value for key, value in error.items() if key in {"msg", "type"}}
+        item["loc"] = ["body", *error.get("loc", ())]
+        detail.append(item)
+    return sanic_json({"detail": detail}, status=422)
