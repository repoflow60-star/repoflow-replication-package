+from __future__ import annotations
+
+import asyncio
+import json
+from urllib.parse import urlsplit
+
+import httpx
+
+
+class TestClient:
+    def __init__(
+        self,
+        app,
+        base_url: str = "http://testserver",
+        raise_server_exceptions: bool = True,
+        root_path: str = "",
+        backend: str = "asyncio",
+        backend_options: dict | None = None,
+        cookies=None,
+        headers: dict[str, str] | None = None,
+        follow_redirects: bool = True,
+    ) -> None:
+        self.app = app
+        self.base_url = base_url.rstrip("/")
+        self.raise_server_exceptions = raise_server_exceptions
+        self.root_path = root_path
+        self.backend = backend
+        self.backend_options = backend_options or {}
+        self.cookies = cookies
+        self.headers = headers or {}
+        self.follow_redirects = follow_redirects
+        self.headers.setdefault("user-agent", "testclient")
+
+    def _request(self, method: str, url: str, **kwargs):
+        parsed = urlsplit(url)
+        path = parsed.path or "/"
+        query_string = parsed.query.encode()
+
+        body = b""
+        headers = dict(self.headers)
+        if "headers" in kwargs and kwargs["headers"]:
+            headers.update(kwargs["headers"])
+        if "json" in kwargs and kwargs["json"] is not None:
+            body = json.dumps(kwargs.pop("json")).encode("utf-8")
+            headers.setdefault("content-type", "application/json")
+        elif "content" in kwargs and kwargs["content"] is not None:
+            content = kwargs.pop("content")
+            body = content.encode("utf-8") if isinstance(content, str) else bytes(content)
+
+        scope = {
+            "type": "http",
+            "http_version": "1.1",
+            "method": method.upper(),
+            "path": path,
+            "raw_path": path.encode(),
+            "root_path": self.root_path,
+            "scheme": parsed.scheme or "http",
+            "query_string": query_string,
+            "headers": [(key.lower().encode(), value.encode()) for key, value in headers.items()],
+            "client": ["testclient", 50000],
+            "server": [parsed.hostname or "testserver", parsed.port or 80],
+            "extensions": {"http.response.debug": {}},
+            "state": {},
+        }
+
+        response_started = False
+        response_status = 500
+        response_headers = []
+        response_body = bytearray()
+        request_complete = False
+
+        async def receive():
+            nonlocal request_complete
+            if request_complete:
+                return {"type": "http.disconnect"}
+            request_complete = True
+            return {"type": "http.request", "body": body, "more_body": False}
+
+        async def send(message):
+            nonlocal response_started, response_status, response_headers
+            if message["type"] == "http.response.start":
+                response_started = True
+                response_status = message["status"]
+                response_headers = [(key.decode(), value.decode()) for key, value in message.get("headers", [])]
+            elif message["type"] == "http.response.body":
+                response_body.extend(message.get("body", b""))
+
+        async def call_app():
+            await self.app(scope, receive, send)
+
+        try:
+            asyncio.run(call_app())
+        except Exception:
+            if self.raise_server_exceptions:
+                raise
+            response_started = False
+            response_status = 500
+            response_headers = []
+            response_body = bytearray()
+
+        request = httpx.Request(method.upper(), f"{self.base_url}{path}")
+        response = httpx.Response(
+            status_code=response_status if response_started else 500,
+            headers=response_headers,
+            content=bytes(response_body),
+            request=request,
+        )
+        return response
+
+    def get(self, url: str, **kwargs):
+        return self._request("GET", url, **kwargs)
+
+    def post(self, url: str, **kwargs):
+        return self._request("POST", url, **kwargs)
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        return False
+
