+from __future__ import annotations
+
+import json
+import sys
+from dataclasses import dataclass
+from threading import Event, Lock, Thread
+from typing import Any
+
+import treq
+from twisted.internet import defer, reactor
+from twisted.internet.threads import blockingCallFromThread
+
+
+class HTTPError(Exception):
+    def __init__(self, message: str, response: Any = None):
+        super().__init__(message)
+        self.response = response
+
+
+@dataclass(slots=True)
+class _Response:
+    status_code: int
+    content: bytes
+
+    def json(self) -> Any:
+        return json.loads(self.content.decode("utf-8"))
+
+    def raise_for_status(self) -> None:
+        http_error_msg = ""
+        if 400 <= self.status_code < 500:
+            http_error_msg = f"{self.status_code} Client Error"
+        elif 500 <= self.status_code < 600:
+            http_error_msg = f"{self.status_code} Server Error"
+
+        if http_error_msg:
+            raise HTTPError(http_error_msg, response=self)
+
+
+_reactor_lock = Lock()
+_reactor_started = False
+
+
+def _ensure_reactor_running() -> None:
+    global _reactor_started
+
+    if reactor.running or _reactor_started:
+        return
+
+    with _reactor_lock:
+        if reactor.running or _reactor_started:
+            return
+
+        ready = Event()
+
+        def _run() -> None:
+            reactor.callWhenRunning(ready.set)
+            reactor.run(installSignalHandlers=False)
+
+        Thread(target=_run, daemon=True).start()
+        ready.wait()
+        _reactor_started = True
+
+
+def _fetch(url: str) -> _Response:
+    _ensure_reactor_running()
+
+    @defer.inlineCallbacks
+    def _request() -> _Response:
+        response = yield treq.get(url)
+        content = yield treq.content(response)
+        return _Response(status_code=response.code, content=content)
+
+    return blockingCallFromThread(reactor, _request)
+
+
+def get(url: str) -> Any:
+    return _fetch(url)
+
+
+def get_content(url: str) -> bytes:
+    return _fetch(url).content
+
+
+sys.modules["requests"] = sys.modules[__name__]
