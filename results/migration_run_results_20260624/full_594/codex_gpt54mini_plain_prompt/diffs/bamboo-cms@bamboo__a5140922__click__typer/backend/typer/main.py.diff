+from __future__ import annotations
+
+import inspect
+from dataclasses import dataclass
+from typing import Any, Callable
+
+import click
+
+
+@dataclass(frozen=True)
+class _OptionInfo:
+    default: Any
+    param_decls: tuple[str, ...]
+    kwargs: dict[str, Any]
+
+
+def Option(default: Any = ..., *param_decls: str, **kwargs: Any) -> _OptionInfo:
+    return _OptionInfo(default=default, param_decls=param_decls, kwargs=kwargs)
+
+
+def echo(message: Any = None, **kwargs: Any) -> None:
+    click.echo(message, **kwargs)
+
+
+class Typer:
+    def __init__(self, *args: Any, **kwargs: Any) -> None:
+        self.registered_commands: list[tuple[str, Callable[..., Any]]] = []
+
+    def command(self, name: str | None = None, **kwargs: Any) -> Callable[[Callable[..., Any]], Callable[..., Any]]:
+        def decorator(func: Callable[..., Any]) -> Callable[..., Any]:
+            command_name = name or func.__name__.replace("_", "-")
+            self.registered_commands.append((command_name, func))
+            return func
+
+        return decorator
+
+
+def _build_click_command(name: str, func: Callable[..., Any]) -> click.Command:
+    signature = inspect.signature(func)
+    decorated: Callable[..., Any] = func
+
+    for param in reversed(tuple(signature.parameters.values())):
+        default = param.default
+        if not isinstance(default, _OptionInfo):
+            raise TypeError(f"Unsupported parameter {param.name!r} on Typer command {name!r}")
+
+        option_names = default.param_decls or (f"--{param.name.replace('_', '-')}",)
+        kwargs = dict(default.kwargs)
+        if param.annotation is not inspect._empty and "type" not in kwargs:
+            kwargs["type"] = param.annotation
+        if default.default is ...:
+            kwargs.setdefault("required", True)
+            option_default = None
+        else:
+            option_default = default.default
+        decorated = click.option(*option_names, param.name, default=option_default, **kwargs)(decorated)
+
+    return click.command(name=name, help=inspect.getdoc(func))(decorated)
+
+
+def get_command(app: Typer) -> click.Command:
+    commands = [_build_click_command(name, func) for name, func in app.registered_commands]
+    if len(commands) == 1:
+        return commands[0]
+
+    group = click.Group()
+    for command in commands:
+        group.add_command(command)
+    return group
