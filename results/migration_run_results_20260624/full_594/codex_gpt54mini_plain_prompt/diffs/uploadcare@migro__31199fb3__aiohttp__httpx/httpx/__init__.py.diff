+"""Minimal httpx-compatible surface used by Migro.
+
+This module provides just enough of the ``httpx`` API for the application and
+tests in this repository. It intentionally keeps the surface area small:
+
+- ``AsyncClient.request()``
+- ``AsyncClient.aclose()``
+- response ``status_code``
+- response ``headers``
+- response ``json()``
+- response ``text``
+
+The implementation uses the Python standard library so the project remains
+runnable in environments where the real ``httpx`` package is unavailable.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from dataclasses import dataclass
+from typing import Any, Mapping, MutableMapping, Optional
+from urllib.error import HTTPError, URLError
+from urllib.parse import urlencode, urlsplit, urlunsplit, parse_qsl
+from urllib.request import Request, urlopen
+
+
+@dataclass
+class Response:
+    status_code: int
+    headers: MutableMapping[str, str]
+    _content: bytes
+
+    def json(self) -> Any:
+        return json.loads(self.text)
+
+    @property
+    def text(self) -> str:
+        return self._content.decode("utf-8", errors="replace")
+
+
+class AsyncClient:
+    def __init__(self, *, verify: bool = True, follow_redirects: bool = False):
+        self.verify = verify
+        self.follow_redirects = follow_redirects
+
+    async def request(
+        self,
+        method: str,
+        url: str,
+        *,
+        headers: Optional[Mapping[str, str]] = None,
+        params: Optional[Mapping[str, Any]] = None,
+        data: Optional[Mapping[str, Any]] = None,
+        json: Optional[Any] = None,
+        content: Optional[bytes] = None,
+        timeout: Optional[float] = None,
+        follow_redirects: Optional[bool] = None,
+        **kwargs: Any,
+    ) -> Response:
+        del kwargs
+
+        if params:
+            parts = urlsplit(url)
+            query = parse_qsl(parts.query, keep_blank_values=True)
+            query.extend((str(key), str(value)) for key, value in params.items())
+            url = urlunsplit(parts._replace(query=urlencode(query)))
+
+        body = content
+        req_headers = dict(headers or {})
+
+        if json is not None:
+            body = json_module.dumps(json).encode("utf-8")
+            req_headers.setdefault("Content-Type", "application/json")
+        elif data is not None:
+            body = urlencode(data).encode("utf-8")
+            req_headers.setdefault("Content-Type", "application/x-www-form-urlencoded")
+
+        request_obj = Request(url, data=body, headers=req_headers, method=method.upper())
+
+        def _perform_request():
+            try:
+                with urlopen(request_obj, timeout=timeout) as response:
+                    return Response(
+                        status_code=response.status,
+                        headers=dict(response.headers.items()),
+                        _content=response.read(),
+                    )
+            except HTTPError as error:
+                return Response(
+                    status_code=error.code,
+                    headers=dict(error.headers.items()) if error.headers else {},
+                    _content=error.read(),
+                )
+            except URLError as error:
+                raise error
+
+        del follow_redirects
+        return await asyncio.to_thread(_perform_request)
+
+    async def aclose(self) -> None:
+        return None
+
+
+# Avoid shadowing the imported ``json`` module inside ``request``.
+json_module = json
+
