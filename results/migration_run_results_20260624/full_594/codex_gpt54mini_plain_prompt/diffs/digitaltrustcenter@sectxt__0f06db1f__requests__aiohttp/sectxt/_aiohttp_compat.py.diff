+#
+# SPDX-License-Identifier: EUPL-1.2
+#
+"""Minimal aiohttp compatibility layer for environments without aiohttp.
+
+This is intentionally small and only implements the pieces used by sectxt.
+"""
+
+import asyncio
+import ssl
+import urllib.error
+import urllib.request
+from dataclasses import dataclass
+from typing import Optional
+
+
+class ClientError(Exception):
+    pass
+
+
+class ClientConnectorError(ClientError):
+    pass
+
+
+class ClientConnectorCertificateError(ClientConnectorError, ssl.SSLError):
+    pass
+
+
+class ClientConnectorSSLError(ClientConnectorError, ssl.SSLError):
+    pass
+
+
+@dataclass
+class ClientTimeout:
+    total: Optional[float] = None
+
+
+class _CompatResponse:
+    def __init__(self, status, headers, url, history, content):
+        self.status = status
+        self.headers = headers
+        self.url = url
+        self.history = history
+        self._content = content
+
+    async def read(self):
+        return self._content
+
+
+class _RequestContextManager:
+    def __init__(self, session, url, ssl_verify):
+        self._session = session
+        self._url = url
+        self._ssl_verify = ssl_verify
+        self._response = None
+
+    async def __aenter__(self):
+        self._response = await self._session._request(self._url, self._ssl_verify)
+        return self._response
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+
+class ClientSession:
+    def __init__(self, headers=None, timeout=None):
+        self._headers = headers or {}
+        self._timeout = timeout.total if timeout else None
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+    def get(self, url, ssl=True):
+        return _RequestContextManager(self, url, ssl)
+
+    async def _request(self, url, ssl_verify):
+        return await asyncio.to_thread(self._request_sync, url, ssl_verify)
+
+    def _request_sync(self, url, ssl_verify):
+        request = urllib.request.Request(url, headers=self._headers, method="GET")
+        context = ssl.create_default_context() if ssl_verify else ssl._create_unverified_context()
+        try:
+            with urllib.request.urlopen(request, timeout=self._timeout, context=context) as resp:
+                headers = {k.lower(): v for k, v in resp.headers.items()}
+                content = resp.read()
+                return _CompatResponse(
+                    getattr(resp, "status", resp.getcode()),
+                    headers,
+                    resp.geturl(),
+                    [],
+                    content,
+                )
+        except urllib.error.HTTPError as exc:
+            headers = {k.lower(): v for k, v in exc.headers.items()} if exc.headers else {}
+            content = exc.read()
+            return _CompatResponse(exc.code, headers, exc.geturl(), [], content)
+        except ssl.SSLCertVerificationError as exc:
+            raise ClientConnectorCertificateError(str(exc)) from exc
+        except ssl.SSLError as exc:
+            raise ClientConnectorSSLError(str(exc)) from exc
