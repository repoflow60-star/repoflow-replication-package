@@ -0,0 +1,98 @@
+from __future__ import annotations
+
+import base64
+import json as json_module
+import sys
+import types
+from dataclasses import dataclass, field
+from typing import Any
+from urllib import error as urllib_error
+from urllib import parse as urllib_parse
+from urllib import request as urllib_request
+
+
+class RequestError(Exception):
+    pass
+
+
+@dataclass
+class Response:
+    status_code: int
+    content: bytes
+    url: str
+    headers: dict[str, str] = field(default_factory=dict)
+
+    def json(self) -> Any:
+        return json_module.loads(self.content.decode('utf-8'))
+
+    @property
+    def text(self) -> str:
+        return self.content.decode('utf-8')
+
+
+def _build_headers(headers: dict[str, str] | None, auth: tuple[str, str] | None) -> dict[str, str]:
+    prepared = dict(headers or {})
+    if auth is not None:
+        username, password = auth
+        token = base64.b64encode(f'{username}:{password}'.encode('utf-8')).decode('ascii')
+        prepared['Authorization'] = f'Basic {token}'
+    return prepared
+
+
+def _encode_body(data: Any = None, json: Any = None) -> tuple[bytes | None, dict[str, str]]:
+    headers: dict[str, str] = {}
+    if json is not None:
+        headers['Content-Type'] = 'application/json'
+        return json_module.dumps(json).encode('utf-8'), headers
+    if data is None:
+        return None, headers
+    if isinstance(data, bytes):
+        return data, headers
+    if isinstance(data, str):
+        return data.encode('utf-8'), headers
+    headers['Content-Type'] = 'application/x-www-form-urlencoded'
+    return urllib_parse.urlencode(data).encode('utf-8'), headers
+
+
+def _request(method: str, url: str, **kwargs) -> Response:
+    headers = _build_headers(kwargs.pop('headers', None), kwargs.pop('auth', None))
+    timeout = kwargs.pop('timeout', None)
+    data, content_headers = _encode_body(kwargs.pop('data', None), kwargs.pop('json', None))
+    headers.update(content_headers)
+
+    request = urllib_request.Request(url, data=data, headers=headers, method=method.upper())
+    try:
+        with urllib_request.urlopen(request, timeout=timeout) as response:
+            body = response.read()
+            return Response(
+                status_code=response.getcode(),
+                content=body,
+                url=response.geturl(),
+                headers=dict(response.headers.items()),
+            )
+    except urllib_error.HTTPError as exc:
+        body = exc.read()
+        return Response(
+            status_code=exc.code,
+            content=body,
+            url=exc.geturl() or url,
+            headers=dict(exc.headers.items()) if exc.headers else {},
+        )
+    except urllib_error.URLError as exc:
+        raise RequestError(str(exc)) from exc
+
+
+def get(url: str, **kwargs) -> Response:
+    return _request('GET', url, **kwargs)
+
+
+def post(url: str, **kwargs) -> Response:
+    return _request('POST', url, **kwargs)
+
+
+_requests_exceptions = types.ModuleType('requests.exceptions')
+_requests_exceptions.RequestException = RequestError
+exceptions = _requests_exceptions
+
+sys.modules['requests'] = sys.modules[__name__]
+sys.modules['requests.exceptions'] = _requests_exceptions
