+class _ResponseLike(Protocol):
+    text: str
+    content: bytes
+    url: str
+    history: List["_ResponseLike"]
+    status_code: int
+
+    def raise_for_status(self) -> None:
+        """Raise an exception for 4xx/5xx responses."""
+
