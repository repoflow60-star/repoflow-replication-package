+@dataclass
+class _HttpResponse:
+    """Minimal response object compatible with the old requests-based call sites."""
+
+    status_code: int
+    url: str
+    content: bytes
+    headers: Dict[str, str] = field(default_factory=dict)
+    history: List["_HttpResponse"] = field(default_factory=list)
+
+    @property
+    def text(self) -> str:
+        encoding = "utf-8"
+        content_type = self.headers.get("content-type", "")
+        match = re.search(r"charset=([A-Za-z0-9._-]+)", content_type, re.IGNORECASE)
+        if match:
+            encoding = match.group(1)
+        return self.content.decode(encoding, errors="replace")
+
+    def raise_for_status(self) -> None:
+        if 400 <= self.status_code:
+            raise RuntimeError(f"HTTP {self.status_code} for {self.url}")
+
+
+def _extract_headers(raw_headers: bytes) -> Dict[str, str]:
+    headers: Dict[str, str] = {}
+    for line in raw_headers.decode("iso-8859-1", errors="replace").splitlines():
+        if ":" not in line:
+            continue
+        name, value = line.split(":", 1)
+        headers[name.strip().lower()] = value.strip()
+    return headers
+
+
+class _PycurlSession:
+    """Persistent HTTP session backed by pycurl."""
+
+    def __init__(self):
+        if pycurl is None:
+            raise RuntimeError("pycurl is not available")
+        self._curl = pycurl.Curl()
+        self._curl.setopt(pycurl.FOLLOWLOCATION, True)
+        self._curl.setopt(pycurl.MAXREDIRS, 10)
+        self._curl.setopt(pycurl.COOKIEFILE, "")
+        self._curl.setopt(pycurl.COOKIEJAR, "")
+        self._curl.setopt(pycurl.NOSIGNAL, 1)
+
+    def clear_cookies(self) -> None:
+        self._curl.setopt(pycurl.COOKIELIST, "ALL")
+
+    def _request(self, url: str, method: str, data: Optional[Mapping[str, Any]] = None):
+        body = io.BytesIO()
+        header_bytes = io.BytesIO()
+
+        self._curl.setopt(pycurl.URL, url)
+        self._curl.setopt(pycurl.WRITEDATA, body)
+        self._curl.setopt(pycurl.HEADERFUNCTION, header_bytes.write)
+
+        if method == "GET":
+            self._curl.setopt(pycurl.HTTPGET, 1)
+            self._curl.setopt(pycurl.POST, 0)
+            self._curl.setopt(pycurl.POSTFIELDS, "")
+            self._curl.setopt(pycurl.HTTPHEADER, [])
+        else:
+            encoded = urlencode(dict(data or {}))
+            self._curl.setopt(pycurl.HTTPGET, 0)
+            self._curl.setopt(pycurl.POST, 1)
+            self._curl.setopt(pycurl.POSTFIELDS, encoded)
+            self._curl.setopt(
+                pycurl.HTTPHEADER, ["Content-Type: application/x-www-form-urlencoded"]
+            )
+
+        self._curl.perform()
+        status_code = int(self._curl.getinfo(pycurl.RESPONSE_CODE))
+        effective_url = self._curl.getinfo(pycurl.EFFECTIVE_URL)
+        headers = _extract_headers(header_bytes.getvalue())
+        return _HttpResponse(
+            status_code=status_code,
+            url=effective_url,
+            content=body.getvalue(),
+            headers=headers,
+        )
+
+    def get(self, url: str) -> _ResponseLike:
+        return self._request(url=url, method="GET")
+
+    def post(self, url: str, data: Optional[Mapping[str, Any]] = None) -> _ResponseLike:
+        return self._request(url=url, method="POST", data=data)
+
+
+class _UrllibSession:
+    """Compatibility fallback for environments without pycurl."""
+
+    def __init__(self):
+        self._cookie_jar = CookieJar()
+        self._opener = build_opener(HTTPCookieProcessor(self._cookie_jar))
+
+    def clear_cookies(self) -> None:
+        self._cookie_jar.clear()
+
+    def _request(self, url: str, method: str, data: Optional[Mapping[str, Any]] = None):
+        if method == "POST":
+            encoded = urlencode(dict(data or {})).encode("utf-8")
+            request = Request(
+                url,
+                data=encoded,
+                headers={"Content-Type": "application/x-www-form-urlencoded"},
+            )
+        else:
+            request = Request(url)
+
+        try:
+            response = self._opener.open(request)
+        except UrllibHTTPError as exc:
+            content = exc.read()
+            headers = {}
+            if exc.headers is not None:
+                headers = {k.lower(): v for k, v in exc.headers.items()}
+            return _HttpResponse(
+                status_code=exc.code,
+                url=exc.geturl(),
+                content=content,
+                headers=headers,
+            )
+
+        with response:
+            content = response.read()
+            headers = {k.lower(): v for k, v in dict(response.headers.items()).items()}
+            return _HttpResponse(
+                status_code=response.getcode(),
+                url=response.geturl(),
+                content=content,
+                headers=headers,
+            )
+
+    def get(self, url: str) -> _ResponseLike:
+        return self._request(url=url, method="GET")
+
+    def post(self, url: str, data: Optional[Mapping[str, Any]] = None) -> _ResponseLike:
+        return self._request(url=url, method="POST", data=data)
+
+
+def _create_default_session():
+    if pycurl is not None:
+        return _PycurlSession()
+    return _UrllibSession()
+
