+class _SessionLike(Protocol):
+    def get(self, url: str) -> _ResponseLike:
+        """Fetch a URL."""
+
+    def post(self, url: str, data: Optional[Mapping[str, Any]] = None) -> _ResponseLike:
+        """Submit a form."""
