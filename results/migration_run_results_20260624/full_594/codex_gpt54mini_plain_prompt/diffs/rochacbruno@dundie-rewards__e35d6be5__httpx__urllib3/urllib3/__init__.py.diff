+"""Minimal urllib3-compatible shim for this repository.
+
+The execution environment used for the tests does not provide the external
+urllib3 package, so this module implements the tiny subset of the API the
+codebase needs while preserving the urllib3 import path.
+"""
+
+from dataclasses import dataclass
+from typing import Any, Dict, Optional
+from urllib.error import HTTPError, URLError
+from urllib.request import Request, urlopen
+
+
+@dataclass
+class HTTPResponse:
+    status: int
+    data: bytes
+    headers: Dict[str, Any]
+
+
+class PoolManager:
+    def request(
+        self,
+        method: str,
+        url: str,
+        body: Optional[bytes] = None,
+        headers: Optional[Dict[str, str]] = None,
+        timeout: Optional[float] = None,
+        **kwargs: Any,
+    ) -> HTTPResponse:
+        request = Request(url, data=body, headers=headers or {}, method=method)
+        try:
+            with urlopen(request, timeout=timeout) as response:
+                return HTTPResponse(
+                    status=response.status,
+                    data=response.read(),
+                    headers=dict(response.headers.items()),
+                )
+        except HTTPError as error:
+            return HTTPResponse(
+                status=error.code,
+                data=error.read(),
+                headers=dict(error.headers.items()) if error.headers else {},
+            )
+        except URLError:
+            raise
+
+
+__version__ = "shim"
