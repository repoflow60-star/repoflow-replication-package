+class ProgressBarAdapter:
+    def __init__(self, total: int, desc: str = ""):
+        self.n = 0
+        self._bar = None
+        if progressbar is not None:
+            widgets = []
+            if desc:
+                widgets.append(desc)
+            widgets.extend(
+                [
+                    progressbar.Percentage(),
+                    " ",
+                    progressbar.Bar(),
+                    " ",
+                    progressbar.ETA(),
+                ]
+            )
+            self._bar = progressbar.ProgressBar(max_value=total, widgets=widgets)
+            self._bar.start()
+
+    def update(self, value: int):
+        self.n = value
+        if self._bar is not None:
+            self._bar.update(value)
+
+    def close(self):
+        if self._bar is not None:
+            self._bar.finish()
+
