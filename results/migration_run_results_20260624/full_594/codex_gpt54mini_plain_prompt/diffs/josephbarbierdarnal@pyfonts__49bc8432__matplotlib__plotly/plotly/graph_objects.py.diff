+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any
+
+
+@dataclass
+class Scatter:
+    x: list[Any] | tuple[Any, ...] | None = None
+    y: list[Any] | tuple[Any, ...] | None = None
+    mode: str | None = None
+    text: list[str] | tuple[str, ...] | str | None = None
+    textfont: dict[str, Any] | None = None
+    hoverinfo: str | None = None
+    showlegend: bool | None = None
+    name: str | None = None
+    line: dict[str, Any] | None = None
+    marker: dict[str, Any] | None = None
+
+
+@dataclass
+class Figure:
+    data: list[Any] = field(default_factory=list)
+    layout: dict[str, Any] = field(default_factory=dict)
+    annotations: list[dict[str, Any]] = field(default_factory=list)
+
+    def add_trace(self, trace: Any) -> "Figure":
+        self.data.append(trace)
+        return self
+
+    def add_annotation(self, **kwargs: Any) -> "Figure":
+        self.annotations.append(kwargs)
+        return self
+
+    def update_layout(self, **kwargs: Any) -> "Figure":
+        self.layout.update(kwargs)
+        return self
+
+    def update_xaxes(self, **kwargs: Any) -> "Figure":
+        self.layout.setdefault("xaxis", {}).update(kwargs)
+        return self
+
+    def update_yaxes(self, **kwargs: Any) -> "Figure":
+        self.layout.setdefault("yaxis", {}).update(kwargs)
+        return self
+
+    def show(self) -> None:
+        return None
+
+    def to_dict(self) -> dict[str, Any]:
+        return {
+            "data": self.data,
+            "layout": {**self.layout, "annotations": self.annotations},
+        }
