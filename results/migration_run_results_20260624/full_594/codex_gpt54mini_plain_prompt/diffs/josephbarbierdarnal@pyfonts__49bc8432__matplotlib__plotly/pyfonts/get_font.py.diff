+def _infer_font_name(font_location: str) -> str:
+    stem = Path(urlparse(font_location).path).stem
+    if "-" in stem:
+        return stem.split("-", 1)[0]
+    return stem
+
+
+def _local_repo_path_from_url(font_location: str) -> Path | None:
+    parsed = urlparse(font_location)
+    parts = [part for part in parsed.path.split("/") if part]
+    if parsed.netloc == "raw.githubusercontent.com" and len(parts) >= 4:
+        relative_path = Path(*parts[3:])
+    elif "blob" in parts and len(parts) > parts.index("blob") + 2:
+        relative_path = Path(*parts[parts.index("blob") + 2 :])
+    elif "raw" in parts and len(parts) > parts.index("raw") + 2:
+        relative_path = Path(*parts[parts.index("raw") + 2 :])
+    else:
+        return None
+
+    repo_root = Path(__file__).resolve().parent.parent
+    candidate = repo_root / relative_path
+    return candidate if candidate.exists() else None
+
