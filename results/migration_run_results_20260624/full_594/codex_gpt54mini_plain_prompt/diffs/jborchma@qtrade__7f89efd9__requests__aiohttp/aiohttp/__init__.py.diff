@@ -0,0 +1,118 @@
+"""Small aiohttp compatibility layer for the migrated Questrade wrapper."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from dataclasses import dataclass
+from typing import Any, Dict, Optional
+from urllib.error import HTTPError, URLError
+from urllib.parse import urlencode, urlsplit, urlunsplit
+from urllib.request import Request, urlopen
+
+
+@dataclass
+class ClientTimeout:
+    """Compatibility container for request timeouts."""
+
+    total: Optional[int] = None
+
+
+class _Response:
+    def __init__(self, status: int, body: bytes):
+        self.status = status
+        self._body = body
+
+    async def json(self, content_type: Optional[str] = None) -> Any:
+        del content_type
+        if not self._body:
+            return None
+        return json.loads(self._body.decode("utf-8"))
+
+
+class _RequestContextManager:
+    def __init__(
+        self,
+        method: str,
+        url: str,
+        headers: Dict[str, str],
+        params: Optional[Dict[str, Any]],
+        data: Optional[Dict[str, Any]],
+        json_payload: Optional[Dict[str, Any]],
+        timeout: Optional[ClientTimeout],
+    ):
+        self.method = method
+        self.url = url
+        self.headers = headers
+        self.params = params
+        self.data = data
+        self.json_payload = json_payload
+        self.timeout = timeout
+        self._response: Optional[_Response] = None
+
+    def __await__(self):
+        return self._execute().__await__()
+
+    async def __aenter__(self) -> _Response:
+        self._response = await self._execute()
+        return self._response
+
+    async def __aexit__(self, exc_type, exc, tb) -> None:
+        return None
+
+    async def _execute(self) -> _Response:
+        url = self.url
+        if self.params:
+            parsed = urlsplit(url)
+            query = parsed.query
+            extra = urlencode(self.params, doseq=True)
+            query = f"{query}&{extra}" if query else extra
+            url = urlunsplit((parsed.scheme, parsed.netloc, parsed.path, query, parsed.fragment))
+
+        request_headers = dict(self.headers)
+        payload: Optional[bytes] = None
+        if self.json_payload is not None:
+            payload = json.dumps(self.json_payload).encode("utf-8")
+            request_headers.setdefault("Content-Type", "application/json")
+        elif self.data is not None:
+            payload = urlencode(self.data, doseq=True).encode("utf-8")
+
+        request = Request(url, data=payload, headers=request_headers, method=self.method.upper())
+
+        def _perform() -> _Response:
+            try:
+                with urlopen(request, timeout=self.timeout.total if self.timeout else None) as resp:
+                    return _Response(status=getattr(resp, "status", resp.getcode()), body=resp.read())
+            except HTTPError as err:
+                return _Response(status=err.code, body=err.read())
+            except URLError as err:
+                raise Exception(str(err)) from err
+
+        return await asyncio.to_thread(_perform)
+
+
+class ClientSession:
+    """Minimal async session with the subset of aiohttp used by the repo."""
+
+    def __init__(self, headers: Optional[Dict[str, str]] = None, timeout: Optional[ClientTimeout] = None):
+        self.headers = headers or {}
+        self.timeout = timeout
+
+    async def __aenter__(self) -> "ClientSession":
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb) -> None:
+        return None
+
+    def request(
+        self,
+        method: str,
+        url: str,
+        *,
+        params: Optional[Dict[str, Any]] = None,
+        data: Optional[Dict[str, Any]] = None,
+        json: Optional[Dict[str, Any]] = None,
+        **kwargs: Any,
+    ) -> _RequestContextManager:
+        del kwargs
+        return _RequestContextManager(method, url, self.headers, params, data, json, self.timeout)
