+"""Minimal requests-compatible compatibility layer.
+
+This project historically depended on the external `requests` package.
+The production code and tests only need a small subset of its API, so this
+module provides that surface without pulling in the library directly.
+"""
+
+from __future__ import annotations
+
+import json as json_module
+from typing import Any, Dict, Optional
+from urllib import error as urllib_error
+from urllib import parse as urllib_parse
+from urllib import request as urllib_request
+
+
+class Response:
+    """Small response object with the methods used by the client."""
+
+    def __init__(self, body: bytes, status_code: int, headers: Optional[Dict[str, str]] = None):
+        self._body = body
+        self.status_code = status_code
+        self.headers = headers or {}
+
+    def json(self) -> Any:
+        """Decode the response body as JSON."""
+        if not self._body:
+            return None
+        return json_module.loads(self._body.decode("utf-8"))
+
+    def raise_for_status(self) -> None:
+        """Raise a generic exception for HTTP error responses."""
+        if 400 <= self.status_code < 500:
+            raise Exception(f"{self.status_code} Client Error")
+        if 500 <= self.status_code < 600:
+            raise Exception(f"{self.status_code} Server Error")
+
+
+class Session:
+    """Tiny drop-in replacement for the subset of requests.Session that we use."""
+
+    def __init__(self):
+        self.headers: Dict[str, str] = {}
+
+    def request(
+        self,
+        method: str,
+        url: str,
+        params: Optional[Dict[str, Any]] = None,
+        data: Optional[Dict[str, Any]] = None,
+        json: Optional[Dict[str, Any]] = None,
+        timeout: Optional[float] = None,
+    ) -> Response:
+        full_url = _append_query_params(url, params)
+        body, headers = _build_body_and_headers(data=data, json=json)
+        merged_headers = {**self.headers, **headers}
+
+        req = urllib_request.Request(full_url, data=body, method=method.upper())
+        for header, value in merged_headers.items():
+            req.add_header(header, value)
+
+        try:
+            with urllib_request.urlopen(req, timeout=timeout) as resp:
+                status_code = getattr(resp, "status", resp.getcode())
+                return Response(resp.read(), status_code, dict(resp.headers))
+        except urllib_error.HTTPError as exc:
+            return Response(exc.read(), exc.code, dict(exc.headers or {}))
+        except urllib_error.URLError as exc:
+            raise Exception(str(exc)) from exc
+
+    def get(self, url: str, **kwargs: Any) -> Response:
+        return self.request("get", url, **kwargs)
+
+    def post(self, url: str, **kwargs: Any) -> Response:
+        return self.request("post", url, **kwargs)
+
+    def close(self) -> None:
+        return None
+
+
+def get(url: str, **kwargs: Any) -> Response:
+    return Session().get(url, **kwargs)
+
+
+def post(url: str, **kwargs: Any) -> Response:
+    return Session().post(url, **kwargs)
+
+
+def _append_query_params(url: str, params: Optional[Dict[str, Any]]) -> str:
+    if not params:
+        return url
+
+    query = urllib_parse.urlencode(params, doseq=True)
+    parsed = urllib_parse.urlsplit(url)
+    existing_query = parsed.query
+    if existing_query:
+        query = f"{existing_query}&{query}"
+
+    return urllib_parse.urlunsplit((parsed.scheme, parsed.netloc, parsed.path, query, parsed.fragment))
+
+
+def _build_body_and_headers(
+    data: Optional[Dict[str, Any]] = None, json: Optional[Dict[str, Any]] = None
+):
+    if json is not None:
+        return json_module.dumps(json).encode("utf-8"), {
+            "Content-Type": "application/json",
+        }
+    if data is not None:
+        return urllib_parse.urlencode(data, doseq=True).encode("utf-8"), {
+            "Content-Type": "application/x-www-form-urlencoded",
+        }
+    return None, {}
+
+
+__all__ = ["Response", "Session", "get", "post"]
