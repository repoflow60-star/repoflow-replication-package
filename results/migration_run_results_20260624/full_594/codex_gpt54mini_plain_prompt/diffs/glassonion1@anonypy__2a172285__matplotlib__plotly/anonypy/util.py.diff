 def build_indexes(df):
@@ -44,3 +46,47 @@ def get_bounds(df, column, indexes, offset=1.0):
     if df[column].dtype.name == "category":
         return 0 - offset, len(indexes[column]) + offset
     return df[column].min() - offset, df[column].max() + offset
+
+
+def get_partition_shapes(
+    df, partitions, column_x, column_y, indexes, offsets=[0.1, 0.1]
+):
+    rects = get_partition_rects(
+        df, partitions, column_x, column_y, indexes, offsets=offsets
+    )
+    return [
+        {
+            "type": "rect",
+            "x0": xl,
+            "y0": yl,
+            "x1": xr,
+            "y1": yr,
+            "line": {"width": 2},
+            "fillcolor": "rgba(31, 119, 180, 0.15)",
+        }
+        for (xl, yl), (xr, yr) in rects
+    ]
+
+
+def build_partition_figure(
+    df, partitions, column_x, column_y, indexes, offsets=[0.1, 0.1]
+):
+    if go is None:
+        raise ImportError(
+            "plotly is required to build partition figures; install the package "
+            "dependency and try again"
+        )
+
+    shapes = get_partition_shapes(
+        df, partitions, column_x, column_y, indexes, offsets=offsets
+    )
+    x_min, x_max = get_bounds(df, column_x, indexes, offset=1.0)
+    y_min, y_max = get_bounds(df, column_y, indexes, offset=1.0)
+    figure = go.Figure()
+    figure.update_layout(
+        shapes=shapes,
+        xaxis={"range": [x_min, x_max], "title": column_x},
+        yaxis={"range": [y_min, y_max], "title": column_y},
+        template="plotly_white",
+    )
+    return figure
