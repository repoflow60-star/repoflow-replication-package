+
+def get_partition_chart(
+    df, partitions, column_x, column_y, indexes, offsets=(0.1, 0.1), title=None
+):
+    try:
+        import altair as alt
+    except ImportError as exc:
+        raise ImportError(
+            "Altair is required to build partition charts. Install the `altair` package."
+        ) from exc
+
+    import pandas as pd
+
+    rects = get_partition_rects(
+        df, partitions, column_x, column_y, indexes, offsets=offsets
+    )
+    chart_data = pd.DataFrame(
+        [
+            {
+                "partition": idx,
+                "x": left[0],
+                "y": left[1],
+                "x2": right[0],
+                "y2": right[1],
+            }
+            for idx, (left, right) in enumerate(rects)
+        ]
+    )
+
+    x_bounds = get_bounds(df, column_x, indexes, offset=offsets[0])
+    y_bounds = get_bounds(df, column_y, indexes, offset=offsets[1])
+
+    chart = (
+        alt.Chart(chart_data)
+        .mark_rect(opacity=0.25, stroke="black")
+        .encode(
+            x=alt.X(f"x:Q", scale=alt.Scale(domain=list(x_bounds)), title=column_x),
+            x2="x2:Q",
+            y=alt.Y(f"y:Q", scale=alt.Scale(domain=list(y_bounds)), title=column_y),
+            y2="y2:Q",
+            color=alt.Color("partition:N", legend=None),
+            tooltip=[
+                alt.Tooltip("partition:N", title="Partition"),
+                alt.Tooltip("x:Q", title="x left"),
+                alt.Tooltip("x2:Q", title="x right"),
+                alt.Tooltip("y:Q", title="y bottom"),
+                alt.Tooltip("y2:Q", title="y top"),
+            ],
+        )
+    )
+    if title is not None:
+        chart = chart.properties(title=title)
+    return chart
