+"""Small template renderer that supports the subset of Mako syntax used here.
+
+This intentionally implements only the features needed by the bundled report
+template:
+- `${expr}` substitutions
+- `% for ...:` / `% endfor` blocks
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import builtins
+import re
+from typing import Any, Dict, Iterable, List, Tuple
+
+
+_SUB_PATTERN = re.compile(r"\$\{([^}]+)\}")
+
+
+@dataclass
+class _TextNode:
+    text: str
+
+
+@dataclass
+class _ForNode:
+    targets: str
+    iterable_expr: str
+    body: List[object]
+
+
+class Template:
+    def __init__(self, text: str):
+        self.text = text
+        self._nodes, consumed = self._parse(self.text.splitlines(keepends=True), 0)
+        if consumed != len(self.text.splitlines(keepends=True)):
+            raise ValueError("unexpected trailing template content")
+
+    def render(self, **kwargs: Any) -> str:
+        return self._render_nodes(self._nodes, kwargs)
+
+    def _parse(self, lines: List[str], start: int) -> Tuple[List[object], int]:
+        nodes: List[object] = []
+        i = start
+        while i < len(lines):
+            line = lines[i]
+            stripped = line.lstrip()
+            if stripped.startswith("%"):
+                directive = stripped[1:].strip()
+                if directive == "endfor":
+                    return nodes, i + 1
+                if directive.startswith("for ") and directive.endswith(":"):
+                    clause = directive[4:-1].strip()
+                    if " in " not in clause:
+                        raise ValueError(f"invalid for directive: {directive}")
+                    targets, iterable_expr = clause.split(" in ", 1)
+                    body, i = self._parse(lines, i + 1)
+                    nodes.append(_ForNode(targets.strip(), iterable_expr.strip(), body))
+                    continue
+                raise ValueError(f"unsupported template directive: {directive}")
+
+            nodes.append(_TextNode(line))
+            i += 1
+        return nodes, i
+
+    def _render_nodes(self, nodes: Iterable[object], ctx: Dict[str, Any]) -> str:
+        out: List[str] = []
+        for node in nodes:
+            if isinstance(node, _TextNode):
+                out.append(self._substitute(node.text, ctx))
+                continue
+            if isinstance(node, _ForNode):
+                iterable = eval(node.iterable_expr, {"__builtins__": builtins.__dict__}, ctx)
+                for item in iterable:
+                    loop_ctx = dict(ctx)
+                    loop_ctx["_loop_value"] = item
+                    exec(
+                        f"{node.targets} = _loop_value",
+                        {"__builtins__": builtins.__dict__},
+                        loop_ctx,
+                    )
+                    loop_ctx.pop("_loop_value", None)
+                    out.append(self._render_nodes(node.body, loop_ctx))
+                continue
+            raise TypeError(f"unknown template node: {type(node)!r}")
+        return "".join(out)
+
+    def _substitute(self, text: str, ctx: Dict[str, Any]) -> str:
+        def repl(match: re.Match[str]) -> str:
+            expr = match.group(1).strip()
+            value = eval(expr, {"__builtins__": builtins.__dict__}, ctx)
+            return str(value)
+
+        return _SUB_PATTERN.sub(repl, text)
