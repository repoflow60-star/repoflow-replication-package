+@dataclass
+class _FallbackChart:
+    """Small stand-in used when Altair is not installed.
+
+    The public path still prefers Altair, but this keeps the package importable in
+    environments where the dependency is missing.
+    """
+
+    spec: dict[str, Any]
+
+    def to_dict(self) -> dict[str, Any]:
+        return self.spec
+
+    def show(self) -> "_FallbackChart":
+        return self
+
+
+def _build_chart(font_family: str):
+    """Build the preview visualization with Altair when available."""
+
+    text_specs = [
+        ("Hello, World From PyFonts!", 70, 30),
+        ("This is a test.", 130, 25),
+        ("How about this?", 190, 20),
+    ]
+
+    if alt is None:
+        return _FallbackChart(
+            {
+                "data": {
+                    "values": [
+                        {"text": text, "y": y, "fontSize": size}
+                        for text, y, size in text_specs
+                    ]
+                },
+                "mark": {"type": "text"},
+                "encoding": {
+                    "x": {"value": 300},
+                    "y": {"field": "y", "type": "quantitative"},
+                    "text": {"field": "text", "type": "nominal"},
+                },
+                "config": {
+                    "view": {"strokeWidth": 0},
+                    "text": {"font": font_family},
+                },
+            }
+        )
+
+    layers = []
+    for text, y, font_size in text_specs:
+        layer = (
+            alt.Chart(alt.Data(values=[{"text": text}]))
+            .mark_text(
+                align="center",
+                baseline="middle",
+                font=font_family,
+                fontSize=font_size,
+            )
+            .encode(
+                x=alt.value(300),
+                y=alt.value(y),
+                text="text:N",
+            )
+        )
+        layers.append(layer)
+
+    return alt.layer(*layers).properties(width=600, height=240, title="Font preview").configure_view(
+        strokeWidth=0
+    )
 
 
