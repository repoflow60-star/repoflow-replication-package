+from pathlib import Path
+from typing import Optional
+from urllib.parse import unquote, urlparse
+from urllib.request import urlopen
 from matplotlib.font_manager import FontProperties
 
 from .is_valid import _is_url, _is_valid_raw_url
 
+def _find_local_font_candidate(font_location: str) -> Optional[Path]:
+    """Try to resolve a local font file that matches a remote font filename."""
+
+    parsed_url = urlparse(font_location)
+    font_name = Path(unquote(parsed_url.path)).name
+    if not font_name:
+        return None
+
+    search_roots = [Path.cwd(), Path(__file__).resolve().parents[1]]
+    seen_roots = set()
+
+    for root in search_roots:
+        if root in seen_roots:
+            continue
+        seen_roots.add(root)
+
+        for candidate in root.rglob(font_name):
+            if candidate.is_file():
+                return candidate
+
+    return None
+
 
 def _get_font_from_url(font_location: str) -> FontProperties:
