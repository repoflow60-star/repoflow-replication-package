+def _decode_body(body: bytes, headers) -> str:
+    content_type = headers.get("Content-Type", "")
+    match = re.search(r"charset=([^\s;]+)", content_type, re.IGNORECASE)
+    encoding = match.group(1) if match else "utf-8"
+    return body.decode(encoding, errors="replace")
+
+
+class Response:
+    def __init__(self, response: urllib3.response.HTTPResponse, url: str, history=None):
+        self._response = response
+        self.url = url
+        self.history = history or []
+
+    @property
+    def status_code(self):
+        return self._response.status
+
+    @property
+    def headers(self):
+        return self._response.headers
+
+    @property
+    def content(self):
+        return self._response.data
+
+    @property
+    def text(self):
+        return _decode_body(self.content, self.headers)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise HTTPError(f"{self.status_code} error for url: {self.url}")
+
+
+class Session:
+    def __init__(self, pool_manager: Optional[PoolManager] = None):
+        self._pool = pool_manager or urllib3.PoolManager()
+        self.cookies = {}
+
+    def _cookie_header(self):
+        if not self.cookies:
+            return None
+        return "; ".join(f"{name}={value}" for name, value in self.cookies.items())
+
+    def _update_cookies(self, response):
+        set_cookie_headers = response.headers.getlist("Set-Cookie") or []
+        for header in set_cookie_headers:
+            cookie = SimpleCookie()
+            cookie.load(header)
+            for morsel in cookie.values():
+                self.cookies[morsel.key] = morsel.value
+
+    def _request(self, method: str, url: str, data=None, headers=None):
+        body = None
+        if data is not None:
+            body = urlencode(data, doseq=True).encode("utf-8")
+
+        history = []
+        current_method = method
+        current_url = url
+        current_body = body
+        for _ in range(10):
+            request_headers = dict(headers or {})
+            cookie_header = self._cookie_header()
+            if cookie_header:
+                request_headers["Cookie"] = cookie_header
+            if current_body is not None:
+                request_headers.setdefault(
+                    "Content-Type", "application/x-www-form-urlencoded"
+                )
+            response = self._pool.request(
+                current_method,
+                current_url,
+                body=current_body,
+                headers=request_headers,
+                preload_content=True,
+                redirect=False,
+            )
+            self._update_cookies(response)
+            wrapped = Response(response=response, url=current_url)
+            location = response.headers.get("Location")
+            if response.status in {301, 302, 303, 307, 308} and location:
+                history.append(wrapped)
+                current_url = urljoin(current_url, location)
+                if response.status == 303 or (
+                    response.status in {301, 302} and current_method != "GET"
+                ):
+                    current_method = "GET"
+                    current_body = None
+                continue
+            wrapped.history = history
+            wrapped.url = current_url
+            return wrapped
+        raise HTTPError(f"Too many redirects for url: {url}")
+
+    def get(self, url, headers=None):
+        return self._request("GET", url, headers=headers)
+
+    def post(self, url, data=None, headers=None):
+        return self._request("POST", url, data=data, headers=headers)
 
 
