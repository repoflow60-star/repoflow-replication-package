+    class _FallbackSeaborn:
+        def set_theme(self, *args, **kwargs):
+            return None
+
+        def heatmap(
+            self,
+            data,
+            annot=False,
+            fmt="d",
+            cmap=None,
+            cbar=False,
+            xticklabels=None,
+            yticklabels=None,
+            ax=None,
+        ):
+            if ax is None:
+                ax = plt.gca()
+            ax.imshow(data, interpolation="nearest", cmap=cmap)
+            if xticklabels is not None:
+                ax.set_xticks(np.arange(len(xticklabels)))
+                ax.set_xticklabels(xticklabels)
+            if yticklabels is not None:
+                ax.set_yticks(np.arange(len(yticklabels)))
+                ax.set_yticklabels(yticklabels)
+            if annot:
+                for i in range(data.shape[0]):
+                    for j in range(data.shape[1]):
+                        ax.text(j, i, format(data[i, j], fmt), ha="center", va="center")
+            if not cbar:
+                ax.grid(False)
+            return ax
+
+        def scatterplot(
+            self,
+            data=None,
+            x=None,
+            y=None,
+            hue=None,
+            palette=None,
+            alpha=None,
+            s=None,
+            linewidth=None,
+            legend=None,
+            ax=None,
+        ):
+            if ax is None:
+                ax = plt.gca()
+            if data is None:
+                raise ValueError("scatterplot fallback requires a data frame")
+            x_values = data[x]
+            y_values = data[y]
+            if hue is None:
+                colors = None
+            else:
+                colors = [palette[val] for val in data[hue]]
+            ax.scatter(
+                x_values,
+                y_values,
+                c=colors,
+                alpha=alpha,
+                s=s,
+                linewidth=linewidth or 0,
+            )
+            return ax
+
+        def barplot(
+            self,
+            data=None,
+            x=None,
+            y=None,
+            order=None,
+            orient="h",
+            ax=None,
+            color=None,
+        ):
+            if ax is None:
+                ax = plt.gca()
+            if data is None:
+                raise ValueError("barplot fallback requires a data frame")
+            if orient != "h":
+                raise ValueError("barplot fallback only supports horizontal bars")
+            if order is None:
+                order = list(data[y])
+            values = [data.loc[data[y] == label, x].iloc[0] for label in order]
+            positions = np.arange(len(order))
+            ax.barh(positions, values, color=color)
+            ax.set_yticks(positions)
+            ax.set_yticklabels(order)
+            return ax
+
+    sns = _FallbackSeaborn()
+
+sns.set_theme(style="white")
 
 
