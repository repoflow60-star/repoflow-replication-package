+"""Minimal requests-compatible wrapper built on top of urllib3."""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+import urllib3
+
+_POOL = urllib3.PoolManager()
+
+
+@dataclass
+class Response:
+    """Small response wrapper that provides the subset of requests we use."""
+
+    status_code: int
+    headers: Mapping[str, str]
+    data: bytes
+
+    @property
+    def text(self) -> str:
+        content_type = self.headers.get("content-type", "")
+        charset = "utf-8"
+        if "charset=" in content_type:
+            charset = content_type.split("charset=", 1)[1].split(";", 1)[0].strip()
+        return self.data.decode(charset, errors="replace")
+
+    def json(self) -> Any:
+        return json.loads(self.text)
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            raise HTTPError(f"HTTP {self.status_code}")
+
+
+class HTTPError(Exception):
+    """Raised when a response has an HTTP error status."""
+
+
+def get(
+    url: str,
+    params: Optional[Mapping[str, Any]] = None,
+    timeout: Optional[float] = None,
+    **kwargs: Any,
+) -> Response:
+    """Perform a GET request via urllib3 and return a requests-like response."""
+    response = _POOL.request(
+        "GET",
+        url,
+        fields=params,
+        timeout=timeout,
+        preload_content=True,
+        **kwargs,
+    )
+    return Response(
+        status_code=response.status,
+        headers=response.headers,
+        data=response.data,
+    )
