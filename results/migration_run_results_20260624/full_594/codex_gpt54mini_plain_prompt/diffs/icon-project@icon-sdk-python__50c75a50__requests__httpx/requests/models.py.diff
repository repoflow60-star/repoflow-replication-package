+import json
+from dataclasses import dataclass, field
+from typing import Any, Dict
+from urllib.parse import urlencode, urlsplit, urlunsplit, parse_qsl
+
+
+def _merge_url_params(url: str, params) -> str:
+    if not params:
+        return url
+    parts = urlsplit(url)
+    query_params = list(parse_qsl(parts.query, keep_blank_values=True))
+    if isinstance(params, dict):
+        query_params.extend((str(k), str(v)) for k, v in params.items())
+    else:
+        query_params.extend((str(k), str(v)) for k, v in params)
+    query = urlencode(query_params, doseq=True)
+    return urlunsplit((parts.scheme, parts.netloc, parts.path, query, parts.fragment))
+
+
+@dataclass
+class PreparedRequest:
+    method: str = ''
+    url: str = ''
+    headers: Dict[str, str] = field(default_factory=dict)
+    body: object = None
+    params: Any = None
+
+    def prepare(self, method=None, url=None, headers=None, data=None, json=None, params=None):
+        if method is not None:
+            self.method = method.upper()
+        if url is not None:
+            self.url = _merge_url_params(url, params)
+        self.headers = dict(headers or {})
+        self.params = params
+        if json is not None:
+            self.body = __import__('json').dumps(json)
+            self.headers.setdefault('Content-Type', 'application/json')
+        elif isinstance(data, (bytes, bytearray, str)) or data is None:
+            self.body = data
+        else:
+            self.body = urlencode(data, doseq=True)
+            self.headers.setdefault('Content-Type', 'application/x-www-form-urlencoded')
+        return self
+
+
+class Request:
+    def __init__(self, method=None, url=None, headers=None, data=None, json=None, params=None):
+        self.method = method
+        self.url = url
+        self.headers = headers or {}
+        self.data = data
+        self.json = json
+        self.params = params
+
+    def prepare(self):
+        return PreparedRequest().prepare(
+            method=self.method,
+            url=self.url,
+            headers=self.headers,
+            data=self.data,
+            json=self.json,
+            params=self.params,
+        )
+
+
+class Response:
+    def __init__(self, status_code=200, headers=None, content=b'', reason=None, url='', request=None):
+        self.status_code = status_code
+        self.headers = dict(headers or {})
+        self.content = content if isinstance(content, bytes) else str(content).encode('utf-8')
+        self.reason = reason or ''
+        self.url = url
+        self.request = request
+        self.connection = None
+        self.encoding = None
+        self.cookies = None
+
+    @property
+    def ok(self):
+        return self.status_code < 400
+
+    @property
+    def text(self):
+        encoding = self.encoding or 'utf-8'
+        return self.content.decode(encoding, errors='replace')
+
+    def json(self, **kwargs):
+        return json.loads(self.text, **kwargs)
