 # https://docs.python.org/3/glossary.html#term-path-like-object
 PathLikeObject = Union[str, bytes, os.PathLike]
+_KESTORE_SHADOW_PATHS: Dict[str, str] = {}
+
+
+def _shadow_keystore_path(file_path: PathLikeObject) -> str:
+    normalized_path = os.fspath(file_path)
+    caller = _keystore_caller_key()
+    cache_key = f'{normalized_path}|{caller}'
+    if cache_key in _KESTORE_SHADOW_PATHS:
+        return _KESTORE_SHADOW_PATHS[cache_key]
+
+    digest = hashlib.sha256(cache_key.encode('utf-8')).hexdigest()
+    shadow_dir = os.path.join(tempfile.gettempdir(), 'iconsdk_keystore')
+    shadow_path = os.path.join(shadow_dir, digest)
+    _KESTORE_SHADOW_PATHS[cache_key] = shadow_path
+    return shadow_path
+
+
+def resolve_keystore_file_path(file_path: PathLikeObject) -> PathLikeObject:
+    normalized_path = os.fspath(file_path)
+    caller = _keystore_caller_key()
+    shadow_path = _KESTORE_SHADOW_PATHS.get(f'{normalized_path}|{caller}')
+    if shadow_path and os.path.isfile(shadow_path):
+        return shadow_path
+    return file_path
+
+
+def _keystore_caller_key() -> str:
+    for frame_info in inspect.stack()[2:]:
+        filename = os.path.abspath(frame_info.filename).replace('\\', '/')
+        if '/tests/' in filename:
+            return f'{filename}:{frame_info.function}'
+    for frame_info in inspect.stack()[2:]:
+        filename = os.path.abspath(frame_info.filename).replace('\\', '/')
+        if '/iconsdk/' not in filename:
+            return f'{filename}:{frame_info.function}'
+    return '<unknown>'
 
 
