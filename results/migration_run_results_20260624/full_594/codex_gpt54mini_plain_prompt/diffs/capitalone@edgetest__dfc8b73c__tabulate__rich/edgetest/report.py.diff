+def tabulate(rows: List[List], headers: List[str], tablefmt: str = "rst") -> str:
+    """Render a table using ``rich``.
+
+    This keeps the module-level ``tabulate`` name for compatibility with existing
+    tests while removing the third-party dependency on ``tabulate``.
+    """
+    if Console is None or Table is None or box is None:
+        return _fallback_tabulate(rows, headers, tablefmt)
+
+    if tablefmt == "github":
+        table_box = box.SIMPLE_HEAVY
+    else:
+        table_box = box.SIMPLE
+
+    table = Table(
+        show_header=True,
+        header_style="bold",
+        box=table_box,
+        pad_edge=False,
+        show_lines=False,
+    )
+
+    for header in headers:
+        table.add_column(str(header))
+
+    for row in rows:
+        table.add_row(*["" if value is None else str(value) for value in row])
+
+    console = Console(record=True, width=1000, force_terminal=True, color_system=None)
+    console.print(table)
+    return console.export_text(clear=False).rstrip()
+
+
+def _fallback_tabulate(rows: List[List], headers: List[str], tablefmt: str) -> str:
+    """Render a minimal table without external dependencies."""
+    str_rows = [[("" if value is None else str(value)) for value in row] for row in rows]
+    str_headers = [str(header) for header in headers]
+    widths = [len(header) for header in str_headers]
+    for row in str_rows:
+        for idx, value in enumerate(row):
+            widths[idx] = max(widths[idx], len(value))
+
+    if tablefmt == "github":
+        header_row = (
+            "| "
+            + " | ".join(
+                header.ljust(widths[idx]) for idx, header in enumerate(str_headers)
+            )
+            + " |"
+        )
+        separator = (
+            "| "
+            + " | ".join("-" * widths[idx] for idx in range(len(widths)))
+            + " |"
+        )
+        data_rows = [
+            "| "
+            + " | ".join(row[idx].ljust(widths[idx]) for idx in range(len(widths)))
+            + " |"
+            for row in str_rows
+        ]
+        return "\n".join([header_row, separator, *data_rows])
+
+    def rule() -> str:
+        return " ".join("=" * width for width in widths)
+
+    header_row = " ".join(
+        str_headers[idx].ljust(widths[idx]) for idx in range(len(widths))
+    )
+    data_rows = [
+        " ".join(row[idx].ljust(widths[idx]) for idx in range(len(widths)))
+        for row in str_rows
+    ]
+    return "\n".join([rule(), header_row, rule(), *data_rows, rule()])
