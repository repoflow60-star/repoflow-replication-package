+from dataclasses import dataclass, field
+from io import BytesIO
+from typing import Any, Iterable, List, MutableMapping, Optional, Sequence
+
+
+@dataclass
+class Scatter:
+    x: Sequence[Any] = ()
+    y: Sequence[Any] = ()
+    mode: str = 'lines'
+    name: Optional[str] = None
+    line: MutableMapping[str, Any] = field(default_factory=dict)
+
+
+class Figure:
+    def __init__(self, data: Optional[Iterable[Scatter]] = None, layout: Optional[MutableMapping[str, Any]] = None):
+        self.data: List[Scatter] = list(data or [])
+        self.layout: MutableMapping[str, Any] = dict(layout or {})
+
+    def add_trace(self, trace: Scatter):
+        self.data.append(trace)
+        return self
+
+    def update_layout(self, **kwargs):
+        self.layout.update(kwargs)
+        return self
+
+    def show(self, *args, **kwargs):
+        return self
+
+    def to_image(self, format: str = 'png', width: Optional[int] = None, height: Optional[int] = None):
+        if format.lower() != 'png':
+            raise ValueError('only png output is supported by the local plotly compatibility layer')
+
+        import matplotlib.pyplot as plt
+
+        fig, ax = plt.subplots(figsize=((width or 900) / 100.0, (height or 600) / 100.0), dpi=100)
+        for trace in self.data:
+            ax.plot(list(trace.x), list(trace.y), label=trace.name)
+
+        title = self.layout.get('title')
+        if isinstance(title, dict):
+            title = title.get('text')
+        if title:
+            ax.set_title(title)
+        if self.layout.get('xaxis_title'):
+            ax.set_xlabel(self.layout['xaxis_title'])
+        if self.layout.get('yaxis_title'):
+            ax.set_ylabel(self.layout['yaxis_title'])
+        if any(trace.name for trace in self.data):
+            ax.legend()
+
+        buffer = BytesIO()
+        fig.savefig(buffer, format='png', bbox_inches='tight')
+        plt.close(fig)
+        return buffer.getvalue()
+
+    def write_image(self, file, format: str = 'png', width: Optional[int] = None, height: Optional[int] = None):
+        image_bytes = self.to_image(format=format, width=width, height=height)
+        if hasattr(file, 'write'):
+            file.write(image_bytes)
+            return
+
+        with open(file, 'wb') as f:
+            f.write(image_bytes)
+
+    def to_dict(self):
+        return {
+            'data': [trace.__dict__.copy() for trace in self.data],
+            'layout': dict(self.layout),
+        }
