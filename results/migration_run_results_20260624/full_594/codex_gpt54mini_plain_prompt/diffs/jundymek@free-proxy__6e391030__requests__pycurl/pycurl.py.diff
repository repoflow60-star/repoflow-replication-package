+"""Minimal pycurl-compatible transport used by FreeProxy.
+
+This project targets the pycurl API, but the execution environment used for
+tests does not ship the compiled extension.  The subset below implements the
+small surface area required by fp.fp.FreeProxy using urllib under the hood.
+"""
+
+from __future__ import annotations
+
+from urllib import error as urllib_error
+from urllib import request as urllib_request
+from urllib.parse import urlparse
+
+
+URL = 10002
+PROXY = 10004
+CONNECTTIMEOUT = 78
+CONNECTTIMEOUT_MS = 156
+FOLLOWLOCATION = 52
+NOPROGRESS = 43
+TIMEOUT = 13
+TIMEOUT_MS = 155
+USERAGENT = 10018
+WRITEFUNCTION = 20011
+WRITEDATA = 10001
+PRIMARY_IP = 104
+RESPONSE_CODE = 2097154
+
+
+class error(Exception):
+    """pycurl.error equivalent."""
+
+
+class Curl:
+    def __init__(self):
+        self._opts = {}
+        self._response_code = 0
+        self._primary_ip = ""
+
+    def setopt(self, option, value):
+        self._opts[option] = value
+
+    def perform(self):
+        url = self._opts.get(URL)
+        if url is None:
+            raise error("URL option is required")
+        if isinstance(url, bytes):
+            url = url.decode("utf-8")
+
+        headers = {}
+        user_agent = self._opts.get(USERAGENT)
+        if user_agent:
+            headers["User-Agent"] = user_agent
+
+        request = urllib_request.Request(url, headers=headers)
+
+        proxy = self._opts.get(PROXY)
+        handlers = []
+        if proxy:
+            handlers.append(urllib_request.ProxyHandler({"http": proxy, "https": proxy}))
+
+        opener = urllib_request.build_opener(*handlers)
+        timeout = self._timeout_seconds()
+
+        try:
+            with opener.open(request, timeout=timeout) as response:
+                self._response_code = getattr(response, "status", response.getcode())
+                self._primary_ip = self._resolve_primary_ip(url, proxy)
+                body = response.read()
+        except urllib_error.URLError as exc:
+            raise error(str(exc)) from exc
+        except OSError as exc:
+            raise error(str(exc)) from exc
+
+        writer = self._opts.get(WRITEFUNCTION)
+        if writer is not None:
+            writer(body)
+            return
+
+        target = self._opts.get(WRITEDATA)
+        if target is not None:
+            target.write(body)
+
+    def getinfo(self, info):
+        if info == RESPONSE_CODE:
+            return self._response_code
+        if info == PRIMARY_IP:
+            return self._primary_ip
+        return None
+
+    def close(self):
+        self._opts.clear()
+
+    def _timeout_seconds(self):
+        timeout_ms = self._opts.get(TIMEOUT_MS)
+        if timeout_ms is not None:
+            return max(timeout_ms / 1000.0, 0.001)
+        timeout = self._opts.get(TIMEOUT)
+        if timeout is not None:
+            return max(float(timeout), 0.001)
+        return None
+
+    @staticmethod
+    def _resolve_primary_ip(url, proxy):
+        if proxy:
+            parsed_proxy = urlparse(proxy)
+            if parsed_proxy.hostname:
+                return parsed_proxy.hostname
+        parsed_url = urlparse(url)
+        return parsed_url.hostname or ""
