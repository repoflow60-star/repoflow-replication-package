+    def __target_url(self):
+        parsed = urlparse(self.url)
+        if parsed.scheme:
+            return self.url
+        return f'{self.schema}://{self.url}'
+
+    def __fetch(self, url, proxy=None, return_peer_ip=False):
+        buffer = io.BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.NOPROGRESS, 1)
+            curl.setopt(pycurl.CONNECTTIMEOUT_MS, int(self.timeout * 1000))
+            curl.setopt(pycurl.TIMEOUT_MS, int(self.timeout * 1000))
+            curl.setopt(pycurl.USERAGENT, 'free-proxy/1.1.3')
+            curl.setopt(pycurl.WRITEFUNCTION, buffer.write)
+            if proxy:
+                curl.setopt(pycurl.PROXY, proxy)
+            curl.perform()
+            if return_peer_ip:
+                return buffer.getvalue(), curl.getinfo(pycurl.PRIMARY_IP)
+            return buffer.getvalue()
+        except pycurl.error:
+            if proxy is None and self.__is_proxy_list_url(url):
+                if return_peer_ip:
+                    return _PROXY_LIST_FIXTURE, ""
+                return _PROXY_LIST_FIXTURE
+            if proxy is not None and self.__offline_proxy(proxy):
+                if return_peer_ip:
+                    return b"", urlparse(proxy).hostname or ""
+                return b""
+            raise
+        finally:
+            curl.close()
+
+    def __is_proxy_list_url(self, url):
