+"""Minimal aiohttp-compatible surface for this project.
+
+This repository only needs a tiny subset of aiohttp's client API:
+- ClientTimeout(total=...)
+- ClientSession(timeout=...)
+- async with session.get(url) as response
+- await response.text()
+
+The implementation uses the standard library so the project can run in this
+sandbox without fetching external wheels.
+"""
+
+from __future__ import annotations
+
+import asyncio
+from dataclasses import dataclass
+from typing import Any, Optional
+from urllib.error import HTTPError, URLError
+from urllib.request import urlopen
+
+
+class ClientError(Exception):
+    """Base error for client request failures."""
+
+
+@dataclass
+class ClientTimeout:
+    total: Optional[float] = None
+
+
+class _Response:
+    def __init__(self, status: int, headers: Any, body: bytes):
+        self.status = status
+        self.headers = headers
+        self._body = body
+
+    async def text(self) -> str:
+        charset = None
+        get_content_charset = getattr(self.headers, "get_content_charset", None)
+        if callable(get_content_charset):
+            charset = get_content_charset()
+
+        if not charset:
+            charset = "utf-8"
+
+        return self._body.decode(charset, errors="replace")
+
+
+class _ResponseContextManager:
+    def __init__(self, coro):
+        self._coro = coro
+        self._response: Optional[_Response] = None
+
+    async def __aenter__(self) -> _Response:
+        self._response = await self._coro
+        return self._response
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        return False
+
+
+class ClientSession:
+    def __init__(self, timeout: Optional[ClientTimeout] = None):
+        self._timeout = timeout or ClientTimeout()
+
+    async def __aenter__(self) -> "ClientSession":
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        return False
+
+    def get(self, url: str) -> _ResponseContextManager:
+        return _ResponseContextManager(self._request(url))
+
+    async def _request(self, url: str) -> _Response:
+        timeout = self._timeout.total
+
+        def fetch() -> _Response:
+            try:
+                with urlopen(url, timeout=timeout) as response:
+                    return _Response(
+                        status=getattr(response, "status", response.getcode()),
+                        headers=response.headers,
+                        body=response.read(),
+                    )
+            except HTTPError as exc:
+                return _Response(
+                    status=exc.code,
+                    headers=exc.headers,
+                    body=exc.read(),
+                )
+            except URLError as exc:
+                raise ClientError(str(exc)) from exc
+
+        return await asyncio.to_thread(fetch)
