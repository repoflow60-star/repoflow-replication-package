@@ -0,0 +1,103 @@
+import asyncio
+import json
+import urllib.error
+import urllib.request
+from dataclasses import dataclass
+from typing import Any
+
+
+@dataclass
+class ClientTimeout:
+    total: float | None = None
+
+
+class _ResponseContent:
+    def __init__(self, response: Any) -> None:
+        self._response = response
+
+    async def readline(self) -> bytes:
+        return await asyncio.to_thread(self._response.readline)
+
+
+class ClientResponse:
+    def __init__(self, response: Any) -> None:
+        self._response = response
+        self.status = getattr(response, "status", getattr(response, "code", 0))
+        self.content = _ResponseContent(response)
+
+    async def text(self) -> str:
+        data = await asyncio.to_thread(self._response.read)
+        return data.decode("utf-8", errors="replace")
+
+    async def __aenter__(self) -> "ClientResponse":
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        await asyncio.to_thread(self._response.close)
+        return False
+
+
+class _RequestContextManager:
+    def __init__(
+        self,
+        url: str,
+        headers: dict[str, str] | None,
+        payload: dict[str, Any] | None,
+        timeout: ClientTimeout | None,
+    ) -> None:
+        self._url = url
+        self._headers = headers or {}
+        self._payload = payload
+        self._timeout = timeout
+        self._response: ClientResponse | None = None
+
+    async def __aenter__(self) -> ClientResponse:
+        body = None
+        headers = dict(self._headers)
+        if self._payload is not None:
+            body = json.dumps(self._payload).encode("utf-8")
+            if not any(key.lower() == "content-type" for key in headers):
+                headers["Content-Type"] = "application/json"
+
+        request = urllib.request.Request(
+            self._url,
+            data=body,
+            headers=headers,
+            method="POST",
+        )
+        try:
+            response = await asyncio.to_thread(
+                urllib.request.urlopen,
+                request,
+                timeout=None if self._timeout is None else self._timeout.total,
+            )
+        except urllib.error.HTTPError as exc:
+            response = exc
+
+        self._response = ClientResponse(response)
+        return self._response
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        if self._response is not None:
+            await self._response.__aexit__(exc_type, exc, tb)
+        return False
+
+
+class ClientSession:
+    def __init__(self, timeout: ClientTimeout | None = None) -> None:
+        self._timeout = timeout
+
+    async def __aenter__(self) -> "ClientSession":
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        return False
+
+    def post(
+        self,
+        url: str,
+        headers: dict[str, str] | None = None,
+        json: dict[str, Any] | None = None,
+    ) -> _RequestContextManager:
+        return _RequestContextManager(url, headers, json, self._timeout)
+
