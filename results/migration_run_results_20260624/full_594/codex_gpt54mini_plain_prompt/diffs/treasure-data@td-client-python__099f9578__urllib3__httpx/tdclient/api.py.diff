+class _HttpxResponseAdapter:
+    def __init__(self, response):
+        self._response = response
+        self._body = None
+        self._read_offset = 0
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, type, value, traceback):
+        self.close()
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
+    @property
+    def status(self):
+        return self._response.status_code
+
+    @property
+    def data(self):
+        return self._load_body()
+
+    def getheaders(self):
+        headers = self._response.headers
+        if hasattr(headers, "multi_items"):
+            return list(headers.multi_items())
+        return list(headers.items())
+
+    def _load_body(self):
+        if self._body is None:
+            self._body = self._response.read()
+        return self._body
+
+    def read(self, size=None):
+        body = self._load_body()
+        if size is None:
+            start = self._read_offset
+            self._read_offset = len(body)
+            return body[start:]
+
+        start = self._read_offset
+        end = min(len(body), start + size)
+        self._read_offset = end
+        return body[start:end]
+
+    def stream(self, size=None):
+        if self._body is not None:
+            chunk_size = 64 * 1024 if size is None else size
+            for start in range(self._read_offset, len(self._body), chunk_size):
+                yield self._body[start : start + chunk_size]
+            self._read_offset = len(self._body)
+            return
+
+        chunk_size = 64 * 1024 if size is None else size
+        chunks = []
+        for chunk in self._response.iter_bytes(chunk_size=chunk_size):
+            chunks.append(chunk)
+            yield chunk
+        self._body = b"".join(chunks)
+        self._read_offset = len(self._body)
+
+    def close(self):
+        self._response.close()
+
+
+class _HttpxClient(httpx.Client):
+    def __init__(self, *args, **kwargs):
+        kwargs.setdefault("trust_env", False)
+        proxy_url = kwargs.pop("proxy", None)
+        if proxy_url is not None:
+            kwargs["proxy"] = proxy_url
+        try:
+            super().__init__(*args, **kwargs)
+        except TypeError:
+            if proxy_url is None:
+                raise
+            kwargs.pop("proxy", None)
+            kwargs["proxies"] = proxy_url
+            super().__init__(*args, **kwargs)
+
+    def request(self, method, url, fields=None, body=None, headers=None, **kwargs):
+        kwargs.pop("decode_content", None)
+        kwargs.pop("preload_content", None)
+        request_kwargs = {"headers": headers}
+        if body is None:
+            if fields is not None:
+                if method.upper() in ("GET", "DELETE"):
+                    request_kwargs["params"] = fields
+                else:
+                    request_kwargs["data"] = fields
+        else:
+            if isinstance(body, bytearray):
+                body = bytes(body)
+            elif isinstance(body, array):
+                body = body.tobytes()
+            request_kwargs["content"] = body
+
+        request = super().build_request(method, url, **request_kwargs)
+        response = super().send(request, stream=True)
+        return _HttpxResponseAdapter(response)
+
+    def urlopen(self, method, url, body=None, headers=None, **kwargs):
+        return self.request(method, url, body=body, headers=headers, **kwargs)
+
+    def clear(self):
+        self.close()
+
