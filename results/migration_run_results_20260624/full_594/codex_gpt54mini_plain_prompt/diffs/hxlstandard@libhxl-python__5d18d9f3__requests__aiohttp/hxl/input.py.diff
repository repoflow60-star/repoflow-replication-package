+def _run_async(coro):
+    """Run a coroutine from synchronous code.
+
+    If there is already an event loop running in this thread, run the
+    coroutine in a helper thread so we do not nest event loops.
+    """
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coro)
+
+    result = {}
+    error = {}
+
+    def runner():
+        try:
+            result["value"] = asyncio.run(coro)
+        except Exception as exc:  # pragma: no cover - propagated below
+            error["value"] = exc
+
+    thread = threading.Thread(target=runner, daemon=True)
+    thread.start()
+    thread.join()
+    if error:
+        raise error["value"]
+    return result["value"]
+
+
+def _aiohttp_session_kwargs(input_options, headers=None):
+    """Build keyword arguments for an aiohttp ClientSession."""
+    session_kwargs = {}
+    if input_options and input_options.timeout is not None:
+        session_kwargs["timeout"] = aiohttp.ClientTimeout(total=input_options.timeout)
+    if headers is None and input_options is not None:
+        headers = input_options.http_headers
+    if headers is not None:
+        session_kwargs["headers"] = headers
+    if input_options and not input_options.verify_ssl:
+        session_kwargs["connector"] = aiohttp.TCPConnector(ssl=False)
+    return session_kwargs
+
+
+async def _aiohttp_fetch_bytes(url, input_options, method="GET", headers=None, params=None, data=None, allow_redirects=True):
+    """Fetch a URL and return status, headers, and the raw body."""
+    session_kwargs = _aiohttp_session_kwargs(input_options, headers=headers)
+    request_kwargs = {"allow_redirects": allow_redirects}
+    if params is not None:
+        request_kwargs["params"] = params
+    if data is not None:
+        request_kwargs["data"] = data
+
+    async with aiohttp.ClientSession(**session_kwargs) as session:
+        async with session.request(method, url, **request_kwargs) as response:
+            status = response.status
+            response_headers = response.headers
+            if status == 403:
+                return status, response_headers, None
+            response.raise_for_status()
+            return status, response_headers, await response.read()
+
+
+async def _aiohttp_fetch_json(url, input_options, method="GET", headers=None, params=None, data=None, allow_redirects=True):
+    """Fetch a URL and return status, headers, and parsed JSON."""
+    session_kwargs = _aiohttp_session_kwargs(input_options, headers=headers)
+    request_kwargs = {"allow_redirects": allow_redirects}
+    if params is not None:
+        request_kwargs["params"] = params
+    if data is not None:
+        request_kwargs["data"] = data
+
+    async with aiohttp.ClientSession(**session_kwargs) as session:
+        async with session.request(method, url, **request_kwargs) as response:
+            status = response.status
+            response_headers = response.headers
+            if status == 403:
+                return status, response_headers, None
+            response.raise_for_status()
+            return status, response_headers, await response.json(content_type=None)
+
+
+async def _aiohttp_head(url, input_options, headers=None):
+    """Fetch headers for a URL without following redirects."""
+    session_kwargs = _aiohttp_session_kwargs(input_options, headers=headers)
+    async with aiohttp.ClientSession(**session_kwargs) as session:
+        async with session.head(url, allow_redirects=False) as response:
+            return response.status, response.headers
+
