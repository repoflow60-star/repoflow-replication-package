+"""Small local substitute for requests_futures.sessions."""
+
+from concurrent.futures import ThreadPoolExecutor
+
+import requests
+
+
+class FuturesSession:
+    """Submit HTTP requests on a thread pool and return futures."""
+
+    def __init__(self, session=None, executor=None, max_workers=8):
+        self._session = session or requests.Session()
+        self._executor = executor or ThreadPoolExecutor(max_workers=max_workers)
+
+    def get(self, url, **kwargs):
+        return self._executor.submit(self._session.get, url, **kwargs)
