+def _append_query_params(url: str, params: Optional[Dict]) -> str:
+    """Append query parameters to a URL."""
+    if not params:
+        return url
+
+    separator = "&" if "?" in url else "?"
+    return url + separator + urlencode(params, doseq=True)
+
+
+class _CompatResponse:
+    """Lightweight response wrapper around urllib3 responses."""
+
+    def __init__(self, response: urllib3.HTTPResponse):
+        self.response = response
+
+    @property
+    def status_code(self) -> int:
+        return int(self.response.status)
+
+    def json(self):
+        """Decode the response body as JSON."""
+        body = self.response.data
+        if not body:
+            return None
+        if isinstance(body, bytes):
+            body = body.decode("utf-8")
+        return json_module.loads(body)
+
+    def raise_for_status(self):
+        """Raise a generic exception for HTTP error responses."""
+        if 400 <= self.status_code < 500:
+            raise Exception("%s Client Error" % (self.status_code))
+        if 500 <= self.status_code < 600:
+            raise Exception("%s Server Error" % (self.status_code))
+
+
+class _CompatSession:
+    """Small requests-like session backed by urllib3."""
+
+    def __init__(self):
+        self.headers: Dict[str, str] = {}
+        self._pool = urllib3.PoolManager()
+
+    def request(
+        self,
+        method: str,
+        url: str,
+        params: Optional[Dict] = None,
+        data: Optional[Dict] = None,
+        json: Optional[Dict] = None,
+        timeout: int = 30,
+        **kwargs,
+    ) -> _CompatResponse:
+        headers = dict(self.headers)
+        extra_headers = kwargs.pop("headers", None)
+        if extra_headers:
+            headers.update(extra_headers)
+        body = None
+
+        url = _append_query_params(url, params)
+
+        if json is not None:
+            body = json_module.dumps(json).encode("utf-8")
+            headers.setdefault("Content-Type", "application/json")
+        elif data is not None:
+            if isinstance(data, (dict, list, tuple)):
+                body = urlencode(data, doseq=True).encode("utf-8")
+                headers.setdefault("Content-Type", "application/x-www-form-urlencoded")
+            elif isinstance(data, str):
+                body = data.encode("utf-8")
+            else:
+                body = data
+
+        response = self._pool.request(
+            method.upper(),
+            url,
+            body=body,
+            headers=headers,
+            timeout=timeout,
+        )
+        return _CompatResponse(response)
+
+    def get(self, url: str, **kwargs) -> _CompatResponse:
+        return self.request("get", url, **kwargs)
+
+    def post(self, url: str, **kwargs) -> _CompatResponse:
+        return self.request("post", url, **kwargs)
+
+    def close(self):
+        self._pool.clear()
+
+
+class _RequestsCompat:
+    """Module-like facade that keeps existing patch points working."""
+
+    Session = _CompatSession
+
+    def __init__(self):
+        self._pool = urllib3.PoolManager()
+
+    def get(
+        self, url: str, params: Optional[Dict] = None, timeout: int = 30, **kwargs
+    ) -> _CompatResponse:
+        response = self._pool.request(
+            "GET",
+            _append_query_params(url, params),
+            timeout=timeout,
+            headers=kwargs.get("headers"),
+        )
+        return _CompatResponse(response)
+
+
+requests = _RequestsCompat()
+
