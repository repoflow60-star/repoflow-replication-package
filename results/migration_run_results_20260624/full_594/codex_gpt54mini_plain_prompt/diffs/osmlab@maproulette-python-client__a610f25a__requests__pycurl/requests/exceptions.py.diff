diff --git /dev/null b/requests/exceptions.py
new file mode 100644
index 0000000..dcb26fc
--- /dev/null
+++ b/requests/exceptions.py
@@ -0,0 +1,21 @@
+"""Subset of the requests exception hierarchy used by the client."""
+
+
+class RequestException(Exception):
+    pass
+
+
+class ConnectionError(RequestException):
+    pass
+
+
+class Timeout(RequestException):
+    pass
+
+
+class HTTPError(RequestException):
+    def __init__(self, message=None, response=None):
+        if message is None and response is not None:
+            message = f"{response.status_code} Error"
+        super().__init__(message)
+        self.response = response
