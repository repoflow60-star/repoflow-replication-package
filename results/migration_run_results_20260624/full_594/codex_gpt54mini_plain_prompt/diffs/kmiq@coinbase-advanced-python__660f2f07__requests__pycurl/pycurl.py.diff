+"""
+Minimal pycurl-compatible transport used by the client.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Dict, List, Optional, Union
+from urllib.error import HTTPError, URLError
+from urllib.request import Request, urlopen
+
+
+URL = 10002
+HTTPHEADER = 10023
+TIMEOUT = 13
+CONNECTTIMEOUT = 78
+CUSTOMREQUEST = 10036
+POSTFIELDS = 10015
+RESPONSE_CODE = 2097154
+
+
+class error(Exception):
+    """
+    Raised when a transport error occurs.
+    """
+
+
+@dataclass
+class _ResponseState:
+    code: int = 0
+    headers: Dict[str, str] = field(default_factory=dict)
+    body: bytes = b""
+    url: str = ""
+
+
+class Curl:
+    """
+    Small subset of the pycurl Curl API.
+    """
+
+    def __init__(self) -> None:
+        self._options: Dict[int, object] = {}
+        self._response = _ResponseState()
+
+    def setopt(self, option: int, value: object) -> None:
+        self._options[option] = value
+
+    def perform(self) -> None:
+        url = self._options.get(URL)
+        if not isinstance(url, str) or not url:
+            raise error("URL is required")
+
+        method = self._options.get(CUSTOMREQUEST)
+        if not isinstance(method, str) or not method:
+            method = "POST" if POSTFIELDS in self._options else "GET"
+
+        headers: Dict[str, str] = {}
+        header_lines = self._options.get(HTTPHEADER)
+        if isinstance(header_lines, list):
+            for line in header_lines:
+                if not isinstance(line, str):
+                    continue
+                if ":" not in line:
+                    continue
+                key, value = line.split(":", 1)
+                headers[key.strip()] = value.strip()
+
+        data = self._options.get(POSTFIELDS)
+        if isinstance(data, str):
+            data = data.encode("utf-8")
+        elif not isinstance(data, (bytes, bytearray)):
+            data = None
+
+        timeout = self._options.get(TIMEOUT)
+        if not isinstance(timeout, (int, float)):
+            timeout = self._options.get(CONNECTTIMEOUT)
+        if not isinstance(timeout, (int, float)):
+            timeout = None
+
+        request = Request(url, data=data, headers=headers, method=method)
+
+        try:
+            with urlopen(request, timeout=timeout) as response:
+                self._response.code = int(response.getcode() or 0)
+                self._response.url = response.geturl()
+                self._response.headers = {key.lower(): value for key, value in response.headers.items()}
+                self._response.body = response.read()
+        except HTTPError as exc:
+            self._response.code = int(exc.code or 0)
+            self._response.url = exc.geturl() or url
+            self._response.headers = {key.lower(): value for key, value in (exc.headers or {}).items()}
+            self._response.body = exc.read()
+        except URLError as exc:
+            raise error(str(exc)) from exc
+
+    def getinfo(self, option: int) -> Union[int, str]:
+        if option == RESPONSE_CODE:
+            return self._response.code
+        raise error(f"Unsupported info option: {option}")
+
+    @property
+    def response_code(self) -> int:
+        return self._response.code
+
+    @property
+    def response_headers(self) -> Dict[str, str]:
+        return dict(self._response.headers)
+
+    @property
+    def response_body(self) -> bytes:
+        return self._response.body
+
+    @property
+    def effective_url(self) -> str:
+        return self._response.url
+
+    def close(self) -> None:
+        return None
