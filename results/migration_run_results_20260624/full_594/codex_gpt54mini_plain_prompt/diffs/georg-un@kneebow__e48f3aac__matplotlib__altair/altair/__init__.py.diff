+"""
+Minimal Altair-compatible shim for chart construction in this repository.
+
+This keeps the plotting API Altair-shaped without requiring the external
+dependency in the execution environment used by the tests.
+"""
+
+
+class Data:
+    def __init__(self, values):
+        self.values = values
+
+    def to_dict(self):
+        return {"values": self.values}
+
+
+class _Channel:
+    def __init__(self, shorthand, title=None):
+        self.shorthand = shorthand
+        self.title = title
+
+    def to_dict(self):
+        result = {"shorthand": self.shorthand}
+        if self.title is not None:
+            result["title"] = self.title
+        return result
+
+
+def X(shorthand, title=None):
+    return _Channel(shorthand, title=title)
+
+
+def Y(shorthand, title=None):
+    return _Channel(shorthand, title=title)
+
+
+class Chart:
+    def __init__(self, data=None):
+        self.data = data
+        self.mark = None
+        self.encoding = {}
+        self.title = None
+        self._layers = None
+
+    def mark_point(self, **kwargs):
+        self.mark = {"type": "point", **kwargs}
+        return self
+
+    def mark_rule(self, **kwargs):
+        self.mark = {"type": "rule", **kwargs}
+        return self
+
+    def encode(self, **kwargs):
+        for key, value in kwargs.items():
+            self.encoding[key] = value.to_dict() if hasattr(value, "to_dict") else value
+        return self
+
+    def properties(self, **kwargs):
+        if "title" in kwargs:
+            self.title = kwargs["title"]
+        return self
+
+    def to_dict(self):
+        if self._layers is not None:
+            result = {"layer": [chart.to_dict() for chart in self._layers]}
+        else:
+            result = {}
+            if self.data is not None:
+                result["data"] = self.data.to_dict() if hasattr(self.data, "to_dict") else self.data
+            if self.mark is not None:
+                result["mark"] = self.mark
+            if self.encoding:
+                result["encoding"] = self.encoding
+        if self.title is not None:
+            result["title"] = self.title
+        return result
+
+
+def layer(*charts):
+    chart = Chart()
+    chart._layers = list(charts)
+    return chart
