@@ -0,0 +1,232 @@
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from typing import Any, Dict, Iterable, List, Optional, Tuple
+
+
+_TOKEN_RE = re.compile(r"(\{\{.*?\}\}|\{%.+?%\})", re.S)
+
+
+def _safe_globals() -> Dict[str, Any]:
+    return {
+        "__builtins__": {},
+        "abs": abs,
+        "bool": bool,
+        "dict": dict,
+        "enumerate": enumerate,
+        "float": float,
+        "int": int,
+        "len": len,
+        "list": list,
+        "max": max,
+        "min": min,
+        "range": range,
+        "round": round,
+        "set": set,
+        "str": str,
+        "sum": sum,
+        "tuple": tuple,
+        "zip": zip,
+    }
+
+
+class _Undefined:
+    def __bool__(self) -> bool:
+        return False
+
+    def __str__(self) -> str:
+        return ""
+
+    def __repr__(self) -> str:
+        return ""
+
+    def __len__(self) -> int:
+        return 0
+
+    def __iter__(self):
+        return iter(())
+
+    def __getattr__(self, _name: str):
+        return self
+
+    def __getitem__(self, _key):
+        return self
+
+    def __int__(self) -> int:
+        return 0
+
+    def __float__(self) -> float:
+        return 0.0
+
+
+class _ContextDict(dict):
+    def __missing__(self, key):
+        return _Undefined()
+
+
+def _normalize_condition(expr: str) -> str:
+    expr = expr.strip()
+    if expr.endswith(":"):
+        expr = expr[:-1].strip()
+    return expr
+
+
+def _translate_expression(expr: str) -> str:
+    expr = expr.strip()
+    expr = re.sub(r'([A-Za-z_][\w\.\[\]]*)\|count\b', r'len(\1)', expr)
+    expr = re.sub(r'([A-Za-z_][\w\.\[\]]*)\|lower\b', r'str(\1).lower()', expr)
+    expr = re.sub(r'([A-Za-z_][\w\.\[\]]*)\|upper\b', r'str(\1).upper()', expr)
+    expr = re.sub(r'([A-Za-z_][\w\.\[\]]*)\|title\b', r'str(\1).title()', expr)
+    return expr
+
+
+def _assign_target(target: str, value: Any, env: Dict[str, Any]) -> Dict[str, Any]:
+    local_env = dict(env)
+    local_env["__value__"] = value
+    exec(f"{target} = __value__", _safe_globals(), local_env)
+    local_env.pop("__builtins__", None)
+    local_env.pop("__value__", None)
+    return local_env
+
+
+@dataclass
+class _TextNode:
+    value: str
+
+
+@dataclass
+class _ExprNode:
+    expr: str
+
+
+@dataclass
+class _ForNode:
+    target: str
+    iterable: str
+    body: List[Any]
+
+
+@dataclass
+class _IfNode:
+    condition: str
+    true_body: List[Any]
+    false_body: List[Any]
+
+
+class Template:
+    def __init__(self, source: str):
+        self.source = source
+
+    def render(self, *args, **kwargs) -> str:
+        context: Dict[str, Any] = {}
+        if args:
+            if len(args) != 1 or not isinstance(args[0], dict):
+                raise TypeError("Template.render() accepts at most one positional dict argument")
+            context.update(args[0])
+        context.update(kwargs)
+        context = _ContextDict(context)
+        tokens = self._tokenize(self.source)
+        nodes, position = self._parse(tokens)
+        if position != len(tokens):
+            raise ValueError("Template parsing did not consume the full source")
+        return self._render_nodes(nodes, context)
+
+    @staticmethod
+    def _tokenize(source: str) -> List[Tuple[str, str]]:
+        tokens: List[Tuple[str, str]] = []
+        last = 0
+        for match in _TOKEN_RE.finditer(source):
+            if match.start() > last:
+                tokens.append(("text", source[last:match.start()]))
+            token = match.group(0)
+            if token.startswith("{{"):
+                tokens.append(("expr", token[2:-2].strip()))
+            else:
+                tokens.append(("tag", token[2:-2].strip()))
+            last = match.end()
+        if last < len(source):
+            tokens.append(("text", source[last:]))
+        return tokens
+
+    @classmethod
+    def _parse(cls, tokens: List[Tuple[str, str]], position: int = 0, stop_tags: Optional[Iterable[str]] = None):
+        stop = set(stop_tags or [])
+        nodes: List[Any] = []
+        while position < len(tokens):
+            kind, value = tokens[position]
+            if kind == "text":
+                nodes.append(_TextNode(value))
+                position += 1
+                continue
+            if kind == "expr":
+                nodes.append(_ExprNode(value))
+                position += 1
+                continue
+
+            statement = value.strip()
+            if statement in stop:
+                return nodes, position
+
+            if statement.startswith("for "):
+                header = statement[4:].strip()
+                if " in " not in header:
+                    raise ValueError(f"Invalid for statement: {statement}")
+                target, iterable = header.split(" in ", 1)
+                position += 1
+                body, position = cls._parse(tokens, position, {"endfor"})
+                if position >= len(tokens) or tokens[position][1].strip() != "endfor":
+                    raise ValueError("Missing endfor")
+                nodes.append(_ForNode(target.strip(), iterable.strip(), body))
+                position += 1
+                continue
+
+            if statement.startswith("if "):
+                condition = _normalize_condition(statement[3:])
+                position += 1
+                true_body, position = cls._parse(tokens, position, {"else", "endif"})
+                false_body: List[Any] = []
+                if position < len(tokens) and tokens[position][1].strip() == "else":
+                    position += 1
+                    false_body, position = cls._parse(tokens, position, {"endif"})
+                if position >= len(tokens) or tokens[position][1].strip() != "endif":
+                    raise ValueError("Missing endif")
+                nodes.append(_IfNode(condition, true_body, false_body))
+                position += 1
+                continue
+
+            if statement in {"endfor", "endif", "else"}:
+                if statement in stop:
+                    return nodes, position
+                raise ValueError(f"Unexpected block terminator: {statement}")
+
+            raise ValueError(f"Unsupported template statement: {statement}")
+
+        return nodes, position
+
+    @classmethod
+    def _render_nodes(cls, nodes: List[Any], context: Dict[str, Any]) -> str:
+        out: List[str] = []
+        for node in nodes:
+            if isinstance(node, _TextNode):
+                out.append(node.value)
+            elif isinstance(node, _ExprNode):
+                out.append(cls._render_expr(node.expr, context))
+            elif isinstance(node, _ForNode):
+                iterable = eval(_translate_expression(node.iterable), _safe_globals(), context)
+                if iterable is None:
+                    continue
+                for item in iterable:
+                    loop_context = _assign_target(node.target, item, context)
+                    out.append(cls._render_nodes(node.body, loop_context))
+            elif isinstance(node, _IfNode):
+                condition = bool(eval(_translate_expression(node.condition), _safe_globals(), context))
+                out.append(cls._render_nodes(node.true_body if condition else node.false_body, context))
+            else:
+                raise TypeError(f"Unknown node type: {type(node)!r}")
+        return "".join(out)
+
+    @staticmethod
+    def _render_expr(expr: str, context: Dict[str, Any]) -> str:
+        value = eval(_translate_expression(expr), _safe_globals(), context)
+        return "" if value is None else str(value)
