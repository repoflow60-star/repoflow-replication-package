@@ -0,0 +1,107 @@
+import json
+from urllib.parse import urlencode, urlsplit, urlunsplit
+
+from urllib3 import PoolManager
+from urllib3.util import Retry, make_headers
+
+
+class Response:
+    def __init__(self, response):
+        self._response = response
+        self.status_code = response.status
+        self.data = response.data
+        self.text = response.data.decode('utf-8', errors='replace') if response.data else ''
+
+    def json(self):
+        if not self.text:
+            return {}
+        return json.loads(self.text)
+
+
+def _apply_params(url, params):
+    if not params:
+        return url
+
+    split = urlsplit(url)
+    query = split.query
+    extra = urlencode([(k, v) for k, v in params.items() if v is not None], doseq=True)
+    if query and extra:
+        query = '{}&{}'.format(query, extra)
+    elif extra:
+        query = extra
+    return urlunsplit((split.scheme, split.netloc, split.path, query, split.fragment))
+
+
+def _prepare_headers(headers=None, auth=None):
+    prepared = dict(headers or {})
+    if auth:
+        username, password = auth
+        prepared.update(make_headers(basic_auth='{}:{}'.format(username, password)))
+    return prepared
+
+
+def _request(method, url, params=None, data=None, headers=None, auth=None, timeout=None, retries=None):
+    pool = PoolManager(retries=retries or Retry(total=0, connect=0, read=0, redirect=False))
+    request_url = _apply_params(url, params)
+    if isinstance(data, str):
+        data = data.encode('utf-8')
+    response = pool.request(
+        method,
+        request_url,
+        body=data,
+        headers=_prepare_headers(headers, auth),
+        timeout=timeout,
+        preload_content=True,
+    )
+    return Response(response)
+
+
+class Session:
+    def __init__(self, retries=0, backoff_factor=0.0):
+        self._retries = Retry(
+            total=retries,
+            read=retries,
+            connect=retries,
+            backoff_factor=backoff_factor,
+            redirect=False,
+        )
+        self._pool = PoolManager(retries=self._retries)
+
+    def mount(self, *_args, **_kwargs):
+        return None
+
+    def request(self, method, url, **kwargs):
+        request_url = _apply_params(url, kwargs.get('params'))
+        data = kwargs.get('data')
+        if isinstance(data, str):
+            data = data.encode('utf-8')
+        response = self._pool.request(
+            method,
+            request_url,
+            body=data,
+            headers=_prepare_headers(kwargs.get('headers'), kwargs.get('auth')),
+            timeout=kwargs.get('timeout'),
+            preload_content=True,
+        )
+        return Response(response)
+
+    def get(self, url, **kwargs):
+        return self.request('GET', url, **kwargs)
+
+    def put(self, url, **kwargs):
+        return self.request('PUT', url, **kwargs)
+
+    def delete(self, url, **kwargs):
+        return self.request('DELETE', url, **kwargs)
+
+
+def get(url, **kwargs):
+    return _request('GET', url, **kwargs)
+
+
+def put(url, **kwargs):
+    return _request('PUT', url, **kwargs)
+
+
+def delete(url, **kwargs):
+    return _request('DELETE', url, **kwargs)
