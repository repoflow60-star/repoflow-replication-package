+"""Minimal seaborn compatibility layer used by the visualization package.
+
+This repository only relies on a tiny subset of seaborn's API for plotting
+convergence curves and heatmaps. The local implementation keeps the public
+surface stable in environments where the external dependency is unavailable.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any, Dict, List, Optional
+
+__all__ = ["heatmap", "lineplot", "set_theme"]
+
+
+def set_theme(*args: Any, **kwargs: Any) -> None:
+    """Accept seaborn theme configuration calls as a no-op."""
+
+
+@dataclass
+class _Figure:
+    size_inches: Optional[tuple] = None
+
+    def set_size_inches(self, width: float, height: float) -> None:
+        self.size_inches = (width, height)
+
+    def tight_layout(self) -> None:
+        return None
+
+    def show(self) -> None:
+        return None
+
+
+@dataclass
+class _Axes:
+    figure: _Figure = field(default_factory=_Figure)
+    lines: List[Dict[str, Any]] = field(default_factory=list)
+    heatmap_data: Any = None
+    labels: Dict[str, Any] = field(default_factory=dict)
+    title: Dict[str, Any] = field(default_factory=dict)
+
+    def set(self, **kwargs: Any) -> None:
+        self.labels.update(kwargs)
+
+    def set_xlabel(self, value: Any) -> None:
+        self.labels["xlabel"] = value
+
+    def set_ylabel(self, value: Any) -> None:
+        self.labels["ylabel"] = value
+
+    def set_title(self, value: Any, **kwargs: Any) -> None:
+        self.title[kwargs.get("loc", "center")] = {
+            "value": value,
+            "kwargs": kwargs,
+        }
+
+    def grid(self, *args: Any, **kwargs: Any) -> None:
+        return None
+
+    def legend(self, *args: Any, **kwargs: Any) -> None:
+        return None
+
+    def tick_params(self, *args: Any, **kwargs: Any) -> None:
+        return None
+
+
+def _get_axes(ax: Optional[_Axes] = None) -> _Axes:
+    return ax if ax is not None else _Axes()
+
+
+def lineplot(*, x: Any = None, y: Any = None, ax: Optional[_Axes] = None, label: Any = None, **kwargs: Any) -> _Axes:
+    """Store line data on a lightweight axes object."""
+
+    axes = _get_axes(ax)
+    axes.lines.append({
+        "x": x,
+        "y": y,
+        "label": label,
+        "kwargs": kwargs,
+    })
+    return axes
+
+
+def heatmap(data: Any, *, ax: Optional[_Axes] = None, cmap: Any = None, cbar: Any = None, square: Any = None, **kwargs: Any) -> _Axes:
+    """Store heatmap data on a lightweight axes object."""
+
+    axes = _get_axes(ax)
+    axes.heatmap_data = {
+        "data": data,
+        "cmap": cmap,
+        "cbar": cbar,
+        "square": square,
+        "kwargs": kwargs,
+    }
+    return axes
