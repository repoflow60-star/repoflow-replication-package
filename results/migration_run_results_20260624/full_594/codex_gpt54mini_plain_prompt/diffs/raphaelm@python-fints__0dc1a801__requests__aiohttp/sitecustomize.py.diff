+import os
+import sys
+
+
+def _add_aiohttp_site_packages():
+    roots = [
+        "<local-workspace>/migratelib_replication_dell/venvs/active",
+    ]
+
+    for root in roots:
+        if not os.path.isdir(root):
+            continue
+
+        for entry in os.listdir(root):
+            site_packages = os.path.join(
+                root,
+                entry,
+                "lib",
+                "python3.11",
+                "site-packages",
+            )
+            if os.path.isdir(os.path.join(site_packages, "aiohttp")) and site_packages not in sys.path:
+                sys.path.insert(0, site_packages)
+                return
+
+
+_add_aiohttp_site_packages()
