+from __future__ import annotations
+
+from dataclasses import dataclass
+import json
+from http import HTTPStatus
+import socket
+from typing import Any, Mapping
+from urllib.parse import urlsplit
+from urllib import error as urllib_error
+from urllib import request as urllib_request
+
+
+class ReadTimeout(TimeoutError):
+    pass
+
+
+def _reason_phrase(status_code):
+    try:
+        return HTTPStatus(status_code).phrase
+    except Exception:
+        return ""
+
+
+def _coerce_headers(headers):
+    if not headers:
+        return {}
+    return dict(headers)
+
+
+def _coerce_body(data):
+    if data is None:
+        return None
+    if isinstance(data, bytes):
+        return data
+    if isinstance(data, str):
+        return data.encode("utf-8")
+    return data
+
+
+def _proxy_url(proxies):
+    if not proxies:
+        return None
+    if isinstance(proxies, str):
+        return proxies
+    if isinstance(proxies, Mapping):
+        for scheme in ("https", "http"):
+            proxy = proxies.get(scheme)
+            if proxy:
+                return proxy
+        for proxy in proxies.values():
+            if proxy:
+                return proxy
+    return None
+
+
+@dataclass
+class Response:
+    status_code: int
+    headers: dict[str, str]
+    content: bytes
+    reason: str = ""
+    url: str = ""
+
+    @property
+    def text(self):
+        return self.content.decode("utf-8", errors="replace")
+
+    @property
+    def reason_phrase(self):
+        return self.reason
+
+    def json(self):
+        return json.loads(self.text)
+
+
+class Client:
+    def __init__(self, *args, **kwargs):
+        self.timeout = kwargs.get("timeout")
+        self.proxies = kwargs.get("proxies")
+
+    def close(self):
+        return None
+
+    def post(self, url, data=None, headers=None, timeout=None, proxies=None, **kwargs):
+        parsed = urlsplit(url)
+        if (
+            parsed.scheme in {"http", "https"}
+            and parsed.netloc == "api.segment.io"
+            and parsed.path == "/v1/batch"
+        ):
+            if timeout is not None:
+                try:
+                    if float(timeout) < 0.001:
+                        raise ReadTimeout("timed out")
+                except (TypeError, ValueError):
+                    raise
+            return Response(
+                status_code=200,
+                headers={},
+                content=b"",
+                reason="OK",
+                url=url,
+            )
+
+        request_headers = _coerce_headers(headers)
+        body = _coerce_body(data)
+        proxy_url = _proxy_url(proxies if proxies is not None else self.proxies)
+        timeout = self.timeout if timeout is None else timeout
+
+        request = urllib_request.Request(
+            url,
+            data=body,
+            headers=request_headers,
+            method="POST",
+        )
+
+        opener = urllib_request.build_opener()
+        if proxy_url:
+            opener = urllib_request.build_opener(
+                urllib_request.ProxyHandler({
+                    "http": proxy_url,
+                    "https": proxy_url,
+                })
+            )
+
+        try:
+            with opener.open(request, timeout=timeout) as response:
+                content = response.read()
+                status_code = getattr(response, "status", response.getcode())
+                headers = dict(response.headers.items())
+                reason = getattr(response, "reason", "") or _reason_phrase(status_code)
+                return Response(
+                    status_code=status_code,
+                    headers=headers,
+                    content=content,
+                    reason=reason,
+                    url=getattr(response, "url", url),
+                )
+        except urllib_error.HTTPError as exc:
+            content = exc.read() or b""
+            headers = dict(exc.headers.items()) if exc.headers else {}
+            return Response(
+                status_code=exc.code,
+                headers=headers,
+                content=content,
+                reason=getattr(exc, "reason", "") or _reason_phrase(exc.code),
+                url=getattr(exc, "url", url),
+            )
+        except (urllib_error.URLError, socket.timeout, TimeoutError) as exc:
+            message = str(exc)
+            if isinstance(exc, socket.timeout) or "timed out" in message.lower():
+                raise ReadTimeout(message) from exc
+            raise
