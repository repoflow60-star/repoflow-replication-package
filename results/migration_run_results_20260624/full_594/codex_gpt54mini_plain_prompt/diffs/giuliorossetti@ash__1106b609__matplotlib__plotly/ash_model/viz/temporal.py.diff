+def _resolve_figure(kwargs: Dict[str, Any]):
+    fig = kwargs.pop("fig", None)
+    if fig is None:
+        fig = kwargs.pop("ax", None)
+    if fig is None:
+        fig = go.Figure()
+    return fig
+
+
+def _resolve_location(kwargs: Dict[str, Any]):
+    row = kwargs.pop("row", None)
+    col = kwargs.pop("col", None)
+    return row, col
+
+
+def _trace_style(kwargs: Dict[str, Any], *, default_mode: str = "lines"):
+    style: Dict[str, Any] = {}
+
+    alpha = kwargs.pop("alpha", None)
+    if alpha is not None:
+        style["opacity"] = alpha
+
+    color = kwargs.pop("color", None)
+    marker = dict(kwargs.pop("marker", {}) or {})
+    line = dict(kwargs.pop("line", {}) or {})
+    if color is not None:
+        marker.setdefault("color", color)
+        line.setdefault("color", color)
+
+    marker_size = kwargs.pop("marker_size", None)
+    if marker_size is not None:
+        marker["size"] = marker_size
+
+    marker_symbol = kwargs.pop("marker_symbol", None)
+    if marker_symbol is not None:
+        marker["symbol"] = marker_symbol
+
+    line_width = kwargs.pop("line_width", None)
+    if line_width is not None:
+        line["width"] = line_width
+
+    line_dash = kwargs.pop("line_dash", None)
+    if line_dash is not None:
+        line["dash"] = line_dash
+
+    if marker:
+        style["marker"] = marker
+    if line:
+        style["line"] = line
+
+    for key in (
+        "opacity",
+        "showlegend",
+        "legendgroup",
+        "hovertemplate",
+        "hoverinfo",
+        "text",
+        "customdata",
+        "fill",
+        "fillcolor",
+        "mode",
+    ):
+        if key in kwargs:
+            style[key] = kwargs.pop(key)
+
+    style.setdefault("mode", default_mode)
+    return style
+
+
+def _add_trace(fig, trace, kwargs):
+    row, col = _resolve_location(kwargs)
+    if row is not None or col is not None:
+        try:
+            fig.add_trace(trace, row=row, col=col)
+            return
+        except Exception:
+            pass
+    fig.add_trace(trace)
+
+
+def _kde_trace(y):
+    y = np.asarray(list(y), dtype=float)
+    if len(y) == 0:
+        return None, None
+    if len(y) == 1 or np.allclose(y, y[0]):
+        span = 0.01 if y[0] == 0 else max(abs(y[0]) * 0.01, 0.01)
+        x = np.array([y[0] - span, y[0], y[0] + span])
+        density = np.array([0.0, 1.0, 0.0])
+        return x, density
+
+    x = np.linspace(np.min(y), np.max(y), 200)
+    try:
+        kde = gaussian_kde(y)
+        density = kde(x)
+    except Exception:
+        density = np.zeros_like(x)
+        density[len(density) // 2] = 1.0
+    return x, density
+
