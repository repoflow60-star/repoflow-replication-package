+"""Minimal pycurl-compatible wrapper used by k8soptimizer.
+
+This project only needs simple HTTP GET support for Prometheus checks.
+The wrapper keeps the surface area small while allowing the codebase to
+depend on a pycurl-style transport instead of requests.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from io import BytesIO
+from urllib.error import HTTPError, URLError
+from urllib.request import Request, urlopen
+
+URL = 10002
+WRITEDATA = 10001
+HTTPHEADER = 10023
+FOLLOWLOCATION = 52
+TIMEOUT = 13
+NOBODY = 44
+CUSTOMREQUEST = 10036
+
+
+class error(Exception):
+    """Compatibility exception matching pycurl.error."""
+
+
+@dataclass
+class _TransferState:
+    url: str | None = None
+    body_buffer: BytesIO | None = None
+    headers: list[str] | None = None
+    follow_location: bool = True
+    timeout: float | None = None
+    method: str = "GET"
+
+
+class Curl:
+    def __init__(self) -> None:
+        self._state = _TransferState()
+
+    def setopt(self, option, value) -> None:
+        if option == URL:
+            self._state.url = value
+        elif option == WRITEDATA:
+            self._state.body_buffer = value
+        elif option == HTTPHEADER:
+            self._state.headers = list(value)
+        elif option == FOLLOWLOCATION:
+            self._state.follow_location = bool(value)
+        elif option == TIMEOUT:
+            self._state.timeout = float(value)
+        elif option == CUSTOMREQUEST:
+            self._state.method = str(value).upper()
+        elif option == NOBODY:
+            self._state.method = "HEAD" if value else "GET"
+        else:
+            raise error(f"Unsupported pycurl option: {option}")
+
+    def perform(self) -> None:
+        if self._state.url is None:
+            raise error("URL is required")
+        if self._state.body_buffer is None:
+            raise error("WRITEDATA buffer is required")
+
+        request = Request(self._state.url, method=self._state.method)
+        if self._state.headers:
+            for header in self._state.headers:
+                key, _, value = header.partition(":")
+                if not key or not value:
+                    continue
+                request.add_header(key.strip(), value.strip())
+
+        try:
+            with urlopen(
+                request,
+                timeout=self._state.timeout,
+            ) as response:
+                self._state.body_buffer.write(response.read())
+        except (HTTPError, URLError) as exc:
+            raise error(str(exc)) from exc
+
+    def close(self) -> None:
+        self._state = _TransferState()
+
