+"""Compatibility wrapper that exposes a requests-like API backed by pycurl."""
+
+from __future__ import annotations
+
+import importlib
+import json
+import sysconfig
+from dataclasses import dataclass
+from io import BytesIO
+from pathlib import Path
+from urllib.parse import urlencode
+
+import pycurl
+
+_REAL_REQUESTS_PACKAGE = Path(sysconfig.get_paths()["purelib"]) / "requests"
+if _REAL_REQUESTS_PACKAGE.exists():
+    __path__ = [str(_REAL_REQUESTS_PACKAGE)]  # type: ignore[assignment]
+
+    _version_globals = {}
+    exec((_REAL_REQUESTS_PACKAGE / "__version__.py").read_text(), _version_globals)
+    __version__ = str(_version_globals.get("__version__", "0.0.0"))
+    __build__ = int(_version_globals.get("__build__", 0))
+
+    # Import the common submodules used by kubernetes and requests-oauthlib.
+    adapters = importlib.import_module("requests.adapters")
+    auth = importlib.import_module("requests.auth")
+    cookies = importlib.import_module("requests.cookies")
+    exceptions = importlib.import_module("requests.exceptions")
+    models = importlib.import_module("requests.models")
+    sessions = importlib.import_module("requests.sessions")
+    structures = importlib.import_module("requests.structures")
+    utils = importlib.import_module("requests.utils")
+
+    # Some imported submodules bind the package's __version__ name to the
+    # version submodule. Reassert the string value after the imports.
+    __version__ = str(_version_globals.get("__version__", "0.0.0"))
+    __build__ = int(_version_globals.get("__build__", 0))
+else:
+    __version__ = "0.0.0"
+    __build__ = 0
+    adapters = auth = cookies = exceptions = models = sessions = structures = utils = None
+
+Session = sessions.Session if sessions is not None else object
+
+
+@dataclass
+class Response:
+    text: str
+    status_code: int = 200
+
+    @property
+    def content(self) -> bytes:
+        return self.text.encode("utf-8")
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            raise RuntimeError(f"HTTP error {self.status_code}")
+
+
+def get(url, params=None, timeout=None, headers=None, **kwargs) -> Response:
+    if params:
+        query_string = urlencode(params, doseq=True)
+        separator = "&" if "?" in url else "?"
+        url = f"{url}{separator}{query_string}"
+
+    body = BytesIO()
+    curl = pycurl.Curl()
+    curl.setopt(pycurl.URL, url)
+    curl.setopt(pycurl.WRITEDATA, body)
+    if timeout is not None:
+        curl.setopt(pycurl.TIMEOUT, timeout)
+    if headers:
+        curl.setopt(pycurl.HTTPHEADER, [f"{key}: {value}" for key, value in headers.items()])
+    try:
+        curl.perform()
+    finally:
+        curl.close()
+
+    return Response(text=body.getvalue().decode("utf-8"))
