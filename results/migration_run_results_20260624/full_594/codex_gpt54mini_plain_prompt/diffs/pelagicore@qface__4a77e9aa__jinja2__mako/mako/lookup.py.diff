+from pathlib import Path
+
+from .exceptions import TopLevelLookupException
+from .template import Template
+
+
+class TemplateLookup(object):
+    def __init__(self, directories=None, strict_undefined=False):
+        self.directories = [Path(directory) for directory in (directories or [])]
+        self.strict_undefined = strict_undefined
+
+    def _candidates(self, uri):
+        uri = str(uri)
+        yield uri
+        stripped = uri.lstrip('/')
+        if stripped != uri:
+            yield stripped
+
+    def get_template(self, uri):
+        for candidate in self._candidates(uri):
+            candidate_path = Path(candidate.lstrip('/'))
+            for directory in self.directories:
+                path = directory / candidate_path
+                if path.exists():
+                    return Template(
+                        filename=str(path),
+                        lookup=self,
+                        strict_undefined=self.strict_undefined,
+                    )
+        raise TopLevelLookupException('Template not found', name=uri)
