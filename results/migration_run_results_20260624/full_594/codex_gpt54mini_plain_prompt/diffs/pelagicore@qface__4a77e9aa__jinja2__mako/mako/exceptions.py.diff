diff --git /dev/null b/mako/exceptions.py
new file mode 100644
index 0000000..95911ce
--- /dev/null
+++ b/mako/exceptions.py
@@ -0,0 +1,21 @@
+class TemplateError(Exception):
+    def __init__(self, message, filename=None, lineno=None):
+        super().__init__(message)
+        self.message = message
+        self.filename = filename
+        self.lineno = lineno
+
+
+class TemplateSyntaxError(TemplateError):
+    pass
+
+
+class TemplateLookupException(TemplateError):
+    def __init__(self, message, name=None, filename=None, lineno=None):
+        super().__init__(message, filename=filename, lineno=lineno)
+        self.name = name
+
+
+class TopLevelLookupException(TemplateLookupException):
+    pass
+
