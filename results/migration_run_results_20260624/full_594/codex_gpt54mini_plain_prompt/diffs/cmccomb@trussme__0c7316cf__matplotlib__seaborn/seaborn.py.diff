+"""Minimal seaborn-compatible helpers used by trussme.
+
+This repository only needs a tiny subset of seaborn's API for styling and
+palette generation. The real seaborn package is preferred when available, but
+the test environment does not ship with it, so this module provides the small
+surface area the code depends on.
+"""
+
+from __future__ import annotations
+
+from matplotlib import colors as mcolors
+from matplotlib import pyplot as plt
+from matplotlib.colors import LinearSegmentedColormap
+
+
+def set_theme(style: str = "white", **kwargs) -> None:
+    """Apply a light plotting theme.
+
+    The implementation is intentionally minimal; it keeps the figure defaults
+    predictable without depending on the external seaborn package.
+    """
+
+    plt.style.use("default")
+    if style == "white":
+        plt.rcParams.update(
+            {
+                "axes.facecolor": "white",
+                "figure.facecolor": "white",
+                "savefig.facecolor": "white",
+            }
+        )
+
+
+def lineplot(x=None, y=None, color=None, alpha=None, legend=None, **kwargs):
+    """Create a matplotlib line plot with a seaborn-like call signature."""
+
+    fig, ax = plt.subplots()
+    fig._trussme_close = lambda: plt.close(fig)
+    if x is not None and y is not None:
+        ax.plot(x, y, color=color, alpha=alpha, **kwargs)
+    return ax
+
+
+def color_palette(name, as_cmap: bool = False):
+    """Return a palette or colormap similar to seaborn.color_palette."""
+
+    if name == "vlag":
+        colors = [
+            (0.001, 0.249, 0.412),
+            (0.532, 0.707, 0.864),
+            (0.969, 0.961, 0.961),
+            (0.901, 0.564, 0.549),
+            (0.547, 0.094, 0.152),
+        ]
+    else:
+        try:
+            cmap = plt.get_cmap(name)
+            colors = [cmap(i / 4.0)[:3] for i in range(5)]
+        except ValueError:
+            colors = [mcolors.to_rgb(name)]
+
+    if as_cmap:
+        return LinearSegmentedColormap.from_list(name, colors)
+
+    return colors
