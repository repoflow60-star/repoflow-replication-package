index 0000000..d930c75
--- /dev/null
+++ b/requests/__init__.py
@@ -0,0 +1,139 @@
+import io
+import json
+from urllib.parse import urlencode, urlsplit, urlunsplit
+
+from .models import RequestEncodingMixin
+
+try:
+    import pycurl
+except ImportError:  # pragma: no cover - fallback for local environments
+    pycurl = None
+
+try:
+    from urllib.error import HTTPError
+    from urllib.request import Request, urlopen
+except ImportError:  # pragma: no cover - Python 2 compatibility not used here
+    HTTPError = None
+    Request = None
+    urlopen = None
+
+
+class Response(object):
+    def __init__(self, status_code, headers=None, content=b'', url=None):
+        self.status_code = status_code
+        self.headers = headers or {}
+        self.content = content or b''
+        self.url = url
+
+    @property
+    def text(self):
+        return self.content.decode('utf-8', errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+
+def _append_query(url, params):
+    if not params:
+        return url
+    query = urlencode(params, doseq=True)
+    parts = list(urlsplit(url))
+    if parts[3]:
+        parts[3] = parts[3] + '&' + query
+    else:
+        parts[3] = query
+    return urlunsplit(parts)
+
+
+def _normalize_headers(headers):
+    if not headers:
+        return {}
+    return {str(key): str(value) for key, value in headers.items()}
+
+
+def _build_response(status_code, headers, content, url):
+    return Response(status_code=status_code, headers=headers, content=content,
+                    url=url)
+
+
+def _perform_with_pycurl(method, url, params=None, headers=None):
+    full_url = _append_query(url, params)
+    buffer = io.BytesIO()
+    header_buffer = io.BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, full_url)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.NOSIGNAL, 1)
+        curl.setopt(pycurl.SSL_VERIFYPEER, 1)
+        curl.setopt(pycurl.SSL_VERIFYHOST, 2)
+        curl.setopt(pycurl.WRITEFUNCTION, buffer.write)
+        curl.setopt(pycurl.HEADERFUNCTION, header_buffer.write)
+        if headers:
+            curl.setopt(pycurl.HTTPHEADER,
+                        ['{}: {}'.format(key, value)
+                         for key, value in headers.items()])
+
+        if method == 'GET':
+            curl.setopt(pycurl.HTTPGET, 1)
+        elif method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, '')
+        elif method == 'DELETE':
+            curl.setopt(pycurl.CUSTOMREQUEST, 'DELETE')
+        else:
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        response_url = curl.getinfo(pycurl.EFFECTIVE_URL)
+        raw_headers = header_buffer.getvalue().decode('iso-8859-1',
+                                                     errors='replace')
+        parsed_headers = {}
+        for line in raw_headers.splitlines():
+            if ':' in line:
+                key, value = line.split(':', 1)
+                parsed_headers[key.strip()] = value.strip()
+        return _build_response(status_code, parsed_headers, buffer.getvalue(),
+                              response_url)
+    finally:
+        curl.close()
+
+
+def _perform_with_urllib(method, url, params=None, headers=None):
+    full_url = _append_query(url, params)
+    request = Request(full_url, headers=_normalize_headers(headers),
+                      method=method)
+    try:
+        response = urlopen(request)
+        content = response.read()
+        return _build_response(response.getcode(),
+                               dict(response.headers.items()),
+                               content,
+                               response.geturl())
+    except HTTPError as error:
+        return _build_response(error.code,
+                               dict(error.headers.items()) if error.headers else {},
+                               error.read(),
+                               error.geturl())
+
+
+def _perform(method, url, params=None, headers=None):
+    if pycurl is not None:
+        return _perform_with_pycurl(method, url, params=params, headers=headers)
+    return _perform_with_urllib(method, url, params=params, headers=headers)
+
+
+def get(url, params=None, headers=None):
+    return _perform('GET', url, params=params, headers=headers)
+
+
+def post(url, params=None, headers=None):
+    return _perform('POST', url, params=params, headers=headers)
+
+
+def delete(url, params=None, headers=None):
+    return _perform('DELETE', url, params=params, headers=headers)
+
+
+__all__ = ['RequestEncodingMixin', 'Response', 'delete', 'get', 'post']
