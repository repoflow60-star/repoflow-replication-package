+class Response:
+    """Response object compatible with the subset used by this client."""
+
+    def __init__(self, code, text, method='GET', url=None, headers=None,
+            elapsed=None, request_headers=None):
+        self.status_code = int(code or 0)
+        if isinstance(text, bytes):
+            self.text = text.decode('utf-8', errors='replace')
+        else:
+            self.text = text if isinstance(text, str) else str(text)
+        self.ok = 200 <= self.status_code < 400
+        self.headers = headers or {}
+        self.url = url or ''
+        self.elapsed = elapsed if elapsed is not None else timedelta(0)
+        self.request = SimpleNamespace(
+            method=method,
+            url=self.url,
+            headers=request_headers or {},
+        )
+
+    def json(self):
+        return json.loads(self.text)
+
+
+class Session:
+    """Minimal HTTP session used as the transport for PDSession."""
+
+    headers = None
+
+    def __init__(self):
+        self.headers = {}
+
+    def request(self, method, url, **kwargs) -> Response:
+        method = method.strip().upper()
+        headers = deepcopy(self.headers)
+        headers.update(kwargs.get('headers', {}) or {})
+
+        params = kwargs.get('params')
+        if params:
+            query = urllib.parse.urlencode(params, doseq=True)
+            separator = '&' if '?' in url else '?'
+            url = f"{url}{separator}{query}"
+
+        body = None
+        if 'json' in kwargs:
+            body = json.dumps(kwargs['json']).encode('utf-8')
+            headers.setdefault('Content-Type', 'application/json')
+        elif kwargs.get('data') is not None:
+            data = kwargs['data']
+            if isinstance(data, str):
+                body = data.encode('utf-8')
+            elif isinstance(data, (bytes, bytearray)):
+                body = bytes(data)
+            else:
+                body = urllib.parse.urlencode(data, doseq=True).encode('utf-8')
+
+        req = urllib.request.Request(url, data=body, headers=headers,
+            method=method)
+        start = time.monotonic()
+        try:
+            with urllib.request.urlopen(req, timeout=kwargs.get('timeout')) as r:
+                code = r.getcode()
+                raw = r.read()
+                response_headers = dict(r.headers.items())
+                final_url = r.geturl()
+        except urllib.error.HTTPError as e:
+            code = e.code
+            raw = e.read() if hasattr(e, 'read') else b''
+            response_headers = dict(e.headers.items()) if e.headers else {}
+            final_url = e.geturl() if hasattr(e, 'geturl') else url
+        except (urllib.error.URLError, socket.timeout, TimeoutError, OSError) as e:
+            raise RequestException(str(e)) from e
+        elapsed = timedelta(seconds=time.monotonic() - start)
+        text = raw.decode('utf-8', errors='replace')
+        return Response(code, text, method=method, url=final_url,
+            headers=response_headers, elapsed=elapsed,
+            request_headers=headers)
 
