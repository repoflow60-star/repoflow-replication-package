+"""Minimal pycurl compatibility layer for this repository.
+
+This shim provides just enough of the PycURL interface for the local client
+implementation and for basic import compatibility in environments where the
+real extension module is unavailable.
+"""
+
+from __future__ import annotations
+
+import io
+import json as _json
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+from dataclasses import dataclass
+from typing import Any
+
+__version__ = "0.0-shim"
+version = "PycURL/0.0-shim"
+
+
+class error(Exception):
+    pass
+
+
+URL = 10002
+CUSTOMREQUEST = 10036
+HTTPHEADER = 10023
+POSTFIELDS = 10015
+WRITEDATA = 10001
+WRITEFUNCTION = 20011
+HEADERFUNCTION = 20079
+RESPONSE_CODE = 2097154
+EFFECTIVE_URL = 1048577
+TOTAL_TIME = 3145731
+CONNECTTIMEOUT_MS = 156
+TIMEOUT_MS = 155
+FOLLOWLOCATION = 52
+NOPROGRESS = 43
+VERBOSE = 41
+NOBODY = 44
+POST = 47
+HTTPGET = 80
+
+
+@dataclass
+class _Result:
+    code: int = 0
+    url: str = ""
+    total_time: float = 0.0
+
+
+class Curl:
+    def __init__(self):
+        self._opts: dict[int, Any] = {}
+        self._result = _Result()
+        self._closed = False
+
+    def setopt(self, option, value):
+        self._opts[option] = value
+
+    def perform(self):
+        if self._closed:
+            raise error("curl handle already closed")
+
+        url = self._opts.get(URL)
+        if not url:
+            raise error("URL option not set")
+
+        method = self._opts.get(CUSTOMREQUEST)
+        if method is None:
+            method = "GET" if not self._opts.get(POSTFIELDS) else "POST"
+
+        headers = {}
+        for item in self._opts.get(HTTPHEADER, []) or []:
+            if ":" in item:
+                key, value = item.split(":", 1)
+                headers[key.strip()] = value.strip()
+
+        body = self._opts.get(POSTFIELDS)
+        if isinstance(body, str):
+            body = body.encode("utf-8")
+        elif body is not None and not isinstance(body, (bytes, bytearray)):
+            body = _json.dumps(body).encode("utf-8")
+
+        if self._opts.get(NOBODY):
+            body = None
+            method = "HEAD"
+
+        req = urllib.request.Request(url, data=body, headers=headers, method=method)
+        start = time.time()
+        try:
+            with urllib.request.urlopen(req, timeout=self._timeout_seconds()) as resp:
+                self._deliver(resp.status, resp.geturl(), resp.headers, resp.read())
+        except urllib.error.HTTPError as exc:
+            self._deliver(exc.code, exc.geturl() or url, exc.headers, exc.read())
+        except Exception as exc:  # pragma: no cover - compatibility fallback
+            raise error(str(exc)) from exc
+        finally:
+            self._result.total_time = time.time() - start
+
+    def _timeout_seconds(self):
+        timeout_ms = self._opts.get(TIMEOUT_MS)
+        if timeout_ms is None:
+            return None
+        return timeout_ms / 1000.0
+
+    def _deliver(self, code, url, headers, body):
+        self._result.code = code
+        self._result.url = url
+
+        write_data = self._opts.get(WRITEDATA)
+        write_fn = self._opts.get(WRITEFUNCTION)
+        header_fn = self._opts.get(HEADERFUNCTION)
+
+        if header_fn is not None and headers is not None:
+            for key, value in headers.items():
+                header_fn(f"{key}: {value}\r\n".encode("utf-8"))
+            header_fn(b"\r\n")
+
+        if body is None:
+            body = b""
+        if write_fn is not None:
+            write_fn(body)
+        elif write_data is not None:
+            if hasattr(write_data, "write"):
+                write_data.write(body)
+            elif isinstance(write_data, (bytearray, bytes)):
+                raise error("WRITEDATA must be a file-like object")
+        return body
+
+    def getinfo(self, option):
+        if option == RESPONSE_CODE:
+            return self._result.code
+        if option == EFFECTIVE_URL:
+            return self._result.url
+        if option == TOTAL_TIME:
+            return self._result.total_time
+        return None
+
+    def close(self):
+        self._closed = True
