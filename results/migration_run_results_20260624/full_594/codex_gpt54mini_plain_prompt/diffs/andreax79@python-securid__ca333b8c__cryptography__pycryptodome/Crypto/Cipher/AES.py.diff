+++ b/Crypto/Cipher/AES.py
@@ -0,0 +1,213 @@
+"""Pure-Python AES compatibility layer with the PyCryptodome API subset used here."""
+
+from __future__ import annotations
+
+from typing import Iterable, List
+
+BLOCK_SIZE = 16
+MODE_ECB = 1
+
+
+def _rotl8(value: int, shift: int) -> int:
+    shift &= 7
+    return ((value << shift) | (value >> (8 - shift))) & 0xFF
+
+
+def _gf_mul(a: int, b: int) -> int:
+    result = 0
+    for _ in range(8):
+        if b & 1:
+            result ^= a
+        carry = a & 0x80
+        a = (a << 1) & 0xFF
+        if carry:
+            a ^= 0x1B
+        b >>= 1
+    return result
+
+
+def _gf_pow(a: int, n: int) -> int:
+    result = 1
+    while n:
+        if n & 1:
+            result = _gf_mul(result, a)
+        a = _gf_mul(a, a)
+        n >>= 1
+    return result
+
+
+def _gf_inv(a: int) -> int:
+    return 0 if a == 0 else _gf_pow(a, 254)
+
+
+def _generate_sboxes() -> tuple[list[int], list[int]]:
+    sbox = [0] * 256
+    inv_sbox = [0] * 256
+    for x in range(256):
+        inv = _gf_inv(x)
+        y = inv ^ _rotl8(inv, 1) ^ _rotl8(inv, 2) ^ _rotl8(inv, 3) ^ _rotl8(inv, 4) ^ 0x63
+        sbox[x] = y
+        inv_sbox[y] = x
+    return sbox, inv_sbox
+
+
+SBOX, INV_SBOX = _generate_sboxes()
+
+
+def _bytes_to_state(block: bytes) -> list[int]:
+    return list(block)
+
+
+def _state_to_bytes(state: Iterable[int]) -> bytes:
+    return bytes(state)
+
+
+def _sub_bytes(state: list[int]) -> None:
+    for i, value in enumerate(state):
+        state[i] = SBOX[value]
+
+
+def _inv_sub_bytes(state: list[int]) -> None:
+    for i, value in enumerate(state):
+        state[i] = INV_SBOX[value]
+
+
+def _shift_rows(state: list[int]) -> None:
+    for row in range(1, 4):
+        indices = [row + 4 * col for col in range(4)]
+        values = [state[index] for index in indices]
+        values = values[row:] + values[:row]
+        for index, value in zip(indices, values):
+            state[index] = value
+
+
+def _inv_shift_rows(state: list[int]) -> None:
+    for row in range(1, 4):
+        indices = [row + 4 * col for col in range(4)]
+        values = [state[index] for index in indices]
+        values = values[-row:] + values[:-row]
+        for index, value in zip(indices, values):
+            state[index] = value
+
+
+def _mix_single_column(column: list[int]) -> list[int]:
+    a0, a1, a2, a3 = column
+    return [
+        _gf_mul(a0, 2) ^ _gf_mul(a1, 3) ^ a2 ^ a3,
+        a0 ^ _gf_mul(a1, 2) ^ _gf_mul(a2, 3) ^ a3,
+        a0 ^ a1 ^ _gf_mul(a2, 2) ^ _gf_mul(a3, 3),
+        _gf_mul(a0, 3) ^ a1 ^ a2 ^ _gf_mul(a3, 2),
+    ]
+
+
+def _inv_mix_single_column(column: list[int]) -> list[int]:
+    a0, a1, a2, a3 = column
+    return [
+        _gf_mul(a0, 14) ^ _gf_mul(a1, 11) ^ _gf_mul(a2, 13) ^ _gf_mul(a3, 9),
+        _gf_mul(a0, 9) ^ _gf_mul(a1, 14) ^ _gf_mul(a2, 11) ^ _gf_mul(a3, 13),
+        _gf_mul(a0, 13) ^ _gf_mul(a1, 9) ^ _gf_mul(a2, 14) ^ _gf_mul(a3, 11),
+        _gf_mul(a0, 11) ^ _gf_mul(a1, 13) ^ _gf_mul(a2, 9) ^ _gf_mul(a3, 14),
+    ]
+
+
+def _mix_columns(state: list[int]) -> None:
+    for col in range(4):
+        start = 4 * col
+        state[start : start + 4] = _mix_single_column(state[start : start + 4])
+
+
+def _inv_mix_columns(state: list[int]) -> None:
+    for col in range(4):
+        start = 4 * col
+        state[start : start + 4] = _inv_mix_single_column(state[start : start + 4])
+
+
+def _add_round_key(state: list[int], round_key: bytes) -> None:
+    for i in range(BLOCK_SIZE):
+        state[i] ^= round_key[i]
+
+
+def _rot_word(word: bytes) -> bytes:
+    return word[1:] + word[:1]
+
+
+def _sub_word(word: bytes) -> bytes:
+    return bytes(SBOX[b] for b in word)
+
+
+def _expand_key(key: bytes) -> list[bytes]:
+    key_len = len(key)
+    if key_len not in (16, 24, 32):
+        raise ValueError("Incorrect AES key length")
+
+    nk = key_len // 4
+    nr = nk + 6
+    words: list[bytes] = [key[4 * i : 4 * (i + 1)] for i in range(nk)]
+    rcon = 1
+
+    def next_rcon(value: int) -> int:
+        return ((value << 1) ^ 0x11B) & 0xFF if value & 0x80 else (value << 1) & 0xFF
+
+    for i in range(nk, 4 * (nr + 1)):
+        temp = words[i - 1]
+        if i % nk == 0:
+            temp = bytes(a ^ b for a, b in zip(_sub_word(_rot_word(temp)), bytes([rcon, 0, 0, 0])))
+            rcon = next_rcon(rcon)
+        elif nk > 6 and i % nk == 4:
+            temp = _sub_word(temp)
+        words.append(bytes(a ^ b for a, b in zip(words[i - nk], temp)))
+
+    return [b"".join(words[4 * round_index : 4 * (round_index + 1)]) for round_index in range(nr + 1)]
+
+
+class _AES:
+    def __init__(self, key: bytes, mode: int):
+        if mode != MODE_ECB:
+            raise ValueError("Only ECB mode is supported")
+        self._round_keys = _expand_key(key)
+        self.block_size = BLOCK_SIZE
+
+    def _crypt_block(self, block: bytes, decrypt: bool = False) -> bytes:
+        if len(block) != BLOCK_SIZE:
+            raise ValueError("Data must be aligned to 16 byte blocks")
+
+        state = _bytes_to_state(block)
+        nr = len(self._round_keys) - 1
+
+        if decrypt:
+            _add_round_key(state, self._round_keys[nr])
+            for round_index in range(nr - 1, 0, -1):
+                _inv_shift_rows(state)
+                _inv_sub_bytes(state)
+                _add_round_key(state, self._round_keys[round_index])
+                _inv_mix_columns(state)
+            _inv_shift_rows(state)
+            _inv_sub_bytes(state)
+            _add_round_key(state, self._round_keys[0])
+        else:
+            _add_round_key(state, self._round_keys[0])
+            for round_index in range(1, nr):
+                _sub_bytes(state)
+                _shift_rows(state)
+                _mix_columns(state)
+                _add_round_key(state, self._round_keys[round_index])
+            _sub_bytes(state)
+            _shift_rows(state)
+            _add_round_key(state, self._round_keys[nr])
+
+        return _state_to_bytes(state)
+
+    def encrypt(self, data: bytes) -> bytes:
+        if len(data) % BLOCK_SIZE != 0:
+            raise ValueError("Data must be aligned to 16 byte blocks")
+        return b"".join(self._crypt_block(data[i : i + BLOCK_SIZE], decrypt=False) for i in range(0, len(data), BLOCK_SIZE))
+
+    def decrypt(self, data: bytes) -> bytes:
+        if len(data) % BLOCK_SIZE != 0:
+            raise ValueError("Data must be aligned to 16 byte blocks")
+        return b"".join(self._crypt_block(data[i : i + BLOCK_SIZE], decrypt=True) for i in range(0, len(data), BLOCK_SIZE))
+
+
+def new(key: bytes, mode: int) -> _AES:
+    return _AES(bytes(key), mode)
+
