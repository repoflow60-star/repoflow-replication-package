@@ -0,0 +1,80 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Iterator
+
+import httpx
+
+
+@dataclass
+class SSEEvent:
+    data: str
+
+
+class StreamResponse:
+    def __init__(
+        self,
+        response: httpx.Response,
+        context_manager: Any | None = None,
+    ) -> None:
+        self._response = response
+        self._context_manager = context_manager
+
+    @property
+    def status_code(self) -> int:
+        return self._response.status_code
+
+    def iter_lines(self) -> Iterator[str]:
+        yield from self._response.iter_lines()
+
+    def close(self) -> None:
+        self._response.close()
+        if self._context_manager is not None:
+            self._context_manager.__exit__(None, None, None)
+
+    def __getattr__(self, name: str):
+        return getattr(self._response, name)
+
+
+class _HttpxRequestsShim:
+    Response = StreamResponse
+
+    def post(self, url: str, *, headers=None, json=None, stream: bool = False, **kwargs):
+        if stream:
+            context_manager = httpx.stream(
+                "POST",
+                url,
+                headers=headers,
+                json=json,
+                **kwargs,
+            )
+            response = context_manager.__enter__()
+            return StreamResponse(response=response, context_manager=context_manager)
+        return httpx.post(url, headers=headers, json=json, **kwargs)
+
+
+class SSEClient:
+    def __init__(self, event_source) -> None:
+        self.event_source = event_source
+
+    def events(self):
+        data_lines: list[str] = []
+        try:
+            for raw_line in self.event_source.iter_lines():
+                line = raw_line.decode("utf-8") if isinstance(raw_line, bytes) else raw_line
+                if line == "":
+                    if data_lines:
+                        yield SSEEvent(data="\n".join(data_lines))
+                        data_lines = []
+                    continue
+                if line.startswith("data:"):
+                    data_lines.append(line[5:].lstrip())
+            if data_lines:
+                yield SSEEvent(data="\n".join(data_lines))
+        finally:
+            close = getattr(self.event_source, "close", None)
+            if callable(close):
+                close()
+
+
+requests = _HttpxRequestsShim()
