+import io
+import json
+from wsgiref.simple_server import make_server
+
+
+class _Request:
+    def __init__(self):
+        self.method = "GET"
+        self.path = "/"
+        self.headers = {}
+        self.query = {}
+        self.environ = {}
+        self.body = io.BytesIO()
+
+    @property
+    def json(self):
+        data = self.body.getvalue()
+        if not data:
+            return None
+        return json.loads(data.decode("utf-8"))
+
+
+class _Response:
+    def __init__(self):
+        self.status = 200
+        self.headers = {}
+        self.content_type = "text/html; charset=utf-8"
+
+
+request = _Request()
+response = _Response()
+
+
+class Bottle:
+    def __init__(self):
+        self._routes = []
+        self._after_request_hooks = []
+
+    def route(self, path, method="GET"):
+        methods = method if isinstance(method, (list, tuple, set)) else [method]
+
+        def decorator(func):
+            for item in methods:
+                self._routes.append((item.upper(), path, func))
+            return func
+
+        return decorator
+
+    def get(self, path):
+        return self.route(path, "GET")
+
+    def post(self, path):
+        return self.route(path, "POST")
+
+    def options(self, path):
+        return self.route(path, "OPTIONS")
+
+    def hook(self, name):
+        def decorator(func):
+            if name == "after_request":
+                self._after_request_hooks.append(func)
+            return func
+
+        return decorator
+
+    def _find_route(self, method, path):
+        for route_method, route_path, func in self._routes:
+            if route_method == method and route_path == path:
+                return func
+        return None
+
+    def _bind_request(self, environ):
+        request.method = environ.get("REQUEST_METHOD", "GET").upper()
+        request.path = environ.get("PATH_INFO", "/")
+        request.environ = environ
+        request.headers = {}
+        request.query = {}
+        request.body = io.BytesIO(environ.get("wsgi.input", io.BytesIO()).read())
+        request.body.seek(0)
+        response.status = 200
+        response.headers = {}
+        response.content_type = "text/html; charset=utf-8"
+
+    def _build_response(self, start_response, payload):
+        status = f"{response.status} OK"
+        headers = dict(response.headers)
+        headers.setdefault("Content-Type", response.content_type)
+        body = payload
+        if body is None:
+            body = b""
+        elif isinstance(body, str):
+            body = body.encode("utf-8")
+        elif isinstance(body, (dict, list)):
+            body = json.dumps(body).encode("utf-8")
+        elif not isinstance(body, (bytes, bytearray)):
+            body = str(body).encode("utf-8")
+        headers.setdefault("Content-Length", str(len(body)))
+        start_response(status, list(headers.items()))
+        return [body]
+
+    def __call__(self, environ, start_response):
+        self._bind_request(environ)
+        func = self._find_route(request.method, request.path)
+        if func is None:
+            return self._build_response(start_response, b"Not Found")
+        payload = func()
+        for hook in self._after_request_hooks:
+            hook()
+        return self._build_response(start_response, payload)
+
+    def run(self, host="127.0.0.1", port=8080, **kwargs):
+        server = make_server(host, port, self)
+        server.serve_forever()
