@@ -0,0 +1,72 @@
+import io
+import json
+from dataclasses import dataclass, field
+from typing import Iterable, Iterator
+
+import pycurl
+
+
+@dataclass
+class CurlResponse:
+    """Minimal streaming response wrapper backed by pycurl."""
+
+    status_code: int = 0
+    headers: dict[str, str] = field(default_factory=dict)
+    _chunks: list[bytes] = field(default_factory=list, repr=False)
+
+    def append_chunk(self, chunk: bytes) -> int:
+        if chunk:
+            self._chunks.append(chunk)
+        return len(chunk)
+
+    def __iter__(self) -> Iterator[bytes]:
+        return iter(self._chunks)
+
+    def iter_content(self, chunk_size: int = 1) -> Iterator[bytes]:
+        # chunk_size is accepted for requests compatibility, but the stream is
+        # already collected in transport-sized chunks by pycurl.
+        del chunk_size
+        return iter(self._chunks)
+
+    def close(self) -> None:
+        return None
+
+
+def _format_headers(headers: dict[str, str]) -> list[str]:
+    return [f"{key}: {value}" for key, value in headers.items()]
+
+
+def post_json(url: str, headers: dict[str, str], data: dict) -> CurlResponse:
+    response = CurlResponse()
+    payload = json.dumps(data).encode("utf-8")
+    header_buffer = io.BytesIO()
+
+    def write_callback(chunk: bytes) -> int:
+        return response.append_chunk(chunk)
+
+    def header_callback(chunk: bytes) -> int:
+        header_buffer.write(chunk)
+        return len(chunk)
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.POST, 1)
+        curl.setopt(pycurl.POSTFIELDS, payload)
+        curl.setopt(pycurl.POSTFIELDSIZE, len(payload))
+        curl.setopt(pycurl.HTTPHEADER, _format_headers(headers))
+        curl.setopt(pycurl.WRITEFUNCTION, write_callback)
+        curl.setopt(pycurl.HEADERFUNCTION, header_callback)
+        curl.setopt(pycurl.NOSIGNAL, 1)
+        curl.perform()
+        response.status_code = int(curl.getinfo(pycurl.RESPONSE_CODE))
+        for raw_header in header_buffer.getvalue().splitlines():
+            if b":" not in raw_header:
+                continue
+            key, value = raw_header.split(b":", 1)
+            response.headers[key.decode("utf-8").strip().lower()] = (
+                value.decode("utf-8").strip()
+            )
+        return response
+    finally:
+        curl.close()
