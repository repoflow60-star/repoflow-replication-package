+class _SessionCompat:
+    """Minimal session-like object for headers and mounted request adapters."""
+
+    def __init__(self):
+        self.headers = {}
+        self.adapters = {}
+
+    def mount(self, prefix, adapter):
+        self.adapters[prefix] = adapter
+
+    def adapter_for(self, url):
+        for prefix in sorted(self.adapters, key=len, reverse=True):
+            if url.startswith(prefix):
+                return self.adapters[prefix]
+        return None
+
+
+_REACTOR_THREAD = None
+_REACTOR_READY = Event()
+
+
+def _run_blocking(factory):
+    """Run a Deferred-returning callable in a background Twisted reactor."""
+    reactor = _get_reactor()
+    from twisted.internet.threads import blockingCallFromThread
+
+    return blockingCallFromThread(reactor, factory, reactor)
+
+
+def _get_reactor():
+    """Start a reactor thread on demand and return the reactor instance."""
+    global _REACTOR_THREAD
+    if _REACTOR_THREAD is not None:
+        from twisted.internet import reactor
+        return reactor
+
+    from twisted.internet import reactor
+
+    def _run():
+        _REACTOR_READY.set()
+        reactor.run(installSignalHandlers=False)
+
+    _REACTOR_THREAD = Thread(target=_run, daemon=True)
+    _REACTOR_THREAD.start()
+    _REACTOR_READY.wait()
+    return reactor
