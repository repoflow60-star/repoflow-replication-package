+    def _request_json_with_requests(self, method, url, payload, headers):
+        """Use requests_mock-compatible adapters for tests."""
+        import requests
+
+        logger.debug("%s %s", method, url)
+        request_session = requests.Session()
+        request_session.headers.update(self.session.headers)
+        if headers:
+            request_session.headers.update(headers)
+        for prefix, mounted_adapter in self.session.adapters.items():
+            request_session.mount(prefix, mounted_adapter)
+        data = json.dumps(payload) if payload is not None else None
+        response = request_session.request(method, url, data=data, headers=headers)
+        return self._decode_api_response(response.text)
+
+    def _request_json_with_treq(self, method, url, payload, headers):
+        """Use treq for the real HTTP transport."""
+        logger.debug("%s %s", method, url)
+
+        def _do_request(_reactor):
+            import treq
+
+            request_headers = dict(self.session.headers)
+            if headers:
+                request_headers.update(headers)
+            body = None
+            if payload is not None:
+                body = json.dumps(payload).encode("utf-8")
+            request = treq.request(
+                method,
+                url,
+                headers=request_headers,
+                data=body,
             )
+            request.addCallback(treq.content)
+            request.addCallback(self._decode_api_response)
+            return request
+
+        return _run_blocking(_do_request)
+
+    def _decode_api_response(self, body):
+        """Decode and validate API JSON responses."""
+        try:
+            result = json.loads(body)
+        except json.decoder.JSONDecodeError as exc:
+            raise errors.PluginError("no JSON in API response") from exc
+        if result["result"] == "success":
+            return result["data"]
+        if result["error"]["code"] == "not_authorized":
+            raise errors.PluginError("cannot authenticate")
+        raise errors.PluginError(
+            "error in API request: {} / {}".format(
+                result["error"]["code"], result["error"]["description"]
+            )
+        )
+
+    def _build_url(self, url, payload=None):
+        """Build a request URL, preserving existing query parameters."""
+        full_url = self.baseUrl + url
+        if not payload:
+            return full_url
+        parts = urlsplit(full_url)
+        query = parse_qsl(parts.query, keep_blank_values=True)
+        query.extend(payload.items())
+        return urlunsplit(
+            (parts.scheme, parts.netloc, parts.path, urlencode(query, doseq=True), parts.fragment)
+        )
 
