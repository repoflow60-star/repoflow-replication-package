+++ b/sitecustomize.py
@@ -0,0 +1,14 @@
+"""Ensure the local src layout takes precedence over any preinstalled copy."""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent
+SRC = ROOT / "src"
+
+if SRC.is_dir():
+    src_path = str(SRC)
+    if src_path not in sys.path:
+        sys.path.insert(0, src_path)
