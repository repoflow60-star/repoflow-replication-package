+"""Compatibility layer backed by urllib3.
+
+This module provides a small subset of the ``requests`` API that the project
+uses, but all network traffic is performed by urllib3.
+"""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+from types import SimpleNamespace
+from typing import Any, Mapping
+from urllib.parse import urlencode, urlsplit, urlunsplit
+
+import urllib3
+from urllib3.exceptions import (
+    ConnectTimeoutError,
+    HTTPError as Urllib3HTTPError,
+    MaxRetryError,
+    ReadTimeoutError,
+)
+
+
+class RequestException(Exception):
+    """Base exception for compatibility with requests."""
+
+
+class HTTPError(RequestException):
+    """Raised when an HTTP response returns a failing status code."""
+
+    def __init__(self, message: str = "", response: "Response | None" = None):
+        super().__init__(message)
+        self.response = response
+
+
+class Timeout(RequestException):
+    """Raised when a request times out."""
+
+
+exceptions = SimpleNamespace(
+    RequestException=RequestException,
+    HTTPError=HTTPError,
+    Timeout=Timeout,
+)
+
+
+def _build_url(url: str, params: Mapping[str, Any] | None) -> str:
+    if not params:
+        return url
+
+    split = urlsplit(url)
+    query = split.query
+    encoded = urlencode(params, doseq=True)
+    if query:
+        query = f"{query}&{encoded}"
+    else:
+        query = encoded
+    return urlunsplit((split.scheme, split.netloc, split.path, query, split.fragment))
+
+
+def _encode_form(data: Any) -> tuple[bytes | None, dict[str, str]]:
+    if data is None:
+        return None, {}
+    if isinstance(data, (bytes, bytearray)):
+        return bytes(data), {}
+    if isinstance(data, str):
+        return data.encode(), {}
+    if isinstance(data, Mapping):
+        return urlencode(data, doseq=True).encode(), {
+            "Content-Type": "application/x-www-form-urlencoded",
+        }
+    return str(data).encode(), {}
+
+
+@dataclass
+class Response:
+    _response: urllib3.HTTPResponse
+
+    @property
+    def status_code(self) -> int:
+        return self._response.status
+
+    @property
+    def text(self) -> str:
+        data = self._response.data or b""
+        return data.decode("utf-8", errors="replace")
+
+    @property
+    def content(self) -> bytes:
+        return self._response.data or b""
+
+    @property
+    def headers(self) -> dict[str, str]:
+        return dict(self._response.headers.items())
+
+    def json(self) -> Any:
+        return json.loads(self.text)
+
+    def raise_for_status(self) -> None:
+        if 400 <= self.status_code:
+            reason = getattr(self._response, "reason", "") or ""
+            message = f"{self.status_code} Client Error: {reason}".strip()
+            raise HTTPError(message, response=self)
+
+
+_pool = urllib3.PoolManager()
+
+
+def request(
+    method: str,
+    url: str,
+    *,
+    params: Mapping[str, Any] | None = None,
+    data: Any = None,
+    headers: Mapping[str, str] | None = None,
+    timeout: float | urllib3.util.Timeout | None = None,
+    **kwargs: Any,
+) -> Response:
+    full_url = _build_url(url, params)
+    body, form_headers = _encode_form(data)
+    merged_headers: dict[str, str] = {}
+    if headers:
+        merged_headers.update(headers)
+    merged_headers.update(form_headers)
+
+    try:
+        response = _pool.request(
+            method,
+            full_url,
+            body=body,
+            headers=merged_headers or None,
+            timeout=timeout,
+            **kwargs,
+        )
+    except (ReadTimeoutError, ConnectTimeoutError, MaxRetryError) as exc:
+        raise Timeout(str(exc)) from exc
+    except Urllib3HTTPError as exc:
+        raise RequestException(str(exc)) from exc
+
+    return Response(response)
+
+
+def get(url: str, **kwargs: Any) -> Response:
+    return request("GET", url, **kwargs)
+
+
+def post(url: str, **kwargs: Any) -> Response:
+    return request("POST", url, **kwargs)
