+''' Minimal Template implementation compatible with the project usage. '''
+
+import re
+
+
+_TEMPLATE_VAR_PATTERN = re.compile(r"\$\{([^}]+)\}")
+
+
+class Template:
+    ''' Render ${expression} placeholders using keyword arguments. '''
+
+    def __init__(self, text):
+        self.text = text
+
+    def render(self, **kwargs):
+        ''' Render the template with the provided keyword arguments. '''
+
+        def replace(match):
+            expression = match.group(1).strip()
+            return str(eval(expression, {"__builtins__": {}}, kwargs))
+
+        return _TEMPLATE_VAR_PATTERN.sub(replace, self.text)
+
