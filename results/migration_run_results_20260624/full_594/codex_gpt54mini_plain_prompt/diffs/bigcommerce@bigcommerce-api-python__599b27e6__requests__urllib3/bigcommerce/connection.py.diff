+class Urllib3Response(object):
+    def __init__(self, response):
+        self.status_code = response.status
+        self.headers = dict(response.headers)
+        self.content = response.data or b""
+        self.reason = response.reason.decode("utf-8") if isinstance(response.reason, bytes) else response.reason
+
+    def json(self):
+        payload = self.content
+        if isinstance(payload, bytes):
+            payload = payload.decode("utf-8")
+        return loads(payload)
+
+
+class Urllib3Session(object):
+    def __init__(self):
+        self.auth = None
+        self.headers = {}
+        self._http = urllib3.PoolManager()
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        if self.auth and "Authorization" not in request_headers and "authorization" not in request_headers:
+            username, password = self.auth
+            encoded = base64.b64encode(("%s:%s" % (username, password)).encode("utf-8")).decode("ascii")
+            request_headers["Authorization"] = "Basic %s" % encoded
+
+        body = data
+        content_type = request_headers.get("Content-Type") or request_headers.get("content-type")
+        if isinstance(data, dict):
+            if content_type == "application/x-www-form-urlencoded":
+                body = urlencode(data)
+            else:
+                body = dumps(data)
+                request_headers.setdefault("Content-Type", "application/json")
+        if isinstance(body, str):
+            body = body.encode("utf-8")
+
+        response = self._http.request(method, url, body=body, timeout=timeout, headers=request_headers)
+        return Urllib3Response(response)
+
+
