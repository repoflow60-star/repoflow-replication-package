+from __future__ import (
+    absolute_import,
+    division,
+    print_function,
+    unicode_literals,
+)
+
+from io import BytesIO
+from urllib.error import HTTPError, URLError
+from urllib.request import Request, urlopen
+
+from .exceptions import ConnectionError, RequestException
+
+
+class Response(object):
+    def __init__(self, content=b'', status_code=200):
+        self.content = content
+        self.status_code = status_code
+
+    def raise_for_status(self):
+        if 400 <= self.status_code:
+            raise RequestException(
+                'HTTP {} error'.format(self.status_code)
+            )
+
+
+class Session(object):
+    def __init__(self):
+        self.headers = {}
+
+    def get(self, url):
+        try:
+            import pycurl
+        except ImportError:
+            return self._get_urllib(url)
+
+        buffer = BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEFUNCTION, buffer.write)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.CONNECTTIMEOUT, 10)
+            curl.setopt(pycurl.TIMEOUT, 30)
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                [
+                    '{}: {}'.format(name, value)
+                    for name, value in self.headers.items()
+                ],
+            )
+            curl.perform()
+            status_code = int(curl.getinfo(pycurl.RESPONSE_CODE))
+        except pycurl.error as e:
+            raise ConnectionError(str(e))
+        finally:
+            curl.close()
+        return Response(buffer.getvalue(), status_code=status_code)
+
+    def _get_urllib(self, url):
+        request = Request(url, headers=self.headers)
+        try:
+            with urlopen(request, timeout=30) as response:
+                return Response(
+                    response.read(), status_code=getattr(response, 'status', 200)
+                )
+        except HTTPError as e:
+            return Response(e.read(), status_code=e.code)
+        except URLError as e:
+            raise ConnectionError(str(e))
