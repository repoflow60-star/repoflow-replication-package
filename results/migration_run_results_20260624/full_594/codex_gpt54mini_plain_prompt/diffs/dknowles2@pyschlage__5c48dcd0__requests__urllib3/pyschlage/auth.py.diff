+def _merge_query_params(url: str, params: object) -> str:
+    """Adds query parameters to a URL."""
+    if not params:
+        return url
+
+    split_url = urlsplit(url)
+    existing_query = split_url.query
+    if hasattr(params, "items"):
+        new_query = urlencode(params, doseq=True)
+    else:
+        new_query = urlencode(list(params), doseq=True)
+    query = "&".join(part for part in [existing_query, new_query] if part)
+    return urlunsplit(
+        (
+            split_url.scheme,
+            split_url.netloc,
+            split_url.path,
+            query,
+            split_url.fragment,
+        )
+    )
+
+
+def _serialize_body(
+    kwargs: dict[str, object],
+) -> tuple[bytes | str | None, str | None]:
+    """Serializes request payload kwargs into urllib3-friendly values."""
+    json_payload = kwargs.pop("json", None)
+    if json_payload is not None:
+        import json as _json
+
+        body = _json.dumps(json_payload).encode("utf-8")
+        return body, "application/json"
+
+    body = kwargs.pop("body", None)
+    if body is not None:
+        return body, None
+
+    data = kwargs.pop("data", None)
+    if data is None:
+        return None, None
+    if isinstance(data, (bytes, bytearray, str)):
+        return data, None
+    if hasattr(data, "items") or isinstance(data, (list, tuple)):
+        return urlencode(data, doseq=True).encode("utf-8"), "application/x-www-form-urlencoded"
+    return data, None  # type: ignore[return-value]
+
+
+def _http_error_message(resp: HTTPResponse) -> str:
+    """Extracts the best error message from a failed response."""
+    try:
+        payload = resp.json()
+    except ValueError:
+        return str(resp.reason)
+
+    if isinstance(payload, dict):
+        return str(payload.get("message", resp.reason))
+    return str(resp.reason)
 
 
