+"""Cookie helpers compatible with the subset used by internetarchive."""
+
+
+from http.cookiejar import Cookie
+
+
+def create_cookie(
+    name,
+    value,
+    domain="",
+    path="/",
+    secure=False,
+    expires=None,
+    rest=None,
+):
+    return Cookie(
+        version=0,
+        name=name,
+        value=value,
+        port=None,
+        port_specified=False,
+        domain=domain,
+        domain_specified=bool(domain),
+        domain_initial_dot=domain.startswith("."),
+        path=path,
+        path_specified=True,
+        secure=secure,
+        expires=expires,
+        discard=expires is None,
+        comment=None,
+        comment_url=None,
+        rest=rest or {},
+        rfc2109=False,
+    )
+
