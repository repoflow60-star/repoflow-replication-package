+'''
+Compatibility shim for the legacy ``requests`` test seam.
+
+The production code now uses ``httpx`` directly, but the existing test suite
+still patches ``requests.Session.get``. Keeping ``Session`` as an alias to the
+httpx client makes that patch affect the real client class.
+'''
+
+from __future__ import (
+    absolute_import,
+    division,
+    print_function,
+    unicode_literals,
+)
+
+from httpx import Client as Session
+from httpx import ConnectError
+
+__all__ = ('Session', 'ConnectError')
