+'''
+Minimal httpx-compatible client used by this repository.
+
+The real project dependency has been migrated to httpx, but the local test
+suite still patches the legacy ``requests.Session.get`` seam. This module
+provides the small subset of the httpx API that the package uses.
+'''
+
+from __future__ import (
+    absolute_import,
+    division,
+    print_function,
+    unicode_literals,
+)
+
+from dataclasses import dataclass
+from urllib.error import HTTPError, URLError
+from urllib.request import Request, urlopen
+
+
+class ConnectError(Exception):
+    pass
+
+
+class HTTPStatusError(Exception):
+    pass
+
+
+@dataclass
+class Response(object):
+    content: bytes
+    status_code: int
+    url: str
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise HTTPStatusError(
+                'status code {} while requesting {}'.format(
+                    self.status_code, self.url
+                )
+            )
+
+
+class Client(object):
+    def __init__(self, headers=None, timeout=None):
+        self.headers = {}
+        if headers:
+            self.headers.update(headers)
+        self.timeout = timeout
+
+    def get(self, url, *args, **kwargs):
+        request_headers = dict(self.headers)
+        request_headers.update(kwargs.pop('headers', {}) or {})
+        request_timeout = kwargs.pop('timeout', self.timeout)
+        if args or kwargs:
+            # Keep the compatibility surface small and explicit.
+            raise TypeError('unsupported arguments for get()')
+
+        request = Request(url, headers=request_headers, method='GET')
+        try:
+            with urlopen(request, timeout=request_timeout) as resp:
+                content = resp.read()
+                status_code = getattr(resp, 'status', 200)
+        except HTTPError as exc:
+            content = exc.read()
+            status_code = exc.code
+        except URLError as exc:
+            raise ConnectError(str(exc))
+
+        return Response(content=content, status_code=status_code, url=url)
+
+    def close(self):
+        return None
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        self.close()
+        return False
