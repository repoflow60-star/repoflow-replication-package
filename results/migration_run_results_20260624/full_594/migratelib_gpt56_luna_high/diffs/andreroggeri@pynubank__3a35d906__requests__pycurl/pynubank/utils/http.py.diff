+    def _request(self, url: str, json_data: dict = None) -> Response:
+        response_buffer = BytesIO()
+        curl = pycurl.Curl()
+        cert_file = None
+
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                [f'{name}: {value}' for name, value in self._headers.items()],
+            )
+            curl.setopt(pycurl.WRITEDATA, response_buffer)
+
+            if json_data is None:
+                curl.setopt(pycurl.HTTPGET, 1)
+            else:
+                curl.setopt(pycurl.POST, 1)
+                curl.setopt(pycurl.POSTFIELDS, json.dumps(json_data).encode('utf-8'))
+
+            cert_args = self._cert_args
+            if cert_args:
+                cert_file = tempfile.NamedTemporaryFile(delete=False)
+                cert_file.write(cert_args['pkcs12_data'])
+                cert_file.close()
+
+                curl.setopt(pycurl.SSLCERT, cert_file.name)
+                curl.setopt(pycurl.SSLCERTTYPE, 'P12')
+                curl.setopt(pycurl.KEYPASSWD, cert_args['pkcs12_password'])
+
+            curl.perform()
+
+            return Response(
+                curl.getinfo(pycurl.RESPONSE_CODE),
+                response_buffer.getvalue(),
+            )
+        finally:
+            curl.close()
+
+            if cert_file:
+                os.unlink(cert_file.name)
+
