+
+
+class _Response:
+    def __init__(self, status_code, content, reason):
+        self.status_code = status_code
+        self.content = content
+        self.reason = reason
+
+    @property
+    def text(self):
+        return self.content.decode("utf-8")
+
+    def json(self):
+        return json.loads(self.content.decode("utf-8"))
+
+    def raise_for_status(self):
+        if 400 <= self.status_code:
+            raise RuntimeError(
+                f"HTTP error {self.status_code}: {self.reason}"
+            )
+
+
+def _request(
+        method,
+        url,
+        headers=None,
+        data=None,
+        json_data=None,
+        timeout=None,
+        write_function=None):
+    if json_data is not None:
+        data = json.dumps(json_data).encode("utf-8")
+
+    response_buffer = io.BytesIO()
+    reason = [""]
+
+    def header_function(header_line):
+        header_line = header_line.decode("iso-8859-1").strip()
+        if header_line.startswith("HTTP/"):
+            header_parts = header_line.split(" ", 2)
+            if len(header_parts) == 3:
+                reason[0] = header_parts[2]
+        return len(header_line)
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.HEADERFUNCTION, header_function)
+
+        if headers:
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                [f"{key}: {value}" for key, value in headers.items()]
+            )
+
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT, timeout)
+
+        if method == "POST":
+            curl.setopt(pycurl.POST, 1)
+            if data is not None:
+                curl.setopt(pycurl.POSTFIELDS, data)
+        else:
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            if data is not None:
+                curl.setopt(pycurl.POSTFIELDS, data)
+
+        if write_function is not None:
+            curl.setopt(pycurl.WRITEFUNCTION, write_function)
+        else:
+            curl.setopt(pycurl.WRITEFUNCTION, response_buffer.write)
+
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+
+    return _Response(
+        status_code,
+        response_buffer.getvalue(),
+        reason[0]
+    )
+
 
