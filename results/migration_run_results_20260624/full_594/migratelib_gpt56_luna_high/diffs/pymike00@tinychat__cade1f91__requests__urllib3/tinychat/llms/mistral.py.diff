+class _SSEEventSource:
+    def __init__(self, response) -> None:
+        self._response = response
+
+    def iter_lines(
+        self, chunk_size: int = 1024, decode_unicode: bool = False
+    ):
+        pending = b""
+        for chunk in self._response.stream(
+            amt=chunk_size, decode_content=True
+        ):
+            lines = (pending + chunk).split(b"\n")
+            pending = lines.pop()
+            for line in lines:
+                line = line.rstrip(b"\r")
+                if decode_unicode:
+                    yield line.decode("utf-8")
+                else:
+                    yield line
+
+        if pending:
+            pending = pending.rstrip(b"\r")
+            if decode_unicode:
+                yield pending.decode("utf-8")
+            else:
+                yield pending
 
 
