+                curl.setopt(pycurl.TIMEOUT, kwargs["timeout"])
+
+            if "connect_timeout" in kwargs and kwargs["connect_timeout"] is not None:
+                curl.setopt(pycurl.CONNECTTIMEOUT, kwargs["connect_timeout"])
+
+            auth = kwargs.get("auth")
+            if auth is not None:
+                if isinstance(auth, (tuple, list)):
+                    auth = "%s:%s" % (auth[0], auth[1])
+                curl.setopt(pycurl.USERPWD, auth)
+
+            proxies = kwargs.get("proxies")
+            if proxies:
+                if isinstance(proxies, dict):
+                    if target.lower().startswith("https://"):
+                        proxy = proxies.get("https", proxies.get("all"))
+                    else:
