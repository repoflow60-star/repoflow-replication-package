+class _AiohttpResponse:
+    def __init__(self, status, headers, data):
+        self.status = status
+        self.headers = headers
+        self.data = data
+        self._position = 0
+
+    def read(self, amt=None):
+        if amt is None:
+            data = self.data[self._position :]
+            self._position = len(self.data)
+            return data
+
+        data = self.data[self._position : self._position + amt]
+        self._position += len(data)
+        return data
+
+    def getheaders(self):
+        return self.headers
+
+    def close(self):
+        pass
+
+
+class _AiohttpHTTPClient:
+    def __init__(self, http_proxy=None, **kwargs):
+        self._http_proxy = http_proxy
+        self._proxy_auth = kwargs.pop("proxy_auth", None)
+
+        timeout = kwargs.pop("timeout", 60)
+        if isinstance(timeout, aiohttp.ClientTimeout):
+            self._timeout = timeout
+        else:
+            self._timeout = aiohttp.ClientTimeout(total=timeout)
+
+        ca_certs = kwargs.pop("ca_certs", None)
+        cert_reqs = kwargs.pop("cert_reqs", None)
+
+        if ca_certs is not None:
+            self._ssl = ssl.create_default_context(cafile=ca_certs)
+        elif cert_reqs == ssl.CERT_NONE:
+            self._ssl = False
+        else:
+            self._ssl = ssl.create_default_context()
+
+    async def _request(self, method, url, fields=None, body=None, headers=None):
+        connector = aiohttp.TCPConnector(ssl=self._ssl)
+
+        request_kwargs = {
+            "headers": headers,
+            "timeout": self._timeout,
+        }
+
+        if self._http_proxy is not None:
+            request_kwargs["proxy"] = self._http_proxy
+            if self._proxy_auth is not None:
+                request_kwargs["proxy_auth"] = self._proxy_auth
+
+        if body is None:
+            if method in ("GET", "DELETE") and fields is not None:
+                request_kwargs["params"] = fields
+            elif fields is not None:
+                request_kwargs["data"] = fields
+        else:
+            request_kwargs["data"] = body
+
+        async with aiohttp.ClientSession(
+            connector=connector, auto_decompress=True
+        ) as session:
+            async with session.request(method, url, **request_kwargs) as response:
+                data = await response.read()
+                return _AiohttpResponse(
+                    response.status, dict(response.headers), data
+                )
+
+    def request(self, method, url, fields=None, body=None, headers=None, **kwargs):
+        return asyncio.run(
+            self._request(
+                method,
+                url,
+                fields=fields,
+                body=body,
+                headers=headers,
+            )
+        )
+
+    def close(self):
+        pass
+
+
