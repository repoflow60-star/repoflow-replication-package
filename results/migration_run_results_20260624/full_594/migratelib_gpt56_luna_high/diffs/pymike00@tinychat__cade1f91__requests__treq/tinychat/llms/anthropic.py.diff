+class _SSEEvent:
+    def __init__(self, data: str) -> None:
+        self.data = data
+
+
+class _SSEProtocol(Protocol):
+    def __init__(self, event_queue: DeferredQueue) -> None:
+        self._event_queue = event_queue
+        self._buffer = b""
+        self._data = []
+
+    def dataReceived(self, data: bytes) -> None:
+        self._buffer += data
+        while b"\n" in self._buffer:
+            line, self._buffer = self._buffer.split(b"\n", 1)
+            self._process_line(line.rstrip(b"\r"))
+
+    def _process_line(self, line: bytes) -> None:
+        if line == b"":
+            if self._data:
+                self._event_queue.put(
+                    _SSEEvent(data="\n".join(self._data))
+                )
+                self._data = []
+        elif line.startswith(b"data:"):
+            data = line[5:]
+            if data.startswith(b" "):
+                data = data[1:]
+            self._data.append(data.decode("utf-8"))
+
+    def connectionLost(self, reason) -> None:
+        if self._buffer:
+            self._process_line(self._buffer.rstrip(b"\r"))
+        if self._data:
+            self._event_queue.put(
+                _SSEEvent(data="\n".join(self._data))
+            )
+        self._event_queue.put(None)
+
+
+class _TreqSSEClient:
+    def __init__(self, response) -> None:
+        self._event_queue = DeferredQueue()
+        response.deliverBody(_SSEProtocol(self._event_queue))
+
+    async def events(self):
+        while True:
+            event = await self._event_queue.get()
+            if event is None:
+                break
+            yield event
 
 
