+class _TreqStreamProtocol(Protocol):
+    def __init__(self) -> None:
+        self._chunks = deque()
+        self._waiters = deque()
+        self._finished = False
+        self._failure = None
+
+    def dataReceived(self, data: bytes) -> None:
+        if self._waiters:
+            self._waiters.popleft().callback(data)
+        else:
+            self._chunks.append(data)
+
+    def connectionLost(self, reason) -> None:
+        self._finished = True
+        if not reason.check(ResponseDone):
+            self._failure = reason
+
+        while self._waiters:
+            waiter = self._waiters.popleft()
+            if self._failure is None:
+                waiter.callback(None)
+            else:
+                waiter.errback(self._failure)
+
+    def next_chunk(self) -> Deferred:
+        if self._chunks:
+            return succeed(self._chunks.popleft())
+
+        if self._finished:
+            if self._failure is None:
+                return succeed(None)
+            return fail(self._failure)
+
+        deferred = Deferred()
+        self._waiters.append(deferred)
+        return deferred
+
+
+class _TreqSSEEvent:
+    def __init__(self, data: str) -> None:
+        self.data = data
+
+
+class _TreqSSEClient:
+    def __init__(self, response) -> None:
+        self._response = response
+
+    async def events(self):
+        protocol = _TreqStreamProtocol()
+        self._response.deliverBody(protocol)
+
+        buffer = ""
+
+        while True:
+            chunk = await protocol.next_chunk()
+            if chunk is None:
+                break
+
+            buffer += chunk.decode("utf-8")
+
+            while True:
+                match = re.search(r"\r\n\r\n|\n\n|\r\r", buffer)
+                if match is None:
+                    break
+
+                event = buffer[: match.start()]
+                buffer = buffer[match.end() :]
+
+                data_lines = []
+                for line in event.splitlines():
+                    if line.startswith("data:"):
+                        data_lines.append(line[5:].lstrip(" "))
+
+                event_data = "\n".join(data_lines)
+                if event_data:
+                    yield _TreqSSEEvent(event_data)
+
+        if buffer:
+            data_lines = []
+            for line in buffer.splitlines():
+                if line.startswith("data:"):
+                    data_lines.append(line[5:].lstrip(" "))
+
+            event_data = "\n".join(data_lines)
+            if event_data:
+                yield _TreqSSEEvent(event_data)
 
 
