+class _SSEEvent:
+    def __init__(self, data: str) -> None:
+        self.data = data
+
+
+class _SSEProtocol(Protocol):
+    def __init__(self, events: DeferredQueue) -> None:
+        self._events = events
+        self._buffer = b""
+        self._data = []
+
+    def dataReceived(self, data: bytes) -> None:
+        self._buffer += data
+        lines = self._buffer.split(b"\n")
+        self._buffer = lines.pop()
+
+        for line in lines:
+            self._process_line(line.rstrip(b"\r"))
+
+    def connectionLost(self, reason) -> None:
+        if self._buffer:
+            self._process_line(self._buffer.rstrip(b"\r"))
+        self._emit_event()
+        self._events.put(None)
+
+    def _process_line(self, line: bytes) -> None:
+        if line == b"":
+            self._emit_event()
+        elif line.startswith(b"data:"):
+            self._data.append(line[5:].lstrip())
+
+    def _emit_event(self) -> None:
+        if self._data:
+            data = b"\n".join(self._data).decode("utf-8")
+            self._events.put(_SSEEvent(data))
+            self._data = []
+
+
+class _SSEStream:
+    def __init__(self, events: DeferredQueue) -> None:
+        self._events = events
+
+    async def events(self):
+        while True:
+            event = await self._events.get()
+            if event is None:
+                break
+            yield event
 
 
