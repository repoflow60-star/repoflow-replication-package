 from tinychat.llms.base import BaseLLMClient
 from tinychat.settings import OPENAI_API_KEY_NAME
+
+
+class _SSEEvent:
+    def __init__(self, data: str) -> None:
+        self.data = data
+
+
+class _SSEProtocol(Protocol):
+    def __init__(self) -> None:
+        self._buffer = b""
+        self.event_queue = DeferredQueue()
+
+    def dataReceived(self, data: bytes) -> None:
+        self._buffer += data
+        self._buffer = self._buffer.replace(b"\r\n", b"\n")
+
+        while b"\n\n" in self._buffer:
+            event_data, self._buffer = self._buffer.split(b"\n\n", 1)
+            self._queue_event(event_data)
+
+    def connectionLost(self, reason) -> None:
+        if self._buffer:
+            self._queue_event(self._buffer)
+        self.event_queue.put(None)
+
+    def _queue_event(self, event_data: bytes) -> None:
+        data_lines = []
+
+        for line in event_data.decode("utf-8").split("\n"):
+            if line.startswith("data:"):
+                value = line[5:]
+                if value.startswith(" "):
+                    value = value[1:]
+                data_lines.append(value)
+
+        if data_lines:
+            self.event_queue.put(_SSEEvent("\n".join(data_lines)))
 
 
