+class _SSEEvent:
+    def __init__(self, data: str) -> None:
+        self.data = data
+
+
+class _SSEProtocol(Protocol):
+    def __init__(self, queue: DeferredQueue) -> None:
+        self._queue = queue
+        self._buffer = ""
+        self._data = []
+
+    def dataReceived(self, data: bytes) -> None:
+        self._buffer += data.decode("utf-8")
+        lines = self._buffer.split("\n")
+        self._buffer = lines.pop()
+
+        for line in lines:
+            self._process_line(line.rstrip("\r"))
+
+    def _process_line(self, line: str) -> None:
+        if line == "":
+            self._emit_event()
+        elif line.startswith("data:"):
+            self._data.append(line[5:].lstrip())
+
+    def _emit_event(self) -> None:
+        if self._data:
+            self._queue.put(_SSEEvent("\n".join(self._data)))
+            self._data = []
+
+    def connectionLost(self, reason) -> None:
+        if self._buffer:
+            self._process_line(self._buffer.rstrip("\r"))
+        self._emit_event()
+        self._queue.put(None)
+
+
+class _SSEStream:
+    def __init__(self, response) -> None:
+        self._response = response
+
+    async def events(self):
+        queue = DeferredQueue()
+        self._response.deliverBody(_SSEProtocol(queue))
+
+        while True:
+            event = await queue.get()
+            if event is None:
+                break
+            yield event
 
 
