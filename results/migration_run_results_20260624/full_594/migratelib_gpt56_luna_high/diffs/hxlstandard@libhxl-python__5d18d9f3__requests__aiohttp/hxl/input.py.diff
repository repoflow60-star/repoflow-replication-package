+
+class _AiohttpResponse:
+    """Buffered response adapter for the synchronous input API."""
+
+    def __init__(self, response, content):
+        self.status_code = response.status
+        self.headers = response.headers.copy()
+        self.content = content
+        self.is_redirect = (
+            response.status in (301, 302, 303, 307, 308)
+            and 'Location' in response.headers
+        )
+
+    def json(self):
+        return json.loads(self.content)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise aiohttp.ClientResponseError(
+                request_info=None,
+                history=(),
+                status=self.status_code,
+                message="HTTP status {}".format(self.status_code),
+                headers=self.headers
+            )
+
+    def iter_content(self, chunk_size):
+        for offset in range(0, len(self.content), chunk_size):
+            yield self.content[offset:offset + chunk_size]
+
+    def close(self):
+        pass
+
+
+async def _aiohttp_request_async(
+        method,
+        url,
+        verify_ssl=True,
+        timeout=None,
+        headers=None,
+        params=None,
+        data=None):
+    timeout_config = aiohttp.ClientTimeout(total=timeout)
+
+    async with aiohttp.ClientSession(timeout=timeout_config) as session:
+        request_args = {
+            "ssl": verify_ssl,
+            "headers": headers,
+            "params": params,
+            "data": data,
+        }
+
+        if method.upper() == "HEAD":
+            request_args["allow_redirects"] = False
+
+        async with session.request(method, url, **request_args) as response:
+            content = await response.read()
+            return _AiohttpResponse(response, content)
+
+
+def _aiohttp_request(
+        method,
+        url,
+        verify_ssl=True,
+        timeout=None,
+        headers=None,
+        params=None,
+        data=None):
+    return asyncio.run(
+        _aiohttp_request_async(
+            method=method,
+            url=url,
+            verify_ssl=verify_ssl,
+            timeout=timeout,
+            headers=headers,
+            params=params,
+            data=data
+        )
+    )
+
 
