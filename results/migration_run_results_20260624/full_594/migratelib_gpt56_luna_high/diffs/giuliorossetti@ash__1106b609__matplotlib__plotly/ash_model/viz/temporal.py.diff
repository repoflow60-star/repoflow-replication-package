+def __plotly_trace_kwargs(kwargs):
+    trace_kwargs = {
+        k: v for k, v in kwargs.items() if k != "ax"
+    }
+
+    if "label" in trace_kwargs:
+        trace_kwargs["name"] = trace_kwargs.pop("label")
+
+    line_kwargs = trace_kwargs.get("line")
+    if line_kwargs is not None and isinstance(line_kwargs, dict):
+        line_kwargs = line_kwargs.copy()
+
+    if "color" in trace_kwargs:
+        if line_kwargs is None:
+            line_kwargs = {}
+        line_kwargs["color"] = trace_kwargs.pop("color")
+
+    if "linewidth" in trace_kwargs:
+        if line_kwargs is None:
+            line_kwargs = {}
+        line_kwargs["width"] = trace_kwargs.pop("linewidth")
+    elif "lw" in trace_kwargs:
+        if line_kwargs is None:
+            line_kwargs = {}
+        line_kwargs["width"] = trace_kwargs.pop("lw")
+
+    if "linestyle" in trace_kwargs:
+        if line_kwargs is None:
+            line_kwargs = {}
+        line_kwargs["dash"] = {
+            "-": "solid",
+            "--": "dash",
+            "-.": "dashdot",
+            ":": "dot",
+        }.get(trace_kwargs.pop("linestyle"), "solid")
+    elif "ls" in trace_kwargs:
+        if line_kwargs is None:
+            line_kwargs = {}
+        line_kwargs["dash"] = {
+            "-": "solid",
+            "--": "dash",
+            "-.": "dashdot",
+            ":": "dot",
+        }.get(trace_kwargs.pop("ls"), "solid")
+
+    if line_kwargs is not None:
+        trace_kwargs["line"] = line_kwargs
+
+    if "alpha" in trace_kwargs:
+        trace_kwargs["opacity"] = trace_kwargs.pop("alpha")
+
+    return trace_kwargs
 
 
