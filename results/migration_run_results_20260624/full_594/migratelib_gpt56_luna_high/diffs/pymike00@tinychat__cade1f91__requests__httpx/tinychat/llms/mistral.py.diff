+class _HTTPXEventSource:
+    def __init__(self, response: httpx.Response, client: httpx.Client) -> None:
+        self._response = response
+        self._client = client
+        self.encoding = response.encoding or "utf-8"
+
+    def raise_for_status(self) -> None:
+        self._response.raise_for_status()
+
+    def iter_content(self, chunk_size: int = 1, decode_unicode: bool = False):
+        try:
+            for chunk in self._response.iter_bytes(chunk_size=chunk_size):
+                if decode_unicode:
+                    yield chunk.decode(self.encoding)
+                else:
+                    yield chunk
+        finally:
+            self.close()
+
+    def close(self) -> None:
+        self._response.close()
+        self._client.close()
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
 
 
