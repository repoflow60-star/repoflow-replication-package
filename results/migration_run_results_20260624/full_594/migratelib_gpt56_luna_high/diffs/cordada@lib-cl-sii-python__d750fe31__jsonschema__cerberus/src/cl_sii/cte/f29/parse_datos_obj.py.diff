+def _json_schema_to_cerberus_type(json_type: object) -> object:
+    json_type_mapping = {
+        'array': 'list',
+        'boolean': 'boolean',
+        'integer': 'integer',
+        'number': 'number',
+        'null': None,
+        'object': 'dict',
+        'string': 'string',
+    }
+
+    if isinstance(json_type, list):
+        cerberus_types = [
+            json_type_mapping[type_name]
+            for type_name in json_type
+            if json_type_mapping[type_name] is not None
+        ]
+        if len(cerberus_types) == 1:
+            return cerberus_types[0]
+        return cerberus_types
+
+    return json_type_mapping.get(json_type, json_type)
+
+
+def _json_schema_to_cerberus_schema(
+    schema: Mapping[str, Any],
+) -> Mapping[str, Any]:
+    cerberus_schema: MutableMapping[str, Any] = {}
+    required = schema.get('required', [])
+    properties = schema.get('properties', {})
+
+    for name, property_schema in properties.items():
+        field_schema = _json_schema_property_to_cerberus_schema(property_schema)
+        if name in required:
+            field_schema['required'] = True
+        cerberus_schema[name] = field_schema
+
+    return cerberus_schema
+
+
+def _json_schema_property_to_cerberus_schema(
+    schema: Mapping[str, Any],
+) -> MutableMapping[str, Any]:
+    cerberus_schema: MutableMapping[str, Any] = {}
+
+    json_type = schema.get('type')
+    if json_type is not None:
+        if isinstance(json_type, list) and 'null' in json_type:
+            cerberus_schema['nullable'] = True
+        cerberus_type = _json_schema_to_cerberus_type(json_type)
+        if cerberus_type not in (None, []):
+            cerberus_schema['type'] = cerberus_type
+
+    if 'enum' in schema:
+        cerberus_schema['allowed'] = schema['enum']
+    elif 'const' in schema:
+        cerberus_schema['allowed'] = [schema['const']]
+
+    if 'pattern' in schema:
+        cerberus_schema['regex'] = schema['pattern']
+    if 'minLength' in schema:
+        cerberus_schema['minlength'] = schema['minLength']
+    if 'maxLength' in schema:
+        cerberus_schema['maxlength'] = schema['maxLength']
+    if 'minimum' in schema:
+        cerberus_schema['min'] = schema['minimum']
+    if 'maximum' in schema:
+        cerberus_schema['max'] = schema['maximum']
+    if 'uniqueItems' in schema:
+        cerberus_schema['unique'] = schema['uniqueItems']
+
+    if json_type == 'array':
+        if 'minItems' in schema:
+            cerberus_schema['minlength'] = schema['minItems']
+        if 'maxItems' in schema:
+            cerberus_schema['maxlength'] = schema['maxItems']
+        if isinstance(schema.get('items'), Mapping):
+            cerberus_schema['schema'] = _json_schema_property_to_cerberus_schema(
+                schema['items'],
+            )
+
+    if (
+        json_type == 'object'
+        or 'properties' in schema
+        or 'patternProperties' in schema
+    ):
+        cerberus_schema['type'] = 'dict'
+
+        if 'properties' in schema:
+            cerberus_schema['schema'] = _json_schema_to_cerberus_schema(schema)
+
+        pattern_properties = schema.get('patternProperties', {})
+        if len(pattern_properties) == 1:
+            pattern, pattern_schema = next(iter(pattern_properties.items()))
+            cerberus_schema['keysrules'] = {'regex': pattern}
+            cerberus_schema['allow_unknown'] = _json_schema_property_to_cerberus_schema(
+                pattern_schema,
+            )
+        else:
+            additional_properties = schema.get('additionalProperties', True)
+            if isinstance(additional_properties, Mapping):
+                cerberus_schema['allow_unknown'] = (
+                    _json_schema_property_to_cerberus_schema(additional_properties)
+                )
+            else:
+                cerberus_schema['allow_unknown'] = additional_properties
+
+    return cerberus_schema
