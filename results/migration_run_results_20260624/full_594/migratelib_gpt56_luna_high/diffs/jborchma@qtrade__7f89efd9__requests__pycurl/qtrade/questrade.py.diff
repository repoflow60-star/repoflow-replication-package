+class _PycurlResponse:
+    """Response compatibility wrapper for pycurl."""
+
+    def __init__(self, content: bytes, status_code: int):
+        self.content = content
+        self.status_code = status_code
+
+    def raise_for_status(self):
+        """Raise an exception for HTTP error responses."""
+        if self.status_code >= 400:
+            raise RuntimeError("HTTP error {}".format(self.status_code))
+
+    def json(self):
+        """Return the response body decoded as JSON."""
+        return jsonlib.loads(self.content.decode("utf-8"))
+
+
+class _PycurlSession:
+    """Session compatibility wrapper implemented with pycurl."""
+
+    def __init__(self):
+        self.headers = {}
+        self._curl = pycurl.Curl()
+
+    def request(
+        self,
+        method: str,
+        url: str,
+        params: Optional[Dict] = None,
+        data: Optional[Dict] = None,
+        json: Optional[Dict] = None,
+        timeout: Optional[int] = None,
+    ):
+        """Send an HTTP request using pycurl."""
+        if params:
+            query = urlencode(params, doseq=True)
+            url += ("&" if "?" in url else "?") + query
+
+        request_headers = dict(self.headers)
+
+        if json is not None:
+            request_headers["Content-Type"] = "application/json"
+            body = jsonlib.dumps(json).encode("utf-8")
+        elif isinstance(data, dict):
+            body = urlencode(data, doseq=True).encode("utf-8")
+        else:
+            body = data
+
+        buffer = io.BytesIO()
+
+        self._curl.reset()
+        self._curl.setopt(pycurl.URL, url)
+        self._curl.setopt(pycurl.CUSTOMREQUEST, method.upper())
+        self._curl.setopt(
+            pycurl.HTTPHEADER,
+            [key + ": " + str(value) for key, value in request_headers.items()],
+        )
+        self._curl.setopt(pycurl.WRITEFUNCTION, buffer.write)
+
+        if timeout is not None:
+            self._curl.setopt(pycurl.TIMEOUT, timeout)
+
+        self._curl.setopt(pycurl.HTTPGET, 0)
+        self._curl.setopt(pycurl.POST, 0)
+        self._curl.setopt(pycurl.POSTFIELDS, None)
+
+        if method.lower() == "get":
+            self._curl.setopt(pycurl.HTTPGET, 1)
+        elif method.lower() == "post":
+            self._curl.setopt(pycurl.POST, 1)
+            self._curl.setopt(pycurl.POSTFIELDS, body)
+        elif body is not None:
+            self._curl.setopt(pycurl.POSTFIELDS, body)
+
+        self._curl.perform()
+
+        status_code = self._curl.getinfo(pycurl.RESPONSE_CODE)
+
+        return _PycurlResponse(buffer.getvalue(), status_code)
+
+    def get(self, url: str, **kwargs):
+        """Send a GET request."""
+        return self.request("get", url, **kwargs)
+
+    def post(self, url: str, **kwargs):
+        """Send a POST request."""
+        return self.request("post", url, **kwargs)
+
+    def close(self):
+        """Close the pycurl session."""
+        self._curl.close()
 
 
