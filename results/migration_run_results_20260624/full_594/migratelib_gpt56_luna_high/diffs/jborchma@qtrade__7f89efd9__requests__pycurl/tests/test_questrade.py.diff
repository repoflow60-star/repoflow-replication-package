+# Since pycurl is a low-level client, this mock provides the Curl operations
+# used by the Questrade class.
+class MockCurl:
+    """Class that includes mocked pycurl Curl behavior"""
+
+    def __init__(self):
+        self.options = {}
+        self.status_code = 200
+
+    def setopt(self, option, value):
+        """Method to set a pycurl option"""
+        self.options[option] = value
+
+    def perform(self):
+        """Method to perform a mocked pycurl request"""
+        url = self.options.get(pycurl.URL)
+        if isinstance(url, bytes):
+            url = url.decode()
+
+        parsed_url = urlsplit(url)
+        params = {
+            key: values[-1]
+            for key, values in parse_qs(parsed_url.query).items()
+        }
+
+        response = mocked_curl_get(url, params)
+        self.status_code = response.status_code
+
+        response_data = json.dumps(response.json_data).encode()
+
+        write_function = self.options.get(getattr(pycurl, "WRITEFUNCTION", None))
+        write_data = self.options.get(getattr(pycurl, "WRITEDATA", None))
+
+        if write_function:
+            write_function(response_data)
+        elif write_data:
+            write_data.write(response_data)
+
+    def getinfo(self, option):
+        """Method to return mocked pycurl response information"""
+        if option in (
+            getattr(pycurl, "RESPONSE_CODE", None),
+            getattr(pycurl, "HTTP_CODE", None),
+        ):
+            return self.status_code
+        return None
+
+    def close(self):
+        """Method to close the mocked pycurl connection"""
+        return None
+
+
