+def _resolve_json_schema_reference(ref, base_uri, root_schema):
+    reference = urljoin(base_uri, ref)
+    document_uri, fragment = urldefrag(reference)
+
+    if not document_uri:
+        document_uri = base_uri
+
+    if document_uri == base_uri:
+        document = root_schema
+    elif document_uri in registry:
+        document = registry[document_uri]
+    else:
+        document = retrieve_local(document_uri)
+        registry[document_uri] = document
+
+    target = document
+    if fragment:
+        for part in fragment.lstrip("/").split("/"):
+            part = unquote(part).replace("~1", "/").replace("~0", "~")
+            target = target[part]
+
+    return target, document_uri, document
+
+
+def _exclusive_bounds(minimum=None, maximum=None):
+    def check(field, value, error):
+        if isinstance(value, (int, float)) and not isinstance(value, bool):
+            if minimum is not None and value <= minimum:
+                error(field, f"must be greater than {minimum}")
+            if maximum is not None and value >= maximum:
+                error(field, f"must be less than {maximum}")
+
+    return check
+
+
+def _convert_json_schema(schema, base_uri, root_schema):
+    if schema is True:
+        return {}
+
+    if schema is False:
+        return {"allowed": []}
+
+    if "$ref" in schema:
+        referenced, reference_base, reference_root = _resolve_json_schema_reference(
+            schema["$ref"], base_uri, root_schema
+        )
+
+        if isinstance(referenced, dict):
+            merged_schema = dict(referenced)
+            merged_schema.update(
+                {key: value for key, value in schema.items() if key != "$ref"}
+            )
+            schema = merged_schema
+        else:
+            schema = referenced
+
+        base_uri = reference_base
+        root_schema = reference_root
+
+    if not isinstance(schema, dict):
+        return {}
+
+    if "$id" in schema:
+        base_uri = urljoin(base_uri, schema["$id"])
+
+    type_value = schema.get("type")
+    if isinstance(type_value, list) and len(type_value) > 1:
+        rules = []
+        for type_name in type_value:
+            branch = dict(schema)
+            branch["type"] = type_name
+            rules.append(_convert_json_schema(branch, base_uri, root_schema))
+        return {"anyof": rules}
+
+    if isinstance(type_value, list):
+        type_value = type_value[0]
+
+    rules = {}
+
+    if type_value == "object" or any(
+        key in schema
+        for key in (
+            "properties",
+            "required",
+            "additionalProperties",
+            "patternProperties",
+            "minProperties",
+            "maxProperties",
+        )
+    ):
+        rules["type"] = "dict"
+
+        properties = {}
+        required = schema.get("required", [])
+
+        for property_name, property_schema in schema.get("properties", {}).items():
+            property_rules = _convert_json_schema(
+                property_schema, base_uri, root_schema
+            )
+            if property_name in required:
+                property_rules["required"] = True
+            properties[property_name] = property_rules
+
+        rules["schema"] = properties
+
+        additional_properties = schema.get("additionalProperties", True)
+        if isinstance(additional_properties, dict):
+            rules["allow_unknown"] = _convert_json_schema(
+                additional_properties, base_uri, root_schema
+            )
+        else:
+            rules["allow_unknown"] = additional_properties
+
+        if "minProperties" in schema:
+            rules["minlength"] = schema["minProperties"]
+        if "maxProperties" in schema:
+            rules["maxlength"] = schema["maxProperties"]
+
+    elif type_value == "array":
+        rules["type"] = "list"
+
+        items = schema.get("items")
+        if isinstance(items, dict):
+            rules["schema"] = _convert_json_schema(items, base_uri, root_schema)
+
+        if "minItems" in schema:
+            rules["minlength"] = schema["minItems"]
+        if "maxItems" in schema:
+            rules["maxlength"] = schema["maxItems"]
+        if "uniqueItems" in schema:
+            rules["unique"] = schema["uniqueItems"]
+
+    elif type_value == "string":
+        rules["type"] = "string"
+
+        if "minLength" in schema:
+            rules["minlength"] = schema["minLength"]
+        if "maxLength" in schema:
+            rules["maxlength"] = schema["maxLength"]
+        if "pattern" in schema:
+            rules["regex"] = schema["pattern"]
+
+    elif type_value == "integer":
+        rules["type"] = "integer"
+
+    elif type_value == "number":
+        rules["type"] = "number"
+
+    elif type_value == "boolean":
+        rules["type"] = "boolean"
+
+    elif type_value == "null":
+        rules["allowed"] = [None]
+
+    if "enum" in schema:
+        rules["allowed"] = schema["enum"]
+
+    if "const" in schema:
+        rules["allowed"] = [schema["const"]]
