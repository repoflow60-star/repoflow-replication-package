+    if "default" in schema:
+        rules["default"] = schema["default"]
+
+    if "allOf" in schema:
+        rules["allof"] = [
+            _convert_json_schema(item, base_uri, root_schema)
+            for item in schema["allOf"]
+        ]
+
+    if "anyOf" in schema:
+        rules["anyof"] = [
