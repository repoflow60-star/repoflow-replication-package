+            for item in schema["anyOf"]
+        ]
+
+    if "oneOf" in schema:
+        rules["oneof"] = [
+            _convert_json_schema(item, base_uri, root_schema)
+            for item in schema["oneOf"]
+        ]
+
+    if "not" in schema:
+        rules["noneof"] = [
+            _convert_json_schema(schema["not"], base_uri, root_schema)
+        ]
+
+    return rules
+
