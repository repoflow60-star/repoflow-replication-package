     def resolve(self, ref):
-        return self.resolver.resolve_fragment(self.schema, ref)
+        fragment = ref[1:] if ref.startswith("#") else ref
+        resolved = self.schema
+
+        if not fragment:
+            return resolved
+
+        for part in fragment.strip("/").split("/"):
+            part = part.replace("~1", "/").replace("~0", "~")
+            resolved = resolved[part]
+
+        return resolved
+
+
+class _CerberusValidator(Validator):
+    def __init__(self, *args, resolver=None, **kwargs):
+        self.resolver = resolver
+        super().__init__(*args, **kwargs)
+
+    def _validate_schema_ref(self, constraint, field, value):
+        """{'type': 'string'}"""
+        schema = self.resolver.resolve(constraint)
+        validator = _CerberusValidator(
+            schema["schema"],
+            allow_unknown=schema.get("allow_unknown", False),
+            resolver=self.resolver,
+        )
+
+        if not validator.validate(value):
+            self._error(field, "Value does not conform to the referenced schema")
 
 
