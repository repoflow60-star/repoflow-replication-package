+    def _request(self, method: str, url: str, headers: dict, payload=None):
+        response_buffer = BytesIO()
+        header_buffer = BytesIO()
+        curl = pycurl.Curl()
+
+        request_headers = dict(headers)
+
+        if payload is not None:
+            body = json.dumps(payload).encode('utf-8')
+            request_headers['Content-Type'] = 'application/json'
+        else:
+            body = None
+
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.CUSTOMREQUEST, method)
+        curl.setopt(
+            pycurl.HTTPHEADER,
+            [key + ': ' + str(value) for key, value in request_headers.items()])
+        curl.setopt(pycurl.WRITEFUNCTION, response_buffer.write)
+        curl.setopt(pycurl.HEADERFUNCTION, header_buffer.write)
+        curl.setopt(pycurl.TIMEOUT, self.timeout)
+
+        if body is not None:
+            curl.setopt(pycurl.POSTFIELDS, body)
+
+        try:
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        response_headers = {}
+        for line in header_buffer.getvalue().decode('iso-8859-1').splitlines():
+            if ':' in line:
+                key, value = line.split(':', 1)
+                response_headers[key.strip()] = value.strip()
+
+        return _PycurlResponse(
+            response_buffer.getvalue(),
+            status_code,
+            response_headers)
