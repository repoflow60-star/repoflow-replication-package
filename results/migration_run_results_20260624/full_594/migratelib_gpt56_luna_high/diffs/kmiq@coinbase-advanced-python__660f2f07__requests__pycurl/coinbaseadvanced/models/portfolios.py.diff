+class PyCurlResponse:
+    """
+    Response adapter for pycurl responses.
+    """
+
+    def __init__(self, curl: pycurl.Curl, body: bytes):
+        self.status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        self.content = body
+        self.text = body.decode("utf-8", errors="replace")
+
+    @property
+    def ok(self) -> bool:
+        return self.status_code < 400
+
+    def json(self):
+        return json.loads(self.content.decode("utf-8"))
 
 
