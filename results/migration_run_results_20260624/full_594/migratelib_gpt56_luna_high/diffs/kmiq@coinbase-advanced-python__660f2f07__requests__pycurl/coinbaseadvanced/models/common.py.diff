+
+    def __init__(self, curl: pycurl.Curl, body: bytes) -> None:
+        self.status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        self.content = body
+
+    @property
+    def ok(self) -> bool:
+        return self.status_code < 400
+
+    @property
+    def text(self) -> str:
+        return self.content.decode("utf-8", errors="replace")
+
+    def json(self):
+        return json.loads(self.content)
 
 
