+class PycurlResponse:
+    """
+    Response adapter for pycurl.
+    """
+
+    def __init__(self, curl: pycurl.Curl, body: bytes) -> None:
+        self.status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        self.content = body
+        self.text = body.decode('utf-8')
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status_code < 400
+
+    def json(self):
+        return json.loads(self.text)
 
 
