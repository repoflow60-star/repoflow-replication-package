+class _PycurlResponse:
+    """
+    Response adapter for pycurl responses.
+    """
+
+    def __init__(self, curl: pycurl.Curl, body: BytesIO) -> None:
+        self.status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        self.content = body.getvalue()
+
+    @property
+    def ok(self) -> bool:
+        return self.status_code < 400
+
+    @property
+    def text(self) -> str:
+        return self.content.decode("utf-8")
+
+    def json(self) -> dict:
+        return json.loads(self.content.decode("utf-8"))
 
 
