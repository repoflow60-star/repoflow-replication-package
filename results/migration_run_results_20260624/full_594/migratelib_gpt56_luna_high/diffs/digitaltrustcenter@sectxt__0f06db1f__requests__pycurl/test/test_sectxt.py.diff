+class _PycurlCurl:
+    def __init__(self, mocker):
+        self._mocker = mocker
+        self._url = None
+        self._write_data = None
+        self._write_function = None
+        self._header_function = None
+        self._response_code = 0
+        self._content_type = None
+
+    def setopt(self, option, value):
+        if option == pycurl.URL:
+            self._url = value.decode() if isinstance(value, bytes) else value
+        elif option == pycurl.WRITEDATA:
+            self._write_data = value
+        elif option == pycurl.WRITEFUNCTION:
+            self._write_function = value
+        elif option == pycurl.HEADERFUNCTION:
+            self._header_function = value
+
+    def perform(self):
+        response = self._mocker._responses[self._url]
+
+        if response["exc"] is not None:
+            exc = response["exc"]
+            if isinstance(exc, type) and issubclass(exc, pycurl.error):
+                raise exc(pycurl.E_COULDNT_CONNECT, "Connection timed out")
+            raise exc
+
+        self._response_code = response["status_code"]
+        self._content_type = response["headers"].get("content-type")
+
+        if self._header_function is not None:
+            self._header_function(
+                f"HTTP/1.1 {self._response_code} OK\r\n".encode()
+            )
+            for key, value in response["headers"].items():
+                self._header_function(f"{key}: {value}\r\n".encode())
+            self._header_function(b"\r\n")
+
+        content = response["content"]
+
+        if self._write_function is not None:
+            self._write_function(content)
+        elif self._write_data is not None:
+            self._write_data.write(content)
+
+    def getinfo(self, option):
+        if option == pycurl.RESPONSE_CODE:
+            return self._response_code
+        if option == pycurl.CONTENT_TYPE:
+            return self._content_type
+        return None
+
+    def close(self):
+        pass
+
+
+class Mocker:
+    def __init__(self):
+        self._responses = {}
+        self._patcher = None
+
+    def __enter__(self):
+        self._patcher = patch.object(pycurl, "Curl", self._create_curl)
+        self._patcher.start()
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        self._patcher.stop()
+
+    def _create_curl(self):
+        return _PycurlCurl(self)
+
+    def get(
+        self,
+        url,
+        headers=None,
+        content=None,
+        text=None,
+        exc=None,
+        status_code=200,
+    ):
+        if content is None and text is not None:
+            content = text.encode()
+
+        if content is None:
+            content = b""
+
+        if headers is None:
+            headers = {}
+
+        self._responses[url] = {
+            "headers": headers,
+            "content": content,
+            "exc": exc,
+            "status_code": status_code,
+        }
