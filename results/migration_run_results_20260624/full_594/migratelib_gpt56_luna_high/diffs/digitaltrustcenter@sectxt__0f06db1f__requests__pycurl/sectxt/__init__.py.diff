+def _pycurl_ssl_error(error) -> bool:
+    return bool(error.args) and error.args[0] in (
+        getattr(pycurl, "CURLE_SSL_CONNECT_ERROR", None),
+        getattr(pycurl, "CURLE_SSL_CERTPROBLEM", None),
+        getattr(pycurl, "CURLE_SSL_CIPHER", None),
+        getattr(pycurl, "CURLE_SSL_ENGINE_NOTFOUND", None),
+        getattr(pycurl, "CURLE_SSL_ENGINE_SETFAILED", None),
+        getattr(pycurl, "CURLE_SSL_ENGINE_INITFAILED", None),
+        getattr(pycurl, "CURLE_PEER_FAILED_VERIFICATION", None),
+        getattr(pycurl, "CURLE_SSL_CACERT", None),
+        getattr(pycurl, "CURLE_SSL_CACERT_BADFILE", None),
+        getattr(pycurl, "CURLE_SSL_ISSUER", None),
+        getattr(pycurl, "CURLE_SSL_INVALIDCERTSTATUS", None),
+        getattr(pycurl, "CURLE_SSL_PINNEDPUBKEYNOTMATCH", None),
+    )
+
+
+def _pycurl_get(url: str, verify: bool = True):
+    content = io.BytesIO()
+    response_headers = {}
+
+    def header_function(header):
+        if isinstance(header, bytes):
+            header = header.decode("iso-8859-1")
+        header = header.rstrip("\r\n")
+
+        if header.startswith("HTTP/"):
+            response_headers.clear()
+        elif ":" in header:
+            key, value = header.split(":", 1)
+            response_headers[key.lower()] = value.strip()
+
+    s.reset()
+    s.setopt(pycurl.URL, url)
+    s.setopt(
+        pycurl.HTTPHEADER,
+        [
+            'User-Agent: Mozilla/5.0 (Windows NT 6.1; WOW64; rv:12.0) '
+            'Gecko/20100101 Firefox/12.0'
+        ]
+    )
+    s.setopt(pycurl.TIMEOUT, 5)
+    s.setopt(pycurl.FOLLOWLOCATION, 1)
+    s.setopt(pycurl.MAXREDIRS, 30)
+    s.setopt(pycurl.SSL_VERIFYPEER, 1 if verify else 0)
+    s.setopt(pycurl.SSL_VERIFYHOST, 2 if verify else 0)
+    s.setopt(pycurl.WRITEDATA, content)
+    s.setopt(pycurl.HEADERFUNCTION, header_function)
+    s.perform()
+
+    effective_url = s.getinfo(pycurl.EFFECTIVE_URL)
+    if isinstance(effective_url, bytes):
+        effective_url = effective_url.decode("utf-8")
+
+    return {
+        "status_code": s.getinfo(pycurl.HTTP_CODE),
+        "history": s.getinfo(pycurl.REDIRECT_COUNT),
+        "url": effective_url,
+        "headers": response_headers,
+        "content": content.getvalue(),
+    }
 
 
