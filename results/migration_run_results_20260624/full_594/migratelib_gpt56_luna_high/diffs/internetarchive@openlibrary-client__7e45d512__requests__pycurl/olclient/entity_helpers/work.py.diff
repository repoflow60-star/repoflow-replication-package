+class _PycurlResponse:
+    def __init__(self, content, status_code):
+        self.content = content
+        self.status_code = status_code
+
+    def json(self):
+        return json.loads(self.content)
+
+
+def _pycurl_request(method, url, data=None, params=None, files=None):
+    if params:
+        url += ('&' if '?' in url else '?') + urlencode(params)
+
+    response_body = io.BytesIO()
+    curl = pycurl.Curl()
+    curl.setopt(pycurl.URL, url)
+    curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+
+    if method == 'GET':
+        curl.setopt(pycurl.HTTPGET, 1)
+    elif method == 'POST':
+        curl.setopt(pycurl.POST, 1)
+    else:
+        curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+    if files is not None:
+        curl.setopt(
+            pycurl.HTTPPOST,
+            [(key, value) for key, value in files.items()],
+        )
+    elif data is not None:
+        if isinstance(data, str):
+            data = data.encode()
+        curl.setopt(pycurl.POSTFIELDS, data)
+
+    curl.perform()
+    response = _PycurlResponse(
+        response_body.getvalue(),
+        curl.getinfo(pycurl.RESPONSE_CODE),
+    )
+    curl.close()
+    return response
 
 
