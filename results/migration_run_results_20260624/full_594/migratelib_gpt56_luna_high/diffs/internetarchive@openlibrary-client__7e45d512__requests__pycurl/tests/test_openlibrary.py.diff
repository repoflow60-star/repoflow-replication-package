 def raise_http_error():
-    r = requests.Response
     # Non 4xx status will trigger backoff retries
-    r.status_code = 404
-    kwargs = {'response': r}
-    raise requests.HTTPError("test HTTPError", **kwargs)
+    raise pycurl.error(404, "test HTTPError")
+
+
+def set_curl_responses(mock_get, responses):
+    responses = iter(responses)
+    mock_get.return_value.getinfo.return_value = 200
+
+    def perform():
+        response = json.dumps(next(responses)).encode()
+        options = {}
+        for item in mock_get.return_value.setopt.call_args_list:
+            option, value = item.args
+            options[option] = value
+
+        writer = options.get(pycurl.WRITEDATA)
+        if writer is None:
+            writer = options.get(pycurl.WRITEFUNCTION)
+
+        if writer is None:
+            for value in options.values():
+                if hasattr(value, 'write') or callable(value):
+                    writer = value
+                    break
+
+        if callable(writer):
+            writer(response)
+        else:
+            writer.write(response)
+
+    mock_get.return_value.perform.side_effect = perform
+
+
+def curl_urls(mock_get):
+    urls = []
+    for item in mock_get.return_value.setopt.call_args_list:
+        option, value = item.args
+        if option == pycurl.URL or (
+            isinstance(value, str)
+            and value.startswith(('http://', 'https://'))
+        ):
+            urls.append(value)
+    return urls
+
+
+def curl_options(mock_get):
+    options = {}
+    for item in mock_get.return_value.setopt.call_args_list:
+        option, value = item.args
+        options[option] = value
+    return options
 
 
