+def _treq_json_request(method, url, **kwargs):
+    @defer.inlineCallbacks
+    def request():
+        response = yield treq.request(method, url, **kwargs)
+        data = None
+        if response.code == 200:
+            data = yield treq.json_content(response)
+        else:
+            yield response.content()
+        defer.returnValue((response.code, data))
+
+    return blockingCallFromThread(reactor, request)
 
 
