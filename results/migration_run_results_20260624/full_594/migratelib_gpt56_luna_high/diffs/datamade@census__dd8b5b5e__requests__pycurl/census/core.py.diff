 __version__ = version('census')
 
 ALL = '*'
 
 
+class PyCurlResponse(object):
+
+    def __init__(self, content, status_code):
+        self.content = content
+        self.status_code = status_code
+        self.text = content.decode('utf-8', errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+
+class PyCurlSession(object):
+
+    def __init__(self, *args, **kwargs):
+        self.headers = {}
+
+    def get(self, url, params=None, **kwargs):
+        import pycurl
+
+        if params:
+            query = urlencode(params, doseq=True)
+            if query:
+                url = '{}{}{}'.format(url, '&' if '?' in url else '?', query)
+
+        body = io.BytesIO()
+        curl = pycurl.Curl()
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEDATA, body)
+
+        if self.headers:
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                ['{}: {}'.format(key, value) for key, value in self.headers.items()]
+            )
+
+        try:
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        return PyCurlResponse(body.getvalue(), status_code)
+
+
 def new_session(*args, **kwargs):
