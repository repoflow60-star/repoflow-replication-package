+def main():
+    commands = {
+        "bounds": _bounds,
+        "bbox": _bbox,
+        "tile": _tile,
+        "tiles": _tiles,
+        "snap_bounds": _snap_bounds,
+        "snap_bbox": _snap_bbox,
+    }
+
+    command_index = None
+    for index, argument in enumerate(sys.argv[1:], start=1):
+        if argument in commands:
+            command_index = index
+            break
+
+    if command_index is None:
+        if "--version" in sys.argv[1:]:
+            print(tilematrix.__version__)
+        else:
+            print(
+                "Usage: %s [OPTIONS] COMMAND"
+                % sys.argv[0]
+            )
+        return
+
+    if "--version" in sys.argv[1:command_index]:
+        print(tilematrix.__version__)
+        return
+
+    sys.argv.pop(command_index)
+    plac.call(commands[sys.argv[command_index - 1]])
+
+
+if __name__ == "__main__":
+    main()
