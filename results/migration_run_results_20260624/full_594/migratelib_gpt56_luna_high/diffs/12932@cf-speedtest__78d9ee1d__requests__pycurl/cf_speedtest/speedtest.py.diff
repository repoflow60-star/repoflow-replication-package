 PROXY_DICT = None
 VERIFY_SSL = True
 OUTPUT_FILE = None
+
+
+class _PycurlHeaders(dict):
+    def __getitem__(self, key):
+        return super().__getitem__(key.lower())
+
+    def get(self, key, default=None):
+        return super().get(key.lower(), default)
+
+
+class _PycurlResponse:
+    def __init__(self, content, headers, status_code):
+        self.content = content
+        self.headers = headers
+        self.status_code = status_code
+
+    @property
+    def text(self):
+        return self.content.decode('utf-8', errors='replace')
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise RuntimeError(f'HTTP Error {self.status_code}')
+
+
+def _request(
+    method: str,
+    url: str,
+    data=None,
+    headers=None,
+    verify: bool = True,
+    proxies=None,
+) -> _PycurlResponse:
+    response_content = io.BytesIO()
+    response_headers = _PycurlHeaders()
+
+    def header_function(header_line):
+        header_line = header_line.decode('iso-8859-1').strip('\r\n')
+
+        if header_line.startswith('HTTP/'):
+            response_headers.clear()
+        elif ':' in header_line:
+            key, value = header_line.split(':', 1)
+            response_headers[key.strip().lower()] = value.strip()
+
+    REQ_SESSION.setopt(pycurl.URL, url)
+    REQ_SESSION.setopt(pycurl.WRITEFUNCTION, response_content.write)
+    REQ_SESSION.setopt(pycurl.HEADERFUNCTION, header_function)
+    REQ_SESSION.setopt(pycurl.FOLLOWLOCATION, 1)
+    REQ_SESSION.setopt(pycurl.SSL_VERIFYPEER, 1 if verify else 0)
+    REQ_SESSION.setopt(pycurl.SSL_VERIFYHOST, 2 if verify else 0)
+    REQ_SESSION.setopt(pycurl.ACCEPT_ENCODING, '')
+
+    if proxies:
+        proxy = proxies.get('https') or proxies.get('http')
+        if proxy:
+            REQ_SESSION.setopt(pycurl.PROXY, proxy)
+
+    if headers:
+        REQ_SESSION.setopt(
+            pycurl.HTTPHEADER,
+            [f'{key}: {value}' for key, value in headers.items()],
+        )
+    else:
+        REQ_SESSION.setopt(pycurl.HTTPHEADER, [])
+
+    if method == 'POST':
+        if isinstance(data, bytearray):
+            data = bytes(data)
+
+        REQ_SESSION.setopt(pycurl.HTTPGET, 0)
+        REQ_SESSION.setopt(pycurl.POST, 1)
+        REQ_SESSION.setopt(pycurl.POSTFIELDS, data)
+    else:
+        REQ_SESSION.setopt(pycurl.POST, 0)
+        REQ_SESSION.setopt(pycurl.POSTFIELDS, None)
+        REQ_SESSION.setopt(pycurl.HTTPGET, 1)
+
+    REQ_SESSION.perform()
+
+    return _PycurlResponse(
+        response_content.getvalue(),
+        response_headers,
+        REQ_SESSION.getinfo(pycurl.RESPONSE_CODE),
+    )
 
