+class _Response:
+    def __init__(self, content, url, history=None, status_code=0):
+        self.content = content
+        self.url = url
+        self.history = history or []
+        self.status_code = status_code
+
+    @property
+    def text(self):
+        return self.content.decode("utf-8", errors="replace")
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise RuntimeError(
+                "HTTP error %s while fetching %s"
+                % (self.status_code, self.url)
+            )
+
+
+class _Cookies:
+    def __init__(self, curl):
+        self._curl = curl
+
+    def clear(self):
+        self._curl.setopt(pycurl.COOKIELIST, "ALL")
+
+
+class _Session:
+    def __init__(self):
+        self._curl = pycurl.Curl()
+        self._curl.setopt(pycurl.COOKIEFILE, "")
+        self._curl.setopt(pycurl.FOLLOWLOCATION, True)
+        self._curl.setopt(pycurl.MAXREDIRS, 30)
+        self.cookies = _Cookies(self._curl)
+
+    def _request(self, url, data=None):
+        response_buffer = BytesIO()
+        redirect_history = []
+        current_url = url
+        response_status = [0]
+        location = [None]
+
+        def _header_callback(header):
+            line = header.decode("iso-8859-1")
+
+            if line.startswith("HTTP/"):
+                parts = line.split()
+                if len(parts) > 1:
+                    try:
+                        response_status[0] = int(parts[1])
+                    except ValueError:
+                        response_status[0] = 0
+                location[0] = None
+            elif line.lower().startswith("location:"):
+                location[0] = line.split(":", 1)[1].strip()
+            elif not line.strip():
+                if (
+                    location[0]
+                    and 300 <= response_status[0] < 400
+                ):
+                    redirect_history.append(
+                        _Response(
+                            content=b"",
+                            url=current_url,
+                            status_code=response_status[0],
+                        )
+                    )
+                    current_url = urljoin(current_url, location[0])
+                location[0] = None
+
+            return len(header)
+
+        self._curl.setopt(pycurl.URL, url)
+        self._curl.setopt(pycurl.WRITEFUNCTION, response_buffer.write)
+        self._curl.setopt(pycurl.HEADERFUNCTION, _header_callback)
+        self._curl.setopt(pycurl.FOLLOWLOCATION, True)
+
+        if data is None:
+            self._curl.setopt(pycurl.HTTPGET, True)
+            self._curl.setopt(pycurl.POST, False)
+            self._curl.setopt(pycurl.HTTPHEADER, [])
+        else:
+            self._curl.setopt(pycurl.HTTPGET, False)
+            self._curl.setopt(pycurl.POST, True)
+            self._curl.setopt(
+                pycurl.POSTFIELDS, urlencode(data).encode("utf-8")
+            )
+            self._curl.setopt(
+                pycurl.HTTPHEADER,
+                ["Content-Type: application/x-www-form-urlencoded"],
+            )
+
+        self._curl.perform()
+
+        return _Response(
+            content=response_buffer.getvalue(),
+            url=self._curl.getinfo(pycurl.EFFECTIVE_URL) or url,
+            history=redirect_history,
+            status_code=self._curl.getinfo(pycurl.RESPONSE_CODE),
+        )
+
+    def get(self, url):
+        return self._request(url)
+
+    def post(self, url, data=None):
+        return self._request(url, data=data)
 
 
