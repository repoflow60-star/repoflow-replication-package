+    auth: ty.Optional[ty.Union[HTTPTokenAuth, ty.Tuple[str, str]]],
+    headers: ty.Dict[str, str],
+    params: ty.Optional[Filters] = None,
+    data: ty.Optional[ty.List[ty.Tuple[str, ty.Any]]] = None,
+) -> _Response:
+    if params:
+        query = urlencode(params, doseq=True)
+        url = '{}{}{}'.format(
+            url,
+            '&' if '?' in url else '?',
+            query,
+        )
+
+    curl = pycurl.Curl()
+    body = bytearray()
+    response_headers = bytearray()
+
+    curl_headers = [
+        '{}: {}'.format(key, value)
+        for key, value in headers.items()
+    ]
+
+    if isinstance(auth, HTTPTokenAuth):
+        auth_headers: ty.Dict[str, str] = {}
+        auth(auth_headers)
+        curl_headers.extend(
+            '{}: {}'.format(key, value)
+            for key, value in auth_headers.items()
+        )
+    elif auth is not None:
+        curl.setopt(
+            pycurl.USERPWD,
+            '{}:{}'.format(auth[0], auth[1]),
+        )
+        curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+
+    if data is not None:
+        curl_headers.append(
+            'Content-Type: application/x-www-form-urlencoded'
+        )
+
+    curl.setopt(pycurl.URL, url)
+    curl.setopt(pycurl.HTTPHEADER, curl_headers)
+    curl.setopt(pycurl.FOLLOWLOCATION, True)
+    curl.setopt(pycurl.WRITEFUNCTION, body.extend)
+    curl.setopt(pycurl.HEADERFUNCTION, response_headers.extend)
+
+    if method == 'POST':
+        curl.setopt(pycurl.POST, True)
+        curl.setopt(
+            pycurl.POSTFIELDS,
+            urlencode(data or [], doseq=True).encode(),
+        )
+    elif method == 'PATCH':
+        curl.setopt(pycurl.CUSTOMREQUEST, 'PATCH')
+        curl.setopt(
+            pycurl.POSTFIELDS,
+            urlencode(data or [], doseq=True).encode(),
+        )
+    elif method == 'DELETE':
+        curl.setopt(pycurl.CUSTOMREQUEST, 'DELETE')
+    else:
+        curl.setopt(pycurl.HTTPGET, True)
+
+    try:
+        curl.perform()
+
+        status_code = 0
+        parsed_headers: ty.Dict[str, str] = {}
+
+        for line in response_headers.decode(
+            'iso-8859-1',
+        ).splitlines():
+            if line.startswith('HTTP/'):
+                status_code = int(line.split()[1])
+                parsed_headers = {}
+            elif ':' in line:
+                key, value = line.split(':', 1)
+                parsed_headers[key.lower()] = value.strip()
+
+        return _Response(
+            status_code,
+            parsed_headers,
+            bytes(body),
+        )
+    finally:
+        curl.close()
+
