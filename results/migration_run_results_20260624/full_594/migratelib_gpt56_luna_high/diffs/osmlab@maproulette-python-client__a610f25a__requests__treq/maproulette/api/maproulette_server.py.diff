+
+        if isinstance(self.certs, (tuple, list)):
+            return CertificateOptions(
+                privateKeyFile=self.certs[1],
+                certificateFile=self.certs[0],
+                trustRoot=trust_root
+            )
+        elif self.certs is not None:
+            return CertificateOptions(
+                privateKeyFile=self.certs,
+                certificateFile=self.certs,
+                trustRoot=trust_root
+            )
+        else:
+            return CertificateOptions(
+                trustRoot=trust_root
+            )
 
 
