+    def _perform_request(self, method, url, params=None, body=None):
+        if params:
+            if isinstance(params, str):
+                query = params
+            else:
+                query = urlencode(params, doseq=True)
+            url = url + ('&' if '?' in url else '?') + query
+
+        response_content = io.BytesIO()
+        response_headers = io.BytesIO()
+
+        self.session.reset()
+        self.session.setopt(pycurl.URL, url)
+        self.session.setopt(
+            pycurl.HTTPHEADER,
+            [
+                f'Authorization: {self.authorization_header}',
+                *(
+                    ['Content-Type: application/json']
+                    if method in ('POST', 'PATCH')
+                    else []
+                ),
+            ],
+        )
+        self.session.setopt(pycurl.WRITEDATA, response_content)
+        self.session.setopt(pycurl.HEADERFUNCTION, response_headers.write)
+        self.session.setopt(pycurl.CUSTOMREQUEST, method)
+
+        if method == 'GET':
+            self.session.setopt(pycurl.HTTPGET, True)
+        elif method in ('POST', 'PATCH'):
+            self.session.setopt(pycurl.POST, True)
+            self.session.setopt(
+                pycurl.POSTFIELDS,
+                body if body is not None else '',
+            )
+
+        self.session.perform()
+
+        return _PycurlResponse(
+            content=response_content.getvalue(),
+            header_data=response_headers.getvalue(),
+            status_code=self.session.getinfo(pycurl.RESPONSE_CODE),
+            url=self.session.getinfo(pycurl.EFFECTIVE_URL) or url,
+        )
+
