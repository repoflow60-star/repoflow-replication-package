+class _PycurlSession(object):
+    def _request(self, method, url, data=None, params=None, headers=None,
+                 verify=True):
+        if params:
+            query = urllib_parse.urlencode(params)
+            separator = '&' if '?' in url else '?'
+            url = ''.join([url, separator, query])
+
+        response = io.BytesIO()
+        curl = pycurl.Curl()
+
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEFUNCTION, response.write)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.SSL_VERIFYPEER, 1 if verify else 0)
+            curl.setopt(pycurl.SSL_VERIFYHOST, 2 if verify else 0)
+
+            if headers:
+                curl.setopt(
+                    pycurl.HTTPHEADER,
+                    ['%s: %s' % (key, value)
+                     for key, value in headers.items()]
+                )
+
+            if method == 'POST':
+                if data is None:
+                    data = b''
+                elif isinstance(data, str):
+                    data = data.encode('utf8')
+                curl.setopt(pycurl.POST, 1)
+                curl.setopt(pycurl.POSTFIELDS, data)
+            else:
+                curl.setopt(pycurl.HTTPGET, 1)
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            return _PycurlResponse(response.getvalue(), status_code)
+        finally:
+            curl.close()
+
+    def get(self, url, params=None, verify=True, stream=False):
+        return self._request(
