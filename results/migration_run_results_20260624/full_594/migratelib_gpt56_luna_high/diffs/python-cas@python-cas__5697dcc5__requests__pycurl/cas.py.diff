+            url,
+            params=params,
+            verify=verify
+        )
+
+    def post(self, url, data=None, params=None, headers=None, verify=True):
+        return self._request(
+            'POST',
+            url,
+            data=data,
+            params=params,
+            headers=headers,
+            verify=verify
+        )
 
 
