+class _PycurlHeaders(dict):
+    def __contains__(self, key):
+        if dict.__contains__(self, key):
+            return True
+        key = key.lower()
+        return any(header.lower() == key for header in self.keys())
+
+    def __getitem__(self, key):
+        if dict.__contains__(self, key):
+            return dict.__getitem__(self, key)
+        key = key.lower()
+        for header, value in self.items():
+            if header.lower() == key:
+                return value
+        raise KeyError(key)
+
+    def get(self, key, default=None):
+        try:
+            return self[key]
+        except KeyError:
+            return default
+
+
+class _PycurlResponse(object):
+    def __init__(self, status_code, reason, headers, content):
+        self.status_code = status_code
+        self.reason = reason
+        self.headers = headers
+        self.content = content
+
+    def json(self):
+        return loads(self.content)
+
+
+class _PycurlSession(object):
+    def __init__(self):
+        self.auth = None
+        self.headers = {}
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        request_headers = self.headers.copy()
+        if headers:
+            request_headers.update(headers)
+
+        content_type = None
+        accept_encoding = ""
+        header_list = []
+
+        for key, value in request_headers.items():
+            if key.lower() == 'content-type':
+                content_type = value
+            if key.lower() == 'accept-encoding':
+                accept_encoding = value
+            else:
+                header_list.append("%s: %s" % (key, value))
+
+        if isinstance(data, dict) and content_type == 'application/x-www-form-urlencoded':
+            data = urlencode(data)
+
+        if isinstance(data, str):
+            data = data.encode('utf-8')
+
+        body = BytesIO()
+        response_data = {
+            'headers': _PycurlHeaders(),
+            'reason': ''
+        }
+
+        def header_function(header):
+            try:
+                line = header.decode('iso-8859-1')
+            except AttributeError:
+                line = header
+
+            line = line.rstrip('\r\n')
+
+            if line.startswith('HTTP/'):
+                response_data['headers'] = _PycurlHeaders()
+                parts = line.split(' ', 2)
+                if len(parts) > 2:
+                    response_data['reason'] = parts[2]
+            elif ':' in line:
+                key, value = line.split(':', 1)
+                response_data['headers'][key.strip()] = value.strip()
+
+            return len(header)
+
+        curl = pycurl.Curl()
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.CUSTOMREQUEST, method)
+        curl.setopt(pycurl.HTTPHEADER, header_list)
+        curl.setopt(pycurl.ACCEPT_ENCODING, accept_encoding)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, header_function)
+
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT, int(timeout))
+
+        if data is not None:
+            curl.setopt(pycurl.POSTFIELDS, data)
+
+        if self.auth:
+            if isinstance(self.auth, (tuple, list)) and len(self.auth) >= 2:
+                username, password = self.auth[0], self.auth[1]
+                curl.setopt(pycurl.USERPWD, "%s:%s" % (username, password))
+                curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+            elif hasattr(self.auth, 'username') and hasattr(self.auth, 'password'):
+                curl.setopt(pycurl.USERPWD, "%s:%s" % (self.auth.username, self.auth.password))
+                curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+
+        curl.perform()
+
+        status_code = int(curl.getinfo(pycurl.RESPONSE_CODE))
+        curl.close()
+
+        return _PycurlResponse(status_code,
+                               response_data['reason'],
+                               response_data['headers'],
+                               body.getvalue())
 
 
