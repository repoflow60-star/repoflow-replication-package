 ########################################################################
+# treq compatibility helpers
+########################################################################
+
+_treq_reactor_started = threading.Event()
+_treq_reactor_lock = threading.Lock()
+_treq_reactor_thread = None
+
+
+class _TreqHeaders(dict):
+    """Case-insensitive response headers compatible with requests headers."""
+
+    def get(self, key, default=None):
+        key = key.lower()
+        for header, value in self.items():
+            if header.lower() == key:
+                return value
+        return default
+
+
+class _TreqResponse:
+    """Small synchronous response wrapper for a treq response."""
+
+    def __init__(self, response, content):
+        self.status_code = response.code
+        self.reason = response.phrase.decode('utf-8', errors='replace') if response.phrase else ''
+        self.content = content
+        self.headers = _TreqHeaders()
+
+        for name in response.headers.getAllRawHeaders():
+            header_name = name.decode('utf-8') if isinstance(name, bytes) else name
+            values = response.headers.getRawHeaders(name)
+            values = [
+                value.decode('utf-8') if isinstance(value, bytes) else value
+                for value in values
+            ]
+            self.headers[header_name] = ', '.join(values)
+
+        self.is_redirect = (
+            self.status_code in (301, 302, 303, 307, 308)
+            and self.headers.get('location') is not None
+        )
+        self.raw = self
+
+    def json(self):
+        return json.loads(self.content.decode('utf-8'))
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise IOError(
+                "HTTP error {} {}".format(self.status_code, self.reason)
+            )
+
+    def iter_content(self, chunk_size=0x1000):
+        for offset in range(0, len(self.content), chunk_size):
+            yield self.content[offset:offset + chunk_size]
+
+    def readable(self):
+        return True
+
+    def close(self):
+        pass
+
+
+def _start_treq_reactor():
+    global _treq_reactor_thread
+
+    with _treq_reactor_lock:
+        if reactor.running:
+            return
+
+        if _treq_reactor_thread is None:
+            _treq_reactor_thread = threading.Thread(
+                target=_run_treq_reactor,
+                daemon=True
+            )
+            _treq_reactor_thread.start()
+
+    _treq_reactor_started.wait()
+
+
+def _run_treq_reactor():
+    _treq_reactor_started.set()
+    reactor.run(installSignalHandlers=False)
+
+
+def _treq_request(method, url, verify=True, timeout=None, headers=None, params=None, data=None):
+    """Perform a treq request while preserving the module's synchronous API."""
+
+    if not reactor.running:
+        _start_treq_reactor()
+
+    result = {}
+    finished = threading.Event()
+
+    def perform_request():
+        @defer.inlineCallbacks
+        def request():
+            try:
+                context_factory = (
+                    ssl.CertificateOptions()
+                    if verify
+                    else ssl.ClientContextFactory()
+                )
+                agent = Agent(reactor, contextFactory=context_factory)
+
+                request_args = {
+                    "headers": headers,
+                    "agent": agent,
+                }
+
+                if timeout is not None:
+                    request_args["timeout"] = timeout
+                if params is not None:
+                    request_args["params"] = params
+                if data is not None:
+                    request_args["data"] = data
+
+                response = yield treq.request(method, url, **request_args)
+                content = yield treq.content(response)
+                result["response"] = _TreqResponse(response, content)
+            except Exception as error:
+                result["error"] = error
+            finally:
+                finished.set()
+
+        request()
+
+    reactor.callFromThread(perform_request)
+    finished.wait()
+
+    if "error" in result:
+        raise result["error"]
+
+    return result["response"]
+
