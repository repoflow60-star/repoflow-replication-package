+class _PycurlHeaders(dict):
+    """Case-insensitive HTTP headers returned by pycurl."""
+
+    def __getitem__(self, key):
+        key_lower = key.lower()
+        for name, value in self.items():
+            if name.lower() == key_lower:
+                return value
+        raise KeyError(key)
+
+    def get(self, key, default=None):
+        key_lower = key.lower()
+        for name, value in self.items():
+            if name.lower() == key_lower:
+                return value
+        return default
+
+
+class _PycurlResponse:
+    """Small response adapter providing the attributes used by this module."""
+
+    def __init__(self, status_code, headers, content):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+        self.is_redirect = (
+            status_code in (301, 302, 303, 307, 308)
+            and headers.get('location') is not None
+        )
+        self.raw = io.BytesIO(content)
+
+    def json(self):
+        return json.loads(self.content.decode('utf-8'))
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise IOError("HTTP error {} for URL".format(self.status_code))
+
+    def iter_content(self, chunk_size=0x1000):
+        for offset in range(0, len(self.content), chunk_size):
+            yield self.content[offset:offset + chunk_size]
+
+    def close(self):
+        self.raw.close()
+
+
+def _pycurl_request(method, url, verify_ssl=True, timeout=None, headers=None,
+                    params=None, data=None, follow_redirects=True):
+    """Perform an HTTP request using pycurl."""
+
+    if params:
+        query = urllib.parse.urlencode(params, doseq=True)
+        url = "{}{}{}".format(url, '&' if '?' in url else '?', query)
+
+    content = io.BytesIO()
+    header_content = io.BytesIO()
+    curl = pycurl.Curl()
+
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEFUNCTION, content.write)
+        curl.setopt(pycurl.HEADERFUNCTION, header_content.write)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1 if follow_redirects else 0)
+        curl.setopt(pycurl.SSL_VERIFYPEER, 1 if verify_ssl else 0)
+        curl.setopt(pycurl.SSL_VERIFYHOST, 2 if verify_ssl else 0)
+        curl.setopt(pycurl.ACCEPT_ENCODING, "")
+
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT, int(timeout))
+
+        if headers:
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                ["{}: {}".format(key, value) for key, value in headers.items()]
+            )
+
+        if method == "HEAD":
+            curl.setopt(pycurl.NOBODY, 1)
+        elif method == "POST":
+            curl.setopt(pycurl.POST, 1)
+            if data is not None:
+                curl.setopt(pycurl.POSTFIELDS, urllib.parse.urlencode(data))
+        else:
+            curl.setopt(pycurl.HTTPGET, 1)
+
+        curl.perform()
+
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        raw_headers = header_content.getvalue()
+        parsed_headers = _PycurlHeaders()
+        current_status = None
+
+        for line in raw_headers.splitlines():
+            line = line.decode('iso-8859-1')
+            if line.startswith('HTTP/'):
+                current_status = line
+                parsed_headers = _PycurlHeaders()
+            elif ':' in line and current_status:
+                name, value = line.split(':', 1)
+                parsed_headers[name.strip()] = value.strip()
+
+        return _PycurlResponse(
+            status_code,
+            parsed_headers,
+            content.getvalue()
+        )
+    finally:
+        curl.close()
 
 
