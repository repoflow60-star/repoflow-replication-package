+def _to_rgb(color):
+    if isinstance(color, str):
+        color = color.lstrip("#")
+
+        if len(color) in (3, 4):
+            color = "".join(channel * 2 for channel in color)
+
+        if len(color) not in (6, 8):
+            raise ValueError("Invalid hexadecimal color")
+
+        return tuple(
+            int(color[index : index + 2], 16) / 255.0
+            for index in (0, 2, 4)
+        )
+
+    return tuple(np.asarray(color, dtype=float)[:3])
 
 
