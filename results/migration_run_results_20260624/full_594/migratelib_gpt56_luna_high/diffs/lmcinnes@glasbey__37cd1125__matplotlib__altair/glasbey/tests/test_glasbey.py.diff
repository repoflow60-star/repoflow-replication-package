+def to_rgb(color):
+    if isinstance(color, str):
+        color = color.lstrip("#")
+
+        if len(color) in (3, 4):
+            color = "".join(channel * 2 for channel in color)
+
+        if len(color) in (6, 8):
+            return tuple(
+                int(color[i : i + 2], 16) / 255.0 for i in range(0, 6, 2)
+            )
+
+        raise ValueError(f"Invalid color: {color}")
+
+    rgb = np.asarray(color, dtype=float)
+
+    if rgb.shape != (3,):
+        raise ValueError(f"Invalid color: {color}")
+
+    return tuple(rgb)
 
 
