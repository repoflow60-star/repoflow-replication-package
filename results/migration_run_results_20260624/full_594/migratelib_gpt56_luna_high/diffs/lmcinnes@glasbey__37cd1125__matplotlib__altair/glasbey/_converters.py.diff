+def _rgb2hex(color):
+    return "#{:02x}{:02x}{:02x}".format(
+        *[int(round(float(clip(channel, 0.0, 1.0)) * 255)) for channel in color[:3]]
+    )
+
+
+def _to_rgb(color):
+    if type(color) is str:
+        color = color.lower().strip()
+
+        if color.startswith("#"):
+            value = color[1:]
+
+            if len(value) in (3, 4):
+                value = "".join(channel * 2 for channel in value)
+
+            if len(value) not in (6, 8):
+                raise ValueError(f"Invalid color {color}")
+
+            return tuple(
+                int(value[index:index + 2], 16) / 255
+                for index in (0, 2, 4)
+            )
+
+        if color.startswith("rgb(") or color.startswith("rgba("):
+            value = color[color.index("(") + 1:color.rindex(")")]
+            channels = [float(channel.strip().rstrip("%")) for channel in value.split(",")[:3]]
+
+            if any(channel > 1.0 for channel in channels):
+                channels = [channel / 255 for channel in channels]
+
+            return tuple(channels)
+
+        if color in _CSS_COLORS:
+            return _to_rgb(_CSS_COLORS[color])
+
+        try:
+            grayscale = float(color)
+            return grayscale, grayscale, grayscale
+        except ValueError:
+            raise ValueError(f"Invalid color {color}")
+
+    values = asarray(color, dtype=float).reshape(-1)
+
+    if len(values) not in (3, 4):
+        raise ValueError(f"Invalid color {color}")
+
+    return tuple(values[:3])
+
+
+class _AltairColorMap:
+    def __init__(self, colors=None):
+        if colors is not None:
+            self.colors = [_to_rgb(color) for color in colors]
+        else:
+            self._colors = []
+
+    def __call__(self, values):
+        values = asarray(values, dtype=float)
+        result = []
+
+        for value in values:
+            value = float(clip(value, 0.0, 1.0))
+            position = value * (len(self._colors) - 1)
+            lower = int(position)
+            upper = min(lower + 1, len(self._colors) - 1)
+            fraction = position - lower
+
+            color = (
+                (1.0 - fraction) * self._colors[lower]
+                + fraction * self._colors[upper]
+            )
+
+            result.append([color[0], color[1], color[2], 1.0])
+
+        return array(result, dtype=float32)
+
+
+def _get_cmap(name):
+    scheme = alt.Scale(scheme=name).scheme
+
+    if scheme in _ALTair_DISCRETE_SCHEMES:
+        return _AltairColorMap(_ALTair_DISCRETE_SCHEMES[scheme])
+
+    if scheme in _ALTair_CONTINUOUS_SCHEMES:
+        cmap = _AltairColorMap()
+        cmap._colors = array(
+            [_to_rgb(color) for color in _ALTair_CONTINUOUS_SCHEMES[scheme]],
+            dtype=float32,
+        )
+        return cmap
+
+    raise ValueError(f"Unrecognized palette name {name}")
 
 
