+class Mocker:
+    def __init__(self):
+        self._responses = []
+
+    def __enter__(self):
+        self._patcher = patch.object(
+            urllib3.PoolManager,
+            "request",
+            side_effect=self._request,
+        )
+        self._patcher.start()
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        self._patcher.stop()
+
+    def get(self, url, headers=None, content=None, text=None, exc=None):
+        if content is None and text is not None:
+            content = text.encode()
+
+        self._responses.append(
+            {
+                "url": url,
+                "headers": headers or {},
+                "content": content or b"",
+                "exc": exc,
+            }
+        )
+
+    def _request(self, method, url, **kwargs):
+        for response in self._responses:
+            if response["url"] == url:
+                if response["exc"] is not None:
+                    raise response["exc"]
+
+                return HTTPResponse(
+                    body=response["content"],
+                    headers=response["headers"],
+                    status=200,
+                )
+
+        raise AssertionError(f"No mocked response for {url}")
 
 
