+class _Urllib3Cookies:
+    def __init__(self):
+        self._cookies = {}
+
+    def clear(self):
+        self._cookies.clear()
+
+    def update(self, response):
+        try:
+            set_cookie_headers = response.headers.getlist("Set-Cookie")
+        except AttributeError:
+            set_cookie_header = response.headers.get("Set-Cookie")
+            set_cookie_headers = [set_cookie_header] if set_cookie_header else []
+
+        for set_cookie_header in set_cookie_headers:
+            cookies = SimpleCookie()
+            cookies.load(set_cookie_header)
+            for name, morsel in cookies.items():
+                max_age = morsel["max-age"]
+                if max_age:
+                    try:
+                        if int(max_age) <= 0:
+                            self._cookies.pop(name, None)
+                            continue
+                    except ValueError:
+                        pass
+                self._cookies[name] = morsel.value
+
+    def header(self):
+        return "; ".join(
+            "%s=%s" % (name, value) for name, value in self._cookies.items()
+        )
+
+
+class _Urllib3Response:
+    def __init__(self, response, url, history):
+        self._response = response
+        self.url = url
+        self.history = list(history)
+        self.content = response.data
+        self.headers = response.headers
+        self.status = response.status
+        self.reason = response.reason
+
+    @property
+    def text(self):
+        return self.content.decode("utf-8", errors="replace")
+
+    def raise_for_status(self):
+        if self.status >= 400:
+            error = urllib3.exceptions.HTTPError(
+                "%s %s for url: %s" % (self.status, self.reason, self.url)
+            )
+            error.response = self
+            raise error
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
+
+class _Urllib3Session:
+    def __init__(self):
+        self._pool = urllib3.PoolManager()
+        self.cookies = _Urllib3Cookies()
+
+    def _request(self, method, url, data=None):
+        history = []
+        current_url = url
+        current_method = method
+        current_data = data
+
+        for _ in range(30):
+            headers = {}
+            cookie_header = self.cookies.header()
+            if cookie_header:
+                headers["Cookie"] = cookie_header
+
+            if current_method == "POST":
+                response = self._pool.request(
+                    current_method,
+                    current_url,
+                    fields=current_data,
+                    encode_multipart=False,
+                    headers=headers,
+                    redirect=False,
+                )
+            else:
+                response = self._pool.request(
+                    current_method,
+                    current_url,
+                    headers=headers,
+                    redirect=False,
+                )
+
+            self.cookies.update(response)
+            wrapped_response = _Urllib3Response(
+                response=response,
+                url=current_url,
+                history=history,
+            )
+
+            location = response.headers.get("Location")
+            if response.status not in (301, 302, 303, 307, 308) or not location:
+                return wrapped_response
+
+            history.append(wrapped_response)
+            current_url = urljoin(current_url, location)
+
+            if response.status == 303 or (
+                response.status in (301, 302) and current_method == "POST"
+            ):
+                current_method = "GET"
+                current_data = None
+
+        raise urllib3.exceptions.HTTPError("Too many redirects")
+
+    def get(self, url):
+        return self._request("GET", url)
+
+    def post(self, url, data=None):
+        return self._request("POST", url, data=data)
 
 
