+def _pkcs12_kdf(
+    password: bytes,
+    salt: bytes,
+    id_byte: int,
+    length: int,
+    iterations: int,
+    hash_module,
+) -> bytes:
+    password = _pkcs12_password(password)
+
+    digest_size = hash_module.digest_size
+    block_size = hash_module.block_size
+
+    diversifier = bytes([id_byte]) * block_size
+    salt_value = salt * ((block_size + len(salt) - 1) // len(salt)) if salt else b''
+    password_value = (
+        password * ((block_size + len(password) - 1) // len(password))
+        if password
+        else b''
+    )
+
+    internal_state = bytearray(salt_value + password_value)
+    result = bytearray()
+
+    for offset in range(0, length, digest_size):
+        value = hash_module.new(diversifier + bytes(internal_state)).digest()
+
+        for _ in range(1, iterations):
+            value = hash_module.new(value).digest()
+
+        result.extend(value)
+
+        if internal_state:
+            adjustment = int.from_bytes(
+                (value * ((block_size + len(value) - 1) // len(value)))[:block_size],
+                'big',
+            ) + 1
+
+            for block_offset in range(0, len(internal_state), block_size):
+                block = int.from_bytes(
+                    internal_state[block_offset:block_offset + block_size],
+                    'big',
+                )
+                block = (
+                    block
+                    + adjustment
+                ) % (1 << (8 * block_size))
+                internal_state[block_offset:block_offset + block_size] = block.to_bytes(
+                    block_size,
+                    'big',
+                )
+
+    return bytes(result[:length])
