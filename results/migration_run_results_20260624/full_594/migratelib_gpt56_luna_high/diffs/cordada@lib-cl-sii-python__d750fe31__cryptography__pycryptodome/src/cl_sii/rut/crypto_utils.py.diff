+    auth_safe_content = _der_read(auth_safe_content_info[1][1])
+    authenticated_safe = auth_safe_content[1]
+
+    if len(pfx_children) > 2:
+        _verify_pkcs12_mac(
+            mac_data=pfx_children[2][1],
+            authenticated_safe=authenticated_safe,
+            password=password,
+        )
+
+    certificates = []
+
+    for content_info in _der_children(_der_read(authenticated_safe)[1]):
+        content_info_children = _der_children(content_info[1])
+        content_type = _der_oid(content_info_children[0][1])
+        content = _der_read(content_info_children[1][1])
+
+        if content_type == '1.2.840.113549.1.7.1':
+            certificates.extend(
+                _extract_certificates_from_safe_contents(content[1]),
