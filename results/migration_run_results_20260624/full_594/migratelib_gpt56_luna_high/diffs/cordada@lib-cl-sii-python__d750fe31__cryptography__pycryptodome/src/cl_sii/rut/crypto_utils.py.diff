+def _verify_pkcs12_mac(
+    mac_data: bytes,
+    authenticated_safe: bytes,
+    password: bytes,
+) -> None:
+    mac_data_children = _der_children(mac_data)
+    digest_info = _der_children(mac_data_children[0][1])
+    digest_oid, _ = _algorithm_identifier(digest_info[0][1])
+    digest = digest_info[1][1]
+    salt = mac_data_children[1][1]
+    iterations = (
+        _der_integer(mac_data_children[2][1])
+        if len(mac_data_children) > 2
+        else 1
+    )
+
+    hash_module = _hash_module_from_oid(digest_oid)
+    if hash_module is None:
+        raise ValueError(f'Unsupported PKCS12 MAC algorithm: {digest_oid}')
+
+    mac_key = _pkcs12_kdf(
+        password=password,
+        salt=salt,
+        id_byte=3,
+        length=hash_module.digest_size,
+        iterations=iterations,
+        hash_module=hash_module,
+    )
+
+    calculated_digest = HMAC.new(
+        mac_key,
+        authenticated_safe,
+        digestmod=hash_module,
+    ).digest()
+
+    if calculated_digest != digest:
+        raise ValueError('Invalid PKCS12 password or MAC')
+
