+                '1.2.840.113549.2.9': SHA224,
+                '1.2.840.113549.2.9': SHA256,
+                '1.2.840.113549.2.10': SHA384,
+                '1.2.840.113549.2.11': SHA512,
+            }.get(prf_oid)
+
+            if prf_hash_module is None:
+                raise ValueError(f'Unsupported PBKDF2 PRF: {prf_oid}')
+
+    encryption_parameters_value = (
+        encryption_parameters[1]
+        if encryption_parameters is not None
+        else None
+    )
+    if encryption_parameters_value is None:
+        raise ValueError('Missing PBES2 encryption parameters')
+
+    encryption_iv = encryption_parameters_value
+
+    cipher_information = {
+        '2.16.840.1.101.3.4.1.2': (AES, 16),
+        '2.16.840.1.101.3.4.1.22': (AES, 24),
+        '2.16.840.1.101.3.4.1.42': (AES, 32),
+        '1.2.840.113549.3.7': (DES3, 24),
+    }
