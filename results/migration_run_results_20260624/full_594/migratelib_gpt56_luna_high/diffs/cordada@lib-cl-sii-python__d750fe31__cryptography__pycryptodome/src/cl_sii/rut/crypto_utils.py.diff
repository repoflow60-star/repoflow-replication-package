+def _decrypt_encrypted_data(
+    encrypted_data: bytes,
+    password: bytes,
+) -> bytes:
+    encrypted_data_children = _der_children(encrypted_data)
+    encrypted_content_info = encrypted_data_children[1][1]
+    encrypted_content_info_children = _der_children(encrypted_content_info)
+
+    algorithm_oid, algorithm_parameters = _algorithm_identifier(
+        encrypted_content_info_children[1][1],
+    )
+
+    encrypted_content = encrypted_content_info_children[2]
+    if encrypted_content[0] == 0x80:
+        encrypted_value = encrypted_content[1]
+    elif encrypted_content[0] == 0xA0:
+        encrypted_value = _der_read(encrypted_content[1])[1]
+    else:
+        raise ValueError('Malformed encrypted content')
+
+    if algorithm_oid == '1.2.840.113549.1.5.13':
+        return _decrypt_pbes2(
+            parameters=algorithm_parameters,
+            password=password,
+            encrypted_data=encrypted_value,
+        )
+
+    return _decrypt_pkcs12_pbe(
+        algorithm_oid=algorithm_oid,
+        parameters=algorithm_parameters,
+        password=password,
+        encrypted_data=encrypted_value,
+    )
