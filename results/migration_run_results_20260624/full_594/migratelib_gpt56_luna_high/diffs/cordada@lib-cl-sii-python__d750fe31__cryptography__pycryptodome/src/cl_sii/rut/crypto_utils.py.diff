+def _decrypt_pbes2(
+    parameters,
+    password: bytes,
+    encrypted_data: bytes,
+) -> bytes:
+    if parameters is None or parameters[0] != 0x30:
+        raise ValueError('Malformed PBES2 parameters')
+
+    pbes2_parameters = _der_children(parameters[1])
+    kdf_oid, kdf_parameters = _algorithm_identifier(pbes2_parameters[0][1])
