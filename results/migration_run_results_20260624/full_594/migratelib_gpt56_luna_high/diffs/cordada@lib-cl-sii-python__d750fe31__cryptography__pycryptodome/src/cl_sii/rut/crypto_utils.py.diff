+def _der_read(data: bytes, offset: int = 0):
+    if offset >= len(data):
+        raise ValueError('Malformed DER data')
+
+    tag = data[offset]
+    offset += 1
+
+    if offset >= len(data):
+        raise ValueError('Malformed DER length')
+
+    length = data[offset]
+    offset += 1
+
+    if length & 0x80:
+        length_bytes = length & 0x7F
+        if length_bytes == 0 or offset + length_bytes > len(data):
+            raise ValueError('Malformed DER length')
+
+        length = int.from_bytes(data[offset:offset + length_bytes], 'big')
+        offset += length_bytes
+
+    end = offset + length
+    if end > len(data):
+        raise ValueError('Malformed DER value')
+
+    return tag, data[offset:end], end
+
+
+def _der_children(data: bytes):
+    children = []
+    offset = 0
+
+    while offset < len(data):
+        tag, value, end = _der_read(data, offset)
+        children.append((tag, value, end))
+        offset = end
+
+    return children
+
+
+def _der_integer(value: bytes) -> int:
+    return int.from_bytes(value, 'big', signed=False)
+
+
+def _der_oid(value: bytes) -> str:
+    if not value:
+        raise ValueError('Malformed DER OID')
+
+    first = value[0]
+    if first < 40:
+        first_arc = 0
+        second_arc = first
+    elif first < 80:
+        first_arc = 1
+        second_arc = first - 40
+    else:
+        first_arc = 2
+        second_arc = first - 80
+
+    arcs = [first_arc, second_arc]
+    current = 0
+
+    for byte in value[1:]:
+        current = (current << 7) | (byte & 0x7F)
+        if not byte & 0x80:
+            arcs.append(current)
+            current = 0
+
+    if current:
+        raise ValueError('Malformed DER OID')
+
+    return '.'.join(str(arc) for arc in arcs)
+
+
+def _algorithm_identifier(data: bytes):
+    children = _der_children(data)
+    if not children:
+        raise ValueError('Malformed algorithm identifier')
+
+    oid = _der_oid(children[0][1])
+    parameters = children[1] if len(children) > 1 else None
+
+    return oid, parameters
