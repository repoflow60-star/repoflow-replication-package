+def _decrypt_pkcs12_pbe(
+    algorithm_oid: str,
+    parameters,
+    password: bytes,
+    encrypted_data: bytes,
+) -> bytes:
+    if parameters is None or parameters[0] != 0x30:
+        raise ValueError('Malformed PKCS12 PBE parameters')
+
+    pbe_parameters = _der_children(parameters[1])
+    salt = pbe_parameters[0][1]
+    iterations = _der_integer(pbe_parameters[1][1])
+
+    pbe_algorithms = {
+        '1.2.840.113549.1.12.1.1': (ARC4, 16, None, None),
+        '1.2.840.113549.1.12.1.2': (ARC4, 5, None, None),
+        '1.2.840.113549.1.12.1.3': (DES3, 24, 8, None),
+        '1.2.840.113549.1.12.1.4': (DES3, 16, 8, None),
+        '1.2.840.113549.1.12.1.5': (ARC2, 16, 8, 128),
+        '1.2.840.113549.1.12.1.6': (ARC2, 5, 8, 40),
+    }
+
+    cipher_class, key_length, iv_length, effective_key_length = pbe_algorithms.get(
+        algorithm_oid,
+        (None, None, None, None),
+    )
+
+    if cipher_class is None:
+        raise ValueError(f'Unsupported PKCS12 PBE algorithm: {algorithm_oid}')
+
+    key = _pkcs12_kdf(
+        password=password,
+        salt=salt,
+        id_byte=1,
+        length=key_length,
+        iterations=iterations,
+        hash_module=SHA1,
+    )
+
+    if iv_length is None:
+        cipher = cipher_class.new(key)
+        return cipher.decrypt(encrypted_data)
+
+    iv = _pkcs12_kdf(
+        password=password,
+        salt=salt,
+        id_byte=2,
+        length=iv_length,
+        iterations=iterations,
+        hash_module=SHA1,
+    )
+
+    if cipher_class is ARC2:
+        cipher = cipher_class.new(
+            key,
+            cipher_class.MODE_CBC,
+            iv,
+            effective_keylen=effective_key_length,
+        )
+    else:
+        cipher = cipher_class.new(key, cipher_class.MODE_CBC, iv)
