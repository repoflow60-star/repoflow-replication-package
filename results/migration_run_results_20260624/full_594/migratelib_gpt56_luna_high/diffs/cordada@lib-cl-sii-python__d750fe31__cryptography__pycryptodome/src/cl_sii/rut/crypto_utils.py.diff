+def _extract_certificates_from_safe_contents(
+    safe_contents: bytes,
+) -> list[bytes]:
+    safe_contents_children = _der_children(_der_read(safe_contents)[1])
+    certificates = []
+
+    for safe_bag in safe_contents_children:
+        safe_bag_children = _der_children(safe_bag[1])
+        bag_id = _der_oid(safe_bag_children[0][1])
+        bag_value = safe_bag_children[1]
+
+        if bag_value[0] != 0xA0:
+            continue
+
+        bag_value_der = _der_read(bag_value[1])
+        bag_value_children = _der_children(bag_value_der[1])
+
+        if bag_id == '1.2.840.113549.1.12.10.1.3':
+            cert_id = _der_oid(bag_value_children[0][1])
+            if cert_id != '1.2.840.113549.1.9.22.1':
+                continue
+
+            cert_value = bag_value_children[1]
+            cert_value_der = _der_read(cert_value[1])
+            certificates.append(cert_value_der[1])
+        elif bag_id == '1.2.840.113549.1.12.10.1.6':
+            certificates.extend(
+                _extract_certificates_from_safe_contents(bag_value_der[1]),
+            )
+
+    return certificates
