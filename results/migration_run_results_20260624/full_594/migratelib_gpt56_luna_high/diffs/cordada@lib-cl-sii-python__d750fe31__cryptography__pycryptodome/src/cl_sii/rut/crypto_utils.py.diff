+def _get_other_name_value(value: bytes) -> bytes:
+    current_value = value
+
+    for _ in range(2):
+        try:
+            tag, nested_value, end = _der_read(current_value)
+        except ValueError:
+            break
+
+        if end != len(current_value):
+            break
+
+        if tag in (0x04, 0x0C, 0x13, 0x16, 0x1A, 0x1E):
+            current_value = nested_value
+        else:
+            break
+
+    return current_value
+
