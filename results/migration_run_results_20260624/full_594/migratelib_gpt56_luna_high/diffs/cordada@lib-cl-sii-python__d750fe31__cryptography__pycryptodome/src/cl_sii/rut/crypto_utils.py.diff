+        raise ValueError('Malformed PBKDF2 parameters')
+
+    pbkdf2_parameters = _der_children(kdf_parameters[1])
+    salt = pbkdf2_parameters[0][1]
+    iterations = _der_integer(pbkdf2_parameters[1][1])
+
+    key_length = None
