+class _MakoTemplateLookup(TemplateLookup):
+    def get_template(self, uri):
+        try:
+            return super().get_template(uri)
+        except TopLevelNotFound:
+            if uri.startswith(('${', '<%', '%')):
+                return Template(text=uri, lookup=self)
+
+            name = os.path.abspath(uri)
+            if os.path.isfile(name):
+                return Template(
+                    filename=name,
+                    lookup=self,
+                    input_encoding='utf-8',
+                )
+
+            raise
+
