+            value = '(' + value + ')'
+
+        return _SQLExpression(
+            '{} IN {}'.format(self, value),
+            self.dialect,
+            40
+        )
+
+    def notin_(self, value):
+        if isinstance(value, (_SQLExpression, _SQLQuery)):
+            value = str(value)
+        else:
+            value = ', '.join(
+                str(self._coerce(i))
+                for i in value
+            )
+            value = '(' + value + ')'
+
+        return _SQLExpression(
+            '{} NOT IN {}'.format(self, value),
+            self.dialect,
+            40
+        )
+
+    def op(self, operator):
+        def operation(value):
+            return self._binary(operator, value, 40)
+
+        return operation
+
+    def concat(self, value):
+        return self._binary('||', value, 60)
+
