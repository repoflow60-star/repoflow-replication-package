+def _quote_identifier(value, dialect):
+    value = str(value)
+
+    if value == '*':
+        return value
+
+    if re.match(r'^[a-z_][a-z0-9_]*$', value):
+        return value
+
+    if dialect.name == 'mysql':
+        return '`' + value.replace('`', '``') + '`'
+    if dialect.name == 'mssql':
+        return '[' + value.replace(']', ']]') + ']'
+
+    return '"' + value.replace('"', '""') + '"'
+
+
+def _literal(value):
+    if value is None:
+        return 'NULL'
+
+    if isinstance(value, bool):
+        return 'TRUE' if value else 'FALSE'
+
+    if isinstance(value, (str, dt.date, dt.datetime, dt.timedelta)):
+        return "'{}'".format(str(value).replace("'", "''"))
+
+    return str(value)
+
+
+class _SQLExpression(sqlbuilder.SQLExpression):
+
+    def __init__(self, sql, dialect, precedence=100):
+        self.sql = sql
+        self.dialect = dialect
+        self.precedence = precedence
+
+    def __sqlrepr__(self, db):
+        return self.sql
+
+    def __str__(self):
+        return self.sql
+
+    def _coerce(self, value):
+        if isinstance(value, (_SQLExpression, _SQLQuery)):
+            return value
+
+        return _SQLExpression(_literal(value), self.dialect, 100)
+
+    def _value(self, value, parent_precedence=0):
+        value = self._coerce(value)
+
+        if value.precedence < parent_precedence:
+            return '(' + str(value) + ')'
+
+        return str(value)
+
+    def _binary(self, operator, value, precedence=40):
+        value = self._coerce(value)
+
+        left = str(self)
+        right = str(value)
+
+        if self.precedence < precedence:
+            left = '(' + left + ')'
+
+        if value.precedence < precedence:
+            right = '(' + right + ')'
+
+        return _SQLExpression(
+            '{} {} {}'.format(left, operator, right),
+            self.dialect,
+            precedence
+        )
+
+    def __add__(self, value):
+        return self._binary('+', value, 60)
+
+    def __sub__(self, value):
+        return self._binary('-', value, 60)
+
+    def __truediv__(self, value):
+        return self._binary('/', value, 60)
+
+    def __mul__(self, value):
+        return self._binary('*', value, 60)
+
+    def __mod__(self, value):
+        return self._binary('%', value, 60)
+
+    def __eq__(self, value):
+        return self._binary('=', value, 40)
+
+    def __ne__(self, value):
+        return self._binary('<>', value, 40)
+
+    def __gt__(self, value):
+        return self._binary('>', value, 40)
+
+    def __lt__(self, value):
+        return self._binary('<', value, 40)
+
+    def __ge__(self, value):
+        return self._binary('>=', value, 40)
+
+    def __le__(self, value):
+        return self._binary('<=', value, 40)
+
+    def __invert__(self):
+        return _SQLExpression(
+            'NOT {}'.format(self._value(self, 70)),
+            self.dialect,
+            70
+        )
+
+    def __neg__(self):
+        return _SQLExpression(
+            '-{}'.format(self._value(self, 70)),
+            self.dialect,
+            70
+        )
+
+    def is_(self, value):
+        return self._binary('IS', value, 40)
+
+    def is_not(self, value):
+        return self._binary('IS NOT', value, 40)
+
+    def like(self, value):
+        return self._binary('LIKE', value, 40)
+
+    def notlike(self, value):
+        return self._binary('NOT LIKE', value, 40)
+
+    def in_(self, value):
