+class _PycurlSession:
+    def __init__(self) -> None:
+        self.headers = {}
+        self.cookies = {}
+
+    def _request(
+        self,
+        method: str,
+        url: str,
+        data=None,
+        params=None,
+        headers=None,
+        json=None,
+    ) -> _PycurlResponse:
+        if params:
+            separator = "&" if "?" in url else "?"
+            url = f"{url}{separator}{urlencode(params)}"
+
+        request_headers = self.headers.copy()
+        if headers:
+            request_headers.update(headers)
+
+        if json is not None:
+            data = jsonlib.dumps(json).encode("utf-8")
+            request_headers["Content-Type"] = "application/json"
+        elif isinstance(data, dict):
+            data = urlencode(data).encode("utf-8")
+        elif isinstance(data, str):
+            data = data.encode("utf-8")
+
+        response_buffer = io.BytesIO()
+
+        def header_function(header_line):
+            header = header_line.decode("iso-8859-1").strip()
+            if header.lower().startswith("set-cookie:"):
+                response_cookie = SimpleCookie()
+                response_cookie.load(header.split(":", 1)[1].strip())
+                for key, morsel in response_cookie.items():
