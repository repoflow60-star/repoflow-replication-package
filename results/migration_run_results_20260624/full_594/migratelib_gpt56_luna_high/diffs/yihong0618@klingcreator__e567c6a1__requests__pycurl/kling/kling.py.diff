+            return len(header_line)
+
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEFUNCTION, response_buffer.write)
+            curl.setopt(pycurl.HEADERFUNCTION, header_function)
+            curl.setopt(pycurl.FOLLOWLOCATION, True)
+            curl.setopt(pycurl.ACCEPT_ENCODING, "")
+
+            if request_headers:
+                curl.setopt(
+                    pycurl.HTTPHEADER,
+                    [f"{key}: {value}" for key, value in request_headers.items()],
+                )
+
+            if self.cookies:
+                curl.setopt(
+                    pycurl.COOKIE,
+                    "; ".join(
+                        f"{key}={value}" for key, value in self.cookies.items()
+                    ),
+                )
+
+            if method == "POST":
+                curl.setopt(pycurl.POST, True)
+                curl.setopt(pycurl.POSTFIELDS, data or b"")
+            else:
+                curl.setopt(pycurl.HTTPGET, True)
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            response_content = response_buffer.getvalue()
+        finally:
+            curl.close()
+
+        return _PycurlResponse(response_content, status_code)
+
+    def get(self, url, params=None, headers=None):
+        return self._request("GET", url, params=params, headers=headers)
+
+    def post(self, url, data=None, params=None, headers=None, json=None):
+        return self._request(
+            "POST",
+            url,
+            data=data,
+            params=params,
+            headers=headers,
+            json=json,
