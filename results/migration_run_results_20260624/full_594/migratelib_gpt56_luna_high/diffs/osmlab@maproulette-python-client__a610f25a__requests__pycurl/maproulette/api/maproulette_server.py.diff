+    def _headers(self, json_body=False, multipart=False):
+        headers = []
+        for key, value in self.headers.items():
+            if multipart and key.lower() == 'content-type':
+                continue
+            headers.append(f"{key}: {value}")
+        if json_body and not any(header.lower().startswith('content-type:') for header in headers):
+            headers.append('Content-Type: application/json')
+        return headers
+
+    def _set_ssl_options(self, curl):
+        if self.verify is False:
+            curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+            curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+        else:
+            curl.setopt(pycurl.SSL_VERIFYPEER, 1)
+            curl.setopt(pycurl.SSL_VERIFYHOST, 2)
+            if isinstance(self.verify, str):
+                curl.setopt(pycurl.CAINFO, self.verify)
+
+        if isinstance(self.certs, (tuple, list)):
+            curl.setopt(pycurl.SSLCERT, self.certs[0])
+            if len(self.certs) > 1:
+                curl.setopt(pycurl.SSLKEY, self.certs[1])
+        elif self.certs:
+            curl.setopt(pycurl.SSLCERT, self.certs)
+
+    def _url_with_params(self, url, params):
+        if params is None:
+            return url
+        if isinstance(params, str):
+            query = params
+        else:
+            query = urlencode(params, doseq=True)
+        separator = '&' if '?' in url else '?'
+        return url + separator + query
+
+    @staticmethod
+    def _multipart_fields(body):
+        fields = []
+        if body is None:
+            return fields
+
+        if hasattr(body, 'items'):
+            body = body.items()
+
+        for name, value in body:
+            if isinstance(value, tuple):
+                filename = value[0] if len(value) > 0 else name
+                content = value[1] if len(value) > 1 else b''
+
+                if hasattr(content, 'read'):
+                    content = content.read()
+
+                if isinstance(content, str):
+                    content = content.encode()
+                elif not isinstance(content, bytes):
+                    content = str(content).encode()
+
+                form_value = (
+                    pycurl.FORM_BUFFER,
+                    filename,
+                    content
+                )
+
+                if len(value) > 2 and value[2]:
+                    form_value = form_value + (
+                        pycurl.FORM_CONTENTTYPE,
+                        value[2]
+                    )
+
+                fields.append((name, form_value))
+            elif hasattr(value, 'read'):
+                content = value.read()
+                if isinstance(content, str):
+                    content = content.encode()
+                filename = getattr(value, 'name', name)
+                fields.append((
+                    name,
+                    (
+                        pycurl.FORM_BUFFER,
+                        filename,
+                        content
+                    )
+                ))
+            else:
+                fields.append((name, value))
+
+        return fields
