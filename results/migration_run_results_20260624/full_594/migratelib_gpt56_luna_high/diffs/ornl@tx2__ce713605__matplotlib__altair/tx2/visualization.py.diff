+def _wordcloud_data_url(cloud):
+    image = cloud.to_image()
+    buffer = io.BytesIO()
+    image.save(buffer, format="PNG")
+    return (
+        "data:image/png;base64,"
+        + base64.b64encode(buffer.getvalue()).decode("ascii")
+    )
+
+
+def _wordcloud_chart(cloud, name, width=800, height=400):
+    temp_df = pd.DataFrame({"url": [_wordcloud_data_url(cloud)]})
+
+    fig = (
+        alt.Chart(temp_df)
+        .mark_image(width=width, height=height)
+        .encode(
+            x=alt.value(width / 2),
+            y=alt.value(height / 2),
+            url=alt.Url("url:N"),
+        )
+        .properties(width=width, height=height, title=name)
+        .configure_view(stroke=None)
+    )
+    return fig
+
