+                        "classification": classification,
+                        "classification_order": int(classification),
+                        "order": index,
+                    }
+                )
+
+        temp_df = pd.DataFrame(bar_rows)
+        classification_domain = [
+            str(classification) for classification in encodings.values()
+        ]
+
+        charts.append(
+            alt.Chart(temp_df)
+            .mark_bar()
+            .encode(
+                x=alt.X("value:Q", stack="zero", title=None),
+                y=alt.Y(
+                    "word:N",
+                    sort=alt.SortField(field="order", order="ascending"),
+                    title=None,
+                ),
+                color=alt.Color(
+                    "classification:N",
+                    scale=alt.Scale(
+                        domain=classification_domain,
+                        range=list(colors),
+                    ),
+                    legend=None,
+                ),
+                order=alt.Order(
+                    "classification_order:Q",
+                    sort="ascending",
+                ),
+            )
+            .properties(
+                width=250,
+                height=160,
+                title=str(cluster),
+            )
+        )
+
+    fig = alt.concat(*charts, columns=num_cols).configure_view(stroke=None)
     return fig
