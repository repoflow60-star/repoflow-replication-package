+def _projection_layer(
+    x,
+    y,
+    colors,
+    dashboard,
+    alpha,
+    size,
+    show_legend=False,
+):
+    labels = list(dashboard.transformer_wrapper.encodings.keys())
+    color_to_label = {
+        str(color): labels[index]
+        for index, color in enumerate(dashboard.colors)
+    }
+
+    temp_df = pd.DataFrame(
+        {
+            "x": list(x),
+            "y": list(y),
+            "label": [
+                color_to_label.get(str(color), str(color)) for color in list(colors)
+            ],
+        }
+    )
+
+    return (
+        alt.Chart(temp_df)
+        .mark_point(opacity=alpha, size=size, filled=True)
+        .encode(
+            x=alt.X("x:Q", title=None),
+            y=alt.Y("y:Q", title=None),
+            color=alt.Color(
+                "label:N",
+                scale=alt.Scale(
+                    domain=labels,
+                    range=list(dashboard.colors),
+                ),
+                legend=alt.Legend() if show_legend else None,
+            ),
+        )
+    )
+
+
+def _projection_point_layer(x, y, color, size, edge_color="black"):
