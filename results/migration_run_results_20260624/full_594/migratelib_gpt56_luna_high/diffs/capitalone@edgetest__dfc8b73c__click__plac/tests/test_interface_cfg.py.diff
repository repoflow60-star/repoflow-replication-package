 CURR_DIR = Path(__file__).resolve().parent
+
+
+class PlacRunner:
+    """Provide Click CliRunner-like functionality for plac."""
+
+    @contextmanager
+    def isolated_filesystem(self):
+        """Run commands in an isolated temporary filesystem."""
+        old_dir = os.getcwd()
+
+        with tempfile.TemporaryDirectory() as loc:
+            os.chdir(loc)
+            try:
+                yield loc
+            finally:
+                os.chdir(old_dir)
+
+    def invoke(self, command, args=None):
+        """Invoke a plac command and capture its output."""
+        output = StringIO()
+        exit_code = 0
+
+        try:
+            with redirect_stdout(output):
+                plac.call(command, args or [])
+        except SystemExit as exc:
+            exit_code = exc.code if isinstance(exc.code, int) else 1
+
+        return SimpleNamespace(
+            exit_code=exit_code,
+            output=output.getvalue(),
+        )
+
 
