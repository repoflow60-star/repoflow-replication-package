-from click.testing import CliRunner
+import plac
 
 from edgetest.interface import cli
 
 CURR_DIR = Path(__file__).resolve().parent
+
+
+class PlacRunner:
+    """Test helper for invoking a plac CLI."""
+
+    @contextmanager
+    def isolated_filesystem(self):
+        """Run within a temporary working directory."""
+        with tempfile.TemporaryDirectory() as loc:
+            curr_dir = os.getcwd()
+            os.chdir(loc)
+            try:
+                yield loc
+            finally:
+                os.chdir(curr_dir)
+
+    def invoke(self, command, args=None):
+        """Invoke a plac command and capture its output."""
+        output = StringIO()
+        exit_code = 0
+
+        with patch("sys.argv", ["cli"] + list(args or [])):
+            with redirect_stdout(output):
+                try:
+                    plac.Interpreter(command).run()
+                except SystemExit as exc:
+                    exit_code = 0 if exc.code is None else exc.code
+                    if not isinstance(exit_code, int):
+                        exit_code = 1
+
+        return SimpleNamespace(exit_code=exit_code, output=output.getvalue())
+
 
