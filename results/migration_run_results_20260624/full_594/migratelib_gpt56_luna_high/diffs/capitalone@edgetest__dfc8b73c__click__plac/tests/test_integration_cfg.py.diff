+        outfile.write(MODULE_CODE)
+    # Make a directory for the tests
+    Path(loc, "tests").mkdir()
+    with open(Path(loc, "tests", "test_main.py"), "w") as outfile:
+        outfile.write(TEST_CODE)
+
