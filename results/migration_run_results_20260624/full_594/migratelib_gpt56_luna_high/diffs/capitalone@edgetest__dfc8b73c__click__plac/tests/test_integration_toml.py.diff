+class PlacRunner:
+    @contextmanager
+    def isolated_filesystem(self):
+        with TemporaryDirectory() as loc:
+            current_directory = os.getcwd()
+            os.chdir(loc)
+            try:
+                yield loc
+            finally:
+                os.chdir(current_directory)
+
+    def invoke(self, command, args):
+        stdout = io.StringIO()
+
+        try:
+            with redirect_stdout(stdout):
+                plac.Interpreter(command).call(*args)
+        except SystemExit as exc:
+            if exc.code is None:
+                exit_code = 0
+            elif isinstance(exc.code, int):
+                exit_code = exc.code
+            else:
+                exit_code = 1
+        except Exception:
+            exit_code = 1
+        else:
+            exit_code = 0
+
+        return type(
+            "Result",
+            (),
+            {"exit_code": exit_code, "stdout": stdout.getvalue()},
+        )()
