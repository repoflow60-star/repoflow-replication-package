+class _PycurlStream:
+    def __init__(self, url: str, headers: dict, data: str) -> None:
+        self._url = url
+        self._headers = [
+            f"{key}: {value}" for key, value in headers.items()
+        ]
+        if not any(
+            header.lower().startswith("content-type:")
+            for header in self._headers
+        ):
+            self._headers.append("Content-Type: application/json")
+        self._data = data
+        self._chunks = queue.Queue()
+        self._response_ready = threading.Event()
+        self._stop = threading.Event()
+        self._error = None
+        self.status_code = None
+        self._thread = threading.Thread(target=self._perform, daemon=True)
+        self._thread.start()
+        self._response_ready.wait()
+
+    def _header(self, header: bytes) -> int:
+        if header.startswith(b"HTTP/"):
+            status_line = header.decode("iso-8859-1").split()
+            if len(status_line) > 1:
+                try:
+                    self.status_code = int(status_line[1])
+                except ValueError:
+                    pass
+        return len(header)
+
+    def _write(self, chunk: bytes) -> int:
+        if self._stop.is_set():
+            return 0
+        self._response_ready.set()
+        self._chunks.put(chunk)
+        return len(chunk)
+
+    def _perform(self) -> None:
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, self._url)
+            curl.setopt(pycurl.HTTPHEADER, self._headers)
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, self._data.encode("utf-8"))
+            curl.setopt(pycurl.WRITEFUNCTION, self._write)
+            curl.setopt(pycurl.HEADERFUNCTION, self._header)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            curl.perform()
+            self.status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        except Exception as error:
+            self._error = error
+        finally:
+            self._response_ready.set()
+            self._chunks.put(None)
+            curl.close()
+
+    def __iter__(self):
+        while True:
+            chunk = self._chunks.get()
+            if chunk is None:
+                if self._error is not None:
+                    raise self._error
+                return
+            yield chunk
+
+    def iter_content(self, chunk_size=1):
+        for chunk in self:
+            yield chunk
+
+    def close(self) -> None:
+        self._stop.set()
+        self._thread.join()
 
 
