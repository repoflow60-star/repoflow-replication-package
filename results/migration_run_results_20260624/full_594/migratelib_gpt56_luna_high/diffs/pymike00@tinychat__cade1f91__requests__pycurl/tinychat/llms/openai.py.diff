+class _PycurlResponse:
+    def __init__(self, url: str, headers: list[str], data: str) -> None:
+        self.status_code = 0
+        self._chunks = queue.Queue()
+        self._error = None
+        self._closed = False
+        self._header_complete = threading.Event()
+
+        self._curl = pycurl.Curl()
+        self._curl.setopt(pycurl.URL, url)
+        self._curl.setopt(pycurl.HTTPHEADER, headers)
+        self._curl.setopt(pycurl.POST, 1)
+        self._curl.setopt(pycurl.POSTFIELDS, data)
+        self._curl.setopt(pycurl.HEADERFUNCTION, self._header_callback)
+        self._curl.setopt(pycurl.WRITEFUNCTION, self._write_callback)
+
+        self._thread = threading.Thread(target=self._perform)
+        self._thread.daemon = True
+        self._thread.start()
+        self._header_complete.wait()
+
+    def _header_callback(self, header: bytes) -> int:
+        if header.startswith(b"HTTP/"):
+            self.status_code = int(header.split()[1])
+
+        if header in (b"\r\n", b"\n"):
+            self._header_complete.set()
+
+        return len(header)
+
+    def _write_callback(self, chunk: bytes) -> int:
+        if self._closed:
+            return 0
+
+        self._chunks.put(chunk)
+        return len(chunk)
+
+    def _perform(self) -> None:
+        try:
+            self._curl.perform()
+        except Exception as error:
+            self._error = error
+        finally:
+            self._header_complete.set()
+            self._chunks.put(None)
+            self._curl.close()
+
+    def iter_content(
+        self, chunk_size: int = 1, decode_unicode: bool = False
+    ):
+        while True:
+            chunk = self._chunks.get()
+
+            if chunk is None:
+                if self._error is not None:
+                    raise self._error
+                return
+
+            if decode_unicode:
+                yield chunk.decode("utf-8")
+            else:
+                yield chunk
+
+    def close(self) -> None:
+        self._closed = True
 
 
