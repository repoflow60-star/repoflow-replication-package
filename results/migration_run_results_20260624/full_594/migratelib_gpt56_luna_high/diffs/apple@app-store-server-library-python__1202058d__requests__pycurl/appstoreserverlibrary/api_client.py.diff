+def _execute_pycurl_request(method: str, url: str, params: Dict[str, Union[str, List[str]]], headers: Dict[str, str], json: Dict[str, Any]) -> _PycurlResponse:
+    if params:
+        query_string = urlencode(params, doseq=True)
+        url += ("&" if "?" in url else "?") + query_string
+
+    response_body = io.BytesIO()
+    response_headers = []
+
+    def header_function(header):
+        response_headers.append(header)
+        return len(header)
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.CUSTOMREQUEST, method)
+        curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, header_function)
+
+        if method == "GET":
+            curl.setopt(pycurl.HTTPGET, 1)
+        elif method == "POST":
+            curl.setopt(pycurl.POST, 1)
+
+        request_headers = [key + ": " + value for key, value in headers.items()]
+
+        if json is not None:
+            request_body = json_module.dumps(json).encode("utf-8")
+            request_headers.append("Content-Type: application/json")
+            curl.setopt(pycurl.POSTFIELDS, request_body)
+
+        curl.setopt(pycurl.HTTPHEADER, request_headers)
+        curl.perform()
+
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+
+    parsed_headers = {}
+    for header in response_headers:
+        header = header.decode("iso-8859-1").strip()
+        if ":" in header:
+            key, value = header.split(":", 1)
+            parsed_headers[key.strip().lower()] = value.strip()
+
+    return _PycurlResponse(status_code, parsed_headers, response_body.getvalue())
