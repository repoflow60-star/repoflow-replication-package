+def _pycurl_request(url, method='GET', json_data=None, headers=None, data=None):

+    response_body = BytesIO()

+    response_headers = BytesIO()

+

+    curl = pycurl.Curl()

+    curl.setopt(pycurl.URL, url)

+    curl.setopt(pycurl.FOLLOWLOCATION, 1)

+    curl.setopt(pycurl.WRITEFUNCTION, response_body.write)

+    curl.setopt(pycurl.HEADERFUNCTION, response_headers.write)

+

+    request_headers = []

+    if headers:

+        for key, value in headers.items():

+            request_headers.append('{}: {}'.format(key, value))

+

+    if json_data is not None:

+        body = bytes(str(json_data).replace("'", '"'), 'utf-8')

+        curl.setopt(pycurl.POSTFIELDS, body)

+        request_headers.append('Content-Type: application/json')

+        if method == 'POST':

+            curl.setopt(pycurl.POST, 1)

+        elif method == 'PUT':

+            curl.setopt(pycurl.CUSTOMREQUEST, 'PUT')

+    elif data is not None:

+        curl.setopt(pycurl.POSTFIELDS, data)

+        if method == 'PUT':

+            curl.setopt(pycurl.CUSTOMREQUEST, 'PUT')

+        elif method == 'POST':

+            curl.setopt(pycurl.POST, 1)

+    else:

+        if method == 'POST':

+            curl.setopt(pycurl.POST, 1)

+        elif method == 'PUT':

+            curl.setopt(pycurl.CUSTOMREQUEST, 'PUT')

+

+    if request_headers:

+        curl.setopt(pycurl.HTTPHEADER, request_headers)

+

+    curl.perform()

+    status_code = curl.getinfo(pycurl.RESPONSE_CODE)

+    curl.close()

+

+    response_body.seek(0)

+    response_headers.seek(0)

+

+    class Response:

+        def __init__(self, body, headers, status_code):

+            self._body = body

+            self.headers = headers

+            self.status_code = status_code

+

+        def json(self):

+            import json

+            return json.loads(self._body.read().decode('utf-8'))

+

+    parsed_headers = {}

+    for line in response_headers.read().decode('utf-8').splitlines():

+        if ':' in line:

+            key, value = line.split(':', 1)

+            parsed_headers[key.strip()] = value.strip()

+

+    return Response(response_body, parsed_headers, status_code)

+

