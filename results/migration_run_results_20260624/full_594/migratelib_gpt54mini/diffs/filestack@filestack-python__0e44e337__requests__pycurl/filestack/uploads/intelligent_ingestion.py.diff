+def _pycurl_request(url, method='POST', json_data=None, headers=None, data=None):

+    response_body = io.BytesIO()

+    response_headers = []

+

+    c = pycurl.Curl()

+    c.setopt(pycurl.URL, url)

+    c.setopt(pycurl.CUSTOMREQUEST, method)

+    c.setopt(pycurl.FOLLOWLOCATION, True)

+    c.setopt(pycurl.WRITEFUNCTION, response_body.write)

+    c.setopt(pycurl.HEADERFUNCTION, lambda header_line: response_headers.append(header_line.decode('iso-8859-1')))

+

+    request_headers = []

+    if headers:

+        for key, value in headers.items():

+            request_headers.append('{}: {}'.format(key, value))

+

+    if json_data is not None:

+        body = json.dumps(json_data).encode('utf-8')

+        request_headers.append('Content-Type: application/json')

+        c.setopt(pycurl.POSTFIELDS, body)

+        c.setopt(pycurl.POSTFIELDSIZE, len(body))

+    elif data is not None:

+        c.setopt(pycurl.POSTFIELDS, data)

+        c.setopt(pycurl.POSTFIELDSIZE, len(data))

+

+    if request_headers:

+        c.setopt(pycurl.HTTPHEADER, request_headers)

+

+    c.perform()

+    status_code = c.getinfo(pycurl.RESPONSE_CODE)

+    c.close()

+

+    class Response(object):

+        def __init__(self, status_code, content, headers):

+            self.status_code = status_code

+            self.content = content

+            self.headers = headers

+            self.ok = 200 <= status_code < 300

+

+        def json(self):

+            return json.loads(self.content.decode('utf-8'))

+

+        def __str__(self):

+            return str(self.status_code)

+

+    return Response(status_code, response_body.getvalue(), response_headers)

 

 

