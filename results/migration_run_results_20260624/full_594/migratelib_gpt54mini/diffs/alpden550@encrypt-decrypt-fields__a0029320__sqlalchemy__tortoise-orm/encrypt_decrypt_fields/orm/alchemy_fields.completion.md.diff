@@ -0,0 +1,23 @@
+I migrated the field implementation from SQLAlchemy’s `TypeDecorator`/`BINARY` type system to Tortoise ORM’s field system by replacing the SQLAlchemy-specific hooks (`process_bind_param`) with Tortoise field conversion hooks (`to_db_value` and `to_python_value`). The class name, constructor arguments, and overall behavior were kept the same, and the encrypted value is still passed through `Crypto` before being stored.

+

+```python

+from tortoise import fields

+

+from encrypt_decrypt_fields import Crypto

+

+

+class EncryptedAlchemyBinaryField(fields.BinaryField):

+    def __init__(self, key: str, *arg, **kwargs):

+        fields.BinaryField.__init__(self, *arg, **kwargs)

+        self.key = key

+        self.crypto = Crypto(key=self.key)

+

+    def to_db_value(self, value, instance):

+        if not value or isinstance(value, (bytes, memoryview)):

+            return value

+

+        return self.crypto.encrypt(str(value))

+

+    def to_python_value(self, value):

+        return value

+```
