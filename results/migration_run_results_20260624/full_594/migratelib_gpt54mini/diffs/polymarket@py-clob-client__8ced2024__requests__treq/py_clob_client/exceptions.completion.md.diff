+Changed the code to use `treq`’s response type instead of `requests.Response`. The migration is minimal: the import was updated, and the response handling was adapted to `treq`’s async API by making the message extraction method await the JSON/text body. The exception initializer now stores the response object and defers extracting the error message until the body is read.

+

+```python

+from treq.response import _Response

+

+

+class PolyException(Exception):

+    def __init__(self, msg):

+        self.msg = msg

+

+

+class PolyApiException(PolyException):

+    def __init__(self, resp: _Response = None, error_msg=None):

+        assert resp is not None or error_msg is not None

+        if resp is not None:

+            self.status_code = resp.code

+            self.error_msg = self._get_message(resp)

+        if error_msg is not None:

+            self.error_msg = error_msg

+            self.status_code = None

+

+    async def _get_message(self, resp: _Response):

+        try:

+            return await resp.json()

+        except Exception:

+            return await resp.text()

+

+    def __repr__(self):

+        return "PolyApiException[status_code={}, error_message={}]".format(

+            self.status_code, self.error_msg

+        )

+

+    def __str__(self):

+        return self.__repr__()

+```
