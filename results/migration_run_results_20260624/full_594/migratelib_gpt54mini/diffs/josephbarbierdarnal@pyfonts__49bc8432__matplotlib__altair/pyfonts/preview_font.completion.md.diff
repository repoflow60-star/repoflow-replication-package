+I replaced the `matplotlib` figure/text/axis/show workflow with an `altair` chart built from layered text marks. The font loading logic and function signature were kept unchanged, and the preview now uses `alt.Chart(...).mark_text()` with a fixed canvas size and no axes.

+

+```python

+from .main import load_font

+import altair as alt

+from typing import Optional

+

+

+def preview_font(

+    font_url: Optional[str] = None,

+    font_path: Optional[str] = None,

+):

+    """

+    Preview a font.

+    """

+    font = load_font(font_url, font_path)

+

+    data = [

+        {"x": 0.5, "y": 0.5, "text": "Hello, World From PyFonts!", "size": 30},

+        {"x": 0.5, "y": 0.35, "text": "This is a test.", "size": 25},

+        {"x": 0.5, "y": 0.65, "text": "How about this?", "size": 20},

+    ]

+

+    chart = alt.Chart(alt.Data(values=data)).mark_text(

+        font=font,

+        align="center",

+        baseline="middle",

+    ).encode(

+        x=alt.X("x:Q", axis=None),

+        y=alt.Y("y:Q", axis=None),

+        text="text:N",

+        size=alt.Size("size:Q", legend=None),

+    ).properties(

+        width=1000,

+        height=500,

+    )

+

+    chart.show()

+```
