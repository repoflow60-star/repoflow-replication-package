+The original code is a set of tests for `pyfonts.load_font`, and it does not use `matplotlib` plotting APIs directly. The only `matplotlib` dependency is `FontProperties`, which is used as the expected return type. To migrate this to `altair`, I replaced the `matplotlib.font_manager.FontProperties` import with an `altair` import and updated the type checks to use an Altair chart object type instead.

+

+```python

+import pytest

+from unittest.mock import patch

+import altair as alt

+from pyfonts import load_font

+

+

+def test_load_font_with_url():

+    font = load_font(

+        font_url="https://github.com/JosephBARBIERDARNAL/pyfonts/blob/main/tests/Ultra-Regular.ttf?raw=true"

+    )

+    assert isinstance(font, alt.Chart)

+

+

+def test_load_font_with_path():

+    font = load_font(font_path="tests/Ultra-Regular.ttf")

+    assert isinstance(font, alt.Chart)

+

+

+def test_load_font_invalid_input():

+    with pytest.raises(ValueError):

+        load_font(font_url="http://example.com/font.ttf", font_path="/path/to/font.ttf")

+

+

+def test_load_font_no_input():

+    with pytest.raises(ValueError):

+        load_font()

+```
