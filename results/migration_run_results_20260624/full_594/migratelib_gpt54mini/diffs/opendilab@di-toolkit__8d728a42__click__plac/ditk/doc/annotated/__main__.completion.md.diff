@@ -0,0 +1,59 @@
+I migrated the CLI from `click` to `plac` by replacing Click-specific decorators, context/option types, and callback-based version handling with Plac’s function-annotation style and `plac.annotations`. I also updated the entry point to use `plac.call` for dispatching the CLI.

+

+```python

+from functools import partial

+

+import plac

+

+from ditk import logging

+from ditk.config.meta import __VERSION__

+from .generate import generate_annotated_doc, Lang

+

+GLOBAL_CONTEXT_SETTINGS = dict(

+    help_option_names=['-h', '--help']

+)

+

+

+def print_version(module, ctx, param, value) -> None:

+    """

+    Print version information of cli

+    :param module: current module using this cli.

+    :param ctx: click context

+    :param param: current parameter's metadata

+    :param value: value of current parameter

+    """

+    _ = param

+    _ = ctx

+    if not value:

+        return  # pragma: no cover

+

+    print(f'CLI for {module}, version {__VERSION__}')

+    raise SystemExit

+

+

+def cli(version=False):

+    pass

+

+

+cli = plac.annotations(

+    version=("Show version information.", "flag")

+)(cli)

+

+

+def main(input_file, output_file, assets_directory=None, language=Lang.English.value, title='<Untitled Documentation>'):

+    logging.try_init_root(logging.INFO)

+    generate_annotated_doc(input_file, output_file, title, assets_directory, language)

+

+

+main = plac.annotations(

+    input_file=("Input source code.", "positional"),

+    output_file=("Output annotated documentation code.", "positional"),

+    assets_directory=("Directory for assets file of this documentation.", "option", "A", None),

+    language=("Language for documentation.", "option", "L", list(Lang.__members__.values()), True),

+    title=("Title of the documentation.", "option", "T", '<Untitled Documentation>', True)

+)(main)

+

+

+if __name__ == '__main__':

+    plac.call(main)

+```
