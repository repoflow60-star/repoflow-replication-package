@@ -0,0 +1,60 @@
+I replaced the `requests`/`requests_pkcs12` response and request helpers with `urllib3` equivalents, while keeping the same class, method names, and overall structure. The main changes are:

+- Swapped `requests.Response` for `urllib3.response.HTTPResponse`.

+- Replaced `requests_pkcs12.get/post` with a shared `urllib3.PoolManager`.

+- Added JSON encoding for POST bodies and manual `Content-Type` handling through headers.

+- Updated response handling to read and decode JSON from `urllib3` responses.

+

+```python

+import json

+

+import urllib3

+from urllib3.response import HTTPResponse

+

+from pynubank import NuRequestException

+

+

+class HttpClient:

+

+    def __init__(self):

+        self._cert = None

+        self._headers = {

+            'Content-Type': 'application/json',

+            'X-Correlation-Id': 'and-7-86-2-1000005524.9twu3pgr',

+            'User-Agent': 'pynubank Client - https://github.com/andreroggeri/pynubank',

+        }

+        self._http = urllib3.PoolManager()

+

+    def set_cert_data(self, cert_data: bytes):

+        self._cert = cert_data

+

+    def set_header(self, name: str, value: str):

+        self._headers[name] = value

+

+    def remove_header(self, name: str):

+        self._headers.pop(name)

+

+    def get_header(self, name: str):

+        return self._headers.get(name)

+

+    @property

+    def _cert_args(self):

+        return {}

+

+    def _handle_response(self, response: HTTPResponse) -> dict:

+        if response.status != 200:

+            raise NuRequestException(response)

+

+        return json.loads(response.data.decode('utf-8'))

+

+    def raw_get(self, url: str) -> HTTPResponse:

+        return self._http.request('GET', url, headers=self._headers)

+

+    def raw_post(self, url: str, json: dict) -> HTTPResponse:

+        return self._http.request('POST', url, body=json.dumps(json).encode('utf-8'), headers=self._headers)

+

+    def get(self, url: str) -> dict:

+        return self._handle_response(self.raw_get(url))

+

+    def post(self, url: str, json: dict) -> dict:

+        return self._handle_response(self.raw_post(url, json))

+```
