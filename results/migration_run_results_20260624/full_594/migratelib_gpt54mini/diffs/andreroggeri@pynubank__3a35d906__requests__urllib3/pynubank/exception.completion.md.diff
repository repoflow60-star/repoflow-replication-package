@@ -0,0 +1,29 @@
+I replaced the `requests.Response` type import with the equivalent `urllib3.response.HTTPResponse` type, since `urllib3` does not provide a `Response` class like `requests` does. The exception logic and attribute access were kept the same, with only the import/type annotation updated for `urllib3` compatibility.

+

+```python

+from urllib3.response import HTTPResponse as Response

+

+

+class NuException(Exception):

+

+    def __init__(self, message):

+        super().__init__(message)

+

+

+class NuInvalidAuthenticationMethod(NuException):

+    def __init__(self, message):

+        super().__init__(message)

+

+

+class NuMissingCreditCard(NuException):

+    def __init__(self):

+        super().__init__(f'Couldn\'t fetch bills due to missing credit card.')

+

+

+class NuRequestException(NuException):

+    def __init__(self, response: Response):

+        super().__init__(f'The request made failed with HTTP status code {response.status_code}')

+        self.url = response.url

+        self.status_code = response.status_code

+        self.response = response

+```
