+I migrated the code from `requests` to `aiohttp` by changing the imported response type from `requests.Response` to `aiohttp.ClientResponse`. The exception logic was kept the same, but the response attribute access was updated to match `aiohttp` (`status` instead of `status_code`, and `await resp.json()` / `await resp.text()` because `aiohttp` response body methods are asynchronous).

+

+```python

+from aiohttp import ClientResponse

+

+

+class PolyException(Exception):

+    def __init__(self, msg):

+        self.msg = msg

+

+

+class PolyApiException(PolyException):

+    def __init__(self, resp: ClientResponse = None, error_msg=None):

+        assert resp is not None or error_msg is not None

+        if resp is not None:

+            self.status_code = resp.status

+            self.error_msg = self._get_message(resp)

+        if error_msg is not None:

+            self.error_msg = error_msg

+            self.status_code = None

+

+    async def _get_message(self, resp: ClientResponse):

+        try:

+            return await resp.json()

+        except Exception:

+            return await resp.text()

+

+    def __repr__(self):

+        return "PolyApiException[status_code={}, error_message={}]".format(

+            self.status_code, self.error_msg

+        )

+

+    def __str__(self):

+        return self.__repr__()

+```
