+I replaced the `tqdm` import with `alive_progress`, and migrated the custom progress class to use `alive_bar` as the underlying progress bar mechanism. Since `alive-progress` does not use the same subclassing pattern as `tqdm`, the custom class now wraps `alive_bar` while keeping the original class name and `setLevel` interface intact.

+

+```python

+#!/usr/bin/env python3

+import logging

+

+from alive_progress import alive_bar

+

+# Get logger (def level: INFO)

+logger = logging.getLogger(__name__)

+logger.setLevel(logging.INFO)

+

+# Get console handler

+# On log tout ce qui est possible ici (i.e >= level du logger)

+ch = logging.StreamHandler()

+ch.setLevel(logging.DEBUG)

+

+# Manage formatter

+formatter = logging.Formatter(

+    "[%(asctime)s] - %(name)s.%(funcName)s() - %(levelname)s - %(message)s",

+    datefmt="%Y-%m-%d %H:%M:%S",

+)

+ch.setFormatter(formatter)

+

+# Add handler to the logger

+logger.addHandler(ch)

+

+

+## Manage alive-progress

+# On créé une classe à utiliser à la place de celle de tqdm

+# def level: INFO

+class CustomTqdm:

+    level = logging.INFO

+

+    def __init__(self, **kwargs):

+        self.kwargs = kwargs

+        self._bar = None

+        self._bar_ctx = None

+

+    def __enter__(self):

+        if logger.isEnabledFor(self.level):

+            self._bar_ctx = alive_bar(**self.kwargs)

+            self._bar = self._bar_ctx.__enter__()

+        return self

+

+    def __exit__(self, exc_type, exc_val, exc_tb):

+        if self._bar_ctx is not None:

+            self._bar_ctx.__exit__(exc_type, exc_val, exc_tb)

+

+    def display(self, msg=None, pos=None):

+        if logger.isEnabledFor(self.level):

+            if self._bar is not None:

+                self._bar()

+

+    def close(self):

+        if logger.isEnabledFor(self.level):

+            if self._bar_ctx is not None:

+                self._bar_ctx.__exit__(None, None, None)

+

+    @staticmethod

+    def setLevel(level):

+        CustomTqdm.level = level

+```
