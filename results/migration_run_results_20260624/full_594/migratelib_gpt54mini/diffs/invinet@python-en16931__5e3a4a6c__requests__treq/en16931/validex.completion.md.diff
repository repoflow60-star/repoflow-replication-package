+I migrated the code from `requests` to `treq` by replacing synchronous `requests.get/post(...)` calls with `treq.get/post(...)`, and by switching response handling to `treq`’s async-style API (`response.json()` / `response.text()` are awaitable in treq). Since the original code is synchronous, I kept the structure intact and used `twisted.internet.defer.inlineCallbacks` so the functions can still return/raise in the same places while awaiting treq responses. I also replaced `response.status_code` with `response.code`, which is the equivalent in treq.

+

+```python

+"""

+Module to interact with open.validex.net

+

+You need to create an user at validex.net to be able to

+use its API.

+

+"""

+

+import base64

+import treq

+import time

+from twisted.internet import defer

+

+URL = "https://api2.validex.net/api/validate"

+

+

+@defer.inlineCallbacks

+def is_valid_at_validex(invoice, api_key, user_id):

+    """Validates an Invoice at open.validex.net

+

+    You need to create an user at validex.net to be able to

+    use its API.

+

+    Parameters

+    ----------

+    api_key: string.

+        The authentification API key for validex.net

+

+    user_id: string.

+        The user ID of validex.net

+

+    Notes

+    -----

+    Warnings are not reported.

+

+    """

+    payload = {

+        'userId': user_id,

+        'filename': "{}.xml".format(int(time.time())),

+        'fileContents64': base64.b64encode(invoice.to_xml().encode('utf8')),

+    }

+    headers = {

+        'content_type': 'json',

+        'accept': 'json',

+        'Authorization': "apikey={}".format(api_key),

+    }

+    response = yield treq.post(URL, json=payload, headers=headers, verify=False)

+    if response.code == 200:

+        result = yield response.json()

+        if result.get('report') and result['report'].get('result') and\

+                result['report']['result'] != 'fatal':

+            # Warnings are not reported

+            return True

+        elif result.get('report') and result['report'].get('id'):

+            raise ValueError((yield _get_validation_errors(result['report']['id'], api_key)))

+        else:

+            raise RuntimeError(": ".join((yield response.json())['error'].values()))

+    elif response.code == 401:

+        raise RuntimeError("Unauthorized: invalid API_KEY")

+    else:

+        raise RuntimeError(": ".join((yield response.json())['error'].values()))

+

+

+@defer.inlineCallbacks

+def _get_validation_errors(report_id, api_key):

+    headers = {

+        'accept': 'json',

+        'Authorization': "apikey={}".format(api_key),

+    }

+    response = yield treq.get(

+        "{}/{}".format(URL.replace('validate', 'report'), report_id),

+        headers=headers,

+        verify=False,

+    )

+    if response.code == 200:

+        resp = yield response.json()

+        errors = []

+        validation_steps = []

+        if resp['report'].get('validationSteps'):

+            validation_steps.extend(resp['report']['validationSteps'])

+        for step in validation_steps:

+            if step.get('success') or not step.get('errors'):

+                continue

+            for error in step['errors']:

+                if error.get('message'):

+                    errors.add("{}: {}".format(step['description'], error['message']))

+                elif error.get('text'):

+                    errors.add("{}: {}".format(step['description'], error['text']))

+                else:

+                    errors.add(str(error))

+        return ". ".join(errors)

+    elif response.code == 401:

+        raise RuntimeError("Unauthorized: invalid API_KEY")

+    else:

+        raise RuntimeError(": ".join((yield response.json())['error'].values()))

+```
