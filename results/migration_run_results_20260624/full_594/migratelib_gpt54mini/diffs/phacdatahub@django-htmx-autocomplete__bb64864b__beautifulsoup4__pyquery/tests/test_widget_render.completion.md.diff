+

+    lis = ac_container_ul("li")

+    assert len(lis) == 1

+    actual_input_field = lis.eq(0)("input")

+    assert actual_input_field.attr("type") == "text"

+    assert actual_input_field.attr("value") == lead.name

+    assert "multiselect" not in actual_input_field.attr("hx-vals")

+

