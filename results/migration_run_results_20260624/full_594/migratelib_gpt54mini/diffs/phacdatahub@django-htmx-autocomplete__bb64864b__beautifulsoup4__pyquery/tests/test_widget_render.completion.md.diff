+

+    soup = soup_from_str(rendered)

+

+    ac_container = soup(".ac_container")

+    chips = ac_container("li.chip")

+    assert len(chips) == 2

+    for chip in chips.items():

+        assert not chip("a")

+    input_li = ac_container("li.input")

+    assert not input_li("input")

+    assert input_li("output#members__textinput")

