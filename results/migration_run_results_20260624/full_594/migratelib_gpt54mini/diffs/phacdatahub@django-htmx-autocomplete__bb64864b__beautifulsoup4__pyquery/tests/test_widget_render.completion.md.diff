+def test_render_widget_multi_non_empty():

+

+    class FormWithMulti(forms.ModelForm):

+        class Meta:

+            model = Team

+            fields = ["members"]

+

+            widgets = {

+                "members": AutocompleteWidget(

+                    ac_class=PersonAC4, options={"multiselect": True}

+                )

+            }

+

+    people = PersonFactory.create_batch(5)

+    record = TeamFactory()

+    record.members.set(people[:2])

+

+    edit_form = FormWithMulti(instance=record)

+

+    rendered = render_template(single_form_template, {"form": edit_form})

+

+    soup = soup_from_str(rendered)

+

+    component = soup("#members")

+    hidden_inputs = component('span > input[type="hidden"]')

+

+    assert len(hidden_inputs) == 2

+    assert hidden_inputs.eq(0).attr("name") == "members"

+    values = {int(i.attr("value")) for i in hidden_inputs.items()}

+    assert values == {people[0].id, people[1].id}

+

+    # check untoggle buttons,

+    ac_items = soup("ul#members_ac_container.ac_container > li.chip")

+    assert len(ac_items) == 2

+    for li in ac_items.items():

+        assert li("span").text() in {people[0].name, people[1].name}

+        delete_button = li("a")

+        assert delete_button.attr("hx-get") == reverse(

+            "autocomplete:toggle", args=["PersonAC4"]

+        )

+        assert (

+            delete_button.attr("hx-params")

+            == "members,field_name,item,component_prefix,required,multiselect,remove"

+        )

+        assert "multiselect" in delete_button.attr("hx-vals")

+        assert delete_button.attr("hx-vals")

+        assert delete_button.attr("hx-include") == "#members"

+        assert delete_button.attr("hx-swap") == "delete"

+        assert delete_button.attr("hx-target") == "this"

+        assert delete_button.attr("href") == "#"

+

