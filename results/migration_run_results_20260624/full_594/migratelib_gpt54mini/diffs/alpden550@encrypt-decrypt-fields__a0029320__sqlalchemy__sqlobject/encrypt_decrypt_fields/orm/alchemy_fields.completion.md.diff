@@ -0,0 +1,20 @@
+I migrated the code from `sqlalchemy` to `sqlobject` by replacing the SQLAlchemy `TypeDecorator`/`BINARY` type usage with SQLObject’s `StringCol`-based custom column type pattern. The encryption logic and class name were kept the same, and only the database-type integration was changed to match `sqlobject` 3.13.1.

+

+```python

+from sqlobject import StringCol

+

+from encrypt_decrypt_fields import Crypto

+

+

+class EncryptedAlchemyBinaryField(StringCol):

+    def __init__(self, key: str, *arg, **kwargs):

+        StringCol.__init__(self, *arg, **kwargs)

+        self.key = key

+        self.crypto = Crypto(key=self.key)

+

+    def _sqlrepr(self, value, connection):

+        if not value or isinstance(value, (bytes, memoryview)):

+            return value

+

+        return self.crypto.encrypt(str(value))

+```
