+++ b/src/tests/test_fastAPI_aiohttp.completion.md
@@ -0,0 +1,66 @@
+To migrate this test code from `fastapi` to `sanic`, I replaced FastAPI’s `TestClient` with Sanic’s test client and updated the app import to use the Sanic application object. The rest of the test logic and names were kept unchanged, with only the framework-specific client import and usage adjusted.

+

+```python

+import json

+

+import httpx

+from aioresponses import aioresponses

+from sanic.testing import SanicTestClient

+import pytest

+

+from fastAPI_aiohttp.fastAPI import app, SingletonAiohttp

+

+

+@pytest.fixture

+def client_aio():

+    with aioresponses() as m:

+        m.post(url="test/toto",

+               status=200,

+               body=json.dumps({"result": 2}))

+        yield m

+

+

+@pytest.fixture

+def client_fastAPI():

+    return SanicTestClient(app=app)

+

+

+@pytest.mark.asyncio

+async def test_query_url(client_aio):

+    rst = await SingletonAiohttp.query_url("test/toto")

+    assert rst == {"result": 2}

+

+

+def test_endpoint(client_fastAPI):

+    url = "http://localhost:8080/test"

+    with aioresponses() as mock_server:

+        mock_server.post(url=url, status=200, body=json.dumps({"success": 1}))

+

+        request, result: httpx.Response = client_fastAPI.get('/endpoint/')

+    assert result is not None

+

+    result_json = result.json()

+    assert result_json == {'success': 1}

+

+

+def test_endpoint_multi(client_fastAPI):

+    url = "http://localhost:8080/test"

+    with aioresponses() as mock_server:

+        mock_server.post(url=url, status=200, body=json.dumps({"success": 1}))

+        mock_server.post(url=url, status=200, body=json.dumps({"success": 2}))

+

+        request, result: httpx.Response = client_fastAPI.get('/endpoint_multi/')

+    assert result is not None

+

+    result_json = result.json()

+    assert result_json == {'success': 3}

+

+

+def test_endpoint_stream(client_fastAPI):

+    data = b'TOTO' * 10000

+

+    request, result = client_fastAPI.post('/endpoint_stream/', data=data)

+    assert result is not None

+    rst = result.body

+    assert rst == b'RST' + data

+```
