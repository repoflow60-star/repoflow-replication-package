+I migrated the code from `requests` to `requests_futures` by replacing the direct `requests` import with `FuturesSession` from `requests_futures.sessions`, then creating a session and using its asynchronous `get()` method. Since `requests_futures` returns a future, I added `.result()` before calling `raise_for_status()`, `json()`, and accessing `content`.

+

+```python

+from typing import Any

+

+from requests_futures.sessions import FuturesSession

+

+session = FuturesSession()

+

+

+def build_route(base_url: str, *paths: str | int) -> str:

+    if base_url.endswith("/"):

+        base_url = base_url[:-1]

+

+    paths = tuple(str(p).strip("/") for p in paths)

+    url = f"{base_url}/{'/'.join(paths)}"

+    return url.strip("/")

+

+

+def add_filters(url: str, *args: tuple[str, Any]) -> str:

+    """

+    Adds filters to the given url.

+    """

+    symbol = "?"

+    if "?" in url:

+        symbol = "&"

+    for arg in args:

+        url = f"{url}{symbol}{arg[0]}={arg[1]}"

+        symbol = "&"

+    return url

+

+

+def get(url: str) -> Any:

+    response = session.get(url).result()

+    response.raise_for_status()

+    return response.json()

+

+

+def get_content(url: str) -> bytes:

+    response = session.get(url).result()

+    response.raise_for_status()

+    return response.content

+```
