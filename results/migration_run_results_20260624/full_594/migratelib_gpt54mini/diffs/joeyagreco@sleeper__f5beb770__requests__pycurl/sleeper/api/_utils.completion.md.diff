+I replaced `requests.get(...)` calls with `pycurl`-based HTTP GET requests, added the necessary `pycurl` and `io` imports, and preserved the existing function names and behavior by reading the response body from an in-memory buffer and raising an exception for HTTP status codes outside the 2xx range.

+

+```python

+from typing import Any

+import io

+

+import pycurl

+

+

+def build_route(base_url: str, *paths: str | int) -> str:

+    if base_url.endswith("/"):

+        base_url = base_url[:-1]

+

+    paths = tuple(str(p).strip("/") for p in paths)

+    url = f"{base_url}/{'/'.join(paths)}"

+    return url.strip("/")

+

+

+def add_filters(url: str, *args: tuple[str, Any]) -> str:

+    """

+    Adds filters to the given url.

+    """

+    symbol = "?"

+    if "?" in url:

+        symbol = "&"

+    for arg in args:

+        url = f"{url}{symbol}{arg[0]}={arg[1]}"

+        symbol = "&"

+    return url

+

+

+def get(url: str) -> Any:

+    buffer = io.BytesIO()

+    curl = pycurl.Curl()

+    curl.setopt(pycurl.URL, url)

+    curl.setopt(pycurl.WRITEFUNCTION, buffer.write)

+    curl.perform()

+    status_code = curl.getinfo(pycurl.RESPONSE_CODE)

+    curl.close()

+    if status_code < 200 or status_code >= 300:

+        raise Exception(f"HTTP error: {status_code}")

+    return __import__("json").loads(buffer.getvalue().decode("utf-8"))

+

+

+def get_content(url: str) -> bytes:

+    buffer = io.BytesIO()

+    curl = pycurl.Curl()

+    curl.setopt(pycurl.URL, url)

+    curl.setopt(pycurl.WRITEFUNCTION, buffer.write)

+    curl.perform()

+    status_code = curl.getinfo(pycurl.RESPONSE_CODE)

+    curl.close()

+    if status_code < 200 or status_code >= 300:

+        raise Exception(f"HTTP error: {status_code}")

+    return buffer.getvalue()

+```
