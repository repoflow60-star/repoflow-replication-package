+def load_schema(schema_url):

+    schema = registry.get(schema_url).contents

+    cerberus_schema = {}

+    properties = schema.get("properties", {})

+    required = schema.get("required", [])

+

+    for key, value in properties.items():

+        if "enum" in value:

+            cerberus_schema[key] = {"allowed": value["enum"]}

+        elif value.get("type") == "object":

+            cerberus_schema[key] = {"type": "dict"}

+        elif value.get("type") == "array":

+            cerberus_schema[key] = {"type": "list"}

+        elif value.get("type") == "string":

+            cerberus_schema[key] = {"type": "string"}

+        elif value.get("type") == "integer":

+            cerberus_schema[key] = {"type": "integer"}

+        elif value.get("type") == "number":

+            cerberus_schema[key] = {"type": "number"}

+        elif value.get("type") == "boolean":

+            cerberus_schema[key] = {"type": "boolean"}

+        else:

+            cerberus_schema[key] = {}

+

+        if key in required:

+            cerberus_schema[key]["required"] = True

+

+    return cerberus_schema

 

 

