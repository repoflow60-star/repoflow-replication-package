+    def _pycurl_get(self, url: str, verify: bool = True):

+        buffer = BytesIO()

+        headers = {}

+        history = []

+        current_url = url

+

+        def header_function(header_line):

+            header_line = header_line.decode("iso-8859-1").strip()

+            if header_line.startswith("HTTP/"):

+                history.append(current_url)

+            elif ":" in header_line:

+                key, value = header_line.split(":", 1)

+                headers[key.strip().lower()] = value.strip()

+

+        c = pycurl.Curl()

+        c.setopt(pycurl.URL, url)

+        c.setopt(pycurl.WRITEDATA, buffer)

+        c.setopt(pycurl.HEADERFUNCTION, header_function)

+        c.setopt(pycurl.USERAGENT, 'Mozilla/5.0 (Windows NT 6.1; WOW64; rv:12.0) Gecko/20100101 Firefox/12.0')

+        c.setopt(pycurl.TIMEOUT, 5)

+        c.setopt(pycurl.FOLLOWLOCATION, True)

+        c.setopt(pycurl.MAXREDIRS, 10)

+        if not verify:

+            c.setopt(pycurl.SSL_VERIFYPEER, False)

+            c.setopt(pycurl.SSL_VERIFYHOST, False)

+        c.perform()

+        status_code = c.getinfo(pycurl.RESPONSE_CODE)

+        final_url = c.getinfo(pycurl.EFFECTIVE_URL)

+        c.close()

+

+        class Resp:

+            pass

+

+        resp = Resp()

+        resp.status_code = status_code

+        resp.content = buffer.getvalue()

+        resp.url = final_url

+        resp.headers = headers

+        resp.history = []

+        if len(history) > 1:

+            for h in history[:-1]:

+                hresp = Resp()

+                hresp.url = h

+                resp.history.append(hresp)

+        return resp

+

