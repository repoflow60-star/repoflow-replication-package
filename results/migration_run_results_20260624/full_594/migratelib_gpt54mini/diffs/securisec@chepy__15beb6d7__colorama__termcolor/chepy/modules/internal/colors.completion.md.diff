+    Returns:

+        str: Colored string

+

+    Examples:

+        >>> from chepy.modules.internal.colors import red

+        >>> print(RED("some string"))

+    """

+    if sys.stdout.isatty():

+        return colored(s, "red")

+    else:

+        return s

+

