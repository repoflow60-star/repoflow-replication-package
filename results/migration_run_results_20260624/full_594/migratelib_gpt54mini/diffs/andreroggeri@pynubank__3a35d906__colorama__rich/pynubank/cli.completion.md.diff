@@ -0,0 +1,65 @@
+I replaced `colorama` imports and initialization with `rich` equivalents, and updated the colored output to use Rich’s markup-based styling while keeping the same function names, flow, and overall structure.

+

+```python

+import os

+import random

+import string

+from getpass import getpass

+

+from rich import print

+from rich.console import Console

+

+from pynubank import NuException

+from pynubank.utils.certificate_generator import CertificateGenerator

+

+

+console = Console()

+

+

+def generate_random_id() -> str:

+    return ''.join(random.choices(string.ascii_lowercase + string.digits, k=12))

+

+

+def log(message, color='blue'):

+    print(f'[{color}][*] [dim]{message}')

+

+

+def save_cert(cert, name):

+    path = os.path.join(os.getcwd(), name)

+    with open(path, 'wb') as cert_file:

+        cert_file.write(cert.export())

+

+

+def main():

+    log(f'Starting [magenta][dim]PyNubank[/dim][/magenta] context creation.')

+

+    device_id = generate_random_id()

+

+    log(f'Generated random id: {device_id}')

+

+    cpf = input(f'[>] Enter your CPF(Numbers only): ')

+    password = getpass('[>] Enter your password (Used on the app/website): ')

+

+    generator = CertificateGenerator(cpf, password, device_id)

+

+    log('Requesting e-mail code')

+    try:

+        email = generator.request_code()

+    except NuException:

+        log('Failed to request code. Check your credentials!', 'red')

+        return

+

+    log(f'Email sent to [bright_black]{email}[/bright_black]')

+    code = input('[>] Type the code received by email: ')

+

+    cert1, cert2 = generator.exchange_certs(code)

+

+    save_cert(cert1, 'cert.p12')

+

+    print('[green]Certificates generated successfully. (cert.pem)')

+    print('[yellow]Warning, keep these certificates safe (Do not share or version in git)')

+

+

+if __name__ == '__main__':

+    main()

+```
