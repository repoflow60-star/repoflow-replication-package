+I replaced the `requests` session-based HTTP GET with `pycurl`-based requests, while keeping the same class, method names, and behavior. The migration includes:

+- swapping `requests.Session` and `requests.exceptions.ConnectionError` imports for `pycurl` and `io.BytesIO`

+- creating a `pycurl.Curl()` handle in place of the session

+- setting the `URL`, `USERAGENT`, and `WRITEFUNCTION` options to fetch the response body

+- translating `pycurl.error` into the same generic exception used before

+- decoding the downloaded bytes the same way as the original code

+

+```python

+'''

+A simple Dynamic DNS source for octoDNS.

+

+Supports both IPv4 and IPv6 addresses. Generally useful when you have a zone

+with staticly configured records but would also like to include a dynamic

+record, e.g. for your office or home on a non-fixed IP address.

+'''

+

+from __future__ import (

+    absolute_import,

+    division,

+    print_function,

+    unicode_literals,

+)

+

+from logging import getLogger

+from io import BytesIO

+

+import pycurl

+

+from octodns import __VERSION__ as octodns_version

+from octodns.record import Record

+from octodns.source.base import BaseSource

+

+# TODO: remove __VERSION__ with the next major version release

+__version__ = __VERSION__ = '0.2.1'

+

+

+class DdnsSource(BaseSource):

+    SUPPORTS_GEO = False

+    SUPPORTS = ('A', 'AAAA')

+

+    def __init__(self, id, types=('A', 'AAAA'), urls={}, ttl=60):

+        self.log = getLogger('DdnsSource[{}]'.format(id))

+        self.log.debug('__init__: id=%s, types=%s, ttl=%d', id, types, ttl)

+        super().__init__(id)

+        self.types = types

+        self.ttl = ttl

+        self.urls = {

+            'A': urls.get('A', 'https://v4.ident.me/'),

+            'AAAA': urls.get('AAAA', 'https://v6.ident.me/'),

+        }

+

+        self._sess = pycurl.Curl()

+        self._sess.setopt(

+            pycurl.USERAGENT,

+            f'octodns/{octodns_version} octodns-ddns/{__VERSION__}'

+        )

+

+    def _get_addr(self, _type):

+        self.log.debug('_get_addr: type=%s', _type)

+        try:

+            buf = BytesIO()

+            self._sess.setopt(pycurl.URL, self.urls[_type])

+            self._sess.setopt(pycurl.WRITEFUNCTION, buf.write)

+            self._sess.perform()

+            resp_code = self._sess.getinfo(pycurl.RESPONSE_CODE)

+        except pycurl.error:

+            raise Exception(

+                'Failed to get ip address for type={}'.format(_type)

+            )

+        if resp_code >= 400:

+            raise Exception(

+                'Failed to get ip address for type={}'.format(_type)

+            )

+        addr = buf.getvalue().decode('utf-8')

+        self.log.info('_get_addr: type=%s is %s', _type, addr)

+        return addr

+

+    def populate(self, zone, target=False, lenient=False):

+        self.log.debug('populate: zone=%s', zone.name)

+        before = len(zone.records)

+

+        for _type in self.types:

+            addr = self._get_addr(_type)

+            if addr:

+                record = Record.new(

+                    zone,

+                    self.id,

+                    {'ttl': self.ttl, 'type': _type, 'value': addr},

+                    source=self,

+                )

+                zone.add_record(record)

+

+        self.log.info(

+            'populate:   found %s records', len(zone.records) - before

+        )

+```
