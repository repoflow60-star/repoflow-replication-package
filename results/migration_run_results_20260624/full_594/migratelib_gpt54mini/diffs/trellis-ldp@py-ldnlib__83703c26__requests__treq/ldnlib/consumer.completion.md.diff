--- /dev/null
+++ b/ldnlib/consumer.completion.md
@@ -0,0 +1,57 @@
+I migrated the HTTP calls from `requests.get(...)` to `treq.get(...)`. Since `treq` is Twisted-based, the calls now return Deferreds, so I added `@inlineCallbacks` and `yield` to keep the same synchronous-looking flow. I also replaced `raise_for_status()` with explicit status-code checks, and switched response body/header access to `treq`’s async response methods.

+

+```python

+from rdflib import Graph, URIRef

+import treq

+

+import json

+

+from twisted.internet.defer import inlineCallbacks

+

+from .base import BaseLDN

+

+

+class Consumer(BaseLDN):

+

+    def __init__(self, **kwargs):

+        super(self.__class__, self).__init__(**kwargs)

+

+    @inlineCallbacks

+    def notifications(self, inbox, **kwargs):

+        """

+        Retrieve all of the notification IRIs from an ldp:inbox as a list.

+        """

+        headers = kwargs.pop("headers", dict())

+        if 'accept' not in headers:

+            headers['accept'] = kwargs.pop("accept", self.accept_headers)

+

+        r = yield treq.get(inbox, headers=headers, **kwargs)

+        if r.code >= 400:

+            raise Exception("HTTP error {}".format(r.code))

+        body = yield treq.text_content(r)

+        content_type = yield treq.get_header(r, 'content-type')

+        g = Graph().parse(data=body, format=self.content_type_to_mime_type(

+            content_type))

+        return [str(o) for (s, o) in g[:URIRef(self.LDP_CONTAINS)]]

+

+    @inlineCallbacks

+    def notification(self, iri, **kwargs):

+        """

+        Retrieve a single LDN notification and decode into a Python object.

+        """

+        headers = kwargs.pop("headers", dict())

+        if 'accept' not in headers:

+            headers['accept'] = kwargs.pop("accept", self.accept_headers)

+

+        r = yield treq.get(iri, headers=headers, **kwargs)

+        if r.code >= 400:

+            raise Exception("HTTP error {}".format(r.code))

+        content_type = yield treq.get_header(r, 'content-type')

+        mime_type = self.content_type_to_mime_type(content_type)

+        body = yield treq.text_content(r)

+        if mime_type == self.JSON_LD:

+            return json.loads(body)

+        else:

+            g = Graph().parse(data=body, format=mime_type)

+            return json.loads(g.serialize(format="json-ld"))

+```
