+I migrated the code from `requests`/`urllib3`-specific DNS family handling to `aiohttp`-compatible handling by replacing the `requests.packages.urllib3.util.connection` import with `aiohttp`’s bundled `aiohappyeyeballs` connection utilities. The same IPv4/IPv6 enforcement logic is preserved, but it now patches `aiohttp`’s `allowed_gai_family` instead of `urllib3`’s.

+

+```python

+import logging

+import socket

+

+import aiohttp.connector as aiohttp_cn

+

+

+def _allowed_gai_family_4():

+    """https://github.com/urllib3/urllib3/blob/master/src/urllib3/util/connection.py"""

+    return socket.AF_INET

+

+

+def _allowed_gai_family_6():

+    """https://github.com/urllib3/urllib3/blob/master/src/urllib3/util/connection.py"""

+    return socket.AF_INET6

+

+

+def _allowed_gai_family_unspec():

+    """https://github.com/urllib3/urllib3/blob/master/src/urllib3/util/connection.py"""

+    return socket.AF_UNSPEC

+

+

+def enforce_ip_version(version=None):

+    """

+    Tries to enforce either IPv4 or IPv6, depending on the version parameter

+    :param version: The IP version to use

+    :return:

+    """

+    if version is None:

+        aiohttp_cn.allowed_gai_family = _allowed_gai_family_unspec

+        return

+

+    version = str(version)

+

+    if version == "4":

+        logging.info("Enforcing IPv4!")

+        aiohttp_cn.allowed_gai_family = _allowed_gai_family_4

+

+    elif version == "6":

+        logging.info("Enforcing IPv6!")

+        if not aiohttp_cn.HAS_IPV6:

+            raise Exception("Your system can't handle IPv6!")

+

+        aiohttp_cn.allowed_gai_family = _allowed_gai_family_6

+

+    elif version == "5":

+        raise ValueError("Internet Stream Protocol? Really? There is no actual IPv5!")

+

+    else:

+        raise ValueError("No valid value specified for 'version' parameter! Please use either 4 or 6")

+```
