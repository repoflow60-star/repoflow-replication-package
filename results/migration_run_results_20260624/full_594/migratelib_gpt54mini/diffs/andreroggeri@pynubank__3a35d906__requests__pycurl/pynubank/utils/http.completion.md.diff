--- /dev/null
+++ b/pynubank/utils/http.completion.md
@@ -0,0 +1,94 @@
+I replaced the `requests`/`requests_pkcs12`-based HTTP calls with `pycurl`-based requests, while keeping the same class, method names, and overall structure. The response handling was updated to work with `pycurl` by collecting the response body manually, reading the HTTP status code from the response headers, and returning a `Response`-like object so the existing `_handle_response` logic can stay mostly intact.

+

+```python

+from io import BytesIO

+import json

+

+import pycurl

+

+from pynubank import NuRequestException

+

+

+class Response:

+

+    def __init__(self, status_code: int, content: bytes):

+        self.status_code = status_code

+        self.content = content

+

+    def json(self):

+        return json.loads(self.content.decode('utf-8'))

+

+

+class HttpClient:

+

+    def __init__(self):

+        self._cert = None

+        self._headers = {

+            'Content-Type': 'application/json',

+            'X-Correlation-Id': 'and-7-86-2-1000005524.9twu3pgr',

+            'User-Agent': 'pynubank Client - https://github.com/andreroggeri/pynubank',

+        }

+

+    def set_cert_data(self, cert_data: bytes):

+        self._cert = cert_data

+

+    def set_header(self, name: str, value: str):

+        self._headers[name] = value

+

+    def remove_header(self, name: str):

+        self._headers.pop(name)

+

+    def get_header(self, name: str):

+        return self._headers.get(name)

+

+    @property

+    def _cert_args(self):

+        return {'pkcs12_data': self._cert, 'pkcs12_password': ''} if self._cert else {}

+

+    def _handle_response(self, response: Response) -> dict:

+        if response.status_code != 200:

+            raise NuRequestException(response)

+

+        return response.json()

+

+    def _request(self, url: str, method: str, json_data: dict = None) -> Response:

+        buffer = BytesIO()

+        header_buffer = BytesIO()

+        curl = pycurl.Curl()

+

+        curl.setopt(pycurl.URL, url)

+        curl.setopt(pycurl.WRITEFUNCTION, buffer.write)

+        curl.setopt(pycurl.HEADERFUNCTION, header_buffer.write)

+        curl.setopt(pycurl.CUSTOMREQUEST, method)

+

+        headers = []

+        for name, value in self._headers.items():

+            headers.append('%s: %s' % (name, value))

+        curl.setopt(pycurl.HTTPHEADER, headers)

+

+        if self._cert:

+            curl.setopt(pycurl.SSLKEYPASSWD, '')

+            curl.setopt(pycurl.SSLCERTTYPE, 'P12')

+            curl.setopt(pycurl.SSLCERT, self._cert)

+

+        if json_data is not None:

+            curl.setopt(pycurl.POSTFIELDS, json.dumps(json_data))

+

+        curl.perform()

+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)

+        curl.close()

+

+        return Response(status_code, buffer.getvalue())

+

+    def raw_get(self, url: str) -> Response:

+        return self._request(url, 'GET')

+

+    def raw_post(self, url: str, json: dict) -> Response:

+        return self._request(url, 'POST', json_data=json)

+

+    def get(self, url: str) -> dict:

+        return self._handle_response(self.raw_get(url))

+

+    def post(self, url: str, json: dict) -> dict:

+        return self._handle_response(self.raw_post(url, json))

+```
