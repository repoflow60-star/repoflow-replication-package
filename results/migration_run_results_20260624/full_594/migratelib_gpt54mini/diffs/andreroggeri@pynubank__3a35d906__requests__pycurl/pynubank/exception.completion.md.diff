@@ -0,0 +1,26 @@
+I replaced the `requests.Response` type dependency with the equivalent `pycurl`-compatible handling by removing the `requests` import and making `NuRequestException` accept a generic response object that can carry the same attributes (`url`, `status_code`, `response`) used by the class. This keeps the class names and behavior intact while removing the direct dependency on `requests`.

+

+```python

+class NuException(Exception):

+

+    def __init__(self, message):

+        super().__init__(message)

+

+

+class NuInvalidAuthenticationMethod(NuException):

+    def __init__(self, message):

+        super().__init__(message)

+

+

+class NuMissingCreditCard(NuException):

+    def __init__(self):

+        super().__init__(f'Couldn\'t fetch bills due to missing credit card.')

+

+

+class NuRequestException(NuException):

+    def __init__(self, response):

+        super().__init__(f'The request made failed with HTTP status code {response.status_code}')

+        self.url = response.url

+        self.status_code = response.status_code

+        self.response = response

+```
