+    def __perform_request(

+            self,

+            method: str,

+            url: str,

+            payload: Optional[dict] = None,

+            files: Optional[dict] = None

+    ) -> dict:

+        buffer = BytesIO()

+        curl = pycurl.Curl()

+

+        try:

+            curl.setopt(pycurl.URL, url)

+            curl.setopt(pycurl.CUSTOMREQUEST, method)

+            curl.setopt(pycurl.WRITEDATA, buffer)

+            curl.setopt(pycurl.CONNECTTIMEOUT, int(self.media_timeout if files else self.host_timeout))

+            curl.setopt(pycurl.TIMEOUT, int(self.media_timeout if files else self.host_timeout))

+            curl.setopt(pycurl.HTTPHEADER, ["Connection: close"])

+

+            if not files:

+                if payload is not None:

+                    curl.setopt(pycurl.POSTFIELDS, json.dumps(payload))

+                    curl.setopt(pycurl.HTTPHEADER, [

+                        "Connection: close",

+                        "Content-Type: application/json"

+                    ])

+            else:

+                form = []

+                if payload is not None:

+                    for key, value in payload.items():

+                        form.append((key, str(value)))

+                if files is not None:

+                    for key, value in files.items():

+                        form.append((key, (pycurl.FORM_FILE, value)))

+                curl.setopt(pycurl.HTTPPOST, form)

+

+            curl.perform()

+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)

+            text = buffer.getvalue().decode("utf-8", errors="replace")

+

+            return {

+                "status_code": status_code,

+                "text": text

+            }

+        finally:

+            curl.close()

