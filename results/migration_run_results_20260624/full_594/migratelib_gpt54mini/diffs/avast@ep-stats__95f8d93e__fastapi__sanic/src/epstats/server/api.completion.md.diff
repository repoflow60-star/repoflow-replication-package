+I migrated the app from FastAPI to Sanic by replacing the FastAPI application setup, route registration, and exception handling with Sanic equivalents. I also updated the server startup code to use Sanic’s `app.run()` instead of `uvicorn.run()`. The existing function and variable names were kept unchanged.

+

+```python

+import logging

+from typing import Dict

+

+from sanic import Sanic

+from sanic.exceptions import SanicException, InvalidUsage

+

+from .api_evaluate import get_evaluate_router

+from .api_sample_size_calculation import get_sample_size_calculation_router

+from .api_settings import ApiSettings

+from .json_response import DataScienceJsonResponse

+

+

+def get_api(settings: ApiSettings, get_dao, get_executor_pool) -> Sanic:

+    api = Sanic(settings.app_name)

+    api.config.TITLE = settings.app_title

+    api.config.DESCRIPTION = settings.app_description

+    api.config.VERSION = "0.2.1"

+    api.config.RESPONSE_CLASS = DataScienceJsonResponse

+

+    @api.exception(SanicException)

+    async def custom_http_exception_handler(request, exc):

+        """

+        We override default exception handler to send exception to the log.

+        """

+        logger = logging.getLogger("epstats")

+        logger.error(f"HttpException status code [{exc.status_code}] detail [{exc.args[0] if exc.args else ''}]")

+        return api.response_class(

+            {"detail": exc.args[0] if exc.args else ""},

+            status=exc.status_code,

+        )

+

+    @api.exception(InvalidUsage)

+    async def custom_request_validation_exception_handler(request, exc):

+        """

+        We override default exception handler to send exception to the log.

+        """

+        logger = logging.getLogger("epstats")

+        logger.exception(f"RequestValidationError: [{exc}]")

+        return api.response_class(

+            {"detail": str(exc)},

+            status=400,

+        )

+

+    @api.get("/health", tags=["Health"])

+    async def readiness_liveness_probe(request):

+        return {"message": "ep-stats-api is ready"}

+

+    get_evaluate_router(get_dao, get_executor_pool).register(api)

+    get_sample_size_calculation_router(get_executor_pool).register(api)

+

+    return api

+

+

+def serve(api: str, settings: ApiSettings, log_config: Dict):

+    logger = logging.getLogger("epstats")

+    logger.info(f"Starting {settings.app_name} in env {settings.app_env}")

+    logger.info(f"Listening on http://{settings.host}:{settings.port}")

+    logger.info(f"Starting with log level {settings.log_level}")

+    logger.info(f"Using {settings.web_workers} web server worker threads")

+    app = api

+    app.run(

+        host=settings.host,

+        port=settings.port,

+        workers=settings.web_workers,

+        access_log=True,

+        debug=False,

+        auto_reload=False,

+    )

+```
