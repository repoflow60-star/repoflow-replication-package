+class _PycurlResponse(object):

+    def __init__(self, url, content, status_code, headers, history=None):

+        self.url = url

+        self.content = content

+        self.text = content.decode("utf-8", errors="replace")

+        self.status_code = status_code

+        self.headers = headers

+        self.history = history or []

+

+    def raise_for_status(self):

+        if self.status_code >= 400:

+            raise requests.HTTPError(

+                "%s Client Error: HTTP %s for url: %s"

+                % (self.status_code, self.status_code, self.url)

+            )

+

+

+class _PycurlSession(object):

+    def __init__(self):

+        self._share = pycurl.CurlShare()

+        self._share.setopt(pycurl.SH_SHARE, pycurl.LOCK_DATA_COOKIE)

+

+    def cookies_clear(self):

+        curl = pycurl.Curl()

+        curl.setopt(pycurl.SHARE, self._share)

+        curl.setopt(pycurl.COOKIEFILE, "")

+        curl.setopt(pycurl.COOKIEJAR, "")

+        curl.perform()

+        curl.close()

+

+    def _request(self, method, url, data=None):

+        history = []

+        current_url = url

+        for _ in range(10):

+            buffer = io.BytesIO()

+            header_buffer = io.BytesIO()

+            curl = pycurl.Curl()

+            curl.setopt(pycurl.URL, current_url)

+            curl.setopt(pycurl.WRITEDATA, buffer)

+            curl.setopt(pycurl.HEADERFUNCTION, header_buffer.write)

+            curl.setopt(pycurl.FOLLOWLOCATION, False)

+            curl.setopt(pycurl.SHARE, self._share)

+            curl.setopt(pycurl.COOKIEFILE, "")

+            curl.setopt(pycurl.COOKIEJAR, "")

+            curl.setopt(pycurl.USERAGENT, "python-pycurl")

+            if method == "POST":

+                curl.setopt(pycurl.POST, True)

+                curl.setopt(pycurl.POSTFIELDS, urlencode(data or {}))

+            curl.perform()

+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)

+            effective_url = curl.getinfo(pycurl.EFFECTIVE_URL)

+            curl.close()

+

+            content = buffer.getvalue()

+            headers = header_buffer.getvalue().decode("iso-8859-1", errors="replace")

+            response = _PycurlResponse(

+                url=effective_url,

+                content=content,

+                status_code=status_code,

+                headers=headers,

+                history=history,

+            )

+

+            if status_code in (301, 302, 303, 307, 308):

+                location = None

+                for line in headers.splitlines():

+                    if line.lower().startswith("location:"):

+                        location = line.split(":", 1)[1].strip()

+                        break

+                if location is None:

+                    return response

+                history.append(response)

+                current_url = urljoin(current_url, location)

+                continue

+

+            return response

+

+        return response

+

+    def get(self, url):

+        return self._request("GET", url)

+

+    def post(self, url, data=None):

+        return self._request("POST", url, data=data)

 

 

