+class Response:

+    def __init__(self, status_code: int, body: bytes) -> None:

+        self.status_code = status_code

+        self.content = body

+        self.text = body.decode("utf-8", errors="replace")

+

+    @property

+    def ok(self) -> bool:

+        return 200 <= self.status_code < 400

+

+    def json(self):

+        return json.loads(self.text)

+

+

+class Session:

+    def __init__(self) -> None:

+        self.headers = {}

+        self.cookies = CookieJar()

+

+    def _request(self, method: str, url: str, data=None, json_data=None, params=None, headers=None):

+        if params:

+            if "?" in url:

+                url = f"{url}&{urlencode(params)}"

+            else:

+                url = f"{url}?{urlencode(params)}"

+

+        body = None

+        request_headers = {}

+        request_headers.update(self.headers)

+        if headers:

+            request_headers.update(headers)

+

+        if json_data is not None:

+            body = json.dumps(json_data).encode("utf-8")

+            request_headers["Content-Type"] = "application/json"

+        elif data is not None:

+            if isinstance(data, str):

+                body = data.encode("utf-8")

+            else:

+                body = data

+

+        buffer = io.BytesIO()

+        header_buffer = io.BytesIO()

+        curl = pycurl.Curl()

+        curl.setopt(pycurl.URL, url)

+        curl.setopt(pycurl.FOLLOWLOCATION, True)

+        curl.setopt(pycurl.WRITEDATA, buffer)

+        curl.setopt(pycurl.HEADERFUNCTION, header_buffer.write)

+        curl.setopt(pycurl.COOKIEJAR, "")

+        curl.setopt(pycurl.COOKIEFILE, "")

+        cookie_list = []

+        for cookie in self.cookies:

+            cookie_list.append(f"{cookie.name}={cookie.value}")

+        if cookie_list:

+            curl.setopt(pycurl.COOKIE, "; ".join(cookie_list))

+        if request_headers:

+            curl.setopt(

+                pycurl.HTTPHEADER,

+                [f"{key}: {value}" for key, value in request_headers.items()],

+            )

+        if method == "POST":

+            curl.setopt(pycurl.POST, True)

+            if body is not None:

+                curl.setopt(pycurl.POSTFIELDS, body)

+        curl.perform()

+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)

+        curl.close()

+        return Response(status_code, buffer.getvalue())

+

+    def get(self, url: str, params=None, headers=None):

+        return self._request("GET", url, params=params, headers=headers)

+

+    def post(self, url: str, data=None, json=None, params=None, headers=None):

+        return self._request("POST", url, data=data, json_data=json, params=params, headers=headers)

+

