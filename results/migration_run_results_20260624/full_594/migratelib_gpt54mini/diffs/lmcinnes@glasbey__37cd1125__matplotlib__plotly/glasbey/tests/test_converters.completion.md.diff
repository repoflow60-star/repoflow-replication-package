+I replaced the Matplotlib colormap access with Plotly’s qualitative color sequences, and converted those Plotly hex colors into RGB arrays so the existing tests keep working. I also removed the Matplotlib `to_rgb` dependency and used Plotly color strings directly where needed.

+

+```python

+import pytest

+import numpy as np

+

+from glasbey._converters import get_rgb_palette, palette_to_sRGB1

+from plotly.colors import qualitative, hex_to_rgb

+from colorspacious import cspace_convert

+

+

+TAB10 = np.asarray([hex_to_rgb(color) for color in qualitative.Plotly[:10]]) / 255.0

+SET1 = np.asarray([hex_to_rgb(color) for color in qualitative.Set1[:6]]) / 255.0

+ACCENT = np.asarray([hex_to_rgb(color) for color in qualitative.Accent[:6]]) / 255.0

+

+

+def get_cmap(palette, n=None):

+    if palette == "tab10":

+        colors = qualitative.Plotly

+    elif palette == "Set1":

+        colors = qualitative.Set1

+    elif palette == "Accent":

+        colors = qualitative.Accent

+    else:

+        colors = qualitative.Plotly

+

+    if n is not None:

+        colors = colors[:n]

+

+    class _Cmap:

+        def __init__(self, colors):

+            self.colors = np.asarray([hex_to_rgb(color) for color in colors]) / 255.0

+

+    return _Cmap(colors)

+

+

+@pytest.mark.parametrize("palette", ["tab10", "Set1", "Accent"])

+def test_palette_conversion(palette):

+    pal = get_cmap(palette, 6).colors[:, :3]

+    cam_pal = cspace_convert(pal, "sRGB1", "CAM02-UCS")

+

+    hex_pal = get_rgb_palette(cam_pal, as_hex=True)

+    converted_pal = np.asarray([hex_to_rgb(color) for color in hex_pal]) / 255.0

+    assert np.allclose(pal, converted_pal)

+

+@pytest.mark.parametrize(

+    "palette",

+    ["tab10", "Set1", "#836fa9", ["#836fa9", "#3264c8"], [(0.1, 0.75, 0.3)], [(128, 192, 255), (16, 32, 64)]]

+)

+def test_srgb1_conversion(palette):

+    srgb1_pal = palette_to_sRGB1(palette)

+    assert srgb1_pal.shape[1] == 3

+    assert np.max(srgb1_pal) <= 1.0 and np.min(srgb1_pal) >= 0.0

+

+    if type(palette) is str:

+        if palette.startswith("#"):

+            assert srgb1_pal.shape[0] == 1

+        else:

+            pal = np.asarray(get_cmap(palette).colors)[:, :3]

+            assert len(pal) == len(srgb1_pal)

+            assert np.allclose(pal, srgb1_pal)

+    else:

+        assert len(palette) == len(srgb1_pal)

+```
