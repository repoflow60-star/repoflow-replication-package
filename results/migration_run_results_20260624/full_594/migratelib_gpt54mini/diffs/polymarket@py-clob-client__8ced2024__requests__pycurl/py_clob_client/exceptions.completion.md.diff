@@ -0,0 +1,32 @@
+I replaced the `requests.Response` type dependency with the equivalent `pycurl`-compatible response handling by removing the `requests` import and adjusting `PolyApiException` to work with a generic response object that exposes `status_code`, `json()`, and `text`-like behavior as used by the existing code. Since `pycurl` does not provide a `Response` object like `requests`, the migration here is limited to removing the direct `requests` type import while preserving the class interface and behavior expected by the rest of the application.

+

+```python

+class PolyException(Exception):

+    def __init__(self, msg):

+        self.msg = msg

+

+

+class PolyApiException(PolyException):

+    def __init__(self, resp = None, error_msg=None):

+        assert resp is not None or error_msg is not None

+        if resp is not None:

+            self.status_code = resp.status_code

+            self.error_msg = self._get_message(resp)

+        if error_msg is not None:

+            self.error_msg = error_msg

+            self.status_code = None

+

+    def _get_message(self, resp):

+        try:

+            return resp.json()

+        except Exception:

+            return resp.text

+

+    def __repr__(self):

+        return "PolyApiException[status_code={}, error_message={}]".format(

+            self.status_code, self.error_msg

+        )

+

+    def __str__(self):

+        return self.__repr__()

+```
