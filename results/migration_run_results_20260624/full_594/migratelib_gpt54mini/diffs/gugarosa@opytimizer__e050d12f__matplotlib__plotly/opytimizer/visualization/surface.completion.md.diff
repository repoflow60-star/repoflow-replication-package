+I replaced the `matplotlib` 3D plotting calls with the equivalent `plotly` 3D figure and trace setup. Specifically, I switched from `plt.figure`/`plt.axes(projection="3d")` to `plotly.graph_objects.Figure`, replaced `plot_wireframe` with a `Scatter3d` line trace, replaced `plot_surface` with a `Surface` trace, and mapped the titles, axis labels, and colorbar behavior to Plotly’s layout and color scale settings.

+

+```python

+"""3-D benchmarking functions plots.

+"""

+

+import plotly.graph_objects as go

+import numpy as np

+

+

+def plot(

+    points: np.ndarray,

+    title: str = "",

+    subtitle: str = "",

+    style: str = "winter",

+    colorbar: bool = True,

+) -> None:

+    """Plots the surface from a 3-dimensional function.

+

+    Args:

+        points: Points to be plotted with shape equal to (3, n, n).

+        title: Title of the plot.

+        subtitle: Subtitle of the plot.

+        style: Surface's style.

+        colorbar: If colorbar should be used or not.

+

+    """

+

+    fig = go.Figure()

+

+    fig.update_layout(

+        width=900,

+        height=500,

+        scene=dict(

+            xaxis_title="$x$",

+            yaxis_title="$y$",

+            zaxis_title="$f(x, y)$",

+        ),

+        title=dict(

+            text=f"{title}<span style='float:right;font-size:8px;color:grey'>{subtitle}</span>",

+            x=0.0,

+            xanchor="left",

+            font=dict(size=14),

+        ),

+    )

+

+    fig.add_trace(

+        go.Scatter3d(

+            x=points[0].flatten(),

+            y=points[1].flatten(),

+            z=points[2].flatten(),

+            mode="lines",

+            line=dict(color="grey", width=1),

+            showlegend=False,

+        )

+    )

+

+    surface = go.Surface(

+        x=points[0],

+        y=points[1],

+        z=points[2],

+        colorscale=style,

+        showscale=colorbar,

+        contours=dict(

+            x=dict(show=False),

+            y=dict(show=False),

+            z=dict(show=False),

+        ),

+    )

+

+    fig.add_trace(surface)

+

+    fig.show()

+```
