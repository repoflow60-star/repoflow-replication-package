+def _perform_request(

+        method: str,

+        url: str,

+        headers: Dict[str, str] = None,

+        data=None,

+        timeout: int = 300,

+        stream: bool = False):

+    response_body = io.BytesIO()

+    response_headers = io.BytesIO()

+    curl = pycurl.Curl()

+    curl.setopt(pycurl.URL, url)

+    curl.setopt(pycurl.TIMEOUT, timeout)

+    curl.setopt(pycurl.FOLLOWLOCATION, 1)

+    curl.setopt(pycurl.WRITEFUNCTION, response_body.write)

+    curl.setopt(pycurl.HEADERFUNCTION, response_headers.write)

+    if method == "PUT":

+        curl.setopt(pycurl.CUSTOMREQUEST, "PUT")

+    elif method == "POST":

+        curl.setopt(pycurl.POST, 1)

+    elif method == "GET":

+        curl.setopt(pycurl.HTTPGET, 1)

+    if headers:

+        curl.setopt(pycurl.HTTPHEADER, [f"{key}: {value}" for key, value in headers.items()])

+    if data is not None:

+        if isinstance(data, str):

+            data = data.encode()

+        curl.setopt(pycurl.POSTFIELDS, data)

+    try:

+        curl.perform()

+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)

+        reason = ""

+        header_text = response_headers.getvalue().decode(errors="ignore")

+        header_lines = header_text.splitlines()

+        if header_lines:

+            reason_parts = header_lines[0].split(" ", 2)

+            if len(reason_parts) >= 3:

+                reason = reason_parts[2]

+        body = response_body.getvalue()

+        return status_code, reason, body

+    finally:

+        curl.close()

 

