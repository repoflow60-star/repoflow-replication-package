+    def _curl_request(self, url, method='GET', data=None, headers=None, stream=False):

+        buffer = BytesIO()

+        response_headers = []

+

+        c = pycurl.Curl()

+        c.setopt(pycurl.URL, url)

+        c.setopt(pycurl.FOLLOWLOCATION, 1)

+        c.setopt(pycurl.WRITEFUNCTION, buffer.write)

+        c.setopt(pycurl.HEADERFUNCTION, lambda header_line: response_headers.append(header_line))

+

+        if not self.verify_ssl_certificate:

+            c.setopt(pycurl.SSL_VERIFYPEER, 0)

+            c.setopt(pycurl.SSL_VERIFYHOST, 0)

+

+        if headers:

+            c.setopt(pycurl.HTTPHEADER, headers)

+

+        if method == 'POST':

+            c.setopt(pycurl.POST, 1)

+            if data is not None:

+                c.setopt(pycurl.POSTFIELDS, data)

+        elif method == 'GET' and data is not None:

+            c.setopt(pycurl.HTTPGET, 1)

+

+        try:

+            c.perform()

+            status_code = c.getinfo(pycurl.RESPONSE_CODE)

+            content = buffer.getvalue()

+            if stream:

+                content = content.splitlines(True)

+            return status_code, content

+        finally:

+            c.close()

 

