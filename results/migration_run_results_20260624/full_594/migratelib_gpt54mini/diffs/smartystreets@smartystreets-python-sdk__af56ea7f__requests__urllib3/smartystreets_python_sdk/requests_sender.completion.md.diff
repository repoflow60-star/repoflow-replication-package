+I replaced the `requests` session/request flow with `urllib3`’s `PoolManager` and direct request sending. Since `urllib3` does not use `Request`, `prepare_request`, or `merge_environment_settings`, I built the request data manually and passed headers, body, method, and proxy settings directly to `urllib3`. I also adjusted response handling to work with `urllib3` response objects and ensured the response is closed after use.

+

+```python

+import urllib3

+from .response import Response

+import smartystreets_python_sdk as smarty

+import smartystreets_python_sdk_version as version

+

+

+class RequestsSender:

+    def __init__(self, max_timeout=None, proxy=None, ip=None):

+        self.session = urllib3.PoolManager()

+        self.max_timeout = max_timeout or 10

+        self.proxy = proxy

+        self.debug = None

+        self.ip = ip

+

+    def send(self, smarty_request):

+        ip = self.ip

+        request = build_request(smarty_request, ip)

+        prepped_proxies = self.build_proxies()

+        if self.debug:

+            print_request_data(request)

+

+        timeout = urllib3.Timeout(total=self.max_timeout)

+        if prepped_proxies:

+            if 'https' in prepped_proxies and 'http' not in prepped_proxies:

+                proxy_url = prepped_proxies['https']

+            else:

+                proxy_url = prepped_proxies.get('http')

+            session = urllib3.ProxyManager(proxy_url)

+        else:

+            session = self.session

+

+        response = session.request(

+            request.method,

+            request.url,

+            body=request.body,

+            headers=request.headers,

+            timeout=timeout,

+            preload_content=True

+        )

+        try:

+            if self.debug:

+                print_response_data(response)

+            return build_smarty_response(response)

+        finally:

+            response.close()

+

+    def build_proxies(self):

+        if not self.proxy:

+            return {}

+        if (self.proxy.host == 'http://' or self.proxy.host =='https://'):

+            raise smarty.exceptions.SmartyException('Proxy must have a valid host (including port)')

+

+        proxy_string = self.proxy.host

+

+        if self.proxy.username:

+            proxy_string += '{}:{}@'.format(self.proxy.username, self.proxy.password)

+

+        if ('https://' in self.proxy.host):

+            return {'https': proxy_string}

+        else:

+            return {'http': proxy_string, 'https': proxy_string}

+

+

+def build_request(smarty_request, ip=None):

+    try:

+        request = urllib3.request.RequestMethods

+        request = type('Request', (), {})()

+        request.url = smarty_request.url_prefix

+        request.headers = {}

+        request.headers['User-Agent'] = "smartystreets (sdk:python@{})".format(version.__version__)

+        request.headers['Content-Type'] = smarty_request.content_type

+        if smarty_request.referer:

+            request.headers['Referer'] = smarty_request.referer

+        if ip != None:

+            request.headers['X-Forwarded-For'] = ip

+        if smarty_request.payload:

+            request.body = smarty_request.payload

+            request.method = 'POST'

+        else:

+            request.body = None

+            request.method = 'GET'

+        return request

+    except AttributeError:

+        return smarty_request

+

+

+def build_smarty_response(inner_response, error=None):

+    return Response(inner_response.data.decode('utf-8'), inner_response.status, inner_response.headers, error)

+

+

+def print_request_data(request):

+    print(request.method)

+    print()

+    print('URL: {}\r\n'.format(request.url))

+    print('Headers:')

+    for header in request.headers:

+        print('  {}: {}'.format(header, request.headers[header]))

+    print()

+    print('Body: ')

+    print('  {}\r\n'.format(request.body))

+

+

+def print_response_data(response):

+    print('****** Response ******\r\n')

+    print(response.status)

+    print()

+    print(response.data.decode('utf-8'))

+    print('**********************\r\n')

+```
