+def _pycurl_request(url: str, method: str = 'GET', data=None) -> tuple[int, dict, str]:

+    response_headers = {}

+    response_body = io.BytesIO()

+    header_buffer = []

+

+    def header_function(header_line):

+        header_line = header_line.decode('iso-8859-1')

+        header_buffer.append(header_line)

+        if ':' in header_line:

+            key, value = header_line.split(':', 1)

+            response_headers[key.strip().lower()] = value.strip()

+        return len(header_line)

+

+    REQ_SESSION.setopt(pycurl.URL, url)

+    REQ_SESSION.setopt(pycurl.FOLLOWLOCATION, 0)

+    REQ_SESSION.setopt(pycurl.NOSIGNAL, 1)

+    REQ_SESSION.setopt(pycurl.WRITEFUNCTION, response_body.write)

+    REQ_SESSION.setopt(pycurl.HEADERFUNCTION, header_function)

+    REQ_SESSION.setopt(pycurl.CUSTOMREQUEST, method)

+

+    if VERIFY_SSL:

+        REQ_SESSION.setopt(pycurl.SSL_VERIFYPEER, 1)

+        REQ_SESSION.setopt(pycurl.SSL_VERIFYHOST, 2)

+    else:

+        REQ_SESSION.setopt(pycurl.SSL_VERIFYPEER, 0)

+        REQ_SESSION.setopt(pycurl.SSL_VERIFYHOST, 0)

+

+    if PROXY_DICT:

+        REQ_SESSION.setopt(pycurl.PROXY, PROXY_DICT.get('https') or PROXY_DICT.get('http'))

+

+    if method == 'POST':

+        REQ_SESSION.setopt(pycurl.POST, 1)

+        if data is not None:

+            REQ_SESSION.setopt(pycurl.POSTFIELDS, data)

+            REQ_SESSION.setopt(pycurl.POSTFIELDSIZE, len(data))

+    else:

+        REQ_SESSION.setopt(pycurl.HTTPGET, 1)

+

+    if method == 'POST':

+        headers = []

+        for k, v in UPLOAD_HEADERS.items():

+            headers.append(f'{k}: {v}')

+        REQ_SESSION.setopt(pycurl.HTTPHEADER, headers)

+    else:

+        REQ_SESSION.setopt(pycurl.HTTPHEADER, [])

+

+    REQ_SESSION.perform()

+    status_code = REQ_SESSION.getinfo(pycurl.RESPONSE_CODE)

+

+    return status_code, response_headers, response_body.getvalue().decode('utf-8', errors='replace')

