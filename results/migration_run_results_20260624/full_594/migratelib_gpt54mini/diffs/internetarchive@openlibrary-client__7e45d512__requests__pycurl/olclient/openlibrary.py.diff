+class _PycurlResponse:

+

+    def __init__(self, body, url, status_code, headers):

+        self._body = body

+        self.url = url

+        self.status_code = status_code

+        self.headers = headers

+

+    def json(self):

+        return json.loads(self._body.decode('utf-8'))

+

+    def raise_for_status(self):

+        if self.status_code >= 400:

+            raise pycurl.error(self.status_code, self._body.decode('utf-8'))

+

+

+class _PycurlSession:

+

+    def __init__(self):

+        self.cookie_file = tempfile.NamedTemporaryFile(delete=False)

+        self.cookie_file.close()

+

+    def _request(self, method, url, data=None, headers=None, files=None, json_data=None):

+        buffer = BytesIO()

+        header_buffer = BytesIO()

+        c = pycurl.Curl()

+        c.setopt(pycurl.URL, url)

+        c.setopt(pycurl.FOLLOWLOCATION, True)

+        c.setopt(pycurl.WRITEFUNCTION, buffer.write)

+        c.setopt(pycurl.HEADERFUNCTION, header_buffer.write)

+        c.setopt(pycurl.COOKIEFILE, self.cookie_file.name)

+        c.setopt(pycurl.COOKIEJAR, self.cookie_file.name)

+

+        request_headers = []

+        if headers:

+            for k, v in headers.items():

+                request_headers.append(f'{k}: {v}')

+

+        if json_data is not None:

+            data = json.dumps(json_data)

+            request_headers.append('Content-Type: application/json')

+

+        if files:

+            form = []

+            for k, v in files.items():

+                if isinstance(v, tuple):

+                    if len(v) == 3:

+                        form.append((k, (pycurl.FORM_FILE, v[0])))

+                    else:

+                        form.append((k, v))

+                else:

+                    form.append((k, v))

+            c.setopt(pycurl.HTTPPOST, form)

+        elif data is not None:

+            if isinstance(data, str):

+                data = data.encode('utf-8')

+            c.setopt(pycurl.POSTFIELDS, data)

+

+        if request_headers:

+            c.setopt(pycurl.HTTPHEADER, request_headers)

+

+        if method == 'POST':

+            c.setopt(pycurl.POST, True)

+        elif method == 'PUT':

+            c.setopt(pycurl.UPLOAD, True)

+            if data is not None:

+                c.setopt(pycurl.READFUNCTION, BytesIO(data).read)

+                c.setopt(pycurl.INFILESIZE, len(data))

+        elif method == 'GET':

+            c.setopt(pycurl.HTTPGET, True)

+

+        c.perform()

+        status_code = c.getinfo(pycurl.RESPONSE_CODE)

+        effective_url = c.getinfo(pycurl.EFFECTIVE_URL)

+        c.close()

+

+        return _PycurlResponse(

+            buffer.getvalue(),

+            effective_url,

+            status_code,

+            header_buffer.getvalue(),

+        )

+

+    def post(self, url, data=None, headers=None, files=None, json=None):

+        return self._request('POST', url, data=data, headers=headers, files=files, json_data=json)

+

+    def put(self, url, data=None, headers=None, json=None):

+        return self._request('PUT', url, data=data, headers=headers, json_data=json)

+

+    def get(self, url, headers=None):

+        return self._request('GET', url, headers=headers)

 

 

