+I migrated the code from `requests` to `treq` by replacing the synchronous `requests.get(...)` calls with `treq.get(...)`, and by adapting response handling to `treq`’s Twisted-style API. In `treq`, response bodies are retrieved asynchronously, so `response.json()` and `response.content` were replaced with `treq.json_content(...)` and `treq.content(...)`, and the functions now return the resulting Deferreds. I also kept the existing function names and structure unchanged.

+

+```python

+from typing import Any

+

+import treq

+

+

+def build_route(base_url: str, *paths: str | int) -> str:

+    if base_url.endswith("/"):

+        base_url = base_url[:-1]

+

+    paths = tuple(str(p).strip("/") for p in paths)

+    url = f"{base_url}/{'/'.join(paths)}"

+    return url.strip("/")

+

+

+def add_filters(url: str, *args: tuple[str, Any]) -> str:

+    """

+    Adds filters to the given url.

+    """

+    symbol = "?"

+    if "?" in url:

+        symbol = "&"

+    for arg in args:

+        url = f"{url}{symbol}{arg[0]}={arg[1]}"

+        symbol = "&"

+    return url

+

+

+def get(url: str) -> Any:

+    response = treq.get(url)

+    return treq.json_content(response)

+

+

+def get_content(url: str) -> bytes:

+    response = treq.get(url)

+    return treq.content(response)

+```
