+I migrated the code from `requests` to `treq` by replacing the synchronous `requests.get`/`requests.post` calls with `treq.get`/`treq.post`, and by updating response handling to use `treq`’s Twisted-style response objects. Since `treq` returns a Deferred-based response flow, I adjusted `_process_response` to read the response body via `treq.json_content(response)` and to handle failures using `twisted.web.error.Error` instead of `requests.exceptions.RequestException`.

+

+```python

+import treq

+from twisted.web.error import Error

+from abc import ABC, abstractmethod

+

+

+class HTTPMixin(ABC):

+    """

+    Very basic code used to make HTTP requests.

+    """

+

+    def send(self) -> dict:

+        match self._method():

+            case 'GET':

+                return self._get()

+            case 'POST':

+                return self._post()

+            case _:

+                raise Exception(f'Unsupported HTTP method {self._method()}')

+

+    def _get(self) -> dict:

+        return self._process_response(treq.get(self._endpoint(), headers=self._headers(), auth=self._auth()))

+

+    def _post(self) -> dict:

+        if self._is_form_encoded():

+            headers = self._headers()

+            headers['Content-Type'] = 'application/x-www-form-urlencoded'

+            return self._process_response(

+                treq.post(self._endpoint(), data=self._data(), headers=self._headers(), auth=self._auth()))

+        return self._process_response(

+            treq.post(self._endpoint(), json=self._data(), headers=self._headers(), auth=self._auth()))

+

+    @staticmethod

+    def _process_response(response) -> dict:

+        try:

+            if 200 <= response.code < 500:

+                return treq.json_content(response)

+            else:

+                raise Exception(f"HTTP {response.code} error while calling {response.request.absoluteURI.decode('utf-8')}")

+        except Error:

+            raise Exception(f"Connection failed while calling {response.request.absoluteURI.decode('utf-8')}")

+

+    @abstractmethod

+    def _method(self) -> str:

+        pass

+

+    @abstractmethod

+    def _endpoint(self) -> str:

+        pass

+

+    @abstractmethod

+    def _auth(self) -> tuple | None:

+        pass

+

+    @abstractmethod

+    def _headers(self) -> dict:

+        pass

+

+    @abstractmethod

+    def _data(self) -> dict:

+        pass

+

+    @abstractmethod

+    def _is_form_encoded(self) -> bool:

+        pass

+```
