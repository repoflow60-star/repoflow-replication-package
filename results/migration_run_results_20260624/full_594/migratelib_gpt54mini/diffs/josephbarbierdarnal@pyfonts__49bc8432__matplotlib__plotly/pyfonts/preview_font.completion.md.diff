+I replaced the `matplotlib` figure/text calls with an equivalent `plotly` figure using `go.Figure()` and `add_annotation()` for the three centered text lines. I also replaced `plt.axis("off")` and `plt.show()` with Plotly’s axis-hiding layout settings and `fig.show()`.

+

+```python

+from .main import load_font

+import plotly.graph_objects as go

+from typing import Optional

+

+

+def preview_font(

+    font_url: Optional[str] = None,

+    font_path: Optional[str] = None,

+):

+    """

+    Preview a font.

+    """

+    font = load_font(font_url, font_path)

+

+    fig = go.Figure()

+    fig.update_layout(

+        width=1000,

+        height=500,

+        xaxis=dict(visible=False),

+        yaxis=dict(visible=False),

+        margin=dict(l=0, r=0, t=0, b=0),

+    )

+

+    fig.add_annotation(

+        x=0.5,

+        y=0.5,

+        text="Hello, World From PyFonts!",

+        showarrow=False,

+        xref="paper",

+        yref="paper",

+        xanchor="center",

+        yanchor="middle",

+        font=dict(size=30, family=font),

+    )

+    fig.add_annotation(

+        x=0.5,

+        y=0.35,

+        text="This is a test.",

+        showarrow=False,

+        xref="paper",

+        yref="paper",

+        xanchor="center",

+        yanchor="middle",

+        font=dict(size=25, family=font),

+    )

+    fig.add_annotation(

+        x=0.5,

+        y=0.65,

+        text="How about this?",

+        showarrow=False,

+        xref="paper",

+        yref="paper",

+        xanchor="center",

+        yanchor="middle",

+        font=dict(size=20, family=font),

+    )

+

+    fig.show()

+```
