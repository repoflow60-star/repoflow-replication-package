+I replaced `tabulate` with `rich` by switching the table rendering to `rich.table.Table` and `rich.console.Console`. The row-building logic and all existing names were kept unchanged; only the output formatting dependency and the final print call were updated.

+

+```python

+from .command import Command

+import itertools

+from rich.console import Console

+from rich.table import Table

+

+

+class FollowersCommand(Command):

+    def __init__(self, args, env):

+        super().__init__(args, env)

+        self.offset = args.offset

+        self.limit = args.limit

+

+    def run(self):

+        coll = self.get_actor_collection("followers")

+        slice = self.collection_slice(coll, self.offset, self.limit)

+        rows = []

+        for item in slice:

+            follower = self.to_object(

+                item,

+                [

+                    "id",

+                    "preferredUsername",

+                    ["name", "nameMap", "summary", "summaryMap"],

+                ],

+            )

+            id = self.to_webfinger(follower)

+            name = self.to_text(follower)

+            rows.append([id, name])

+        table = Table(show_header=True, header_style=None)

+        table.add_column("id")

+        table.add_column("name")

+        for row in rows:

+            table.add_row(*row)

+        Console().print(table)

+```
