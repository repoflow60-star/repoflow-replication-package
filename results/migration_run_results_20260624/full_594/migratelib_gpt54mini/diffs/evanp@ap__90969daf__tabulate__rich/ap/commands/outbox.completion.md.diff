+I replaced `tabulate` with `rich` by switching from `tabulate(...)` to `rich.table.Table`, adding columns for the same headers, and printing the table with `Console.print()`. No class, function, or variable names were changed.

+

+```python

+from .command import Command

+import itertools

+from rich.console import Console

+from rich.table import Table

+

+

+class OutboxCommand(Command):

+    def __init__(self, args, env):

+        super().__init__(args, env)

+        self.offset = args.offset

+        self.limit = args.limit

+

+    def run(self):

+        actor = self.logged_in_actor()

+        if actor is None:

+            raise Exception("Not logged in")

+        outbox = actor.get("outbox", None)

+        if outbox is None:

+            raise Exception("No outbox found")

+        outbox_id = self.to_id(outbox)

+        slice = itertools.islice(

+            self.items(outbox_id), self.offset, self.offset + self.limit

+        )

+        rows = []

+        for item in slice:

+            id = self.to_id(item)

+            type = item.get("type", None)

+            summary = self.text_prop(item, "summary")

+            published = item.get("published")

+            rows.append([id, type, summary, published])

+        table = Table()

+        table.add_column("id")

+        table.add_column("type")

+        table.add_column("summary")

+        table.add_column("published")

+        for row in rows:

+            table.add_row(*[str(value) if value is not None else "" for value in row])

+        Console().print(table)

+```
