+async def _aiohttp_request(method, url, input_options, params=None, data=None):

+    timeout = aiohttp.ClientTimeout(total=input_options.timeout) if input_options.timeout else None

+    async with aiohttp.ClientSession(timeout=timeout, headers=input_options.http_headers) as session:

+        async with session.request(method, url, ssl=input_options.verify_ssl, params=params, data=data, allow_redirects=False) as response:

+            response._content = await response.read()

+            return response

+

+

+def asyncio_run(coro):

+    try:

+        return asyncio.run(coro)

+    except RuntimeError:

+        loop = asyncio.get_event_loop()

+        return loop.run_until_complete(coro)

+

