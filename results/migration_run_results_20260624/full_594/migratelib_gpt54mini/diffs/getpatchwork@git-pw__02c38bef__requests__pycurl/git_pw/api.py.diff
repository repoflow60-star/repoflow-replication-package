+class _Response:

+    def __init__(self, body: bytes, headers: ty.Dict[str, str], status_code: int):

+        self.content = body

+        self.headers = headers

+        self.status_code = status_code

+

+    def json(self):

+        return json.loads(self.content.decode('utf-8'))

+

+    def iter_content(self, chunk_size: int):

+        for i in range(0, len(self.content), chunk_size):

+            yield self.content[i:i + chunk_size]

+

+    def raise_for_status(self):

+        if self.status_code >= 400:

+            raise pycurl.error(self.status_code, self.content.decode('utf-8', errors='replace'))

+

+

+def _request(

+    method: str,

+    url: str,

+    params: ty.Optional[Filters] = None,

+    data: ty.Optional[ty.List[ty.Tuple[str, ty.Any]]] = None,

+    stream: bool = False,

+) -> _Response:

+    body = io.BytesIO()

+    header_buf = io.BytesIO()

+

+    if params:

+        query = '&'.join(

+            '{}={}'.format(

+                pycurl.escape(str(k)),

+                pycurl.escape(str(v)),

+            )

+            for k, v in params

+        )

+        if '?' in url:

+            url = url + '&' + query

+        else:

+            url = url + '?' + query

+

+    curl = pycurl.Curl()

+    try:

+        curl.setopt(pycurl.URL, url)

+        curl.setopt(pycurl.FOLLOWLOCATION, 1)

+        curl.setopt(pycurl.WRITEFUNCTION, body.write)

+        curl.setopt(pycurl.HEADERFUNCTION, header_buf.write)

+        curl.setopt(pycurl.HTTPHEADER, [

+            '{}: {}'.format(k, v) for k, v in _get_headers().items()

+        ])

+

+        auth = _get_auth(optional=(method == 'GET'))

+        if isinstance(auth, HTTPTokenAuth):

+            curl.setopt(pycurl.HTTPHEADER, [

+                '{}: {}'.format(k, v) for k, v in _get_headers().items()

+            ] + [

+                'Authorization: {}'.format(HTTPTokenAuth._token_auth_str(auth.token))

+            ])

+        elif isinstance(auth, tuple):

+            curl.setopt(pycurl.USERPWD, '{}:{}'.format(auth[0], auth[1]))

+

+        if method == 'GET':

+            curl.setopt(pycurl.HTTPGET, 1)

+        elif method == 'POST':

+            curl.setopt(pycurl.POST, 1)

+        elif method == 'PATCH':

+            curl.setopt(pycurl.CUSTOMREQUEST, 'PATCH')

+        elif method == 'DELETE':

+            curl.setopt(pycurl.CUSTOMREQUEST, 'DELETE')

+

+        if data is not None:

+            encoded = '&'.join(

+                '{}={}'.format(

+                    pycurl.escape(str(k)),

+                    pycurl.escape(str(v)),

+                )

+                for k, v in data

+            ).encode('utf-8')

+            curl.setopt(pycurl.POSTFIELDS, encoded)

+

+        curl.perform()

+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)

+        headers = {}

+        for line in header_buf.getvalue().decode('iso-8859-1').splitlines():

+            if ':' in line:

+                key, value = line.split(':', 1)

+                headers[key.strip().lower()] = value.strip()

+

+        rsp = _Response(body.getvalue(), headers, status_code)

+        rsp.raise_for_status()

+    except pycurl.error as exc:

+        _handle_error(method.lower(), exc)

+    finally:

+        curl.close()

+

+    return rsp

+

