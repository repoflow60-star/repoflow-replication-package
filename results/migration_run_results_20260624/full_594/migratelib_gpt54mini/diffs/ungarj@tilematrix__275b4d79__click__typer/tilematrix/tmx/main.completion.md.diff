--- /dev/null
+++ b/tilematrix/tmx/main.completion.md
@@ -0,0 +1,209 @@
+I migrated the CLI from `click` to `typer` by replacing the Click decorators and context handling with Typer’s `Typer()` app, `Option`/`Argument` annotations, and `typer.echo`. I also replaced `click.Choice` with `typer.Option(..., case_sensitive=True)`-style string options using `Literal`-compatible defaults via Typer’s native typing approach, while keeping the original function and variable names unchanged.

+

+```python

+import typer

+import geojson

+from shapely.geometry import box

+

+import tilematrix

+from tilematrix import TilePyramid

+

+

+tmx = typer.Typer(add_completion=False)

+

+

+@tmx.callback()

+def tmx_callback(

+    pixelbuffer: int = typer.Option(

+        0,

+        "--pixelbuffer",

+        "-p",

+        help="Tile bounding box buffer in pixels. (default: 0)",

+    ),

+    tile_size: int = typer.Option(

+        256,

+        "--tile_size",

+        "-s",

+        help="Tile size in pixels. (default: 256)",

+    ),

+    metatiling: int = typer.Option(

+        1,

+        "--metatiling",

+        "-m",

+        help="TilePyramid metatile size. (default: 1)",

+    ),

+    grid: str = typer.Option(

+        "geodetic",

+        "--grid",

+        "-g",

+        help="TilePyramid base grid. (default: geodetic)",

+    ),

+    output_format: str = typer.Option(

+        "Tile",

+        "--output_format",

+        "-f",

+        help="Print Tile ID or Tile bounding box as WKT or GeoJSON. (default: Tile)",

+    ),

+):

+    tmx.info = dict(

+        pixelbuffer=pixelbuffer,

+        tile_size=tile_size,

+        metatiling=metatiling,

+        grid=grid,

+        output_format=output_format,

+    )

+

+

+@tmx.command(short_help="Tile bounds.")

+def bounds(

+    TILE: tuple[int, int, int] = typer.Argument(...),

+):

+    """Print Tile bounds."""

+    click_obj = tmx.info

+    typer.echo(

+        "%s %s %s %s"

+        % TilePyramid(

+            click_obj["grid"],

+            tile_size=click_obj["tile_size"],

+            metatiling=click_obj["metatiling"],

+        )

+        .tile(*TILE)

+        .bounds(pixelbuffer=click_obj["pixelbuffer"])

+    )

+

+

+@tmx.command(short_help="Tile bounding box.")

+def bbox(

+    TILE: tuple[int, int, int] = typer.Argument(...),

+):

+    """Print Tile bounding box as geometry."""

+    click_obj = tmx.info

+    geom = (

+        TilePyramid(

+            click_obj["grid"],

+            tile_size=click_obj["tile_size"],

+            metatiling=click_obj["metatiling"],

+        )

+        .tile(*TILE)

+        .bbox(pixelbuffer=click_obj["pixelbuffer"])

+    )

+    if click_obj["output_format"] in ["WKT", "Tile"]:

+        typer.echo(geom)

+    elif click_obj["output_format"] == "GeoJSON":

+        typer.echo(geojson.dumps(geom))

+

+

+@tmx.command(short_help="Tile from point.")

+def tile(

+    ZOOM: int = typer.Argument(...),

+    POINT: tuple[float, float] = typer.Argument(...),

+):

+    """Print Tile containing POINT.."""

+    click_obj = tmx.info

+    tile = TilePyramid(

+        click_obj["grid"],

+        tile_size=click_obj["tile_size"],

+        metatiling=click_obj["metatiling"],

+    ).tile_from_xy(*POINT, zoom=ZOOM)

+    if click_obj["output_format"] == "Tile":

+        typer.echo("%s %s %s" % tile.id)

+    elif click_obj["output_format"] == "WKT":

+        typer.echo(tile.bbox(pixelbuffer=click_obj["pixelbuffer"]))

+    elif click_obj["output_format"] == "GeoJSON":

+        typer.echo(

+            geojson.dumps(

+                geojson.FeatureCollection(

+                    [

+                        geojson.Feature(

+                            geometry=tile.bbox(pixelbuffer=click_obj["pixelbuffer"]),

+                            properties=dict(zoom=tile.zoom, row=tile.row, col=tile.col),

+                        )

+                    ]

+                )

+            )

+        )

+

+

+@tmx.command(short_help="Tiles from bounds.")

+def tiles(

+    ZOOM: int = typer.Argument(...),

+    BOUNDS: tuple[float, float, float, float] = typer.Argument(...),

+):

+    """Print Tiles from bounds."""

+    click_obj = tmx.info

+    tiles = TilePyramid(

+        click_obj["grid"],

+        tile_size=click_obj["tile_size"],

+        metatiling=click_obj["metatiling"],

+    ).tiles_from_bounds(BOUNDS, zoom=ZOOM)

+    if click_obj["output_format"] == "Tile":

+        for tile in tiles:

+            typer.echo("%s %s %s" % tile.id)

+    elif click_obj["output_format"] == "WKT":

+        for tile in tiles:

+            typer.echo(tile.bbox(pixelbuffer=click_obj["pixelbuffer"]))

+    elif click_obj["output_format"] == "GeoJSON":

+        typer.echo("{\n" '  "type": "FeatureCollection",\n' '  "features": [')

+        # print tiles as they come and only add comma if there is a next tile

+        try:

+            tile = next(tiles)

+            while True:

+                gj = "    %s" % geojson.Feature(

+                    geometry=tile.bbox(pixelbuffer=click_obj["pixelbuffer"]),

+                    properties=dict(zoom=tile.zoom, row=tile.row, col=tile.col),

+                )

+                try:

+                    tile = next(tiles)

+                    typer.echo(gj + ",")

+                except StopIteration:

+                    typer.echo(gj)

+                    raise

+        except StopIteration:

+            pass

+        typer.echo("  ]\n" "}")

+

+

+@tmx.command(short_help="Snap bounds to tile grid.")

+def snap_bounds(

+    ZOOM: int = typer.Argument(...),

+    BOUNDS: tuple[float, float, float, float] = typer.Argument(...),

+):

+    """nap bounds to tile grid."""

+    click_obj = tmx.info

+    typer.echo(

+        "%s %s %s %s"

+        % tilematrix.snap_bounds(

+            bounds=BOUNDS,

+            tile_pyramid=TilePyramid(

+                click_obj["grid"],

+                tile_size=click_obj["tile_size"],

+                metatiling=click_obj["metatiling"],

+            ),

+            zoom=ZOOM,

+            pixelbuffer=click_obj["pixelbuffer"],

+        )

+    )

+

+

+@tmx.command(short_help="Snap bbox to tile grid.")

+def snap_bbox(

+    ZOOM: int = typer.Argument(...),

+    BOUNDS: tuple[float, float, float, float] = typer.Argument(...),

+):

+    """Snap bbox to tile grid."""

+    click_obj = tmx.info

+    typer.echo(

+        box(

+            *tilematrix.snap_bounds(

+                bounds=BOUNDS,

+                tile_pyramid=TilePyramid(

+                    click_obj["grid"],

+                    tile_size=click_obj["tile_size"],

+                    metatiling=click_obj["metatiling"],

+                ),

+                zoom=ZOOM,

+                pixelbuffer=click_obj["pixelbuffer"],

+            )

+        )

+    )

+```
