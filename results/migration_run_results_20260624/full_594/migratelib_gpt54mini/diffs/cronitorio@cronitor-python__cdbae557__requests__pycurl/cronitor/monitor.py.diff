+class _PycurlSession(object):

+    def __init__(self, retries=0, backoff_factor=0.3):

+        self.retries = retries

+        self.backoff_factor = backoff_factor

+

+    def _request(self, method, url, auth=None, headers=None, timeout=None, data=None, params=None):

+        attempt = 0

+        while True:

+            try:

+                buffer = []

+                header_buffer = []

+

+                if params:

+                    query = []

+                    for k, v in params.items():

+                        if v is None:

+                            continue

+                        query.append('{}={}'.format(k, v))

+                    if query:

+                        if '?' in url:

+                            url = '{}&{}'.format(url, '&'.join(query))

+                        else:

+                            url = '{}?{}'.format(url, '&'.join(query))

+

+                c = pycurl.Curl()

+                c.setopt(pycurl.URL, url)

+                c.setopt(pycurl.FOLLOWLOCATION, True)

+                c.setopt(pycurl.CONNECTTIMEOUT, timeout or 10)

+                c.setopt(pycurl.TIMEOUT, timeout or 10)

+                c.setopt(pycurl.WRITEFUNCTION, buffer.append)

+                c.setopt(pycurl.HEADERFUNCTION, header_buffer.append)

+

+                if method == 'PUT':

+                    c.setopt(pycurl.CUSTOMREQUEST, 'PUT')

+                    c.setopt(pycurl.UPLOAD, 1)

+                    c.setopt(pycurl.READFUNCTION, lambda size: data.encode('utf-8') if data else b'')

+                    c.setopt(pycurl.INFILESIZE, len(data.encode('utf-8')) if data else 0)

+                elif method == 'DELETE':

+                    c.setopt(pycurl.CUSTOMREQUEST, 'DELETE')

+                elif method == 'GET':

+                    c.setopt(pycurl.HTTPGET, 1)

+

+                if auth:

+                    c.setopt(pycurl.USERPWD, '{}:{}'.format(auth[0], auth[1]))

+

+                curl_headers = []

+                if headers:

+                    for k, v in headers.items():

+                        if v is not None:

+                            curl_headers.append('{}: {}'.format(k, v))

+                if curl_headers:

+                    c.setopt(pycurl.HTTPHEADER, curl_headers)

+

+                c.perform()

+                status_code = c.getinfo(pycurl.RESPONSE_CODE)

+                c.close()

+

+                text = b''.join(buffer).decode('utf-8')

+                return _PycurlResponse(status_code, text)

+            except pycurl.error:

+                attempt += 1

+                if attempt > self.retries:

+                    raise

+                time.sleep(self.backoff_factor * (2 ** (attempt - 1)))

+

+    def get(self, url, auth=None, headers=None, timeout=None, params=None):

+        return self._request('GET', url, auth=auth, headers=headers, timeout=timeout, params=params)

+

+    def put(self, url, auth=None, headers=None, timeout=None, data=None):

