+def _treq_get_json(response):

+    d = response

+

+    @inlineCallbacks

+    def _get():

+        body = yield treq.content(d)

+        return json.loads(body.decode('utf-8'))

+

+    result = []

+

+    def _store(value):

+        result.append(value)

+        reactor.stop()

+

+    def _fail(failure):

+        result.append(failure)

+        reactor.stop()

+

+    _get().addCallbacks(_store, _fail)

+    reactor.run()

+

+    if result and hasattr(result[0], 'raiseException'):

+        result[0].raiseException()

+

+    return result[0]

 

 

