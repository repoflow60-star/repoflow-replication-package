@@ -0,0 +1,55 @@
+I replaced the `matplotlib` colormap access with `altair`’s built-in categorical scheme palettes, using `altair`’s `scheme` definitions to obtain the equivalent color lists. The `to_rgb` conversion remains unchanged because it is still needed to validate hex output, but all `get_cmap(...)` usage was migrated away from `matplotlib`.

+

+```python

+import pytest

+import numpy as np

+

+from glasbey._converters import get_rgb_palette, palette_to_sRGB1

+import altair as alt

+from matplotlib.colors import to_rgb

+from colorspacious import cspace_convert

+

+

+TAB10 = np.asarray(alt.SchemeParams(name="tableau10").scheme)[:, :3]

+SET1 = np.asarray(alt.SchemeParams(name="set1").scheme)[:, :3]

+ACCENT = np.asarray(alt.SchemeParams(name="accent").scheme)[:, :3]

+

+

+@pytest.mark.parametrize("palette", ["tab10", "Set1", "Accent"])

+def test_palette_conversion(palette):

+    if palette == "tab10":

+        pal = np.asarray(alt.SchemeParams(name="tableau10").scheme)[:, :3]

+    elif palette == "Set1":

+        pal = np.asarray(alt.SchemeParams(name="set1").scheme)[:, :3]

+    else:

+        pal = np.asarray(alt.SchemeParams(name="accent").scheme)[:, :3]

+    cam_pal = cspace_convert(pal, "sRGB1", "CAM02-UCS")

+

+    hex_pal = get_rgb_palette(cam_pal, as_hex=True)

+    converted_pal = np.asarray([to_rgb(color) for color in hex_pal])

+    assert np.allclose(pal, converted_pal)

+

+@pytest.mark.parametrize(

+    "palette",

+    ["tab10", "Set1", "#836fa9", ["#836fa9", "#3264c8"], [(0.1, 0.75, 0.3)], [(128, 192, 255), (16, 32, 64)]]

+)

+def test_srgb1_conversion(palette):

+    srgb1_pal = palette_to_sRGB1(palette)

+    assert srgb1_pal.shape[1] == 3

+    assert np.max(srgb1_pal) <= 1.0 and np.min(srgb1_pal) >= 0.0

+

+    if type(palette) is str:

+        if palette.startswith("#"):

+            assert srgb1_pal.shape[0] == 1

+        else:

+            if palette == "tab10":

+                pal = np.asarray(alt.SchemeParams(name="tableau10").scheme)[:, :3]

+            elif palette == "Set1":

+                pal = np.asarray(alt.SchemeParams(name="set1").scheme)[:, :3]

+            else:

+                pal = np.asarray(alt.SchemeParams(name="accent").scheme)[:, :3]

+            assert len(pal) == len(srgb1_pal)

+            assert np.allclose(pal, srgb1_pal)

+    else:

+        assert len(palette) == len(srgb1_pal)

+```
