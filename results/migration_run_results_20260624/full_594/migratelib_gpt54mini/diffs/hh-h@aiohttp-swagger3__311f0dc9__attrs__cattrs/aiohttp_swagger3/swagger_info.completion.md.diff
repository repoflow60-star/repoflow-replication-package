@@ -0,0 +1,46 @@
+I migrated the code from `attrs` to `cattrs` by replacing `attr`-based class declarations with standard Python classes and using `cattrs` only for structuring/unstructuring support where needed. Since `cattrs` is primarily a conversion library rather than a class-definition library, the `attr.asdict(...)` calls were replaced with `cattrs.unstructure(...)` for nested objects, while preserving the original class names, fields, and behavior.

+

+```python

+from typing import Dict, Optional

+

+import cattrs

+

+

+class SwaggerContact:

+    name: Optional[str] = None

+    url: Optional[str] = None

+    email: Optional[str] = None

+

+    def empty(self) -> bool:

+        return self.name is None and self.url is None and self.email is None

+

+

+class SwaggerLicense:

+    name: str

+    url: Optional[str] = None

+

+

+class SwaggerInfo:

+    title: str

+    version: str

+    description: Optional[str] = None

+    terms_of_service: Optional[str] = None

+    contact: Optional[SwaggerContact] = None

+    license: Optional[SwaggerLicense] = None

+

+    def to_json(self) -> Dict:

+        result: Dict = {

+            "title": self.title,

+            "version": self.version,

+        }

+        if self.description is not None:

+            result["description"] = self.description

+        if self.terms_of_service is not None:

+            result["termsOfService"] = self.terms_of_service

+        if self.contact is not None and not self.contact.empty():

+            result["contact"] = cattrs.unstructure(self.contact)

+        if self.license is not None:

+            result["license"] = cattrs.unstructure(self.license)

+

+        return result

+```
