@@ -0,0 +1,42 @@
+I replaced the `requests.Request` usage with a `pycurl.Curl`-based request setup. Since `pycurl` does not have a `Request` object like `requests`, the `build_request` method now creates and configures a `Curl` instance with the URL, headers, query parameters, and optional POST body. The class, method names, and variable names were kept unchanged.

+

+```python

+import pycurl

+from io import BytesIO

+from urllib.parse import urlencode

+

+

+class CustomHeaderSender:

+    def __init__(self, headers, inner):

+        self.headers = headers

+        self.inner = inner

+

+    def send(self, smarty_request):

+        request = self.build_request(smarty_request)

+        return self.inner.send(request)

+

+    def build_request(self, smarty_request):

+        url = smarty_request.url_prefix

+        if smarty_request.parameters:

+            query_string = urlencode(smarty_request.parameters)

+            if '?' in url:

+                url = url + '&' + query_string

+            else:

+                url = url + '?' + query_string

+

+        request = pycurl.Curl()

+        request.setopt(pycurl.URL, url)

+

+        header_list = []

+        for key, value in self.headers.items():

+            header_list.append(str(key) + ': ' + str(value))

+        request.setopt(pycurl.HTTPHEADER, header_list)

+

+        if smarty_request.payload:

+            request.setopt(pycurl.POST, 1)

+            request.setopt(pycurl.POSTFIELDS, smarty_request.payload)

+        else:

+            request.setopt(pycurl.HTTPGET, 1)

+

+        return request

+```
