@@ -0,0 +1,146 @@
+I replaced the `requests` session/request flow with `pycurl` by:

+- removing `requests.Session` / `requests.Request` usage,

+- building and executing the HTTP request directly with `pycurl.Curl`,

+- mapping headers, method, query parameters, body, timeout, and proxy settings to `pycurl` options,

+- capturing the response body and status code so the existing `build_smarty_response()` logic can stay unchanged.

+

+```python

+import pycurl

+from io import BytesIO

+from urllib.parse import urlencode

+

+from .response import Response

+import smartystreets_python_sdk as smarty

+import smartystreets_python_sdk_version as version

+

+

+class RequestsSender:

+    def __init__(self, max_timeout=None, proxy=None, ip=None):

+        self.session = None

+        self.max_timeout = max_timeout or 10

+        self.proxy = proxy

+        self.debug = None

+        self.ip = ip

+

+    def send(self, smarty_request):

+        ip = self.ip

+        request = build_request(smarty_request, ip)

+        prepped_request = request

+        prepped_proxies = self.build_proxies()

+        if self.debug:

+            print_request_data(prepped_request)

+

+        response = perform_request(prepped_request, prepped_proxies, self.max_timeout)

+        if self.debug:

+            print_response_data(response)

+        return build_smarty_response(response)

+

+    def build_proxies(self):

+        if not self.proxy:

+            return {}

+        if (self.proxy.host == 'http://' or self.proxy.host =='https://'):

+            raise smarty.exceptions.SmartyException('Proxy must have a valid host (including port)')

+

+        proxy_string = self.proxy.host

+

+        if self.proxy.username:

+            proxy_string += '{}:{}@'.format(self.proxy.username, self.proxy.password)

+

+        if ('https://' in self.proxy.host):

+            return {'https': proxy_string}

+        else:

+            return {'http': proxy_string, 'https': proxy_string}

+

+

+def build_request(smarty_request, ip=None):

+    try:

+        request = {}

+        request['url'] = smarty_request.url_prefix

+        request['params'] = smarty_request.parameters

+        request['headers'] = {}

+        request['headers']['User-Agent'] = "smartystreets (sdk:python@{})".format(version.__version__)

+        request['headers']['Content-Type'] = smarty_request.content_type

+        if smarty_request.referer:

+            request['headers']['Referer'] = smarty_request.referer

+        if ip != None:

+            request['headers']['X-Forwarded-For'] = ip

+        if smarty_request.payload:

+            request['data'] = smarty_request.payload

+            request['method'] = 'POST'

+        else:

+            request['method'] = 'GET'

+        return request

+    except AttributeError:

+        return smarty_request

+

+

+def perform_request(request, proxies, max_timeout):

+    curl = pycurl.Curl()

+    buffer = BytesIO()

+

+    url = request['url']

+    if request.get('params'):

+        query_string = urlencode(request['params'], doseq=True)

+        if '?' in url:

+            url += '&' + query_string

+        else:

+            url += '?' + query_string

+

+    curl.setopt(pycurl.URL, url.encode('utf-8'))

+    curl.setopt(pycurl.TIMEOUT, max_timeout)

+    curl.setopt(pycurl.WRITEFUNCTION, buffer.write)

+

+    headers = []

+    for header in request['headers']:

+        headers.append('{}: {}'.format(header, request['headers'][header]))

+    curl.setopt(pycurl.HTTPHEADER, headers)

+

+    if request['method'] == 'POST':

+        curl.setopt(pycurl.POST, 1)

+        curl.setopt(pycurl.POSTFIELDS, request['data'])

+

+    if proxies:

+        if 'https' in proxies:

+            curl.setopt(pycurl.PROXY, proxies['https'])

+        elif 'http' in proxies:

+            curl.setopt(pycurl.PROXY, proxies['http'])

+

+    curl.perform()

+    status_code = curl.getinfo(pycurl.RESPONSE_CODE)

+    body = buffer.getvalue().decode('utf-8')

+    response_headers = {}

+

+    curl.close()

+

+    class CurlResponse:

+        def __init__(self, text, status_code, headers):

+            self.text = text

+            self.status_code = status_code

+            self.headers = headers

+

+    return CurlResponse(body, status_code, response_headers)

+

+

+def build_smarty_response(inner_response, error=None):

+    return Response(inner_response.text, inner_response.status_code, inner_response.headers, error)

+

+

+def print_request_data(request):

+    print(request['method'])

+    print()

+    print('URL: {}\r\n'.format(request['url']))

+    print('Headers:')

+    for header in request['headers']:

+        print('  {}: {}'.format(header, request['headers'][header]))

+    print()

+    print('Body: ')

+    print('  {}\r\n'.format(request.get('data')))

+

+

+def print_response_data(response):

+    print('****** Response ******\r\n')

+    print(response.status_code)

+    print()

+    print(response.text)

+    print('**********************\r\n')

+```
