+    def __perform_request(self, method, url, params=None, body=None, files=None):

+        buffer = BytesIO()

+        header_buffer = BytesIO()

+        curl = pycurl.Curl()

+        try:

+            if params:

+                url = url + '?' + urlencode(params, doseq=True)

+            curl.setopt(pycurl.URL, url)

+            curl.setopt(pycurl.WRITEDATA, buffer)

+            curl.setopt(pycurl.HEADERFUNCTION, header_buffer.write)

+            curl.setopt(pycurl.CUSTOMREQUEST, method)

+            curl.setopt(pycurl.FOLLOWLOCATION, True)

+

+            if self.headers:

+                header_list = []

+                for key, value in self.headers.items():

+                    header_list.append(f"{key}: {value}")

+                curl.setopt(pycurl.HTTPHEADER, header_list)

+

+            if self.verify is False:

+                curl.setopt(pycurl.SSL_VERIFYPEER, False)

+                curl.setopt(pycurl.SSL_VERIFYHOST, False)

+

+            if self.certs:

+                if isinstance(self.certs, tuple) and len(self.certs) > 0:

+                    curl.setopt(pycurl.SSLCERT, self.certs[0])

+                if isinstance(self.certs, tuple) and len(self.certs) > 1:

+                    curl.setopt(pycurl.SSLKEY, self.certs[1])

+

+            if method in ['POST', 'PUT'] and body is not None and files is None:

+                curl.setopt(pycurl.POSTFIELDS, json.dumps(body))

+                if self.headers and 'Content-Type' not in self.headers and 'content-type' not in self.headers:

+                    curl.setopt(pycurl.HTTPHEADER, [f"{key}: {value}" for key, value in self.headers.items()] + ['Content-Type: application/json'])

+

+            if files is not None:

+                form = []

+                for key, value in files.items():

+                    form.append((key, (pycurl.FORM_FILE, value)))

+                curl.setopt(pycurl.HTTPPOST, form)

+

+            curl.perform()

+            status = curl.getinfo(pycurl.RESPONSE_CODE)

+            response_text = buffer.getvalue().decode('utf-8')

+            return {

+                "data": json.loads(response_text),

+                "status": status

+            }

+        except pycurl.error as e:

+            status = 0

+            response_text = buffer.getvalue().decode('utf-8')

+            try:

+                status = curl.getinfo(pycurl.RESPONSE_CODE)

+            except Exception:

+                pass

+            if status == 404:

+                raise NotFoundError(

+                    message=self.parse_response_message(type('obj', (object,), {'text': response_text})()),

+                    status=status

+                ) from None

+            elif status == 400:

+                raise InvalidJsonError(

+                    message=self.parse_response_message(type('obj', (object,), {'text': response_text})()),

+                    status=status

+                ) from None

+            elif status == 401:

+                raise UnauthorizedError(

+                    message=self.parse_response_message(type('obj', (object,), {'text': response_text})()),

+                    status=status

+                ) from None

+            elif status != 0:

+                raise HttpError(

+                    message=self.parse_response_message(type('obj', (object,), {'text': response_text})()),

+                    status=status

+                ) from None

+            else:

+                raise ConnectionUnavailableError(e) from None

+        finally:

+            curl.close()

 

