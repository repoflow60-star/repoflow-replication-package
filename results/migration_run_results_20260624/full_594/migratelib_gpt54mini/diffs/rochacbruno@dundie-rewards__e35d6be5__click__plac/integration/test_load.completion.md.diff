+I replaced the `click` test runner with `plac`’s command-line invocation approach. Specifically, I removed `CliRunner` from `click.testing` and used `plac.call` to execute the command functions directly with arguments, while keeping the test names, variables, and assertions unchanged as much as possible.

+

+```python

+import pytest

+import plac

+

+from dundie.cli import load, main

+

+from .constants import PEOPLE_FILE

+

+cmd = plac

+

+

+@pytest.mark.integration

+@pytest.mark.medium

+def test_load_positive_call_load_command():

+    """test command load"""

+    out = cmd.call(load, PEOPLE_FILE)

+    assert "Dunder Mifflin Associates" in out.output

+

+

+@pytest.mark.integration

+@pytest.mark.medium

+@pytest.mark.parametrize("wrong_command", ["loady", "carrega", "start"])

+def test_load_negative_call_load_command_with_wrong_params(wrong_command):

+    """test command load"""

+    out = cmd.call(main, wrong_command, PEOPLE_FILE)

+    assert out.exit_code != 0

+    assert f"No such command '{wrong_command}'." in out.output

+```
