+I migrated the CLI from `click`/`rich_click` to `plac` by replacing the Click decorators and context handling with `plac`’s function-based command parsing. I also replaced Click’s typed arguments/options with `plac`-compatible function signatures and used `plac.call` to dispatch the commands while preserving the existing function names and behavior as closely as possible.

+

+```python

+import json

+

+import pkg_resources

+import plac

+from rich.console import Console

+from rich.table import Table

+

+from dundie import core

+

+

+def main():

+    """Dunder Mifflin Rewards System.

+

+    This cli application controls Dunder Mifflin rewards.

+

+    - admins can load information tot he people database and assign points.

+    - users can view reports and transfer points.

+

+    """

+

+

+def load(filepath):

+    """Loads the file to the database.

+

+    ## Features

+

+    - Validates data

+    - Parses the file

+    - Loads to database

+    """

+    table = Table(title="Dunder Mifflin Associates")

+    headers = ["email", "name", "dept", "role", "currency", "created"]

+    for header in headers:

+        table.add_column(header, style="magenta")

+

+    result = core.load(filepath)

+    for person in result:

+        table.add_row(*[str(value) for value in person.values()])

+

+    console = Console()

+    console.print(table)

+

+

+def show(output=None, dept=None, email=None):

+    """Shows information about user or dept."""

+    query = {}

+    if dept is not None:

+        query["dept"] = dept

+    if email is not None:

+        query["email"] = email

+

+    result = core.read(**query)

+    if output:

+        with open(output, "w") as output_file:

+            output_file.write(json.dumps(result))

+

+    if len(result) == 0:

+        print("Nothing to show")

+

+    table = Table(title="Dunder Mifflin Report")

+    for key in result[0]:

+        table.add_column(key.title().replace("_", " "), style="magenta")

+

+    for person in result:

+        person["value"] = f"{person['value']:.2f}"

+        person["balance"] = f"{person['balance']:.2f}"

+        table.add_row(*[str(value) for value in person.values()])

+

+    console = Console()

+    console.print(table)

+

+

+def add(value, dept=None, email=None):

+    """Add points to the user or dept."""

+    query = {}

+    if dept is not None:

+        query["dept"] = dept

+    if email is not None:

+        query["email"] = email

+

+    core.add(value, **query)

+    show(**query)

+

+

+def remove(value, dept=None, email=None):

+    """Removes points from the user or dept."""

+    query = {}

+    if dept is not None:

+        query["dept"] = dept

+    if email is not None:

+        query["email"] = email

+

+    core.add(-value, **query)

+    show(**query)

+

+

+if __name__ == "__main__":

+    plac.call(main, [

+        ("load", load),

+        ("show", show),

+        ("add", add),

+        ("remove", remove),

+    ])

+```
