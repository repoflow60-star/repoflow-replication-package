+I replaced the `requests`-based HTTP calls with `pycurl` equivalents, keeping the same function names, variables, and overall structure. The main changes are:

+- Removed `requests` and added `pycurl` plus `io` for capturing response bodies.

+- Replaced `requests.post(...)` and `requests.get(...)` with `pycurl.Curl()` requests.

+- Added explicit handling for HTTP status codes via `pycurl.RESPONSE_CODE`.

+- Added request body serialization for JSON payloads and response body decoding/parsing with `json`.

+- Kept SSL verification disabled to match `verify=False`.

+

+```python

+"""

+Module to interact with open.validex.net

+

+You need to create an user at validex.net to be able to

+use its API.

+

+"""

+

+import base64

+import io

+import json

+import pycurl

+import time

+

+URL = "https://api2.validex.net/api/validate"

+

+

+def is_valid_at_validex(invoice, api_key, user_id):

+    """Validates an Invoice at open.validex.net

+

+    You need to create an user at validex.net to be able to

+    use its API.

+

+    Parameters

+    ----------

+    api_key: string.

+        The authentification API key for validex.net

+

+    user_id: string.

+        The user ID of validex.net

+

+    Notes

+    -----

+    Warnings are not reported.

+

+    """

+    payload = {

+        'userId': user_id,

+        'filename': "{}.xml".format(int(time.time())),

+        'fileContents64': base64.b64encode(invoice.to_xml().encode('utf8')).decode('utf8'),

+    }

+    headers = {

+        'content_type': 'json',

+        'accept': 'json',

+        'Authorization': "apikey={}".format(api_key),

+    }

+    response_body = io.BytesIO()

+    curl = pycurl.Curl()

+    curl.setopt(pycurl.URL, URL)

+    curl.setopt(pycurl.POST, 1)

+    curl.setopt(pycurl.POSTFIELDS, json.dumps(payload))

+    curl.setopt(pycurl.WRITEFUNCTION, response_body.write)

+    curl.setopt(pycurl.SSL_VERIFYPEER, 0)

+    curl.setopt(pycurl.SSL_VERIFYHOST, 0)

+    curl.setopt(pycurl.HTTPHEADER, [

+        'content_type: {}'.format(headers['content_type']),

+        'accept: {}'.format(headers['accept']),

+        'Authorization: {}'.format(headers['Authorization']),

+        'Content-Type: application/json',

+    ])

+    curl.perform()

+    status_code = curl.getinfo(pycurl.RESPONSE_CODE)

+    curl.close()

+    response_text = response_body.getvalue().decode('utf8')

+    if status_code == 200:

+        result = json.loads(response_text)

+        if result.get('report') and result['report'].get('result') and\

+                result['report']['result'] != 'fatal':

+            # Warnings are not reported

+            return True

+        elif result.get('report') and result['report'].get('id'):

+            raise ValueError(_get_validation_errors(result['report']['id']))

+        else:

+            raise RuntimeError(": ".join(json.loads(response_text)['error'].values()))

+    elif status_code == 401:

+        raise RuntimeError("Unauthorized: invalid API_KEY")

+    else:

+        raise RuntimeError(": ".join(json.loads(response_text)['error'].values()))

+

+

+def _get_validation_errors(report_id):

+    headers = {

+        'accept': 'json',

+        'Authorization': "apikey={}".format(api_key),

+    }

+    response_body = io.BytesIO()

+    curl = pycurl.Curl()

+    curl.setopt(pycurl.URL, "{}/{}".format(URL.replace('validate', 'report'), report_id))

+    curl.setopt(pycurl.HTTPGET, 1)

+    curl.setopt(pycurl.WRITEFUNCTION, response_body.write)

+    curl.setopt(pycurl.SSL_VERIFYPEER, 0)

+    curl.setopt(pycurl.SSL_VERIFYHOST, 0)

+    curl.setopt(pycurl.HTTPHEADER, [

+        'accept: {}'.format(headers['accept']),

+        'Authorization: {}'.format(headers['Authorization']),

+    ])

+    curl.perform()

+    status_code = curl.getinfo(pycurl.RESPONSE_CODE)

+    curl.close()

+    response_text = response_body.getvalue().decode('utf8')

+    if status_code == 200:

+        resp = json.loads(response_text)

+        errors = []

+        validation_steps = []

+        if resp['report'].get('validationSteps'):

+            validation_steps.extend(resp['report']['validationSteps'])

+        for step in validation_steps:

+            if step.get('success') or not step.get('errors'):

+                continue

+            for error in step['errors']:

+                if error.get('message'):

+                    errors.add("{}: {}".format(step['description'], error['message']))

+                elif error.get('text'):

+                    errors.add("{}: {}".format(step['description'], error['text']))

+                else:

+                    errors.add(str(error))

+        return ". ".join(errors)

+    elif status_code == 401:

+        raise RuntimeError("Unauthorized: invalid API_KEY")

+    else:

+        raise RuntimeError(": ".join(json.loads(response_text)['error'].values()))

+```
