+def build_pycurl_response(body, response_headers, status_code):
+    headers = {}
+    response_header_data = response_headers.getvalue().decode('iso-8859-1')
+
+    for header_block in response_header_data.split('\r\n\r\n'):
+        if not header_block.startswith('HTTP/'):
+            continue
+        headers = {}
+        for header in header_block.split('\r\n')[1:]:
+            if ':' in header:
+                key, value = header.split(':', 1)
+                headers[key] = value.strip()
+
+    return SimpleNamespace(
+        text=body.getvalue().decode('utf-8', errors='replace'),
+        status_code=status_code,
+        headers=headers
+    )
 
 
