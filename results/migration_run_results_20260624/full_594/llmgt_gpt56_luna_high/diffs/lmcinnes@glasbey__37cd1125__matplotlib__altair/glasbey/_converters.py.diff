+def _rgb2hex(color):
+    return "#{:02x}{:02x}{:02x}".format(*[int(round(channel * 255)) for channel in color[:3]])
+
+
+def _to_rgb(color):
+    if type(color) is str:
+        if not color.startswith("#"):
+            raise ValueError(
+                "Altair does not expose named colors as RGB values; use a hexadecimal color instead"
+            )
+
+        value = color[1:]
+        if len(value) in (3, 4):
+            value = "".join(channel * 2 for channel in value)
+
+        if len(value) not in (6, 8):
+            raise ValueError(f"Unrecognized color {color}")
+
+        return tuple(int(value[index:index + 2], 16) / 255 for index in (0, 2, 4))
+    else:
+        return asarray(color, dtype=float32)[:3]
 
 
