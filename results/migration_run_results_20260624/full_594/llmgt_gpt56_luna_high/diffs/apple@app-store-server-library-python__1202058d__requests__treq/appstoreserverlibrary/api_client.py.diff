+    def _parse_treq_response(self, response, destination_class: Type[T]) -> T:
+        if 200 <= response.code < 300:
+            if destination_class is None:
+                return
+            c = _get_cattrs_converter(destination_class)
+            return treq.json_content(response).addCallback(lambda response_body: c.structure(response_body, destination_class))
+        else:
+            # Best effort parsing of the response body
+            content_type = response.headers.getRawHeaders('content-type')
+            if not content_type or content_type[0] != 'application/json':
+                raise APIException(response.code)
+
+            def parse_response(response_body):
+                try:
+                    raise APIException(response.code, response_body['errorCode'], response_body['errorMessage'])
+                except APIException as e:
+                    raise e
+                except Exception as e:
+                    raise APIException(response.code) from e
+
+            def parse_response_error(failure):
+                raise APIException(response.code) from failure.value
+
+            return treq.json_content(response).addCallbacks(parse_response, parse_response_error)
+
 
