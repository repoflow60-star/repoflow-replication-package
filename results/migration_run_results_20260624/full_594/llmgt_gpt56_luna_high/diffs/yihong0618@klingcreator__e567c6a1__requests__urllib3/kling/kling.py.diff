+class Urllib3Response:
+    def __init__(self, response) -> None:
+        self.status_code = response.status
+        self.content = response.data
+        self.text = response.data.decode("utf-8", errors="replace")
+        self.headers = response.headers
+
+    @property
+    def ok(self) -> bool:
+        return self.status_code < 400
+
+    def json(self):
+        return json.loads(self.content)
+
+    def __str__(self):
+        return f"<Response [{self.status_code}]>"
+
+
+class Urllib3Session:
+    def __init__(self) -> None:
+        self.http = urllib3.PoolManager()
+        self.headers = {}
+        self.cookies = {}
+
+    def _request(
+        self,
+        method,
+        url,
+        params=None,
+        data=None,
+        json_data=None,
+        headers=None,
+    ):
+        request_headers = self.headers.copy()
+        if headers:
+            request_headers.update(headers)
+
+        if self.cookies:
+            request_headers["Cookie"] = "; ".join(
+                f"{key}={value}" for key, value in self.cookies.items()
+            )
+
+        if params:
+            url = f"{url}{'&' if '?' in url else '?'}{urlencode(params, doseq=True)}"
+
+        if json_data is not None:
+            request_headers["Content-Type"] = "application/json"
+            body = json.dumps(json_data).encode("utf-8")
+        else:
+            body = data
+
+        response = self.http.request(
+            method,
+            url,
+            body=body,
+            headers=request_headers,
+        )
+
+        for set_cookie in response.headers.getlist("Set-Cookie"):
+            cookie = SimpleCookie()
+            cookie.load(set_cookie)
+            for key, morsel in cookie.items():
+                self.cookies[key] = morsel.value
+
+        return Urllib3Response(response)
+
+    def get(self, url, params=None):
+        return self._request("GET", url, params=params)
+
+    def post(self, url, data=None, params=None, json=None, headers=None):
+        return self._request(
+            "POST",
+            url,
+            params=params,
+            data=data,
+            json_data=json,
+            headers=headers,
+        )
+
+
