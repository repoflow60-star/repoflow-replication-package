+def _plot_truss(truss, starting_shape="k", deflected_shape=None):
+    data = []
+    for m in truss.members:
+        for end, j in enumerate((m.begin_joint, m.end_joint)):
+            coordinates = j.coordinates
+            data.append(
+                {
+                    "line": str(m.idx) + "-starting",
+                    "member": str(m.idx),
+                    "end": end,
+                    "x": coordinates[0],
+                    "y": coordinates[1],
+                    "z": coordinates[2],
+                    "force": m.force,
+                    "shape": "starting",
+                }
+            )
+
+            if deflected_shape is not None:
+                deflected_coordinates = (
+                    numpy.array(coordinates) + numpy.array(j.deflections)
+                )
+                data.append(
+                    {
+                        "line": str(m.idx) + "-deflected",
+                        "member": str(m.idx),
+                        "end": end,
+                        "x": deflected_coordinates[0],
+                        "y": deflected_coordinates[1],
+                        "z": deflected_coordinates[2],
+                        "force": m.force,
+                        "shape": "deflected",
+                    }
+                )
+
+    chart = altair.Chart(pandas.DataFrame(data)).mark_line().encode(
+        x=altair.X("x:Q", title="X"),
+        y=altair.Y("y:Q", title="Y"),
+        detail="line:N",
+        order="end:Q",
+        tooltip=[
+            altair.Tooltip("member:N", title="Member"),
+            altair.Tooltip("x:Q", title="X"),
+            altair.Tooltip("y:Q", title="Y"),
+            altair.Tooltip("z:Q", title="Z"),
+            altair.Tooltip("force:Q", title="Force"),
+        ],
+    )
+
+    if deflected_shape is None:
+        if starting_shape == "force":
+            chart = chart.encode(color=altair.Color("force:Q", title="Force"))
+        else:
+            chart = chart.encode(color=altair.value(starting_shape))
+    else:
+        chart = chart.encode(
+            color=altair.Color(
+                "shape:N",
+                scale=altair.Scale(
+                    domain=["starting", "deflected"],
+                    range=[starting_shape, deflected_shape],
+                ),
+                legend=None,
+            )
+        )
+
+    return chart
+
