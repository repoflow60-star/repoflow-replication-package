+class PycurlResponse:
+    def __init__(self, status_code: int, content: bytes) -> None:
+        self.status_code = status_code
+        self.content = content
+
+    @property
+    def ok(self) -> bool:
+        return self.status_code < 400
+
+    @property
+    def text(self) -> str:
+        return self.content.decode("utf-8", errors="replace")
+
+    def json(self):
+        return json.loads(self.content.decode("utf-8"))
+
+    def __str__(self) -> str:
+        return f"<PycurlResponse [{self.status_code}]>"
+
+
+class PycurlSession:
+    def __init__(self) -> None:
+        self.cookies = {}
+        self.headers = {}
+
+    def request(
+        self,
+        method: str,
+        url: str,
+        data=None,
+        params=None,
+        headers=None,
+        json_data=None,
+    ) -> PycurlResponse:
+        if params:
+            query_string = urlencode(params, doseq=True)
+            url += ("&" if "?" in url else "?") + query_string
+
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        if json_data is not None:
+            data = json.dumps(json_data).encode("utf-8")
+            if not any(
+                key.lower() == "content-type" for key in request_headers
+            ):
+                request_headers["Content-Type"] = "application/json"
+
+        if self.cookies and not any(
+            key.lower() == "cookie" for key in request_headers
+        ):
+            request_headers["Cookie"] = "; ".join(
+                f"{key}={value}" for key, value in self.cookies.items()
+            )
+
+        header_list = [
+            f"{key}: {value}" for key, value in request_headers.items()
+        ]
+
+        response_buffer = io.BytesIO()
+
+        def handle_header(header_line):
+            header_line = header_line.decode("iso-8859-1").strip()
+            if header_line.lower().startswith("set-cookie:"):
+                cookie = SimpleCookie()
+                cookie.load(header_line.split(":", 1)[1].strip())
+                for key, morsel in cookie.items():
+                    self.cookies[key] = morsel.value
+
+        curl = pycurl.Curl()
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.HTTPHEADER, header_list)
+        curl.setopt(pycurl.WRITEFUNCTION, response_buffer.write)
+        curl.setopt(pycurl.HEADERFUNCTION, handle_header)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.MAXREDIRS, 30)
+        curl.setopt(pycurl.ACCEPT_ENCODING, "")
+
+        if method == "POST":
+            curl.setopt(pycurl.POST, True)
+            if data is not None:
+                curl.setopt(pycurl.POSTFIELDS, data)
+
+        try:
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        return PycurlResponse(status_code, response_buffer.getvalue())
+
+    def get(self, url: str, params=None, headers=None) -> PycurlResponse:
+        return self.request(
+            "GET",
+            url,
+            params=params,
+            headers=headers,
+        )
+
+    def post(
+        self,
+        url: str,
+        data=None,
+        params=None,
+        headers=None,
+        json=None,
+    ) -> PycurlResponse:
+        return self.request(
+            "POST",
+            url,
+            data=data,
+            params=params,
+            headers=headers,
+            json_data=json,
+        )
+
