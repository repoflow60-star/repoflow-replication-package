+def _jsonschema_to_cerberus_rule(rule):
+    """Convert a JSON Schema rule to a Cerberus rule."""
+    if not isinstance(rule, dict):
+        return rule
+
+    result = {}
+    rule_type = rule.get("type")
+
+    if isinstance(rule_type, list):
+        if "null" in rule_type:
+            result["nullable"] = True
+        rule_type = [item for item in rule_type if item != "null"]
+        if len(rule_type) == 1:
+            rule_type = rule_type[0]
+        elif rule_type:
+            result["anyof"] = [{"type": item} for item in rule_type]
+            rule_type = None
+        else:
+            rule_type = None
+
+    if rule_type == "object" or "properties" in rule:
+        result["type"] = "dict"
+        result["schema"] = _jsonschema_to_cerberus_schema(rule)
+        additional_properties = rule.get("additionalProperties", True)
+        if isinstance(additional_properties, dict):
+            result["allow_unknown"] = _jsonschema_to_cerberus_rule(additional_properties)
+        else:
+            result["allow_unknown"] = additional_properties
+    elif rule_type == "array":
+        result["type"] = "list"
+        if isinstance(rule.get("items"), dict):
+            result["schema"] = _jsonschema_to_cerberus_rule(rule["items"])
+    elif rule_type:
+        result["type"] = {"string": "string",
+                          "integer": "integer",
+                          "number": "number",
+                          "boolean": "boolean",
+                          "null": "null"}.get(rule_type, rule_type)
+
+    if "enum" in rule:
+        result["allowed"] = rule["enum"]
+    elif "const" in rule:
+        result["allowed"] = [rule["const"]]
+
+    if "minLength" in rule:
+        result["minlength"] = rule["minLength"]
+    if "maxLength" in rule:
+        result["maxlength"] = rule["maxLength"]
+    if "minItems" in rule:
+        result["minlength"] = rule["minItems"]
+    if "maxItems" in rule:
+        result["maxlength"] = rule["maxItems"]
+    if "minimum" in rule:
+        result["min"] = rule["minimum"]
+    if "maximum" in rule:
+        result["max"] = rule["maximum"]
+    if "pattern" in rule:
+        result["regex"] = rule["pattern"]
+    if "uniqueItems" in rule:
+        result["unique"] = rule["uniqueItems"]
+
+    if "anyOf" in rule:
+        result["anyof"] = [_jsonschema_to_cerberus_rule(item) for item in rule["anyOf"]]
+    if "oneOf" in rule:
+        result["oneof"] = [_jsonschema_to_cerberus_rule(item) for item in rule["oneOf"]]
+
+    return result
+
