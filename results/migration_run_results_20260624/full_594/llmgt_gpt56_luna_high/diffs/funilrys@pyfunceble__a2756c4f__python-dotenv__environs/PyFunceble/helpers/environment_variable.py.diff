+def _get_value_from_env_file(
+    env_file_path: Optional[str], name: str
+) -> Optional[str]:
+    if env_file_path is None or not os.path.isfile(env_file_path):
+        return None
+
+    current_environment = os.environ.copy()
+
+    try:
+        if name in os.environ:
+            del os.environ[name]
+
+        env = Env()
+        env.read_env(env_file_path, override=True)
+
+        return env.str(name, default=None)
+    finally:
+        os.environ.clear()
+        os.environ.update(current_environment)
+
+
+def _set_value_in_env_file(
+    env_file_path: str, name: str, value: str
+) -> None:
+    escaped_value = value.replace("'", "\\'")
+    assignment = re.compile(
+        rf"^(\s*(?:export\s+)?){re.escape(name)}\s*="
+    )
+
+    try:
+        with open(env_file_path, "r", encoding="utf-8") as env_file:
+            lines = env_file.readlines()
+    except FileNotFoundError:
+        lines = []
+
+    for index, line in enumerate(lines):
+        match = assignment.match(line)
+
+        if match:
+            if line.endswith("\r\n"):
+                line_ending = "\r\n"
+            elif line.endswith("\n"):
+                line_ending = "\n"
+            else:
+                line_ending = ""
+
+            lines[index] = (
+                f"{match.group(1)}{name}='{escaped_value}'{line_ending}"
+            )
+            break
+    else:
+        if lines and not lines[-1].endswith(("\n", "\r")):
+            lines.append("\n")
+
+        lines.append(f"{name}='{escaped_value}'\n")
+
+    with open(env_file_path, "w", encoding="utf-8") as env_file:
+        env_file.writelines(lines)
+
+
+def _delete_value_from_env_file(env_file_path: str, name: str) -> None:
+    assignment = re.compile(
+        rf"^\s*(?:export\s+)?{re.escape(name)}\s*="
+    )
+
+    try:
+        with open(env_file_path, "r", encoding="utf-8") as env_file:
+            lines = env_file.readlines()
+    except FileNotFoundError:
+        return
+
+    lines = [line for line in lines if not assignment.match(line)]
+
+    with open(env_file_path, "w", encoding="utf-8") as env_file:
+        env_file.writelines(lines)
 
 
