+    def _request(self, url, method, params=None, body=None, headers=None):
+        if params:
+            query = urlencode(params, doseq=True)
+            if query:
+                url += ('&' if '?' in url else '?') + query
+
+        response_content = BytesIO()
+        response_headers = {}
+        response_reason = ''
+
+        def header_function(line):
+            nonlocal response_reason
+            line = line.decode('iso-8859-1').strip()
+            if line.startswith('HTTP/'):
+                response_headers.clear()
+                parts = line.split(' ', 2)
+                if len(parts) == 3:
+                    response_reason = parts[2]
+            elif ':' in line:
+                key, value = line.split(':', 1)
+                response_headers[key.lower()] = value.strip()
+            return len(line)
+
+        self.session.reset()
+        self.session.setopt(pycurl.URL, url)
+        self.session.setopt(
+            pycurl.HTTPHEADER,
+            self.session_headers + (headers or []),
+        )
+        self.session.setopt(pycurl.WRITEFUNCTION, response_content.write)
+        self.session.setopt(pycurl.HEADERFUNCTION, header_function)
+        self.session.setopt(pycurl.FOLLOWLOCATION, True)
+
+        if method == 'GET':
+            self.session.setopt(pycurl.HTTPGET, True)
+        elif method == 'POST':
+            self.session.setopt(pycurl.POST, True)
+            if body is not None:
+                self.session.setopt(pycurl.POSTFIELDS, body)
+        elif method == 'PATCH':
+            self.session.setopt(pycurl.CUSTOMREQUEST, 'PATCH')
+            self.session.setopt(pycurl.POST, True)
+            if body is not None:
+                self.session.setopt(pycurl.POSTFIELDS, body)
+        elif method == 'DELETE':
+            self.session.setopt(pycurl.CUSTOMREQUEST, 'DELETE')
+
+        self.session.perform()
+
+        return Response(
+            status_code=self.session.getinfo(pycurl.RESPONSE_CODE),
+            headers=response_headers,
+            content=response_content.getvalue(),
+            url=self.session.getinfo(pycurl.EFFECTIVE_URL),
+            reason=response_reason,
+        )
+
