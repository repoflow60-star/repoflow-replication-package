+class PycurlSession(object):
+    def __init__(self):
+        self.curl = pycurl.Curl()
+        self.curl.setopt(pycurl.COOKIEFILE, '')
+
+    def _request(self, url, method, data=None, params=None,
+                 headers=None, verify=True):
+        if params:
+            query = urllib_parse.urlencode(params)
+            if '?' in url:
+                url = ''.join([url, '&', query])
+            else:
+                url = ''.join([url, '?', query])
+
+        response = BytesIO()
+
+        self.curl.setopt(pycurl.URL, url)
+        self.curl.setopt(pycurl.WRITEFUNCTION, response.write)
+        self.curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        self.curl.setopt(pycurl.SSL_VERIFYPEER, 1 if verify else 0)
+        self.curl.setopt(pycurl.SSL_VERIFYHOST, 2 if verify else 0)
+
+        header_list = []
+        if headers:
+            header_list = [
+                '%s: %s' % (key, value)
+                for key, value in headers.items()
+            ]
+        self.curl.setopt(pycurl.HTTPHEADER, header_list)
+
+        if method == 'POST':
+            self.curl.setopt(pycurl.POST, 1)
+            self.curl.setopt(pycurl.POSTFIELDS, data)
+        else:
+            self.curl.setopt(pycurl.HTTPGET, 1)
+
+        self.curl.perform()
+        status_code = self.curl.getinfo(pycurl.RESPONSE_CODE)
+
+        return PycurlResponse(response.getvalue(), status_code)
+
+    def get(self, url, params=None, stream=False, verify=True):
+        return self._request(
