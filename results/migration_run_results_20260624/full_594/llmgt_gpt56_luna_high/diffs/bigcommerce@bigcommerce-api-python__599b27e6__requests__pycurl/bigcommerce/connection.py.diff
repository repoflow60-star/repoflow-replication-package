+class _PycurlHeaders(dict):
+    def __contains__(self, key):
+        return any(header.lower() == key.lower() for header in self.keys())
+
+    def __getitem__(self, key):
+        for header in self.keys():
+            if header.lower() == key.lower():
+                return dict.__getitem__(self, header)
+        raise KeyError(key)
+
+    def get(self, key, default=None):
+        try:
+            return self[key]
+        except KeyError:
+            return default
+
+
+class _PycurlResponse(object):
+    def __init__(self, status_code, reason, headers, content):
+        self.status_code = status_code
+        self.reason = reason
+        self.headers = headers
+        self.content = content
+
+    def json(self):
+        return loads(self.content.decode('utf-8'))
+
+
+class _PycurlSession(object):
+    def __init__(self):
+        self.auth = None
+        self.headers = {}
+
+    @staticmethod
+    def _parse_headers(header_buffer):
+        headers = _PycurlHeaders()
+        reason = ''
+
+        for line in header_buffer.getvalue().splitlines():
+            line = line.decode('iso-8859-1')
+            if line.startswith('HTTP/'):
+                headers = _PycurlHeaders()
+                parts = line.split(' ', 2)
+                if len(parts) > 2:
+                    reason = parts[2]
+                else:
+                    reason = ''
+            elif ':' in line:
+                key, value = line.split(':', 1)
+                headers[key] = value.lstrip()
+
+        return headers, reason
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        request_headers = self.headers.copy()
+        if headers:
+            request_headers.update(headers)
+
+        body = BytesIO()
+        response_headers = BytesIO()
+        curl = pycurl.Curl()
+
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, response_headers.write)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.ENCODING, '')
+
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT, int(timeout))
+
+        if request_headers:
+            curl.setopt(pycurl.HTTPHEADER,
+                        ["%s: %s" % (key, value) for key, value in request_headers.items()])
+
+        if self.auth:
+            curl.setopt(pycurl.USERPWD, "%s:%s" % (self.auth[0], self.auth[1]))
+
+        if method == 'GET':
+            curl.setopt(pycurl.HTTPGET, 1)
+        elif method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+        else:
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+        if data is not None:
+            if isinstance(data, dict):
+                data = urlencode(data)
+            curl.setopt(pycurl.POSTFIELDS, data)
+
+        try:
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        headers, reason = self._parse_headers(response_headers)
+        return _PycurlResponse(status_code, reason, headers, body.getvalue())
 
 
