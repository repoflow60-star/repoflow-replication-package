+def _pycurl_request(url, method, data=None, headers=None):
+    response = io.BytesIO()
+    response_headers = {}
+
+    def header_function(header):
+        header = header.decode('iso-8859-1').strip()
+        if ':' in header:
+            key, value = header.split(':', 1)
+            key = key.strip()
+            if key.lower() == 'etag':
+                key = 'ETag'
+            response_headers[key] = value.strip()
+
+    curl = pycurl.Curl()
+    curl.setopt(pycurl.URL, url)
+    curl.setopt(pycurl.WRITEFUNCTION, response.write)
+    curl.setopt(pycurl.HEADERFUNCTION, header_function)
+    curl.setopt(pycurl.FOLLOWLOCATION, 1)
+
+    if headers:
+        curl.setopt(
+            pycurl.HTTPHEADER,
+            ['{}: {}'.format(key, value) for key, value in headers.items()]
+        )
+
+    if method == 'POST':
+        curl.setopt(pycurl.POST, 1)
+    else:
+        curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+    if data is not None:
+        curl.setopt(pycurl.POSTFIELDS, data)
+
+    try:
+        curl.perform()
+    finally:
+        curl.close()
+
+    return response.getvalue(), response_headers
+
+
+def pycurl_post(url, payload):
+    response, _ = _pycurl_request(
+        url,
+        'POST',
+        data=json.dumps(payload).encode('utf-8'),
+        headers={'Content-Type': 'application/json'}
+    )
+    return json.loads(response.decode('utf-8'))
+
+
+def pycurl_put(url, headers, data):
+    _, response_headers = _pycurl_request(url, 'PUT', data, headers)
+    return response_headers
 
 
