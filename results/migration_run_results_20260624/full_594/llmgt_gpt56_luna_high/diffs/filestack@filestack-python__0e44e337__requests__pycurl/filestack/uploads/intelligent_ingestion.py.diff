+def _curl_request(url, method, data=None, headers=None):
+    response = io.BytesIO()
+    curl = pycurl.Curl()
+
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEFUNCTION, response.write)
+
+        if headers:
+            if isinstance(headers, dict):
+                headers = ['{}: {}'.format(key, value) for key, value in headers.items()]
+            curl.setopt(pycurl.HTTPHEADER, headers)
+
+        if method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, data)
+            curl.setopt(pycurl.POSTFIELDSIZE, len(data))
+        elif method == 'PUT':
+            upload_data = io.BytesIO(data)
+            curl.setopt(pycurl.UPLOAD, 1)
+            curl.setopt(pycurl.READFUNCTION, upload_data.read)
+            curl.setopt(pycurl.INFILESIZE, len(data))
+
+        curl.perform()
+        status = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+
+    return status, response.getvalue()
 
 
