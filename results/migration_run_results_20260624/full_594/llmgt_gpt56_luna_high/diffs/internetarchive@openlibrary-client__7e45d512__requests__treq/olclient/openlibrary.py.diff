+        raise_for_status = kwargs.pop('raise_for_status', False)
+        wait_gen = self.BACKOFF_KWARGS['wait_gen']()
+
+        for attempt in range(self.BACKOFF_KWARGS['max_tries']):
+            try:
+                response = yield getattr(self.session, method)(*args, **kwargs)
+                if raise_for_status and response.code >= 400:
+                    raise TreqResponseError(response)
+                returnValue(response)
+            except Exception as e:
+                if (
+                    self.BACKOFF_KWARGS['giveup'](e)
+                    or attempt + 1 >= self.BACKOFF_KWARGS['max_tries']
+                ):
+                    err(e)
+                    raise
+                from twisted.internet.task import deferLater
+                yield deferLater(reactor, next(wait_gen), lambda: None)
