+class _PycurlResponse:
+
+    def __init__(self, status_code, headers, content):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+        self.text = content.decode()
+
+    def json(self):
+        return json_library.loads(self.text)
+
+
+class PycurlHttpClient:
+
+    def _request(self, url, method, data=None):
+        response = BytesIO()
+        response_headers = BytesIO()
+
+        curl = pycurl.Curl()
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.HTTPHEADER, [
+            'Accept: application/json',
+            'Content-Type: application/json'
+        ])
+        curl.setopt(pycurl.WRITEFUNCTION, response.write)
+        curl.setopt(pycurl.HEADERFUNCTION, response_headers.write)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+
+        if method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, data)
+
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        curl.close()
+
+        headers = {}
+        for header in response_headers.getvalue().decode().splitlines():
+            if ':' not in header:
+                continue
+
+            key, value = header.split(':', 1)
+            headers[key.strip()] = value.strip()
+
+        return _PycurlResponse(status_code, headers, response.getvalue())
+
+    def get(self, url):
+        return self._request(url, 'GET')
+
+    def raw_post(self, url, json=None):
+        data = json_library.dumps(json).encode() if json is not None else b''
+
+        return self._request(url, 'POST', data)
 
 
