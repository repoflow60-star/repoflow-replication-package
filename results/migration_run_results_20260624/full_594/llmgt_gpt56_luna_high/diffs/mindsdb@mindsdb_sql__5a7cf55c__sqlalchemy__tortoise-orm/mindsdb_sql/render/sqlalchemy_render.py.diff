+def quote_identifier(value, quote):
+    if value == '*':
+        return value
+
+    if quote == '[':
+        return '[' + str(value).replace(']', ']]') + ']'
+
+    return quote + str(value).replace(quote, quote + quote) + quote
+
+
+def literal_sql(value):
+    if value is None:
+        return 'NULL'
+
+    if isinstance(value, bool):
+        return 'TRUE' if value else 'FALSE'
+
+    if isinstance(value, (str, dt.date, dt.datetime, dt.timedelta)):
+        return "'{}'".format(str(value).replace("'", "''"))
+
+    return str(value)
+
+
+class TortoiseSQL(RawSQL):
+    def __init__(self, sql, quote='"'):
+        super().__init__(sql)
+        self.sql = sql
+        self.quote = quote
+
+    def __str__(self):
+        return self.sql
+
+    def _new(self, sql):
+        return TortoiseSQL(sql, quote=self.quote)
+
+    def label(self, alias):
+        return self._new(
+            f'{self.sql} AS {quote_identifier(alias, self.quote)}'
+        )
+
+    def distinct(self):
+        return self._new(f'DISTINCT {self.sql}')
+
+    def desc(self):
+        return self._new(f'{self.sql} DESC')
+
+    def asc(self):
+        return self._new(f'{self.sql} ASC')
+
+    def is_(self, other):
+        return self._new(f'{self.sql} IS {_expression_sql(other)}')
+
+    def is_not(self, other):
+        return self._new(f'{self.sql} IS NOT {_expression_sql(other)}')
+
+    def like(self, other):
+        return self._new(f'({self.sql} LIKE {_expression_sql(other)})')
+
+    def notlike(self, other):
+        return self._new(f'({self.sql} NOT LIKE {_expression_sql(other)})')
+
+    def in_(self, other):
+        if not isinstance(other, list):
+            other = [other]
+
+        values = ', '.join(
+            _expression_sql(i)
+            for i in other
+        )
+        return self._new(f'({self.sql} IN ({values}))')
+
+    def notin_(self, other):
+        if not isinstance(other, list):
+            other = [other]
+
+        values = ', '.join(
+            _expression_sql(i)
+            for i in other
+        )
+        return self._new(f'({self.sql} NOT IN ({values}))')
+
+    def op(self, operator):
+        return lambda other: self._new(
+            f'({self.sql} {operator} {_expression_sql(other)})'
+        )
+
+    def __add__(self, other):
+        return self._new(f'({self.sql} + {_expression_sql(other)})')
+
+    def __sub__(self, other):
+        return self._new(f'({self.sql} - {_expression_sql(other)})')
+
+    def __truediv__(self, other):
+        return self._new(f'({self.sql} / {_expression_sql(other)})')
+
+    def __mul__(self, other):
+        return self._new(f'({self.sql} * {_expression_sql(other)})')
+
+    def __mod__(self, other):
+        return self._new(f'({self.sql} % {_expression_sql(other)})')
+
+    def __eq__(self, other):
+        return self._new(f'({self.sql} = {_expression_sql(other)})')
+
+    def __ne__(self, other):
+        return self._new(f'({self.sql} <> {_expression_sql(other)})')
+
+    def __gt__(self, other):
+        return self._new(f'({self.sql} > {_expression_sql(other)})')
+
+    def __lt__(self, other):
+        return self._new(f'({self.sql} < {_expression_sql(other)})')
+
+    def __ge__(self, other):
+        return self._new(f'({self.sql} >= {_expression_sql(other)})')
+
+    def __le__(self, other):
+        return self._new(f'({self.sql} <= {_expression_sql(other)})')
+
+    def __neg__(self):
+        return self._new(f'(-{self.sql})')
+
+    def __invert__(self):
+        return self._new(f'(NOT {self.sql})')
+
+
+class TortoiseStatement:
+    def __init__(self, sql):
+        self.sql = sql
+
+    def __str__(self):
+        return self.sql
+
+
+def _expression_sql(value):
+    if isinstance(value, TortoiseSQL):
+        return value.sql
+
+    if isinstance(value, list):
+        return ', '.join(
+            _expression_sql(i)
+            for i in value
+        )
+
+    return literal_sql(value)
+
