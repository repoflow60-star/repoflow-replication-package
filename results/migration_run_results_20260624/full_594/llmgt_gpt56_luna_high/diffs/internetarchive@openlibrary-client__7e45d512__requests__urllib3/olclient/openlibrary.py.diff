+class _Session:
+
+    def __init__(self):
+        self._pool = urllib3.PoolManager(retries=False)
+        self.cookies = SimpleCookie()
+
+    def _request(self, method, url, data=None, headers=None, files=None):
+        headers = dict(headers or {})
+        if self.cookies and 'Cookie' not in headers:
+            headers['Cookie'] = '; '.join(
+                '{}={}'.format(key, morsel.value)
+                for key, morsel in self.cookies.items()
+            )
+
+        if files is not None:
+            response = self._pool.request(
+                method,
+                url,
+                fields=files,
+                headers=headers,
+                encode_multipart=True,
+            )
+        else:
+            if isinstance(data, dict):
+                data = urlencode(data)
+                headers.setdefault(
+                    'Content-Type',
+                    'application/x-www-form-urlencoded',
+                )
+            response = self._pool.request(
+                method,
+                url,
+                body=data,
+                headers=headers,
+            )
+
+        for set_cookie in response.headers.getlist('Set-Cookie'):
+            self.cookies.load(set_cookie)
+
+        return response
+
+    def get(self, url):
+        return self._request('GET', url)
+
+    def post(self, url, data=None, headers=None, files=None):
+        return self._request(
+            'POST',
+            url,
+            data=data,
+            headers=headers,
+            files=files,
+        )
+
+    def put(self, url, data=None, headers=None):
+        return self._request(
+            'PUT',
+            url,
+            data=data,
+            headers=headers,
+        )
 
 
