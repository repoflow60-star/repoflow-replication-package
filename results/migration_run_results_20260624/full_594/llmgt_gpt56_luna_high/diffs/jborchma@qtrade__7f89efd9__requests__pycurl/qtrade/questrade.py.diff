 log = logging.getLogger(__name__)  # pylint: disable=C0103
 
 TOKEN_URL = "https://login.questrade.com/oauth2/token?grant_type=refresh_token&refresh_token="
+
+
+class _PycurlResponse:
+    def __init__(self, content: bytes, status_code: int):
+        self.content = content
+        self.status_code = status_code
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise Exception("HTTP status code: {}".format(self.status_code))
+
+    def json(self):
+        return json_lib.loads(self.content.decode("utf-8"))
+
+
+class _PycurlSession:
+    def __init__(self):
+        self.curl = pycurl.Curl()
+        self.headers = {}
+
+    def request(
+        self,
+        method: str,
+        url: str,
+        params: Optional[Dict] = None,
+        data: Optional[Dict] = None,
+        json: Optional[Dict] = None,
+        timeout: Optional[int] = None,
+    ):
+        if params:
+            url += ("&" if "?" in url else "?") + pycurl.urlencode(params)
+
+        body = None
+        headers = [key + ": " + str(value) for key, value in self.headers.items()]
+
+        if json is not None:
+            body = json_lib.dumps(json).encode("utf-8")
+            headers.append("Content-Type: application/json")
+        elif data is not None:
+            if isinstance(data, dict):
+                body = pycurl.urlencode(data).encode("utf-8")
+            elif isinstance(data, str):
+                body = data.encode("utf-8")
+            else:
+                body = data
+
+        output = io.BytesIO()
+
+        self.curl.setopt(pycurl.URL, url)
+        self.curl.setopt(pycurl.HTTPHEADER, headers)
+        self.curl.setopt(pycurl.WRITEFUNCTION, output.write)
+        self.curl.setopt(pycurl.TIMEOUT, timeout if timeout is not None else 0)
+        self.curl.setopt(pycurl.CUSTOMREQUEST, method.upper())
+        self.curl.setopt(pycurl.POSTFIELDS, None)
+
+        if method.lower() == "get":
+            self.curl.setopt(pycurl.POST, False)
+            self.curl.setopt(pycurl.HTTPGET, True)
+        elif method.lower() == "post":
+            self.curl.setopt(pycurl.HTTPGET, False)
+            self.curl.setopt(pycurl.POST, True)
+            self.curl.setopt(pycurl.POSTFIELDS, body if body is not None else b"")
+        else:
+            self.curl.setopt(pycurl.HTTPGET, False)
+            self.curl.setopt(pycurl.POST, False)
+            if body is not None:
+                self.curl.setopt(pycurl.POSTFIELDS, body)
+
+        self.curl.perform()
+
+        status_code = self.curl.getinfo(pycurl.RESPONSE_CODE)
+        return _PycurlResponse(output.getvalue(), status_code)
+
+    def get(self, url: str):
+        return self.request("get", url)
+
+    def post(self, url: str, **kwargs):
+        return self.request("post", url, **kwargs)
+
+    def close(self):
+        self.curl.close()
+
+
+def _pycurl_get(url: str):
+    session = _PycurlSession()
+    try:
+        return session.get(url)
+    finally:
+        session.close()
 
 
