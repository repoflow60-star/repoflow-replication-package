+class _Response:
+    def __init__(self):
+        self.status_code = 0
+        self.headers: ty.Dict[str, str] = {}
+        self.content = b''
+
+    def _header(self, value: bytes) -> int:
+        line = value.decode('iso-8859-1').rstrip('\r\n')
+
+        if line.startswith('HTTP/'):
+            self.status_code = int(line.split()[1])
+            self.headers = {}
+        elif ':' in line:
+            key, value = line.split(':', 1)
+            self.headers[key.lower()] = value.strip()
+
+        return len(value)
+
+    def json(self):
+        return json.loads(self.content.decode('utf-8'))
+
+    def iter_content(self, chunk_size: int):
+        for offset in range(0, len(self.content), chunk_size):
+            yield self.content[offset:offset + chunk_size]
+
+    def raise_for_status(self) -> None:
+        if 400 <= self.status_code < 600:
+            raise HTTPError(
+                'HTTP error {}'.format(self.status_code),
+                self,
+            )
+
