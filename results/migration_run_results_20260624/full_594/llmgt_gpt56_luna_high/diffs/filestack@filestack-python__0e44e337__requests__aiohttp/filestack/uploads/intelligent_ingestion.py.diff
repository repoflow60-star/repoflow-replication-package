+async def _aiohttp_request(method, url, retries=0, backoff_factor=0, status_forcelist=None, allowed_methods=None, **kwargs):
+    status_forcelist = status_forcelist or []
+    allowed_methods = allowed_methods or []
+
+    async with aiohttp.ClientSession() as session:
+        for attempt in range(retries + 1):
+            async with session.request(method, url, **kwargs) as response:
+                status = response.status
+                content = await response.read()
+
+            if (
+                status not in status_forcelist
+                or method.upper() not in allowed_methods
+                or attempt == retries
+            ):
+                return status, content
+
+            await asyncio.sleep(backoff_factor * (2 ** max(0, attempt - 1)))
+
+
+def _request(method, url, **kwargs):
+    return asyncio.run(_aiohttp_request(method, url, **kwargs))
 
 
