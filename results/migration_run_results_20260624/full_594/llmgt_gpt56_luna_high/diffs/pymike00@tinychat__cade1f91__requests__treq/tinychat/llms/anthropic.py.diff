+
+class _SSEEvent:
+    def __init__(self, data: str) -> None:
+        self.data = data
+
+
+class _SSEProtocol(Protocol):
+    def __init__(self, event_queue: DeferredQueue) -> None:
+        self._event_queue = event_queue
+        self._buffer = ""
+
+    def dataReceived(self, data: bytes) -> None:
+        self._buffer += data.decode("utf-8")
+        self._buffer = self._buffer.replace("\r\n", "\n").replace("\r", "\n")
+
+        while "\n\n" in self._buffer:
+            event, self._buffer = self._buffer.split("\n\n", 1)
+            self._emit_event(event)
+
+    def _emit_event(self, event: str) -> None:
+        event_data = []
+        for line in event.split("\n"):
+            if line.startswith("data:"):
+                value = line[5:]
+                if value.startswith(" "):
+                    value = value[1:]
+                event_data.append(value)
+
+        if event_data:
+            self._event_queue.put(_SSEEvent("\n".join(event_data)))
+
+    def connectionLost(self, reason) -> None:
+        if self._buffer:
+            self._emit_event(self._buffer)
+        self._event_queue.put(None)
 
 
