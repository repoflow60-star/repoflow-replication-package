+    def _request(self, method, url, body=None, headers=None):
+        response_buffer = io.BytesIO()
+        curl = pycurl.Curl()
+
+        request_headers = []
+        if headers is not None:
+            request_headers = [key + ': ' + value for key, value in headers.items()]
+
+        if body is not None:
+            request_headers.append('Content-Type: application/json')
+
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.CUSTOMREQUEST, method)
+        curl.setopt(pycurl.HTTPHEADER, request_headers)
+        curl.setopt(pycurl.WRITEFUNCTION, response_buffer.write)
+        curl.setopt(pycurl.TIMEOUT, self.timeout)
+
+        if body is not None:
+            curl.setopt(pycurl.POSTFIELDS, body)
+
+        curl.perform()
+
+        response = _PycurlResponse(
+            response_buffer.getvalue(),
+            curl.getinfo(pycurl.RESPONSE_CODE)
+        )
+
+        curl.close()
+
+        return response
