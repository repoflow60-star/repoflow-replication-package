+class _PycurlResponse:
+    def __init__(self, content, url, status_code, history):
+        self.content = content
+        self.url = url
+        self.status_code = status_code
+        self.history = history
+
+    @property
+    def text(self):
+        return self.content.decode("utf-8", errors="replace")
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise RuntimeError(
+                f"{self.status_code} HTTP Error for url: {self.url}"
+            )
+
+
+class _PycurlCookieJar:
+    def __init__(self, session):
+        self._session = session
+
+    def clear(self):
+        self._session._curl.setopt(pycurl.COOKIELIST, "ALL")
+
+
+class PycurlSession:
+    def __init__(self):
+        self._curl = pycurl.Curl()
+        self._curl.setopt(pycurl.COOKIEFILE, "")
+        self._curl.setopt(pycurl.FOLLOWLOCATION, True)
+        self.cookies = _PycurlCookieJar(self)
+
+    def _request(self, url, data=None):
+        import io
+
+        body = io.BytesIO()
+        current_url = [url]
+        current_status = [None]
+        history_urls = []
+
+        def header_callback(header):
+            line = header.decode("iso-8859-1")
+            if line.startswith("HTTP/"):
+                parts = line.split()
+                if len(parts) > 1:
+                    try:
+                        current_status[0] = int(parts[1])
+                    except ValueError:
+                        current_status[0] = None
+            elif (
+                line.lower().startswith("location:")
+                and current_status[0] is not None
+                and 300 <= current_status[0] < 400
+            ):
+                location = line.split(":", 1)[1].strip()
+                history_urls.append(current_url[0])
+                current_url[0] = urljoin(current_url[0], location)
+            return len(header)
+
+        self._curl.setopt(pycurl.URL, url)
+        self._curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        self._curl.setopt(pycurl.HEADERFUNCTION, header_callback)
+
+        if data is None:
+            self._curl.setopt(pycurl.HTTPGET, True)
+        else:
+            self._curl.setopt(pycurl.POST, True)
+            self._curl.setopt(pycurl.POSTFIELDS, urlencode(data))
+
+        self._curl.perform()
+
+        response_url = self._curl.getinfo(pycurl.EFFECTIVE_URL)
+        status_code = self._curl.getinfo(pycurl.RESPONSE_CODE)
+        history = [
+            _PycurlResponse(b"", history_url, 0, [])
+            for history_url in history_urls
+        ]
+
+        return _PycurlResponse(
+            body.getvalue(),
+            response_url,
+            status_code,
+            history,
+        )
+
+    def get(self, url):
+        return self._request(url)
+
+    def post(self, url, data=None):
+        return self._request(url, data=data)
 
 
