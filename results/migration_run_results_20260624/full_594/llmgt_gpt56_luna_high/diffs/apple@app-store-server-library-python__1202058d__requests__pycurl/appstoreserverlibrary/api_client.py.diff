+    def _execute_request(self, method: str, url: str, params: Dict[str, Union[str, List[str]]], headers: Dict[str, str], json: Dict[str, Any]) -> _PycurlResponse:
+        if params:
+            url = url + ("&" if "?" in url else "?") + urlencode(params, doseq=True)
+
+        response_body = BytesIO()
+        response_headers = {}
+
+        def header_function(header):
+            header = header.decode("iso-8859-1").strip()
+            if ":" in header:
+                key, value = header.split(":", 1)
+                response_headers[key.lower()] = value.strip()
+
+        curl = pycurl.Curl()
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.CUSTOMREQUEST, method)
+        curl.setopt(pycurl.HTTPHEADER, [key + ": " + value for key, value in headers.items()])
+        curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, header_function)
+
+        if json is not None:
+            curl.setopt(pycurl.HTTPHEADER, [key + ": " + value for key, value in headers.items()] + ["Content-Type: application/json"])
+            curl.setopt(pycurl.POSTFIELDS, json_library.dumps(json).encode("utf-8"))
+
+        try:
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        return _PycurlResponse(status_code, response_headers, response_body.getvalue())
 
