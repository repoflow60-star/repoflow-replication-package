 __domain__ = "arvato-aws.io"
 
 _logger = logging.getLogger(__name__)
+
+
+_treq_reactor_ready = threading.Event()
+_treq_reactor_lock = threading.Lock()
+
+
+def _run_treq_reactor():
+    reactor.callWhenRunning(_treq_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _get_treq_response_text(url, params=None):
+    with _treq_reactor_lock:
+        if not reactor.running:
+            reactor_thread = threading.Thread(target=_run_treq_reactor)
+            reactor_thread.daemon = True
+            reactor_thread.start()
+            _treq_reactor_ready.wait()
+
+    response = blockingCallFromThread(reactor, treq.get, url, params=params)
+    return blockingCallFromThread(reactor, response.text)
 
 
