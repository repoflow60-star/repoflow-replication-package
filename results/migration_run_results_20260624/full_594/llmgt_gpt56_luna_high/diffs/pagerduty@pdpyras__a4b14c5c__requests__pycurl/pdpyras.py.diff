+    def _pycurl_request(self, method, url, **kwargs) -> Response:
+        """
+        Execute one HTTP request using pycurl.
+        """
+        body = io.BytesIO()
+        response_headers = []
+        curl = pycurl.Curl()
+
+        headers = kwargs.get('headers', {})
+        header_values = [
+            "%s: %s"%(name, value)
+            for name, value in headers.items()
+        ]
+
+        params = kwargs.get('params')
+        request_url = url
+        if params:
+            query = urlencode(params, doseq=True)
+            separator = '&' if '?' in request_url else '?'
+            request_url += separator + query
+
+        request_body = None
+        if 'json' in kwargs:
+            request_body = json.dumps(kwargs['json']).encode('utf-8')
+        elif 'data' in kwargs:
+            request_body = kwargs['data']
+            if isinstance(request_body, (dict, list, tuple)):
+                request_body = urlencode(request_body, doseq=True)
+            if isinstance(request_body, str):
+                request_body = request_body.encode('utf-8')
+
+        try:
+            curl.setopt(pycurl.URL, request_url)
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            curl.setopt(pycurl.HTTPHEADER, header_values)
+            curl.setopt(pycurl.WRITEFUNCTION, body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, response_headers.append)
+
+            timeout = kwargs.get('timeout')
+            if isinstance(timeout, tuple):
+                curl.setopt(pycurl.CONNECTTIMEOUT, timeout[0])
+                curl.setopt(pycurl.TIMEOUT, timeout[1])
+            elif timeout is not None:
+                curl.setopt(pycurl.TIMEOUT, timeout)
+
+            if method == 'GET':
+                curl.setopt(pycurl.HTTPGET, True)
+            elif method == 'POST':
+                curl.setopt(pycurl.POST, True)
+
+            if request_body is not None:
+                curl.setopt(pycurl.POSTFIELDS, request_body)
+
+            curl.perform()
+
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            elapsed = curl.getinfo(pycurl.TOTAL_TIME)
+        finally:
+            curl.close()
+
+        parsed_headers = _Headers()
+        for raw_line in response_headers:
+            line = raw_line.decode('iso-8859-1').strip()
+            if not line:
+                continue
+            if line.startswith('HTTP/'):
+                parsed_headers = _Headers()
+            elif ':' in line:
+                name, value = line.split(':', 1)
+                parsed_headers[name.strip()] = value.strip()
+
+        return Response(
+            status_code,
+            parsed_headers,
+            body.getvalue(),
+            method,
+            request_url,
+            elapsed,
+        )
