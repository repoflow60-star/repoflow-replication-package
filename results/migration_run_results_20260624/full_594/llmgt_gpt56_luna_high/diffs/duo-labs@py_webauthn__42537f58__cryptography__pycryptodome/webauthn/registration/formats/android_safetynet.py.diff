+def _read_der_tlv(data: bytes, offset: int):
+    start = offset
+    tag = data[offset]
+    offset += 1
+
+    length = data[offset]
+    offset += 1
+
+    if length & 0x80:
+        length_bytes = length & 0x7F
+        length = int.from_bytes(data[offset : offset + length_bytes], "big")
+        offset += length_bytes
+
+    end = offset + length
+
+    return tag, data[offset:end], data[start:end], end
 
 
