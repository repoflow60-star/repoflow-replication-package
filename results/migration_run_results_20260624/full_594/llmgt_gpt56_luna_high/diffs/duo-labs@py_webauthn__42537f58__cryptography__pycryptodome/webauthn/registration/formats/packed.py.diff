+def _public_key_from_certificate(certificate_bytes: bytes):
+    certificate = DerSequence()
+    certificate.decode(certificate_bytes)
+
+    tbs_certificate = DerSequence()
+    tbs_certificate.decode(certificate[0])
+
+    if isinstance(tbs_certificate[0], bytes) and tbs_certificate[0][0] == 0xA0:
+        subject_public_key_info = tbs_certificate[6]
+    else:
+        subject_public_key_info = tbs_certificate[5]
+
+    try:
+        return RSA.import_key(subject_public_key_info)
+    except (TypeError, ValueError):
+        return ECC.import_key(subject_public_key_info)
+
+
+def _public_key_from_cose(credential_public_key: bytes):
+    cose_key = parse_cbor(credential_public_key)
+    key_type = cose_key[1]
+
+    if key_type == 2:
+        return RSA.construct(
+            (
+                bytes_to_long(cose_key[-1]),
+                bytes_to_long(cose_key[-2]),
+            )
+        )
+
+    if key_type == 2:
+        curve = {
+            1: "P-256",
+            2: "P-384",
+            3: "P-521",
+        }[cose_key[-1]]
+
+        return ECC.construct(
+            curve=curve,
+            point_x=bytes_to_long(cose_key[-2]),
+            point_y=bytes_to_long(cose_key[-3]),
+        )
+
+    if key_type == 1:
+        curve = cose_key[-1]
+        public_key_bytes = cose_key[-2]
+
+        if curve == 6:
+            algorithm_identifier = b"\x30\x05\x06\x03\x2b\x65\x70"
+        elif curve == 7:
+            algorithm_identifier = b"\x30\x05\x06\x03\x2b\x65\x71"
+        else:
+            raise ValueError("Unsupported OKP curve")
+
+        subject_public_key_info = (
+            algorithm_identifier
+            + b"\x03"
+            + bytes([len(public_key_bytes) + 1])
+            + b"\x00"
+            + public_key_bytes
+        )
+
+        return ECC.import_key(
+            b"\x30"
+            + bytes([len(subject_public_key_info)])
+            + subject_public_key_info
+        )
+
+    raise ValueError("Unsupported COSE key type")
+
