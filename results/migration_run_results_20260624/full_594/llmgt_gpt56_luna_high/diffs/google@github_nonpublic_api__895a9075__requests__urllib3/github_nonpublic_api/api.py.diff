+class _Urllib3Response:
+    def __init__(self, response, url, history):
+        self._response = response
+        self.url = url
+        self.history = history
+
+    @property
+    def content(self):
+        return self._response.data
+
+    @property
+    def text(self):
+        content_type = self._response.headers.get("Content-Type", "")
+        encoding = "utf-8"
+        encoding_match = re.search(r"charset=([^;]+)", content_type, re.IGNORECASE)
+        if encoding_match:
+            encoding = encoding_match.group(1).strip().strip("\"'")
+        return self._response.data.decode(encoding, errors="replace")
+
+    def raise_for_status(self):
+        if self._response.status >= 400:
+            raise urllib3.exceptions.HTTPError(
+                "HTTP %s for url: %s" % (self._response.status, self.url)
+            )
+
+
+class _Urllib3Session:
+    def __init__(self):
+        self._pool = urllib3.PoolManager()
+        self.cookies = http.cookiejar.CookieJar()
+
+    def _request(self, method, url, data=None):
+        current_url = url
+        body = None
+        if data is not None:
+            body = urlencode(data).encode("utf-8")
+
+        history = []
+        for _ in range(30):
+            cookie_request = urllib.request.Request(current_url, method=method)
+            self.cookies.add_cookie_header(cookie_request)
+            headers = dict(cookie_request.header_items())
+            if body is not None:
+                headers["Content-Type"] = "application/x-www-form-urlencoded"
+
+            response = self._pool.request(
+                method,
+                current_url,
+                body=body,
+                headers=headers,
+                redirect=False,
+                decode_content=True,
+            )
+
+            cookie_headers = Message()
+            for header in response.headers:
+                for value in response.headers.getlist(header):
+                    cookie_headers.add_header(header, value)
+            cookie_response = urllib.response.addinfourl(
+                io.BytesIO(), cookie_headers, current_url, response.status
+            )
+            self.cookies.extract_cookies(cookie_response, cookie_request)
+
+            location = response.headers.get("Location")
+            if response.status not in (301, 302, 303, 307, 308) or location is None:
+                return _Urllib3Response(response, current_url, history)
+
+            history.append(_Urllib3Response(response, current_url, []))
+            current_url = urljoin(current_url, location)
+            if response.status in (301, 302, 303):
+                method = "GET"
+                body = None
+
+        raise urllib3.exceptions.MaxRetryError(
+            self._pool, current_url, "too many redirects"
+        )
+
+    def get(self, url):
+        return self._request("GET", url)
+
+    def post(self, url, data=None):
+        return self._request("POST", url, data=data)
 
 
