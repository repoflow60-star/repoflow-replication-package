+class PycurlResponse(object):
+    def __init__(self, status_code, content):
+        self.status_code = status_code
+        self.content = content
+        self.text = content.decode('utf-8')
+
+    def json(self):
+        return json.loads(self.text)
+
+
+def _pycurl_request(method, url, auth=None, data=None, headers=None, timeout=None, params=None):
+    if params:
+        query = urlencode([(key, value) for key, value in params.items() if value is not None], doseq=True)
+        url = '{}{}{}'.format(url, '&' if '?' in url else '?', query)
+
+    body = BytesIO()
+    curl = pycurl.Curl()
+
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEDATA, body)
+
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT, timeout)
+
+        if auth:
+            curl.setopt(pycurl.USERPWD, '{}:{}'.format(auth[0], auth[1]))
+            curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+
+        if headers:
+            curl.setopt(pycurl.HTTPHEADER, [
+                '{}: {}'.format(key, value)
+                for key, value in headers.items()
+                if value is not None
+            ])
+
+        if method == 'GET':
+            curl.setopt(pycurl.HTTPGET, 1)
+        else:
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+        if data is not None:
+            if isinstance(data, str):
+                data = data.encode('utf-8')
+            curl.setopt(pycurl.POSTFIELDS, data)
+
+        curl.perform()
+        return PycurlResponse(curl.getinfo(pycurl.RESPONSE_CODE), body.getvalue())
+    finally:
+        curl.close()
+
+
+class PycurlSession(object):
+    def __init__(self, retries=0, backoff_factor=0.3):
+        self.retries = retries
+        self.backoff_factor = backoff_factor
+
+    def request(self, method, url, **kwargs):
+        attempt = 0
+        while True:
+            try:
+                return _pycurl_request(method, url, **kwargs)
+            except pycurl.error:
+                if attempt >= self.retries:
+                    raise
+                attempt += 1
+                if attempt > 1:
+                    time.sleep(self.backoff_factor * (2 ** (attempt - 1)))
+
+    def get(self, url, **kwargs):
+        return self.request('GET', url, **kwargs)
+
+    def put(self, url, **kwargs):
+        return self.request('PUT', url, **kwargs)
+
+    def delete(self, url, **kwargs):
+        return self.request('DELETE', url, **kwargs)
+
 
