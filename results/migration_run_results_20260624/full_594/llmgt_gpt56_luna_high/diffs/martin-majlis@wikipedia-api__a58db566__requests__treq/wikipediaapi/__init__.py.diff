+_reactor_lock = Lock()
+_reactor_started = False
+
+
+def _start_reactor() -> None:
+    global _reactor_started
+
+    with _reactor_lock:
+        if not _reactor_started:
+            if not reactor.running:
+                Thread(
+                    target=reactor.run,
+                    kwargs={"installSignalHandlers": False},
+                    daemon=True,
+                ).start()
+            _reactor_started = True
+
+
+class _TreqResponse:
+    def __init__(self, data) -> None:
+        self._data = data
+
+    def json(self):
+        return self._data
+
+
+class _TreqSession:
+    def __init__(self) -> None:
+        self.headers = {}
+
+    def get(self, url, params=None, **kwargs):
+        headers = dict(self.headers)
+        headers.update(kwargs.pop("headers", {}))
+
+        treq_headers = Headers(
+            {
+                key: value if isinstance(value, list) else [value]
+                for key, value in headers.items()
+            }
+        )
+
+        _start_reactor()
+
+        def request():
+            return treq.get(
+                url,
+                params=params,
+                headers=treq_headers,
+                **kwargs,
+            ).addCallback(lambda response: response.json())
+
+        return _TreqResponse(blockingCallFromThread(reactor, request))
+
+    def close(self) -> None:
+        pass
 
 
