+class _PycurlEventSource:
+    def __init__(self) -> None:
+        self._condition = threading.Condition()
+        self._data = bytearray()
+        self._closed = False
+        self._error = None
+        self._status_code = None
+
+    def write(self, data: bytes) -> int:
+        with self._condition:
+            self._data.extend(data)
+            self._condition.notify_all()
+        return len(data)
+
+    def header(self, data: bytes) -> int:
+        status_line = data.decode("iso-8859-1").strip()
+        if status_line.startswith("HTTP/"):
+            try:
+                status_code = int(status_line.split()[1])
+                if status_code < 300 or status_code >= 400:
+                    self.set_status(status_code)
+            except (IndexError, ValueError):
+                pass
+        return len(data)
+
+    def set_status(self, status_code: int) -> None:
+        with self._condition:
+            self._status_code = status_code
+            self._condition.notify_all()
+
+    def wait_for_status(self) -> int:
+        with self._condition:
+            while self._status_code is None and self._error is None:
+                self._condition.wait()
+            if self._error is not None:
+                raise self._error
+            return self._status_code
+
+    def set_error(self, error: Exception) -> None:
+        with self._condition:
+            self._error = error
+            self._closed = True
+            self._condition.notify_all()
+
+    def close(self) -> None:
+        with self._condition:
+            self._closed = True
+            self._condition.notify_all()
+
+    def readline(self) -> bytes:
+        with self._condition:
+            while True:
+                newline_index = self._data.find(b"\n")
+                if newline_index != -1:
+                    line = bytes(self._data[: newline_index + 1])
+                    del self._data[: newline_index + 1]
+                    return line
+
+                if self._closed:
+                    if self._data:
+                        line = bytes(self._data)
+                        self._data.clear()
+                        return line
+                    if self._error is not None:
+                        raise self._error
+                    return b""
+
+                self._condition.wait()
+
+    def read(self, size: int = -1) -> bytes:
+        with self._condition:
+            if size < 0:
+                while not self._closed:
+                    self._condition.wait()
+                data = bytes(self._data)
+                self._data.clear()
+                if not data and self._error is not None:
+                    raise self._error
+                return data
+
+            while not self._data and not self._closed:
+                self._condition.wait()
+
+            if self._data:
+                data = bytes(self._data[:size])
+                del self._data[:size]
+                return data
+
+            if self._error is not None:
+                raise self._error
+            return b""
+
+    def iter_lines(self):
+        while True:
+            line = self.readline()
+            if not line:
+                return
+            yield line
+
+    def __iter__(self):
+        return self
+
+    def __next__(self):
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
 
 
