+class _PycurlEventSource:
+    def __init__(self, response_queue, state) -> None:
+        self._response_queue = response_queue
+        self._state = state
+        self._line_iterator = None
+        self.raw = self
+
+    def iter_content(self, chunk_size=None):
+        while True:
+            chunk = self._response_queue.get()
+            if chunk is None:
+                if self._state["error"] is not None:
+                    raise self._state["error"]
+                return
+            yield chunk
+
+    def iter_lines(self, chunk_size=None, decode_unicode=False):
+        buffer = b""
+        while True:
+            chunk = self._response_queue.get()
+            if chunk is None:
+                if buffer.endswith(b"\r"):
+                    buffer = buffer[:-1]
+                if buffer:
+                    line = buffer
+                    if decode_unicode:
+                        line = line.decode("utf-8")
+                    yield line
+                if self._state["error"] is not None:
+                    raise self._state["error"]
+                return
+
+            buffer += chunk
+            while True:
+                line_end = buffer.find(b"\n")
+                carriage_return_end = buffer.find(b"\r")
+                if line_end == -1:
+                    line_end = carriage_return_end
+                elif carriage_return_end != -1:
+                    line_end = min(line_end, carriage_return_end)
+
+                if line_end == -1:
+                    break
+
+                if (
+                    buffer[line_end:line_end + 1] == b"\r"
+                    and line_end == len(buffer) - 1
+                ):
+                    break
+
+                line = buffer[:line_end]
+                if buffer[line_end:line_end + 2] == b"\r\n":
+                    buffer = buffer[line_end + 2:]
+                else:
+                    buffer = buffer[line_end + 1:]
+
+                if decode_unicode:
+                    line = line.decode("utf-8")
+                yield line
+
+    def __iter__(self):
+        return self.iter_lines()
+
+    def readline(self):
+        if self._line_iterator is None:
+            self._line_iterator = self.iter_lines()
+        try:
+            return next(self._line_iterator)
+        except StopIteration:
+            return b""
 
 
