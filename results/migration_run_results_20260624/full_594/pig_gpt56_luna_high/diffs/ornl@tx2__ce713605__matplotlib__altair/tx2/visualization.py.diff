+def _titled_chart(title=None, width=200, height=150):
+    chart = alt.Chart({'values': []}).mark_point().properties(width=width, height=height)
+    if title is not None:
+        chart = chart.properties(title=title)
+    return chart
+
+def _altair_subplots(num_rows, num_cols, figsize):
+    width, height = figsize
+    axs = [[alt.Chart({'values': []}).properties(width=width, height=height) for _ in range(num_cols)] for _ in range(num_rows)]
+    if not axs:
+        return (alt.Chart({'values': []}).properties(width=width, height=height), axs)
+    rows = [alt.hconcat(*row) for row in axs]
+    fig = rows[0] if len(rows) == 1 else alt.vconcat(*rows)
+    return (fig, axs)
+'Helper functions for constructing visualizations.'
