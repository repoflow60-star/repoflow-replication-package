+        c.setopt(pycurl.HEADERFUNCTION, headers.append)
+        if not verify:
+            c.setopt(pycurl.SSL_VERIFYPEER, False)
+            c.setopt(pycurl.SSL_VERIFYHOST, False)
+        c.perform()
+        status_code = c.getinfo(pycurl.RESPONSE_CODE)
+        effective_url = c.getinfo(pycurl.EFFECTIVE_URL)
+        c.close()
+
+        header_block = b"".join(headers).decode("iso-8859-1").split("\r\n")
+        for header_line in header_block:
+            if ":" in header_line:
+                key, value = header_line.split(":", 1)
+                response_headers[key.strip().lower()] = value.strip()
+
+        class Resp:
+            pass
+
+        resp = Resp()
+        resp.status_code = status_code
+        resp.url = effective_url
+        resp.history = []
+        resp.headers = response_headers
+        resp.content = buffer.getvalue()
+        return resp
