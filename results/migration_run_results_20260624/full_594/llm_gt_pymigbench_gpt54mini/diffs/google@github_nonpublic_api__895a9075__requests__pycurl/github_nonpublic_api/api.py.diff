+class _PycurlResponse(object):
+    def __init__(self, url, body, status_code):
+        self.url = url
+        self.text = body.decode("utf-8")
+        self.content = body
+        self.status_code = status_code
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise Exception("HTTP error %d for url %s" % (self.status_code, self.url))
+
+
+class _PycurlSession(object):
+    def __init__(self):
+        self._cookie_file = tempfile.NamedTemporaryFile(delete=False)
+        self._cookie_file.close()
+
+    def clear_cookies(self):
+        open(self._cookie_file.name, "w").close()
+
+    def _request(self, url, method="GET", data=None):
+        buffer = io.BytesIO()
+        curl = pycurl.Curl()
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.COOKIEFILE, self._cookie_file.name)
+        curl.setopt(pycurl.COOKIEJAR, self._cookie_file.name)
+        curl.setopt(pycurl.WRITEFUNCTION, buffer.write)
+
+        if method == "POST":
+            curl.setopt(pycurl.POST, True)
+            curl.setopt(pycurl.POSTFIELDS, data)
+
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        effective_url = curl.getinfo(pycurl.EFFECTIVE_URL)
+        curl.close()
+
+        response = _PycurlResponse(
+            url=effective_url,
+            body=buffer.getvalue(),
+            status_code=status_code,
+        )
+        return response
+
+    def get(self, url):
+        return self._request(url, method="GET")
+
+    def post(self, url, data=None):
+        if data is None:
+            data = ""
+        if isinstance(data, dict):
+            data = "&".join(
+                "%s=%s" % (key, value) for key, value in data.items()
+            )
+        return self._request(url, method="POST", data=data)
 
 
