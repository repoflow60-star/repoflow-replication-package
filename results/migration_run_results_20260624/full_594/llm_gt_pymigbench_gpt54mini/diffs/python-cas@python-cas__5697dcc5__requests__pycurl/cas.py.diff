+    def _perform_request(self, url, method='GET', params=None, data=None, headers=None, stream=False):
+        buffer = BytesIO()
+        curl = self.session
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEDATA, buffer)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.SSL_VERIFYPEER, 1 if self.verify_ssl_certificate else 0)
+        curl.setopt(pycurl.SSL_VERIFYHOST, 2 if self.verify_ssl_certificate else 0)
+        if headers:
+            curl.setopt(pycurl.HTTPHEADER, headers)
+        else:
+            curl.setopt(pycurl.HTTPHEADER, [])
+        if method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, data)
+        else:
+            curl.setopt(pycurl.HTTPGET, 1)
+        if params:
+            query = urllib_parse.urlencode(params)
+            if '?' in url:
+                curl.setopt(pycurl.URL, ''.join([url, '&', query]))
+            else:
+                curl.setopt(pycurl.URL, ''.join([url, '?', query]))
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        content = buffer.getvalue()
+        return status_code, content
 
