+    def _request(self, method, url, data=None, headers=None, cookie=None):
+        buffer = io.BytesIO()
+        header_buffer = io.BytesIO()
+        curl = pycurl.Curl()
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEDATA, buffer)
+        curl.setopt(pycurl.HEADERFUNCTION, header_buffer.write)
+
+        if method == "POST":
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, data)
+        else:
+            curl.setopt(pycurl.HTTPGET, 1)
+
+        request_headers = []
+        if headers is not None:
+            for key, value in headers.items():
+                request_headers.append(key + ": " + value)
+
+        if cookie is not None:
+            request_headers.append("Cookie: " + cookie)
+
+        if request_headers:
+            curl.setopt(pycurl.HTTPHEADER, request_headers)
+
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        curl.close()
+
+        response_body = buffer.getvalue().decode("utf-8")
+        response_headers = header_buffer.getvalue().decode("utf-8")
+
+        response_cookie = None
+        for line in response_headers.splitlines():
+            if line.lower().startswith("set-cookie:"):
+                response_cookie = line[len("Set-Cookie:"):].strip()
+                break
+
+        return status_code, response_body, response_cookie
+
