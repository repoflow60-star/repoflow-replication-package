     # Helpers Methods #
+
+    def _perform_request(self, method, url, headers=None, json=None):
+        buffer = io.BytesIO()
+        curl = pycurl.Curl()
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.TIMEOUT, self.timeout)
+        curl.setopt(pycurl.WRITEFUNCTION, buffer.write)
+
+        if headers is not None:
+            curl_headers = []
+            for key, value in headers.items():
+                curl_headers.append(key + ': ' + value)
+            curl.setopt(pycurl.HTTPHEADER, curl_headers)
+
+        if method == "GET":
+            curl.setopt(pycurl.HTTPGET, 1)
+        elif method == "POST":
+            curl.setopt(pycurl.POST, 1)
+            if json is not None:
+                curl.setopt(pycurl.POSTFIELDS, json.dumps(json))
+        elif method == "PUT":
+            curl.setopt(pycurl.CUSTOMREQUEST, "PUT")
+            if json is not None:
+                curl.setopt(pycurl.POSTFIELDS, json.dumps(json))
+        elif method == "DELETE":
+            curl.setopt(pycurl.CUSTOMREQUEST, "DELETE")
+            if json is not None:
+                curl.setopt(pycurl.POSTFIELDS, json.dumps(json))
+
+        curl.perform()
+        response_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        response_body = buffer.getvalue().decode('utf-8')
+        curl.close()
+
+        class Response(object):
+            def __init__(self, status_code, text):
+                self.status_code = status_code
+                self.text = text
+
+            def json(self):
+                return json.loads(self.text)
+
+        return Response(response_code, response_body)
 
