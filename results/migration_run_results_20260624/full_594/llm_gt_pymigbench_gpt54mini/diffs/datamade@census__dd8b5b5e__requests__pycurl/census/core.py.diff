@@ -8,8 +8,45 @@
 
 
 def new_session(*args, **kwargs):
-    import requests
-    return requests.session(*args, **kwargs)
+    import pycurl
+    return PyCurlSession(*args, **kwargs)
+
+
+class PyCurlResponse(object):
+
+    def __init__(self, status_code, text):
+        self.status_code = status_code
+        self.text = text
+
+    def json(self):
+        import json
+        return json.loads(self.text)
+
+
+class PyCurlSession(object):
+
+    def __init__(self, *args, **kwargs):
+        self.headers = {}
+
+    def get(self, url, params=None):
+        import io
+        import urllib.parse
+        import pycurl
+
+        if params:
+            url = url + '?' + urllib.parse.urlencode(params)
+
+        buffer = io.BytesIO()
+        c = pycurl.Curl()
+        c.setopt(pycurl.URL, url)
+        c.setopt(pycurl.WRITEDATA, buffer)
+        if self.headers:
+            c.setopt(pycurl.HTTPHEADER, ['{}: {}'.format(key, value) for key, value in self.headers.items()])
+        c.perform()
+        status_code = c.getinfo(pycurl.RESPONSE_CODE)
+        c.close()
+        text = buffer.getvalue().decode('utf-8')
+        return PyCurlResponse(status_code, text)
 
 
