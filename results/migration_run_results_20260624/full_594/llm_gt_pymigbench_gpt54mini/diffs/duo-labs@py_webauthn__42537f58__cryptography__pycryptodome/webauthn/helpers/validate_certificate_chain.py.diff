+def _load_certificate(cert_bytes: bytes):
+    if PEM.detect(cert_bytes):
+        der_bytes, marker, enc_flag = PEM.decode(cert_bytes)
+    else:
+        der_bytes = cert_bytes
+
+    cert = DerSequence()
+    cert.decode(der_bytes)
+
+    tbs_certificate = cert[0]
+    signature_algorithm = cert[1]
+    signature_value = cert[2]
+
+    tbs = DerSequence()
+    tbs.decode(tbs_certificate)
+
+    return {
+        "tbs_certificate": tbs_certificate,
+        "signature_algorithm": signature_algorithm,
+        "signature_value": signature_value,
+        "subject": tbs[5],
+        "issuer": tbs[3],
+        "public_key": tbs[6],
+    }
+
+
+def _get_public_key_from_certificate(cert):
+    spki = DerSequence()
+    spki.decode(cert["public_key"])
+
+    algorithm = DerSequence()
+    algorithm.decode(spki[0])
+
+    public_key_der = spki[1]
+    rsa_key = RSA.import_key(public_key_der)
+    return rsa_key
+
+
+def _verify_certificate_signature(cert, issuer_cert):
+    issuer_public_key = _get_public_key_from_certificate(issuer_cert)
+
+    tbs_certificate = cert["tbs_certificate"]
+    signature_value = cert["signature_value"]
+
+    signature = DerBitString()
+    signature.decode(signature_value)
+    signature_bytes = signature.value
+
+    h = SHA256.new(tbs_certificate)
+    pkcs1_15.new(issuer_public_key).verify(h, signature_bytes)
 
 
