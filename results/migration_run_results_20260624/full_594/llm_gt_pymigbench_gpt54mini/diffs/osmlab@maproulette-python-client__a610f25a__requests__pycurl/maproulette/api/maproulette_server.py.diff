+    def __request(self, method, url, params=None, body=None, files=None, headers=None, verify=None, certs=None):
+        response_body = io.BytesIO()
+        curl = pycurl.Curl()
+        try:
+            if params:
+                url = url + '?' + urlencode(params)
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEDATA, response_body)
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            if headers:
+                curl.setopt(pycurl.HTTPHEADER, [f"{key}: {value}" for key, value in headers.items()])
+            if verify is False:
+                curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+                curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+            if certs:
+                if isinstance(certs, tuple) or isinstance(certs, list):
+                    if len(certs) > 0 and certs[0]:
+                        curl.setopt(pycurl.SSLCERT, certs[0])
+                    if len(certs) > 1 and certs[1]:
+                        curl.setopt(pycurl.SSLKEY, certs[1])
+                else:
+                    curl.setopt(pycurl.SSLCERT, certs)
+            if body is not None:
+                if files is not None:
+                    form = []
+                    for key, value in files.items():
+                        form.append((key, (pycurl.FORM_FILE, value)))
+                    curl.setopt(pycurl.HTTPPOST, form)
+                else:
+                    body_data = json.dumps(body).encode('utf-8')
+                    curl.setopt(pycurl.POSTFIELDS, body_data)
+                    if method == 'POST':
+                        curl.setopt(pycurl.POST, 1)
+            curl.perform()
+            status = curl.getinfo(pycurl.RESPONSE_CODE)
+            response_text = response_body.getvalue().decode('utf-8')
+            return {
+                "data": response_text,
+                "status": status
+            }
+        finally:
+            curl.close()
+
