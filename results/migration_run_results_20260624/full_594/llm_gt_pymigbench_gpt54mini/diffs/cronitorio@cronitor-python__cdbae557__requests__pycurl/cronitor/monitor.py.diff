     @classmethod
+    def _request(cls, method, url, auth=None, data=None, headers=None, timeout=None, params=None):
+        buffer = BytesIO()
+        curl = pycurl.Curl()
+        if params:
+            query = []
+            for k, v in params.items():
+                if v is not None:
+                    query.append('{}={}'.format(k, v))
+            if query:
+                url = '{}?{}'.format(url, '&'.join(query))
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEDATA, buffer)
+        curl.setopt(pycurl.CUSTOMREQUEST, method)
+        if timeout:
+            curl.setopt(pycurl.TIMEOUT, timeout)
+        if auth:
+            curl.setopt(pycurl.USERPWD, '{}:{}'.format(auth[0], auth[1]))
+        if headers:
+            curl.setopt(pycurl.HTTPHEADER, ['{}: {}'.format(k, v) for k, v in headers.items()])
+        if data is not None:
+            curl.setopt(pycurl.POSTFIELDS, data)
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        resp = buffer.getvalue().decode('utf-8')
+        curl.close()
+        class Resp(object):
+            def __init__(self, status_code, text):
+                self.status_code = status_code
+                self.text = text
+            def json(self):
+                return json.loads(self.text)
+        return Resp(status_code, resp)
