+def pycurl_request(method, url, json_data=None, headers=None, data=None):
+    response_body = BytesIO()
+    response_headers = BytesIO()
+    curl = pycurl.Curl()
+    curl.setopt(pycurl.URL, url)
+    curl.setopt(pycurl.FOLLOWLOCATION, True)
+    curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+    curl.setopt(pycurl.HEADERFUNCTION, response_headers.write)
+
+    request_headers = []
+    if headers:
+        for key, value in headers.items():
+            request_headers.append('{}: {}'.format(key, value))
+
+    if json_data is not None:
+        body = json.dumps(json_data).encode('utf-8')
+        request_headers.append('Content-Type: application/json')
+        curl.setopt(pycurl.POSTFIELDS, body)
+        curl.setopt(pycurl.POSTFIELDSIZE, len(body))
+    elif data is not None:
+        curl.setopt(pycurl.POSTFIELDS, data)
+
+    if request_headers:
+        curl.setopt(pycurl.HTTPHEADER, request_headers)
+
+    if method == 'POST':
+        curl.setopt(pycurl.POST, True)
+    elif method == 'PUT':
+        curl.setopt(pycurl.UPLOAD, True)
+        curl.setopt(pycurl.READFUNCTION, BytesIO(data).read)
+        curl.setopt(pycurl.INFILESIZE, len(data))
+
+    curl.perform()
+    status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    curl.close()
+
+    return status_code, response_body.getvalue(), response_headers.getvalue()
 
 
