+def _pycurl_request(url: str, method: str = 'GET', data: bytes | None = None) -> tuple[int, dict, bytes]:
+    response_headers = {}
+    response_body = bytearray()
+
+    def header_function(header_line):
+        header_line = header_line.decode('iso-8859-1')
+        if ':' in header_line:
+            key, value = header_line.split(':', 1)
+            response_headers[key.strip()] = value.strip()
+
+    REQ_SESSION.setopt(pycurl.URL, url)
+    REQ_SESSION.setopt(pycurl.FOLLOWLOCATION, 0)
+    REQ_SESSION.setopt(pycurl.NOPROGRESS, 1)
+    REQ_SESSION.setopt(pycurl.WRITEFUNCTION, response_body.extend)
+    REQ_SESSION.setopt(pycurl.HEADERFUNCTION, header_function)
+    REQ_SESSION.setopt(pycurl.CUSTOMREQUEST, method)
+
+    if VERIFY_SSL:
+        REQ_SESSION.setopt(pycurl.SSL_VERIFYPEER, 1)
+        REQ_SESSION.setopt(pycurl.SSL_VERIFYHOST, 2)
+    else:
+        REQ_SESSION.setopt(pycurl.SSL_VERIFYPEER, 0)
+        REQ_SESSION.setopt(pycurl.SSL_VERIFYHOST, 0)
+
+    if PROXY_DICT:
+        REQ_SESSION.setopt(pycurl.PROXY, PROXY_DICT['https'])
+    else:
+        REQ_SESSION.setopt(pycurl.PROXY, '')
+
+    if method == 'POST':
+        REQ_SESSION.setopt(pycurl.POST, 1)
+        REQ_SESSION.setopt(pycurl.POSTFIELDS, data if data is not None else b'')
+        REQ_SESSION.setopt(pycurl.HTTPHEADER, [f'{k}: {v}' for k, v in UPLOAD_HEADERS.items()])
+    else:
+        REQ_SESSION.setopt(pycurl.HTTPGET, 1)
+        REQ_SESSION.setopt(pycurl.HTTPHEADER, [])
+
+    REQ_SESSION.perform()
+    status_code = REQ_SESSION.getinfo(pycurl.RESPONSE_CODE)
+
+    return status_code, response_headers, bytes(response_body)
+
