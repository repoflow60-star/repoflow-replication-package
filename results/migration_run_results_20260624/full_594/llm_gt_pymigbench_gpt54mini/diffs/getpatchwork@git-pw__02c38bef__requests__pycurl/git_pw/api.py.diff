+class _Response:
+    def __init__(self, body: bytes, headers: ty.Dict[str, str], status_code: int):
+        self.content = body
+        self.headers = headers
+        self.status_code = status_code
+
+    def json(self):
+        return json.loads(self.content.decode('utf-8'))
+
+
+class _RequestException(Exception):
+    def __init__(self, response: ty.Optional[_Response] = None):
+        self.response = response
+
+
+def _perform(
+    url: str,
+    method: str,
+    data: ty.Optional[ty.List[ty.Tuple[str, ty.Any]]] = None,
+    params: ty.Optional[Filters] = None,
+    stream: bool = False,
+) -> _Response:
+    body_buffer = io.BytesIO()
+    header_buffer = io.BytesIO()
+    curl = pycurl.Curl()
+
+    try:
+        if params:
+            query = '&'.join(
+                '{}={}'.format(
+                    pycurl.escape(str(k)),
+                    pycurl.escape(str(v)),
+                )
+                for k, v in params
+            )
+            url = '{}?{}'.format(url, query)
+
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.CUSTOMREQUEST, method)
+        curl.setopt(pycurl.HTTPHEADER, [
+            '{}: {}'.format(k, v) for k, v in _get_headers().items()
+        ])
+
+        auth = _get_auth(optional=(method == 'GET'))
+        if auth:
+            if isinstance(auth, tuple):
+                curl.setopt(pycurl.USERPWD, '{}:{}'.format(auth[0], auth[1]))
+            else:
+                auth(curl)
+
+        if data:
+            encoded = '&'.join(
+                '{}={}'.format(
+                    pycurl.escape(str(k)),
+                    pycurl.escape(str(v)),
+                )
+                for k, v in data
+            ).encode('utf-8')
+            curl.setopt(pycurl.POSTFIELDS, encoded)
+
+        if stream:
+            curl.setopt(pycurl.WRITEFUNCTION, body_buffer.write)
+        else:
+            curl.setopt(pycurl.WRITEFUNCTION, body_buffer.write)
+
+        curl.setopt(pycurl.HEADERFUNCTION, header_buffer.write)
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+
+        response_headers = {}
+        for line in header_buffer.getvalue().decode('iso-8859-1').splitlines():
+            if ':' in line:
+                key, value = line.split(':', 1)
+                response_headers[key.strip().lower()] = value.strip()
+
+        rsp = _Response(body_buffer.getvalue(), response_headers, status_code)
+
+        if status_code >= 400:
+            raise _RequestException(rsp)
+
+        return rsp
+    except pycurl.error:
+        raise _RequestException()
+    finally:
+        curl.close()
+
