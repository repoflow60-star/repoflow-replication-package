+    class _Response:
+        def __init__(self, body, status_code, url):
+            self._body = body
+            self.status_code = status_code
+            self.url = url
+
+        def json(self):
+            return json.loads(self._body)
+
+        def raise_for_status(self):
+            if self.status_code >= 400:
+                raise Exception(f'HTTP {self.status_code}')
+
+    def _request(self, method, url, data=None, headers=None, files=None):
+        buffer = io.BytesIO()
+        curl = self.session
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.CUSTOMREQUEST, method)
+        curl.setopt(pycurl.WRITEFUNCTION, buffer.write)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+
+        header_list = []
+        if headers:
+            for k, v in headers.items():
+                header_list.append(f'{k}: {v}')
+        curl.setopt(pycurl.HTTPHEADER, header_list)
+
+        if method in ['POST', 'PUT']:
+            if files:
+                form = []
+                for k, v in files.items():
+                    if isinstance(v, tuple):
+                        if len(v) == 3:
+                            form.append((k, (pycurl.FORM_FILE, v[0], pycurl.FORM_CONTENTS, v[1], pycurl.FORM_CONTENTTYPE, v[2])))
+                        else:
+                            form.append((k, (pycurl.FORM_FILE, v[0], pycurl.FORM_CONTENTS, v[1])))
+                    else:
+                        form.append((k, v))
+                curl.setopt(pycurl.HTTPPOST, form)
+            else:
+                if data is not None:
+                    if isinstance(data, str):
+                        data = data.encode('utf-8')
+                    curl.setopt(pycurl.POSTFIELDS, data)
+
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        effective_url = curl.getinfo(pycurl.EFFECTIVE_URL)
+        body = buffer.getvalue().decode('utf-8')
+        return self._Response(body, status_code, effective_url)
 
