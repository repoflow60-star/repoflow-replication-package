+        def _request(self, method, url, data=None, files=None, params=None):
+            class _Response:
+                def __init__(self, body):
+                    self._body = body
+
+                def json(self):
+                    return json.loads(self._body)
+
+            buffer = bytearray()
+            c = pycurl.Curl()
+            c.setopt(pycurl.URL, url)
+
+            if method == 'GET':
+                c.setopt(pycurl.HTTPGET, 1)
+            elif method == 'POST':
+                c.setopt(pycurl.POST, 1)
+            elif method == 'PUT':
+                c.setopt(pycurl.UPLOAD, 1)
+                if data is not None:
+                    body = data.encode('utf-8') if isinstance(data, str) else data
+                    c.setopt(pycurl.READFUNCTION, lambda size: body)
+                    c.setopt(pycurl.INFILESIZE, len(body))
+
+            if params:
+                query = '&'.join([f'{k}={v}' for k, v in params.items()])
+                if '?' in url:
+                    c.setopt(pycurl.URL, url + '&' + query)
+                else:
+                    c.setopt(pycurl.URL, url + '?' + query)
+
+            if files:
+                if 'url' in files:
+                    c.setopt(pycurl.HTTPPOST, [('url', files['url']), ('upload', files['upload']), ('file', (pycurl.FORM_FILE, ''))])
+
+            if data is not None and method != 'PUT':
+                body = data.encode('utf-8') if isinstance(data, str) else data
+                c.setopt(pycurl.POSTFIELDS, body)
+
+            c.setopt(pycurl.WRITEFUNCTION, buffer.extend)
+            c.perform()
+            c.close()
+            return _Response(buffer.decode('utf-8'))
 
