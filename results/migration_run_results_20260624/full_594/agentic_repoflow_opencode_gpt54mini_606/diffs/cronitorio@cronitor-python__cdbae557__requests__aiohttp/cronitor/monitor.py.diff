+class _AiohttpSession(object):
+    def __init__(self, retries, backoff_factor=0.3):
+        self.retries = retries
+        self.backoff_factor = backoff_factor
+
+    def _request_kwargs(self, kwargs):
+        params = kwargs.pop('params', None)
+        headers = kwargs.pop('headers', None)
+        auth = kwargs.pop('auth', None)
+        timeout = kwargs.pop('timeout', None)
+
+        request_kwargs = dict(kwargs)
+        if params is not None:
+            request_kwargs['params'] = {k: v for k, v in params.items() if v is not None}
+        if headers is not None:
+            request_kwargs['headers'] = {k: v for k, v in headers.items() if v is not None}
+        if auth is not None:
+            login, password = auth
+            token = base64.b64encode(('%s:%s' % (login, password)).encode('utf-8')).decode('ascii')
+            request_kwargs['headers'] = dict(request_kwargs.get('headers', {}), Authorization='Basic %s' % token)
+        if timeout is not None:
+            request_kwargs['timeout'] = aiohttp.ClientTimeout(total=timeout)
+        return request_kwargs
+
+    async def _request(self, method, url, **kwargs):
+        request_kwargs = self._request_kwargs(kwargs)
+
+        last_error = None
+        for attempt in range(self.retries + 1):
+            try:
+                async with aiohttp.ClientSession() as session:
+                    async with session.request(method, url, **request_kwargs) as resp:
+                        return _Response(resp.status, await resp.text())
+            except (aiohttp.ClientError, asyncio.TimeoutError) as exc:
+                last_error = exc
+                if attempt == self.retries:
+                    raise
+                await asyncio.sleep(self.backoff_factor * (2 ** attempt))
+
+        raise last_error
+
+    def _run(self, method, url, **kwargs):
+        return asyncio.run(self._request(method, url, **kwargs))
+
+    def get(self, url, **kwargs):
+        return self._run('GET', url, **kwargs)
+
+    def put(self, url, **kwargs):
+        return self._run('PUT', url, **kwargs)
+
+    def delete(self, url, **kwargs):
+        return self._run('DELETE', url, **kwargs)
