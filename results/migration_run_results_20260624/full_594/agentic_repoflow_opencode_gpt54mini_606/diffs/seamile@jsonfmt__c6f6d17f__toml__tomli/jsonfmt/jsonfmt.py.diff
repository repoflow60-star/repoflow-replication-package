+def _toml_format_key(key: str) -> str:
+    if key and all(ch.isalnum() or ch in '_-' for ch in key):
+        return key
+    return json.dumps(key, ensure_ascii=False)
+
+
+def _toml_format_value(value: Any) -> str:
+    if isinstance(value, str):
+        return json.dumps(value, ensure_ascii=False)
+    if isinstance(value, bool):
+        return 'true' if value else 'false'
+    if isinstance(value, (datetime, date, time)):
+        return value.isoformat()
+    if isinstance(value, int):
+        return str(value)
+    if isinstance(value, float):
+        return repr(value)
+    if isinstance(value, (list, tuple)):
+        return '[' + ', '.join(_toml_format_value(item) for item in value) + ']'
+
+    raise TypeError(f'unsupported toml value type: {type(value).__name__}')
+
+
+def _toml_dump_table(py_obj: dict, path: Optional[List[str]] = None, *,
+                     is_array_item: bool = False) -> List[str]:
+    path = path or []
+    lines: List[str] = []
+
+    if path:
+        header = '.'.join(_toml_format_key(part) for part in path)
+        bracket = '[[' if is_array_item else '['
+        close_bracket = ']]' if is_array_item else ']'
+        lines.append(f'{bracket}{header}{close_bracket}')
+
+    scalar_lines: List[str] = []
+    child_sections: List[Tuple[str, Any, bool]] = []
+
+    for key, value in py_obj.items():
+        if isinstance(value, dict):
+            child_sections.append((key, value, False))
+        elif isinstance(value, (list, tuple)) and value and all(isinstance(item, dict) for item in value):
+            child_sections.append((key, value, True))
+        else:
+            scalar_lines.append(f'{_toml_format_key(key)} = {_toml_format_value(value)}')
+
+    lines.extend(scalar_lines)
+    emitted_child_section = False
+
+    for key, value, is_array in child_sections:
+        if emitted_child_section:
+            lines.append('')
+
+        if is_array:
+            for idx, item in enumerate(value):
+                if idx > 0:
+                    lines.append('')
+                lines.extend(_toml_dump_table(item, path + [key], is_array_item=True))
+        else:
+            lines.extend(_toml_dump_table(value, path + [key]))
+
+        emitted_child_section = True
+
+    return lines
+
+
+def _toml_dumps(py_obj: dict) -> str:
+    return '\n'.join(_toml_dump_table(py_obj))
+
+
