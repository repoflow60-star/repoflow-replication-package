+def _render_table(rows: List[List[object]], headers: List[str]) -> str:
+    table = PrettyTable()
+    table.field_names = headers
+    table.border = False
+    table.header = True
+    table.hrules = HRuleStyle.HEADER
+    table.vrules = VRuleStyle.NONE
+    table.padding_width = 1
+    table.align = "r"
+    for row in rows:
+        table.add_row(row)
+    return table.get_string()
 
 
