+class _CookieJar(object):
+    def __init__(self):
+        self._cookies = {}
+
+    def clear(self):
+        self._cookies.clear()
+
+    def header_value(self):
+        return "; ".join("%s=%s" % (key, value) for key, value in self._cookies.items())
+
+    def absorb(self, header_value: str):
+        cookie = SimpleCookie()
+        cookie.load(header_value)
+        for key, morsel in cookie.items():
+            self._cookies[key] = morsel.value
+
+
+class _PycurlSession(object):
+    def __init__(self):
+        self.cookies = _CookieJar()
+
+    def get(self, url: str):
+        return self._request("GET", url)
+
+    def post(self, url: str, data=None):
+        return self._request("POST", url, data=data)
+
+    def _request(self, method: str, url: str, data=None):
+        body_buffer = io.BytesIO()
+        header_buffer = io.BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.COOKIEFILE, "")
+            curl.setopt(pycurl.ACCEPT_ENCODING, "")
+            curl.setopt(pycurl.WRITEFUNCTION, body_buffer.write)
+            curl.setopt(pycurl.HEADERFUNCTION, header_buffer.write)
+
+            cookie_header = self.cookies.header_value()
+            if cookie_header:
+                curl.setopt(pycurl.COOKIE, cookie_header)
+
+            if method == "POST":
+                curl.setopt(pycurl.POST, 1)
+                curl.setopt(pycurl.POSTFIELDS, urlencode(data or {}))
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            final_url = curl.getinfo(pycurl.EFFECTIVE_URL) or url
+
+            headers = {}
+            raw_headers = header_buffer.getvalue().decode("iso-8859-1")
+            for line in raw_headers.splitlines():
+                if not line or line.startswith("HTTP/"):
+                    continue
+                if ":" not in line:
+                    continue
+                key, value = line.split(":", 1)
+                key = key.strip().lower()
+                value = value.strip()
+                headers[key] = value
+                if key == "set-cookie":
+                    self.cookies.absorb(value)
+
+            return _Response(
+                url=final_url,
+                status_code=status_code,
+                content=body_buffer.getvalue(),
+                headers=headers,
+            )
+        finally:
+            curl.close()
 
 
