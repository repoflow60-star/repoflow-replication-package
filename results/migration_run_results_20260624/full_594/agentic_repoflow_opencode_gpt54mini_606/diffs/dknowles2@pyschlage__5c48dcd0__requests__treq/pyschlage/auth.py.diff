+
+    @property
+    def data(self) -> Any:
+        return self.body
+
+    def register_hook(self, event: str, hook: Any) -> None:
+        self.hooks.setdefault(event, []).append(hook)
+
+    def prepare(self) -> "Request":
+        return self
+
+
+@dataclass
+class Response:
+    status_code: int
+    reason: str
+    _body: bytes = b""
+
+    @property
+    def code(self) -> int:
+        return self.status_code
+
+    @property
+    def content(self) -> bytes:
+        return self._body
+
+    @property
+    def text(self) -> str:
+        return self._body.decode()
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            raise _HTTPError(f"{self.status_code} {self.reason}".strip())
+
+    def json(self) -> Any:
+        return json.loads(self._body.decode())
+
+
+class _HTTPError(Exception):
+    """Raised when an HTTP response indicates failure."""
+
+
+def _ensure_reactor() -> None:
+    try:
+        asyncioreactor.install(_LOOP)
+    except Exception:
+        pass
+
+
+def _run(awaitable: Any) -> Any:
+    if isinstance(awaitable, Deferred):
+        _ensure_reactor()
+        awaitable = awaitable.asFuture(_LOOP)
+        asyncio.set_event_loop(_LOOP)
+        return _LOOP.run_until_complete(awaitable)
+    return awaitable
+
+
+def _read_response(response: Any) -> Response:
+    body = _run(treq.content(response))
+    if isinstance(body, str):
+        body = body.encode()
+    elif body is None:
+        body = b""
+
+    reason = getattr(response, "phrase", "") or getattr(response, "reason", "")
+    if not reason:
+        reason = f"HTTP {getattr(response, 'code', getattr(response, 'status_code', 0))}"
+    if isinstance(reason, bytes):
+        reason = reason.decode()
+
+    return Response(
+        status_code=getattr(response, "code", getattr(response, "status_code", 0)),
+        reason=reason,
+        _body=bytes(body),
+    )
