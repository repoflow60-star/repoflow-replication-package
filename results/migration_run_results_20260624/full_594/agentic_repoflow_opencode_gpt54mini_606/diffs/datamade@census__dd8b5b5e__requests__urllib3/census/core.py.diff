+import json
 import warnings
 from functools import wraps, lru_cache
 from importlib.metadata import version
 
+import urllib3
+
 __version__ = version('census')
 
 ALL = '*'
 
 
+class _Response(object):
+
+    def __init__(self, response):
+        self._response = response
+        self.status_code = response.status
+        self.text = response.data.decode('utf-8') if response.data else ''
+
+    def json(self):
+        return json.loads(self.text)
+
+
+class _Session(object):
+
+    def __init__(self, *args, **kwargs):
+        self.headers = kwargs.pop('headers', {}) or {}
+        self._session = urllib3.PoolManager(*args, **kwargs)
+
+    def get(self, url, params=None, **kwargs):
+        headers = dict(self.headers)
+        headers.update(kwargs.pop('headers', {}) or {})
+        response = self._session.request('GET', url, fields=params, headers=headers, **kwargs)
+        return _Response(response)
+
+    def close(self):
+        self._session.clear()
+
+
+class _SessionAdapter(object):
+
+    def __init__(self, session):
+        self._session = session
+        self.headers = getattr(session, 'headers', {}) or {}
+
+    def get(self, url, params=None, **kwargs):
+        headers = dict(self.headers)
+        headers.update(kwargs.pop('headers', {}) or {})
+        response = self._session.request('GET', url, fields=params, headers=headers, **kwargs)
+        return _Response(response)
+
+    def close(self):
+        close = getattr(self._session, 'close', None)
+        if close is not None:
+            close()
+            return
+
+        clear = getattr(self._session, 'clear', None)
+        if clear is not None:
+            clear()
+
+
+def _ensure_session(session):
+    if hasattr(session, 'get') and hasattr(session, 'headers'):
+        return session
+    return _SessionAdapter(session)
+
+
