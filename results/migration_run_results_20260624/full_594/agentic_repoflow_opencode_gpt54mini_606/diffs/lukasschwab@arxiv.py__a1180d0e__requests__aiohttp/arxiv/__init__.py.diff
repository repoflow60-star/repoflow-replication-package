+    async def __fetch_page(self, url: str) -> tuple[bytes, int]:
+        async with aiohttp.ClientSession() as session:
+            request = session.get(url, headers={"user-agent": "arxiv.py/2.1.3"})
+            if hasattr(request, "__aenter__"):
+                async with request as resp:
+                    return await self.__read_page(resp)
+            if hasattr(request, "__await__"):
+                request = await request
+            return await self.__read_page(request)
+
+    async def __read_page(self, resp) -> tuple[bytes, int]:
+        if hasattr(resp, "read"):
+            body = resp.read()
+            if hasattr(body, "__await__"):
+                body = await body
+        else:
+            body = getattr(resp, "content", b"")
+        status = getattr(resp, "status", None)
+        if status is None:
+            status = getattr(resp, "status_code")
+        return body, status
 
 
