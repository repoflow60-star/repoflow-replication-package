--- a/ldnlib/_treq.py
+++ b/ldnlib/_treq.py
@@ -0,0 +1,119 @@
+import json
+
+import treq
+from twisted.internet import defer, reactor, threads
+
+
+def _to_text(value):
+    if isinstance(value, bytes):
+        return value.decode('utf-8', errors='replace')
+    return str(value)
+
+
+def _headers_to_dict(headers):
+    result = {}
+
+    if hasattr(headers, 'getAllRawHeaders'):
+        for name, values in headers.getAllRawHeaders():
+            if values:
+                result[_to_text(name).lower()] = ', '.join(_to_text(v)
+                                                           for v in values)
+    else:
+        for name, value in dict(headers).items():
+            result[_to_text(name).lower()] = _to_text(value)
+
+    return result
+
+
+def _parse_links(link_header):
+    links = {}
+    if not link_header:
+        return links
+
+    link_header = _to_text(link_header)
+
+    for link in link_header.split(','):
+        link = link.strip()
+        if not link.startswith('<') or '>;' not in link:
+            continue
+
+        url, params = link[1:].split('>', 1)
+        rel = None
+        for param in params.split(';'):
+            param = param.strip()
+            if param.startswith('rel='):
+                rel = param[4:].strip('"')
+                break
+
+        if rel:
+            links[rel] = {'url': url}
+
+    return links
+
+
+def _decode_body(body, content_type):
+    if body is None:
+        return ''
+    if isinstance(body, str):
+        return body
+
+    charset = 'utf-8'
+    if content_type:
+        for item in content_type.split(';')[1:]:
+            item = item.strip()
+            if item.startswith('charset='):
+                charset = item.split('=', 1)[1].strip()
+                break
+
+    return body.decode(charset, errors='replace')
+
+
+class _Response(object):
+
+    def __init__(self, response, body):
+        self.status_code = response.code
+        self.headers = _headers_to_dict(response.headers)
+        self.links = _parse_links(self.headers.get('link'))
+        self.text = _decode_body(body, self.headers.get('content-type'))
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise RuntimeError('HTTP {}'.format(self.status_code))
+
+
+def _request(method, url, **kwargs):
+    data = kwargs.get('data')
+    if isinstance(data, str):
+        kwargs['data'] = data.encode('utf-8')
+
+    if method == 'OPTIONS':
+        deferred = treq.request(method, url, **kwargs)
+    else:
+        deferred = getattr(treq, method.lower())(url, **kwargs)
+
+    response = threads.blockingCallFromThread(
+        reactor, defer.maybeDeferred, lambda: deferred)
+    body = threads.blockingCallFromThread(
+        reactor, defer.maybeDeferred, treq.content, response)
+    return _Response(response, body)
+
+
+def get(url, **kwargs):
+    return _request('GET', url, **kwargs)
+
+
+def head(url, **kwargs):
+    return _request('HEAD', url, **kwargs)
+
+
+def options(url, **kwargs):
+    return _request('OPTIONS', url, **kwargs)
+
+
+def post(url, data=None, **kwargs):
+    if data is not None:
+        kwargs['data'] = data
+    return _request('POST', url, **kwargs)
