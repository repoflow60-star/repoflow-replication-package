--- a/ldnlib/_http.py
+++ b/ldnlib/_http.py
@@ -0,0 +1,115 @@
+import json
+
+import urllib3
+from urllib3.exceptions import HTTPError
+from urllib3.util import make_headers
+
+
+_POOL = urllib3.PoolManager()
+
+
+def _content_type_charset(headers):
+    content_type = headers.get('content-type', '')
+    for part in content_type.split(';')[1:]:
+        part = part.strip()
+        if part.startswith('charset='):
+            return part.split('=', 1)[1].strip().strip('"')
+    return None
+
+
+def _decode_body(data, headers):
+    if data is None:
+        return ''
+    if isinstance(data, str):
+        return data
+
+    charset = _content_type_charset(headers) or 'utf-8'
+    return data.decode(charset, errors='replace')
+
+
+def _parse_links(headers):
+    raw = headers.get('link')
+    if not raw:
+        return {}
+
+    links = {}
+    for item in raw.split(','):
+        part = item.strip()
+        if not part.startswith('<') or '>' not in part:
+            continue
+
+        url, params = part[1:].split('>', 1)
+        link_data = {'url': url}
+        for param in params.split(';'):
+            param = param.strip()
+            if not param or '=' not in param:
+                continue
+            key, value = param.split('=', 1)
+            link_data[key.strip()] = value.strip().strip('"')
+
+        rel = link_data.get('rel')
+        if rel:
+            links[rel] = link_data
+
+    return links
+
+
+class HTTPResponseAdapter(object):
+
+    def __init__(self, response, url):
+        self._response = response
+        self.url = url
+        self.status_code = response.status
+        self.headers = response.headers
+        self.links = _parse_links(self.headers)
+        self.text = _decode_body(response.data, self.headers)
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise HTTPError(
+                f'{self.status_code} {self._response.reason} for url: {self.url}'
+            )
+
+
+class HTTPClient(object):
+
+    def __init__(self, pool=None):
+        self.pool = pool or _POOL
+
+    def request(self, method, target, **kwargs):
+        headers = dict(kwargs.pop('headers', dict()) or {})
+        body = kwargs.pop('body', kwargs.pop('data', None))
+
+        if 'auth' in kwargs:
+            auth = kwargs.pop('auth')
+            if auth is not None:
+                headers.update(make_headers(basic_auth='{}:{}'.format(*auth)))
+
+        if body is None and 'json' in kwargs:
+            body = json.dumps(kwargs.pop('json'))
+
+        redirect = kwargs.pop('allow_redirects', kwargs.pop('redirect', True))
+        response = self.pool.request(
+            method,
+            target,
+            body=body,
+            headers=headers,
+            redirect=redirect,
+            **kwargs
+        )
+        return HTTPResponseAdapter(response, target)
+
+    def head(self, target, **kwargs):
+        return self.request('HEAD', target, **kwargs)
+
+    def get(self, target, **kwargs):
+        return self.request('GET', target, **kwargs)
+
+    def options(self, target, **kwargs):
+        return self.request('OPTIONS', target, **kwargs)
+
+    def post(self, target, **kwargs):
+        return self.request('POST', target, **kwargs)
