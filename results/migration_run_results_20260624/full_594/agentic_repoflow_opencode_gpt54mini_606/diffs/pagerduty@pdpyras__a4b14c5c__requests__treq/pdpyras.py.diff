+@defer.inlineCallbacks
+def _perform_treq_request(method, url, **kwargs):
+    start = time.perf_counter()
+    kwargs.pop('stream', None)
+    allow_redirects = kwargs.pop('allow_redirects', None)
+    kwargs.pop('verify', None)
+    kwargs.pop('cert', None)
+    if allow_redirects is not None and 'browser_like_redirects' not in kwargs:
+        kwargs['browser_like_redirects'] = allow_redirects
+    headers = kwargs.get('headers')
+    if headers is not None:
+        kwargs['headers'] = deepcopy(headers)
+    params = kwargs.pop('params', None)
+    if params:
+        url = _merge_query_params(url, params)
+    json_body = kwargs.pop('json', None)
+    if json_body is not None:
+        kwargs['data'] = json_module.dumps(json_body).encode('utf-8')
+        headers = kwargs.get('headers')
+        if headers is None:
+            headers = {}
+            kwargs['headers'] = headers
+        headers.setdefault('Content-Type', 'application/json')
+    treq_kw = {}
