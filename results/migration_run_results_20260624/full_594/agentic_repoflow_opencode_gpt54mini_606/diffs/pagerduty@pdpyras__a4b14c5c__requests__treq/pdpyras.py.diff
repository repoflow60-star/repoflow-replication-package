+class Response:
+    def __init__(self, status_code=0, headers=None, content=b'', request=None,
+            elapsed=None, encoding=None):
+        self.status_code = status_code
+        self.headers = CaseInsensitiveDict(headers or {})
+        if content is None:
+            content = b''
+        if isinstance(content, str):
+            content = content.encode('utf-8')
+        self._content = content if isinstance(content, bytes) else bytes(content)
+        self.request = request or SimpleNamespace(method='', url='', headers={})
+        self.url = self.request.url
+        self.elapsed = elapsed or timedelta(0)
+        self.encoding = encoding or _response_encoding(self.headers)
+
+    @property
+    def ok(self):
+        return 200 <= self.status_code < 400
+
+    def __bool__(self):
+        return self.ok
+
+    @property
+    def content(self):
+        return self._content
+
+    @property
+    def text(self):
+        return self._content.decode(self.encoding or 'utf-8', errors='replace')
+
+    def json(self):
+        return json_module.loads(self.text)
+
