+_TREQ_REACTOR_THREAD = None
+_TREQ_REACTOR_READY = threading.Event()
+
+
+def _get_reactor():
+    from twisted.internet import reactor
+    return reactor
+
+
+def _ensure_reactor_running():
+    global _TREQ_REACTOR_THREAD
+    reactor = _get_reactor()
+    if reactor.running:
+        return reactor
+    if _TREQ_REACTOR_THREAD is None or not _TREQ_REACTOR_THREAD.is_alive():
+        _TREQ_REACTOR_READY.clear()
+
+        def _run():
+            reactor.callWhenRunning(_TREQ_REACTOR_READY.set)
+            reactor.run(installSignalHandlers=False)
+
+        _TREQ_REACTOR_THREAD = threading.Thread(target=_run, daemon=True)
+        _TREQ_REACTOR_THREAD.start()
+    _TREQ_REACTOR_READY.wait()
+    return reactor
+
