+class _ResponseAdapter:
+    def __init__(self, status_code, text):
+        self.status_code = status_code
+        self.text = text
+
+    @property
+    def ok(self):
+        return 200 <= self.status_code < 400
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise _HTTPError(response=self)
+
+
+def _sanitize_headers(headers, content_type=None):
+    request_headers = {key: value for key, value in headers.items() if value is not None}
+    if content_type:
+        request_headers["Content-Type"] = content_type
+    return request_headers
+
+
+def _append_query_params(url, params):
+    if not params:
+        return url
+    separator = '&' if '?' in url else '?'
+    return f"{url}{separator}{urlencode(params, doseq=True)}"
+
+
+def _response_body_text(response_body):
+    if isinstance(response_body, bytes):
+        return response_body.decode('utf-8', errors='replace')
+    return response_body
+
+
+def _decode_response_body(response_text):
+    try:
+        return json.loads(response_text)
+    except ValueError:
+        return response_text
+
+
+def _parse_response_message(response):
+    try:
+        if hasattr(response, "text"):
+            response = response.text
+        if isinstance(response, bytes):
+            response = response.decode('utf-8', errors='replace')
+        return json.loads(response)['message']
+    except (AttributeError, TypeError, ValueError, KeyError):
+        return None
+
+
+def _ensure_reactor_running():
+    global _REACTOR_THREAD
+
+    with _REACTOR_LOCK:
+        if reactor.running:
+            return
+        if _REACTOR_THREAD is None or not _REACTOR_THREAD.is_alive():
+            _REACTOR_THREAD = threading.Thread(
+                target=reactor.run,
+                kwargs={"installSignalHandlers": False},
+                daemon=True,
+            )
+            _REACTOR_THREAD.start()
+
+    for _ in range(500):
+        if reactor.running:
+            return
+        time.sleep(0.01)
+
+    raise ConnectionUnavailableError(message='Specified server unavailable')
+
+
+def _run_request(method, url, headers, params=None, body=None, files=None):
+    request_url = _append_query_params(url, params)
+    request_headers = _sanitize_headers(headers)
+    request_kwargs = {"headers": request_headers}
+
+    if files is not None:
+        request_kwargs["files"] = files
+    elif body is not None:
+        request_kwargs["data"] = json.dumps(body).encode('utf-8')
+        request_kwargs["headers"] = _sanitize_headers(headers, content_type='application/json')
+
+    @inlineCallbacks
+    def _request():
+        response = yield treq.request(method.upper(), request_url, **request_kwargs)
+        response_body = yield treq.content(response)
+        response_text = _response_body_text(response_body)
+        return _ResponseAdapter(status_code=response.code, text=response_text)
+
+    _ensure_reactor_running()
+    return blockingCallFromThread(reactor, _request)
+
