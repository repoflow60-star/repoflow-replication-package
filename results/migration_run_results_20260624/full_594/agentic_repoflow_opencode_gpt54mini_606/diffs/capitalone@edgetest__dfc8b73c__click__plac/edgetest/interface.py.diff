+def _normalize_multi(value):
+    """Normalize a possibly repeated option into a list."""
+    if value in (None, [], ()):
+        return None
+    if isinstance(value, str):
+        return [value]
+    return list(value)
+
+
+def _parse_cli_args(args):
+    """Parse click-style CLI arguments for the plac-backed entrypoint."""
+    aliases = {
+        "-c": "config",
+        "-r": "requirements",
+        "-e": "environment",
+        "-n": "notest",
+        "-s": "nosetup",
+        "-d": "deps",
+        "-m": "command",
+        "-o": "export",
+    }
+    parsed = {
+        "config": None,
+        "requirements": "requirements.txt",
+        "environment": None,
+        "notest": False,
+        "nosetup": False,
+        "extras": None,
+        "deps": None,
+        "command": "pytest",
+        "export": False,
+    }
+    values = list(args or [])
+    i = 0
+    while i < len(values):
+        arg = values[i]
+        if arg in ("-h", "--help"):
+            raise SystemExit(0)
+        if arg.startswith("--"):
+            name, sep, value = arg[2:].partition("=")
+            if name in {"notest", "nosetup", "export"}:
+                parsed[name] = True
+            else:
+                if not sep:
+                    i += 1
+                    if i >= len(values):
+                        raise SystemExit(2)
+                    value = values[i]
+                if name in {"extras", "deps"}:
+                    if parsed[name] is None:
+                        parsed[name] = [value]
+                    else:
+                        parsed[name].append(value)
+                else:
+                    parsed[name] = value
+        elif arg.startswith("-") and len(arg) > 1:
+            short = arg[:2]
+            name = aliases.get(short)
+            if name is None:
+                raise SystemExit(2)
+            if name in {"notest", "nosetup", "export"}:
+                parsed[name] = True
+            else:
+                value = arg[2:]
+                if value.startswith("="):
+                    value = value[1:]
+                if not value:
+                    i += 1
+                    if i >= len(values):
+                        raise SystemExit(2)
+                    value = values[i]
+                if name == "deps":
+                    if parsed[name] is None:
+                        parsed[name] = [value]
+                    else:
+                        parsed[name].append(value)
+                else:
+                    parsed[name] = value
+        else:
+            raise SystemExit(2)
+        i += 1
+    return parsed
+
+
+def _invoke_cli(args=None, prog_name=None, **_kwargs):
+    """Invoke the command with runner-compatible semantics."""
+    if args is None:
+        raw_args = []
+    elif isinstance(args, str):
+        raw_args = [args]
+    else:
+        raw_args = list(args)
+    parsed = _parse_cli_args(raw_args)
+
+    def _dispatch():
+        return _cli(
+            config=parsed["config"],
+            requirements=parsed["requirements"],
+            environment=parsed["environment"],
+            notest=parsed["notest"],
+            nosetup=parsed["nosetup"],
+            extras=_normalize_multi(parsed["extras"]),
+            deps=_normalize_multi(parsed["deps"]),
+            command=parsed["command"],
+            export=parsed["export"],
+        )
+
+    return plac.call(_dispatch)
+
