+class _HTTPError(Exception):
+    def __init__(self, response):
+        self.response = response
+
+
+class _Response:
+    def __init__(self, status_code, text):
+        self.status_code = status_code
+        self.text = text
+
+    @property
+    def ok(self):
+        return 200 <= int(self.status_code) < 400
+
+    def json(self):
+        return json_module.loads(self.text)
+
+    def raise_for_status(self):
+        if int(self.status_code) >= 400:
+            raise _HTTPError(self)
+
+
+class Session:
+    def __init__(self):
+        self.headers = {}
+        self.verify = True
+        self.cert = None
+
+    @staticmethod
+    def _build_url(url, params=None):
+        if not params:
+            return url
+        filtered_params = [(key, value) for key, value in params.items() if value is not None]
+        if not filtered_params:
+            return url
+        query_string = urlencode(filtered_params, doseq=True)
+        if not query_string:
+            return url
+        separator = "&" if "?" in url else "?"
+        return f"{url}{separator}{query_string}"
+
+    @staticmethod
+    def _merge_headers(session_headers, request_headers=None):
+        merged = {}
+        for source in (session_headers or {}, request_headers or {}):
+            for key, value in source.items():
+                if value is not None:
+                    merged[key] = value
+        return [f"{key}: {value}" for key, value in merged.items()]
+
+    @staticmethod
+    def _build_multipart_body(files):
+        form = []
+        for key, value in (files or {}).items():
+            if isinstance(value, tuple) and len(value) == 2:
+                filename, contents = value
+                if hasattr(contents, "read"):
+                    contents = contents.read()
+                payload = contents if isinstance(contents, bytes) else str(contents).encode("utf-8")
+                form.append((key, (pycurl.FORM_BUFFER, str(filename), pycurl.FORM_BUFFERPTR, payload)))
+            else:
+                payload = value if isinstance(value, bytes) else str(value).encode("utf-8")
+                form.append((key, (pycurl.FORM_BUFFER, key, pycurl.FORM_BUFFERPTR, payload)))
+        return form
+
+    def _apply_ssl_options(self, curl, verify=None, cert=None):
+        ssl_verify = self.verify if verify is None else verify
+        ssl_cert = self.cert if cert is None else cert
+        curl.setopt(pycurl.SSL_VERIFYPEER, 1 if ssl_verify else 0)
+        curl.setopt(pycurl.SSL_VERIFYHOST, 2 if ssl_verify else 0)
+        if ssl_cert:
+            if isinstance(ssl_cert, tuple):
+                cert_file, key_file = ssl_cert
+                curl.setopt(pycurl.SSLCERT, cert_file)
+                curl.setopt(pycurl.SSLKEY, key_file)
+            else:
+                curl.setopt(pycurl.SSLCERT, ssl_cert)
+
+    def _request(self, method, url, params=None, json=None, files=None, headers=None, verify=None, cert=None):
+        response_buffer = io.BytesIO()
+        curl = None
+        try:
+            curl = pycurl.Curl()
+            curl.setopt(pycurl.URL, self._build_url(url, params=params))
+            curl.setopt(pycurl.WRITEFUNCTION, response_buffer.write)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.MAXREDIRS, 5)
+            self._apply_ssl_options(curl, verify=verify, cert=cert)
+
+            request_headers = self._merge_headers(self.headers, headers)
+            if json is not None:
+                payload = json_module.dumps(json).encode("utf-8")
+                if not any(header.lower().startswith("content-type:") for header in request_headers):
+                    request_headers.append("Content-Type: application/json")
+                if method == "PUT":
+                    upload_buffer = io.BytesIO(payload)
+                    curl.setopt(pycurl.UPLOAD, 1)
+                    curl.setopt(pycurl.READFUNCTION, upload_buffer.read)
+                    curl.setopt(pycurl.INFILESIZE, len(payload))
+                else:
+                    curl.setopt(pycurl.POSTFIELDS, payload)
+                    curl.setopt(pycurl.POSTFIELDSIZE, len(payload))
+            elif files is not None:
+                curl.setopt(pycurl.HTTPPOST, self._build_multipart_body(files))
+
+            if method == "GET":
+                pass
+            elif method == "POST":
+                curl.setopt(pycurl.POST, 1)
+            elif method == "PUT":
+                curl.setopt(pycurl.CUSTOMREQUEST, method)
+            else:
+                curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+            if request_headers:
+                curl.setopt(pycurl.HTTPHEADER, request_headers)
+
+            curl.perform()
+            status = curl.getinfo(pycurl.RESPONSE_CODE)
+            text = response_buffer.getvalue().decode("utf-8", errors="replace")
+            return _Response(status, text)
+        except Exception as exc:
+            response = getattr(exc, "response", None)
+            if response is not None:
+                raise ConnectionUnavailableError(
+                    message=self.parse_response_message(response),
+                    status=getattr(response, "status_code", None),
+                    payload=getattr(response, "text", None),
+                ) from None
+            raise ConnectionUnavailableError(message=str(exc)) from None
+        finally:
+            if curl is not None:
+                curl.close()
+
+    def get(self, url, params=None, headers=None, verify=None, cert=None):
+        return self._request("GET", url, params=params, headers=headers, verify=verify, cert=cert)
+
+    def post(self, url, params=None, json=None, headers=None, verify=None, cert=None):
+        return self._request("POST", url, params=params, json=json, headers=headers, verify=verify, cert=cert)
+
+    def put(self, url, params=None, json=None, files=None, headers=None, verify=None, cert=None):
+        return self._request(
+            "PUT",
+            url,
+            params=params,
+            json=json,
+            files=files,
+            headers=headers,
+            verify=verify,
+            cert=cert,
+        )
+
+    def delete(self, url, params=None, headers=None, verify=None, cert=None):
+        return self._request("DELETE", url, params=params, headers=headers, verify=verify, cert=cert)
+
