+class _PycurlResponse(object):
+    def __init__(self, status_code, text, headers):
+        self.status_code = status_code
+        self.text = text
+        self.headers = headers
+
+
+def _parse_response_headers(raw_headers):
+    parsed_headers = {}
+    blocks = [block for block in raw_headers.split("\r\n\r\n") if block.strip()]
+
+    if blocks:
+        for line in blocks[-1].split("\r\n")[1:]:
+            if ":" in line:
+                key, value = line.split(":", 1)
+                parsed_headers[key.strip()] = value.strip()
+
+    return parsed_headers
+
+
+class _RequestsCompat(object):
+    @staticmethod
+    def get(url, timeout=30, **options):
+        response_body = io.BytesIO()
+        response_headers = io.BytesIO()
+        curl = pycurl.Curl()
+
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEDATA, response_body)
+            curl.setopt(pycurl.HEADERFUNCTION, response_headers.write)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.HTTPGET, 1)
+            curl.setopt(pycurl.ACCEPT_ENCODING, "")
+            curl.setopt(pycurl.TIMEOUT, timeout)
+
+            headers = options.get("headers") or {}
+            header_items = [
+                f"{key}: {value}" for key, value in headers.items() if value is not None
+            ]
+            if header_items:
+                curl.setopt(pycurl.HTTPHEADER, header_items)
+
+            proxy = options.get("proxy")
+            if not proxy:
+                proxies = options.get("proxies") or {}
+                proxy = proxies.get("https") or proxies.get("http")
+            if proxy:
+                curl.setopt(pycurl.PROXY, proxy)
+
+            verify = options.get("verify")
+            if verify is None:
+                verify = options.get("verify_ssl", True)
+            curl.setopt(pycurl.SSL_VERIFYPEER, 1 if verify else 0)
+            curl.setopt(pycurl.SSL_VERIFYHOST, 2 if verify else 0)
+
+            curl.perform()
+
+            return _PycurlResponse(
+                curl.getinfo(pycurl.RESPONSE_CODE),
+                response_body.getvalue().decode(),
+                _parse_response_headers(
+                    response_headers.getvalue().decode("iso-8859-1")
+                ),
+            )
+        finally:
+            curl.close()
+
+
+requests = _RequestsCompat()
 
 
