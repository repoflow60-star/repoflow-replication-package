--- a/src/coguard_cli/pycurl_client.py
+++ b/src/coguard_cli/pycurl_client.py
@@ -0,0 +1,105 @@
+"""
+Minimal HTTP client wrapper backed by pycurl.
+"""
+
+from __future__ import annotations
+
+import io
+import json as json_module
+from http.client import responses as http_responses
+from typing import Any, Dict, Iterable, Optional
+from urllib.parse import urlencode
+
+import pycurl
+
+
+class Response:
+    def __init__(self, status_code: int, body: bytes, headers: Optional[Dict[str, str]] = None):
+        self.status_code = status_code
+        self.content = body
+        self.text = body.decode("utf-8", errors="replace")
+        self.reason = http_responses.get(status_code, "")
+        self.headers = headers or {}
+
+    def json(self):
+        return json_module.loads(self.text)
+
+    def iter_content(self, chunk_size: int = 8192):
+        for offset in range(0, len(self.content), chunk_size):
+            yield self.content[offset:offset + chunk_size]
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise Exception(f"{self.status_code} {self.reason}".strip())
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        return False
+
+
+def _normalize_headers(headers: Optional[Dict[str, str]], has_body: bool, is_json: bool) -> Dict[str, str]:
+    normalized = dict(headers or {})
+    has_content_type = any(key.lower() == "content-type" for key in normalized)
+    if not has_content_type:
+        if is_json:
+            normalized["Content-Type"] = "application/json"
+        elif has_body:
+            normalized["Content-Type"] = "application/x-www-form-urlencoded"
+    return normalized
+
+
+def _encode_body(data: Any = None, json_body: Any = None):
+    if json_body is not None:
+        return json_module.dumps(json_body).encode("utf-8"), True
+    if data is None:
+        return None, False
+    if isinstance(data, (bytes, bytearray)):
+        return bytes(data), False
+    if isinstance(data, str):
+        return data.encode("utf-8"), False
+    if isinstance(data, dict):
+        return urlencode(data, doseq=True).encode("utf-8"), False
+    return str(data).encode("utf-8"), False
+
+
+def request(
+        method: str,
+        url: str,
+        headers: Optional[Dict[str, str]] = None,
+        data: Any = None,
+        json_body: Any = None,
+        timeout: Optional[float] = None,
+        stream: bool = False,
+        json: Any = None):
+    body, is_json = _encode_body(data=data, json_body=json_body if json_body is not None else json)
+    normalized_headers = _normalize_headers(headers, body is not None, is_json)
+
+    buffer = io.BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.NOSIGNAL, 1)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.WRITEFUNCTION, buffer.write)
+        curl.setopt(pycurl.HEADER, False)
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT, timeout)
+        if normalized_headers:
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                [f"{key}: {value}" for key, value in normalized_headers.items()]
+            )
+
+        method_upper = method.upper()
+        if method_upper != "GET":
+            curl.setopt(pycurl.CUSTOMREQUEST, method_upper)
+        if body is not None:
+            curl.setopt(pycurl.POSTFIELDS, body)
+
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        return Response(status_code, buffer.getvalue())
+    finally:
+        curl.close()
