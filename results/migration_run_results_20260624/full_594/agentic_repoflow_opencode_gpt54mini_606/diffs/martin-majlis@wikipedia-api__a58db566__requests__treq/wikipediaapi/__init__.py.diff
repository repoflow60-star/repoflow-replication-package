+class _SessionState:
+    def __init__(self, headers: dict[str, Any]) -> None:
+        self.headers = headers
+
+    def close(self) -> None:
+        pass
+
+
+_REACTOR_READY = threading.Event()
+_REACTOR_LOCK = threading.Lock()
+_REACTOR_THREAD_STARTED = False
+
+
+def _run_reactor() -> None:
+    reactor.callWhenRunning(_REACTOR_READY.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor_running() -> None:
+    global _REACTOR_THREAD_STARTED
+
+    if reactor.running or _REACTOR_READY.is_set():
+        return
+
+    with _REACTOR_LOCK:
+        if not _REACTOR_THREAD_STARTED and not reactor.running:
+            _REACTOR_THREAD_STARTED = True
+            threading.Thread(target=_run_reactor, daemon=True).start()
+
+    _REACTOR_READY.wait()
 
 
