+class _Session:
+    def __init__(self) -> None:
+        self._pool = urllib3.PoolManager()
+        self.headers = {}
+        self.cookies = {}
+
+    def _request(self, method: str, url: str, **kwargs) -> _Response:
+        headers = dict(self.headers)
+        extra_headers = kwargs.pop("headers", None)
+        if extra_headers:
+            headers.update(extra_headers)
+
+        if self.cookies and "Cookie" not in headers:
+            headers["Cookie"] = "; ".join(
+                f"{key}={value}" for key, value in self.cookies.items()
+            )
+
+        params = kwargs.pop("params", None)
+        if params:
+            query = urlencode(params, doseq=True)
+            url = f"{url}{'&' if '?' in url else '?'}{query}"
+
+        json_payload = kwargs.pop("json", None)
+        body = kwargs.pop("body", None)
+        data = kwargs.pop("data", None)
+        if body is None:
+            body = data
+        if isinstance(body, str):
+            body = body.encode("utf-8")
+        elif isinstance(body, dict):
+            body = urlencode(body, doseq=True).encode("utf-8")
+            headers.setdefault("Content-Type", "application/x-www-form-urlencoded")
+        elif isinstance(body, (list, tuple)):
+            body = urlencode(body, doseq=True).encode("utf-8")
+            headers.setdefault("Content-Type", "application/x-www-form-urlencoded")
+        if json_payload is not None:
+            body = json.dumps(json_payload).encode("utf-8")
+            headers.setdefault("Content-Type", "application/json")
+
+        response = self._pool.request(method, url, body=body, headers=headers)
+        return _Response(response)
+
+    def request(self, method: str, url: str, **kwargs) -> _Response:
+        return self._request(method, url, **kwargs)
+
+    def get(self, url: str, **kwargs) -> _Response:
+        return self._request("GET", url, **kwargs)
+
+    def post(self, url: str, **kwargs) -> _Response:
+        return self._request("POST", url, **kwargs)
+
