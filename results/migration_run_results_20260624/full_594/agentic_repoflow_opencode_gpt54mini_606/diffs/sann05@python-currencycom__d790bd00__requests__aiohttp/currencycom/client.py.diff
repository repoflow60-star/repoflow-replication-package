+            headers=headers,
+        ) as response:
+            return await response.json(content_type=None)
+
+
+def _request_json_sync(method, url, *, params=None, headers=None):
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(_request_json(method, url, params=params, headers=headers))
+
+    result = {}
+    error = {}
+
+    def _runner():
+        try:
+            result['value'] = asyncio.run(
+                _request_json(method, url, params=params, headers=headers)
+            )
+        except Exception as exc:  # pragma: no cover - surfaced to caller
+            error['exc'] = exc
+
+    thread = Thread(target=_runner)
+    thread.start()
+    thread.join()
+
+    if error:
+        raise error['exc']
+
+    return result['value']
 
 
