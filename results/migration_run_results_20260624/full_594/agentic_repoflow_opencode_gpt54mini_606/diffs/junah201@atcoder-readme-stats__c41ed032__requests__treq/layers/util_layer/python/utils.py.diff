+_reactor_ready = threading.Event()
+_reactor_thread_started = False
+_reactor_lock = threading.Lock()
+
+
+# treq is async, so keep a dedicated reactor thread and bridge back synchronously.
+def _ensure_reactor_running() -> None:
+    global _reactor_thread_started
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if _reactor_thread_started:
+            return
+
+        def _run_reactor():
+            reactor.callWhenRunning(_reactor_ready.set)
+            reactor.run(installSignalHandlers=False)
+
+        thread = threading.Thread(target=_run_reactor, daemon=True)
+        thread.start()
+        _reactor_thread_started = True
+
+    if not _reactor_ready.wait(timeout=5):
+        raise RuntimeError("Twisted reactor failed to start")
+
+
+async def _fetch_user_page(url: str) -> str:
+    response = await treq.get(url)
+    return await treq.text_content(response)
+
+
+def _get_user_page(url: str) -> str:
+    _ensure_reactor_running()
+    return threads.blockingCallFromThread(
+        reactor, lambda: defer.ensureDeferred(_fetch_user_page(url))
+    )
+
