+class _RequestsCompat:
+    """Compatibility surface for existing module consumers."""
+
+    Session = _AiohttpSession
+
+    def request(
+        self,
+        method: str,
+        url: str,
+        params: Optional[Dict[str, Any]] = None,
+        data: Optional[Dict[str, Any]] = None,
+        json: Optional[Dict[str, Any]] = None,
+        timeout: int = 30,
+        headers: Optional[Dict[str, str]] = None,
+    ) -> _AiohttpResponse:
+        session = _AiohttpSession(headers=headers)
+        try:
+            return session.request(method, url, params=params, data=data, json=json, timeout=timeout)
+        finally:
