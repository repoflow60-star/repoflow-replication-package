+class _AiohttpResponse:
+    """Small response wrapper with the methods this module uses."""
+
+    def __init__(self, payload: Any, status: int):
+        self._payload = payload
+        self.status_code = status
+
+    def json(self) -> Any:
+        return self._payload
+
+    def raise_for_status(self) -> None:
+        if 400 <= self.status_code < 600:
+            raise Exception(f"{self.status_code} HTTP Error")
+
+
+class _AiohttpSession:
+    """Synchronous facade around aiohttp.ClientSession."""
+
+    def __init__(self, headers: Optional[Dict[str, str]] = None):
+        self._loop = asyncio.new_event_loop()
+        self.headers = dict(headers or {})
+        self._session = self._loop.run_until_complete(self._create_session())
+
+    async def _create_session(self) -> aiohttp.ClientSession:
+        return aiohttp.ClientSession()
+
+    def request(
+        self,
+        method: str,
+        url: str,
+        params: Optional[Dict[str, Any]] = None,
+        data: Optional[Dict[str, Any]] = None,
+        json: Optional[Dict[str, Any]] = None,
+        timeout: int = 30,
+    ) -> _AiohttpResponse:
+        return self._loop.run_until_complete(
+            self._request(method, url, params=params, data=data, json=json, timeout=timeout)
+        )
+
+    def get(
+        self,
+        url: str,
+        params: Optional[Dict[str, Any]] = None,
+        data: Optional[Dict[str, Any]] = None,
+        json: Optional[Dict[str, Any]] = None,
+        timeout: int = 30,
+    ) -> _AiohttpResponse:
+        return self.request("get", url, params=params, data=data, json=json, timeout=timeout)
+
+    def post(
+        self,
+        url: str,
+        params: Optional[Dict[str, Any]] = None,
+        data: Optional[Dict[str, Any]] = None,
+        json: Optional[Dict[str, Any]] = None,
+        timeout: int = 30,
+    ) -> _AiohttpResponse:
+        return self.request("post", url, params=params, data=data, json=json, timeout=timeout)
+
+    async def _request(
+        self,
+        method: str,
+        url: str,
+        params: Optional[Dict[str, Any]] = None,
+        data: Optional[Dict[str, Any]] = None,
+        json: Optional[Dict[str, Any]] = None,
+        timeout: int = 30,
+    ) -> _AiohttpResponse:
+        timeout_obj = aiohttp.ClientTimeout(total=timeout)
+        async with self._session.request(
+            method.upper(),
+            url,
+            params=params,
+            data=data,
+            json=json,
+            headers=self.headers or None,
+            timeout=timeout_obj,
+        ) as resp:
+            return _AiohttpResponse(await resp.json(content_type=None), resp.status)
+
+    def close(self) -> None:
+        if self._loop.is_closed():
+            return
+        if not self._session.closed:
+            self._loop.run_until_complete(self._close())
+        self._loop.close()
+
+    async def _close(self) -> None:
+        await self._session.close()
+
