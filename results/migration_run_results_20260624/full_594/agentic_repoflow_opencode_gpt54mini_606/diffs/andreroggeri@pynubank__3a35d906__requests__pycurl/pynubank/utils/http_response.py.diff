--- a/pynubank/utils/http_response.py
+++ b/pynubank/utils/http_response.py
@@ -0,0 +1,16 @@
+import json
+
+
+class Response:
+    def __init__(self, url: str = '', status_code: int = 200, headers=None, content: bytes = b''):
+        self.url = url
+        self.status_code = status_code
+        self.headers = {} if headers is None else headers
+        self.content = content
+
+    @property
+    def text(self) -> str:
+        return self.content.decode('utf-8', errors='replace')
+
+    def json(self):
+        return json.loads(self.text or '{}')
