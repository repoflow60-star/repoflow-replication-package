+        return bytes(encrypted)
+
+
+def _decrypt_tdes_cbc(key: bytes, iv: bytes, data: bytes) -> bytes:
+    if len(key) == 8:
+        return _DES.new(key, _DES.MODE_CBC, iv=iv).decrypt(data)
