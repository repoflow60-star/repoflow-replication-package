+def _merge_query_params(url, params):
+    if not params:
+        return url
+    parts = list(urlsplit(url))
+    current = dict(parse_qsl(parts[3], keep_blank_values=True))
+    current.update(params)
+    parts[3] = urlencode(current, doseq=True)
+    return urlunsplit(parts)
