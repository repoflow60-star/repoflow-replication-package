+class _PycurlSession(object):
+    def _request(self, url, data=None, headers=None, verify=True):
+        body = io.BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEDATA, body)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            if verify:
+                curl.setopt(pycurl.SSL_VERIFYPEER, 1)
+                curl.setopt(pycurl.SSL_VERIFYHOST, 2)
+            else:
+                curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+                curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+            if headers:
+                curl.setopt(pycurl.HTTPHEADER, [
+                    '%s: %s' % (key, value) for key, value in headers.items()
+                ])
+            if data is not None:
+                if not isinstance(data, bytes):
+                    data = data.encode('utf-8')
+                curl.setopt(pycurl.POST, 1)
+                curl.setopt(pycurl.POSTFIELDS, data)
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            content = body.getvalue()
+            return _PycurlResponse(content, status_code)
+        finally:
+            curl.close()
+
+    def get(self, url, params=None, stream=False, verify=True, headers=None, **kwargs):
+        if params:
+            query = urllib_parse.urlencode(params, doseq=True)
+            url = ''.join([url, '?', query])
+        return self._request(url, headers=headers, verify=verify)
+
+    def post(self, url, data=None, params=None, headers=None, verify=True, **kwargs):
+        if params:
+            query = urllib_parse.urlencode(params, doseq=True)
+            url = ''.join([url, '?', query])
