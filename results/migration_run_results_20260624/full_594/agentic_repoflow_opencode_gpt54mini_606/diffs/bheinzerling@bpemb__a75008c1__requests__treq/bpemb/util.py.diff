+
+def _get_download_reactor():
+    global _download_reactor
+    with _download_reactor_lock:
+        if _download_reactor is None:
+            from twisted.internet import selectreactor
+
+            reactor = selectreactor.SelectReactor()
+            started = threading.Event()
+
+            def _run():
+                started.set()
+                reactor.run(installSignalHandlers=False)
+
+            thread = threading.Thread(target=_run, daemon=True)
+            thread.start()
+            started.wait()
+            while not reactor.running:
+                threading.Event().wait(0.01)
+            _download_reactor = reactor
+    return _download_reactor
 
 
