 RequestVerb = Literal["get", "post", "put", "patch", "delete"]
 
 T = TypeVar("T")
+
+_REACTOR_READY = Event()
+_REACTOR_THREAD: Union[Thread, None] = None
+
+
+class _Response:
+    def __init__(self, status_code: int, headers: Dict[str, Any], text: str):
+        self.status_code = status_code
+        self.headers = headers
+        self.text = text
+
+    def json(self) -> Any:
+        return json.loads(self.text)
+
+
+def _normalize_header_name(name: Any) -> str:
+    if isinstance(name, bytes):
+        return name.decode("latin-1")
+    return str(name)
+
+
+def _normalize_header_value(value: Any) -> str:
+    if isinstance(value, bytes):
+        return value.decode("latin-1")
+    return str(value)
+
+
+def _start_reactor() -> None:
+    reactor.callWhenRunning(_REACTOR_READY.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor() -> None:
+    global _REACTOR_THREAD
+
+    if reactor.running:
+        _REACTOR_READY.set()
+        return
+
+    if _REACTOR_THREAD is None:
+        _REACTOR_THREAD = Thread(target=_start_reactor, daemon=True)
+        _REACTOR_THREAD.start()
+
+    _REACTOR_READY.wait()
+
+
+async def _make_request(
+    url: str,
+    verb: RequestVerb,
+    params: Union[Dict[Any, Any], List[Dict[Any, Any]]],
+    headers: Dict[Any, Any],
+) -> _Response:
+    response = await treq.request(
+        verb.upper(),
+        url,
+        data=json.dumps(params).encode("utf-8"),
+        headers=headers,
+    )
+    body = await treq.content(response)
+    response_headers = {
+        _normalize_header_name(name): _normalize_header_value(values[0])
+        for name, values in response.headers.getAllRawHeaders()
+        if values
+    }
+    return _Response(
+        status_code=response.code,
+        headers=response_headers,
+        text=body.decode("utf-8"),
+    )
 
 
