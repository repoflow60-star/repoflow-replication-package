+async def _read_response(response, url):
+    try:
+        status = getattr(response, 'status', None)
+        if status is None:
+            status = response.status_code
+
+        headers = response.headers
+        content_type = headers.get('Content-Type') or headers.get('content-type', '')
+
+        if content_type and 'application/json' in content_type:
+            data = await _maybe_await(getattr(response, 'json'))
+        else:
+            data = await _maybe_await(getattr(response, 'text'))
+    except Exception as e:
+        raise ConnectionError(f"Error occurred while getting response from url {url}: {e}")
+
+    return HTTPResponse(status, headers, data)
+
+
+async def _maybe_await(value):
+    if callable(value):
+        value = value()
+
+    if inspect.isawaitable(value):
+        return await value
+
+    return value
