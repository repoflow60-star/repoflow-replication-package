+_reactor_started = Event()
+_reactor_lock = Lock()
+
+
+def _ensure_reactor_running():
+    if reactor.running or _reactor_started.is_set():
+        return
+
+    with _reactor_lock:
+        if reactor.running or _reactor_started.is_set():
+            return
+
+        def _run():
+            reactor.callWhenRunning(_reactor_started.set)
+            reactor.run(installSignalHandlers=False)
+
+        Thread(target=_run, daemon=True).start()
+
+    _reactor_started.wait()
+
+
+class _Response(object):
+    def __init__(self, code, content, reason='', checker=None):
+        self.code = code
+        if content is None:
+            content = b''
+        if isinstance(content, str):
+            content = content.encode('utf-8')
+        self.content = content
+        self.reason = reason
+        self._checker = checker
+
+    def raise_for_status(self):
+        if self._checker is not None:
+            self._checker()
+            return
+        if self.code >= 400:
+            raise Exception(self.reason or 'HTTP {}'.format(self.code))
+
+
+class _Session(object):
+    def __init__(self):
