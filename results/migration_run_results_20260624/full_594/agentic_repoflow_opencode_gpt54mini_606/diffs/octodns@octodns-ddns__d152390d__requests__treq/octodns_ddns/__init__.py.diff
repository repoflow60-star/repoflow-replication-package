+                    if isinstance(reason, bytes):
+                        reason = reason.decode('utf-8')
+                    return _Response(
+                        getattr(resp, 'code', 200),
+                        content,
+                        reason,
+                        checker,
+                    )
+
+                return defer.maybeDeferred(treq.content, resp).addCallback(
