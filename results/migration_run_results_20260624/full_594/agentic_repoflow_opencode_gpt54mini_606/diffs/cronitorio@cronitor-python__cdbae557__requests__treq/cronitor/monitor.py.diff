+def _wait_for_deferred(deferred, timeout=None):
+    done = threading.Event()
+    outcome = {}
+
+    def _success(value):
+        outcome['value'] = value
+        done.set()
+        return value
+
+    def _failure(error):
+        outcome['error'] = error.value if hasattr(error, 'value') else error
+        done.set()
+        return error
+
+    deferred.addCallbacks(_success, _failure)
+    if not done.wait(timeout):
+        deferred.cancel()
+        raise TimeoutError('request timed out')
+
+    if 'error' in outcome:
+        raise outcome['error']
+
+    return outcome.get('value')
+
