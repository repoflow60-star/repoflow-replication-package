+def canonical_header_dict(headers) -> dict:
+    """Return a plain dict with the header names used by the public API."""
+    normalized = {}
+    for key, value in dict(headers).items():
+        lowered = key.lower()
+        if lowered == 'accept':
+            normalized['Accept'] = value
+        elif lowered == 'authorization':
+            normalized['Authorization'] = value
+        elif lowered == 'content-type':
+            normalized['Content-Type'] = value
+        elif lowered == 'from':
+            normalized['From'] = value
+        elif lowered == 'user-agent':
+            normalized['User-Agent'] = value
+        else:
+            normalized[key] = value
+    return normalized
 
