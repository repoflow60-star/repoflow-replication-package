+import treq
+from twisted.internet import reactor, threads
+
 logger = logging.getLogger(__name__)
 
 _DEFAULT_TIME = datetime.min
+_REACTOR_THREAD = None
+_REACTOR_STARTED = threading.Event()
+_REACTOR_LOCK = threading.Lock()
+
+
+def _run_reactor() -> None:
+    reactor.callWhenRunning(_REACTOR_STARTED.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor_running() -> None:
+    global _REACTOR_THREAD
+
+    if reactor.running:
+        _REACTOR_STARTED.set()
+        return
+
+    with _REACTOR_LOCK:
+        if reactor.running:
+            _REACTOR_STARTED.set()
+            return
+        if _REACTOR_THREAD is None:
+            _REACTOR_STARTED.clear()
+            _REACTOR_THREAD = threading.Thread(
+                target=_run_reactor,
+                daemon=True,
+                name="arxiv-treq-reactor",
+            )
+            _REACTOR_THREAD.start()
+
+    _REACTOR_STARTED.wait()
+
+
+def _treq_get(url: str):
+    _ensure_reactor_running()
+
+    try:
+        return threads.blockingCallFromThread(
+            reactor,
+            treq.get,
+            url,
+            headers={"user-agent": "arxiv.py/2.1.3"},
+        )
+    except Exception as exc:
+        raise ConnectionError(str(exc)) from exc
+
+
+def _treq_content(resp) -> bytes:
+    _ensure_reactor_running()
+
+    try:
+        return threads.blockingCallFromThread(reactor, treq.content, resp)
+    except Exception as exc:
+        raise ConnectionError(str(exc)) from exc
 
 
