-import requests
+import io
+from urllib.parse import quote, urlencode
+
+import pycurl
 from nyaapy import torrent
 from nyaapy.parser import parse_nyaa, parse_single, parse_nyaa_rss
+
+
+def _fetch(url: str) -> bytes:
+    buffer = io.BytesIO()
+    curl = pycurl.Curl()
+    status_code = 0
+
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEDATA, buffer)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.ACCEPT_ENCODING, "")
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+
+    if status_code >= 400:
+        raise RuntimeError(f"HTTP {status_code} for {url}")
+
+    return buffer.getvalue()
+
+
+def _build_search_uri(
+    base_url: str,
+    keyword: str,
+    user,
+    category: int,
+    subcategory: int,
+    filters: int,
+    page: int,
+    sorting: str,
+    order: str,
+) -> str:
+    user_uri = f"user/{quote(user, safe='')}" if user else ""
+    path = f"{base_url}/{user_uri}" if user_uri else f"{base_url}/"
+
+    params = {
+        "f": filters,
+        "c": f"{category}_{subcategory}",
+        "q": keyword,
+        "s": sorting,
+        "o": order,
+    }
+
+    if page > 0:
+        params["p"] = page
+
+    if not user:
+        params["page"] = "rss"
+
+    return f"{path}?{urlencode(params, quote_via=quote)}"
 
 
