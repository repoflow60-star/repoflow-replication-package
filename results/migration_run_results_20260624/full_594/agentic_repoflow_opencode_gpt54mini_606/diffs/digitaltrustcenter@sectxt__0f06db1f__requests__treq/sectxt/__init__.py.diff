+            "Gecko/20100101 Firefox/12.0"
+        )
+    }
+    response = _call_treq(treq.get, url, headers=headers, timeout=5, verify=verify)
+    content = _call_treq(treq.content, response)
+    return _FetchedResponse(response, content, url)
 
 
