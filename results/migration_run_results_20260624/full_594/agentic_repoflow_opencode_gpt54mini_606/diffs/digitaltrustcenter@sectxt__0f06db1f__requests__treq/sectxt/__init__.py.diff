+_REACTOR_THREAD_STARTED = threading.Event()
+_REACTOR_THREAD_LOCK = threading.Lock()
+_TREQ = None
+_REACTOR = None
+_BLOCKING_CALL_FROM_THREAD = None
+
+
+def _load_treq_runtime():
+    global _TREQ, _REACTOR, _BLOCKING_CALL_FROM_THREAD
+    if _TREQ is None:
+        import treq as _treq
+        from twisted.internet import reactor as _reactor
+        from twisted.internet.threads import blockingCallFromThread as _blockingCallFromThread
+
+        _TREQ = _treq
+        _REACTOR = _reactor
+        _BLOCKING_CALL_FROM_THREAD = _blockingCallFromThread
+    return _TREQ, _REACTOR, _BLOCKING_CALL_FROM_THREAD
+
+
+def _ensure_reactor_thread() -> None:
+    _, reactor, _ = _load_treq_runtime()
+    if reactor.running:
+        _REACTOR_THREAD_STARTED.set()
+        return
+    with _REACTOR_THREAD_LOCK:
+        if reactor.running:
+            _REACTOR_THREAD_STARTED.set()
+            return
+        if not _REACTOR_THREAD_STARTED.is_set():
+            def _run_reactor() -> None:
+                reactor.callWhenRunning(_REACTOR_THREAD_STARTED.set)
+                reactor.run(installSignalHandlers=False)
+
+            thread = threading.Thread(target=_run_reactor, daemon=True)
+            thread.start()
+    _REACTOR_THREAD_STARTED.wait()
+
+
+def _call_treq(func, *args, **kwargs):
+    _, reactor, blockingCallFromThread = _load_treq_runtime()
+    _ensure_reactor_thread()
+    return blockingCallFromThread(reactor, func, *args, **kwargs)
+
+
+def _normalize_headers(headers) -> dict:
+    normalized = {}
+    if headers is None:
+        return normalized
+    if hasattr(headers, "getAllRawHeaders"):
+        for name, values in headers.getAllRawHeaders() or []:
+            if not values:
+                continue
+            header_name = name.decode("latin-1") if isinstance(name, bytes) else str(name)
+            header_value = values[0]
+            normalized[header_name.lower()] = (
+                header_value.decode("latin-1") if isinstance(header_value, bytes) else str(header_value)
+            )
+        return normalized
+    for name, value in headers.items():
+        header_name = name.decode("latin-1") if isinstance(name, bytes) else str(name)
+        if isinstance(value, (list, tuple)):
+            value = value[0] if value else ""
+        normalized[header_name.lower()] = value.decode("latin-1") if isinstance(value, bytes) else str(value)
+    return normalized
+
+
+def _response_url(response, fallback_url: str) -> str:
+    url = getattr(response, "url", None)
+    if url:
+        return url
+    request = getattr(response, "request", None)
+    if request is not None:
+        request_url = getattr(request, "absoluteURI", None)
+        if request_url:
+            return request_url.decode("ascii") if isinstance(request_url, bytes) else str(request_url)
+        request_uri = getattr(request, "uri", None)
+        if request_uri:
+            return request_uri.decode("ascii") if isinstance(request_uri, bytes) else str(request_uri)
+    return fallback_url
+
+
+def _response_history(response):
+    history = getattr(response, "history", None)
+    if history is not None:
+        return [_HistoryEntry(item) for item in history]
+    previous = getattr(response, "previous_response", None)
+    if previous is None:
+        previous = getattr(response, "previousResponse", None)
+    if previous is None:
+        return []
+    chain = []
+    while previous is not None:
+        chain.insert(0, _HistoryEntry(previous))
+        previous = getattr(previous, "previous_response", None)
+        if previous is None:
+            previous = getattr(previous, "previousResponse", None)
+    return chain
+
+
+def _is_ssl_error(exc: Exception) -> bool:
+    name = exc.__class__.__name__.lower()
+    module = exc.__class__.__module__.lower()
+    message = str(exc).lower()
+    return (
+        "ssl" in name
+        or "ssl" in module
+        or "cert" in name
+        or "cert" in module
+        or "certificate" in message
+        or "ssl" in message
+    )
+
+
+class _FetchedResponse:
+    def __init__(self, response, content: bytes, fallback_url: str):
+        self._response = response
+        self.status_code = getattr(response, "status_code", getattr(response, "code", None))
+        self.history = _response_history(response)
+        self.url = _response_url(response, fallback_url)
+        self.headers = _normalize_headers(getattr(response, "headers", None))
+        self.content = content
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
+
+class _HistoryEntry:
+    def __init__(self, response):
+        self._response = response
+        self.url = _response_url(response, "")
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
+
+def _fetch_url(url: str, verify: bool = True) -> _FetchedResponse:
+    treq, _, _ = _load_treq_runtime()
+    headers = {
