+class _FetchedResponse:
+    def __init__(
+        self,
+        url: str,
+        status_code: int,
+        headers: Dict[str, str],
+        content: bytes,
+        history: List[SimpleNamespace],
+    ):
+        self.url = url
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+        self.history = history
+
+
+def _parse_curl_headers(raw_headers: bytes) -> Dict[str, str]:
+    headers: Dict[str, str] = {}
+    for block in raw_headers.decode("iso-8859-1").split("\r\n\r\n"):
+        if not block.strip():
+            continue
+        block_headers: Dict[str, str] = {}
+        for line in block.split("\r\n")[1:]:
+            if ":" not in line:
+                continue
+            key, value = line.split(":", 1)
+            block_headers[key.strip().lower()] = value.strip()
+        if block_headers:
+            headers = block_headers
+    return headers
+
+
+def _fetch_url(url: str, insecure: bool = False) -> _FetchedResponse:
+    body = io.BytesIO()
+    header_buffer = io.BytesIO()
+    curl = pycurl.Curl()
+    status_code = 0
+    effective_url = url
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.USERAGENT, _USER_AGENT)
+        curl.setopt(pycurl.TIMEOUT, 5)
+        curl.setopt(pycurl.CONNECTTIMEOUT, 5)
+        curl.setopt(pycurl.NOSIGNAL, 1)
+        curl.setopt(pycurl.ACCEPT_ENCODING, "")
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.MAXREDIRS, 10)
+        curl.setopt(pycurl.FAILONERROR, 0)
+        if _HTTP_VERSION_1_1 is not None:
+            curl.setopt(pycurl.HTTP_VERSION, _HTTP_VERSION_1_1)
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, header_buffer.write)
+        if insecure:
+            curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+            curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+        curl.perform()
+        status_code = int(curl.getinfo(pycurl.RESPONSE_CODE))
+        effective_url = curl.getinfo(pycurl.EFFECTIVE_URL) or url
+    finally:
+        curl.close()
+
+    if isinstance(effective_url, bytes):
+        effective_url = effective_url.decode("utf-8", errors="replace")
+
+    history: List[SimpleNamespace] = []
+    if effective_url != url:
+        history = [SimpleNamespace(url=url)]
+
+    return _FetchedResponse(
+        effective_url,
+        status_code,
+        _parse_curl_headers(header_buffer.getvalue()),
+        body.getvalue(),
+        history,
+    )
 
 
