+def _resolve_ref(schema, defs):
+    ref = schema["$ref"]
+    if not ref.startswith("#/defs/"):
+        raise ValueError(f"Unsupported schema reference: {ref}")
+    return defs[ref[len("#/defs/"):]]
+
+
+def _cerberus_regex(pattern):
+    return f"^(?:{pattern})$"
+
+
+def _schema_is_object_like(schema, defs):
+    if "$ref" in schema:
+        return _schema_is_object_like(_resolve_ref(schema, defs), defs)
+
+    if schema.get("type") == "object":
+        return True
+
+    return any(key in schema for key in ("properties", "patternProperties", "additionalProperties"))
+
+
+def _schema_allows_null(schema, defs):
+    if "$ref" in schema:
+        return _schema_allows_null(_resolve_ref(schema, defs), defs)
+
+    if schema.get("type") == "null":
+        return True
+
+    if None in schema.get("enum", []):
+        return True
+
+    for key in ("oneOf", "anyOf"):
+        if key in schema and any(_schema_allows_null(option, defs) for option in schema[key]):
+            return True
+
+    return False
+
+
+def _translate_schema(schema, defs):
+    if "$ref" in schema:
+        return _translate_schema(_resolve_ref(schema, defs), defs)
+
+    if "oneOf" in schema:
+        rule = {"oneof": [_translate_schema(option, defs) for option in schema["oneOf"]]}
+        if _schema_allows_null(schema, defs):
+            rule["nullable"] = True
+        return rule
+
+    if "anyOf" in schema:
+        rule = {"anyof": [_translate_schema(option, defs) for option in schema["anyOf"]]}
+        if _schema_allows_null(schema, defs):
+            rule["nullable"] = True
+        return rule
+
+    if "enum" in schema:
+        rule = {"allowed": list(schema["enum"])}
+        if None in schema["enum"]:
+            rule["nullable"] = True
+        return rule
+
+    schema_type = schema.get("type")
+
+    if schema_type == "object" or _schema_is_object_like(schema, defs):
+        rule = {"type": "dict"}
+
+        properties = schema.get("properties", {})
+        if properties:
+            required = set(schema.get("required", []))
+            rule["schema"] = {
+                name: {
