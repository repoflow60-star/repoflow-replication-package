+            rule["keysrules"] = {"type": "string", "regex": _cerberus_regex(pattern)}
+            rule["valuesrules"] = _translate_schema(subschema, defs)
+
+        additional_properties = schema.get("additionalProperties")
+        if pattern_properties:
+            rule["allow_unknown"] = True
+        elif additional_properties is False:
+            rule["allow_unknown"] = False
+        elif isinstance(additional_properties, dict):
+            rule["allow_unknown"] = _translate_schema(additional_properties, defs)
+
+        if schema_type is None or _schema_allows_null(schema, defs):
+            rule["nullable"] = True
+
+        return rule
+
+    if schema_type == "array":
+        rule = {"type": "list"}
+        if "items" in schema:
