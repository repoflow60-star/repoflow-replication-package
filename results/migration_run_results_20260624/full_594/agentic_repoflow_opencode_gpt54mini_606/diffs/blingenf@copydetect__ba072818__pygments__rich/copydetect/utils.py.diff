+def _get_rich_lexer(code, filename, language=None):
+    if language is not None:
+        syntax = Syntax(code, language)
+    else:
+        syntax = None
+        from_path = getattr(Syntax, "from_path", None)
+        if callable(from_path):
+            try:
+                syntax = from_path(filename)
+            except Exception:
+                syntax = None
+        if syntax is None:
+            syntax = Syntax(code, _guess_language_from_filename(filename))
+
+    lexer = getattr(syntax, "_lexer", None)
+    if not hasattr(lexer, "get_tokens"):
+        lexer = getattr(syntax, "lexer", None)
+    if lexer is None:
+        get_lexer = getattr(syntax, "_get_lexer", None)
+        if callable(get_lexer):
+            lexer = get_lexer()
+    if not hasattr(lexer, "get_tokens"):
+        raise LookupError("rich lexer unavailable")
+    return lexer
+
+
+def _guess_language_from_filename(filename):
+    suffix = Path(filename).suffix.lower()
