+def highlight_text(text: str, lexer_name: str, width: Optional[int] = None) -> str:
+    """Render syntax-colored ANSI text via rich."""
+    lexer_name = {
+        'json': 'json',
+        'toml': 'toml',
+        'xml': 'xml',
+        'yaml': 'yaml',
+        'diff': 'diff',
+    }[lexer_name]
+
+    buffer = io.StringIO()
+    console = Console(
+        file=buffer,
+        force_terminal=True,
+        color_system='standard',
+        width=width or 10_000,
+    )
+    console.print(
+        Syntax(text, lexer_name, theme='ansi_dark', line_numbers=False, word_wrap=False),
+        end='',
+    )
+
+    rendered = Text.from_ansi(buffer.getvalue())
+    buffer = io.StringIO()
