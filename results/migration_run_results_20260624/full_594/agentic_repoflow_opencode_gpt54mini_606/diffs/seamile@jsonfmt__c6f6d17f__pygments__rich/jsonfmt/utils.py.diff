+def _strip_whitespace_styles(text: Text) -> Text:
+    clean = Text(text.plain)
+    for span in text.spans:
+        segment = text.plain[span.start:span.end]
+        for match in re.finditer(r'\S+', segment):
+            start = span.start + match.start()
+            end = span.start + match.end()
+            clean.stylize(span.style, start, end)
+    return clean
+
