+    @staticmethod
+    def render_mako_template(source: str, context: dict):
+        template = Template(VisioFile._convert_jinja_to_mako(source))
+        return template.render(**context)
+
+    @staticmethod
+    def _convert_jinja_to_mako(source: str):
+        def _convert_expression(expression: str):
+            converted_expression = expression.strip()
+            for jinja_filter, mako_suffix in [
+                ('lower', '.lower()'),
+                ('upper', '.upper()'),
+                ('title', '.title()'),
+                ('capitalize', '.capitalize()'),
+                ('strip', '.strip()'),
+                ('lstrip', '.lstrip()'),
+                ('rstrip', '.rstrip()'),
+            ]:
+                converted_expression = re.sub(rf'\|\s*{jinja_filter}\b', mako_suffix, converted_expression)
+            return converted_expression
+
+        def _convert_block(match):
+            inner = match.group(1).strip()
+            if inner.startswith('for '):
+                return f'\n% for {_convert_expression(inner[4:])}:\n'
+            if inner.startswith('if '):
+                return f'\n% if {_convert_expression(inner[3:])}:\n'
+            if inner.startswith('elif '):
+                return f'\n% elif {_convert_expression(inner[5:])}:\n'
+            if inner == 'else':
+                return '\n% else:\n'
+            if inner == 'endfor':
+                return '\n% endfor\n'
+            if inner == 'endif':
+                return '\n% endif\n'
+            if inner.startswith('showif '):
+                return f'\n% if {_convert_expression(inner[7:])}:\n'
+            if inner.startswith('set self.'):
+                return ''
+            return match.group(0)
+
+        converted = re.sub(r'\{\%\s*(.*?)\s*\%\}', _convert_block, source, flags=re.DOTALL)
+        converted = re.sub(r'\{\{\s*(.*?)\s*\}\}', lambda m: '${' + _convert_expression(m.group(1)) + '}', converted, flags=re.DOTALL)
+        return converted
 
