--- a/filestack/http_client.py
+++ b/filestack/http_client.py
@@ -0,0 +1,56 @@
+import random
+import string
+import time
+
+import httpx
+
+from filestack import config
+from filestack.exceptions import FilestackHTTPError
+
+
+def unique_id(length=10):
+    return ''.join(random.choice(string.ascii_letters + string.digits) for _ in range(length))
+
+
+class HTTPClient:
+    def __init__(self):
+        self._client = httpx.Client()
+
+    def __getattr__(self, name):
+        return getattr(self._client, name)
+
+    def _request(self, method, url, *args, **kwargs):
+        headers = kwargs.pop('headers', None)
+        if headers is None:
+            headers = dict(config.HEADERS)
+            headers['Filestack-Trace-Id'] = '{}-{}'.format(int(time.time()), unique_id())
+            headers['Filestack-Trace-Span'] = 'pythonsdk-{}'.format(unique_id())
+
+        stream = kwargs.pop('stream', False)
+        request = self._client.build_request(method, url, *args, headers=headers, **kwargs)
+        response = self._client.send(request, stream=stream)
+
+        try:
+            response.raise_for_status()
+        except httpx.HTTPStatusError as e:
+            message = response.text
+            response.close()
+            raise FilestackHTTPError(message) from e
+
+        return response
+
+    def get(self, url, *args, **kwargs):
+        return self._request('GET', url, *args, **kwargs)
+
+    def post(self, url, *args, **kwargs):
+        return self._request('POST', url, *args, **kwargs)
+
+    def put(self, url, *args, **kwargs):
+        return self._request('PUT', url, *args, **kwargs)
+
+    def delete(self, url, *args, **kwargs):
+        return self._request('DELETE', url, *args, **kwargs)
+
+
+http_client = HTTPClient()
+requests = http_client
