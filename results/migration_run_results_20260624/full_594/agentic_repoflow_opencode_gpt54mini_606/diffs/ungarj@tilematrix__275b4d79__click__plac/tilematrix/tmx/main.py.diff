+def _parse_options(
+    pixelbuffer=0,
+    tile_size=256,
+    metatiling=1,
+    grid="geodetic",
+    output_format="Tile",
+):
+    return {
+        "pixelbuffer": int(pixelbuffer),
+        "tile_size": int(tile_size),
+        "metatiling": int(metatiling),
+        "grid": grid,
+        "output_format": output_format,
+    }
+
+
+def _parse_option_argv(argv):
+    config = {
+        "pixelbuffer": 0,
+        "tile_size": 256,
+        "metatiling": 1,
+        "grid": "geodetic",
+        "output_format": "Tile",
+    }
+    index = 0
+    while index < len(argv):
+        token = argv[index]
+        if token not in _OPTION_TOKENS:
+            break
+        if index + 1 >= len(argv):
+            raise SystemExit(2)
+        value = argv[index + 1]
+        if token in ["-p", "--pixelbuffer"]:
+            config["pixelbuffer"] = int(value)
+        elif token in ["-s", "--tile_size", "--tile-size"]:
+            config["tile_size"] = int(value)
+        elif token in ["-m", "--metatiling"]:
+            config["metatiling"] = int(value)
+        elif token in ["-g", "--grid"]:
+            config["grid"] = value
+        elif token in ["-f", "--output_format", "--output-format"]:
+            config["output_format"] = value
+        index += 2
+    return config, argv[index:]
+
+
+def _split_argv(argv):
+    option_argv = []
+    index = 0
+    while index < len(argv):
+        token = argv[index]
+        if token in ["--help", "-h", "--version", "-V"]:
+            break
+        if token not in _OPTION_TOKENS:
+            if token.startswith("-"):
+                raise SystemExit(2)
+            break
+        if index + 1 >= len(argv):
+            raise SystemExit(2)
+        option_argv.extend([token, argv[index + 1]])
+        index += 2
+    if index >= len(argv):
+        raise SystemExit(2)
+    return option_argv, argv[index], argv[index + 1 :]
+
+
+def _print_help():
+    print("Usage: tmx [OPTIONS] COMMAND [ARGS]...")
+    print()
+    print("Options:")
+    print("  -p, --pixelbuffer INTEGER")
+    print("  -s, --tile_size INTEGER")
+    print("  -m, --metatiling INTEGER")
+    print("  -g, --grid [geodetic|mercator]")
+    print("  -f, --output_format [Tile|WKT|GeoJSON]")
+    print()
+    print("Commands:")
+    print("  bounds")
+    print("  bbox")
+    print("  tile")
+    print("  tiles")
+    print("  snap-bounds")
+    print("  snap-bbox")
+
+
+def _print_command_help(command):
+    if command == "bounds":
+        print("Usage: tmx [OPTIONS] bounds ZOOM ROW COL")
+    elif command == "bbox":
+        print("Usage: tmx [OPTIONS] bbox ZOOM ROW COL")
+    elif command == "tile":
+        print("Usage: tmx [OPTIONS] tile ZOOM X Y")
+    elif command == "tiles":
+        print("Usage: tmx [OPTIONS] tiles ZOOM LEFT BOTTOM RIGHT TOP")
+    elif command == "snap-bounds":
+        print("Usage: tmx [OPTIONS] snap-bounds ZOOM LEFT BOTTOM RIGHT TOP")
+    elif command == "snap-bbox":
+        print("Usage: tmx [OPTIONS] snap-bbox ZOOM LEFT BOTTOM RIGHT TOP")
+
+
+def _dispatch(command, command_args, config):
+    if config["grid"] not in ["geodetic", "mercator"]:
+        raise SystemExit(2)
+    if config["output_format"] not in ["Tile", "WKT", "GeoJSON"]:
+        raise SystemExit(2)
+
+    pyramid = _tile_pyramid(
+        config["grid"], config["tile_size"], config["metatiling"]
+    )
+    command = command.replace("-", "_")
+    if command == "bounds":
+        if len(command_args) != 3:
+            raise SystemExit(2)
+        _bounds(pyramid, *command_args, config["pixelbuffer"])
+    elif command == "bbox":
+        if len(command_args) != 3:
+            raise SystemExit(2)
+        _bbox(pyramid, *command_args, config["pixelbuffer"], config["output_format"])
+    elif command == "tile":
+        if len(command_args) != 3:
+            raise SystemExit(2)
+        _tile(pyramid, *command_args, config["pixelbuffer"], config["output_format"])
+    elif command == "tiles":
+        if len(command_args) != 5:
+            raise SystemExit(2)
+        _tiles(
+            pyramid,
+            *command_args,
+            config["pixelbuffer"],
+            config["output_format"],
+        )
+    elif command == "snap_bounds":
+        if len(command_args) != 5:
+            raise SystemExit(2)
+        _snap_bounds(pyramid, *command_args, config["pixelbuffer"])
+    elif command == "snap_bbox":
+        if len(command_args) != 5:
+            raise SystemExit(2)
+        _snap_bbox(pyramid, *command_args, config["pixelbuffer"])
+    else:
+        raise SystemExit(2)
+
+
+class _TMXCommand:
+    name = "tmx"
+
+    def __call__(self, *args, **kwargs):
+        return self.main(*args, **kwargs)
+
+    def main(self, args=None, prog_name=None, **kwargs):
+        argv = list(sys.argv[1:] if args is None else args)
+        if "--version" in argv or "-V" in argv:
+            print(tilematrix.__version__)
+            return 0
+        if "--help" in argv or "-h" in argv or not argv:
+            command = None
+            for token in argv:
+                if token not in ["--help", "-h", "--version", "-V"] and not token.startswith("-"):
+                    command = token
+                    break
+            if command is None:
+                _print_help()
+            else:
+                _print_command_help(command)
+            return 0
+
+        option_argv, command, command_args = _split_argv(argv)
+        try:
+            config = (
+                plac.call(_parse_options, option_argv)
+                if option_argv
+                else _parse_options()
+            )
+            if not isinstance(config, dict):
+                raise TypeError
+        except (Exception, SystemExit):
+            config, _ = _parse_option_argv(option_argv)
+        try:
+            _dispatch(command, command_args, config)
+        except (IndexError, TypeError, ValueError):
+            raise SystemExit(2)
+        return 0
+
+
+tmx = _TMXCommand()
