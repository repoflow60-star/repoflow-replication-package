 import pandas as pd
 
 
+def _create_figure(figsize):
+    ax = sns.lineplot(x=[0], y=[0], legend=False)
+    fig = ax.figure
+    fig.set_size_inches(*figsize)
+    ax.clear()
+    return fig, ax
+
+
+def _figure_to_image(fig):
+    fig.canvas.draw()
+    width, height = fig.canvas.get_width_height()
+    return Image.frombytes('RGBA', (width, height), fig.canvas.buffer_rgba()).convert('P', palette=Image.ADAPTIVE)
+
+
+def _hide_sparse_xticklabels(ax):
+    for i, label in enumerate(ax.get_xticklabels()):
+        if i % 5 == 0:
+            continue
+        label.set_visible(False)
+
+
+def _save_gif(frames, path, filename, duration=100):
+    if not frames:
+        return
+    frames[0].save(
+        path / filename,
+        save_all=True,
+        append_images=frames[1:],
+        duration=duration,
+        loop=0,
+    )
+
+
