 from typing import Any, List
 
-from tabulate import tabulate
+from prettytable import PrettyTable
 
 from edgetest.core import TestPackage
 
 VALID_OUTPUTS = ["rst", "github"]
+
+
+def _build_table(headers: List[str], rows: List[List[Any]]) -> PrettyTable:
+    table = PrettyTable()
+    table.field_names = [str(header) for header in headers]
+
+    for row in rows:
+        normalized_row = [str(cell) for cell in row]
+        if len(normalized_row) < len(table.field_names):
+            normalized_row.extend([""] * (len(table.field_names) - len(normalized_row)))
+        table.add_row(normalized_row[: len(table.field_names)])
+
+    return table
+
+
+def _normalize_rows(headers: List[str], rows: List[List[Any]]) -> List[List[str]]:
+    normalized_rows = []
+    for row in rows:
+        normalized_row = [str(cell) for cell in row[: len(headers)]]
+        if len(normalized_row) < len(headers):
+            normalized_row.extend([""] * (len(headers) - len(normalized_row)))
+        normalized_rows.append(normalized_row)
+
+    return normalized_rows
+
+
+def _column_widths(headers: List[str], rows: List[List[Any]]) -> List[int]:
+    widths = []
+    for index, header in enumerate(headers):
+        column = [str(header)]
+        column.extend(str(row[index]) if index < len(row) else "" for row in rows)
+        widths.append(max(len(cell) for cell in column))
+
+    return widths
+
+
+def _render_rst(headers: List[str], rows: List[List[Any]]) -> str:
+    widths = _column_widths(headers, rows)
+
+    def render_row(row: List[Any]) -> str:
+        cells = []
+        for cell, width in zip(row, widths):
+            cells.append(str(cell).ljust(width))
+        return "  ".join(cells)
+
+    rule = "  ".join("=" * width for width in widths)
+    output = [rule, render_row(headers), rule]
+    output.extend(render_row(row) for row in rows)
+    if rows:
+        output.append(rule)
+    return "\n".join(output)
+
+
+def _render_github(headers: List[str], rows: List[List[Any]]) -> str:
+    widths = _column_widths(headers, rows)
+
+    def render_row(row: List[Any]) -> str:
+        cells = [str(cell).ljust(width) for cell, width in zip(row, widths)]
+        return "| " + " | ".join(cells) + " |"
+
+    header_rule = "| " + " | ".join("-" * width for width in widths) + " |"
+    output = [render_row(headers), header_rule]
+    output.extend(render_row(row) for row in rows)
+    return "\n".join(output)
+
+
+def tabulate(rows: List[List[Any]], headers: List[str], tablefmt: str = "rst") -> str:
+    """Compatibility wrapper backed by PrettyTable."""
+    table = _build_table(headers, rows)
+    normalized_rows = _normalize_rows(table.field_names, rows)
+
+    if tablefmt == "github":
+        return _render_github(table.field_names, normalized_rows)
+
+    return _render_rst(table.field_names, normalized_rows)
 
 
