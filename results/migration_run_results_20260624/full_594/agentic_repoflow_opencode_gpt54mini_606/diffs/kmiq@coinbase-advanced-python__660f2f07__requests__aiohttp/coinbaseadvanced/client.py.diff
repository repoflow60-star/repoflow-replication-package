+class _HttpResponse:
+    def __init__(self, status: int, text: str) -> None:
+        self.status = status
+        self.status_code = status
+        self.ok = 200 <= status < 400
+        self.text = text
+
+    def json(self) -> Any:
+        if not self.text:
+            return {}
+        return json.loads(self.text)
+
+
+class _AiohttpRequestsAdapter:
+    def get(self, url: str, headers: dict, timeout: int, json: Any = None):
+        return asyncio.run(self._request("GET", url, headers, timeout, json))
+
+    def post(self, url: str, headers: dict, timeout: int, json: Any = None):
+        return asyncio.run(self._request("POST", url, headers, timeout, json))
+
+    def put(self, url: str, headers: dict, timeout: int, json: Any = None):
+        return asyncio.run(self._request("PUT", url, headers, timeout, json))
+
+    def delete(self, url: str, headers: dict, timeout: int, json: Any = None):
+        return asyncio.run(self._request("DELETE", url, headers, timeout, json))
+
+    async def _request(self, method: str, url: str, headers: dict, timeout: int, json_body: Any):
+        client_timeout = aiohttp.ClientTimeout(total=timeout)
+        async with aiohttp.ClientSession(timeout=client_timeout) as session:
+            async with session.request(method, url, headers=headers, json=json_body) as response:
+                return _HttpResponse(response.status, await response.text())
+
+
+_http_client = _AiohttpRequestsAdapter()
+
+# Compatibility hook for existing tests that patch this module attribute.
+requests = _http_client
 
 
