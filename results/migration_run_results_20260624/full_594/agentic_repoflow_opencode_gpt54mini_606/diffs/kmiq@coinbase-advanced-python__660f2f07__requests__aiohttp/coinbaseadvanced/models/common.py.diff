+def _response_is_ok(response: Any) -> bool:
+    if isinstance(response, Mapping):
+        return True
+
+    ok = getattr(response, "ok", None)
+    if ok is not None:
+        return bool(ok)
+
+    status = getattr(response, "status", getattr(response, "status_code", None))
+    return status is not None and 200 <= status < 400
+
+
+def _response_json(response: Any) -> Any:
+    if isinstance(response, Mapping):
+        return response
+
+    json_loader = getattr(response, "json", None)
+    if callable(json_loader):
+        payload = json_loader()
+        if inspect.isawaitable(payload):
+            payload = asyncio.run(payload)
+        return payload
+
+    raise TypeError("Response object does not expose JSON content")
 
 
