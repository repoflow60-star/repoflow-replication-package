+def _new_tdes_cipher(
+    key: bytes, mode: int, iv: _typing.Optional[bytes] = None
+) -> _typing.Any:
+    if len(key) == 8:
+        if iv is None:
+            return _DES.new(key, mode)
+        return _DES.new(key, mode, iv=iv)
+
+    if len(key) == 16:
+        if key[:8] == key[8:]:
+            if iv is None:
+                return _DES.new(key[:8], mode)
+            return _DES.new(key[:8], mode, iv=iv)
+        if iv is None:
+            return _DES3.new(key, mode)
+        return _DES3.new(key, mode, iv=iv)
+
+    if len(key) == 24:
+        if key[:8] == key[8:16]:
+            if iv is None:
+                return _DES.new(key[16:], mode)
+            return _DES.new(key[16:], mode, iv=iv)
+        if key[8:16] == key[16:]:
+            if iv is None:
+                return _DES.new(key[:8], mode)
+            return _DES.new(key[:8], mode, iv=iv)
+        if iv is None:
+            return _DES3.new(key, mode)
+        return _DES3.new(key, mode, iv=iv)
+
+    raise ValueError("Triple DES key must be 8, 16, or 24 bytes long")
