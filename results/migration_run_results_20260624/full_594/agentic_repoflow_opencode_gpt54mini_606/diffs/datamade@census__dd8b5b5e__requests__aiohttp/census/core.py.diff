+class _AiohttpSession:
+
+    def __init__(self, *args, **kwargs):
+        self.headers = dict(kwargs.pop('headers', {}) or {})
+
+    def get(self, url, params=None, **kwargs):
+        return _run_coro(self._get(url, params=params, **kwargs))
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        self.close()
+        return False
+
+    async def _get(self, url, params=None, **kwargs):
+        async with aiohttp.ClientSession(headers=dict(self.headers)) as session:
+            async with session.get(url, params=params, **kwargs) as resp:
+                text = await resp.text()
