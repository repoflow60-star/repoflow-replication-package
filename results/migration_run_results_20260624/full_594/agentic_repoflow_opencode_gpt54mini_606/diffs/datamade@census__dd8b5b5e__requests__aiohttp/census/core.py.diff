+def _run_coro(coro):
+    loop = asyncio.new_event_loop()
+    try:
+        previous = asyncio.get_event_loop()
+    except RuntimeError:
+        previous = None
+    try:
+        asyncio.set_event_loop(loop)
+        return loop.run_until_complete(coro)
+    finally:
+        asyncio.set_event_loop(previous)
+        loop.close()
+
