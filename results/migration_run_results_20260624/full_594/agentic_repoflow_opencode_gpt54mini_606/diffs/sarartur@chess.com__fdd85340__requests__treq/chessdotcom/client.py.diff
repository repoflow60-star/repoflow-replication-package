+def _normalize_request_options(request_options):
+    request_options = copy.deepcopy(request_options)
+
+    headers = request_options.get("headers", {})
+    if isinstance(headers, dict):
+        request_options["headers"] = {
+            key: value for key, value in headers.items() if value is not None
+        }
+
+    request_options.pop("verify", None)
+    request_options.pop("verify_ssl", None)
+
+    return request_options
+
+
+def _response_headers(response):
+    headers = getattr(response, "headers", {})
+    raw_headers = getattr(headers, "getAllRawHeaders", None)
+
+    if raw_headers is None or not callable(raw_headers):
+        return headers
+
+    normalized = {}
+    for key, values in raw_headers() or []:
+        key = key.decode("utf-8") if isinstance(key, bytes) else key
+        normalized[key] = ", ".join(
+            value.decode("utf-8") if isinstance(value, bytes) else value
+            for value in values
+        )
+
+    return normalized
+
+
+@defer.inlineCallbacks
+def _get_treq_response(url, timeout, request_options):
+    transport = requests
+    response = yield getattr(transport, _SYNC_GET_METHOD)(
+        url=url, timeout=timeout, **_normalize_request_options(request_options)
+    )
+    text = yield treq.text_content(response)
+
+    status_code = getattr(response, "code", None)
+    if status_code is None:
+        status_code = getattr(response, "status", None)
+
+    defer.returnValue(
+        SimpleNamespace(
+            status_code=status_code,
+            text=text,
+            headers=_response_headers(response),
+        )
+    )
 
 
