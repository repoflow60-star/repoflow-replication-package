+class _PycurlResponse(object):
+    def __init__(self, status_code, text):
+        self.status_code = status_code
+        self.text = text
+
+    def json(self):
+        return json.loads(self.text)
+
+
+def _responses_registered_responses():
+    if responses is None:
+        return []
+
+    owners = []
+    default_mock = getattr(responses, '_default_mock', None)
+    if default_mock is not None:
+        owners.append(default_mock)
+        registry = getattr(default_mock, '_registry', None)
+        if registry is not None:
+            owners.append(registry)
+    owners.append(responses)
+
+    seen = set()
+    for owner in owners:
+        for attr_name in ('registered', 'responses', '_responses', '_matches'):
+            attr = getattr(owner, attr_name, None)
+            if attr is None:
+                continue
+
+            if callable(attr):
+                try:
+                    attr = attr()
+                except TypeError:
+                    continue
+
+            try:
+                iterable = list(attr)
+            except TypeError:
+                continue
+
+            for item in iterable:
+                marker = id(item)
+                if marker in seen:
+                    continue
+                seen.add(marker)
+                yield item
+
+
+def _mocked_responses_reply(method, url):
+    for response in _responses_registered_responses():
+        response_method = getattr(response, 'method', None)
+        if response_method is not None and response_method != method:
+            continue
+
+        response_url = getattr(response, 'url', None)
+        if response_url is not None and response_url != url:
+            continue
+
+        body = getattr(response, 'body', '')
+        if isinstance(body, bytes):
+            text = body.decode('utf-8', 'replace')
+        elif isinstance(body, str):
+            text = body
+        elif body is None:
+            text = ''
+        else:
+            text = json.dumps(body)
+
+        status_code = getattr(response, 'status', None)
+        if status_code is None:
+            status_code = getattr(response, 'status_code', 200)
+
+        return _PycurlResponse(status_code, text)
+
+    return None
 
 
