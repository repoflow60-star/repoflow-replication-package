+_reactor_ready = Event()
+_reactor_lock = Lock()
+_reactor_thread = None
+
+
+def _ensure_reactor_running():
+    global _reactor_thread
+
+    if reactor.running:
+        _reactor_ready.set()
+        return
+
+    with _reactor_lock:
+        if reactor.running:
+            _reactor_ready.set()
+            return
+        if _reactor_thread is None:
+            _reactor_ready.clear()
+
+            def _run_reactor():
+                try:
+                    reactor.callWhenRunning(_reactor_ready.set)
+                    reactor.run(installSignalHandlers=False)
+                finally:
+                    _reactor_ready.set()
+
+            _reactor_thread = Thread(
+                target=_run_reactor,
+                name='treq-reactor',
+                daemon=True,
+            )
+            _reactor_thread.start()
+
+    _reactor_ready.wait()
+
+
+class _TreqResponse(object):
+    def __init__(self, status_code, content):
+        self.status_code = status_code
+        self.content = content
+
+    def iter_lines(self, chunk_size=8192):
+        for line in self.content.splitlines():
+            if isinstance(line, bytes):
+                yield line.decode('utf-8')
+            else:
+                yield line
+
+    def close(self):
+        return None
+
+
+class _TreqSession(object):
+    def _request(self, method, url, **kwargs):
+        _ensure_reactor_running()
+
+        request_kwargs = {}
+        for key in ('params', 'headers', 'data'):
+            if key in kwargs and kwargs[key] is not None:
+                request_kwargs[key] = kwargs[key]
+
+        def _perform_request():
+            request = getattr(treq, method)(url, **request_kwargs)
+
+            def _read_body(response):
+                return treq.content(response).addCallback(
+                    lambda body: _TreqResponse(response.code, body)
+                )
+
+            return request.addCallback(_read_body)
+
+        return blockingCallFromThread(reactor, _perform_request)
+
+    def get(self, url, **kwargs):
+        return self._request('get', url, **kwargs)
+
+    def post(self, url, data=None, **kwargs):
+        kwargs['data'] = data
+        return self._request('post', url, **kwargs)
 
 
