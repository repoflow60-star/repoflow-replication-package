+def _color_to_srgb1(color):
+    if type(color) is str:
+        if color.startswith("#"):
+            return asarray(plotly_colors.hex_to_rgb(color), dtype=float32) / 255.0
+
+        if color.startswith("rgb"):
+            parser = getattr(plotly_colors, "unlabel_rgb", None)
+            if parser is not None:
+                return asarray(parser(color), dtype=float32) / 255.0
+
+    if hasattr(color, "__len__") and (len(color) == 3 or len(color) == 4):
+        raw_color = color
+        color = asarray(raw_color[:3], dtype=float32)
+        if any([isinstance(channel, (int, integer)) for channel in raw_color]) or max(raw_color) > 1.0:
+            color = color / 255.0
+
+        return color
+
+    raise ValueError(f"Unrecognized color value {color!r}")
+
+
+def _resolve_plotly_palette(palette, max_colors):
+    if palette in _MATPLOTLIB_QUALITATIVE_PALETTES:
+        colors = _MATPLOTLIB_QUALITATIVE_PALETTES[palette]
+        if len(colors) <= max_colors:
+            return list(colors)
+
+        colorscale = list(zip(linspace(0, 1, len(colors)), colors))
+        sampled = plotly_colors.sample_colorscale(colorscale, linspace(0, 1, max_colors))
+        return sampled if type(sampled) is list else [sampled]
+
+    for namespace_name in ("qualitative", "sequential", "diverging", "cyclical"):
+        namespace = getattr(plotly_colors, namespace_name, None)
+        if namespace is None:
+            continue
+
+        colors = getattr(namespace, palette, None)
+        if colors is None:
+            for attr in dir(namespace):
+                if attr.lower() == palette.lower():
+                    colors = getattr(namespace, attr)
+                    break
+        if colors is None:
+            continue
+
+        if len(colors) <= max_colors:
+            return list(colors)
+
+        colorscale = list(zip(linspace(0, 1, len(colors)), colors))
