+    def _render_select(self, node):
+        if isinstance(node, (ast.Union, ast.Except, ast.Intersect)):
+            return self._render_combining_query(node)
+
+        parts = []
+        if node.cte is not None:
+            cte_str = ', '.join(self._render_statement(out) for out in node.cte)
+            parts.append(f'WITH {cte_str}')
+
+        sql = 'SELECT'
+        if node.distinct:
+            sql += ' DISTINCT'
+
+        sql += ' ' + ', '.join(self._render_select_target(t) for t in node.targets)
+
+        if node.from_table is not None:
+            sql += f' FROM {self._render_from_table(node.from_table)}'
+
+        if node.where is not None:
+            sql += f' WHERE {self._render_expression(node.where)}'
+
+        if node.group_by is not None:
+            sql += ' GROUP BY ' + ', '.join(self._render_expression(i) for i in node.group_by)
+
+        if node.having is not None:
+            sql += f' HAVING {self._render_expression(node.having)}'
+
+        if node.order_by is not None:
+            sql += ' ORDER BY ' + ', '.join(self._render_order_by(i) for i in node.order_by)
+
+        if node.limit is not None:
+            sql += f' LIMIT {node.limit.value}'
+
+        if node.offset is not None:
+            sql += f' OFFSET {node.offset.value}'
+
+        if node.mode is not None:
+            sql += f' {node.mode}'
+
+        if node.using is not None:
+            using_ar = []
+            for key, value in node.using.items():
+                if isinstance(value, ast.Object):
+                    args = [f'{k}={json.dumps(v)}' for k, v in value.params.items()]
+                    rendered_value = f'{value.type}({", ".join(args)})'
+                elif hasattr(value, 'to_string'):
+                    rendered_value = value.to_string()
+                else:
+                    rendered_value = json.dumps(value)
+                using_ar.append(f'{ast.Identifier(key).to_string()}={rendered_value}')
+            sql += ' USING ' + ', '.join(using_ar)
+
+        if parts:
+            return ' '.join(parts + [sql])
+        return sql
 
