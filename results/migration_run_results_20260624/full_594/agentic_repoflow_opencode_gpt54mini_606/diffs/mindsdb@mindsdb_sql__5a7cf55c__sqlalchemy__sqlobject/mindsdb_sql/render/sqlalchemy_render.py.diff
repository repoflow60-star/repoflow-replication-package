+    def _binary_precedence(self, op):
+        op = op.lower()
+        if op == 'or':
+            return 1
+        if op == 'and':
+            return 2
+        if op in ('=', '!=', '<>', '>', '<', '>=', '<=', 'is', 'is not', 'like', 'not like', 'in', 'not in'):
+            return 3
+        if op == '||':
+            return 4
+        if op in ('+', '-'):
+            return 5
+        if op in ('*', '/', '%'):
+            return 6
+        return 3
+
+    def _render_with_parentheses(self, node, sql, parent_prec=0):
+        if getattr(node, 'parentheses', False):
+            return f'({sql})'
+        if parent_prec and isinstance(node, ast.BinaryOperation):
+            if self._binary_precedence(node.op) < parent_prec:
+                return f'({sql})'
+        return sql
+
+    def _render_expression(self, node, parent_prec=0):
