+    def _render_binary_operation(self, node):
+        left = self._render_expression(node.args[0], parent_prec=self._binary_precedence(node.op))
+        right = self._render_expression(node.args[1], parent_prec=self._binary_precedence(node.op))
+        op = node.op.lower()
+
+        if op == 'and':
+            return f'{left} AND {right}'
+        if op == 'or':
+            return f'{left} OR {right}'
+        if op == '||':
+            return f'{left} || {right}'
+        if op == 'like':
+            return f'{left} LIKE {right}'
+        if op == 'not like':
+            return f'{left} NOT LIKE {right}'
+        if op == 'is':
+            return f'{left} IS {right}'
+        if op == 'is not':
+            return f'{left} IS NOT {right}'
+        if op == 'in':
+            return f'{left} IN {right}'
+        if op == 'not in':
+            return f'{left} NOT IN {right}'
+        return f'{left} {node.op.upper()} {right}'
+
+    def _render_unary_operation(self, node):
+        arg_node = node.args[0]
+        arg = self._render_expression(arg_node, parent_prec=4)
+        simple_types = (ast.Constant, ast.Identifier, ast.Star, ast.Last, ast.Parameter, ast.Variable, ast.Latest, ast.Data, ast.Function)
+        if not isinstance(arg_node, simple_types) and not arg.startswith('('):
+            arg = f'({arg})'
+        if node.op.upper() == 'NOT':
+            return f'NOT {arg}'
+        return f'-{arg}'
+
+    def _render_function(self, node):
+        args = ', '.join(self._render_expression(i) for i in node.args)
+        distinct = 'DISTINCT ' if node.distinct else ''
+        from_str = f' FROM {self._render_expression(node.from_arg)}' if node.from_arg else ''
+        namespace = f'{node.namespace}.' if node.namespace else ''
+        return f'{namespace}{node.op}({distinct}{args}{from_str})'
+
+    def _render_window_function(self, node):
+        fnc_str = self._render_expression(node.function)
+        partition_str = ''
+        if node.partition is not None:
+            partition_str = 'PARTITION BY ' + ', '.join(self._render_expression(arg) for arg in node.partition)
+
+        order_str = ''
+        if node.order_by is not None:
+            order_str = 'ORDER BY ' + ', '.join(self._render_order_by(order) for order in node.order_by)
+
+        modifier_str = f' {node.modifier}' if node.modifier else ''
+        inner = ' '.join(part for part in (partition_str, order_str) if part)
+        alias_str = f' {node.alias.to_string()}' if node.alias else ''
+        return f'{fnc_str} over({inner}{modifier_str}){alias_str}'
+
+    def _render_type_cast(self, node):
+        type_name = self.get_type(node.type_name)
+        if node.precision is not None:
+            type_name += f'({",".join(map(str, node.precision))})'
+        return f'CAST({self._render_expression(node.arg)} AS {type_name})'
+
+    def _render_case(self, node):
+        rules = ' '.join(
+            f'WHEN {self._render_expression(condition)} THEN {self._render_expression(result)}'
+            for condition, result in node.rules
+        )
+        default = f' ELSE {self._render_expression(node.default)}' if node.default is not None else ''
+        arg = f'{self._render_expression(node.arg)} ' if node.arg is not None else ''
+        return f'CASE {arg}{rules}{default} END'
+
+    def _render_order_by(self, order):
+        out_str = self._render_expression(order.field)
+        if order.direction != 'default':
+            out_str += f' {order.direction}'
+        if order.nulls != 'default':
+            out_str += f' {order.nulls}'
+        return out_str
