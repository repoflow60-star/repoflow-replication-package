+            sql = f'({self._render_combining_query(node)})'
+            if node.alias:
+                sql = f'{sql} AS {self._render_alias(node.alias)}'
+            return sql
+        if isinstance(node, ast.Function):
+            sql = self._render_function(node)
+            return self._render_with_parentheses(node, sql, parent_prec=parent_prec)
+        if isinstance(node, ast.BinaryOperation):
+            sql = self._render_binary_operation(node)
+            return self._render_with_parentheses(node, sql, parent_prec=parent_prec)
+        if isinstance(node, ast.UnaryOperation):
+            sql = self._render_unary_operation(node)
+            return self._render_with_parentheses(node, sql, parent_prec=parent_prec)
+        if isinstance(node, ast.BetweenOperation):
+            sql = (
+                f'{self._render_expression(node.args[0], parent_prec=3)} BETWEEN '
+                f'{self._render_expression(node.args[1], parent_prec=3)} AND '
+                f'{self._render_expression(node.args[2], parent_prec=3)}'
+            )
+            return self._render_with_parentheses(node, sql, parent_prec=parent_prec)
+        if isinstance(node, ast.Interval):
+            items = str(node.args[0]).split(' ', maxsplit=1)
+            items[0] = f"'{items[0]}'"
+            return self._render_with_parentheses(node, 'INTERVAL ' + ' '.join(items), parent_prec=parent_prec)
+        if isinstance(node, ast.WindowFunction):
+            return self._render_with_parentheses(node, self._render_window_function(node), parent_prec=parent_prec)
+        if isinstance(node, ast.TypeCast):
+            return self._render_with_parentheses(node, self._render_type_cast(node), parent_prec=parent_prec)
+        if isinstance(node, ast.Parameter):
+            return self._render_with_parentheses(node, ':' + str(node.value), parent_prec=parent_prec)
+        if isinstance(node, ast.Tuple):
