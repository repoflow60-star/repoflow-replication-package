+        if isinstance(node, ast.Select):
+            sql = f'({self._render_select(node)})'
+            if node.alias:
+                return f'{sql} AS {self._render_alias(node.alias)}'
+            return sql
+        if isinstance(node, ast.WindowFunction):
+            return self._render_window_function(node)
+        if isinstance(node, ast.Identifier) and node.alias:
+            return f'{node.to_string()} AS {self._render_alias(node.alias)}'
+        if getattr(node, 'alias', None):
+            return f'{self._render_expression(node)} AS {self._render_alias(node.alias)}'
+        return self._render_expression(node)
+
+    def _render_from_table(self, node):
+        if isinstance(node, ast.Join):
+            return node.to_string()
+        if isinstance(node, (ast.Select, ast.Union, ast.Intersect, ast.Except)):
+            sql = f'({self._render_statement(node)})'
