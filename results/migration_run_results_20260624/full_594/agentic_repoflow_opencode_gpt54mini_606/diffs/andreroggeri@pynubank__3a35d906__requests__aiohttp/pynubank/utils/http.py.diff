+@dataclass
+class HttpResponse:
+    status_code: int
+    headers: dict
+    url: str
+    _json: dict
+
+    def json(self) -> dict:
+        return self._json
+
+
+async def _request(method: str, url: str, headers: dict, json: dict = None) -> HttpResponse:
+    async with aiohttp.ClientSession(headers=headers) as session:
+        async with session.request(method, url, json=json) as response:
+            data = await response.json(content_type=None)
+            return HttpResponse(response.status, dict(response.headers), str(response.url), data)
+
+
+def get(url: str, headers: dict, **kwargs) -> HttpResponse:
+    return asyncio.run(_request('GET', url, headers))
+
+
+def post(url: str, json: dict, headers: dict, **kwargs) -> HttpResponse:
+    return asyncio.run(_request('POST', url, headers, json=json))
 
 
