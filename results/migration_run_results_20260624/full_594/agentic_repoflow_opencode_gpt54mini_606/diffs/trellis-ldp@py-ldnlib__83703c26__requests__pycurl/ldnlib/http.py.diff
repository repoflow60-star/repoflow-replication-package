--- a/ldnlib/http.py
+++ b/ldnlib/http.py
@@ -0,0 +1,171 @@
+import io
+import json
+
+import pycurl
+
+
+class HTTPError(Exception):
+
+    def __init__(self, status_code, response=None):
+        super().__init__("HTTP {}".format(status_code))
+        self.status_code = status_code
+        self.response = response
+
+
+class Response(object):
+
+    def __init__(self, status_code, headers, text):
+        self.status_code = status_code
+        self.headers = headers
+        self.text = text
+        self.links = _parse_links(headers.get('link', ''))
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise HTTPError(self.status_code, response=self)
+
+
+def _split_link_values(value):
+    parts = []
+    chunk = []
+    in_angle = False
+    in_quote = False
+
+    for char in value:
+        if char == '"':
+            in_quote = not in_quote
+        elif char == '<' and not in_quote:
+            in_angle = True
+        elif char == '>' and not in_quote:
+            in_angle = False
+        elif char == ',' and not in_quote and not in_angle:
+            part = ''.join(chunk).strip()
+            if part:
+                parts.append(part)
+            chunk = []
+            continue
+        chunk.append(char)
+
+    part = ''.join(chunk).strip()
+    if part:
+        parts.append(part)
+    return parts
+
+
+def _parse_links(value):
+    links = {}
+    if not value:
+        return links
+
+    for item in _split_link_values(value):
+        if not item.startswith('<'):
+            continue
+
+        url, _, params = item.partition('>')
+        url = url[1:]
+        params = params.lstrip(';').strip()
+
+        link_data = {'url': url}
+        rel = None
+        if params:
+            for param in params.split(';'):
+                if '=' not in param:
+                    continue
+                key, val = param.split('=', 1)
+                key = key.strip().lower()
+                val = val.strip().strip('"')
+                link_data[key] = val
+                if key == 'rel':
+                    rel = val
+
+        if rel:
+            links[rel] = link_data
+
+    return links
+
+
+def _decode_body(raw_body, headers):
+    content_type = headers.get('content-type', '')
+    charset = 'utf-8'
+    if 'charset=' in content_type:
+        charset = content_type.split('charset=', 1)[1].split(';', 1)[0].strip()
+    return raw_body.decode(charset, errors='replace')
+
+
+def _request_headers(headers):
+    return ["{}: {}".format(key, value) for key, value in headers.items()]
+
+
+def request(method, url, **kwargs):
+    headers = kwargs.pop('headers', None) or {}
+    data = kwargs.pop('data', None)
+    auth = kwargs.pop('auth', None)
+    allow_redirects = kwargs.pop('allow_redirects', True)
+    timeout = kwargs.pop('timeout', None)
+
+    curl = pycurl.Curl()
+    body = io.BytesIO()
+    header_lines = []
+
+    def capture_header(line):
+        decoded = line.decode('iso-8859-1')
+        if decoded.startswith('HTTP/'):
+            header_lines[:] = []
+        else:
+            header_lines.append(decoded.rstrip('\r\n'))
+        return len(line)
+
+    curl.setopt(pycurl.URL, url)
+    curl.setopt(pycurl.FOLLOWLOCATION, 1 if allow_redirects else 0)
+    curl.setopt(pycurl.WRITEFUNCTION, body.write)
+    curl.setopt(pycurl.HEADERFUNCTION, capture_header)
+
+    if timeout is not None:
+        curl.setopt(pycurl.TIMEOUT, timeout)
+
+    if auth is not None:
+        curl.setopt(pycurl.USERPWD, "{}:{}".format(auth[0], auth[1]))
+
+    if headers:
+        curl.setopt(pycurl.HTTPHEADER, _request_headers(headers))
+
+    method = method.upper()
+    if method == 'HEAD':
+        curl.setopt(pycurl.NOBODY, 1)
+        curl.setopt(pycurl.CUSTOMREQUEST, 'HEAD')
+    elif method == 'POST':
+        curl.setopt(pycurl.POST, 1)
+        if data is not None:
+            curl.setopt(pycurl.POSTFIELDS, data)
+    elif method == 'OPTIONS':
+        curl.setopt(pycurl.CUSTOMREQUEST, 'OPTIONS')
+    elif method != 'GET':
+        curl.setopt(pycurl.CUSTOMREQUEST, method)
+        if data is not None:
+            curl.setopt(pycurl.POSTFIELDS, data)
+
+    status_code = 0
+    try:
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+
+    response_headers = {}
+    for line in header_lines:
+        if ':' not in line:
+            continue
+        key, value = line.split(':', 1)
+        key = key.strip().lower()
+        value = value.strip()
+        if key in response_headers and key == 'link':
+            response_headers[key] = response_headers[key] + ', ' + value
+        else:
+            response_headers[key] = value
+
+    response = Response(status_code, response_headers,
+                        _decode_body(body.getvalue(), response_headers))
+    return response
