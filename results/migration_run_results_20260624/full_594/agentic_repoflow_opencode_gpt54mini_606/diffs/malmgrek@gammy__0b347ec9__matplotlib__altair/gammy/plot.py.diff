+def _as_1d(values):
+    return np.asarray(values).reshape(-1)
+
+
+def _native(value):
+    return value.item() if hasattr(value, "item") else value
+
+
+def _css_color(color):
+    return {
+        "r": "red",
+        "g": "green",
+        "b": "blue",
+        "c": "cyan",
+        "m": "magenta",
+        "y": "yellow",
+        "k": "black",
+        "w": "white",
+    }.get(color, color)
+
+
+def _heatmap_chart(x, y, values, width=350, height=350, **kwargs):
+    data = [
+        {"x": _native(xv), "y": _native(yv), "value": _native(vv)}
+        for xv, yv, vv in zip(_as_1d(x), _as_1d(y), _as_1d(values))
+    ]
+    return alt.Chart(data).mark_rect(**kwargs).encode(
+        x=alt.X("x:Q", title=None),
+        y=alt.Y("y:Q", title=None),
+        color=alt.Color("value:Q", scale=alt.Scale(type="symlog"))
+    ).properties(width=width, height=height)
 
 
