+    async def _request(self, method, url, **kwargs):
+        timeout = kwargs.pop('timeout', None)
+        if timeout is not None:
+            kwargs['timeout'] = aiohttp.ClientTimeout(total=timeout)
+        kwargs.pop('stream', None)
