+                return self.session.put(request_url, params=params, json=body)
+            if method == "DELETE":
+                return self.session.delete(request_url, params=params)
+        except (aiohttp.ClientError, asyncio.TimeoutError, OSError) as exc:
+            raise ConnectionUnavailableError(message=str(exc)) from None
+
+        raise ValueError(f"Unsupported method: {method}")
