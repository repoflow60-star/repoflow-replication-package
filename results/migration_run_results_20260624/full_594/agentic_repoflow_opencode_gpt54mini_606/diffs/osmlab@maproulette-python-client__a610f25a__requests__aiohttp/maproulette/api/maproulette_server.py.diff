+class _AiohttpResponse:
+    def __init__(self, status_code, text):
+        self.status = status_code
+        self.status_code = status_code
+        self.text = text
+
+    @property
+    def ok(self):
+        try:
+            return int(self.status_code) < 400
+        except (TypeError, ValueError):
+            return True
+
+    def json(self):
+        return json.loads(self.text)
+
+
+class _AiohttpSession:
+    def __init__(self):
+        self.headers = {}
+        self.verify = True
+        self.certs = None
+
+    def _ssl_context(self):
+        if not self.verify and not self.certs:
+            return False
+
+        context = ssl.create_default_context()
+        if not self.verify:
+            context.check_hostname = False
+            context.verify_mode = ssl.CERT_NONE
+
+        if self.certs:
+            if isinstance(self.certs, tuple):
+                context.load_cert_chain(*self.certs)
+            else:
+                context.load_cert_chain(self.certs)
+
+        return context
+
+    @staticmethod
+    def _form_data(body):
+        form_data = aiohttp.FormData()
+        for key, value in body.items():
+            if isinstance(value, tuple):
+                filename = value[0] if len(value) > 0 else None
+                content = value[1] if len(value) > 1 else None
+                content_type = value[2] if len(value) > 2 else None
+                headers = value[3] if len(value) > 3 else None
+                field_kwargs = {}
+                if filename is not None:
+                    field_kwargs["filename"] = filename
+                if content_type is not None:
+                    field_kwargs["content_type"] = content_type
+                if headers is not None:
+                    field_kwargs["headers"] = headers
+                form_data.add_field(key, content, **field_kwargs)
+            else:
+                form_data.add_field(key, value)
+        return form_data
+
+    async def _request(self, method, url, params=None, json_body=None, files=None):
+        request_kwargs = {
+            "params": params,
+            "ssl": self._ssl_context(),
+        }
+        if files is not None:
+            request_kwargs["data"] = self._form_data(files)
+        elif json_body is not None:
+            request_kwargs["json"] = json_body
+
+        async with aiohttp.ClientSession(headers=self.headers) as session:
+            async with session.request(method, url, **request_kwargs) as response:
+                return _AiohttpResponse(response.status, await response.text())
+
+    def _run_request(self, method, url, params=None, json_body=None, files=None):
+        return asyncio.run(self._request(method, url, params=params, json_body=json_body, files=files))
+
+    def get(self, url, params=None):
+        return self._run_request("GET", url, params=params)
+
+    def post(self, url, params=None, json=None):
+        return self._run_request("POST", url, params=params, json_body=json)
+
+    def put(self, url, params=None, json=None, files=None):
+        return self._run_request("PUT", url, params=params, json_body=json, files=files)
+
+    def delete(self, url, params=None):
+        return self._run_request("DELETE", url, params=params)
+
+
+requests = types.SimpleNamespace(Session=_AiohttpSession)
 
 
