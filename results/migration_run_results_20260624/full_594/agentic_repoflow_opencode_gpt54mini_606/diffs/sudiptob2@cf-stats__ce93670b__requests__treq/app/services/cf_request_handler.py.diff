+    _reactor_ready = Event()
+    _reactor_lock = Lock()
+    _reactor_started = False
+
+    @classmethod
+    def _ensure_reactor(cls):
+        """Start the Twisted reactor once for blocking treq calls."""
+        if cls._reactor_started:
+            return
+
+        with cls._reactor_lock:
+            if cls._reactor_started:
+                return
+
+            def _run_reactor():
+                reactor.callWhenRunning(cls._reactor_ready.set)
+                reactor.run(installSignalHandlers=False)
+
+            Thread(target=_run_reactor, daemon=True).start()
+            cls._reactor_ready.wait()
+            cls._reactor_started = True
+
+    @classmethod
+    def _request_json(cls, url):
+        """Fetch and decode a JSON payload using treq."""
+        cls._ensure_reactor()
+
+        def _fetch():
+            response = treq.get(url, reactor=reactor)
+            return treq.json_content(response)
+
+        return threads.blockingCallFromThread(reactor, _fetch)
 
