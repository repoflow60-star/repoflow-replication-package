+class _Line:
+    def __init__(self, x, y):
+        self._xydata = np.column_stack([np.asarray(x), np.asarray(y)])
+
+    def get_xydata(self):
+        return self._xydata
+
+
+class _Path:
+    def __init__(self, vertices):
+        self.vertices = np.asarray(vertices)
+
+
+class _Collection:
+    def __init__(self, vertices):
+        self._paths = [_Path(vertices)]
+
+    def get_paths(self):
+        return self._paths
+
+
+class _Patch:
+    def __init__(self, height):
+        self._height = height
+
+    def get_height(self):
+        return self._height
+
+
+class _AxisCompat:
+    def __init__(self):
+        self.lines = []
+        self.collections = []
+        self.patches = []
 
 
