+class _CookieJar:
+    def __init__(self):
+        self._cookies = {}
+
+    def clear(self):
+        self._cookies.clear()
+
+    def as_dict(self):
+        return dict(self._cookies)
+
+    def update(self, cookies):
+        for name, morsel in cookies.items():
+            value = getattr(morsel, "value", morsel)
+            self._cookies[name] = value
