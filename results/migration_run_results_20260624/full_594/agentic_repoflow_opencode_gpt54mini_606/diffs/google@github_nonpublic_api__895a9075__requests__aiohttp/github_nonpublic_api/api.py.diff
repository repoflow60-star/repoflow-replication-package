+class _AiohttpSession:
+    def __init__(self):
+        self.cookies = _CookieJar()
+
+    def get(self, url):
+        return self._request("GET", url)
+
+    def post(self, url, data=None):
+        return self._request("POST", url, data=data)
+
+    def _request(self, method, url, data=None):
+        return asyncio.run(self._request_async(method, url, data=data))
+
+    async def _request_async(self, method, url, data=None):
+        async with aiohttp.ClientSession(cookies=self.cookies.as_dict()) as session:
+            async with session.request(method, url, data=data) as response:
+                response.raise_for_status()
+                body = await response.read()
+                text = body.decode(response.charset or "utf-8", errors="replace")
+                self.cookies.update(session.cookie_jar.filter_cookies(response.url))
+                return _Response(
