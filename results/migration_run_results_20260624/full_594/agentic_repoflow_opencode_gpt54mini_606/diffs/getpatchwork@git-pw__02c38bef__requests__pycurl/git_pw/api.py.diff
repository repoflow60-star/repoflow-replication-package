+            curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+
+        if headers:
+            curl.setopt(pycurl.HTTPHEADER, headers)
+
+        if method == 'POST':
+            curl.setopt(pycurl.POSTFIELDS, urlencode(data or [], doseq=True))
+        elif method == 'PATCH':
+            curl.setopt(pycurl.POSTFIELDS, urlencode(data or [], doseq=True))
+            curl.setopt(pycurl.CUSTOMREQUEST, 'PATCH')
+        elif method == 'DELETE':
