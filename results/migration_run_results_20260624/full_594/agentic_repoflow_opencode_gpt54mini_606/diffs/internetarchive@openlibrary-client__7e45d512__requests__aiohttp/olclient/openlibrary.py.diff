+class _AiohttpResponse:
+    def __init__(self, *, url, status, headers, body, method):
+        self.url = url
+        self.status = status
+        self.headers = headers
+        self._body = body
+        self._method = method
+
+    def json(self):
+        return self._body
+
+    def raise_for_status(self):
+        if 400 <= self.status:
+            raise aiohttp.ClientResponseError(
+                request_info=SimpleNamespace(real_url=self.url, method=self._method),
+                history=(),
+                status=self.status,
+                message=str(self._body),
+                headers=self.headers,
+            )
+
+
+class _AiohttpSession:
+    def __init__(self, base_url):
+        self._base_url = base_url
+        self._loop = asyncio.new_event_loop()
+        self._cookie_jar = aiohttp.CookieJar(unsafe=True, loop=self._loop)
+
+    @property
+    def cookies(self):
+        return self._cookie_jar.filter_cookies(self._base_url)
+
+    def get(self, url, **kwargs):
+        return self._request('GET', url, **kwargs)
+
+    def post(self, url, data=None, json=None, **kwargs):
+        if data is not None:
+            kwargs['data'] = data
+        if json is not None:
+            kwargs['json'] = json
+        return self._request('POST', url, **kwargs)
+
+    def put(self, url, data=None, json=None, **kwargs):
+        if data is not None:
+            kwargs['data'] = data
+        if json is not None:
+            kwargs['json'] = json
+        return self._request('PUT', url, **kwargs)
+
+    def close(self):
+        if not self._loop.is_closed():
+            self._loop.close()
+
+    def _request(self, method, url, **kwargs):
+        return self._loop.run_until_complete(self._request_async(method, url, **kwargs))
+
+    async def _request_async(self, method, url, **kwargs):
+        files = kwargs.pop('files', None)
+        if files is not None:
+            form_data = aiohttp.FormData()
+            for name, value in files.items():
+                if isinstance(value, tuple):
+                    if len(value) == 2:
+                        filename, field_value = value
+                        form_data.add_field(
+                            name,
+                            field_value,
+                            filename='' if filename is None else filename,
+                        )
+                    elif len(value) == 3:
+                        filename, field_value, content_type = value
+                        form_data.add_field(
+                            name,
+                            field_value,
+                            filename='' if filename is None else filename,
+                            content_type=content_type,
+                        )
+                    else:
+                        form_data.add_field(name, value[1])
+                else:
+                    form_data.add_field(name, value, filename='')
+            kwargs['data'] = form_data
+
+        async with aiohttp.ClientSession(cookie_jar=self._cookie_jar) as session:
+            async with session.request(method, url, **kwargs) as response:
+                try:
+                    body = await response.json(content_type=None)
+                except (aiohttp.ContentTypeError, ValueError):
+                    body = await response.text()
+                return _AiohttpResponse(
+                    url=str(response.url),
+                    status=response.status,
+                    headers=response.headers,
+                    body=body,
+                    method=method,
+                )
 
 
