+class _HTTPError(RuntimeError):
+    def __init__(self, response):
+        super().__init__(f"{response.status_code} Error for url: {response.url}")
+        self.response = response
+
+
+class _HistoryResponse:
+    def __init__(self, url: str):
+        self.url = url
+
+
+class _Response:
+    def __init__(self, response, url: str, history):
+        self._response = response
+        self.status_code = response.status
+        self.url = url
+        self.history = history
+        self.content = response.data
+        self.text = _decode_body(response.headers, response.data)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise _HTTPError(self)
+
+
+class _CookieJar:
+    def __init__(self):
+        self._cookies = {}
+
+    def clear(self):
+        self._cookies.clear()
+
+    def get_header(self):
+        if not self._cookies:
+            return None
+        return "; ".join(f"{key}={value}" for key, value in self._cookies.items())
+
+    def update(self, headers):
+        set_cookie_values = []
+        getlist = getattr(headers, "getlist", None)
+        if callable(getlist):
+            set_cookie_values = getlist("Set-Cookie") or getlist("set-cookie")
+        else:
+            get_all = getattr(headers, "get_all", None)
+            if callable(get_all):
+                set_cookie_values = get_all("Set-Cookie") or []
+            else:
+                cookie = headers.get("Set-Cookie")
+                if cookie:
+                    set_cookie_values = [cookie]
+
+        for cookie_header in set_cookie_values:
+            jar = http.cookies.SimpleCookie()
+            jar.load(cookie_header)
+            for key, morsel in jar.items():
+                self._cookies[key] = morsel.value
+
+
+class _Session:
+    def __init__(self):
+        self._pool = urllib3.PoolManager()
+        self.cookies = _CookieJar()
+
+    def get(self, url: str):
+        return self._request("GET", url)
+
+    def post(self, url: str, data=None):
+        return self._request("POST", url, data=data)
+
+    def _request(self, method: str, url: str, data=None):
+        history = []
+        body = None
+        if data is not None:
+            body = urlencode(data).encode("utf-8")
+
+        for _ in range(10):
+            headers = {}
+            cookie_header = self.cookies.get_header()
+            if cookie_header:
+                headers["Cookie"] = cookie_header
+            if body is not None:
+                headers["Content-Type"] = "application/x-www-form-urlencoded"
+
+            response = self._pool.request(
+                method,
+                url,
+                body=body,
+                headers=headers or None,
+                redirect=False,
+            )
+            self.cookies.update(response.headers)
+
+            if response.status not in (301, 302, 303, 307, 308):
+                return _Response(response, url, history)
+
+            location = response.headers.get("Location")
+            if not location:
+                return _Response(response, url, history)
+
+            history.append(_HistoryResponse(url))
+            url = urljoin(url, location)
+            if response.status in (301, 302, 303):
+                method = "GET"
+                body = None
+
+        return _Response(response, url, history)
+
+
+def _decode_body(headers, data):
+    content_type = headers.get("Content-Type", "")
+    match = re.search(r"charset=([^;\s]+)", content_type)
+    encoding = match.group(1) if match else "utf-8"
+    return data.decode(encoding, errors="replace")
 
 
