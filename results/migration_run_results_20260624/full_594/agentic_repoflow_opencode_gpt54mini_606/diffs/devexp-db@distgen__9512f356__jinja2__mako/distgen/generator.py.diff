+class _UndefinedTemplateValue(object):
+    def __bool__(self):
+        return False
+
+    __nonzero__ = __bool__
+
+    def __iter__(self):
+        return iter(())
+
+    def __len__(self):
+        return 0
+
+    def __getattr__(self, name):
+        return self
+
+    def __getitem__(self, key):
+        return self
+
+    def __repr__(self):
+        return "UNDEFINED"
+
+    def __str__(self):
+        return ""
+
+
+_UNDEFINED = _UndefinedTemplateValue()
+
+
+class _TemplateMapping(object):
+    def __init__(self, value):
+        self._value = value
+
+    def __getattr__(self, name):
+        if isinstance(self._value, Mapping) and name in self._value:
+            return _template_wrap(self._value[name])
+        return _UNDEFINED
+
+    def __getitem__(self, key):
+        if isinstance(self._value, Mapping):
+            return _template_wrap(self._value.get(key, _UNDEFINED))
+        return _UNDEFINED
+
+    def __iter__(self):
+        if isinstance(self._value, Mapping):
+            return iter(self._value)
+        return iter(())
+
+    def __len__(self):
+        if isinstance(self._value, Mapping):
+            return len(self._value)
+        return 0
+
+    def __bool__(self):
+        return bool(self._value)
+
+    __nonzero__ = __bool__
+
+
+class _TemplateSequence(object):
+    def __init__(self, value):
+        self._value = value
+
+    def __iter__(self):
+        if isinstance(self._value, Sequence):
+            for item in self._value:
+                yield _template_wrap(item)
+        return
+
+    def __getitem__(self, key):
+        if isinstance(self._value, Sequence):
+            try:
+                return _template_wrap(self._value[key])
+            except (IndexError, TypeError):
+                return _UNDEFINED
+        return _UNDEFINED
+
+    def __len__(self):
+        if isinstance(self._value, Sequence):
+            return len(self._value)
+        return 0
+
+    def __bool__(self):
+        return bool(self._value)
+
+    __nonzero__ = __bool__
+
+
+def _template_wrap(value):
+    if value is _UNDEFINED:
+        return value
+    if isinstance(value, Mapping):
+        return _TemplateMapping(value)
+    if isinstance(value, Sequence) and not isinstance(value, (str, bytes, bytearray)):
+        return _TemplateSequence(value)
+    return value
+
+
+def _template_defined(value):
+    return value is not _UNDEFINED
+
