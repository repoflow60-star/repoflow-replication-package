+            if file is not None:
+                if os.path.exists(file):
+                    with open(file, "r") as file_handle:
+                        response["source"] = file_handle.read()
+                    self.set_header("Content-Type", "application/json")
+                    self.finish(json.dumps(response))
+                    return
+        self.set_header("Content-Type", "application/json")
+        self.finish(json.dumps(response))
+
