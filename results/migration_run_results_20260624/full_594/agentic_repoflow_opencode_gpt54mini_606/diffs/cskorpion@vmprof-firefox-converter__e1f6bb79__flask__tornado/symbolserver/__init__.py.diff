+class BaseHandler(tornado.web.RequestHandler):
+    def set_default_headers(self):
+        self.set_header("Access-Control-Allow-Origin", "*")
+        self.set_header("Access-Control-Allow-Headers", "Content-Type")
+        self.set_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
+
+    def options(self):
+        self.set_status(204)
+        self.finish()
+
+
+class ProfileHandler(BaseHandler):
+    def get(self):
+        if profilepath is not None and os.path.exists(profilepath):
+            with open(profilepath, "r") as profile_file:
+                self.set_header("Content-Type", "application/json")
+                self.finish(json.dumps(profile_file.read()))
+        else:
+            self.finish("")
+
+
+class SourceHandler(BaseHandler):
+    def post(self):
+        response = {
+            "symbolsLastModified": None,
+            "sourceLastModified": None,
+            "file": "",
+            "source": ""
+        }
+        if self.request.body is not None:
+            jsonobj = json.loads(self.request.body)
+            response["file"] = jsonobj["file"]
+            file = response["file"]
+            if path_dict is not None:
+                if file in path_dict:
