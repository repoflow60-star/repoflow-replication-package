--- a/PyALE/_src/plot_compat.py
+++ b/PyALE/_src/plot_compat.py
@@ -0,0 +1,127 @@
+import numpy as np
+
+
+class _PlotlyPath:
+    def __init__(self, vertices):
+        self.vertices = np.asarray(vertices)
+
+
+class _PlotlyCollection:
+    def __init__(self, vertices):
+        self._paths = [_PlotlyPath(vertices)]
+
+    def get_paths(self):
+        return self._paths
+
+
+class _PlotlyLine:
+    def __init__(self, x, y):
+        self._xydata = np.column_stack([np.asarray(x), np.asarray(y)])
+
+    def get_xydata(self):
+        return self._xydata
+
+
+class _PlotlyImage:
+    def __init__(self, array):
+        self._array = np.asarray(array)
+
+    def get_array(self):
+        return self._array
+
+
+class _PlotlyPatch:
+    def __init__(self, height):
+        self._height = height
+
+    def get_height(self):
+        return self._height
+
+
+class PlotlyAxesAdapter:
+    def __init__(self, figure, secondary_y=False):
+        self.figure = figure
+        self.secondary_y = secondary_y
+        self.lines = []
+        self.collections = []
+        self.images = []
+        self.patches = []
+
+    def add_line(self, x, y):
+        line = _PlotlyLine(x, y)
+        self.lines.append(line)
+        return line
+
+    def add_collection(self, vertices):
+        collection = _PlotlyCollection(vertices)
+        self.collections.append(collection)
+        return collection
+
+    def add_image(self, array):
+        image = _PlotlyImage(array)
+        self.images.append(image)
+        return image
+
+    def add_patch(self, height):
+        patch = _PlotlyPatch(height)
+        self.patches.append(patch)
+        return patch
+
+    def plot(self, x, y=None, *args, **kwargs):
+        if y is None:
+            y = np.asarray(x)
+            x = np.arange(len(y))
+        return self.add_line(x, y)
+
+    def fill_between(self, x, y1, y2, *args, **kwargs):
+        vertices = np.vstack(
+            [np.column_stack([np.asarray(x), np.asarray(y1)]), np.column_stack([np.asarray(x)[::-1], np.asarray(y2)[::-1]])]
+        )
+        return self.add_collection(vertices)
+
+    def errorbar(self, x, y, yerr=None, *args, **kwargs):
+        self.add_line(x, y)
+        if yerr is not None:
+            y = np.asarray(y)
+            x = np.asarray(x)
+            self.add_line(np.concatenate(([x[0]], x)), np.concatenate(([np.nan], y - yerr)))
+            self.add_line(np.concatenate(([x[0]], x)), np.concatenate(([np.nan], y + yerr)))
+        return self.lines[-1]
+
+    def bar(self, x, height, *args, **kwargs):
+        for value in height:
+            self.add_patch(value)
+        return self.patches
+
+    def twinx(self):
+        return PlotlyAxesAdapter(self.figure, secondary_y=True)
+
+    def imshow(self, array, *args, **kwargs):
+        return self.add_image(array)
+
+    def contour(self, *args, **kwargs):
+        return None
+
+    def clabel(self, *args, **kwargs):
+        return None
+
+    def legend(self, *args, **kwargs):
+        return None
+
+    def set_xlabel(self, label):
+        self.figure.update_xaxes(title_text=label)
+
+    def set_ylabel(self, label, color=None):
+        if self.secondary_y:
+            try:
+                self.figure.update_yaxes(title_text=label, secondary_y=True)
+            except Exception:
+                self.figure.update_layout(yaxis2=dict(title=label))
+        else:
+            self.figure.update_yaxes(title_text=label)
+
+    def set_title(self, title):
+        self.figure.update_layout(title=title)
+
+    def tick_params(self, *args, **kwargs):
+        return None
