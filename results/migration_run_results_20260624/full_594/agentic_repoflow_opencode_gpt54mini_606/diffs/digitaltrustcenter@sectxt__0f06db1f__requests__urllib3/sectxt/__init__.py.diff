+
+def _response_content(resp):
+    return getattr(resp, "data", getattr(resp, "content", b""))
+
+
+def _response_history(resp):
+    history = getattr(resp, "history", None)
+    if history:
+        return list(history)
+    retries = getattr(resp, "retries", None)
+    if retries is not None:
+        return [
+            item
+            for item in (getattr(retries, "history", ()) or ())
+            if getattr(item, "redirect_location", None)
+        ]
+    return []
+
+
+def _response_url(resp):
+    url = getattr(resp, "url", None)
+    if url:
+        return url
+    geturl = getattr(resp, "geturl", None)
+    if callable(geturl):
+        try:
+            return geturl()
+        except TypeError:
+            return None
+    return None
+
+
+def _is_ssl_error(exc):
+    if isinstance(exc, urllib3.exceptions.SSLError):
+        return True
+    if isinstance(exc, urllib3.exceptions.MaxRetryError):
+        reason = getattr(exc, "reason", None)
+        return isinstance(reason, (ssl.SSLError, urllib3.exceptions.SSLError))
+    return False
 
 
