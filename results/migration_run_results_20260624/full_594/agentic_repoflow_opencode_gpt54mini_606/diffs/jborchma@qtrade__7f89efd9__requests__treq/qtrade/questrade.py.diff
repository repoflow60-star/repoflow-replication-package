+class _TreqResponse:
+    """Minimal response wrapper for the synchronous API used by this module."""
+
+    def __init__(self, code: int, payload: Any):
+        self.code = code
+        self.status_code = code
+        self._payload = payload
+
+    def raise_for_status(self):
+        if self.code >= 400:
+            raise Exception(f"HTTP error {self.code}")
+
+    def json(self):
+        return self._payload
+
+
+def _append_params(url: str, params: Optional[Dict]) -> str:
+    if not params:
+        return url
+
+    parts = urlsplit(url)
+    encoded = urlencode(params, doseq=True)
+    if parts.query:
+        encoded = parts.query + "&" + encoded
+    return urlunsplit((parts.scheme, parts.netloc, parts.path, encoded, parts.fragment))
+
+
+def _normalize_body(data: Optional[Dict]) -> Optional[bytes]:
+    if data is None:
+        return None
+    if isinstance(data, bytes):
+        return data
+    if isinstance(data, str):
+        return data.encode("utf-8")
+    return urlencode(data, doseq=True).encode("utf-8")
+
+
+def _start_reactor():
+    reactor.callWhenRunning(_REACTOR_READY.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor_running():
+    global _REACTOR_STARTED
+
+    if reactor.running:
+        _REACTOR_READY.set()
+        return
+
+    with _REACTOR_LOCK:
+        if not reactor.running and not _REACTOR_STARTED:
+            thread = threading.Thread(
+                target=_start_reactor,
+                name="qtrade-treq-reactor",
+                daemon=True,
+            )
+            thread.start()
+            _REACTOR_STARTED = True
+
+    _REACTOR_READY.wait()
+
+
+def _treq_request(
+    method: str,
+    url: str,
+    params: Optional[Dict] = None,
+    data: Optional[Dict] = None,
+    json_payload: Optional[Dict] = None,
+    headers: Optional[Dict[str, str]] = None,
+    timeout: Optional[int] = None,
+) -> _TreqResponse:
+    _ensure_reactor_running()
+
+    def _do_request():
+        request_url = _append_params(url, params)
+        request_headers = dict(headers or {})
+        body = _normalize_body(data)
+
+        if json_payload is not None:
+            body = json_module.dumps(json_payload).encode("utf-8")
+            request_headers.setdefault("Content-Type", "application/json")
+
+        deferred = treq.request(
+            method,
+            request_url,
+            data=body,
+            headers=request_headers or None,
+            timeout=timeout,
+        )
+
+        def _wrap_response(response):
+            def _decode(body_bytes):
+                if response.code >= 400:
+                    raise Exception(
+                        f"HTTP error {response.code}: {body_bytes.decode(errors='replace')}"
+                    )
+                return _TreqResponse(response.code, json_module.loads(body_bytes.decode("utf-8")))
+
+            return treq.content(response).addCallback(_decode)
+
+        return deferred.addCallback(_wrap_response)
+
+    return threads.blockingCallFromThread(reactor, _do_request)
