+def get_evaluate_router(get_dao, get_executor_pool) -> Blueprint:
+    @contextmanager
+    def _provided_dependency(request, provider):
+        dependency_provider = request.app.dependency_overrides.get(provider, provider)
+        dependency = dependency_provider()
+        if hasattr(dependency, "__enter__"):
+            with dependency as value:
+                yield value
+            return
+        if hasattr(dependency, "__next__"):
+            try:
+                yield next(dependency)
+            finally:
+                close = getattr(dependency, "close", None)
+                if close is not None:
+                    close()
+            return
+        yield dependency
+
+    def _validation_error_response(exc: ValidationError):
+        detail = []
+        for error in exc.errors():
+            normalized = dict(error)
+            loc = tuple(normalized.get("loc", ()))
+            if not loc or loc[0] != "body":
+                normalized["loc"] = ("body", *loc)
+            detail.append(normalized)
+        return data_science_json_response({"detail": detail}, status=422)
+
