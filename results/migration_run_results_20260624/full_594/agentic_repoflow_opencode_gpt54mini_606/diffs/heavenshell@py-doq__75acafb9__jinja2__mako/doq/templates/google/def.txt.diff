--- a/doq/templates/google/def.txt
+++ b/doq/templates/google/def.txt
@@ -1,11 +1,18 @@
-"""{{ name }}.
-
-Args:
-{%- for p in params %}
-    {{ p.argument }}{% if p.annotation %} ({{ p.annotation }}): {{ p.argument }}{% else %}:{% endif -%}
-{% endfor %}
-{% if return_type %}
-Returns:
-    {{ return_type }}:
-{% endif -%}
-"""
+<%
+parts = ['"""%s.' % name]
+if params or return_type:
+    parts.append('')
+    if params:
+        parts.append('Args:')
+        for p in params:
+            if p.get('annotation'):
+                parts.append('    %s (%s): %s' % (p['argument'], p['annotation'], p['argument']))
+            else:
+                parts.append('    %s:' % p['argument'])
