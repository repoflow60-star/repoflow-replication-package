--- a/doq/templates/numpy/def.txt
+++ b/doq/templates/numpy/def.txt
@@ -1,15 +1,22 @@
-"""{{ name }}.
-
-Parameters
-----------
-{% for p in params -%}
-{{ p.argument }} :{% if p.annotation %} {{ p.annotation }}{% endif %}
-    {{ p.argument }}
-{% endfor %}
-{%- if return_type %}
-Returns
--------
-{{ return_type }}
-
-{% endif -%}
-"""
+<%
+parts = ['"""%s.' % name]
+if params or return_type:
+    parts.append('')
+    if params:
+        parts.append('Parameters')
+        parts.append('----------')
+        for p in params:
+            line = '%s :' % p['argument']
