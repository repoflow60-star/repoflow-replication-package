--- a/doq/templates/sphinx/def.txt
+++ b/doq/templates/sphinx/def.txt
@@ -1,12 +1,12 @@
-"""{{ name }}.
-
-{% for p in params -%}
-:param {{ p.argument }}:
-{% if p.annotation -%}
-:type {{ p.argument }}: {{ p.annotation }}
-{% endif -%}
-{% endfor -%}
-{% if return_type -%}
-:rtype: {{ return_type }}
-{% endif -%}
-"""
+<%
+parts = ['"""%s.' % name]
+if params or return_type:
+    parts.append('')
+    for p in params:
+        parts.append(':param %s:' % p['argument'])
+        if p.get('annotation'):
+            parts.append(':type %s: %s' % (p['argument'], p['annotation']))
+    if return_type:
+        parts.append(':rtype: %s' % return_type)
+parts.append('"""')
+%>${'\n'.join(parts)}
