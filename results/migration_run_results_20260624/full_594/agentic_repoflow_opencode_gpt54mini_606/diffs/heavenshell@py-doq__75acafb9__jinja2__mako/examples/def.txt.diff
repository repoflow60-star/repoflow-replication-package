--- a/examples/def.txt
+++ b/examples/def.txt
@@ -1,24 +1,32 @@
-"""Summary of {{ name }}.
-{% if params %}
-Args:
-{%- for p in params %}
-    {{ p.argument }}{% if p.annotation %} ({{ p.annotation }}): Description of {{ p.argument }}.{% endif -%}{% if p.default %} Default to {{ p.default }}{% endif -%}
-{% endfor %}
-{% endif -%}
-{% if return_type %}
-Returns:
-    {{ return_type }}: Description of return value
-{% endif -%}
-{% if yields %}
-Yields:
-{%- for y in yields %}
-    {{ y }}:
-{%- endfor %}
-{% endif -%}
-{% if exceptions %}
-Raises:
-{%- for e in exceptions %}
-    {{ e }}:
-{%- endfor %}
-{% endif -%}
-"""
+<%
+parts = ['"""Summary of %s.' % name]
+if params or return_type or yields or exceptions:
+    parts.append('')
+    if params:
+        parts.append('Args:')
+        for p in params:
+            line = '    %s' % p['argument']
+            if p.get('annotation'):
+                line += ' (%s): Description of %s.' % (p['annotation'], p['argument'])
+            if p.get('default'):
+                line += ' Default to %s' % p['default']
+            parts.append(line)
+        if return_type or yields or exceptions:
+            parts.append('')
+    if return_type:
+        parts.append('Returns:')
+        parts.append('    %s: Description of return value' % return_type)
+        if yields or exceptions:
+            parts.append('')
+    if yields:
+        parts.append('Yields:')
+        for y in yields:
+            parts.append('    %s:' % y)
+        if exceptions:
+            parts.append('')
+    if exceptions:
+        parts.append('Raises:')
+        for e in exceptions:
+            parts.append('    %s:' % e)
+parts.append('"""')
+%>${'\n'.join(parts)}
