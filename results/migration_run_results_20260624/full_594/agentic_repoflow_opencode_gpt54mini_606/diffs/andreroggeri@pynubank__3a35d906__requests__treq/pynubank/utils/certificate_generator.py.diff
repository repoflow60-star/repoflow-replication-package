+        key = self._privatekey
+        cert = self._certificate
+
+        key_pem = None
+        if key is not None:
+            key_pem = OpenSSL.crypto.dump_privatekey(OpenSSL.crypto.FILETYPE_PEM, key)
+
+        cert_pem = None
+        if cert is not None:
+            cert_pem = OpenSSL.crypto.dump_certificate(OpenSSL.crypto.FILETYPE_PEM, cert)
+
+        private_key = None if key_pem is None else serialization.load_pem_private_key(key_pem, password=None)
+        certificate = None if cert_pem is None else x509.load_pem_x509_certificate(cert_pem)
+
+        return cryptography_pkcs12.serialize_key_and_certificates(
+            name=b'pynubank',
+            key=private_key,
+            cert=certificate,
+            cas=None,
+            encryption_algorithm=serialization.NoEncryption(),
+        )
+
+
