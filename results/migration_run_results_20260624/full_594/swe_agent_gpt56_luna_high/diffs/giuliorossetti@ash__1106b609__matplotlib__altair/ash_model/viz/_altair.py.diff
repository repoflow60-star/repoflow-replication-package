--- a/ash_model/viz/_altair.py
+++ b/ash_model/viz/_altair.py
@@ -0,0 +1,137 @@
+"""Small helpers shared by the Altair based visualizations.
+
+The public plotting functions intentionally return :class:`altair.Chart`
+objects.  Keeping the translation of the few commonly used plotting options
+in one place makes the functions tolerant of the style arguments that were
+accepted by the old plotting API, while avoiding a dependency on Matplotlib.
+"""
+
+from types import SimpleNamespace
+
+import altair as alt
+
+
+# ``plt.Axes`` used to be visible through ``ash_model.viz`` because the old
+# modules imported pyplot at module scope. Keeping this tiny compatibility
+# object lets old callers perform a type check without the legacy library.
+# New code should use ``alt.Chart`` directly.
+plt = SimpleNamespace(Axes=alt.Chart)
+
+
+_MARK_PROPERTIES = {
+    "angle",
+    "color",
+    "fill",
+    "fillOpacity",
+    "opacity",
+    "shape",
+    "size",
+    "stroke",
+    "strokeDash",
+    "strokeOpacity",
+    "strokeWidth",
+    "tooltip",
+}
+
+_CHART_PROPERTIES = {"background", "padding", "title", "width", "height"}
+
+
+_MARKER_SHAPES = {
+    ".": "circle",
+    "o": "circle",
+    "s": "square",
+    "^": "triangle-up",
+    "v": "triangle-down",
+    "<": "triangle-left",
+    ">": "triangle-right",
+    "D": "diamond",
+    "d": "diamond",
+    "*": "star",
+    "+": "cross",
+    "x": "cross",
+}
+
+
+def plotting_options(options):
+    """Translate common legacy plotting options to Altair options.
+
+    Altair is declarative, so options such as ``label`` and ``ax`` do not
+    have a direct equivalent.  They are consumed here rather than passed on
+    to Altair, which keeps the plotting functions backwards-friendly and
+    prevents unrelated keyword arguments from becoming schema errors.
+    """
+
+    options = dict(options)
+    options.pop("ax", None)
+    options.pop("label", None)
+
+    mark = {}
+    properties = {}
+
+    aliases = {
+        "alpha": "opacity",
+        "lw": "strokeWidth",
+        "linewidth": "strokeWidth",
+        "markersize": "size",
+    }
+    for old_name, new_name in aliases.items():
+        if old_name in options and new_name not in options:
+            options[new_name] = options.pop(old_name)
+
+    if "marker" in options:
+        marker = options.pop("marker")
+        options.setdefault("shape", _MARKER_SHAPES.get(marker, marker))
+
+    for name in list(options):
+        if name in _MARK_PROPERTIES:
+            mark[name] = options.pop(name)
+        elif name in _CHART_PROPERTIES:
+            properties[name] = options.pop(name)
+
+    # ``figsize`` is a common Matplotlib option.  Accept a pair of pixels as
+    # a useful Altair equivalent, while ignoring the other Matplotlib-only
+    # options (grid, linestyle, and so on) instead of raising an exception.
+    figsize = options.pop("figsize", None)
+    if figsize is not None:
+        if len(figsize) != 2:
+            raise ValueError("figsize must contain (width, height)")
+        properties.setdefault("width", figsize[0] * 100)
+        properties.setdefault("height", figsize[1] * 100)
+
+    return mark, properties
+
+
+def scale(log=False, domain=None):
+    """Return an Altair scale, omitting it when no customization is needed."""
+
+    if log or domain is not None:
+        options = {"type": "log" if log else "linear"}
+        if domain is not None:
+            options["domain"] = domain
+        return alt.Scale(**options)
+    return None
+
+
+def chart_data(rows):
+    """Wrap inline rows in the Altair data schema used by Altair 6."""
+
+    return alt.Data(values=list(rows))
+
+
+def apply_properties(chart, properties):
+    """Apply chart properties only when there is something to apply."""
+
+    return chart.properties(**properties) if properties else chart
+
+
+def python_value(value):
+    """Convert NumPy/Pandas scalar values into JSON-friendly Python values."""
+
+    item = getattr(value, "item", None)
+    if callable(item):
+        try:
+            return item()
+        except ValueError:
+            pass
+    return value
+
