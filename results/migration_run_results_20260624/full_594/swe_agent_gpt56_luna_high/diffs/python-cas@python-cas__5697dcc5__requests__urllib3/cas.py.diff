+def _request_get(session, url, params=None, stream=False):
+    """Make a GET request using an urllib3 manager or a custom session.
+
+    urllib3's :class:`PoolManager` exposes ``request`` rather than the
+    convenience methods provided by higher-level HTTP clients.  Keeping the
+    small amount of dispatching here also means that callers can continue to
+    provide a session object with a ``get`` method (as supported by the public API).
+    """
+    get = getattr(session, 'get', None)
+    if callable(get):
+        kwargs = {}
+        if params is not None:
+            kwargs['params'] = params
+        if stream:
+            kwargs['stream'] = True
+        return get(url, **kwargs)
+
+    kwargs = {}
+    if params is not None:
+        kwargs['fields'] = params
+    if stream:
+        kwargs['preload_content'] = False
+    return session.request('GET', url, **kwargs)
+
+
+def _request_post(session, url, body, params=None, headers=None):
+    """Make a POST request using urllib3's request API."""
+    post = getattr(session, 'post', None)
+    if callable(post):
+        kwargs = {'data': body}
+        if params is not None:
+            kwargs['params'] = params
+        if headers is not None:
+            kwargs['headers'] = headers
+        return post(url, **kwargs)
+
+    # urllib3 uses ``fields`` for POST bodies, so query parameters must be
+    # added to the URL when a separate request body is being sent.
+    if params:
+        separator = '&' if '?' in url else '?'
+        url = ''.join([url, separator, urllib_parse.urlencode(params)])
+    kwargs = {'body': body}
+    if headers is not None:
+        kwargs['headers'] = headers
+    return session.request('POST', url, **kwargs)
+
+
+def _response_status(response):
+    """Return the status from either an urllib3 or compatible response."""
+    status = getattr(response, 'status', None)
+    if isinstance(status, int):
+        return status
+    return getattr(response, 'status_code', status)
+
+
+def _response_content(response):
+    """Return response bytes for urllib3 and response-like custom objects."""
+    # Custom sessions may return response objects that expose ``content``.
+    # urllib3 HTTPResponse exposes the body as ``data``.
+    content = getattr(response, 'content', None)
+    if isinstance(content, (bytes, bytearray, str)):
+        return content
+    return response.data
+
+
+def _response_lines(response, chunk_size):
+    """Yield decoded response lines from compatible or urllib3 responses."""
+    iter_lines = getattr(response, 'iter_lines', None)
+    if callable(iter_lines):
+        lines = iter_lines(chunk_size=chunk_size)
+    else:
+        def stream_lines():
+            pending = b''
+            for chunk in response.stream(amt=chunk_size):
+                if isinstance(chunk, str):
+                    chunk = chunk.encode('utf-8')
+                pending += chunk
+                split = pending.split(b'\n')
+                pending = split.pop()
+                for line in split:
+                    yield line.rstrip(b'\r')
+            if pending:
+                yield pending.rstrip(b'\r')
+
+        lines = stream_lines()
+
+    for line in lines:
+        if isinstance(line, bytes):
+            line = line.decode('utf-8')
+        yield line
+
 
