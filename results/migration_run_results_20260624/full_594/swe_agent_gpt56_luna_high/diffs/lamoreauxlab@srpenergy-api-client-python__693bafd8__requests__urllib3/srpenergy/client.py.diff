+class _Urllib3Session:
+    """Small session wrapper providing the behavior used by the client.
+
+    ``urllib3`` does not provide a high-level session or cookie jar like
+    ``requests``.  The SRP API needs both form POSTs and the cookie returned
+    by the anti-forgery endpoint, so keep that small amount of state here.
+    """
+
+    def __init__(self):
+        self._pool = urllib3.PoolManager()
+        self._cookies = {}
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        self._pool.clear()
+        return False
+
+    def _request(self, method, url, fields=None, headers=None):
+        request_headers = dict(headers or {})
+        if self._cookies and not any(
+            key.lower() == "cookie" for key in request_headers
+        ):
+            request_headers["Cookie"] = "; ".join(
+                f"{name}={value}" for name, value in self._cookies.items()
+            )
+
+        if method == "POST" and fields is not None:
+            request_headers.setdefault(
+                "Content-Type", "application/x-www-form-urlencoded"
+            )
+            response = self._pool.request(
+                method,
+                url,
+                body=urlencode(fields).encode("utf-8"),
+                headers=request_headers,
+            )
+        else:
+            response = self._pool.request(
+                method, url, fields=fields, headers=request_headers
+            )
+
+        self._store_cookies(response)
+        return response
+
+    def _store_cookies(self, response):
+        response_headers = getattr(response, "headers", {})
+        if hasattr(response_headers, "getlist"):
+            set_cookie_headers = response_headers.getlist("Set-Cookie")
+        else:
+            set_cookie_headers = response_headers.get("Set-Cookie", [])
+
+        if isinstance(set_cookie_headers, str):
+            set_cookie_headers = [set_cookie_headers]
+
+        for header in set_cookie_headers:
+            cookies = SimpleCookie()
+            cookies.load(header)
+            for name, morsel in cookies.items():
+                self._cookies[name] = morsel.value
+
+    @property
+    def cookies(self):
+        """Return cookies collected from responses."""
+        return self._cookies
+
+    def post(self, url, data=None, headers=None):
+        """Send a form-encoded POST request."""
+        return self._request("POST", url, fields=data, headers=headers)
+
+    def get(self, url, headers=None):
+        """Send a GET request."""
+        return self._request("GET", url, headers=headers)
+
+
+class _RequestsCompatibility:
+    """Compatibility namespace for callers patching the former session API."""
+
+    Session = _Urllib3Session
+
+
+# Keep the old module path patchable without depending on the requests package.
+requests = _RequestsCompatibility()
