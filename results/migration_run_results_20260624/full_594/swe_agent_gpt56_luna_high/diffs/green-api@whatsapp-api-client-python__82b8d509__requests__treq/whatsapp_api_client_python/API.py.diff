+class _TreqResponse:
+    """Small synchronous response view used by the existing API surface.
+
+    treq returns a Deferred and exposes the response body through another
+    Deferred.  The public methods in this package are intentionally
+    synchronous, so the adapter below resolves both Deferreds before
+    returning a response with the attributes the rest of this package uses.
+    """
+
+    def __init__(self, status_code: int, body: bytes):
+        self.status_code = status_code
+        self.text = body.decode("utf-8", errors="replace")
+
+
+_reactor_lock = threading.Lock()
+_reactor_started = threading.Event()
+_reactor_thread: Optional[threading.Thread] = None
+
+
+def _run_reactor() -> None:
+    reactor.callWhenRunning(_reactor_started.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor() -> None:
+    """Start the Twisted reactor used by the synchronous compatibility layer."""
+
+    global _reactor_thread
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if not reactor.running and _reactor_thread is None:
+            _reactor_thread = threading.Thread(
+                target=_run_reactor,
+                name="whatsapp-api-treq-reactor",
+                daemon=True,
+            )
+            _reactor_thread.start()
+
+    _reactor_started.wait()
+
+
+def _request_with_treq(**arguments: Any) -> _TreqResponse:
+    """Execute a treq request and wait for its complete response body."""
+
+    def request() -> defer.Deferred:
+        deferred = defer.maybeDeferred(treq.request, **arguments)
+
+        def read_body(response: Any) -> defer.Deferred:
+            body = defer.maybeDeferred(treq.content, response)
+            return body.addCallback(
+                lambda content: _TreqResponse(response.code, content)
+            )
+
+        return deferred.addCallback(read_body)
+
+    _ensure_reactor()
+    return blockingCallFromThread(reactor, request)
+
+
+def _treq_file_value(value: Any) -> Any:
+    """Accept the legacy file tuple used by existing tool methods.
+
+    The previous HTTP client used ``(filename, file_object, content_type)``
+    while treq uses
+    ``(filename, content_type, file_object)``.  Supporting both forms keeps
+    the tool methods compatible while sending the request through treq.
+    """
+
+    if (
+        isinstance(value, tuple)
+        and len(value) == 3
+        and hasattr(value[1], "read")
+        and not hasattr(value[2], "read")
+    ):
+        return value[0], value[2], value[1]
+    return value
+
+
