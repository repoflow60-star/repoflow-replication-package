+                }
+            else:
+                arguments["files"] = [
+                    (key, _treq_file_value(value)) for key, value in files
+                ]
+
+        arguments["headers"] = headers
+        arguments["reactor"] = reactor
+        return _request_with_treq(method=method, url=url, **arguments)
 
 
