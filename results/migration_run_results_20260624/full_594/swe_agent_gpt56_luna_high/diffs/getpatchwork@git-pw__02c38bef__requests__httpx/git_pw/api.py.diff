+def _close_response(rsp: ty.Optional[httpx.Response]) -> None:
+    """Close a response and its client, if it owns a streaming client."""
+    if rsp is None:
+        return
+
+    rsp.close()
+    client = getattr(rsp, _HTTPX_CLIENT_ATTR, None)
+    if client is not None:
+        client.close()
+
+
+def _streaming_get(
+    url: str,
+    params: ty.Optional[Filters],
+) -> httpx.Response:
+    """Make a streaming GET request while retaining its client."""
+    client = httpx.Client(
+        auth=_get_auth(optional=True),
+        headers=_get_headers(),
+        follow_redirects=True,
+    )
+    try:
+        request = client.build_request('GET', url, params=params)
+        rsp = client.send(request, stream=True)
+    except Exception:
+        client.close()
+        raise
+
+    # A streamed response needs its client to stay alive until it is consumed.
+    # Keep it with the response; ``download`` closes both when finished.
+    setattr(rsp, _HTTPX_CLIENT_ATTR, client)
+    return rsp
 
 
