+def _add_query_params(url, params):
+    if not params:
+        return url
+
+    # Omit optional parameters whose value is None and use doseq so the ping
+    # API receives repeated ``metric`` parameters.
+    query = [(key, value) for key, value in params.items() if value is not None]
+    if not query:
+        return url
+    parts = urlsplit(url)
+    existing = parts.query
+    encoded = urlencode(query, doseq=True)
+    query_string = '{}&{}'.format(existing, encoded) if existing else encoded
+    return urlunsplit((parts.scheme, parts.netloc, parts.path, query_string,
+                       parts.fragment))
