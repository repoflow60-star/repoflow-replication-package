+class CurlSession(object):
+    """A session-like adapter implemented with PycURL.
+
+    PycURL is deliberately a low-level binding, so this adapter keeps the
+    higher-level interface that Monitor uses while ensuring that all HTTP
+    traffic is performed by libcurl.
+    """
+
+    def __init__(self, retries=0, backoff_factor=0.3):
+        self.retries = retries
+        self.backoff_factor = backoff_factor
+
+    def get(self, url, **kwargs):
+        return self.request('GET', url, **kwargs)
+
+    def put(self, url, **kwargs):
+        return self.request('PUT', url, **kwargs)
+
+    def delete(self, url, **kwargs):
+        return self.request('DELETE', url, **kwargs)
+
+    def request(self, method, url, params=None, data=None, auth=None,
+                headers=None, timeout=None):
+        url = _add_query_params(url, params)
+        request_headers = [
+            '{}: {}'.format(name, value)
+            for name, value in (headers or {}).items()
+            if value is not None
+        ]
+
+        if auth:
+            username, password = auth
+            auth_value = '{}:{}'.format(username, password)
+        else:
+            auth_value = None
+
+        # Retrying the operation, rather than reusing a Curl handle, prevents
+        # stale options and response data from leaking between attempts.
+        for attempt in range(self.retries + 1):
+            body = BytesIO()
+            curl = pycurl.Curl()
+            try:
+                curl.setopt(pycurl.URL, url)
+                curl.setopt(pycurl.CUSTOMREQUEST, method)
+                curl.setopt(pycurl.WRITEFUNCTION, body.write)
+                curl.setopt(pycurl.FOLLOWLOCATION, 1)
+                curl.setopt(pycurl.NOSIGNAL, 1)
+                if request_headers:
+                    curl.setopt(pycurl.HTTPHEADER, request_headers)
+                if auth_value is not None:
+                    curl.setopt(pycurl.USERPWD, auth_value)
+                if timeout is not None:
+                    curl.setopt(pycurl.TIMEOUT, timeout)
+                if data is not None:
+                    if isinstance(data, str):
+                        data = data.encode('utf-8')
+                    curl.setopt(pycurl.POSTFIELDS, data)
+
+                curl.perform()
+                status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+                return CurlResponse(status_code, body.getvalue())
+            except pycurl.error:
+                if attempt >= self.retries:
+                    raise
+                if self.backoff_factor:
+                    time.sleep(self.backoff_factor * (2 ** attempt))
+            finally:
+                curl.close()
+
