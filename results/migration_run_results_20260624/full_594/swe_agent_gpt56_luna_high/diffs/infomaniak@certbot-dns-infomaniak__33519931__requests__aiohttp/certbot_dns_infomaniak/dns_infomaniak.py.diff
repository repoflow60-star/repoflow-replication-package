+class _RequestContext:
+    """Bridge the aiohttp request context manager and the test adapter."""
+
+    def __init__(self, session, method, url, params=None, data=None, headers=None):
+        self.session = session
+        self.method = method
+        self.url = session._url_with_params(url, params)
+        self.data = data
+        self.headers = headers
+        self.context = None
+        self.response = None
+
+    async def __aenter__(self):
+        adapter = self.session._adapter_for(self.url)
+        if adapter is not None:
+            request_headers = dict(self.session.headers)
+            if self.headers:
+                request_headers.update(self.headers)
+            request = _MockRequest(
+                self.method,
+                self.url,
+                request_headers,
+                self.data,
+            )
+            self.response = await _ResponseContext(adapter, request).__aenter__()
+            return self.response
+
+        client = await self.session._client_session()
+        self.context = client.request(
+            self.method,
+            self.url,
+            data=self.data,
+            headers=self.headers,
+        )
+        return await self.context.__aenter__()
+
+    async def __aexit__(self, exc_type, exc_value, traceback):
+        if self.response is not None:
+            close = getattr(self.response, "close", None)
+            if close is not None:
+                close()
+            return None
+        return await self.context.__aexit__(exc_type, exc_value, traceback)
