+    @staticmethod
+    def _line_style(style: dict[str, float | str] | None, default_width: float = 0.8) -> dict[str, float | str]:
+        """Translate line style names accepted by the public API.
+
+        Parameters
+        ----------
+        style : dict[str, float | str], optional
+            Requested line style.
+        default_width : float
+            Width used when no width is specified.
+        """
+        style = style or {}
+        dash = style.get("dash", style.get("linestyle", "dashdot"))
+        dash = {"-": "solid", "--": "dash", "-.": "dashdot", ":": "dot"}.get(dash, dash)
+        return {
+            "width": style.get("width", style.get("linewidth", default_width)),
+            "color": style.get("color", "gray"),
+            "dash": dash,
+        }
 
