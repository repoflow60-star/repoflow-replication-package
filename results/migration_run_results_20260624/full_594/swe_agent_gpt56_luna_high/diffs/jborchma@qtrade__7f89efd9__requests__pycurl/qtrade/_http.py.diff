--- a/qtrade/_http.py
+++ b/qtrade/_http.py
@@ -0,0 +1,114 @@
+"""Small HTTP adapter built on top of :mod:`pycurl`.
+
+PycURL exposes libcurl's low-level interface rather than a high-level
+request/response API.  The adapter in this module supplies only the small part
+of that interface needed by the Questrade client.
+"""
+
+import json as jsonlib
+from io import BytesIO
+from typing import Any, Dict, Optional
+from urllib.parse import urlencode
+
+import pycurl
+
+
+class _PycurlResponse:
+    """Response object exposing the methods used by :class:`Questrade`."""
+
+    def __init__(self, content: bytes, status_code: int):
+        self.content = content
+        self.status_code = status_code
+
+    def json(self) -> Any:
+        """Decode the response body as JSON."""
+        return jsonlib.loads(self.content.decode("utf-8"))
+
+    def raise_for_status(self) -> None:
+        """Raise an exception for an HTTP error status."""
+        if self.status_code >= 400:
+            if 400 <= self.status_code < 500:
+                error_type = "Client Error"
+            else:
+                error_type = "Server Error"
+            raise RuntimeError(f"{self.status_code} {error_type}")
+
+
+class PycurlSession:
+    """A minimal session implemented with PycURL.
+
+    A fresh ``Curl`` handle is used for each request.  This keeps request
+    bodies and options from leaking between calls while the session still
+    provides shared headers across calls.
+    """
+
+    def __init__(self) -> None:
+        self.headers: Dict[str, str] = {}
+
+    def request(
+        self,
+        method: str,
+        url: str,
+        params: Optional[Dict] = None,
+        data: Optional[Any] = None,
+        json: Optional[Any] = None,
+        timeout: Optional[int] = None,
+    ) -> _PycurlResponse:
+        """Perform an HTTP request with libcurl."""
+        if params:
+            query = urlencode(params, doseq=True)
+            url = f"{url}&{query}" if "?" in url else f"{url}?{query}"
+
+        body: Optional[bytes] = None
+        request_headers = dict(self.headers)
+        if json is not None:
+            body = jsonlib.dumps(json).encode("utf-8")
+            request_headers.setdefault("Content-Type", "application/json")
+        elif data is not None:
+            if isinstance(data, dict):
+                body = urlencode(data, doseq=True).encode("utf-8")
+                request_headers.setdefault(
+                    "Content-Type", "application/x-www-form-urlencoded"
+                )
+            elif isinstance(data, str):
+                body = data.encode("utf-8")
+            else:
+                body = data
+
+        curl = pycurl.Curl()
+        output = BytesIO()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.CUSTOMREQUEST, method.upper())
+            curl.setopt(pycurl.WRITEFUNCTION, output.write)
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                [f"{name}: {value}" for name, value in request_headers.items()],
+            )
+            if body is not None:
+                curl.setopt(pycurl.POSTFIELDS, body)
+            if timeout is not None:
+                curl.setopt(pycurl.TIMEOUT, timeout)
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            return _PycurlResponse(output.getvalue(), status_code)
+        finally:
+            curl.close()
+
+    def get(self, url: str, **kwargs: Any) -> _PycurlResponse:
+        """Perform a GET request."""
+        return self.request("get", url, **kwargs)
+
+    def post(self, url: str, **kwargs: Any) -> _PycurlResponse:
+        """Perform a POST request."""
+        return self.request("post", url, **kwargs)
+
+    def close(self) -> None:
+        """Close the session.
+
+        Curl handles are closed after each request, so there is no persistent
+        libcurl resource to release here.  The method is retained for the
+        lifecycle API exposed by the Questrade client.
+        """
+        return None
