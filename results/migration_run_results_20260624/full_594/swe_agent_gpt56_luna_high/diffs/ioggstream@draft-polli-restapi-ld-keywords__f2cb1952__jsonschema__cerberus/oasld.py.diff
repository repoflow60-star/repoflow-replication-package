+        """Return the value addressed by a local JSON Pointer reference."""
+        if not isinstance(ref, str):
+            raise TypeError("A schema reference must be a string")
+
+        # ``resolve_fragment`` received the fragment without its leading '#'
+        # from the caller.  Accept it here as well so RefResolver remains
+        # useful on its own.
+        fragment = ref[1:] if ref.startswith("#") else ref
+        fragment = fragment.lstrip("/")
