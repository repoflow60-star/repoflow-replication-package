+class LegacyTemplateError(Exception):
+    """Error raised while reading a template written in the old syntax."""
+    def __init__(self, line, message):
+        super().__init__(message)
+        self.lineno = line
+        self.message = message
+
+
+def _split_filter(value):
+    """Split a Jinja expression at top-level pipes."""
+    parts = []
+    start = 0
+    depth = 0
+    quote = None
+    escaped = False
+    for index, char in enumerate(value):
+        if quote:
+            if escaped:
+                escaped = False
+            elif char == '\\\\':
+                escaped = True
+            elif char == quote:
+                quote = None
+        elif char in ('\"', "'"):
+            quote = char
+        elif char in '([':
+            depth += 1
+        elif char in ')]':
+            depth -= 1
+        elif char == '|' and depth == 0:
+            parts.append(value[start:index].strip())
+            start = index + 1
+    parts.append(value[start:].strip())
+    return parts
+
+
+def _legacy_expression(expression):
+    parts = _split_filter(expression.strip())
+    result = parts[0]
+    for item in parts[1:]:
+        match = re.match(r'^([A-Za-z_][\w.]*)\s*(?:\((.*)\))?$', item, re.S)
+        if not match:
+            result = '{0}({1})'.format(item, result)
+            continue
+        name, arguments = match.groups()
+        args = [result]
+        if arguments:
+            args.append(arguments)
+        result = '{0}({1})'.format(name, ', '.join(args))
+    return result
+
+
+def _translate_legacy_template(source):
+    """Translate the small Jinja dialect historically accepted by qface.
+
+    Mako is the rendering engine.  This compatibility path keeps existing
+    rule files working while new templates use normal Mako syntax.
+    """
+    if '{%' not in source and '{{' not in source and '{#' not in source:
+        return source
+
+    def output(match):
+        return '${{{0}}}'.format(_legacy_expression(match.group(1).strip()))
+
+    source = re.sub(r'\{\{[-+]?\s*(.*?)\s*[-+]?\}\}', output, source, flags=re.S)
+    source = re.sub(r'\{#.*?#\}', '', source, flags=re.S)
+    tag_pattern = re.compile(r'\{\%[-+]?\s*(.*?)\s*[-+]?\%\}', re.S)
+
+    def tag(match):
+        statement = match.group(1).strip()
+        line = source[:match.start()].count('\n') + 1
+        if statement.startswith(('for ', 'if ', 'elif ')):
+            return '% ' + statement + ':'
+        if statement == 'else':
+            return '% else:'
+        if statement in ('endif', 'endfor'):
+            return '% ' + statement
+        if statement == 'endwith':
+            return ''
+        if statement.startswith('with '):
+            assignment = statement[5:].strip()
+            if '=' not in assignment:
+                raise LegacyTemplateError(line, "expected assignment in 'with' block")
+            return '<% {0} %>'.format(_legacy_expression(assignment))
+        if statement.startswith('set '):
+            return '<% {0} %>'.format(_legacy_expression(statement[4:].strip()))
+        if statement.startswith('macro '):
+            return '<%def name="{0}">'.format(statement[6:].strip())
+        if statement == 'endmacro':
+            return '</%def>'
+        raise LegacyTemplateError(line, "Encountered unknown tag '{0}'.".format(statement.split()[0]))
+
+    return tag_pattern.sub(tag, source)
+
+
+class _FilterNamespace(object):
+    def __init__(self, filters, prefix=''):
+        self._filters = filters
+        self._prefix = prefix
+
+    def __getattr__(self, name):
+        full_name = name if not self._prefix else self._prefix + '.' + name
+        if full_name in self._filters:
+            return self._filters[full_name]
+        return _FilterNamespace(self._filters, full_name)
+
