+class _MakoEnvironment(object):
+    """Compatibility facade exposing the old ``env.filters`` API."""
+    def __init__(self, directories):
+        package_templates = Path(__file__).parent / 'templates'
+        self.filters = {}
+        self.lookup = TemplateLookup(
+            directories=[str(path) for path in directories] + [str(package_templates)],
+            input_encoding='utf-8',
+        )
+
+    def get_template(self, name):
+        # TemplateLookup does not expose its preprocessor source, so inspect
+        # the search path first in order to translate legacy files before
+        # handing them to Mako.
+        for directory in self.lookup.directories:
+            path = Path(directory) / name
+            if path.is_file():
+                source = path.read_text(encoding='utf-8')
+                if '{%' in source or '{{' in source or '{#' in source:
+                    try:
+                        translated = _translate_legacy_template(source)
+                    except LegacyTemplateError as exc:
+                        exc.filename = str(path)
+                        raise
+                    return _MakoTemplate(
+                        Template(text=translated, filename=str(path),
+                                 lookup=self.lookup), self, source, str(path))
+                break
+        return _MakoTemplate(self.lookup.get_template(name), self)
+
+    def from_string(self, source):
+        translated = _translate_legacy_template(source)
+        return _MakoTemplate(Template(text=translated, lookup=self.lookup), self)
