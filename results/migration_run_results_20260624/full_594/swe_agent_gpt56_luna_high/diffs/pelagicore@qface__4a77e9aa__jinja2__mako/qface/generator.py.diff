+class _MakoTemplate(object):
+    def __init__(self, template, environment, legacy_source=None, filename=None):
+        self._template = template
+        self._environment = environment
+        self._legacy_source = legacy_source
+        self._filename = filename
+
+    def render(self, context=None):
+        values = dict(context or {})
+        filters = self._environment.filters
+        if self._legacy_source:
+            known = set(values) | set(filters) | {'True', 'False', 'None', 'join', 'lower', 'upper'}
+            for expression in re.findall(r'\{\{[-+]?\s*(.*?)\s*[-+]?\}\}', self._legacy_source, re.S):
+                root = re.match(r'([A-Za-z_]\w*)', expression.strip())
+                if root and root.group(1) not in known:
+                    error = LegacyTemplateError(
+                        1, "'{0}' is undefined".format(root.group(1)))
+                    error.filename = self._filename
+                    raise error
+
+        for name, callback in filters.items():
+            if '.' not in name and name not in values:
+                values[name] = callback
+        for namespace in ('qt', 'qml'):
+            values[namespace] = _FilterNamespace(filters, namespace)
+        values.setdefault('join', lambda value, separator=', ': separator.join(str(v) for v in value))
+        values.setdefault('lower', lambda value: str(value).lower())
+        values.setdefault('upper', lambda value: str(value).upper())
+        return self._template.render(**values)
+
