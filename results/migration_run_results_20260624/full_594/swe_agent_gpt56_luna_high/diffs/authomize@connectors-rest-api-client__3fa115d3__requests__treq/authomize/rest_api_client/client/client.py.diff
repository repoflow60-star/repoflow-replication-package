+def serialize_deferred_response(schema: Optional[Type] = None) -> Callable:
+    """Serialize normal results and values produced by treq Deferreds."""
+    def decorator(func: Callable) -> Callable:
+        nonlocal schema
+        if not schema:  # pragma: no cover
+            schema = get_type_hints(func).get('return')
+            # Public methods expose Deferred[T], while the payload itself is T.
+            if get_args(schema):
+                schema = get_args(schema)[0]
+
+        def serialize(response: Any) -> Any:
+            if isinstance(response, (list, dict, tuple, set)) and schema:
+                return parse_obj_as(schema, response)
+            return response
+
+        @wraps(func)
+        def wrap(*args: Any, **kwargs: Dict[str, Any]) -> Any:
+            response = func(*args, **kwargs)
+            if isinstance(response, Deferred):
+                response.addCallback(serialize)
+                return response
+            return serialize(response)
+
+        return wrap
+    return decorator
+
+
