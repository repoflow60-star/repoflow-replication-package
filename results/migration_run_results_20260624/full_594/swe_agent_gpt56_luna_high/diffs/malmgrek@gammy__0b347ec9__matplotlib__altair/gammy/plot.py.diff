+# Altair accepts a mapping with a ``values`` member without requiring pandas.
+def _chart(records):
+    return alt.Chart({"values": records})
+
+
+def _values(values):
+    """Return a one-dimensional list of JSON-friendly numeric values."""
+    return np.asarray(values).reshape(-1).tolist()
+
+
+def _number(value):
+    """Convert NumPy scalar values for Vega-Lite's JSON serializer."""
+    return value.item() if isinstance(value, np.generic) else value
+
+
+def _with_title(chart, title):
+    return chart if title is None else chart.properties(title=title)
+
+
+def _altair_color(color):
+    """Translate the most common short color names to CSS color names."""
+    return {"r": "red", "g": "green", "b": "blue", "k": "black"}.get(
+        color, color
+    )
 
 
