+def _normalize_args(args):
+    """Accept the old spelling and placement of options.
+
+    plac attaches options to subcommands.  The previous interface accepted
+    those options before the subcommand and used underscores in the
+    long option names, so normalize both forms at the small compatibility
+    boundary before handing arguments to plac.
+    """
+    args = list(args)
+    command_names = set(_TMX.commands)
+    try:
+        command_index = next(i for i, arg in enumerate(args) if arg in command_names)
+    except StopIteration:
+        return [_normalize_option(arg) for arg in args]
+
+    before = args[:command_index]
+    # These belong to the root parser.  In particular, keeping --version at
+    # the root means it exits successfully even if a command follows it.
+    if any(arg in {"--version", "-v", "--help", "-h"} for arg in before):
+        return [_normalize_option(arg) for arg in args]
+
+    command = args[command_index]
+    after = args[command_index + 1 :]
+    # All arguments before the command are global options in the old CLI.
+    # Move them to the subparser, retaining their values.
+    moved = []
+    i = 0
+    while i < len(before):
+        arg = before[i]
+        normalized = _normalize_option(arg)
+        moved.append(normalized)
+        if "=" not in arg and normalized in {
+            "--pixelbuffer",
+            "--tile-size",
+            "--metatiling",
+            "--grid",
+            "--output-format",
+            "-p",
+            "-s",
+            "-m",
+            "-g",
+            "-f",
+        }:
+            if i + 1 < len(before):
+                i += 1
+                moved.append(before[i])
+        i += 1
+    # Put options before the ``--`` end-of-options marker, if one was used
+    # for the positional tile arguments.
+    return [command] + moved + [_normalize_option(arg) for arg in after]
+
+
+def _normalize_option(arg):
+    """Convert legacy underscore option names to plac's dash names."""
+    replacements = {
+        "--tile_size": "--tile-size",
+        "--output_format": "--output-format",
+        "-tile_size": "--tile-size",
+        "-output_format": "--output-format",
+    }
+    for old, new in replacements.items():
+        if arg == old:
+            return new
+        if arg.startswith(old + "="):
+            return new + arg[len(old) :]
+    return arg
