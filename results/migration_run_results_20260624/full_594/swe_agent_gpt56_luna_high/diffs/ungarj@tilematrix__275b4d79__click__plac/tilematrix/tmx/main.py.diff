+    def main(self, args=None, **kwargs):
+        """Run plac while retaining the command object's CLI entry point."""
+        del kwargs  # accepted for compatibility with CLI runners
+        if args is None:
+            args = sys.argv[1:]
+        parser = plac.parser_from(self)
+        if not self._version_added:
+            parser.add_argument(
+                "--version", "-v", action="version", version=tilematrix.__version__
+            )
+            self._version_added = True
+        _, result = parser.consume(_normalize_args(args))
+        return result
