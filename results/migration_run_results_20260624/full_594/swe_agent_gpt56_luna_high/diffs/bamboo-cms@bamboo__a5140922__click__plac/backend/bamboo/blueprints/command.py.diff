+def _get_admin_options(args: Sequence[str]) -> tuple[str, str, str, str]:
+    """Parse create-admin options and prompt for values that were omitted."""
+    # ``--name`` was the public spelling of the full-name option in the old
+    # Click command.  Keep accepting it while plac uses the parameter name.
+    plac_args = [
+        "--fullname" if arg == "--name" else arg.replace("--name=", "--fullname=", 1)
+        for arg in args
+    ]
+    username, password, fullname, email = plac.call(_admin_options, plac_args)
+
+    if username is None:
+        username = input("Admin username: ")
+    if password is None:
+        # ``getpass`` cannot read from Click's non-terminal test stream, so
+        # use the regular input stream when the command is not attached to a
+        # terminal.
+        prompt_password = getpass if sys.stdin.isatty() else input
+        password = prompt_password("Admin password: ")
+        if password != prompt_password("Repeat for confirmation: "):
+            raise ValueError("Passwords do not match.")
+    if fullname is None:
+        fullname = input("Admin full name: ")
+    if email is None:
+        email = input("Admin email: ")
+    return username, password, fullname, email
+
+
