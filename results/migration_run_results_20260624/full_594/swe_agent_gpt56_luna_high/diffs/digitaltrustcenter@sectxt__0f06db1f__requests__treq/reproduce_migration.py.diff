--- a/reproduce_migration.py
+++ b/reproduce_migration.py
@@ -0,0 +1,17 @@
+"""Reproduce the pre-migration HTTP dependency."""
+from pathlib import Path
+
+source = Path(__file__).with_name("sectxt") / "__init__.py"
+text = source.read_text()
+
+try:
+    import treq
+except ModuleNotFoundError as exc:
+    print(f"treq import failed: {exc}")
+
+print("uses requests:", "import requests" in text)
+print("uses treq:", "import treq" in text)
+print("declared requests:", any("requests==" in line for line in Path(__file__).with_name("setup.cfg").read_text().splitlines()))
+print("declared treq:", any("treq==" in line for line in Path(__file__).with_name("setup.cfg").read_text().splitlines()))
+assert "import requests" not in text
+assert "import treq" in text
