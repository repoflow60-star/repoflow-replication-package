+        if not params:
+            return url
+        if hasattr(params, 'items'):
+            pairs = []
+            for key, value in params.items():
+                if value is None:
+                    continue
+                if isinstance(value, (list, tuple)):
+                    pairs.extend((key, item) for item in value if item is not None)
