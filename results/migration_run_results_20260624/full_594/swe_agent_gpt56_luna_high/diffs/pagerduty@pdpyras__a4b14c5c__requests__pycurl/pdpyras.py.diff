+class _Headers(dict):
+    """A minimal case-insensitive HTTP header mapping."""
+
+    def _key(self, key):
+        key = str(key)
+        for existing in self:
+            if existing.lower() == key.lower():
+                return existing
+        return key
+
+    def __getitem__(self, key):
+        return super(_Headers, self).__getitem__(self._key(key))
+
+    def __contains__(self, key):
+        return any(existing.lower() == str(key).lower() for existing in self)
+
+    def get(self, key, default=None):
+        return super(_Headers, self).get(self._key(key), default)
+
+    def __setitem__(self, key, value):
+        super(_Headers, self).__setitem__(self._key(key), value)
+
+    def update(self, values=None, **kwargs):
+        if values is not None:
+            values = values.items() if hasattr(values, 'items') else values
+            for key, value in values:
+                self[key] = value
+        for key, value in kwargs.items():
+            self[key] = value
