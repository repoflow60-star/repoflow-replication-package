+++ b/reproduce_httpx_migration.py
@@ -0,0 +1,15 @@
+"""Reproduce the missing httpx migration dependency/implementation."""
+from unittest.mock import MagicMock, patch
+
+import httpx
+
+from nukedockerbuild.creator.collector import fetch_json_data
+from nukedockerbuild.datamodel.constants import JSON_DATA_SOURCE
+
+response = MagicMock(spec=httpx.Response)
+response.status_code = 200
+response.json.return_value = {"releases": {}}
+
+with patch("nukedockerbuild.creator.collector.httpx.get", return_value=response) as get:
+    fetch_json_data()
+    get.assert_called_once_with(JSON_DATA_SOURCE, timeout=10)
