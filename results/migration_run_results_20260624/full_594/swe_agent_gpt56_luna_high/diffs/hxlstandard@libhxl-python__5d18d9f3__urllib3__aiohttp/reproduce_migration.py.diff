--- a/reproduce_migration.py
+++ b/reproduce_migration.py
@@ -0,0 +1,42 @@
+"""Reproduce the HTTP dependency migration and verify the synchronous adapter."""
+from http.server import BaseHTTPRequestHandler, HTTPServer
+from pathlib import Path
+import threading
+
+requirements = Path(__file__).with_name("requirements.txt").read_text()
+assert "aiohttp==3.14.1" in requirements
+assert "urllib3" not in requirements
+
+import hxl.input
+
+assert not hasattr(hxl.input, "requests")
+
+
+class Handler(BaseHTTPRequestHandler):
+    def do_GET(self):
+        body = b"Sector\\n#sector\\nWASH\\n"
+        self.send_response(200)
+        self.send_header("Content-Type", "text/csv; charset=utf-8")
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    def log_message(self, *_):
+        pass
+
+
+server = HTTPServer(("127.0.0.1", 0), Handler)
+threading.Thread(target=server.serve_forever, daemon=True).start()
+try:
+    stream, mime, extension, encoding, length, fileno = hxl.input.open_url_or_file(
+        "http://127.0.0.1:{}/data.csv".format(server.server_port),
+        hxl.input.InputOptions(allow_local=True),
+    )
+    assert stream.read() == b"Sector\\n#sector\\nWASH\\n"
+    assert mime == "text/csv"
+    assert encoding == "utf-8"
+    assert length == len(stream.getvalue())
+finally:
+    server.shutdown()
+
+print("aiohttp 3.14.1 migration is working")
