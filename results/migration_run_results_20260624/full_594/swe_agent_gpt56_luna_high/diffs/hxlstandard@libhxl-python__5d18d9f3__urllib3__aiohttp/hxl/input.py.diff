+class _HTTPHeaders(dict):
+    """Case-insensitive headers, matching requests' response headers."""
+
+    def _key(self, key):
+        key_lower = key.lower()
+        for existing in self:
+            if existing.lower() == key_lower:
+                return existing
+        return key
+
+    def __getitem__(self, key):
+        return super().__getitem__(self._key(key))
+
+    def get(self, key, default=None):
+        return super().get(self._key(key), default)
+
+
+class _HTTPResponse:
+    """Small synchronous response object used by the HTTP helpers below.
+
+    The public input API is synchronous, while aiohttp is asynchronous.  The
+    response is therefore fully read before the coroutine returns so callers
+    can continue to consume it in the same way as the old requests response.
+    """
+
+    def __init__(self, status, headers, content, history=()):
+        self.status_code = status
+        self.headers = _HTTPHeaders(headers)
+        self.content = content
+        self.history = history
+
+    @property
+    def is_redirect(self):
+        return self.status_code in (301, 302, 303, 307, 308) and 'Location' in self.headers
+
+    def json(self):
+        content_type = self.headers.get('content-type', '')
+        match = re.search(r'charset=([^;\s]+)', content_type, re.IGNORECASE)
+        encoding = match.group(1) if match else 'utf-8'
+        return json.loads(self.content.decode(encoding))
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise IOError('HTTP {} error'.format(self.status_code))
+
+
+async def _request_async(method, url, verify_ssl=True, timeout=None,
+                         headers=None, params=None, data=None,
+                         allow_redirects=True):
+    """Perform one HTTP request with aiohttp and return a buffered response."""
+    client_timeout = aiohttp.ClientTimeout(
+        total=None,
+        connect=timeout,
+        sock_read=timeout,
+    )
+    ssl = None if verify_ssl else False
+    async with aiohttp.ClientSession(timeout=client_timeout) as session:
+        async with session.request(
+                method,
+                url,
+                headers=headers,
+                params=params,
+                data=data,
+                ssl=ssl,
+                allow_redirects=allow_redirects) as response:
+            content = await response.read()
+            return _HTTPResponse(
+                response.status,
+                dict(response.headers),
+                content,
+                tuple(response.history),
+            )
+
+
+def _run_async(coro):
+    """Run an aiohttp coroutine from the library's synchronous API.
+
+    ``asyncio.run`` cannot be called while an event loop is already running.
+    Running the request in a short-lived worker in that case keeps the existing
+    synchronous API usable by applications that otherwise use asyncio.
+    """
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coro)
+
+    with concurrent.futures.ThreadPoolExecutor(max_workers=1) as executor:
+        return executor.submit(asyncio.run, coro).result()
+
+
+def _request(method, url, **kwargs):
+    return _run_async(_request_async(method, url, **kwargs))
+
+
+def _get(url, **kwargs):
+    return _request('GET', url, **kwargs)
+
+
+def _post(url, **kwargs):
+    return _request('POST', url, **kwargs)
+
+
+def _head(url, **kwargs):
+    return _request('HEAD', url, allow_redirects=False, **kwargs)
 
