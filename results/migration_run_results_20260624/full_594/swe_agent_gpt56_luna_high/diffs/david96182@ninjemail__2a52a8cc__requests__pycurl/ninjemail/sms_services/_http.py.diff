--- a/ninjemail/sms_services/_http.py
+++ b/ninjemail/sms_services/_http.py
@@ -0,0 +1,99 @@
+"""Small HTTP response helpers backed by PycURL.
+
+The SMS providers only need a very small part of an HTTP client interface:
+form-encoded GET/POST calls, response text/JSON, and HTTP status checking.
+Keeping that interface here avoids duplicating the PycURL buffer and cleanup
+boilerplate in each provider.
+"""
+
+import json
+from io import BytesIO
+from urllib.parse import urlencode, urlsplit, urlunsplit
+
+import pycurl
+
+
+class HTTPError(Exception):
+    """Raised when an HTTP response has a client or server error status."""
+
+
+class Response:
+    """The response fields used by the SMS service implementations."""
+
+    def __init__(self, content, status_code):
+        self.content = content
+        self.status_code = status_code
+
+    @property
+    def text(self):
+        return self.content.decode("utf-8", errors="replace")
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if 400 <= self.status_code < 600:
+            raise HTTPError(f"HTTP {self.status_code}")
+
+
+def _add_query_params(url, params):
+    if not params:
+        return url
+
+    parts = urlsplit(url)
+    query = urlencode(params, doseq=True)
+    combined_query = f"{parts.query}&{query}" if parts.query else query
+    return urlunsplit((parts.scheme, parts.netloc, parts.path, combined_query, parts.fragment))
+
+
+def request(method, url, *, headers=None, data=None, params=None):
+    """Perform a form-encoded HTTP request with PycURL.
+
+    ``data`` is sent as an ``application/x-www-form-urlencoded`` POST body,
+    while ``params`` is appended to the URL as a query string.  Network
+    failures are deliberately left as :class:`pycurl.error`, matching
+    PycURL's native error handling.
+    """
+    method = method.upper()
+    if method not in {"GET", "POST"}:
+        raise ValueError(f"Unsupported HTTP method: {method}")
+
+    response_buffer = BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, _add_query_params(url, params))
+        curl.setopt(pycurl.WRITEFUNCTION, response_buffer.write)
+        # Ask libcurl to negotiate and transparently decode supported content
+        # encodings, as a high-level HTTP client would.
+        curl.setopt(pycurl.ACCEPT_ENCODING, "")
+        # Provider endpoints do not normally redirect, but retaining common
+        # HTTP-client redirect behavior is inexpensive.
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+
+        if headers:
+            curl.setopt(pycurl.HTTPHEADER, [f"{key}: {value}" for key, value in headers.items()])
+
+        if method == "POST":
+            curl.setopt(pycurl.POST, True)
+            if data is not None:
+                curl.setopt(pycurl.POSTFIELDS, urlencode(data, doseq=True))
+
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        content = response_buffer.getvalue()
+    finally:
+        curl.close()
+
+    return Response(content, status_code)
+
+
+def get(url, *, headers=None, params=None):
+    return request("GET", url, headers=headers, params=params)
+
+
+def post(url, *, headers=None, data=None, params=None):
+    return request("POST", url, headers=headers, data=data, params=params)
+
+
+__all__ = ["HTTPError", "Response", "get", "post", "request"]
+
