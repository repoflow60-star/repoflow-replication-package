--- a/reproduce_migration.py
+++ b/reproduce_migration.py
@@ -0,0 +1,19 @@
+"""Reproduce the plotting dependency currently used by PyALE."""
+from pathlib import Path
+import ast
+
+for path in Path("PyALE").rglob("*.py"):
+    tree = ast.parse(path.read_text(), filename=str(path))
+    imports = [
+        node.names[0].name
+        for node in ast.walk(tree)
+        if isinstance(node, ast.Import) and node.names
+    ]
+    if "matplotlib.pyplot" in imports or any(
+        isinstance(node, ast.ImportFrom) and node.module == "matplotlib"
+        for node in ast.walk(tree)
+    ):
+        print(f"{path}: imports matplotlib")
+
+import PyALE._src.ALE_1D as ale_1d
+print("ALE_1D plotting backend:", ale_1d.plt.__name__)
