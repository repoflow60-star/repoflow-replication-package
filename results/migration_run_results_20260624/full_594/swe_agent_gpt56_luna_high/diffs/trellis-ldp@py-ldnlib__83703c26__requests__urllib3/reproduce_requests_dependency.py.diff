--- a/reproduce_requests_dependency.py
+++ b/reproduce_requests_dependency.py
@@ -0,0 +1,17 @@
+"""Reproduce the dependency that the urllib3 migration must remove."""
+import builtins
+
+_real_import = builtins.__import__
+
+def reject_requests(name, *args, **kwargs):
+    if name == "requests" or name.startswith("requests."):
+        raise ImportError("requests is unavailable in the urllib3-only environment")
+    return _real_import(name, *args, **kwargs)
+
+builtins.__import__ = reject_requests
+try:
+    import ldnlib
+except ImportError as error:
+    print(f"reproduced: {error}")
+else:
+    print("unexpectedly imported without requests")
