--- a/ldnlib/http.py
+++ b/ldnlib/http.py
@@ -0,0 +1,133 @@
+"""Small HTTP compatibility layer built on urllib3.
+
+The public library used to rely on requests' response and keyword argument
+conventions.  Keeping the translation here means the LDN code can continue
+to accept the same useful options while using urllib3 for all network I/O.
+"""
+
+import base64
+import json
+import re
+
+import urllib3
+
+
+_http = urllib3.PoolManager()
+
+
+def request(method, url, **kwargs):
+    """Make an HTTP request, translating the requests-style options we use."""
+    headers = kwargs.pop("headers", None)
+    if headers is None:
+        headers = {}
+    else:
+        headers = dict(headers)
+
+    auth = kwargs.pop("auth", None)
+    if auth is not None:
+        if (isinstance(auth, (tuple, list)) and len(auth) == 2 and
+                "authorization" not in {key.lower() for key in headers}):
+            credentials = "{}:{}".format(auth[0], auth[1]).encode("utf-8")
+            headers["Authorization"] = "Basic " + base64.b64encode(
+                credentials).decode("ascii")
+        elif not isinstance(auth, (tuple, list)):
+            raise TypeError(
+                "urllib3 transport only supports username/password auth")
+
+    if "allow_redirects" in kwargs:
+        kwargs["redirect"] = kwargs.pop("allow_redirects")
+    if "params" in kwargs:
+        kwargs["fields"] = kwargs.pop("params")
+    if "data" in kwargs:
+        kwargs["body"] = kwargs.pop("data")
+    if "stream" in kwargs:
+        kwargs["preload_content"] = not kwargs.pop("stream")
+
+    # urllib3 uses cert_reqs rather than requests' verify flag.
+    if "verify" in kwargs:
+        verify = kwargs.pop("verify")
+        if verify is False:
+            kwargs["cert_reqs"] = "CERT_NONE"
+
+    return _http.request(method, url, headers=headers, **kwargs)
+
+
+def status(response):
+    """Return an HTTP response status for an urllib3 (or test double)."""
+    value = getattr(response, "status", None)
+    if isinstance(value, int):
+        return value
+    return getattr(response, "status_code", value)
+
+
+def raise_for_status(response):
+    """Raise an urllib3 HTTPError when the response is unsuccessful."""
+    code = status(response)
+    if isinstance(code, int):
+        if code >= 400:
+            raise urllib3.exceptions.HTTPError(
+                "HTTP error {} for request".format(code))
+        return
+
+    # This keeps custom response doubles useful without depending on a
+    # requests response object in the production code.
+    method = getattr(response, "raise_for_status", None)
+    if callable(method):
+        method()
+
+
+def header(response, name):
+    """Get a response header case-insensitively."""
+    headers = response.headers
+    value = headers.get(name)
+    if value is not None:
+        return value
+    wanted = name.lower()
+    for key, value in headers.items():
+        if key.lower() == wanted:
+            return value
+    return None
+
+
+def text(response):
+    """Decode an urllib3 response body using its declared charset."""
+    value = getattr(response, "text", None)
+    if isinstance(value, str):
+        return value
+
+    data = getattr(response, "data", b"")
+    if isinstance(data, str):
+        return data
+    content_type = header(response, "content-type") or ""
+    match = re.search(r"(?:^|;)\s*charset\s*=\s*([^;\s]+)",
+                      content_type, re.IGNORECASE)
+    encoding = match.group(1).strip('"') if match else "utf-8"
+    return data.decode(encoding, errors="replace")
+
+
+def json_body(response):
+    """Decode a JSON response body."""
+    return json.loads(text(response))
+
+
+def links(response):
+    """Return response links in the shape used by the original code."""
+    existing = getattr(response, "links", None)
+    if isinstance(existing, dict):
+        return existing
+
+    link_header = header(response, "link") or ""
+    result = {}
+    pattern = re.compile(
+        r"<([^>]+)>\s*;\s*rel\s*=\s*(?:\"([^\"]+)\"|'([^']+)'|([^;,\s]+))",
+        re.IGNORECASE)
+    for match in pattern.finditer(link_header):
+        url = match.group(1)
+        rels = (match.group(2) or match.group(3) or match.group(4)).split()
+        for rel in rels:
+            result[rel] = {"url": url}
+    return result
+
+
+__all__ = ["request", "status", "raise_for_status", "header", "text",
+           "json_body", "links"]
