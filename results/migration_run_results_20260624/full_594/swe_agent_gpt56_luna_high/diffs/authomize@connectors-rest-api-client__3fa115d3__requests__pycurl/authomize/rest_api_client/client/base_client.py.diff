+    @staticmethod
+    def _encode_params(params) -> str:
+        if not params:
+            return ''
+
+        def value(item):
+            return item.value if isinstance(item, Enum) else str(item)
+
+        pairs: list[tuple[str, str]] = []
+        for key, item in params.items():
+            if item is None:
+                continue
+            if isinstance(item, (list, tuple)):
+                pairs.extend((key, value(part)) for part in item if part is not None)
+            else:
+                pairs.append((key, value(item)))
+        return urlencode(pairs)
+
+    def _request(self, method: str, url: str, params=None, body: Optional[str] = None,
+                 headers: Optional[dict] = None) -> _CurlResponse:
+        query = self._encode_params(params)
+        if query:
+            parts = urlsplit(url)
+            url = urlunsplit((parts.scheme, parts.netloc, parts.path,
+                              f'{parts.query}&{query}' if parts.query else query, parts.fragment))
+
+        content = io.BytesIO()
+        response_headers: list[bytes] = []
+        curl = pycurl.Curl()
+        request_headers = {**self.headers, **(headers or {})}
+        payload = body.encode('utf-8') if isinstance(body, str) else body
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                [f'{key}: {value}' for key, value in request_headers.items()],
+            )
+            curl.setopt(pycurl.WRITEFUNCTION, content.write)
+            curl.setopt(pycurl.HEADERFUNCTION, response_headers.append)
+            curl.setopt(pycurl.FOLLOWLOCATION, True)
+            if method == 'GET':
+                curl.setopt(pycurl.HTTPGET, True)
+            elif method == 'POST':
+                curl.setopt(pycurl.POST, True)
+                if payload is not None:
+                    curl.setopt(pycurl.POSTFIELDS, payload)
+            else:
+                curl.setopt(pycurl.CUSTOMREQUEST, method)
+                if payload is not None:
+                    curl.setopt(pycurl.POSTFIELDS, payload)
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        parsed_headers: dict[str, str] = {}
+        for raw_header in response_headers:
+            line = (
+                raw_header.decode('iso-8859-1').strip()
+                if isinstance(raw_header, bytes)
+                else raw_header.strip()
+            )
+            if line.startswith('HTTP/'):
+                parsed_headers = {}
+            elif ':' in line:
+                key, value = line.split(':', 1)
+                parsed_headers[key.strip().lower()] = value.strip()
+
+        return _CurlResponse(status_code, parsed_headers, content.getvalue(), url)
