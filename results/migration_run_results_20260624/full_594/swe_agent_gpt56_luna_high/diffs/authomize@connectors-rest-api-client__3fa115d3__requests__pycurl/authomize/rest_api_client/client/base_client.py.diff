+class _CurlResponse:
+    """Small response object exposing the parts used by the client.
+
+    PycURL writes the response body and headers to callbacks rather than
+    returning a response object like a high-level HTTP library does. Keeping this adapter
+    private lets the response handling below retain its existing behaviour.
+    """
+
+    def __init__(self, status_code: int, headers: dict, content: bytes, url: str):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+        self.url = url
+        self.reason = ''
+
+    @property
+    def ok(self) -> bool:
+        return self.status_code < 400
+
+    @property
+    def text(self) -> str:
+        return self.content.decode('utf-8', errors='replace')
+
+    def json(self) -> Any:
+        return json.loads(self.text)
+
+    def raise_for_status(self) -> None:
+        if not self.ok:
+            raise ClientError(f'{self.status_code} {self.reason}'.strip())
 
 
