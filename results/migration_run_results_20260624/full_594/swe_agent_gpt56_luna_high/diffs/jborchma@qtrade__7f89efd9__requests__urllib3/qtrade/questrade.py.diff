+def _raise_for_status(response: Any) -> None:
+    """Raise an HTTP error for an unsuccessful urllib3 response.
+
+    ``urllib3`` exposes the status as ``HTTPResponse.status`` and does not provide
+    a ``raise_for_status`` method.
+    """
+    status = getattr(response, "status", None)
+    if status is None and hasattr(response, "raise_for_status"):
+        # Keep response-like objects usable for callers that provide a custom
+        # transport or a test double.
+        response.raise_for_status()
+    elif status is not None and status >= 400:
+        raise urllib3.exceptions.HTTPError(
+            "HTTP Error {0}: {1}".format(status, getattr(response, "reason", ""))
+        )
 
 
