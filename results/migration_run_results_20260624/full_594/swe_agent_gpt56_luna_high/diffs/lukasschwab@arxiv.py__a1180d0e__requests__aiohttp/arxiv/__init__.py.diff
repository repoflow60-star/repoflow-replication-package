+
+    async def _request(self, url: str) -> tuple[int, bytes]:
+        """Fetch ``url`` with aiohttp and return its status and body.
+
+        ``Client`` intentionally retains its historical synchronous API.  The
+        session therefore belongs to this coroutine and is always closed before
+        the coroutine returns, avoiding sessions tied to an event loop that has
+        already been shut down by the synchronous adapter.
+        """
+        async with aiohttp.ClientSession() as session:
+            async with session.get(
+                url, headers={"user-agent": "arxiv.py/2.1.3"}
+            ) as response:
+                return response.status, await response.read()
+
+    @staticmethod
+    def _run_async(coroutine):
+        """Run an aiohttp coroutine from the client's synchronous API.
+
+        ``asyncio.run`` is sufficient for normal synchronous callers.  If a
+        caller invokes the synchronous client while another event loop is
+        running (for example, from a notebook), execute the request on a
+        dedicated thread instead of raising ``RuntimeError``.
+        """
+        try:
+            loop = asyncio.get_running_loop()
+        except RuntimeError:
+            return asyncio.run(coroutine)
+
+        if not loop.is_running():
+            return asyncio.run(coroutine)
+
+        result = []
+        error = []
+
+        def run_in_thread():
+            try:
+                result.append(asyncio.run(coroutine))
+            except BaseException as exception:  # propagate the original error
+                error.append(exception)
+
+        thread = threading.Thread(target=run_in_thread)
+        thread.start()
+        thread.join()
+        if error:
+            raise error[0]
+        return result[0]
 
