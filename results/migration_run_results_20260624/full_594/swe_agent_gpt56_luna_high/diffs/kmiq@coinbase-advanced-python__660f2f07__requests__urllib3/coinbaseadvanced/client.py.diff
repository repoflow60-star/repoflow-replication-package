+class _Urllib3HTTPClient:
+    """Requests-like convenience methods backed by urllib3.PoolManager."""
+
+    def __init__(self) -> None:
+        self._pool = urllib3.PoolManager()
+
+    def _request(self, method: str, url: str, *, headers=None,
+                 timeout=None, json=None) -> urllib3.response.HTTPResponse:
+        request_headers = dict(headers or {})
+        body = None
+        if json is not None:
+            body = jsonlib.dumps(json).encode("utf-8")
+            if not any(key.lower() == "content-type" for key in request_headers):
+                request_headers["Content-Type"] = "application/json"
+
+        response = self._pool.request(
+            method,
+            url,
+            body=body,
+            headers=request_headers,
+            timeout=timeout,
+        )
+        return response
+
+    def get(self, url, **kwargs):
+        return self._request("GET", url, **kwargs)
+
+    def post(self, url, **kwargs):
+        return self._request("POST", url, **kwargs)
+
+    def put(self, url, **kwargs):
+        return self._request("PUT", url, **kwargs)
+
+    def delete(self, url, **kwargs):
+        return self._request("DELETE", url, **kwargs)
+
+
+_http = _Urllib3HTTPClient()
+
+# Keep this alias as a backwards-compatible monkeypatch hook for callers and
+# the existing test suite.  It is not the third-party requests package.
+requests = _http
 
 
