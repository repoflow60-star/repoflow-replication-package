+def _raise_for_status(response):
+    """Raise for an unsuccessful response from either a test double or treq."""
+    # The existing public helpers accept session-like objects, which is useful
+    # to callers and keeps the old unit-test doubles working.
+    raise_for_status = getattr(response, "raise_for_status", None)
+    if callable(raise_for_status):
+        raise_for_status()
+        return
+
+    code = response.code
+    if code < 200 or code >= 400:
+        raise RuntimeError("HTTP request failed with status code %s" % code)
+
