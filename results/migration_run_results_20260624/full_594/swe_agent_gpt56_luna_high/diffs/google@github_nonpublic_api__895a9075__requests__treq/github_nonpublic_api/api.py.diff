+class _TreqSession:
+    """A small, cookie-preserving session built on top of treq.
+
+    ``treq`` exposes an asynchronous HTTP client rather than a synchronous
+    session object. Keeping the session abstraction here lets the rest of the API
+    retain its cookie and redirect handling while
+    returning Deferreds for real network requests.
+    """
+
+    def __init__(self):
+        self.cookies = CookieJar()
+        self._client = treq.client.HTTPClient(
+            Agent(reactor), cookiejar=self.cookies
+        )
+        # create_login_session replaces this with the completed login chain.
+        # Every normal request waits for authentication before starting.
+        self._ready = defer.succeed(None)
+
+    def get(self, url: str, **kwargs):
+        return self._ready.addCallback(
+            lambda _: self._client.get(url, **kwargs)
+        )
+
+    def post(self, url: str, data=None, **kwargs):
+        return self._ready.addCallback(
+            lambda _: self._client.post(url, data=data, **kwargs)
+        )
+
+
+class _TreqLoginSession:
+    """Session view used while constructing the login request chain."""
+
+    def __init__(self, session: _TreqSession):
