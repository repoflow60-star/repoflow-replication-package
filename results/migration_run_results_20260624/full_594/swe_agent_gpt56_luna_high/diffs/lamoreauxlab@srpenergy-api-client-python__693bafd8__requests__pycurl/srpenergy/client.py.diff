+class _PycurlResponse:
+    """Small response adapter exposing the parts used by the client."""
+
+    def __init__(self, body, headers, status_code):
+        self._body = body
+        self.headers = headers
+        self.status_code = status_code
+        self.cookies = {}
+
+        for header in headers.splitlines():
+            if header.lower().startswith("set-cookie:"):
+                cookie = SimpleCookie()
+                cookie.load(header.split(":", 1)[1].strip())
+                for name, morsel in cookie.items():
+                    self.cookies[name] = morsel.value
+
+    def json(self):
+        """Decode the response body as JSON."""
+        return json.loads(self._body.decode("utf-8"))
+
+
+class _PycurlSession:
+    """Context-managed, requests-like session backed by PycURL.
+
+    The adapter keeps one curl handle for the lifetime of the session so that
+    cookies set during authorization are sent with subsequent requests.
+    """
+
+    def __init__(self):
+        self._curl = pycurl.Curl()
+        self._curl.setopt(pycurl.COOKIEFILE, "")
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, _exc_type, _exc_value, _traceback):
+        self.close()
+
+    def close(self):
+        """Release the underlying curl handle."""
+        self._curl.close()
+
+    def _request(self, url, method, data=None, headers=None):
+        body = BytesIO()
+        response_headers = BytesIO()
+
+        self._curl.setopt(pycurl.URL, url)
+        self._curl.setopt(pycurl.WRITEDATA, body)
+        self._curl.setopt(pycurl.HEADERFUNCTION, response_headers.write)
+        self._curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        self._curl.setopt(
+            pycurl.HTTPHEADER,
+            [f"{key}: {value}" for key, value in (headers or {}).items()],
+        )
+
+        if method == "POST":
+            self._curl.setopt(pycurl.POST, 1)
+            self._curl.setopt(pycurl.POSTFIELDS, urlencode(data or {}))
+        else:
+            self._curl.setopt(pycurl.HTTPGET, 1)
+
+        self._curl.perform()
+        status_code = self._curl.getinfo(pycurl.RESPONSE_CODE)
+        return _PycurlResponse(
+            body.getvalue(),
+            response_headers.getvalue().decode("iso-8859-1"),
+            status_code,
+        )
+
+    def post(self, url, data=None, **_kwargs):
+        """Send a form-encoded POST request."""
+        return self._request(url, "POST", data=data)
+
+    def get(self, url, headers=None, **_kwargs):
+        """Send a GET request."""
+        return self._request(url, "GET", headers=headers)
+
+
+class _RequestsCompatibility:
+    """Compatibility namespace for callers that patch the old session path."""
+
+    Session = _PycurlSession
+
+
+# Keep the old patchable path working while the implementation uses PycURL.
+requests = _RequestsCompatibility()
