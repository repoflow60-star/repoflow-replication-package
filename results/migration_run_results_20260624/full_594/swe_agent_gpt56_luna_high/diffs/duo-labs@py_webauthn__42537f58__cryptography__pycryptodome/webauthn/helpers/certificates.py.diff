--- a/webauthn/helpers/certificates.py
+++ b/webauthn/helpers/certificates.py
@@ -0,0 +1,81 @@
+"""Small certificate helpers backed by pycryptodome and asn1crypto.
+
+PyCryptodome handles the public-key operations while asn1crypto provides the
+read-only X.509 parsing needed by the attestation formats.
+"""
+
+from typing import Any
+
+from asn1crypto import x509
+from Crypto.PublicKey import ECC, RSA
+
+
+class CertificateExtensionNotFound(LookupError):
+    pass
+
+
+def load_der_certificate(data: bytes) -> x509.Certificate:
+    return x509.Certificate.load(data)
+
+
+def certificate_public_key(certificate: x509.Certificate) -> Any:
+    """Return the certificate's public key as a PyCryptodome key."""
+    public_key_info = certificate.public_key
+    algorithm = public_key_info["algorithm"]["algorithm"].native
+    if algorithm == "rsa":
+        return RSA.import_key(public_key_info.dump())
+    if algorithm == "ec":
+        return ECC.import_key(public_key_info.dump())
+    if algorithm in ("ed25519", "ed448"):
+        return ECC.import_key(public_key_info.dump())
+    raise ValueError(f"Unsupported certificate public-key algorithm: {algorithm}")
+
+
+def certificate_public_key_der(certificate: x509.Certificate) -> bytes:
+    return certificate.public_key.dump()
+
+
+def certificate_extension_bytes(certificate: x509.Certificate, oid: str) -> bytes:
+    try:
+        extensions = certificate["tbs_certificate"]["extensions"]
+    except (KeyError, ValueError):
+        extensions = []
+    for extension in extensions:
+        if extension["extn_id"].dotted == oid:
+            return extension["extn_value"].native
+    raise CertificateExtensionNotFound(oid)
+
+
+def certificate_extension(certificate: x509.Certificate, oid: str) -> Any:
+    try:
+        extensions = certificate["tbs_certificate"]["extensions"]
+    except ValueError:
+        extensions = None
+    if extensions is not None:
+        for extension in extensions:
+            if extension["extn_id"].dotted == oid:
+                return extension["extn_value"].parsed
+    raise CertificateExtensionNotFound(oid)
+
+
+def certificate_common_name(certificate: x509.Certificate) -> str:
+    return certificate.subject.native.get("common_name", "")
+
+
+def certificate_is_v3(certificate: x509.Certificate) -> bool:
+    return certificate["tbs_certificate"]["version"].native == "v3"
+
+
+def certificate_extensions(certificate: x509.Certificate) -> Any:
+    try:
+        return certificate["tbs_certificate"]["extensions"]
+    except ValueError:
+        return []
+
+
+def load_public_key(data: bytes) -> Any:
+    """Load a DER SubjectPublicKeyInfo using PyCryptodome."""
+    try:
+        return RSA.import_key(data)
+    except (ValueError, IndexError, TypeError):
+        return ECC.import_key(data)
