+"""Synchronous HTTP facade backed by treq.
+
+The public client in pynubank is intentionally synchronous.  treq is a
+Twisted client and returns Deferreds, so this module keeps the existing public
+API while driving those Deferreds from a small background reactor.
+"""
+
+from collections.abc import Mapping
+import threading
+from typing import Any, Callable
+
+import treq
+from twisted.internet import reactor
+from twisted.internet.defer import Deferred
+from twisted.python.failure import Failure
+from twisted.web.client import Agent, BrowserLikePolicyForHTTPS
 
 from pynubank import NuRequestException
+
+
+_reactor_thread = None
+_reactor_lock = threading.Lock()
+
+
+def _start_reactor():
+    """Start the process-wide reactor used by the synchronous adapter."""
+    global _reactor_thread
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is None:
+            started = threading.Event()
+
+            def run_reactor():
+                started.set()
+                reactor.run(installSignalHandlers=False)
+
+            _reactor_thread = threading.Thread(
+                target=run_reactor,
+                name='pynubank-twisted-reactor',
+                daemon=True,
+            )
+            _reactor_thread.start()
+            started.wait()
+
+
+def _wait_for_deferred(deferred: Deferred):
+    """Wait for a Deferred without stopping the Twisted reactor."""
+    if not isinstance(deferred, Deferred):
+        return deferred
+
+    if reactor.running and threading.current_thread() is _reactor_thread:
+        raise RuntimeError('A synchronous HTTP call cannot be made from the Twisted reactor thread')
+
+    _start_reactor()
+    completed = threading.Event()
+    result = []
+
+    def finished(value):
+        result.append(value)
+        completed.set()
+        return value
+
+    deferred.addBoth(finished)
+    completed.wait()
+    value = result[0]
+    if isinstance(value, Failure):
+        value.raiseException()
+    return value
+
+
+def _call(request: Callable[[], Any]):
+    return _wait_for_deferred(request())
+
+
+def _as_text(value):
+    if isinstance(value, bytes):
+        return value.decode('utf-8', errors='replace')
+    return value
+
+
+class _ResponseHeaders(Mapping):
+    """A small, case-insensitive mapping for Twisted response headers."""
+
+    def __init__(self, headers):
+        self._headers = {}
+        for name, values in headers.getAllRawHeaders():
+            key = _as_text(name).lower()
+            self._headers[key] = [_as_text(value) for value in values]
+
+    def __getitem__(self, name):
+        values = self._headers[name.lower()]
+        return values[0] if len(values) == 1 else values
+
+    def __iter__(self):
+        return iter(self._headers)
+
+    def __len__(self):
+        return len(self._headers)
+
+    def get(self, name, default=None):
+        return self._headers.get(name.lower(), [default])[0]
+
+
+class _TreqResponse:
+    """Requests-like response view used by the library's existing API."""
+
+    def __init__(self, response, requested_url):
+        self._response = response
+        self.status_code = response.code
+        self.url = _as_text(getattr(getattr(response, 'request', None), 'absoluteURI', requested_url))
+        self.headers = _ResponseHeaders(response.headers)
+
+    def json(self):
+        return _wait_for_deferred(self._response.json())
+
+
+def _certificate_agent(cert_data):
+    """Build a treq Agent that presents a PKCS#12 client certificate."""
+    from cryptography.hazmat.primitives.serialization import pkcs12
+    from OpenSSL import crypto
+
+    private_key, certificate, chain = pkcs12.load_key_and_certificates(cert_data, b'')
+    if private_key is None or certificate is None:
+        raise ValueError('The PKCS#12 data does not contain a private key and certificate')
+
+    key = crypto.PKey.from_cryptography_key(private_key)
+    cert = crypto.X509.from_cryptography(certificate)
+    extra_chain = [crypto.X509.from_cryptography(item) for item in (chain or ())]
+
+    class CertificatePolicy(BrowserLikePolicyForHTTPS):
+        def creatorForNetloc(self, hostname, port):
+            options = super().creatorForNetloc(hostname, port)
+            options.privateKey = key
+            options.certificate = cert
+            options.extraCertChain = extra_chain
+            return options
+
+    return Agent(reactor, CertificatePolicy())
 
 
