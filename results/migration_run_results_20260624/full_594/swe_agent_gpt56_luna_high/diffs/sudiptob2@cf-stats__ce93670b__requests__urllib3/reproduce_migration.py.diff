--- a/reproduce_migration.py
+++ b/reproduce_migration.py
@@ -0,0 +1,17 @@
+"""Show that the request handler still depends on requests."""
+import builtins
+
+real_import = builtins.__import__
+
+
+def deny_requests(name, *args, **kwargs):
+    if name == "requests" or name.startswith("requests."):
+        raise ModuleNotFoundError("No module named 'requests'")
+    return real_import(name, *args, **kwargs)
+
+
+builtins.__import__ = deny_requests
+
+from app.services.cf_request_handler import CFRequestHandler  # noqa: E402
+
+print(CFRequestHandler)
