+# Keep the existing one-letter colour defaults while passing CSS colour names
+# to Plotly.
+_PLOTLY_COLORS = {"b": "blue", "g": "green", "r": "red", "c": "cyan",
+                  "m": "magenta", "y": "yellow", "k": "black", "w": "white"}
+
+
+def _color(color):
+    return _PLOTLY_COLORS.get(color, color)
+
+
+def _scatter_kwargs(kwargs):
+    """Translate the small set of legacy plotting keyword aliases."""
+    kwargs = dict(kwargs)
+    if "s" in kwargs:
+        kwargs.setdefault("marker", {})["size"] = kwargs.pop("s")
+    if "lw" in kwargs:
+        kwargs.setdefault("line", {})["width"] = kwargs.pop("lw")
+    if "c" in kwargs:
+        kwargs.setdefault("marker", {})["color"] = _color(kwargs.pop("c"))
+    if "label" in kwargs:
+        kwargs["name"] = kwargs.pop("label")
+    if "alpha" in kwargs:
+        kwargs["opacity"] = kwargs.pop("alpha")
+    return kwargs
+
+
+def _confidence_trace(x, lower, upper, color="black", opacity=0.3):
+    """Return a closed Plotly trace for a confidence band."""
+    x = np.asarray(x)
+    lower = np.asarray(lower)
+    upper = np.asarray(upper)
+    return go.Scatter(
+        x=np.concatenate((x, x[::-1])),
+        y=np.concatenate((upper, lower[::-1])),
+        mode="lines",
+        line={"color": "rgba(0,0,0,0)"},
+        fill="toself",
+        fillcolor=_color(color),
+        opacity=opacity,
+        hoverinfo="skip",
+        showlegend=False,
+    )
+
+
+def _validation_specs(term_dimensions):
+    rows = 2 + (len(term_dimensions) + 1) // 2
+    specs = [[{"type": "xy", "colspan": 2}, None],
+             [{"type": "xy", "colspan": 2}, None]]
+    for i in range((len(term_dimensions) + 1) // 2):
+        left = {"type": "scene" if i * 2 < len(term_dimensions)
+                and term_dimensions[i * 2] == 2 else "xy"}
+        right = {"type": "scene" if i * 2 + 1 < len(term_dimensions)
+                 and term_dimensions[i * 2 + 1] == 2 else "xy"}
+        specs.append([left, right])
+    return rows, specs
 
 
