--- a/reproduce_requests_migration.py
+++ b/reproduce_requests_migration.py
@@ -0,0 +1,17 @@
+"""Show the current HTTP implementation still depends on requests."""
+from unittest.mock import patch
+
+from fmi_weather_client import http
+
+
+class Response:
+    status_code = 200
+    text = "ok"
+    elapsed = type("Elapsed", (), {"microseconds": 0})()
+
+
+with patch("fmi_weather_client.http.requests.get", return_value=Response()) as get:
+    assert http._send_request({"example": "value"}) == "ok"
+    get.assert_called_once()
+
+print("Current implementation calls requests.get")
