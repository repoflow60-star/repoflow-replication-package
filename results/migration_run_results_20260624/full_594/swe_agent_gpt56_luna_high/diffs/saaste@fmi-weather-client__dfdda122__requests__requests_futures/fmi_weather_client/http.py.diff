+class _RequestsSession:
+    """Provide the transport expected by :class:`FuturesSession`.
+
+    ``requests_futures`` accepts a requests-compatible session. Keeping the
+    GET operation in this small adapter also preserves the module-level GET
+    behavior of the previous implementation while the request itself is
+    scheduled by ``FuturesSession``.
+    """
+
+    def request(self, method: str, url: str, **kwargs: Any) -> requests.Response:
+        if method.upper() != 'GET':
+            return requests.request(method, url, **kwargs)
+        return requests.get(url, **kwargs)
 
 
