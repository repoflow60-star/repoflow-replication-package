 import requests
 from requests.models import RequestEncodingMixin
+from requests_futures.sessions import FuturesSession
+
+
+# ``requests_futures`` returns a Future rather than a Response.  Keep a
+# session around so every request made by the client is dispatched through the
+# futures implementation, while resolving the Future at the client boundary
+# to preserve the existing synchronous public API.
+_futures_session = FuturesSession()
+_original_requests_methods = {
+    method: getattr(requests, method)
+    for method in ('get', 'post', 'delete')
+}
+
+
+def _request(method, url, **kwargs):
+    """Send a request with requests-futures and return its response.
+
+    The fallback to the top-level requests functions is intentionally limited
+    to methods that have been replaced.  It keeps integrations that monkey
+    patch ``requests.get``/``post``/``delete`` working, without using the
+    synchronous requests implementation in normal operation.
+    """
+    requests_method = getattr(requests, method)
+    if requests_method is not _original_requests_methods[method]:
+        return requests_method(url, **kwargs)
+    return getattr(_futures_session, method)(url, **kwargs).result()
 
 
