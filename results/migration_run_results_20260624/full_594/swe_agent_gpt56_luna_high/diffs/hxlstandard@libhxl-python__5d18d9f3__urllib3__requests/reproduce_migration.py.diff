--- a/reproduce_migration.py
+++ b/reproduce_migration.py
@@ -0,0 +1,22 @@
+"""Reproduce the dependency declaration problem for the migration."""
+from pathlib import Path
+
+root = Path(__file__).parent
+requirements = {
+    line.strip().split("==", 1)[0]
+    for line in (root / "requirements.txt").read_text().splitlines()
+    if line.strip() and not line.startswith("#")
+}
+
+assert "requests" in requirements, "requests is not declared"
+assert "urllib3" not in requirements, "urllib3 is still declared directly"
+assert any(line.strip() == "requests==2.34.2" for line in (root / "requirements.txt").read_text().splitlines()), \
+    "requests is not pinned to 2.34.2"
+
+setup_text = (root / "setup.py").read_text()
+assert "'requests==2.34.2'" in setup_text, "setup.py does not pin requests to 2.34.2"
+assert "'urllib3'" not in setup_text, "setup.py still declares urllib3"
+print("dependency migration declarations are correct")
+
+if __name__ == "__main__":
+    pass
