--- a/reproduce_tomlkit_migration.py
+++ b/reproduce_tomlkit_migration.py
@@ -0,0 +1,16 @@
+"""Reproduce TOML handling when only tomlkit is installed."""
+import builtins
+
+real_import = builtins.__import__
+
+def import_without_toml(name, *args, **kwargs):
+    if name == "toml" or name.startswith("toml."):
+        raise ModuleNotFoundError("No module named 'toml'")
+    return real_import(name, *args, **kwargs)
+
+builtins.__import__ = import_without_toml
+from frontmatter.default_handlers import TOMLHandler
+
+# The current implementation only knows about ``toml``, so TOMLHandler is
+# unavailable even though tomlkit is installed.
+TOMLHandler()
