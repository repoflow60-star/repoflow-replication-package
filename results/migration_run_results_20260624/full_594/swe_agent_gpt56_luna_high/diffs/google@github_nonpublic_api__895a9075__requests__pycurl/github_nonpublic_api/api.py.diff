+class PycurlHTTPError(Exception):
+    """Raised when a PycURL response has an HTTP error status."""
+
+    def __init__(self, response):
+        self.response = response
+        super().__init__(
+            "%s Server Error: %s for url: %s"
+            % (response.status_code, response.status_code, response.url)
+        )
+
+
+class PycurlResponse:
+    """The small response interface used by this module.
+
+    PycURL exposes libcurl's transfer API rather than a high-level response
+    object.  Keeping this adapter here gives the rest of the API response text,
+    response content, and status checking without another HTTP dependency.
+    """
+
+    def __init__(self, content, url, status_code, headers=None, history=None):
+        self.content = content
+        self.url = url
+        self.status_code = status_code
+        self.headers = headers or {}
+        self.history = history or []
+
+    @property
+    def encoding(self):
+        content_type = self.headers.get("content-type", "")
+        match = re.search(r"charset\s*=\s*[\"']?([^;\"'\s]+)", content_type, re.I)
+        return match.group(1) if match else None
+
+    @property
+    def text(self):
+        encoding = self.encoding or "utf-8"
+        try:
+            return self.content.decode(encoding)
+        except (LookupError, UnicodeDecodeError):
+            return self.content.decode(encoding, errors="replace")
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise PycurlHTTPError(self)
+
+
+class _PycurlCookies:
+    """Cookie-jar compatibility used by ``create_login_session``."""
+
+    def __init__(self, curl):
+        self._curl = curl
+
+    def clear(self):
+        # COOKIELIST=ALL removes every cookie in libcurl's in-memory jar.
+        self._curl.setopt(pycurl.COOKIELIST, "ALL")
+
+
+class PycurlSession:
+    """A session-like wrapper around one reusable PycURL handle."""
+
+    def __init__(self):
+        self._curl = pycurl.Curl()
+        # An empty cookie file enables libcurl's in-memory cookie engine.  The
+        # same handle is reused for every request, so login cookies persist.
+        self._curl.setopt(pycurl.COOKIEFILE, "")
+        self.cookies = _PycurlCookies(self._curl)
+
+    @staticmethod
+    def _encode_form(data):
+        if data is None:
+            return b""
+        if isinstance(data, bytes):
+            return data
+        if isinstance(data, str):
+            return data.encode("utf-8")
+        return urlencode(data, doseq=True).encode("utf-8")
+
+    @staticmethod
+    def _headers_from_bytes(header_lines):
+        # A redirect produces several header blocks.  The last block belongs
+        # to the response represented by the body, so discard earlier blocks.
+        current = {}
+        for raw_header in header_lines:
+            line = raw_header.decode("iso-8859-1").strip()
+            if line.startswith("HTTP/"):
+                current = {}
+            elif ":" in line:
+                name, value = line.split(":", 1)
+                current[name.lower()] = value.strip()
+        return current
+
+    def _request(self, url, data=None):
+        body = io.BytesIO()
+        header_lines = []
+
+        def receive_header(header):
+            header_lines.append(header)
+            return len(header)
+
+        self._curl.setopt(pycurl.URL, url)
+        self._curl.setopt(pycurl.WRITEDATA, body)
+        self._curl.setopt(pycurl.HEADERFUNCTION, receive_header)
+        self._curl.setopt(pycurl.FOLLOWLOCATION, True)
+        self._curl.setopt(pycurl.ACCEPT_ENCODING, "")
+
+        if data is None:
+            # HTTPGET also clears the POST mode left by a preceding login
+            # submission.  POSTFIELDS must be reset on a reused Curl handle.
+            self._curl.setopt(pycurl.POSTFIELDS, b"")
+            self._curl.setopt(pycurl.HTTPGET, True)
+        else:
+            self._curl.setopt(pycurl.HTTPGET, False)
+            self._curl.setopt(pycurl.POST, True)
+            self._curl.setopt(pycurl.POSTFIELDS, self._encode_form(data))
+
+        self._curl.perform()
+        status_code = self._curl.getinfo(pycurl.RESPONSE_CODE)
+        effective_url = self._curl.getinfo(pycurl.EFFECTIVE_URL) or url
+        return PycurlResponse(
+            content=body.getvalue(),
+            url=effective_url,
+            status_code=status_code,
+            headers=self._headers_from_bytes(header_lines),
+        )
+
+    def get(self, url):
+        return self._request(url)
+
+    def post(self, url, data=None):
+        return self._request(url, data=data)
+
+    def close(self):
+        self._curl.close()
 
 
