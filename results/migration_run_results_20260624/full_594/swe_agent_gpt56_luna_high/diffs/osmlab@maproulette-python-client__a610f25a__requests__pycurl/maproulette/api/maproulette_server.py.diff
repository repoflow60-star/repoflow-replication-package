 from .errors import HttpError, InvalidJsonError, ConnectionUnavailableError, UnauthorizedError, NotFoundError
 
 
+class _PycurlResponse:
+    """The response attributes used by the rest of this package.
+
+    PycURL writes response data to a file-like object and exposes the status
+    code through ``getinfo``.  Keeping that translation in one place makes
+    response decoding identical for all HTTP verbs.
+    """
+
+    def __init__(self, content, status_code, headers=b''):
+        self.content = content
+        self.status_code = status_code
+        self.headers = headers
+
+    @property
+    def text(self):
+        return self.content.decode('utf-8', errors='replace')
+
+    @property
+    def ok(self):
+        return self.status_code < 400
+
+    def json(self):
+        return json.loads(self.text)
+
+
+class _PycurlSession:
+    """A minimal session-like adapter backed by a fresh curl handle per call."""
+
+    def __init__(self, headers=None, verify=True, certs=None):
+        self.headers = headers or {}
+        self.verify = verify
+        self.certs = certs
+
+    def get(self, url, params=None):
+        return self._request('GET', url, params=params)
+
+    def post(self, url, params=None, json_body=None):
+        return self._request('POST', url, params=params, json_body=json_body)
+
+    def put(self, url, params=None, json_body=None):
+        return self._request('PUT', url, params=params, json_body=json_body)
+
+    def put_file(self, url, params=None, files=None):
+        return self._request('PUT', url, params=params, files=files)
+
+    def delete(self, url, params=None):
+        return self._request('DELETE', url, params=params)
+
+    def _request(self, method, url, params=None, json_body=None, files=None):
+        url = self._url_with_params(url, params)
+        body = BytesIO()
+        response_headers = BytesIO()
+        curl = pycurl.Curl()
+
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEDATA, body)
+            curl.setopt(pycurl.HEADERFUNCTION, response_headers.write)
+            curl.setopt(pycurl.FOLLOWLOCATION, True)
+            curl.setopt(pycurl.SSL_VERIFYPEER, 1 if self.verify else 0)
+            # libcurl requires 2 for normal hostname verification and 0 when
+            # verification is disabled.
+            curl.setopt(pycurl.SSL_VERIFYHOST, 2 if self.verify else 0)
+            curl.setopt(pycurl.HTTPHEADER, self._headers(files is not None,
+                                                          json_body is not None))
+            self._set_client_certificate(curl)
+
+            if method == 'GET':
+                curl.setopt(pycurl.HTTPGET, True)
+            elif method == 'DELETE':
+                curl.setopt(pycurl.CUSTOMREQUEST, 'DELETE')
+            elif method == 'POST' and files is None:
+                # CUSTOMREQUEST changes the method name but does not switch
+                # curl out of its default GET transfer mode.
+                curl.setopt(pycurl.POST, True)
+                if json_body is not None:
+                    curl.setopt(pycurl.POSTFIELDS,
+                                json.dumps(json_body).encode('utf-8'))
+            elif files is not None:
+                curl.setopt(pycurl.CUSTOMREQUEST, method)
+                curl.setopt(pycurl.HTTPPOST, self._multipart_form(files))
+            else:
+                curl.setopt(pycurl.CUSTOMREQUEST, method)
+                if json_body is not None:
+                    # POSTFIELDS accepts bytes and avoids an implicit locale
+                    # conversion for non-ASCII JSON data.
+                    curl.setopt(pycurl.POSTFIELDS,
+                                json.dumps(json_body).encode('utf-8'))
+
+            curl.perform()
+            return _PycurlResponse(
+                body.getvalue(),
+                curl.getinfo(pycurl.RESPONSE_CODE),
+                response_headers.getvalue()
+            )
+        except pycurl.error as error:
+            # A curl error has no HTTP response and therefore cannot be
+            # classified as an API error (404, 401, etc.).
+            raise ConnectionUnavailableError(message=str(error)) from None
+        finally:
+            curl.close()
+
+    def _headers(self, multipart=False, json_body=False):
+        headers = []
+        has_content_type = False
+        for name, value in self.headers.items():
+            if value is None:
+                continue
+            has_content_type = has_content_type or name.lower() == 'content-type'
+            headers.append(f'{name}: {value}')
+        if json_body and not has_content_type:
+            headers.append('Content-Type: application/json')
+        # libcurl supplies the multipart content type and boundary itself.
+        return headers
+
+    def _set_client_certificate(self, curl):
+        if not self.certs:
+            return
+        if isinstance(self.certs, (tuple, list)):
+            if self.certs:
+                curl.setopt(pycurl.SSLCERT, self.certs[0])
+            if len(self.certs) > 1 and self.certs[1]:
+                curl.setopt(pycurl.SSLKEY, self.certs[1])
+        else:
+            curl.setopt(pycurl.SSLCERT, self.certs)
+
+    @staticmethod
+    def _url_with_params(url, params):
+        if not params:
+            return url
+        if hasattr(params, 'items'):
+            params = [(key, value) for key, value in params.items()
+                      if value is not None]
+        else:
+            params = [(key, value) for key, value in params if value is not None]
+        if not params:
+            return url
+        query = urlencode(params, doseq=True)
+        parts = urlsplit(url)
+        old_query = f'{parts.query}&' if parts.query else ''
+        return urlunsplit((parts.scheme, parts.netloc, parts.path,
+                           old_query + query, parts.fragment))
+
+    @staticmethod
+    def _multipart_form(files):
+        form = []
+        for name, value in files.items():
+            if isinstance(value, tuple):
+                filename, contents = (value + (None, None))[:2]
+                if hasattr(contents, 'read'):
+                    contents = contents.read()
+                if contents is None:
+                    contents = b''
+                if not isinstance(contents, (bytes, bytearray)):
+                    contents = str(contents).encode('utf-8')
+                form.append((name, (pycurl.FORM_BUFFER, str(filename),
+                                    pycurl.FORM_CONTENTS, bytes(contents))))
+            else:
+                form.append((name, str(value)))
+        return form
+
