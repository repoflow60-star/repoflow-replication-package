+class _PycurlSession:
+    """A persistent session backed by a single curl handle."""
+
+    def __init__(self) -> None:
+        self._curl: Optional[pycurl.Curl] = pycurl.Curl()
+        self.headers: dict[str, Any] = {}
+
+    def close(self) -> None:
+        """Release the curl handle."""
+        if self._curl is not None:
+            self._curl.close()
+            self._curl = None
+
+    @staticmethod
+    def _query_url(url: str, params: Any) -> str:
+        if not params:
+            return url
+
+        # Omit parameters whose value is None, matching common HTTP client
+        # behavior while retaining support for repeated values (for example, ``titles``).
+        if hasattr(params, "items"):
+            params = [
+                (key, value) for key, value in params.items() if value is not None
+            ]
+        else:
+            params = [(key, value) for key, value in params if value is not None]
+        query = parse.urlencode(params, doseq=True)
+        if not query:
+            return url
+        return url + ("&" if "?" in url else "?") + query
+
+    @staticmethod
+    def _proxy_for(url: str, proxies: Any) -> Optional[str]:
