+def tabulate(rows: List[List], headers: List[str], tablefmt: str) -> str:
+    """Render rows using PrettyTable's equivalent table styles.
+
+    The function keeps the report renderer's existing call interface while
+    using PrettyTable for the actual formatting.  PrettyTable does not have
+    an rST style, so its default style is used for rST reports; GitHub reports
+    use PrettyTable's Markdown style.
+    """
+    table = PrettyTable(headers)
+    table.add_rows(rows)
+    if tablefmt == "github":
+        table.set_style(TableStyle.MARKDOWN)
+    return table.get_string()
 
 
