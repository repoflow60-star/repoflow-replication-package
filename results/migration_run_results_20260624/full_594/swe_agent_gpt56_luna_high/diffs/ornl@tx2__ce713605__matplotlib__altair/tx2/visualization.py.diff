+def _metric_chart(data: pd.DataFrame, value_columns: List[str], title: str):
+    """Create a compact heatmap/table for metric values."""
+    if data.empty:
+        return alt.Chart(data).mark_text().properties(title=title)
+    long_data = data.melt(
+        id_vars=["metric"], value_vars=value_columns, var_name="class", value_name="value"
+    )
+    heatmap = alt.Chart(long_data).mark_rect().encode(
+        x=alt.X("class:N", title=None),
+        y=alt.Y("metric:N", title=None),
+        color=alt.Color("value:Q", scale=alt.Scale(domain=[0, 1], scheme="redyellowgreen"), title="score"),
+        tooltip=["metric:N", "class:N", alt.Tooltip("value:Q", format=".3f")],
+    )
+    labels = alt.Chart(long_data).mark_text().encode(
+        x="class:N", y="metric:N", text=alt.Text("value:Q", format=".3f"), color=alt.value("black")
+    )
+    return (heatmap + labels).properties(title=title)
 
 
