+        # on every Altair data transformer.
+        color = str(color)
+        rows.append(
+            {
+                "x": float(px),
+                "y": float(py),
+                "color": color,
+                "class": inverse.get(int(target_classes[point_index]), "") if target_classes is not None else "",
+                "size": size,
+                "opacity": opacity,
+            }
+        )
