+class _TextCloud:
+    """Small, dependency-free image representation of a word cloud.
+
+    The previous implementation used a separate plotting package, which imported
+    an additional plotting backend even when the image was only embedded in a notebook.  Keeping the
+    rendered image as a PIL object gives the Altair image mark the same input
+    contract without bringing a second plotting stack into the package.
+    """
+
+    def __init__(self, text):
+        words = re.findall(r"[\w']+", text.lower())
+        self.frequencies = Counter(word for word in words if word not in STOPWORDS)
+
+    def to_image(self):
+        image = Image.new("RGB", (800, 400), "white")
+        draw = ImageDraw.Draw(image)
+        try:
+            font_path = ImageFont.truetype("DejaVuSans.ttf", 24).path
+        except (OSError, AttributeError):
+            font_path = None
+        words = self.frequencies.most_common(40)
+        max_frequency = words[0][1] if words else 1
+        x, y = 15, 15
+        for word, frequency in words:
+            size = max(12, int(12 + 32 * frequency / max_frequency))
+            try:
+                font = ImageFont.truetype(font_path, size) if font_path else ImageFont.load_default()
+            except OSError:
+                font = ImageFont.load_default()
+            width = draw.textbbox((0, 0), word, font=font)[2]
+            if x + width > 785:
+                x, y = 15, y + 45
+            if y > 370:
+                break
+            draw.text((x, y), word, fill="#333333", font=font)
+            x += width + 15
+        return image
+
+
