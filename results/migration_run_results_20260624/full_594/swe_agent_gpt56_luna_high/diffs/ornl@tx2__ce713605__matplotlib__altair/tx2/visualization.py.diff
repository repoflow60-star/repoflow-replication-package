+
+def _wordcloud_data(cloud):
+    """Convert a wordcloud/PIL image into a notebook-safe data URL."""
+    image = cloud.to_image() if hasattr(cloud, "to_image") else cloud
+    output = io.BytesIO()
+    image.save(output, format="PNG")
+    encoded = base64.b64encode(output.getvalue()).decode("ascii")
+    return "data:image/png;base64," + encoded
+
+
+def _wordcloud_chart(cloud, title):
+    data = pd.DataFrame({"x": [0], "y": [0], "url": [_wordcloud_data(cloud)]})
+    return (
+        alt.Chart(data)
+        .mark_image(width=800, height=400)
+        .encode(
+            x=alt.X("x:Q", axis=None, scale=alt.Scale(domain=[-1, 1])),
+            y=alt.Y("y:Q", axis=None, scale=alt.Scale(domain=[-1, 1])),
+            url=alt.Url("url:N"),
+        )
+        .properties(width=800, height=400, title=str(title))
+        .configure_view(stroke=None)
+    )
 
 
