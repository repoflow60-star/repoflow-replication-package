+def _append_points(rows, x, y, colors, encodings, size, opacity=1.0, target_classes=None):
+    inverse = _projection_class_names(encodings)
+    for point_index, (px, py, color) in enumerate(zip(np.asarray(x), np.asarray(y), np.asarray(colors))):
