--- a/ash_model/viz/_plotly.py
+++ b/ash_model/viz/_plotly.py
@@ -0,0 +1,101 @@
+"""Small helpers shared by the Plotly-based visualizations."""
+
+from __future__ import annotations
+
+from typing import Any, MutableMapping
+
+import plotly.graph_objects as go
+
+
+_LAYOUT_KEYS = {
+    "autosize",
+    "height",
+    "hovermode",
+    "template",
+    "title",
+    "width",
+    "xaxis",
+    "yaxis",
+    "showlegend",
+}
+
+
+def figure_from_kwargs(kwargs: MutableMapping[str, Any]) -> go.Figure:
+    """Return the requested figure and remove figure/layout arguments.
+
+    ``fig`` is the Plotly equivalent of the old ``ax`` argument.  ``figure``
+    and ``ax`` are accepted as aliases so callers can use an existing figure
+    without having to special-case the plotting function they call.
+    """
+    figure = kwargs.pop("fig", None)
+    if figure is None:
+        figure = kwargs.pop("figure", None)
+    if figure is None:
+        figure = kwargs.pop("ax", None)
+    if figure is None:
+        figure = go.Figure()
+    if not isinstance(figure, go.Figure):
+        raise TypeError("fig must be a plotly.graph_objects.Figure")
+
+    layout = {key: kwargs.pop(key) for key in tuple(kwargs) if key in _LAYOUT_KEYS}
+    if layout:
+        figure.update_layout(**layout)
+    return figure
+
+
+def trace_kwargs(kwargs: MutableMapping[str, Any], kind: str = "scatter") -> dict[str, Any]:
+    """Translate the few commonly used Matplotlib options to Plotly options.
+
+    Plotly keyword arguments are otherwise passed through unchanged.  This
+    keeps the functions useful with Plotly's extensive trace options while
+    making the old ``alpha``, ``color`` and line-width spellings harmless for
+    existing users.
+    """
+    options = dict(kwargs)
+    for key in ("fig", "figure", "ax", *_LAYOUT_KEYS):
+        options.pop(key, None)
+
+    if "alpha" in options and "opacity" not in options:
+        options["opacity"] = options.pop("alpha")
+    if "linewidth" in options and "line" not in options:
+        options["line"] = {"width": options.pop("linewidth")}
+    if "lw" in options and "line" not in options:
+        options["line"] = {"width": options.pop("lw")}
+    if "linestyle" in options and "line" not in options:
+        options["line"] = {"dash": _line_dash(options.pop("linestyle"))}
+    if "ls" in options and "line" not in options:
+        options["line"] = {"dash": _line_dash(options.pop("ls"))}
+
+    # Matplotlib uses color as a top-level option; Plotly puts it in the
+    # marker or line object depending on the trace.
+    if "color" in options:
+        color = options.pop("color")
+        if kind in {"bar", "marker", "violin"}:
+            options.setdefault("marker", {})
+            if isinstance(options["marker"], dict):
+                options["marker"].setdefault("color", color)
+        else:
+            options.setdefault("line", {})
+            if isinstance(options["line"], dict):
+                options["line"].setdefault("color", color)
+
+    # A dot format string is used by the old implementation for distributions.
+    # Plotly has no format-string positional argument, so provide its natural
+    # marker equivalent when it is supplied as a keyword.
+    marker = options.get("marker")
+    if isinstance(marker, str):
+        options["marker"] = {"symbol": "circle" if marker == "." else marker}
+
+    return options
+
+
+def _line_dash(value: Any) -> Any:
+    return {"-": "solid", "--": "dash", ":": "dot", "-.": "dashdot"}.get(
+        value, value
+    )
+
+
+def set_loglog(figure: go.Figure) -> None:
+    """Use logarithmic axes, matching ``Axes.loglog``."""
+    figure.update_xaxes(type="log")
+    figure.update_yaxes(type="log")
