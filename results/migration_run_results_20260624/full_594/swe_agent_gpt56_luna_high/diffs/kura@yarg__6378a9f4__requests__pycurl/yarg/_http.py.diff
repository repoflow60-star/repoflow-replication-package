--- a/yarg/_http.py
+++ b/yarg/_http.py
@@ -0,0 +1,48 @@
+# -*- coding: utf-8 -*-
+
+"""Small HTTP response adapter built on top of :mod:`pycurl`."""
+
+try:
+    from http.client import responses
+except ImportError:  # pragma: no cover - Python 2 compatibility
+    from httplib import responses
+from io import BytesIO
+
+import pycurl
+
+
+class Response(object):
+    """The small part of an HTTP response used by yarg."""
+
+    def __init__(self, status_code, content):
+        self.status_code = status_code
+        self.reason = responses.get(status_code, '')
+        self.content = content
+
+
+def get(url):
+    """Fetch *url* with pycurl and return a response-like object."""
+    body = BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        # WRITEFUNCTION works with both the Python 2 and Python 3 PycURL
+        # bindings, whereas WRITEDATA has changed behavior between versions.
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        # Follow redirects as the previous HTTP client did by default.
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        return Response(status_code, body.getvalue())
+    finally:
+        curl.close()
+
+
+class Session(object):
+    """Session-shaped facade retained for the client's internal API."""
+
+    def get(self, url):
+        return get(url)
+
+
+session = Session()
