+async def _fetch_response(url: str):
+    """Fetch a response with aiohttp and return its status and body."""
+    async with aiohttp.ClientSession() as session:
+        async with session.get(url) as response:
+            return response.status, await response.read()
+
+
+def _run_async(coro):
+    """Run an aiohttp coroutine from the library's synchronous API.
+
+    The public NameSilo API predates aiohttp and is synchronous.  Normally
+    ``asyncio.run`` is sufficient, but synchronous callers can also be made
+    from code that already owns an event loop (for example, a notebook).  In
+    that case the coroutine is run in a short-lived worker thread instead of
+    trying to nest event loops.
+    """
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coro)
+
+    result = []
+    error = []
+
+    def run_in_thread():
+        try:
+            result.append(asyncio.run(coro))
+        except BaseException as exc:  # propagate the original exception
+            error.append(exc)
+
+    thread = threading.Thread(target=run_in_thread)
+    thread.start()
+    thread.join()
+
+    if error:
+        raise error[0]
+    return result[0]
+
+
+class _AiohttpResponse:
+    """Small response object retained for the old internal response contract."""
+
+    def __init__(self, status_code: int, content: bytes):
+        self.status_code = status_code
+        self.content = content
+
+
+class _AiohttpRequestsCompat:
+    """Requests-like facade backed entirely by aiohttp.
+
+    ``requests.get`` was part of the module's internal surface and existing
+    users may patch it in tests.  Keeping this tiny facade avoids breaking
+    those users while ensuring that all network I/O is performed by aiohttp.
+    """
+
+    @staticmethod
+    def get(url: str) -> _AiohttpResponse:
+        status_code, content = _run_async(_fetch_response(url))
+        return _AiohttpResponse(status_code, content)
+
+
+# Kept as a compatibility namespace; this is not the requests package.
+_http_client = _AiohttpRequestsCompat()
+requests = _http_client
 
