--- a/smartystreets_python_sdk/http_request.py
+++ b/smartystreets_python_sdk/http_request.py
@@ -0,0 +1,40 @@
+class HTTPRequest:
+    """Small transport-neutral representation of an HTTP request.
+
+    urllib3 sends requests directly rather than exposing a prepared Request
+    object like requests does.  Keeping this object internal lets the sender
+    chain continue to build and decorate requests before they are sent.
+    """
+
+    def __init__(self, url, params=None, headers=None, body=None, method='GET'):
+        self.url = url
+        self.params = params or {}
+        self.headers = headers or {}
+        self._body = body
+        self.method = method
+
+    @property
+    def body(self):
+        return self._body
+
+    @body.setter
+    def body(self, value):
+        self._body = value
+
+    # ``data`` is retained as an alias for the old sender-chain API.
+    @property
+    def data(self):
+        return self._body
+
+    @data.setter
+    def data(self, value):
+        self._body = value
+
+    @property
+    def url_with_params(self):
+        from urllib.parse import urlencode
+
+        if not self.params:
+            return self.url
+        separator = '&' if '?' in self.url else '?'
+        return self.url + separator + urlencode(self.params, doseq=True)
