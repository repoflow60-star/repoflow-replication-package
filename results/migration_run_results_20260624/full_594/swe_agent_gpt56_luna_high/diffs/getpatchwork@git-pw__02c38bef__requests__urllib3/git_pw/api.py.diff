+def _request(
+    operation: str,
+    method: str,
+    url: str,
+    fields: ty.Optional[ty.List[ty.Tuple[str, ty.Any]]] = None,
+    stream: bool = False,
+    optional_auth: bool = False,
+) -> urllib3.BaseHTTPResponse:
+    """Make an HTTP request and handle transport and HTTP status errors."""
+    LOG.debug('%s %s', method, url)
+
+    headers = _get_headers()
+    auth = _get_auth(optional=optional_auth)
+    if auth:
+        headers.update(auth)
+
+    try:
+        request_options = {}
+        if method in ('POST', 'PATCH'):
+            # Form data is URL-encoded by default by the previous client.
+            request_options['encode_multipart'] = False
+
+        rsp = HTTP.request(
+            method,
+            url,
+            fields=fields,
+            headers=headers,
+            preload_content=not stream,
+            **request_options,
+        )
+        if rsp.status >= 400:
+            raise _HTTPStatusError(rsp)
+    except urllib3.exceptions.HTTPError as exc:
+        _handle_error(operation, exc)
+
+    LOG.debug('Got response')
+    return rsp
