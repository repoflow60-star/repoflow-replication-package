+    @classmethod
+    def _start_reactor(cls):
+        """Start the reactor once, without taking ownership of the main thread."""
+        with cls._lock:
+            if cls._reactor_started:
+                return
+            cls._reactor_started = True
+            if reactor.running:
+                # An application embedding PastePwn may already own the
+                # reactor's thread.
+                cls._reactor_ready.set()
+                return
+
+            def run_reactor():
+                reactor.callWhenRunning(cls._reactor_ready.set)
+                reactor.run(installSignalHandlers=False)
+
+            Thread(target=run_reactor, name="PastePwnReactor", daemon=True).start()
+
+        # Do not submit work before the reactor has entered its event loop.
+        if not cls._reactor_ready.wait(5):
+            raise RuntimeError("The Twisted reactor could not be started")
+
+    def _proxy_url(self, url):
+        """Return the proxy URL applicable to *url*, if one is configured."""
+        parsed_url = urlsplit(url)
+        scheme = parsed_url.scheme.lower()
+
+        # An explicitly supplied mapping takes precedence over environment
+        # proxies, matching the old requests-based behaviour.
+        if self.proxies is not None:
+            if not isinstance(self.proxies, dict):
+                return None
+            proxy = self.proxies.get(scheme)
+            if proxy is None:
+                proxy = self.proxies.get("all")
+            return proxy or None
+
+        if parsed_url.hostname and proxy_bypass(parsed_url.hostname):
+            return None
+        return getproxies().get(scheme)
+
+    def _client(self, url):
+        """Build a treq client, optionally using an HTTP proxy."""
+        proxy_url = self._proxy_url(url)
+        if not proxy_url:
+            return HTTPClient(Agent(reactor))
+
+        parsed_proxy = urlsplit(proxy_url)
+        if not parsed_proxy.hostname:
+            raise ValueError(f"Invalid proxy URL: {proxy_url}")
+        proxy_port = parsed_proxy.port or (443 if parsed_proxy.scheme == "https" else 80)
+        endpoint = HostnameEndpoint(reactor, parsed_proxy.hostname, proxy_port)
+        return HTTPClient(ProxyAgent(endpoint, reactor=reactor))
 
