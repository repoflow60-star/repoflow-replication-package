+class _FigureAxesAdapter:
+    """Small compatibility layer for callers of the former axes API.
+
+    Plotly does not expose axes objects. Keeping ``get_title`` available on
+    ``Gantt.ax`` avoids breaking existing clients while the actual chart is a
+    Plotly figure.
+    """
+
+    def __init__(self, figure):
+        self._figure = figure
+
+    def get_title(self):
+        """Return the figure title through the legacy axes-style API."""
+        return self._figure.layout.title.text or ""
+
+    def __getattr__(self, name):
+        return getattr(self._figure, name)
 
 
