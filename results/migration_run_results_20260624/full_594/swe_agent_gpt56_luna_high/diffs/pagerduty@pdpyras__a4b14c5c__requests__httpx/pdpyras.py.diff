+def _response_ok(response: Response) -> bool:
+    """Return whether a response has a successful HTTP status code.
+
+    ``httpx.Response`` exposes this as ``is_success`` (Requests used ``ok``).
+    Keeping the fallback makes the response helpers useful with lightweight
+    response doubles as well.
+    """
+    try:
+        return response.is_success
+    except AttributeError:
+        return response.ok
+
