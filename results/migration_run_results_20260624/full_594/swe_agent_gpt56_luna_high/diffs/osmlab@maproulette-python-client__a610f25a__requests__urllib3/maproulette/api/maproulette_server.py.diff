+"""Low-level HTTP support for the MapRoulette API.
+
+The client uses urllib3 directly rather than relying on the requests package.  A
+small session/response adapter is kept here because the rest of the client has
+historically used the requests-style ``session.get``/``response.json`` API.
+"""
+
 import json
+import ssl
 import time
