 from .errors import HttpError, InvalidJsonError, ConnectionUnavailableError, UnauthorizedError, NotFoundError
 
 
+class _Urllib3Response:
+    """Provide the response operations used by the public API."""
+
+    def __init__(self, response):
+        self._response = response
+
+    @property
+    def status_code(self):
+        return self._response.status
+
+    @property
+    def headers(self):
+        return self._response.headers
+
+    @property
+    def ok(self):
+        return 200 <= self.status_code < 400
+
+    @property
+    def data(self):
+        return self._response.data
+
+    @property
+    def text(self):
+        data = self.data
+        if isinstance(data, str):
+            return data
+        return data.decode("utf-8", errors="replace")
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            error = urllib3.exceptions.HTTPError(
+                "HTTP status {} ({})".format(self.status_code, self._response.reason)
+            )
+            # urllib3 does not attach a response to HTTPError.  The server's
+            # error mapping needs it, so attach the adapter explicitly.
+            error.response = self
+            raise error
+
+
+class _Urllib3Session:
+    """A minimal requests.Session-compatible facade backed by PoolManager."""
+
+    def __init__(self):
+        self.headers = {}
+        self.verify = True
+        self.cert = None
+        self._pool = None
+        self._pool_settings = None
+
+    def _get_pool(self):
+        cert = self.cert
+        if isinstance(cert, (tuple, list)):
+            cert_file = cert[0] if cert else None
+            key_file = cert[1] if len(cert) > 1 else None
+        else:
+            cert_file = cert
+            key_file = None
+
+        settings = (self.verify, cert_file, key_file)
+        if self._pool is None or self._pool_settings != settings:
+            pool_kwargs = {
+                "cert_reqs": ssl.CERT_REQUIRED if self.verify else ssl.CERT_NONE,
+                # Retries are handled by MapRouletteServer's health check.
+                "retries": False,
+            }
+            if cert_file:
+                pool_kwargs["cert_file"] = cert_file
+            if key_file:
+                pool_kwargs["key_file"] = key_file
+            self._pool = urllib3.PoolManager(**pool_kwargs)
+            self._pool_settings = settings
+        return self._pool
+
+    @staticmethod
+    def _url_with_params(url, params):
+        if not params:
+            return url
+        if isinstance(params, bytes):
+            query = params.decode("ascii")
+        elif isinstance(params, str):
+            query = params
+        else:
+            # Accept both mappings and the list-of-pairs form supported by
+            # requests.  doseq preserves list-valued parameters.
+            items = params.items() if hasattr(params, "items") else params
+            query = urlencode(
+                [(key, value) for key, value in items if value is not None],
+                doseq=True,
+            )
+        if not query:
+            return url
+        separator = "" if url.endswith(("?", "&")) else ("&" if "?" in url else "?")
+        return "{}{}{}".format(url, separator, query)
+
+    def request(self, method, url, params=None, json_body=None, files=None):
+        headers = {key: value for key, value in self.headers.items() if value is not None}
+        url = self._url_with_params(url, params)
+        try:
+            if files is not None:
+                response = self._get_pool().request(
+                    method,
+                    url,
+                    fields=files,
+                    headers=headers,
+                )
+            elif json_body is not None:
+                response = self._get_pool().request(
+                    method,
+                    url,
+                    json=json_body,
+                    headers=headers,
+                )
+            else:
+                response = self._get_pool().request(
+                    method,
+                    url,
+                    headers=headers,
+                )
+        except urllib3.exceptions.HTTPError as error:
+            raise ConnectionUnavailableError(message=str(error)) from None
+        return _Urllib3Response(response)
+
+    def get(self, url, params=None):
+        return self.request("GET", url, params=params)
+
+    def post(self, url, params=None, json=None):
+        return self.request("POST", url, params=params, json_body=json)
+
+    def put(self, url, params=None, json=None, files=None):
+        return self.request("PUT", url, params=params, json_body=json, files=files)
+
+    def delete(self, url, params=None):
+        return self.request("DELETE", url, params=params)
+
+
+# The alias is intentionally private to the implementation.  It also leaves a
+# stable Session patch point for applications that used the old test seam; it
+# is not an import of, or a dependency on, requests.
+requests = SimpleNamespace(Session=_Urllib3Session)
+
+
+def _get(url, headers, verify, cert):
+    session = _Urllib3Session()
+    session.headers = headers
+    session.verify = verify
+    session.cert = cert
+    return session.get(url)
+
