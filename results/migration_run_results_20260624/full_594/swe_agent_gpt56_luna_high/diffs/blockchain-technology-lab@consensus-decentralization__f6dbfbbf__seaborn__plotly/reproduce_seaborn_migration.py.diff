--- a/reproduce_seaborn_migration.py
+++ b/reproduce_seaborn_migration.py
@@ -0,0 +1,12 @@
+"""Exercise the palette conversion used by the plotting module."""
+import numpy as np
+from consensus_decentralization.plot import _get_colors
+
+for count in (0, 1, 3, 256, 257):
+    colors = _get_colors(count)
+    assert len(colors) == count
+    assert all(len(color) == 3 and all(0 <= channel <= 1 for channel in color) for color in colors)
+
+# Requests beyond Glasbey's size should cycle just as the old seaborn palette did.
+assert _get_colors(257)[0] == _get_colors(257)[-1]
+print("Plotly palette conversion works for empty, normal, and oversized palettes.")
