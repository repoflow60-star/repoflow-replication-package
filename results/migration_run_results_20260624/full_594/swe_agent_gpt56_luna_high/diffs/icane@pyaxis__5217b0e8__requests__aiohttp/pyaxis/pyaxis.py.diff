+async def _read_url(uri, encoding, timeout):
+    """Read a URL asynchronously with aiohttp."""
+    client_timeout = aiohttp.ClientTimeout(total=timeout)
+    async with aiohttp.ClientSession(timeout=client_timeout) as session:
+        async with session.get(uri) as response:
+            response.raise_for_status()
+            return (await response.read()).decode(encoding)
+
+
+def _run_async(coroutine):
+    """Run a coroutine from the synchronous public API.
+
+    ``asyncio.run`` cannot be called while another event loop is running (for
+    example, from a notebook).  In that case the request is run in a short-
+    lived worker thread with its own event loop.
+    """
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coroutine)
+
+    result = []
+    error = []
+
+    def run_in_thread():
+        try:
+            result.append(asyncio.run(coroutine))
+        except BaseException as exception:  # propagate the original error
+            error.append(exception)
+
+    thread = threading.Thread(target=run_in_thread)
+    thread.start()
+    thread.join()
+
+    if error:
+        raise error[0]
+    return result[0]
+
