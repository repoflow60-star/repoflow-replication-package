+
+class _PycurlResponse:
+    """Small response object containing the parts used by the public API."""
+
+    def __init__(self, content: bytes, status_code: int):
+        self.content = content
+        self.status_code = status_code
+
+    @property
+    def text(self) -> str:
+        # Nyaa serves UTF-8 HTML/RSS.  Latin-1 is a lossless fallback for
+        # responses that do not declare a charset.
+        try:
+            return self.content.decode("utf-8")
+        except UnicodeDecodeError:
+            return self.content.decode("latin-1")
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise RuntimeError(f"HTTP request failed with status {self.status_code}")
+
+
+def _get(url: str) -> _PycurlResponse:
+    """Fetch *url* with PycURL and return the response body and status code."""
+    body = BytesIO()
+    curl = pycurl.Curl()
+    try:
+        # Prepare URLs before sending them; in particular, this makes search
+        # terms containing spaces valid for libcurl as well.
+        curl.setopt(pycurl.URL, quote(url, safe=":/?#[]@!$&'()*+,;=%~-"))
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.WRITEDATA, body)
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+
+    return _PycurlResponse(body.getvalue(), status_code)
 
 
