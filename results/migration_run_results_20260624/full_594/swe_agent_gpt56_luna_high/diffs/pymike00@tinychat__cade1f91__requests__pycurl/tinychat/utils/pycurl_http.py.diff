--- a/tinychat/utils/pycurl_http.py
+++ b/tinychat/utils/pycurl_http.py
@@ -0,0 +1,90 @@
+"""Small HTTP adapter backed by :mod:`pycurl`.
+
+The LLM clients only need a POST operation and an iterable response body for
+Server-Sent Events.  Keeping that small interface here avoids coupling the
+clients to a second HTTP implementation while retaining response streaming
+semantics for ``sseclient``.
+"""
+
+from __future__ import annotations
+
+import json as json_module
+from typing import Any, Iterator
+
+import pycurl
+
+
+class Response:
+    """The part of an HTTP response used by the LLM clients.
+
+    The body is kept as chunks rather than being decoded.  ``sseclient``
+    expects an iterable of byte strings and is responsible for parsing those
+    chunks as SSE data.
+    """
+
+    def __init__(self, status_code: int, chunks: list[bytes]) -> None:
+        self.status_code = status_code
+        self._chunks = chunks
+        self.content = b"".join(chunks)
+
+    def __iter__(self) -> Iterator[bytes]:
+        return iter(self._chunks)
+
+    def read(self, size: int = -1) -> bytes:
+        """Return the response body, matching the file-like API SSEClient uses."""
+        if size == 0:
+            return b""
+        content = self.content
+        if size < 0:
+            return content
+        return content[:size]
+
+    def close(self) -> None:
+        """Close the response.
+
+        pycurl closes the transfer before a ``Response`` is returned, so this
+        method exists for the ``SSEClient.close`` contract.
+        """
+
+    def json(self) -> Any:
+        """Decode a JSON response when a caller needs it."""
+        return json_module.loads(self.content.decode("utf-8"))
+
+
+def post(
+    url: str,
+    *,
+    headers: dict[str, str] | None = None,
+    json: Any = None,
+    stream: bool = False,
+) -> Response:
+    """Perform a JSON POST request with pycurl.
+
+    ``stream`` is accepted for API compatibility with the old client call
+    sites.  The transfer is captured in chunks, so consumers such as
+    ``sseclient`` can still iterate over the returned byte chunks.
+    """
+    del stream
+
+    chunks: list[bytes] = []
+
+    def write_chunk(chunk: bytes) -> int:
+        chunks.append(chunk)
+        return len(chunk)
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.POST, 1)
+        curl.setopt(
+            pycurl.HTTPHEADER,
+            [f"{key}: {value}" for key, value in (headers or {}).items()],
+        )
+        curl.setopt(pycurl.POSTFIELDS, json_module.dumps(json).encode("utf-8"))
+        curl.setopt(pycurl.WRITEFUNCTION, write_chunk)
+        curl.perform()
+        status_code = int(curl.getinfo(pycurl.RESPONSE_CODE))
+    finally:
+        curl.close()
+
+    return Response(status_code=status_code, chunks=chunks)