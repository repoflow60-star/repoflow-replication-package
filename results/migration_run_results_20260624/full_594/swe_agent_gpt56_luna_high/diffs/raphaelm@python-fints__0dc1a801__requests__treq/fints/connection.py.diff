+_reactor_thread = None
+_reactor_started = threading.Event()
+_reactor_lock = threading.Lock()
+
+
+def _run_reactor():
+    """Run Twisted's reactor in the background for the synchronous API."""
+    _reactor_started.set()
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor_running():
+    global _reactor_thread
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is None:
+            _reactor_thread = threading.Thread(
+                target=_run_reactor,
+                name="fints-twisted-reactor",
+                daemon=True,
+            )
+            _reactor_thread.start()
+        _reactor_started.wait()
+
+
+@defer.inlineCallbacks
+def _post(url, data):
+    response = yield treq.post(
+        url,
+        data=data,
+        headers={
+            'Content-Type': 'text/plain',
+        },
+        # FinTS servers commonly use HTTP/1.0 and close the connection after
+        # every response.  Do not let treq's global persistent pool reuse one.
+        persistent=False,
+    )
+
+    if response.code < 200 or response.code > 299:
+        raise FinTSConnectionError('Bad status code {}'.format(response.code))
+
+    body = yield response.content()
+    return body
 
 
