+    @staticmethod
+    def _request(url):
+        """Fetch and decode a JSON response from the Codeforces API."""
+        response = BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(curl.URL, url)
+            curl.setopt(curl.WRITEDATA, response)
+            curl.perform()
+        except Exception:
+            raise SystemExit('Could not connect to the codeforces API')
+        finally:
+            curl.close()
+        return json.loads(response.getvalue().decode('utf-8'))
