+class _Urllib3Client:
+    """Requests-like request surface backed by an urllib3 PoolManager."""
+
+    def __init__(self):
+        self.pool = urllib3.PoolManager()
+
+    @staticmethod
+    def _url_with_params(url, params):
+        if not params:
+            return url
+        query = urlencode(params, doseq=True)
+        return url + ('&' if '?' in url else '?') + query
+
+    def request(self, method, url, **kwargs):
+        method = method.upper()
+        headers = dict(kwargs.get('headers') or {})
+        request_url = self._url_with_params(url, kwargs.get('params'))
+
+        # Translate Requests-style bodies into urllib3's body argument.  JSON
+        # is encoded here rather than relying on an unsupported urllib3
+        # keyword, while preserving an explicitly supplied data body.
+        if 'json' in kwargs:
+            body = json.dumps(kwargs['json']).encode('utf-8')
+            if not any(key.lower() == 'content-type' for key in headers):
+                headers['Content-Type'] = 'application/json'
+        else:
+            body = kwargs.get('data')
+            if isinstance(body, dict):
+                body = urlencode(body, doseq=True).encode('utf-8')
+                if not any(key.lower() == 'content-type' for key in headers):
+                    headers['Content-Type'] = 'application/x-www-form-urlencoded'
+            elif isinstance(body, str):
+                body = body.encode('utf-8')
+
+        request_kwargs = {
+            'headers': headers,
+            'body': body,
+            'preload_content': True,
+            # Retry policy belongs to PDSession, not the transport pool.
+            'retries': False,
+        }
+        timeout = kwargs.get('timeout')
+        if timeout is not None:
+            if isinstance(timeout, urllib3.Timeout):
+                request_kwargs['timeout'] = timeout
+            elif isinstance(timeout, (tuple, list)):
+                request_kwargs['timeout'] = urllib3.Timeout(
+                    connect=timeout[0], read=timeout[1])
+            else:
+                request_kwargs['timeout'] = urllib3.Timeout.from_float(timeout)
+        if 'allow_redirects' in kwargs:
+            request_kwargs['redirect'] = kwargs['allow_redirects']
+
+        started = time.monotonic()
+        raw = self.pool.request(method, request_url, **request_kwargs)
+        return Response(raw, method, request_url, time.monotonic() - started)
+
+    def get(self, url, **kwargs):
+        kwargs.setdefault('allow_redirects', True)
+        return self.request('GET', url, **kwargs)
+
+    def post(self, url, data=None, **kwargs):
+        kwargs['data'] = data
+        return self.request('POST', url, **kwargs)
+
+    def put(self, url, data=None, **kwargs):
+        kwargs['data'] = data
+        return self.request('PUT', url, **kwargs)
+
+    def delete(self, url, **kwargs):
+        kwargs.setdefault('allow_redirects', True)
+        return self.request('DELETE', url, **kwargs)
+
+    def close(self):
+        self.pool.clear()
+
