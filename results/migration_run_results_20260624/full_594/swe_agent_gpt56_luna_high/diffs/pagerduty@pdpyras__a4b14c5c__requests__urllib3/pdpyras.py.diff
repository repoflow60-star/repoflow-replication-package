+class Response:
+    """Response compatibility wrapper around :class:`urllib3.HTTPResponse`.
+
+    urllib3 returns the response body as bytes and intentionally does not
+    provide Requests' ``ok``, ``text``, ``json`` or request metadata helpers.
+    pdpyras has always exposed those conveniences, so keep them in this small
+    wrapper while retaining the underlying urllib3 response as ``raw``.
+    """
+
+    def __init__(self, raw, method, url, elapsed):
+        self.raw = raw
+        self.status_code = raw.status
+        self.ok = self.status_code < 400
+        self.url = url
+        self.reason = getattr(raw, 'reason', None)
+        self.headers = raw.headers
+        self.request = _Request(method, url)
+        self.elapsed = timedelta(seconds=elapsed)
+        self._content = raw.data if raw.data is not None else b''
+
+    @property
+    def content(self):
+        return self._content
+
+    @property
+    def text(self):
+        content_type = self.headers.get('content-type', '')
+        encoding = 'utf-8'
+        for value in content_type.split(';')[1:]:
+            name, separator, charset = value.strip().partition('=')
+            if separator and name.lower() == 'charset':
+                encoding = charset.strip()
+                break
+        try:
+            return self._content.decode(encoding)
+        except (LookupError, UnicodeDecodeError):
+            return self._content.decode('utf-8', errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+    def close(self):
+        self.raw.close()
