+    def _response_received(self, response):
+        """Report the result of a completed treq request.
+
+        Unlike ``requests``, treq is asynchronous: ``post`` returns a
+        Deferred, and its response exposes the HTTP status as ``code``.  Keep
+        the existing user-facing output while handling the response in a
+        Deferred callback.
+        """
+        if 200 <= response.code <= 202:
+            print("Adaptive Card sent!")
+            return response
+
+        print("Error while sending adaptive card")
+        print(f"Response status code: {response.code}")
+
+        def print_response_text(text):
+            print(f"Response text: {text}")
+            return response
+
+        return response.text().addCallback(print_response_text)
+
+    def _proxy_agent(self):
+        """Build a treq agent for the configured HTTP proxy."""
+        from urllib.parse import urlparse
+
+        from twisted.internet import reactor
+        from twisted.internet.endpoints import HostnameEndpoint
+        from twisted.web.client import ProxyAgent
+
+        proxy = urlparse(self._proxy)
+        if proxy.hostname is None or proxy.port is None:
+            raise ValueError("Proxy must include a hostname and port")
+
+        endpoint = HostnameEndpoint(reactor, proxy.hostname, proxy.port)
+        return ProxyAgent(endpoint, reactor=reactor)
