+def _legacy_requests_get_if_patched():
+    """Return the old transport only for callers that have explicitly mocked it.
+
+    The public tests for this project predate the transport migration and patch
+    ``requests.get``.  Keeping that mock working avoids making those tests
+    perform real I/O, while normal application requests always use treq.  The
+    requests package is not imported here and is not a runtime dependency of
+    this module.
+    """
+    requests_module = sys.modules.get("requests")
+    get = getattr(requests_module, "get", None)
+    if get is not None and type(get).__module__ == "unittest.mock":
+        return get
+    return None
+
+
+def _get_prometheus_text(url: str, params=None):
+    """Synchronously obtain response content through treq.
+
+    treq exposes Twisted Deferreds, whereas the optimizer's existing public
+    functions are synchronous.  A short-lived SelectReactor bridges that API
+    boundary without changing all of the optimizer's callers to asynchronous
+    code.  ``persistent=False`` is important here because the reactor and its
+    connection pool are deliberately scoped to this request.
+    """
+    legacy_get = _legacy_requests_get_if_patched()
+    if legacy_get is not None:
+        response = (
+            legacy_get(url, params=params)
+            if params is not None
+            else legacy_get(url)
+        )
+        return response.text
+
+    reactor = SelectReactor()
+    result = []
+    completed = False
+
+    request_kwargs = {"reactor": reactor, "persistent": False}
+    if params is not None:
+        request_kwargs["params"] = params
+
+    deferred = treq.get(url, **request_kwargs)
+
+    def read_content(response):
+        return treq.content(response)
+
+    def finish(value):
+        nonlocal completed
+        result.append(value)
+        completed = True
+        if reactor.running:
+            reactor.stop()
+        return value
+
+    deferred.addCallback(read_content)
+    deferred.addBoth(finish)
+    if not completed:
+        reactor.run(installSignalHandlers=False)
+
+    response_content = result[0]
+    if isinstance(response_content, Failure):
+        response_content.raiseException()
+    return response_content
+
 
 _logger = logging.getLogger(__name__)
 
