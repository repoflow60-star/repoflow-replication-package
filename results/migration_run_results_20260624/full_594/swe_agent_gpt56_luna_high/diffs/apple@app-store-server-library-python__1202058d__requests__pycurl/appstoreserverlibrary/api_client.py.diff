+    def _execute_request(self, method: str, url: str, params: Dict[str, Union[str, List[str]]], headers: Dict[str, str], json: Dict[str, Any]) -> _PycurlResponse:
+        """Execute an HTTP request with PycURL and adapt its result to the client API."""
+        if params:
+            url = url + ("&" if "?" in url else "?") + urlencode(params, doseq=True)
+
+        response_body = BytesIO()
+        response_headers: Dict[str, str] = {}
+
+        def receive_header(header_line: bytes) -> None:
+            line = header_line.decode("iso-8859-1").strip()
+            if not line:
+                return
+            if line.startswith("HTTP/"):
+                # Keep only headers belonging to the final response when a
+                # redirect or interim response is returned.
+                response_headers.clear()
+                return
+            if ":" in line:
+                name, value = line.split(":", 1)
+                response_headers[name.strip().lower()] = value.strip()
+
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            request_headers = [f"{name}: {value}" for name, value in headers.items()]
+            if json is not None and not any(name.lower() == "content-type" for name in headers):
+                request_headers.append("Content-Type: application/json")
+            curl.setopt(pycurl.HTTPHEADER, request_headers)
+            curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, receive_header)
+            if json is not None:
+                request_body = json_module.dumps(json).encode("utf-8")
+                curl.setopt(pycurl.POSTFIELDS, request_body)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        return _PycurlResponse(status_code, response_headers, response_body.getvalue())
 
