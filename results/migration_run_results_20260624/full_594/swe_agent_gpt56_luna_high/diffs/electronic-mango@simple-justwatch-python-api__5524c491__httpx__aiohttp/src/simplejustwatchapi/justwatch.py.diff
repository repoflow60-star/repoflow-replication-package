+class _Response:
+    """Small synchronous response wrapper used by the public API.
+
+    ``aiohttp`` responses are asynchronous and are only valid while their
+    session is open.  The rest of this module intentionally keeps its
+    historical synchronous API, so :func:`post` consumes the response body
+    before returning and exposes the two response methods used below.
+    """
+
+    def __init__(self, json_data: Any) -> None:
+        self._json_data = json_data
+
+    def raise_for_status(self) -> None:
+        """Match the response interface used by the request functions."""
+        return None
+
+    def json(self) -> Any:
+        """Return the JSON body that was read by the asynchronous request."""
+        return self._json_data
+
+
+async def _post(url: str, json: dict) -> _Response:
+    """Make a POST request with aiohttp and retain a synchronous result."""
+    async with aiohttp.ClientSession() as session:
+        async with session.post(url, json=json) as response:
+            response.raise_for_status()
+            return _Response(await response.json())
+
+
+def _run(coroutine: Any) -> Any:
+    """Run an aiohttp coroutine from the module's synchronous API.
+
+    ``asyncio.run`` is sufficient for normal callers.  If a caller already
+    owns an event loop, running the request in a short-lived worker thread
+    avoids the ``asyncio.run() cannot be called from a running event loop``
+    error while keeping the existing synchronous return value.
+    """
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coroutine)
+
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        return executor.submit(asyncio.run, coroutine).result()
+
+
+def post(url: str, *, json: dict) -> _Response:
+    """Synchronous aiohttp-backed POST helper used by the public functions."""
+    return _run(_post(url, json))
 
 
