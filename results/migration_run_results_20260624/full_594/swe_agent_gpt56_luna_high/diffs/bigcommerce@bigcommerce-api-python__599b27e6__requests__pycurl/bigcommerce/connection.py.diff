+class _CaseInsensitiveHeaders(dict):
+    """Dictionary matching the case-insensitive HTTP header semantics."""
+
+    def __contains__(self, name):
+        return any(key.lower() == name.lower() for key in self)
+
+    def __getitem__(self, name):
+        for key, value in self.items():
+            if key.lower() == name.lower():
+                return value
+        raise KeyError(name)
+
+    def get(self, name, default=None):
+        try:
+            return self[name]
+        except KeyError:
+            return default
+
+    def __setitem__(self, name, value):
+        old_name = next((key for key in self if key.lower() == name.lower()), None)
+        if old_name is not None:
+            dict.__delitem__(self, old_name)
+        dict.__setitem__(self, name, value)
+
+
+class _PycurlResponse(object):
+    """Small response object exposing the part of the requests API we use."""
+
+    def __init__(self, content, status_code, reason, headers):
+        self.content = content
+        self.status_code = status_code
+        self.reason = reason
+        self.headers = _CaseInsensitiveHeaders(headers)
+
+    def json(self):
+        # ``requests.Response.json`` accepts both bytes and text.  Keeping the
+        # same behaviour here makes the connection layer independent of the
+        # wire encoding used by libcurl.
+        return loads(self.content.decode('utf-8') if isinstance(self.content, bytes) else self.content)
+
+
+class _PycurlSession(object):
+    """A minimal session-like adapter backed by :mod:`pycurl`.
+
+    PycURL exposes libcurl's low-level handle API rather than requests'
+    session API.  This adapter keeps the connection code's small session
+    abstraction (persistent headers and basic authentication), while ensuring
+    that all HTTP I/O is performed by pycurl.
+    """
+
+    def __init__(self, auth=None):
+        self.auth = auth
+        self.headers = {}
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        curl = pycurl.Curl()
+        body = BytesIO()
+        response_headers = {}
+        reason = ['']
+
+        # Request headers override session headers, just as they do for a
+        # requests.Session.  Header names are case insensitive.
+        merged_headers = dict(self.headers)
+        for name, value in (headers or {}).items():
+            old_name = next((key for key in merged_headers
+                             if key.lower() == name.lower()), None)
+            if old_name is not None:
+                del merged_headers[old_name]
+            merged_headers[name] = value
+
+        header_values = ['%s: %s' % (name, value)
+                         for name, value in merged_headers.items()]
+        content_type = next((value for name, value in merged_headers.items()
+                             if name.lower() == 'content-type'), '')
+
+        def receive_headers(raw_header):
+            line = raw_header.decode('iso-8859-1').strip('\r\n')
+            if line.startswith('HTTP/'):
+                # A redirect or an interim response starts a new header block;
+                # only the final block belongs to the response we expose.
+                response_headers.clear()
+                parts = line.split(' ', 2)
+                reason[0] = parts[2] if len(parts) == 3 else ''
+            elif ':' in line:
+                name, value = line.split(':', 1)
+                response_headers[name] = value.strip()
+            return len(raw_header)
+
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            curl.setopt(pycurl.HTTPHEADER, header_values)
+            curl.setopt(pycurl.WRITEFUNCTION, body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, receive_headers)
+
+            if timeout is not None:
+                curl.setopt(pycurl.TIMEOUT_MS, int(float(timeout) * 1000))
+
+            if self.auth is not None:
+                username, password = self.auth
+                curl.setopt(pycurl.USERPWD, '%s:%s' % (username, password))
+                curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+
+            # Setting ACCEPT_ENCODING asks libcurl to decompress responses;
+            # merely sending the header would leave compressed bytes in the
+            # response body.
+            encoding = next((value for name, value in merged_headers.items()
+                             if name.lower() == 'accept-encoding'), None)
+            if encoding is not None:
+                curl.setopt(pycurl.ACCEPT_ENCODING, encoding)
+
+            if data is not None:
+                if isinstance(data, dict) and str(content_type).lower().startswith(
+                        'application/x-www-form-urlencoded'):
+                    data = urlencode(data, doseq=True)
+                if isinstance(data, str):
+                    data = data.encode('utf-8')
+                curl.setopt(pycurl.POSTFIELDS, data)
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            return _PycurlResponse(body.getvalue(), status_code, reason[0], response_headers)
+        finally:
+            curl.close()
+
 
