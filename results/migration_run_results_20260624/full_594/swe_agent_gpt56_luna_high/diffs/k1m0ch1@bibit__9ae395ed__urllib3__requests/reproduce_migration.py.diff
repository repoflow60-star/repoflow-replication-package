--- a/reproduce_migration.py
+++ b/reproduce_migration.py
@@ -0,0 +1,15 @@
+"""Reproduce the stale HTTP dependency configuration."""
+from pathlib import Path
+
+requirements = Path("requirements.txt").read_text()
+pipfile = Path("Pipfile").read_text()
+
+# urllib3 is currently installed as a direct, pinned dependency even though
+# application HTTP calls are made through requests.
+if "urllib3==1.26.18" in requirements or "urllib3 = \"<2\"" in pipfile:
+    raise RuntimeError(
+        "repository still declares urllib3 1.26.18 directly; "
+        "requests 2.31.0 should be the application HTTP dependency"
+    )
+
+print("HTTP dependency migration is complete")
