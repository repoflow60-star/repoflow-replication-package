+class _AiohttpResponse:
+    """Small synchronous response wrapper used by the existing client API.
+
+    The public td-client API is synchronous, while aiohttp is asynchronous.  The
+    transport reads the response before returning it and this wrapper retains the
+    response interface used by the rest of the package (``status``, ``read`` and
+    ``stream``).
+    """
+
+    def __init__(self, status, headers, body):
+        self.status = status
+        self.headers = headers
+        self.data = body
+        self._position = 0
+
+    def read(self, size=None):
+        if size is None:
+            size = len(self.data) - self._position
+        start = self._position
+        self._position = min(len(self.data), start + size)
+        return self.data[start : self._position]
+
+    def stream(self, size=None):
+        size = len(self.data) if size is None else size
+        while self._position < len(self.data):
+            yield self.read(size)
+
+    def getheaders(self):
+        return self.headers
+
+    def close(self):
+        # The aiohttp session and response have already been closed by the
+        # transport.  Keep close() for contextlib.closing compatibility.
+        pass
+
+
+class _AiohttpTransport:
+    """Synchronous adapter around aiohttp's asynchronous client session."""
+
+    def __init__(self, http_proxy=None, proxy_auth=None, **kwargs):
+        timeout = kwargs.pop("timeout", 60)
+        if isinstance(timeout, aiohttp.ClientTimeout):
+            client_timeout = timeout
+        else:
+            client_timeout = aiohttp.ClientTimeout(total=timeout)
+
+        ca_certs = kwargs.pop("ca_certs", None)
+        cert_reqs = kwargs.pop("cert_reqs", None)
+        ssl_context = kwargs.pop("ssl_context", None)
+        connector_ssl = kwargs.pop("ssl", None)
+        if ssl_context is not None:
+            connector_ssl = ssl_context
+        elif connector_ssl is None and cert_reqs != ssl.CERT_NONE:
+            connector_ssl = ssl.create_default_context(cafile=ca_certs)
+        elif cert_reqs == ssl.CERT_NONE:
+            connector_ssl = False
+
+        # maxsize is the legacy name for the connection pool limit. Ignore
+        # options that only applied to the previous transport rather than passing
+        # them to aiohttp and failing during session construction.
+        limit = kwargs.pop("maxsize", 0)
+        kwargs.pop("block", None)
+        kwargs.pop("assert_hostname", None)
+        kwargs.pop("ca_cert_dir", None)
+        kwargs.pop("assert_fingerprint", None)
+        kwargs.pop("retries", None)
+
+        self.proxy = http_proxy
+        self.proxy_auth = proxy_auth
+        self._session_kwargs = kwargs
+        self._connector_kwargs = {"limit": limit, "ssl": connector_ssl}
+        self._timeout = client_timeout
+
+    @staticmethod
+    def _run(coroutine):
+        """Run an aiohttp operation from both normal and async callers."""
+        try:
+            asyncio.get_running_loop()
+        except RuntimeError:
+            return asyncio.run(coroutine)
+
+        # A synchronous td-client method may also be called from code that
+        # already owns an event loop.  asyncio.run cannot be nested, so run the
+        # operation on a short-lived worker thread in that case.
+        with ThreadPoolExecutor(max_workers=1) as executor:
+            return executor.submit(asyncio.run, coroutine).result()
+
+    async def _request(
+        self, method, url, fields=None, body=None, headers=None, decode_content=True
+    ):
+        connector = aiohttp.TCPConnector(**self._connector_kwargs)
+        async with aiohttp.ClientSession(
+            connector=connector,
+            timeout=self._timeout,
+            **self._session_kwargs,
+        ) as session:
+            method_upper = method.upper()
+            request_params = (
+                fields if method_upper in ("GET", "HEAD", "DELETE") else None
+            )
+            request_body = body if body is not None else fields
+            async with session.request(
+                method,
+                url,
+                params=request_params,
+                data=request_body,
+                headers=headers,
+                proxy=self.proxy,
+                proxy_auth=self.proxy_auth,
+                auto_decompress=decode_content,
+            ) as response:
+                response_body = await response.read()
+                return _AiohttpResponse(
+                    response.status, dict(response.headers), response_body
+                )
+
+    def request(self, method, url, fields=None, body=None, headers=None, **kwargs):
+        # preload_content/decode_content are transport details. The
+        # response is always fully read by _request so callers can keep using
+        # the synchronous response API.
+        decode_content = kwargs.pop("decode_content", True)
+        kwargs.pop("preload_content", None)
+        if kwargs:
+            unexpected = next(iter(kwargs))
+            raise TypeError("unexpected request argument: %s" % unexpected)
+        return self._run(
+            self._request(
+                method,
+                url,
+                fields=fields,
+                body=body,
+                headers=headers,
+                decode_content=decode_content,
+            )
+        )
+
+    def clear(self):
+        # Sessions are scoped to individual requests and therefore have
+        # already released their connections.
+        pass
+
