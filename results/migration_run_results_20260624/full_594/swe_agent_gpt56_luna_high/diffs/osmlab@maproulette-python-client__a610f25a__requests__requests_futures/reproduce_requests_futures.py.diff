--- a/reproduce_requests_futures.py
+++ b/reproduce_requests_futures.py
@@ -0,0 +1,33 @@
+"""Verify MapRouletteServer resolves requests-futures responses."""
+import json
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from urllib.parse import urlparse
+
+from maproulette.api.configuration import Configuration
+from maproulette.api.maproulette_server import MapRouletteServer
+
+
+class Handler(BaseHTTPRequestHandler):
+    def do_GET(self):
+        body = {"healthy": True} if urlparse(self.path).path == "/ping" else {"data": "ok"}
+        payload = json.dumps(body).encode()
+        self.send_response(200)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(payload)))
+        self.end_headers()
+        self.wfile.write(payload)
+
+    def log_message(self, *_):
+        pass
+
+
+server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+try:
+    host, port = server.server_address
+    config = Configuration(hostname=f"{host}:{port}", protocol="http")
+    client = MapRouletteServer(config)
+    print(client.get("/endpoint"))
+    client.session.close()
+finally:
+    server.shutdown()
+    server.server_close()
