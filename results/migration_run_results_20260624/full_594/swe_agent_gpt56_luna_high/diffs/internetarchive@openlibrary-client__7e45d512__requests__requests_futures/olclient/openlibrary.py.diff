+class _FuturesSession(FuturesSession):
+    """A FuturesSession retaining requests' positional call behavior."""
+
+    # requests-futures passes ``json=None`` and makes ``data`` a keyword when
+    # delegating these methods.  Keep the requests call shape for compatibility
+    # with callers that patch requests.Session methods.
+    def post(self, url, *args, **kwargs):
+        return super(FuturesSession, self).post(url, *args, **kwargs)
+
+    def put(self, url, *args, **kwargs):
+        return super(FuturesSession, self).put(url, *args, **kwargs)
 
 
