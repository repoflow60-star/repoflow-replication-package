+    def _request(self, method, *args, **kwargs):
+        """Run a requests-futures call and return its completed response.
+
+        OpenLibrary's public methods have historically returned ``Response``
+        objects.  ``FuturesSession`` returns ``Future`` objects instead, so
+        wait here at the boundary to preserve that API (and allow errors to be
+        handled by the existing backoff decorators).
+        """
+        response = getattr(self.session, method)(*args, **kwargs)
+        return response.result() if isinstance(response, Future) else response
 
