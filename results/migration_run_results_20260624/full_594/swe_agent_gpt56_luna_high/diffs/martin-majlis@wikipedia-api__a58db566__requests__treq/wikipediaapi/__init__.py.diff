+class _TreqSession:
+    """Small session-compatible wrapper around :mod:`treq`.
+
+    ``treq`` does not expose a ``Session`` object like the previous HTTP
+    client did. The wrapper keeps the headers and request options used by
+    ``Wikipedia`` in one place while delegating the actual HTTP request to
+    treq.
+    """
+
+    def __init__(self, headers: dict[str, Any]) -> None:
+        self.headers = headers
+
+    def get(self, url: str, **kwargs):
+        request_headers = kwargs.pop("headers", None)
+        headers = dict(self.headers)
+        if request_headers:
+            headers.update(request_headers)
+        return treq.get(url, headers=headers, **kwargs)
+
+    def close(self) -> None:
+        """There is no per-session resource to close in treq."""
+
+
+def _wait_for_deferred(result):
+    """Return a treq result to the synchronous public API.
+
+    The original wikipedia-api API is synchronous, whereas treq returns a
+    Twisted ``Deferred``.  Run the shared Twisted reactor in a daemon thread
+    and wait for the Deferred from callers using the existing synchronous API.
+    A non-Deferred result is returned unchanged, which also keeps the private
+    ``_query`` hook easy to replace in applications and tests.
+    """
+    from twisted.internet import reactor
+    from twisted.internet.defer import Deferred
+    from twisted.internet.threads import blockingCallFromThread
+
+    if not isinstance(result, Deferred):
+        return result
+
+    reactor_thread = getattr(_wait_for_deferred, "_reactor_thread", None)
+    if not reactor.running:
+        if reactor_thread is None or not reactor_thread.is_alive():
+            reactor_thread = threading.Thread(
+                target=reactor.run,
+                kwargs={"installSignalHandlers": False},
+                name="wikipediaapi-treq-reactor",
+                daemon=True,
+            )
+            _wait_for_deferred._reactor_thread = reactor_thread
+            reactor_thread.start()
+
+    if reactor_thread is not None and threading.current_thread() is reactor_thread:
+        # Waiting from inside the reactor would deadlock.  This case is only
+        # reachable for callers already running on Twisted's event loop, for
+        # whom returning the Deferred is the useful behaviour.
+        return result
+
+    return blockingCallFromThread(reactor, lambda: result)
+
+
+def _json_content(result):
+    """Decode a treq response, preserving the synchronous API."""
+    response = _wait_for_deferred(result)
+    return _wait_for_deferred(treq.json_content(response))
+
 
