+
+# Keep this alias for callers that patched the old module-level HTTP client.  It
+# points at treq (and is not the requests package); using it also means those
+# callers transparently patch treq.get.
+requests = treq
+
+_reactor_started = threading.Event()
+_reactor_start_lock = threading.Lock()
+
+
+def _run_reactor():
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor_running():
+    """Start treq's Twisted reactor when a synchronous call needs it."""
+    if reactor.running:
+        return
+
+    with _reactor_start_lock:
+        if not reactor.running:
+            thread = threading.Thread(
+                target=_run_reactor,
+                name="chessdotcom-treq-reactor",
+                daemon=True,
+            )
+            thread.start()
+            _reactor_started.wait()
+
+
+def _mark_reactor_started():
+    _reactor_started.set()
+
+
+reactor.callWhenRunning(_mark_reactor_started)
+
+
+def _read_treq_response(response):
+    """Turn a treq response Deferred into ``(response, text)``."""
+    return treq.text_content(response).addCallback(
+        lambda text: (response, text)
+    )
+
+
+def _resolve_treq_response(deferred):
+    _ensure_reactor_running()
+    return blockingCallFromThread(
+        reactor, lambda: deferred.addCallback(_read_treq_response)
+    )
+
+
+def _request_options_for_treq(options):
+    # ``verify`` and ``verify_ssl`` are requests/aiohttp options.  Treq uses
+    # an Agent to configure TLS verification, so neither is a valid keyword
+    # for treq.get.  Preserve the existing public option while not passing it
+    # to treq.
+    options = dict(options)
+    verify = options.pop("verify", options.pop("verify_ssl", True))
+    if not verify and "agent" not in options:
+        options["agent"] = Agent(reactor, contextFactory=ClientContextFactory())
+    if isinstance(options.get("headers"), dict):
+        options["headers"] = {
+            key: value
+            for key, value in options["headers"].items()
+            if value is not None
+        }
+    return options
 
