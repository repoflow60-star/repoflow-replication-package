+class _TreqResponse:
+    """Small synchronous response adapter for the existing response models.
+
+    Treq returns a Twisted response and exposes the body asynchronously.  The
+    public client API predates treq and is synchronous, so the adapter buffers
+    the body and presents the small subset of the HTTP response interface
+    used by the models.
+    """
+
+    def __init__(self, response, body: bytes) -> None:
+        self.status_code = response.code
+        self.ok = response.code < 400
+        self.content = body
+        self.text = body.decode("utf-8", errors="replace")
+        self.headers = getattr(response, "headers", None)
+
+    def json(self):
+        return json.loads(self.text)
+
+
+class _TreqClient:
+    """Synchronous facade over treq used by the legacy client API.
+
+    Keeping this facade in the client also preserves the existing public
+    method signatures while the actual HTTP implementation is treq.  It is
+    deliberately named ``requests`` below for backwards-compatible patch
+    points used by clients' existing tests and integrations; no requests
+    package is imported or required.
+    """
+
+    _reactor_thread = None
+    _reactor_lock = threading.Lock()
+    _reactor_ready = Event()
+
+    @classmethod
+    def _ensure_reactor(cls):
+        if reactor.running:
+            return
+
+        with cls._reactor_lock:
+            if cls._reactor_thread is None:
+                cls._reactor_thread = threading.Thread(
+                    target=cls._run_reactor,
+                    name="coinbaseadvanced-treq-reactor",
+                    daemon=True,
+                )
+                cls._reactor_thread.start()
+
+        cls._reactor_ready.wait()
+
+    @classmethod
+    def _run_reactor(cls):
+        reactor.callWhenRunning(cls._reactor_ready.set)
+        reactor.run(installSignalHandlers=False)
+
+    @staticmethod
+    def _response(response):
+        """Turn a treq response into the response shape used by the models."""
+        return maybeDeferred(treq.content, response).addCallback(
+            lambda body: _TreqResponse(response, body)
+        )
+
+    def _request(self, method: str, url: str, **kwargs):
+        # This branch is useful for callers/tests that provide a response
+        # directly instead of a Deferred.  Real treq calls always return one.
+        result = []
+        error = []
+        complete = Event()
+
+        def start_request():
+            try:
+                request = getattr(treq, method)
+                deferred = request(url, **kwargs)
+                if not isinstance(deferred, Deferred):
+                    result.append(deferred)
+                    complete.set()
+                    return
+
+                deferred.addCallback(self._response)
+
+                def succeeded(response):
+                    result.append(response)
+                    complete.set()
+                    return response
+
+                def failed(failure):
+                    error.append(failure.value)
+                    complete.set()
+                    return failure
+
+                deferred.addCallbacks(succeeded, failed)
+            except Exception as exception:  # propagate request setup errors
+                error.append(exception)
+                complete.set()
+
+        self._ensure_reactor()
+        reactor.callFromThread(start_request)
+        complete.wait()
+
+        if error:
+            raise error[0]
+        return result[0]
+
+    def get(self, url, **kwargs):
+        return self._request("get", url, **kwargs)
+
+    def post(self, url, **kwargs):
+        return self._request("post", url, **kwargs)
+
+    def put(self, url, **kwargs):
+        return self._request("put", url, **kwargs)
+
+    def delete(self, url, **kwargs):
+        return self._request("delete", url, **kwargs)
+
+
+# Kept as a compatibility patch point for the unchanged pre-treq tests.  All
