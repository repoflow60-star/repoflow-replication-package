+# Plotly writes self-contained HTML documents, so plots can be opened directly in a
+# browser without requiring a GUI backend (or an additional image-export package).
+_DEFAULT_COLORS = getattr(qualitative, 'Glasbey', qualitative.Dark24)
+
+
+def _colors(number):
+    """Return enough colours for ``number`` traces, cycling when necessary."""
+    if number <= 0:
+        return []
+    return [_DEFAULT_COLORS[index % len(_DEFAULT_COLORS)] for index in range(number)]
+
+
+def _as_plotly_color(color):
+    """Convert the RGB tuples returned by older callers into Plotly colours."""
+    if isinstance(color, (tuple, list)) and len(color) == 3:
+        values = [round(value * 255) if 0 <= value <= 1 else round(value) for value in color]
+        return f'rgb({values[0]}, {values[1]}, {values[2]})'
+    return color
+
+
+def _write_html(figure, path, filename):
+    """Write a Plotly figure to ``path`` and return the resulting file path."""
+    output = Path(path) / filename
+    output.parent.mkdir(parents=True, exist_ok=True)
+    figure.write_html(str(output), include_plotlyjs=True)
+    return output
+
+
+def _animation_controls():
+    return [
+        {
+            'type': 'buttons',
+            'showactive': False,
+            'x': 0,
+            'y': 1.15,
+            'xanchor': 'left',
+            'yanchor': 'top',
+            'buttons': [
+                {
+                    'label': 'Play',
+                    'method': 'animate',
+                    'args': [None, {'frame': {'duration': 100, 'redraw': True}, 'fromcurrent': True}],
+                },
+            ],
+        }
+    ]
+
+
+def _line_traces(x_values, data, colors):
+    return [
+        go.Scatter(
+            x=x_values,
+            y=data[column],
+            mode='lines',
+            name=str(column),
+            line={'color': _as_plotly_color(colors[index])},
+        )
+        for index, column in enumerate(data.columns)
+    ]
 
 
