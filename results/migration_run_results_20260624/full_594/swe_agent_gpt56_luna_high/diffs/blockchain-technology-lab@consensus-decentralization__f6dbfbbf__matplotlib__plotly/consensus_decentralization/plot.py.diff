+def _area_traces(values, labels, colors, visible_legend=True):
+    traces = []
+    for index, (value, label) in enumerate(zip(values, labels)):
+        traces.append(
+            go.Scatter(
+                y=value,
+                mode='lines',
+                name=str(label),
+                stackgroup='one',
+                line={'color': _as_plotly_color(colors[index]), 'width': 0.5},
+                showlegend=visible_legend and not str(label).startswith('_'),
+            )
+        )
+    return traces
+
