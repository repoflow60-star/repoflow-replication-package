+def response_is_successful(response: httpx.Response) -> bool:
+    """Return whether an HTTP response represents a successful request.
+
+    HTTPX exposes this as ``is_success`` whereas the repository's existing
+    response test doubles expose Requests' ``ok`` attribute.  Supporting both
+    keeps response parsing independent of the concrete response object.
+    """
+    is_success = getattr(response, "is_success", None)
+    if isinstance(is_success, bool):
+        return is_success
+    return response.ok
 
 
