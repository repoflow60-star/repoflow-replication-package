+    def _scale(self):
+        """Return the common x scale used by bars and milestones."""
+        # A non-zero domain also makes an empty or all-zero input renderable.
+        maximum = max(self.end, default=0)
+        return alt.Scale(domain=[0, max(1, maximum)])
+
+    def _records(self):
+        """Build the inline records consumed by Altair.
+
+        Altair 6 does not accept a bare list as ``Chart.data``.  The records
+        are therefore passed through ``alt.Data(values=...)`` in ``render``.
+        """
+        records = []
+        for pkg in self.packages:
+            # A private key lets bars without a legend keep their own color,
+            # while the explicit legend values below hide those private keys.
+            legend_key = pkg.legend or "__color__{}".format(pkg.color)
+            records.append(
+                {
+                    "label": pkg.label,
+                    "start": pkg.start,
+                    "end": pkg.end,
+                    "color": pkg.color,
+                    "legend_key": legend_key,
+                }
+            )
+        return records
+
+    def _bar_chart(self):
+        records = self._records()
+        legend_labels = []
+        domains = []
+        ranges = []
+        for record in records:
+            key = record["legend_key"]
+            if key not in domains:
+                domains.append(key)
+                ranges.append(record["color"])
+            if not key.startswith("__color__") and key not in legend_labels:
+                legend_labels.append(key)
+
+        legend = None
+        if legend_labels:
+            legend = alt.Legend(values=legend_labels, columns=3, title=None)
+
+        axis = alt.Axis(title=self.xlabel or None)
+        if self.xticks:
+            axis = alt.Axis(title=self.xlabel or None, values=self.xticks)
+
+        return alt.Chart(alt.Data(values=records)).mark_bar().encode(
+            x=alt.X("start:Q", scale=self._scale(), axis=axis),
+            x2=alt.X2("end:Q"),
+            y=alt.Y(
+                "label:N",
+                sort=list(reversed(self.labels)),
+                axis=alt.Axis(title=None),
+            ),
+            color=alt.Color(
+                "legend_key:N",
+                scale=alt.Scale(domain=domains, range=ranges),
+                legend=legend,
+            ),
+        )
 
