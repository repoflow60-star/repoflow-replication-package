+class _ChartAxis:
+    """Small compatibility view for the old ``g.ax`` attribute.
+
+    The previous renderer exposed its axes as ``g.ax``.  Altair has no axes
+    object, so the chart is exposed as ``g.chart`` instead.  Keeping this forwarding
+    object means code which only used ``g.ax.get_title()`` continues to work
+    while the actual renderer is entirely Altair based.
+    """
+
+    def __init__(self, chart):
+        self.chart = chart
+
+    def get_title(self):
+        title = self.chart.to_dict().get("title", "")
+        if isinstance(title, dict):
+            return title.get("text", "")
+        return title
+
+    def __getattr__(self, name):
+        return getattr(self.chart, name)
 
 
