--- a/reproduce_migration.py
+++ b/reproduce_migration.py
@@ -0,0 +1,14 @@
+"""Reproduce the dependency mismatch before migrating the HTTP provider."""
+
+from pathlib import Path
+
+source = Path(__file__).parent / "iconsdk/providers/http_provider.py"
+assert "import requests" in source.read_text(), "The pre-migration provider no longer uses requests"
+
+# This is the target dependency, which is not available in the pre-migration
+# environment.  The import fails before any pycurl-backed request can run.
+import pycurl  # noqa: F401
+
+print("pycurl is available")
+earlier = "requests"
+print(f"HTTPProvider still depends on {earlier}")
