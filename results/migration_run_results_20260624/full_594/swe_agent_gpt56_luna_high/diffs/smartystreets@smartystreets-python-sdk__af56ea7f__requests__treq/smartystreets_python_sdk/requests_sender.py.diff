+def _response_body(response, headers):
+    body = _wait_for(treq.content(response))
+    if isinstance(body, str):
+        return body
+    if body is None:
+        return ''
+    encoding = 'utf-8'
+    content_type = _header_value(headers, 'content-type') or ''
+    marker = 'charset='
+    if marker in content_type.lower():
+        encoding = content_type.lower().split(marker, 1)[1].split(';', 1)[0].strip()
+    try:
+        return body.decode(encoding)
+    except (LookupError, UnicodeDecodeError):
+        return body.decode('utf-8', errors='replace')
