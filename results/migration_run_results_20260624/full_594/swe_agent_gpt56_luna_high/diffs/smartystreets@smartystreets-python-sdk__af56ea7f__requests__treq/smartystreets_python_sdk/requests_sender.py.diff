+def _wait_for(value):
+    """Resolve a Deferred while keeping the sender API synchronous."""
+    if not hasattr(value, 'addBoth'):
+        return value
+
+    result = []
+    finished = threading.Event()
+
+    def complete(value):
+        result.append(value)
+        finished.set()
+        return value
