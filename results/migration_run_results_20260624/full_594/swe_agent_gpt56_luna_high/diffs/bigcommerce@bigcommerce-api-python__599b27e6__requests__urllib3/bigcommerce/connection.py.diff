 from bigcommerce.exception import *
 
+
+class _Urllib3Response(object):
+    """Small response compatibility layer for the public connection API.
+
+    The rest of this module historically exposed the response attributes used by
+    ``requests`` (``status_code``, ``content`` and ``json``).  urllib3 uses
+    ``status`` and ``data`` instead, so keep that interface at the boundary.
+    """
+
+    def __init__(self, response):
+        self.status_code = response.status
+        self.content = response.data
+        self.headers = response.headers
+        self.reason = response.reason
+
+    def json(self):
+        return loads(self.content)
+
+
+class _Urllib3Session(object):
+    """The small subset of ``requests.Session`` used by this package.
+
+    urllib3 provides connection pooling, but it intentionally does not provide
+    a session object with default headers or basic-auth handling.  Keeping this
+    adapter private lets the existing connection classes retain their API while
+    using urllib3 for all HTTP I/O.
+    """
+
+    def __init__(self):
+        self._pool = urllib3.PoolManager()
+        self.auth = None
+        self.headers = {}
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        has_authorization = any(key.lower() == 'authorization' for key in request_headers)
+        if self.auth and not has_authorization:
+            username, password = self.auth
+            request_headers['Authorization'] = urllib3.util.make_headers(
+                basic_auth='%s:%s' % (username, password)
+            )['authorization']
+
+        body = data
+        if isinstance(data, dict):
+            if not data:
+                body = None
+            else:
+                content_type = next((value for key, value in request_headers.items()
+                                     if key.lower() == 'content-type'), '').lower()
+                if content_type == 'application/x-www-form-urlencoded':
+                    body = urlencode(data)
+                else:
+                    body = dumps(data)
+
+        response = self._pool.request(method, url, body=body,
+                                      timeout=timeout, headers=request_headers)
+        return _Urllib3Response(response)
+
+
 log = logging.getLogger("bigcommerce.connection")
 
 
