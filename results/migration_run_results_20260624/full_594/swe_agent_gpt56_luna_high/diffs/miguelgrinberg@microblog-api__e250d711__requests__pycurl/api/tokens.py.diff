+class _CurlResponse:
+    """Small response object with the interface used by the OAuth flow."""
+
+    def __init__(self, status_code, content):
+        self.status_code = status_code
+        self._content = content
+
+    def json(self):
+        return json.loads(self._content)
+
+
+class _CurlRequests:
+    """Requests-compatible entry points backed by PycURL.
+
+    Keeping these two entry points makes the OAuth code easy to exercise with
+    the existing test suite while the actual HTTP implementation uses PycURL.
+    """
+
+    @staticmethod
+    def _request(url, method, data=None, headers=None):
+        if pycurl is None:  # pragma: no cover - dependency is in requirements
+            raise RuntimeError('PycURL is required for OAuth2 requests')
+        body = BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEFUNCTION, body.write)
+            if headers:
+                curl.setopt(
+                    pycurl.HTTPHEADER,
+                    [f'{key}: {value}' for key, value in headers.items()])
+            if method == 'POST':
+                curl.setopt(pycurl.POST, 1)
+                curl.setopt(pycurl.POSTFIELDS, urlencode(data or {}))
+            else:
+                curl.setopt(pycurl.HTTPGET, 1)
+            curl.perform()
+            return _CurlResponse(curl.getinfo(pycurl.RESPONSE_CODE),
+                                 body.getvalue())
+        finally:
+            curl.close()
+
+    @classmethod
+    def post(cls, url, data=None, headers=None):
+        return cls._request(url, 'POST', data=data, headers=headers)
+
+    @classmethod
+    def get(cls, url, headers=None):
+        return cls._request(url, 'GET', headers=headers)
+
+
+# This name is retained as a small compatibility seam for callers/tests that
+# patch the old requests.post/get entry points. It is not the requests
+# package; all network traffic above goes through PycURL.
+requests = _CurlRequests()
 
