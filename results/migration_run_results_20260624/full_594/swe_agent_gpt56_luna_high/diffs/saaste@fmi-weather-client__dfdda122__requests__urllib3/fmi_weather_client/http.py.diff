+def _status_code(response: urllib3.HTTPResponse) -> int:
+    """Return the status code from an urllib3 response."""
+    # ``status_code`` is accepted for compatibility with response-like objects
+    # used by callers of the private error helper.
+    status = getattr(response, 'status', None)
+    return status if status is not None else response.status_code
+
+
+def _response_text(response: urllib3.HTTPResponse) -> str:
+    """Return an urllib3 response body as text."""
+    body = getattr(response, 'data', None)
+    if isinstance(body, bytes):
+        return body.decode('utf-8')
+    if isinstance(body, str):
+        return body
+
