+_HTTP_ERRORS = (
+    twisted_error.ConnectError,
+    twisted_error.ConnectionAborted,
+    twisted_error.ConnectionClosed,
+    twisted_error.ConnectionLost,
+    twisted_error.ConnectionRefusedError,
