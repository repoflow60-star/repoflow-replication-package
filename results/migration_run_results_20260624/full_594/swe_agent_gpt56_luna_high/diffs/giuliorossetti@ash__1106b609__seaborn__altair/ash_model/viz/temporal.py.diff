+def _altair_density_chart(values, label):
+    """Build the Altair representation of one consistency distribution.
+
+    Altair performs the density estimation in the resulting Vega-Lite chart,
+    rather than in Python.  Keeping this chart on the returned axes lets the
+    existing plotting API remain backwards compatible while making Altair the
+    source of the distribution visualization.
+    """
+    data = pd.DataFrame(
+        {"consistency": list(values), "attribute": str(label)}
+    )
+    return (
+        alt.Chart(data)
+        .transform_density(
+            "consistency",
+            groupby=["attribute"],
+            as_=["consistency", "density"],
+        )
+        .mark_line()
+        .encode(
+            x=alt.X("consistency:Q", title="Consistency"),
+            y=alt.Y("density:Q", title="Density"),
+            color=alt.Color("attribute:N", title="Attribute"),
+        )
+    )
+
+
+def _matplotlib_density(values):
+    """Return density points for the legacy Matplotlib compatibility view.
+
+    ``plot_consistency`` historically returned a Matplotlib ``Axes`` object.
+    The compatibility view is useful to callers that still use that API, but
+    no longer relies on a statistical plotting wrapper.  Explicit handling
+    of singleton and constant samples avoids the singular covariance error
+    from ``gaussian_kde`` for those valid inputs.
+    """
+    values = np.asarray(list(values), dtype=float)
+    if values.size == 0:
+        return np.array([]), np.array([])
+
+    lower = float(values.min())
+    upper = float(values.max())
+    if lower == upper:
+        bandwidth = max(abs(lower) * 0.05, 0.05)
+        x = np.linspace(lower - bandwidth, upper + bandwidth, 100)
+        density = np.exp(-0.5 * ((x - lower) / bandwidth) ** 2)
+        density /= bandwidth * np.sqrt(2 * np.pi)
+        return x, density
+
+    x = np.linspace(lower, upper, 100)
+    return x, gaussian_kde(values)(x)
 
 
