+class _Headers(dict):
+    """A small case-insensitive mapping for response headers."""
+
+    def __getitem__(self, key):
+        key_lower = key.lower()
+        for header, value in self.items():
+            if header.lower() == key_lower:
+                return value
+        raise KeyError(key)
+
+    def get(self, key, default=None):
+        try:
+            return self[key]
+        except KeyError:
+            return default
+
+
+class _Response:
+    def __init__(self, content: bytes, headers: _Headers, status_code: int):
+        self.content = content
+        self.headers = headers
+        self.status_code = status_code
+
+    @property
+    def text(self) -> str:
+        return self.content.decode('utf-8', errors='replace')
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            raise RuntimeError(f'HTTP error {self.status_code}')
+
+
+class _PycurlSession:
+    """An HTTP-style facade backed entirely by a fresh libcurl handle."""
+
+    @staticmethod
+    def _proxy_for(url: str, proxies):
+        if not proxies:
+            return None
+        if isinstance(proxies, dict):
+            scheme = urlsplit(url).scheme.lower()
+            return proxies.get(scheme) or proxies.get('all')
+        return proxies
+
+    def _request(self, method: str, url: str, data=None, headers=None,
+                 verify: bool = True, proxies=None) -> _Response:
+        body = io.BytesIO()
+        header_data = []
+        curl = pycurl.Curl()
+
+        def receive_headers(value):
+            header_data.append(value)
+
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEFUNCTION, body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, receive_headers)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.SSL_VERIFYPEER, int(verify))
+            curl.setopt(pycurl.SSL_VERIFYHOST, 2 if verify else 0)
+
+            proxy = self._proxy_for(url, proxies)
+            if proxy:
+                proxy_url = urlsplit(proxy if '://' in proxy else f'http://{proxy}')
+                curl.setopt(pycurl.PROXY, proxy)
+                if proxy_url.scheme.lower() in ('socks5', 'socks5h'):
+                    proxy_type = (pycurl.PROXYTYPE_SOCKS5_HOSTNAME
+                                  if proxy_url.scheme.lower() == 'socks5h'
+                                  else pycurl.PROXYTYPE_SOCKS5)
+                else:
+                    proxy_type = pycurl.PROXYTYPE_HTTP
+                curl.setopt(pycurl.PROXYTYPE, proxy_type)
+
+            if headers:
+                curl.setopt(
+                    pycurl.HTTPHEADER,
+                    [f'{key}: {value}' for key, value in headers.items()],
+                )
+
+            if method == 'POST':
+                curl.setopt(pycurl.POST, 1)
+                curl.setopt(pycurl.POSTFIELDS, bytes(data or b''))
+            else:
+                curl.setopt(pycurl.HTTPGET, 1)
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        parsed_headers = _Headers()
+        # A header callback includes status lines and an empty line for every
+        # response.  Keep only the final response (important after redirects).
+        current_headers = []
+        for raw_line in b''.join(header_data).splitlines():
+            if raw_line.startswith(b'HTTP/'):
+                current_headers = []
+                continue
+            if b':' not in raw_line:
+                continue
+            key, value = raw_line.split(b':', 1)
+            current_headers.append((
+                key.decode('iso-8859-1').strip(),
+                value.decode('iso-8859-1').strip(),
+            ))
+        for key, value in current_headers:
+            parsed_headers[key] = value
+
+        return _Response(body.getvalue(), parsed_headers, status_code)
