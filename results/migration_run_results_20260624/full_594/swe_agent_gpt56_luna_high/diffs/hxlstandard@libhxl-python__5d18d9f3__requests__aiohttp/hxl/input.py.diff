+
+class _HTTPResponseError(aiohttp.ClientResponseError, IOError):
+    """HTTP error retaining the IOError behavior of the former client."""
+
+
+class _HTTPResponse:
+    """Small synchronous response adapter for the aiohttp client.
+
+    The rest of this module has a synchronous API, while aiohttp is
+    asynchronous.  Requests are fully read before this adapter is returned;
+    this is also what the existing implementation did for normal inputs.
+    """
+
+    def __init__(self, status_code, headers, content, method, url):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+        self.method = method
+        self.url = url
+        self.is_redirect = 300 <= status_code < 400 and 'Location' in headers
+
+    def json(self):
+        return json.loads(self.content.decode('utf-8'))
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            request_url = URL(self.url)
+            raise _HTTPResponseError(
+                request_info=aiohttp.RequestInfo(
+                    request_url, self.method, self.headers, real_url=request_url
+                ),
+                history=(),
+                status=self.status_code,
+                message='HTTP status {}'.format(self.status_code),
+                headers=self.headers,
+            )
+
+
+async def _aiohttp_request(method, url, *, headers=None, params=None, data=None,
+                           timeout=None, verify_ssl=True, allow_redirects=True):
+    """Make an aiohttp request and return a fully buffered response adapter."""
+    client_timeout = aiohttp.ClientTimeout(total=timeout)
+    ssl = None if verify_ssl else False
+    async with aiohttp.ClientSession(timeout=client_timeout) as session:
+        async with session.request(
+                method,
+                url,
+                headers=headers,
+                params=params,
+                data=data,
+                ssl=ssl,
+                allow_redirects=allow_redirects,
+        ) as response:
+            return _HTTPResponse(
+                response.status,
+                response.headers,
+                await response.read(),
+                method,
+                url,
+            )
+
+
+def _run_async(awaitable):
+    """Run an aiohttp coroutine from the library's synchronous API.
+
+    ``asyncio.run`` is sufficient for normal callers.  If a caller already
+    owns the current thread's event loop (for example, a notebook), execute
+    the request on a short-lived worker thread instead of failing with
+    ``RuntimeError: asyncio.run() cannot be called from a running event loop``.
+    """
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(awaitable)
+
+    result = []
+    error = []
+
+    def run():
+        try:
+            result.append(asyncio.run(awaitable))
+        except BaseException as exc:
+            error.append(exc)
+
+    thread = threading.Thread(target=run)
+    thread.start()
+    thread.join()
+    if error:
+        raise error[0]
+    return result[0]
+
+
+def _http_request(method, url, **kwargs):
+    """Synchronous bridge used by the legacy public API and CLI."""
+    return _run_async(_aiohttp_request(method, url, **kwargs))
+
+
+def _http_get(url, **kwargs):
+    return _http_request('GET', url, **kwargs)
+
+
+def _http_post(url, **kwargs):
+    return _http_request('POST', url, **kwargs)
+
+
+def _http_head(url, **kwargs):
+    return _http_request('HEAD', url, **kwargs)
 
