+def _is_deferred(value):
+    """Return whether *value* is a Twisted Deferred.
+
+    Keeping this check explicit is important: the existing public API and its
+    tests also accept ordinary response objects (and MagicMock instances).
+    """
+    return isinstance(value, Deferred)
+
+
+class _TreqSession(object):
+    """Small session-state transport backed by treq.
+
+    The rest of this module historically kept authentication and default
+    headers on a stateful HTTP session.  treq deliberately has no Session
+    object, so this adapter keeps that bit of state while delegating every
+    network operation to treq.  It also lets callers that replace
+    ``_session.request`` continue to do so.
+    """
+
+    def __init__(self):
+        self.auth = None
+        self.headers = {}
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        # _run_method serializes mappings to JSON to retain the old wire
+        # format.  treq's body producer accepts bytes, not text.
+        if isinstance(data, str):
+            data = data.encode("utf-8")
+
+        response = treq.request(method, url, data=data,
+                                timeout=timeout, headers=request_headers,
+                                auth=self.auth)
+        if _is_deferred(response):
+            return response.addCallback(_TreqResponse)
+        return _TreqResponse(response)
+
+
+class _TreqResponse(object):
+    """Expose the response attributes used by this package.
+
+    treq responses expose ``code`` and asynchronous ``content()``/``json()``
+    methods, whereas the old implementation consumed synchronous responses.
+    Body data is populated by ``_handle_response`` before an error is raised.
+    """
+
+    def __init__(self, response):
+        self._response = response
+        self._content = None
+
+    @property
+    def status_code(self):
+        return self._response.code
+
+    @property
+    def reason(self):
+        phrase = self._response.phrase
+        return phrase.decode("utf-8", "replace") if isinstance(phrase, bytes) else phrase
+
+    @property
+    def headers(self):
+        result = {}
+        for key, values in self._response.headers.getAllRawHeaders():
+            if isinstance(key, bytes):
+                key = key.decode("ascii", "replace")
+            if isinstance(values, (list, tuple)):
+                value = values[-1] if values else ""
+            else:
+                value = values
+            if isinstance(value, bytes):
+                value = value.decode("utf-8", "replace")
+            result[key] = value
+        return result
+
+    @property
+    def content(self):
+        return self._content
+
+    def content_deferred(self):
+        return self._response.content()
+
+    def json_deferred(self):
+        return self._response.json()
+
