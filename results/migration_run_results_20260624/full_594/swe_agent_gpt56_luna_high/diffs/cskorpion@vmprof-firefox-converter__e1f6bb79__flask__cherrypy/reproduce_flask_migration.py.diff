--- a/reproduce_flask_migration.py
+++ b/reproduce_flask_migration.py
@@ -0,0 +1,34 @@
+"""Smoke test for the CherryPy server used by the converter."""
+import json
+import tempfile
+import threading
+import time
+from urllib.request import Request, urlopen
+
+import cherrypy
+import symbolserver
+
+with tempfile.NamedTemporaryFile(mode="w", delete=False) as profile:
+    profile.write('{"meta": {}}')
+    profile_path = profile.name
+symbolserver.profilepath = profile_path
+symbolserver.jitlogpath = None
+symbolserver.path_dict = None
+
+cherrypy.config.update({
+    "server.socket_host": "127.0.0.1",
+    "server.socket_port": 5001,
+    "engine.autoreload.on": False,
+})
+cherrypy.tree.mount(symbolserver.cherrypyapp, "/")
+cherrypy.engine.start()
+try:
+    for _ in range(20):
+        if cherrypy.engine.state == cherrypy.engine.states.STARTED:
+            break
+        time.sleep(0.05)
+    response = urlopen("http://127.0.0.1:5001/profile")
+    assert json.load(response) == '{"meta": {}}'
+    print(type(symbolserver.cherrypyapp).__name__, response.headers["Access-Control-Allow-Origin"])
+finally:
+    cherrypy.engine.exit()
