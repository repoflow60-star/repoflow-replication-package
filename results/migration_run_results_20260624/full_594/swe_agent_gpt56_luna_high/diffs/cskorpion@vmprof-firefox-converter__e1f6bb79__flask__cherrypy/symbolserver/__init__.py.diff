+class SymbolServer:
+    """CherryPy application exposing the Firefox profiler symbol server."""
+
+    @staticmethod
+    def _headers(content_type="application/json"):
+        cherrypy.response.headers["Access-Control-Allow-Origin"] = "*"
+        cherrypy.response.headers["Access-Control-Allow-Headers"] = "Content-Type"
+        cherrypy.response.headers["Access-Control-Allow-Methods"] = "GET, POST, OPTIONS"
+        cherrypy.response.headers["Content-Type"] = content_type
+
+    @staticmethod
+    def _read_body():
+        return cherrypy.request.body.read()
+
+    @staticmethod
+    def _not_allowed(methods):
+        cherrypy.response.headers["Allow"] = ", ".join(methods)
+        raise cherrypy.HTTPError(405)
+
+    @cherrypy.expose
+    def profile(self, *path, **params):
+        self._headers()
+        if cherrypy.request.method == "OPTIONS":
+            return b""
+        if cherrypy.request.method != "GET" or path:
+            self._not_allowed(["GET", "OPTIONS"])
+        if os.path.exists(profilepath):
+            with open(profilepath, "r") as profile_file:
+                return json.dumps(profile_file.read()).encode("utf-8")
+        return b""
+
+    @cherrypy.expose
+    def source(self, *path, **params):
+        self._headers()
+        if path != ("v1",):
+            raise cherrypy.HTTPError(404)
+        if cherrypy.request.method == "OPTIONS":
+            return b""
+        if cherrypy.request.method != "POST":
+            self._not_allowed(["POST", "OPTIONS"])
+
+        response = {
+            "symbolsLastModified": None,
+            "sourceLastModified": None,
+            "file": "",
+            "source": ""
+        }
+        body = self._read_body()
+        if body:
+            jsonobj = json.loads(body)
+            response["file"] = jsonobj["file"]
+            file = response["file"]
+            if path_dict is not None and file in path_dict:
+                file = path_dict[file]
+            if file is not None and os.path.exists(file):
+                with open(file, "r") as source_file:
+                    response["source"] = source_file.read()
+        return json.dumps(response).encode("utf-8")
+
