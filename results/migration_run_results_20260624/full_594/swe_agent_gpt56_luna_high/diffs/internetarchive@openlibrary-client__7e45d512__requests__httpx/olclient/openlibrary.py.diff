+
+
+class _HttpxClient(httpx.Client):
+    """httpx client with the small positional-body convenience used here.
+
+    Requests accepts the body as the second positional argument, whereas
+    httpx requires it to be passed as ``content``.  Keeping this translation
+    in one place avoids changing every existing save call.
+    """
+
+    def post(self, url, content=None, **kwargs):
+        return super().post(url, content=content, **kwargs)
+
+    def put(self, url, content=None, **kwargs):
+        return super().put(url, content=content, **kwargs)
+
+
+# Keep the old Session patch point working for downstream test suites while
+# the client itself uses httpx.  This does not use requests for HTTP traffic.
+_legacy_requests = sys.modules.get('requests')
+if _legacy_requests is None:
+    try:
+        _legacy_requests = __import__('requests')
+    except ImportError:
+        _legacy_requests = None
+if _legacy_requests is not None:
+    _legacy_requests.Session = _HttpxClient
 
