+def get(url: str, headers: Optional[dict] = None, **kwargs) -> BaseHTTPResponse:
+    """Perform a GET request using urllib3."""
+    return _request('GET', url, headers=headers, **kwargs)
+
+
+def post(url: str, json: dict, headers: Optional[dict] = None, **kwargs) -> BaseHTTPResponse:
+    """Perform a JSON POST request using urllib3."""
+    return _request('POST', url, headers=headers, json=json, **kwargs)
+
+
+def _request(method: str, url: str, headers: Optional[dict] = None,
+             pkcs12_data: Optional[bytes] = None,
+             pkcs12_password: str = '', json: Optional[dict] = None) -> BaseHTTPResponse:
+    # urllib3 does not accept PKCS#12 data directly. Build an
+    # SSL context from the bundle instead and give it to a pool manager.
+    if pkcs12_data:
+        pool = PoolManager(ssl_context=_pkcs12_ssl_context(pkcs12_data, pkcs12_password))
+        response = pool.request(method, url, headers=headers, json=json)
+    else:
+        response = request(method, url, headers=headers, json=json)
+
+    # urllib3 stores the path in ``url`` for responses from a pool. Keep the
+    # complete URL available to callers.
+    response.url = url
+    return response
+
+
+def _pkcs12_ssl_context(pkcs12_data: bytes, password: str) -> ssl.SSLContext:
+    """Create an SSL context containing the client certificate in a PKCS#12."""
+    password_bytes = password if isinstance(password, bytes) else password.encode('utf-8')
+    bundle = crypto.load_pkcs12(pkcs12_data, password_bytes)
+
+    cert = bundle.get_certificate()
+    key = bundle.get_privatekey()
+    if cert is None or key is None:
+        raise ValueError('The PKCS#12 data does not contain a client certificate and private key')
+
+    pem = crypto.dump_certificate(crypto.FILETYPE_PEM, cert)
+    pem += crypto.dump_privatekey(crypto.FILETYPE_PEM, key)
+    for ca_cert in bundle.get_ca_certificates() or ():
+        pem += crypto.dump_certificate(crypto.FILETYPE_PEM, ca_cert)
+
+    ssl_context = ssl.create_default_context()
+    path = None
+    try:
+        with tempfile.NamedTemporaryFile(mode='wb', delete=False) as certificate_file:
+            certificate_file.write(pem)
+            path = certificate_file.name
+        ssl_context.load_cert_chain(path)
+    finally:
+        if path is not None:
+            os.unlink(path)
+
+    return ssl_context
+
+
+def response_status_code(response: BaseHTTPResponse) -> int:
+    """Return an HTTP status from urllib3 or a legacy response-like object."""
+    status = getattr(response, 'status', None)
+    return status if status is not None else response.status_code
 
 
