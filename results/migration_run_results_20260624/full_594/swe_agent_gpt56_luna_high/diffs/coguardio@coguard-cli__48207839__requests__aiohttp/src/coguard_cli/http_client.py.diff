--- a/src/coguard_cli/http_client.py
+++ b/src/coguard_cli/http_client.py
@@ -0,0 +1,146 @@
+"""Small synchronous adapter around :mod:`aiohttp`.
+
+The CLI has a synchronous public API, while aiohttp is asynchronous.  Keeping
+that boundary in one place lets the rest of the CLI retain its existing API
+without falling back to a second HTTP client library.
+"""
+
+import asyncio
+import json as json_module
+from concurrent.futures import ThreadPoolExecutor
+from typing import Any, Dict, Iterable, Optional
+
+import aiohttp
+from multidict import CIMultiDict, CIMultiDictProxy
+from yarl import URL
+
+
+class HttpResponse:
+    """The small part of the previous response type used by the CLI."""
+
+    def __init__(self, status: int, reason: str, content: bytes, url: str, method: str):
+        self.status_code = status
+        self.reason = reason
+        self.content = content
+        self._url = URL(url)
+        self._method = method
+
+    @property
+    def text(self) -> str:
+        return self.content.decode("utf-8", errors="replace")
+
+    def json(self) -> Any:
+        return json_module.loads(self.text)
+
+    def iter_content(self, chunk_size: int = 8192) -> Iterable[bytes]:
+        for start in range(0, len(self.content), chunk_size):
+            yield self.content[start:start + chunk_size]
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            request_info = aiohttp.RequestInfo(
+                self._url,
+                self._method,
+                CIMultiDictProxy(CIMultiDict()),
+                self._url,
+            )
+            raise aiohttp.ClientResponseError(
+                request_info=request_info,
+                history=(),
+                status=self.status_code,
+                message=self.reason,
+            )
+
+    def __enter__(self) -> "HttpResponse":
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback) -> None:
+        return None
+
+
+def _run(coroutine):
+    """Run an aiohttp coroutine from the CLI's synchronous code.
+
+    ``asyncio.run`` cannot be called while another event loop is running.  The
+    thread fallback keeps the synchronous API usable by callers such as
+    notebooks and async test runners as well.
+    """
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coroutine)
+
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        return executor.submit(asyncio.run, coroutine).result()
+
+
+async def _request_async(
+        method: str,
+        url: str,
+        headers: Optional[Dict[str, str]],
+        data: Any,
+        json_payload: Any,
+        timeout: Optional[float],
+) -> HttpResponse:
+    client_timeout = aiohttp.ClientTimeout(total=timeout) if timeout else None
+    request_kwargs = {"headers": headers, "timeout": client_timeout}
+    if data is not None:
+        request_kwargs["data"] = data
+    if json_payload is not None:
+        request_kwargs["json"] = json_payload
+
+    async with aiohttp.ClientSession() as session:
+        async with session.request(method, url, **request_kwargs) as response:
+            return HttpResponse(
+                response.status, response.reason or "", await response.read(), url, method
+            )
+
+
+def request(
+        method: str,
+        url: str,
+        *,
+        headers: Optional[Dict[str, str]] = None,
+        data: Any = None,
+        json_payload: Any = None,
+        timeout: Optional[float] = None,
+        stream: bool = False,
+) -> HttpResponse:
+    """Make one HTTP request through aiohttp.
+
+    ``stream`` is accepted for compatibility with the old call sites.  The
+    response is buffered here; report downloads use :func:`download` below to
+    retain true streaming behavior.
+    """
+    del stream
+    return _run(_request_async(method, url, headers, data, json_payload, timeout))
+
+
+async def _download_async(
+        method: str,
+        url: str,
+        destination: str,
+        headers: Optional[Dict[str, str]],
+        timeout: Optional[float],
+) -> None:
+    client_timeout = aiohttp.ClientTimeout(total=timeout) if timeout else None
+    async with aiohttp.ClientSession() as session:
+        async with session.request(
+                method, url, headers=headers, timeout=client_timeout) as response:
+            if response.status >= 400:
+                response.raise_for_status()
+            with open(destination, "wb") as output:
+                async for chunk in response.content.iter_chunked(8192):
+                    output.write(chunk)
+
+
+def download(
+        method: str,
+        url: str,
+        destination: str,
+        *,
+        headers: Optional[Dict[str, str]] = None,
+        timeout: Optional[float] = None,
+) -> None:
+    """Stream an HTTP response to a local file."""
+    _run(_download_async(method, url, destination, headers, timeout))
