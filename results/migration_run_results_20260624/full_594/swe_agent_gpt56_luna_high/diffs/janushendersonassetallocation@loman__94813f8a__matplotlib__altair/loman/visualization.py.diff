+# Altair represents colour maps as scales.  GraphViz needs the colour value
+# itself, so the scale's range is interpolated here before it is put on a node.
+# Keeping the scale as the public ``cmap`` value also means callers can provide
+# any Altair colour range without needing a plotting backend.
+_DEFAULT_TIMING_COLORS = ('#15b01a', '#ffff14', '#e50000')
+_VEGA_SCHEME_COLORS = {
+    'redyellowgreen': ('#d73027', '#fee08b', '#1a9850'),
+    'viridis': ('#440154', '#31688e', '#35b779', '#fde725'),
+    'blues': ('#f7fbff', '#6baed6', '#08306b'),
+    'greens': ('#f7fcf5', '#74c476', '#00441b'),
+    'reds': ('#fff5f0', '#fb6a4a', '#67000d'),
+}
+
+
+def _color_components(color):
+    """Return RGB components in the 0--255 range for a CSS colour value."""
+    if isinstance(color, str):
+        value = color.strip().lower()
+        if value.startswith('#'):
+            value = value[1:]
+            if len(value) == 3:
+                value = ''.join(component * 2 for component in value)
+            if len(value) in (6, 8):
+                try:
+                    return tuple(int(value[i:i + 2], 16) for i in (0, 2, 4))
+                except ValueError:
+                    pass
+        if value.startswith('rgb(') or value.startswith('rgba('):
+            values = value[value.index('(') + 1:-1].split(',')
+            if len(values) >= 3:
+                try:
+                    components = [float(component.strip().rstrip('%')) for component in values[:3]]
+                    if '%' in values[0]:
+                        components = [component * 2.55 for component in components]
+                    return tuple(max(0, min(255, round(component))) for component in components)
+                except ValueError:
+                    pass
+    return None
+
+
+def _color_as_hex(color):
+    """Convert a colour returned by a callable scale to a GraphViz colour."""
+    if isinstance(color, str):
+        components = _color_components(color)
+        if components is None:
+            return color
+        return '#{:02x}{:02x}{:02x}'.format(*components)
+    try:
+        components = list(color[:3])
+        if all(abs(float(component)) <= 1 for component in components):
+            components = [float(component) * 255 for component in components]
+        return '#{:02x}{:02x}{:02x}'.format(*(max(0, min(255, round(float(component)))) for component in components))
+    except (TypeError, ValueError, IndexError):
+        return str(color)
+
+
+def _scale_colors(cmap):
+    """Get a sequence of colours from an Altair scale (or a compatible value)."""
+    if isinstance(cmap, alt.Scale):
+        colors = cmap.range
+        if colors is alt.Undefined:
+            scheme = cmap.scheme
+            colors = _VEGA_SCHEME_COLORS.get(scheme, _DEFAULT_TIMING_COLORS)
+    else:
+        colors = cmap
+    if isinstance(colors, str):
+        colors = _VEGA_SCHEME_COLORS.get(colors.lower(), (colors,))
+    try:
+        colors = tuple(colors)
+    except TypeError:
+        colors = _DEFAULT_TIMING_COLORS
+    return colors or _DEFAULT_TIMING_COLORS
+
+
+def _interpolate_scale(cmap, position):
+    """Return the colour at *position* in an Altair scale's colour range."""
+    # A callable is accepted for compatibility with callers that supplied a
+    # custom colour scale before the migration to Altair.
+    if callable(cmap) and not isinstance(cmap, alt.Scale):
+        return _color_as_hex(cmap(position))
+
+    colors = _scale_colors(cmap)
+    position = max(0.0, min(1.0, float(position)))
+    if len(colors) == 1:
+        return _color_as_hex(colors[0])
+
+    scaled_position = position * (len(colors) - 1)
+    lower = min(int(scaled_position), len(colors) - 2)
+    fraction = scaled_position - lower
+    first = _color_components(colors[lower])
+    second = _color_components(colors[lower + 1])
+    if first is None or second is None:
+        return _color_as_hex(colors[round(scaled_position)])
+    components = [round(a + (b - a) * fraction) for a, b in zip(first, second)]
+    return '#{:02x}{:02x}{:02x}'.format(*components)
+
