+class _RequestsModuleSession:
+    """Delegate requests to the module-level API.
+
+    ``requests_futures`` normally delegates to a ``requests.Session``.  Using
+    this small adapter keeps the existing requests API as the transport while
+    allowing the request to be submitted through a ``FuturesSession``.  It
+    also keeps callers that replace ``requests.get`` or ``requests.post``
+    (such as the existing unit tests) working during the migration.
+    """
+
+    @staticmethod
+    def request(method: str, url: str, **kwargs):
+        return getattr(requests, method.lower())(url, **kwargs)
 
 
