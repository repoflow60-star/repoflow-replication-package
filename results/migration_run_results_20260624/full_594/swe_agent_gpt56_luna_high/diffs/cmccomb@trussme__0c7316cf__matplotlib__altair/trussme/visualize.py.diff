+
+# Keep the short color names accepted by the old plotting interface.  They are
+# not CSS colors, so Vega-Lite cannot interpret them directly.
+_COLOR_ALIASES = {
+    "b": "blue",
+    "g": "green",
+    "k": "black",
+    "m": "magenta",
+    "r": "red",
+    "c": "cyan",
+    "y": "yellow",
+    "w": "white",
+}
+
+
+def _color_name(color: AltairColor) -> AltairColor:
+    """Return an Altair/CSS spelling for a color name."""
+    if isinstance(color, str):
+        return _COLOR_ALIASES.get(color, color)
+    return color
+
+
+def _force_color(force: float, scaler: float) -> str:
+    """Map a member force to the red/gray/blue scale used by the plot."""
+    # The previous plot used force / (2 * scaler) + .5.  Clamping also makes
+    # this well-defined for forces outside the normal range and for a zero
+    # force truss.
+    if scaler == 0 or not numpy.isfinite(scaler):
+        position = 0.5
+    else:
+        position = float(numpy.clip(force / (2.0 * scaler) + 0.5, 0.0, 1.0))
+
+    if position <= 0.5:
+        fraction = position * 2.0
+        left, right = (255, 0, 0), (204, 204, 204)
+    else:
+        fraction = (position - 0.5) * 2.0
+        left, right = (204, 204, 204), (0, 0, 255)
+    rgb = tuple(round(a + fraction * (b - a)) for a, b in zip(left, right))
+    return "#%02x%02x%02x" % rgb
+
+
+def _line_records(
+    truss, shape, exaggeration_factor, scaler, deflected, fos_threshold
+):
+    """Create the two-point records used by a Vega-Lite line chart."""
+    if shape is None:
+        return []
+
+    records = []
+    for member in truss.members:
+        if shape == "fos":
+            color = (
+                "green"
+                if min(member.fos_buckling, member.fos_yielding) > fos_threshold
+                else "red"
+            )
+        elif shape == "force":
+            color = _force_color(member.force, scaler)
+        else:
+            color = _color_name(shape)
+
+        def point(joint):
+            if not deflected:
+                return joint.coordinates[0], joint.coordinates[1]
+            return (
+                joint.coordinates[0] + exaggeration_factor * joint.deflections[0],
+                joint.coordinates[1] + exaggeration_factor * joint.deflections[1],
+            )
+
+        x0, y0 = point(member.begin_joint)
+        x1, y1 = point(member.end_joint)
+        series = ("deflected" if deflected else "starting") + str(member.idx)
+        records.extend(
+            [
+                {"x": x0, "y": y0, "series": series, "color": color},
+                {"x": x1, "y": y1, "series": series, "color": color},
+            ]
+        )
+    return records
 
 
