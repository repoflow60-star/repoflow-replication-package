+class _TreqRequestsCompatibility:
+    """Expose the old ``requests.get`` seam for existing callers.
+
+    The project now uses treq for HTTP requests.  Keeping this tiny adapter
+    means callers that patched ``collector.requests.get`` continue to work,
+    while the default implementation delegates entirely to treq.
+    """
+
+    @staticmethod
+    def get(url: str, *, timeout: int) -> defer.Deferred[Any]:
+        _start_reactor()
+        if threading.current_thread() is _reactor_thread:
+            return treq.get(url, timeout=timeout)
+        return threads.blockingCallFromThread(
+            reactor, treq.get, url, timeout=timeout
+        )
+
+
+# ``requests`` is deliberately an adapter, not the requests package.  It is
+# retained as a compatibility seam for consumers that patch the old call.
+requests = _TreqRequestsCompatibility()
+
+_reactor_thread: threading.Thread | None = None
+_reactor_started = threading.Event()
+_reactor_lock = threading.Lock()
+
+
+def _resolve_deferred(value: Any) -> Any:
+    """Return a Deferred's result from synchronous application code.
+
+    Treq is asynchronous, but the public collector API predates that change
+    and is synchronous.  A reactor is started once in a background thread so
+    the command-line entry point can keep its existing synchronous contract.
+    Deferreds that have already fired (which is common in tests) do not need a
+    reactor at all.
+    """
+    if not isinstance(value, defer.Deferred):
+        return value
+
+    result: list[Any] = []
+    failure: list[Any] = []
+    finished = threading.Event()
+
+    def _success(res: Any) -> Any:
+        result.append(res)
+        finished.set()
+        return res
+
+    def _failure(err: Any) -> None:
+        failure.append(err)
+        finished.set()
+        # Consume the Failure here; it is raised synchronously below.
+        return None
+
+    value.addCallbacks(_success, _failure)
+    if not finished.is_set():
+        _start_reactor()
+        finished.wait()
+
+    if failure:
+        failure[0].raiseException()
+    return result[0]
+
+
+def _start_reactor() -> None:
+    """Start Twisted's reactor in a daemon thread if it is not running."""
+    global _reactor_thread
+
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is None or not _reactor_thread.is_alive():
+            _reactor_started.clear()
+
+            def _run_reactor() -> None:
+                reactor.callWhenRunning(_reactor_started.set)
+                reactor.run(installSignalHandlers=False)
+
+            _reactor_thread = threading.Thread(
+                target=_run_reactor,
+                name="nukedockerbuild-twisted-reactor",
+                daemon=True,
+            )
+            _reactor_thread.start()
+    _reactor_started.wait()
+
