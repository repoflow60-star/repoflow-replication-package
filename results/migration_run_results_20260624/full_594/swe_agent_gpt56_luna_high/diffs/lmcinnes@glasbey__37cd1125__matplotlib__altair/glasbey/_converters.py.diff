+def to_rgb(color):
+    """Convert a CSS/hex colour or an RGB(A) sequence to an RGB triple."""
+    if isinstance(color, str):
+        value = _CSS_COLORS.get(color.lower(), color)
+        if not value.startswith("#"):
+            match = re.fullmatch(
+                r"rgba?\(\s*([0-9.]+)\s*,\s*([0-9.]+)\s*,\s*([0-9.]+)(?:\s*,\s*[0-9.]+)?\s*\)",
+                value,
+                re.I,
+            )
+            if match:
+                return tuple(float(channel) / 255.0 for channel in match.groups())
+            raise ValueError(f"Invalid colour value {color!r}")
+        value = value[1:]
+        if len(value) in (3, 4):
+            value = "".join(channel * 2 for channel in value)
+        if len(value) not in (6, 8):
+            raise ValueError(f"Invalid colour value {color!r}")
+        try:
+            return tuple(int(value[index:index + 2], 16) / 255.0 for index in (0, 2, 4))
+        except ValueError as exc:
+            raise ValueError(f"Invalid colour value {color!r}") from exc
+
+    values = tuple(float(channel) for channel in color)
+    if len(values) not in (3, 4):
+        raise ValueError("An RGB colour must have three or four channels")
+    if any(channel < 0 or channel > 1 for channel in values[:3]):
+        values = tuple(channel / 255.0 for channel in values)
+    return values[:3]
+
+
+def rgb2hex(color):
+    """Return the six-digit hex representation of an RGB(A) colour."""
+    rgb = np.clip(np.asarray(to_rgb(color), dtype=float), 0.0, 1.0)
+    # np.round matches the half-to-even rounding used by Matplotlib's
+    # rgb2hex, while keeping this helper independent of Matplotlib.
+    channels = np.round(rgb * 255).astype(int)
+    return "#" + "".join(f"{channel:02x}" for channel in channels)
+
