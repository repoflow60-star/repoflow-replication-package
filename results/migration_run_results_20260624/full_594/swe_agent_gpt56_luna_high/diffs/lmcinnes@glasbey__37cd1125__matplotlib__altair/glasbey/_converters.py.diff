+def _scheme_colors(name, max_colors):
+    try:
+        colors = _SCHEMES[name.lower()]
+    except (AttributeError, KeyError) as exc:
+        raise ValueError(f"Unrecognized palette name {name}") from exc
+    colors = [to_rgb(color) for color in colors]
+    if max_colors < 1:
+        raise ValueError("max_colors must be a positive integer")
+    if len(colors) > max_colors:
+        # Sample listed schemes at evenly spaced points, including both ends.
+        # This is also the behaviour of the listed schemes in older glasbey
+        # releases and avoids silently dropping the final colour.
+        indices = linspace(0, len(colors) - 1, max_colors).astype(int)
+        colors = [colors[index] for index in indices]
+    return array(colors, dtype=float32, order="C")
+
