+class _Response:
+    """Small synchronous response facade for treq's asynchronous response."""
+
+    def __init__(self, response: Any, body: bytes) -> None:
+        self.status_code = response.code
+        self.headers = self._headers(response.headers)
+        self.text = self._text(body, self.headers.get("content-type", ""))
+
+    @staticmethod
+    def _headers(headers: Any) -> Dict[str, str]:
+        result: Dict[str, str] = {}
+        for name, values in headers.getAllRawHeaders():
+            if isinstance(name, bytes):
+                name = name.decode("latin-1")
+            decoded_values = [
+                value.decode("latin-1") if isinstance(value, bytes) else str(value)
+                for value in values
+            ]
+            result[str(name).lower()] = ", ".join(decoded_values)
+        return result
+
+    @staticmethod
+    def _text(body: bytes, content_type: str) -> str:
+        encoding = "utf-8"
+        for part in content_type.split(";")[1:]:
+            key, separator, value = part.strip().partition("=")
+            if separator and key.lower() == "charset":
+                encoding = value.strip().strip('"')
+                break
+        return body.decode(encoding, errors="replace")
+
+    def json(self) -> Any:
+        return json.loads(self.text)
+
+
+_reactor_lock = threading.Lock()
+_reactor_started = threading.Event()
+_reactor_thread: Union[threading.Thread, None] = None
+
+
+def _start_reactor() -> None:
+    reactor.callWhenRunning(_reactor_started.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor() -> None:
+    global _reactor_thread
+    with _reactor_lock:
+        if _reactor_thread is not None and _reactor_thread.is_alive():
+            return
+        _reactor_started.clear()
+        _reactor_thread = threading.Thread(
+            target=_start_reactor, name="treq-reactor", daemon=True
+        )
+        _reactor_thread.start()
+    if not _reactor_started.wait(timeout=5):
+        raise RuntimeError("Unable to start the Twisted reactor")
+
+
+def _request_with_treq(
+    method: str,
+    url: str,
+    params: Union[Dict[Any, Any], List[Dict[Any, Any]]],
+    headers: Dict[Any, Any],
+) -> Any:
+    """Run one treq request synchronously for the SDK's synchronous API."""
+    _ensure_reactor()
+    completed = threading.Event()
+    result: Dict[str, Any] = {}
+
+    def fail(failure: Any) -> None:
+        if isinstance(failure, Failure):
+            result["error"] = failure.value
+        else:
+            result["error"] = failure
+        completed.set()
+
+    def done(response: Any, body: Any) -> None:
+        try:
+            result["response"] = _Response(response, body)
+        except Exception as error:
+            result["error"] = error
+        completed.set()
+
+    def got_response(response: Any) -> Any:
+        body_deferred = treq.content(response)
+        body_deferred.addCallbacks(lambda body: done(response, body), fail)
+        return response
+
+    def issue_request() -> None:
+        try:
+            deferred = treq.request(method, url, json=params, headers=headers)
+            # treq always returns a Deferred.  Keeping a direct return value
+            # usable also makes the transport easy to replace in applications.
+            if isinstance(deferred, Deferred):
+                deferred.addCallbacks(got_response, fail)
+            else:
+                result["response"] = deferred
+                completed.set()
+        except Exception as error:
+            result["error"] = error
+            completed.set()
+
+    reactor.callFromThread(issue_request)
+    completed.wait()
+    if "error" in result:
+        raise result["error"]
+    return result["response"]
 
 
