 from rdflib import Graph, URIRef
 import requests
+from requests_futures.sessions import FuturesSession
+
+
+class _RequestsModuleSession(object):
+    """Adapt requests' module-level API for a FuturesSession.
+
+    ``requests-futures`` normally wraps a requests ``Session``.  The
+    original library uses the module-level requests functions, however, and
+    keeping that boundary here also preserves the existing request options
+    and makes the dependency easy to substitute in callers' tests.
+    """
+
+    def request(self, method, url, **kwargs):
+        request = getattr(requests, method.lower())
+        # Session.post supplies its optional ``json`` argument even when it
+        # was not provided.  The module-level requests API does not.
+        if kwargs.get('json') is None:
+            kwargs.pop('json', None)
+        return request(url, **kwargs)
+
+
+def http_request(method, url, **kwargs):
+    """Perform a requests call through ``requests-futures``.
+
+    The public LDN methods are synchronous, so wait for the future before
+    returning.  This keeps their existing API while using the futures-backed
+    HTTP implementation.
+    """
+    session = FuturesSession(session=_RequestsModuleSession())
+    try:
+        future = getattr(session, method.lower())(url, **kwargs)
+        return future.result()
+    finally:
+        session.close()
 
 
