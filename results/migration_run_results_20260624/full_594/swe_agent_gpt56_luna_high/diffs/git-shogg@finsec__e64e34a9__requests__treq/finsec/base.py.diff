 import time
 from io import StringIO
 
+
+# treq is asynchronous, while FilingBase's public API is synchronous.  Keep a
+# single reactor running in a daemon thread and bridge each request back to the
+# calling thread.  A reactor cannot be started and stopped repeatedly, so using
+# one per request would fail after the first request to a filing.
+_reactor_start_lock = threading.Lock()
+_reactor_ready = threading.Event()
+_reactor_thread = None
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _start_reactor():
+    global _reactor_thread
+    if reactor.running:
+        return
+    with _reactor_start_lock:
+        if _reactor_thread is None:
+            _reactor_thread = threading.Thread(
+                target=_run_reactor,
+                name="finsec-treq-reactor",
+                daemon=True,
+            )
+            _reactor_thread.start()
+    _reactor_ready.wait()
+
+
+def _get_text(url, headers):
+    """Synchronously fetch *url* using treq and return its response text."""
+    _start_reactor()
+
+    def request():
+        response = treq.get(url, headers=headers)
+        return response.addCallback(treq.text_content)
+
+    return blockingCallFromThread(reactor, request)
+
