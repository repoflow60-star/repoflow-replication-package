+class _AiohttpResponse:
+    """Small response snapshot used after an aiohttp response is closed."""
+
+    def __init__(self, status: int, content: bytes):
+        self.status = status
+        self.content = content
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status < 400
+
+
+def _run_async(coro):
+    """Run an aiohttp coroutine from the SDK's synchronous public API.
+
+    ``IconService`` and ``Provider`` predate aiohttp and intentionally expose
+    synchronous methods.  ``asyncio.run`` is sufficient for normal callers,
+    but cannot be used while another event loop is running (for example from
+    a notebook).  In that case the request is run on a short-lived helper
+    thread with its own event loop.
+    """
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coro)
+
+    result = []
+    error = []
+
+    def run_in_thread():
+        try:
+            result.append(asyncio.run(coro))
+        except BaseException as exc:  # preserve the original exception type
+            error.append(exc)
+
+    thread = Thread(target=run_in_thread)
+    thread.start()
+    thread.join()
+    if error:
+        raise error[0]
+    return result[0]
+
+
+
 
 
