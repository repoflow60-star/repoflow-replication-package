+class _HTTPXResponse:
+    """Expose the small response interface used by the legacy API methods.
+
+    The public API historically returned HTTP responses (``status``,
+    ``read`` and ``stream``).  Keeping this adapter lets the rest of the
+    client retain that interface while the transport is provided entirely by
+    httpx.
+    """
+
+    def __init__(self, response):
+        self._response = response
+        self._body = None
+        self._position = 0
+
+    @property
+    def status(self):
+        return self._response.status_code
+
+    @property
+    def status_code(self):
+        return self._response.status_code
+
+    @property
+    def headers(self):
+        return self._response.headers
+
+    @property
+    def data(self):
+        return self._read_all()
+
+    def _read_all(self):
+        if self._body is None:
+            self._body = self._response.read()
+        return self._body
+
+    def read(self, size=None):
+        body = self._read_all()
+        if size is None:
+            result = body[self._position :]
+            self._position = len(body)
+            return result
+        result = body[self._position : self._position + size]
+        self._position += len(result)
+        return result
+
+    def stream(self, size=65536):
+        body = self._read_all()
+        while self._position < len(body):
+            yield self.read(size)
+
+    def getheaders(self):
+        return self._response.headers.items()
+
+    def close(self):
+        self._response.close()
+
+    def __iter__(self):
+        return iter(self._body.splitlines(True) if self._body is not None else [])
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
+
