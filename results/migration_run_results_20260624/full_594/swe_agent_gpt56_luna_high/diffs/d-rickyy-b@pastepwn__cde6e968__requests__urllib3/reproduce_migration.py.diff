--- a/reproduce_migration.py
+++ b/reproduce_migration.py
@@ -0,0 +1,23 @@
+"""Show that the current request helper still requires requests."""
+import builtins
+import sys
+import types
+
+# The optional Twitter integration imports requests internally. Keep this
+# reproduction focused on PastePwn's own HTTP helper.
+sys.modules["twitter"] = types.ModuleType("twitter")
+
+real_import = builtins.__import__
+
+
+def reject_requests(name, *args, **kwargs):
+    if name == "requests" or name.startswith("requests."):
+        raise ModuleNotFoundError("requests is not installed")
+    return real_import(name, *args, **kwargs)
+
+
+builtins.__import__ = reject_requests
+from pastepwn.util import Request  # noqa: E402
+
+Request()
+print("urllib3-only import succeeded")
