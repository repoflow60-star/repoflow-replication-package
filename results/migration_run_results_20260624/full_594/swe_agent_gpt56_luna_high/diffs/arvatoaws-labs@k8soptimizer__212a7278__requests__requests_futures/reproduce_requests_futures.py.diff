--- a/reproduce_requests_futures.py
+++ b/reproduce_requests_futures.py
@@ -0,0 +1,19 @@
+"""Reproduce the requests -> requests_futures migration gap."""
+from pathlib import Path
+
+requirements = Path(__file__).with_name("requirements.txt").read_text()
+assert "requests_futures==1.0.2" in requirements, (
+    "the repository still installs requests rather than requests_futures==1.0.2"
+)
+
+from k8soptimizer import main  # noqa: E402
+
+assert main.__name__ == "k8soptimizer.main"
+assert "requests_futures" in main.__file__
+
+try:
+    from requests_futures.sessions import FuturesSession  # noqa: F401
+except ModuleNotFoundError as error:
+    raise AssertionError("requests_futures is not available") from error
+
+print("requests_futures migration is present")
