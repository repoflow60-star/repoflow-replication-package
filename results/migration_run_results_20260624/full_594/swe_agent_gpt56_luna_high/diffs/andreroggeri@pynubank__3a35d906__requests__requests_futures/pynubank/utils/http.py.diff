+    def _request(self, method: str, url: str, **kwargs) -> Response:
+        # Keep the existing synchronous HttpClient contract while using the
+        # futures transport underneath. This also lets requests-pkcs12 keep
+        # handling PKCS#12 certificates in the worker thread.
+        with FuturesSession(session=_Pkcs12Session()) as session:
+            return session.request(method, url, **kwargs).result()
