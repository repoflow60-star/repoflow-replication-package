+def _get_response_body(url: str) -> bytes:
+    body = BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEDATA, body)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.FAILONERROR, True)
+        curl.perform()
+    finally:
+        curl.close()
+    return body.getvalue()
+
