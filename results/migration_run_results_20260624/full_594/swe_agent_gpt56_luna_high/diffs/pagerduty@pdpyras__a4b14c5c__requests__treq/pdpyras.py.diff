+class _TreqSession:
+    """Session-shaped adapter used to preserve pdpyras' synchronous API."""
+
+    def __init__(self):
+        self.headers = {}
+
+    def request(self, method, url, **kwargs):
+        return _treq_request(method, url, **kwargs)
+
+    def get(self, url, **kwargs):
+        kwargs.setdefault('allow_redirects', True)
+        return self.request('GET', url, **kwargs)
+
+    def options(self, url, **kwargs):
+        kwargs.setdefault('allow_redirects', True)
+        return self.request('OPTIONS', url, **kwargs)
+
+    def head(self, url, **kwargs):
+        kwargs.setdefault('allow_redirects', False)
+        return self.request('HEAD', url, **kwargs)
+
+    def post(self, url, data=None, json=None, **kwargs):
+        kwargs['data'] = data
+        # Unlike requests, treq treats ``json=None`` as an explicit JSON null
+        # body.  Omitting it preserves requests' historical behavior.
+        if json is not None:
+            kwargs['json'] = json
+        return self.request('POST', url, **kwargs)
+
+    def put(self, url, data=None, **kwargs):
+        kwargs['data'] = data
+        return self.request('PUT', url, **kwargs)
+
+    def patch(self, url, data=None, **kwargs):
+        kwargs.setdefault('allow_redirects', True)
+        kwargs['data'] = data
+        return self.request('PATCH', url, **kwargs)
+
+    def delete(self, url, **kwargs):
+        kwargs.setdefault('allow_redirects', True)
+        return self.request('DELETE', url, **kwargs)
+
+Response = _TreqResponse
 
