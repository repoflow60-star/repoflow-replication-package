+def _rich_table(
+    output: ty.List[ty.Tuple[str, ty.Any]],
+    headers: ty.List[str],
+    tablefmt: str,
+) -> str:
+    """Render rows as a Rich table.
+
+    Rich renders tables to a console rather than returning a string, so use a
+    string buffer here.  Disabling terminal features is important because the
+    result is subsequently sent to a pager (and may also be written to a
+    pipe).
+    """
+    headers = [ensure_str(header) for header in headers]
+    values = [[ensure_str(value) for value in row] for row in output]
+
+    table = Table(
+        *headers,
+        box=box.SIMPLE if tablefmt == 'simple' else box.HEAVY_HEAD,
+        highlight=False,
+    )
+    for row in values:
+        # API responses should always have one value per header.  Padding and
+        # truncating here keeps a malformed response from making output fail
+        # while retaining the behaviour of a tabular formatter.
+        row = row[: len(headers)]
+        row.extend([''] * (len(headers) - len(row)))
+        table.add_row(*row)
+
+    # Rich otherwise assumes an 80-column console when writing to StringIO,
+    # which can wrap long values before they reach the pager.  Give it enough
+    # room for the rendered table instead.
+    widths = [cell_len(header) for header in headers]
+    for row in values:
+        for index, value in enumerate(row[: len(headers)]):
+            widths[index] = max(
+                [
+                    widths[index],
+                    *(cell_len(line) for line in value.splitlines()),
+                ]
+            )
+    width = max(80, sum(widths) + 3 * len(headers) + 1)
+
+    result = io.StringIO()
+    Console(
+        file=result,
+        width=width,
+        force_terminal=False,
+        color_system=None,
+        markup=False,
+        emoji=False,
+        highlight=False,
+    ).print(table)
+    return result.getvalue().rstrip('\n')
+
+
+# Keep the old module-level name as a small compatibility seam for callers
+# which patched the former formatter.  This is implemented with Rich; the
+# tabulate package is no longer imported or required.
+tabulate = _rich_table
 
 
