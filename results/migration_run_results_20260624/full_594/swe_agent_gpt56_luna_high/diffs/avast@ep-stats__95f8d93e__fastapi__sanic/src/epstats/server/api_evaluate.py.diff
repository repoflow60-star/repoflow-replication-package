+class RequestValidationError(SanicException):
+    """Validation failure represented as the API's 422 response."""
+
+    def __init__(self, detail: list[dict[str, Any]]) -> None:
+        self.detail = detail
+        super().__init__("Request validation failed", status_code=422)
+
+
+def _validation_detail(error: ValidationError) -> list[dict[str, Any]]:
+    detail = []
+    for item in error.errors():
+        # Preserve the historical request-body prefix so existing API clients
+        # do not need to change.
+        location = ["body", *item["loc"]]
+        detail.append(
+            {
+                "loc": location,
+                "msg": item["msg"],
+                "type": item["type"],
+            }
+        )
+    return detail
 
