--- a/src/epstats/server/dependencies.py
+++ b/src/epstats/server/dependencies.py
@@ -0,0 +1,43 @@
+"""Small dependency resolver used by the Sanic endpoints.
+
+The previous framework resolved generator dependencies and exposed an
+override mapping for tests. Keeping this behavior here makes the migration
+transparent to applications that already provide DAO and executor factories.
+"""
+
+import inspect
+from contextlib import asynccontextmanager
+from typing import Any, Callable
+
+
+@asynccontextmanager
+async def dependency(factory: Callable[..., Any], app):
+    override = app.dependency_overrides.get(factory, factory)
+    value = override()
+
+    if inspect.isawaitable(value):
+        value = await value
+
+    if inspect.isasyncgen(value):
+        try:
+            yield await value.__anext__()
+        finally:
+            await value.aclose()
+    elif inspect.isgenerator(value):
+        try:
+            yield next(value)
+        finally:
+            value.close()
+    else:
+        yield value
+
+
+async def maybe_await(value: Any) -> Any:
+    return await value if inspect.isawaitable(value) else value
+
+
+__all__ = ["dependency", "maybe_await"]
+
+
+# The module intentionally does not depend on Sanic. It can therefore also be
+# used by integrations that expose ordinary or async DAO factories.
