+def _as_number(value: Any) -> Any:
+    """Turn Mako's rendered filter argument back into a useful number.
+
+    Mako applies output filters to the string representation of an
+    expression. The formatters above, however, operate on the original
+    numeric value. Converting here lets the filters retain that behaviour
+    when used with Mako's ``|`` syntax.
+    """
+    if not isinstance(value, str):
+        return value
+    try:
+        return int(value)
+    except ValueError:
+        try:
+            return float(value)
+        except ValueError:
+            return value
+
+
+def _filter(func: Callable[[Any], Any]) -> Callable[[Any], Any]:
+    def wrapped(value: Any) -> str:
+        return str(func(_as_number(value)))
+
+    return wrapped
+
+
+def _as_int(value: Any) -> str:
+    value = _as_number(value)
+    return str(int(value))
+
+
+def register_filters() -> Dict[str, Callable[[Any], Any]]:
+    """Return functions available to Mako templates.
+
+    In addition to the application filters, ``int`` is supplied because it
+    was available as a built-in Jinja filter and is commonly used in task
+    format strings. Mako passes filter arguments as text, so this version
+    also accepts values such as ``"50.0"``.
+    """
+    return {
+        "KB": _filter(kb),
+        "MB": _filter(mb),
+        "GB": _filter(gb),
+        "uptime": _filter(uptime),
+        "uptimesec": _filter(uptimesec),
+        "int": _as_int,
+    }
+
+
+def _mako_template(source: str) -> Template:
+    """Compile a Mako template, retaining support for old format strings.
+
+    Existing configurations used Jinja-style ``{{ expression }}`` markers.
+    Supporting those markers while migrating means configurations do not
+    silently publish the marker text when they are upgraded to Mako. New
+    templates should use Mako's ``${expression}`` form.
+    """
+    source = re.sub(r"\{\{(.*?)\}\}", r"${\1}", source, flags=re.DOTALL)
+    return Template(source)
