+            text = self._response_text(body_bytes)
+        except Exception as error:
+            raise ConnectionUnavailableError(message=str(error) or None) from None
+
+        status = self._status_code(response)
+        if status is None:
+            raise ConnectionUnavailableError(message="Invalid response from server") from None
+
+        if status >= 400:
+            message = self.parse_response_message(text)
+            if method == "GET" and status == 404:
+                raise NotFoundError(message=message, status=status) from None
+            if method == "DELETE" and status == 404:
+                raise NotFoundError(message=message, status=status) from None
+            if status == 400 and method in {"POST", "PUT"}:
+                raise InvalidJsonError(message=message, status=status) from None
+            if status == 401 and method in {"POST", "PUT", "DELETE"}:
+                raise UnauthorizedError(message=message, status=status) from None
+            raise HttpError(message=message, status=status) from None
+
+        try:
+            data = json.loads(text)
+        except (TypeError, ValueError):
+            data = text
+        defer.returnValue({"data": data, "status": status})
 
