+    @defer.inlineCallbacks
+    def _perform_request(self, method, endpoint, params=None, body=_UNSET, files=_UNSET):
+        """Issue a treq request and translate its Deferred into API output."""
+        kwargs = {"headers": self._request_headers(), "params": params}
+        if body is not _UNSET and body is not None:
+            kwargs["json"] = body
+        if files is not _UNSET and files is not None:
+            kwargs["files"] = files
+
+        try:
+            request_method = getattr(treq, method.lower())
+            response = yield defer.maybeDeferred(
