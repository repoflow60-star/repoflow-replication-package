+class _Response:
+    """Small synchronous response representation for the compatibility shim."""
+
+    def __init__(self, status_code: int, data: dict | None = None) -> None:
+        self.status_code = status_code
+        self._data = data
+
+    def json(self) -> dict:
+        """Return the decoded response body."""
+        return self._data
+
+
+async def _aiohttp_get(url: str, timeout: int) -> _Response:
+    """Fetch a JSON response with aiohttp."""
+    async with aiohttp.ClientSession() as session:
+        async with session.get(url, timeout=timeout) as response:
+            if response.status != 200:
+                return _Response(response.status)
+            return _Response(response.status, await response.json())
+
+
+def _sync_aiohttp_get(url: str, timeout: int) -> _Response:
+    """Run the aiohttp request while preserving the synchronous API."""
+    return asyncio.run(_aiohttp_get(url, timeout))
+
+
+# Keep a requests-like entry point so callers of the original synchronous API
+# (and integrations that patch ``collector.requests.get``) continue to work.
+# The implementation itself uses aiohttp; requests is not a dependency.
+requests = SimpleNamespace(get=_sync_aiohttp_get)
 
 
