+class Session:
+    """Synchronous facade over :class:`aiohttp.ClientSession`.
+
+    ``Session`` remains a module-level name for compatibility with callers
+    that customize or mock the client's session.  All network I/O is carried
+    out by aiohttp; this facade only bridges it to the library's existing
+    synchronous methods.
+    """
+
+    def __init__(self) -> None:
+        self.headers = {}
+
+    def request(self, method: str, url: str, **arguments: Any) -> _HTTPResponse:
+        return _run_sync(self._request(method, url, **arguments))
+
+    async def _request(
