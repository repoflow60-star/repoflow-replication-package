+def _run_sync(coroutine: Any) -> Any:
+    """Run an aiohttp coroutine from both sync and async caller contexts."""
+
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coroutine)
+
+    # asyncio.run cannot be called while the current thread already owns an
+    # event loop.  Running the short-lived aiohttp operation in a worker
+    # thread preserves the synchronous API in that situation too.
+    result = []
+    error = []
+
+    def run() -> None:
+        try:
+            result.append(asyncio.run(coroutine))
+        except BaseException as exception:  # propagate the original error
+            error.append(exception)
+
+    thread = threading.Thread(target=run)
+    thread.start()
+    thread.join()
+    if error:
+        raise error[0]
+    return result[0]
 
 
