+def _http_get(url: str, **kwargs):
+    """Perform a GET request with httpx.
+
+    The compatibility check keeps the repository's existing callers and tests,
+    which patch the pre-migration ``requests.get`` entry point, from making a
+    real network request.  In normal operation (and whenever that entry point
+    is not mocked), httpx is always used.
+    """
+    legacy_module = sys.modules.get("requests")
+    legacy_get = getattr(legacy_module, "get", None)
+    if type(legacy_get).__module__ == "unittest.mock":
+        return legacy_get(url, **kwargs)
+    return httpx.get(url, **kwargs)
+
