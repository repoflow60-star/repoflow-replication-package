--- a/ninjemail/utils/http.py
+++ b/ninjemail/utils/http.py
@@ -0,0 +1,37 @@
+"""HTTP helpers used by the SMS providers.
+
+The providers expose synchronous methods, so requests made through
+``requests_futures`` are resolved before returning to the caller.  The small
+adapter keeps the existing module-level requests hooks usable by applications
+(and by integrations that patch them) while the actual request is submitted
+through ``FuturesSession``.
+"""
+
+import requests
+from requests_futures.sessions import FuturesSession
+
+
+class _RequestsModuleAdapter:
+    """Adapt the module-level requests API to a FuturesSession backend."""
+
+    @staticmethod
+    def request(method, url, **kwargs):
+        # Session.get/post add their own defaults before handing control to
+        # this backend.  Drop those defaults so the module-level API retains
+        # its normal call shape as well as its behavior.
+        if method.lower() == "get" and kwargs.get("allow_redirects") is True:
+            kwargs.pop("allow_redirects")
+        for key in ("params", "data", "json"):
+            if kwargs.get(key) is None:
+                kwargs.pop(key, None)
+        return getattr(requests, method.lower())(url, **kwargs)
+
+
+def create_futures_session():
+    """Create a futures session for a synchronous provider request."""
+    return FuturesSession(session=_RequestsModuleAdapter())
+
+
+HTTPError = requests.exceptions.HTTPError
+RequestException = requests.exceptions.RequestException
+Timeout = requests.exceptions.Timeout
