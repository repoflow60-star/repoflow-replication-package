+class _Response:
+    """Small response-compatible view of an urllib3 response.
+
+    urllib3 deliberately exposes a lower-level API. Keeping
+    this compatibility view here means the rest of this module can continue
+    to deal with responses returned by injected test sessions as well as
+    responses from the real HTTP session below.
+    """
+
+    def __init__(self, response, url: str, history=None):
+        self._response = response
+        self.url = response.url or url
+        self.history = history or []
+        self.status_code = response.status
+        self.headers = response.headers
+        self.content = response.data
+
+    @property
+    def text(self) -> str:
+        content_type = self.headers.get("Content-Type", "")
+        match = re.search(r"charset=\s*([\w.-]+)", content_type, re.IGNORECASE)
+        encoding = match.group(1) if match else "utf-8"
+        return self.content.decode(encoding, errors="replace")
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise urllib3.exceptions.HTTPError(
+                "HTTP status %s for %s" % (self.status_code, self.url)
+            )
+
+
+class Session:
+    """Cookie-preserving HTTP session backed by urllib3."""
+
+    _MAX_REDIRECTS = 30
+
+    def __init__(self, pool_manager=None):
+        self._pool_manager = (
+            pool_manager if pool_manager is not None else urllib3.PoolManager()
+        )
+        self.cookies = CookieJar()
+
+    def _headers_with_cookies(self, url: str, headers=None):
+        request = Request(url)
+        self.cookies.add_cookie_header(request)
+        request_headers = dict(headers or {})
+        cookie = request.get_header("Cookie")
+        if cookie:
+            request_headers["Cookie"] = cookie
+        return request_headers
+
+    def _save_cookies(self, url: str, response):
+        # urllib3's response.info() provides the email-message-like interface
+        # expected by CookieJar, while Request supplies the request metadata.
+        self.cookies.extract_cookies(response, Request(url))
+
+    def request(self, method: str, url: str, data=None, headers=None, **kwargs):
+        method = method.upper()
+        history = []
+        current_url = url
+
+        for _ in range(self._MAX_REDIRECTS + 1):
+            request_headers = self._headers_with_cookies(current_url, headers)
+            request_kwargs = dict(kwargs)
+            request_kwargs["redirect"] = False
+            if data is not None:
+                request_kwargs["fields"] = data
+                # HTML forms use application/x-www-form-urlencoded, as they
+                # do with a normal HTML form, rather than urllib3's multipart default.
+                request_kwargs["encode_multipart"] = False
+
+            response = self._pool_manager.request(
+                method, current_url, headers=request_headers, **request_kwargs
+            )
+            self._save_cookies(current_url, response)
+            wrapped_response = _Response(response, current_url, history)
+            redirect_location = response.get_redirect_location()
+            if not isinstance(redirect_location, str):
+                return wrapped_response
+
+            history.append(wrapped_response)
+            next_url = urljoin(current_url, redirect_location)
+            if response.status in (301, 302, 303) and method == "POST":
+                method = "GET"
+                data = None
+            current_url = next_url
+
+        raise urllib3.exceptions.MaxRetryError(
+            self._pool_manager, current_url, "too many redirects"
+        )
+
+    def get(self, url: str, **kwargs):
+        return self.request("GET", url, **kwargs)
+
+    def post(self, url: str, data=None, **kwargs):
+        return self.request("POST", url, data=data, **kwargs)
 
 
