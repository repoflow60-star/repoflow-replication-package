+    @staticmethod
+    def _create_client(proxies):
+        """Create an HTTPX client while accepting the legacy proxy mapping."""
+        if proxies is None:
+            return httpx.Client()
+
+        if isinstance(proxies, str):
+            return httpx.Client(proxy=proxies)
+
+        if not isinstance(proxies, Mapping):
+            raise TypeError("proxies must be a proxy URL or a mapping of schemes to proxy URLs")
+
+        mounts = {}
+        for scheme, proxy in proxies.items():
+            if proxy is None:
+                continue
+
+            scheme = str(scheme).lower()
+            if scheme in {"all", "all://"}:
+                schemes = ("http://", "https://")
+            elif scheme in {"http", "http://"}:
+                schemes = ("http://",)
+            elif scheme in {"https", "https://"}:
+                schemes = ("https://",)
+            else:
+                schemes = (scheme if scheme.endswith("://") else f"{scheme}://",)
+
+            for scheme_prefix in schemes:
+                mounts[scheme_prefix] = httpx.HTTPTransport(proxy=proxy)
+
+        return httpx.Client(mounts=mounts)
 
