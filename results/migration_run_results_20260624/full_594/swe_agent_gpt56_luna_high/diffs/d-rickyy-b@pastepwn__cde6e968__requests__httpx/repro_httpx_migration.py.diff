--- a/repro_httpx_migration.py
+++ b/repro_httpx_migration.py
@@ -0,0 +1,32 @@
+"""Verify the request wrapper works with HTTPX when requests is unavailable."""
+import builtins
+import sys
+
+import httpx
+import pastepwn
+
+# Pastepwn's optional Twitter integration imports requests itself. Load the
+# package first so this check is limited to the migrated request utility.
+del sys.modules["pastepwn.util.request"]
+
+original_import = builtins.__import__
+
+
+def import_without_requests(name, *args, **kwargs):
+    if name == "requests" or name.startswith("requests."):
+        raise ModuleNotFoundError("No module named 'requests'")
+    return original_import(name, *args, **kwargs)
+
+
+builtins.__import__ = import_without_requests
+from pastepwn.util.request import Request
+
+Request._instance = None
+Request._initialized = False
+request = Request(headers={"X-Test": "yes"})
+request.session.close()
+request.session = httpx.Client(
+    transport=httpx.MockTransport(lambda sent_request: httpx.Response(200, content=b"ok", request=sent_request)),
+)
+assert request.get("https://example.com") == "ok"
+print("fixed: Request uses HTTPX without importing requests")
