+class _HTTPStatusError(urllib3.exceptions.HTTPError):
+    """HTTP error carrying the response that caused it."""
+
+    def __init__(self, response):
+        self.response = response
+        super().__init__(
+            f'HTTP status {response.status}: {getattr(response, "reason", "")}'
+        )
+
+
+def _raise_for_status(response):
+    """Raise an urllib3 error for an unsuccessful HTTP response.
+
+    urllib3 exposes the response status as ``status`` but does not provide
+    ``raise_for_status`` on ``HTTPResponse``.
+    """
+    if hasattr(response, 'raise_for_status'):
+        # This also keeps custom response objects supplied by callers usable.
+        response.raise_for_status()
+    elif getattr(response, 'status', 0) >= 400:
+        raise _HTTPStatusError(response)
+
+
+class _Urllib3Session:
+    """Small session adapter around urllib3's connection pool.
+
+    urllib3 supplies connection pooling but deliberately does not provide a
+    cookie-aware session.  This adapter keeps cookies between login and
+    subsequent requests and translates the conveniences used by the client
+    (form fields, multipart files, and query parameters).
+    """
+
+    def __init__(self):
+        self._pool = urllib3.PoolManager()
+        self.cookies = {}
+
+    def _url_with_params(self, url, params):
+        if not params:
+            return url
+        query = urlencode(
+            [(key, value) for key, value in params.items() if value is not None],
+            doseq=True,
+        )
+        if not query:
+            return url
+        if '?' not in url:
+            return f'{url}?{query}'
+        separator = '' if url.endswith(('?', '&')) else '&'
+        return f'{url}{separator}{query}'
+
+    def _update_cookies(self, response):
+        getlist = getattr(response.headers, 'getlist', None)
+        set_cookies = getlist('Set-Cookie') if getlist else []
+        if not set_cookies:
+            cookie_header = response.headers.get('Set-Cookie')
+            set_cookies = [cookie_header] if cookie_header else []
+        for header in set_cookies:
+            parsed = SimpleCookie()
+            parsed.load(header)
+            for name, morsel in parsed.items():
+                self.cookies[name] = morsel.value
+
+    def request(self, method, url, data=None, headers=None, files=None,
+                params=None, json=None, **kwargs):
+        headers = dict(headers or {})
+        url = self._url_with_params(url, params)
+        if self.cookies and not any(key.lower() == 'cookie' for key in headers):
+            headers['Cookie'] = '; '.join(
+                f'{name}={value}' for name, value in self.cookies.items()
+            )
+
+        if files is not None:
+            response = self._pool.request_encode_body(
+                method, url, fields=files, headers=headers, **kwargs
+            )
+        elif isinstance(data, Mapping):
+            response = self._pool.request_encode_body(
+                method,
+                url,
+                fields=data,
+                headers=headers,
+                encode_multipart=False,
+                **kwargs,
+            )
+        else:
+            request_kwargs = dict(kwargs)
+            if data is not None:
+                request_kwargs['body'] = data
+            if json is not None:
+                request_kwargs['json'] = json
+            response = self._pool.request(
+                method, url, headers=headers, **request_kwargs
+            )
+        self._update_cookies(response)
+        return response
+
+    def get(self, url, **kwargs):
+        return self.request('GET', url, **kwargs)
+
+    def post(self, url, **kwargs):
+        return self.request('POST', url, **kwargs)
+
+    def put(self, url, **kwargs):
+        return self.request('PUT', url, **kwargs)
+
 
