+# HTTP transport.  aiohttp is asynchronous, while pdpyras intentionally keeps
+# its long-standing synchronous API.  The small adapter below materializes an
+# aiohttp response before returning it to the rest of the client.
+import aiohttp
+
+AIOHTTP_VERSION = aiohttp.__version__
+# Retained for compatibility with clients that inspect the old user-agent
+# format.  The transport itself is now aiohttp (see AIOHTTP_VERSION above).
+REQUESTS_VERSION = '2.34.2'
+
+# These names were historically part of pdpyras' public surface.  Keep them as
+# aliases for aiohttp errors so callers can continue to catch transport errors
+# without requiring requests or urllib3.
+HTTPError = aiohttp.ClientError
+PoolError = aiohttp.ClientConnectionError
+RequestException = aiohttp.ClientError
+
+
+class Response:
+    """Synchronous, requests-compatible view of an aiohttp response."""
+
+    def __init__(self, status_code, body, method, url, headers, elapsed):
+        self.status_code = status_code
+        self.url = url
+        self.headers = headers
+        self.content = body
+        self.text = body.decode('utf-8', errors='replace')
+        self.encoding = 'utf-8'
+        self.elapsed = timedelta(seconds=elapsed)
+        self.request = SimpleNamespace(method=method, url=url)
+        self.ok = status_code < 400
+
+    def json(self, **kwargs):
+        return json.loads(self.text, **kwargs)
+
+
+async def _aiohttp_request(method, url, kwargs):
+    """Perform one request and eagerly read its body inside the event loop."""
+    request_kwargs = dict(kwargs)
+    # ``stream`` is a requests-only option.  Responses are read eagerly because
+    # the public pdpyras methods are synchronous and must outlive this loop.
+    request_kwargs.pop('stream', None)
+    started = time.monotonic()
+    async with aiohttp.ClientSession() as session:
+        async with session.request(method, url, **request_kwargs) as response:
+            body = await response.read()
+            return Response(
+                response.status,
+                body,
+                response.method,
+                str(response.url),
+                dict(response.headers),
+                time.monotonic() - started,
+            )
+
+
+def _run_async(coro):
+    """Run a coroutine from synchronous code, including inside an event loop."""
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coro)
+
+    # asyncio.run cannot be nested.  Running this one blocking operation in a
+    # helper thread keeps the synchronous API usable by applications that call
+    # it from an async callback as well.
+    result = []
+    error = []
+
+    def run():
+        try:
+            result.append(asyncio.run(coro))
+        except BaseException as exc:  # propagate the original transport error
+            error.append(exc)
+
+    thread = threading.Thread(target=run)
+    thread.start()
+    thread.join()
+    if error:
+        raise error[0]
+    return result[0]
+
+
+class _AiohttpSession:
+    """Transport adapter exposing the subset of Session used by PDSession."""
+
+    def request(self, method, url, **kwargs):
+        return _run_async(_aiohttp_request(method, url, kwargs))
+
+    def close(self):
+        # ClientSession instances are deliberately scoped to each request.
+        pass
 
