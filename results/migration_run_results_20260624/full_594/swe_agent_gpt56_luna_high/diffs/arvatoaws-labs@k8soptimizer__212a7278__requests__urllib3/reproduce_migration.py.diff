--- a/reproduce_migration.py
+++ b/reproduce_migration.py
@@ -0,0 +1,16 @@
+"""Reproduce the requests dependency/API usage that must be migrated."""
+import ast
+from pathlib import Path
+
+source = Path("src/k8soptimizer/main.py").read_text()
+tree = ast.parse(source)
+imports_requests = any(
+    isinstance(node, ast.Import)
+    and any(alias.name == "requests" for alias in node.names)
+    for node in ast.walk(tree)
+)
+requirement = Path("requirements.txt").read_text()
+print("requests import:", imports_requests)
+print("requests requirement:", any(line.strip().startswith("requests") for line in requirement.splitlines()))
+assert not imports_requests, "requests is still imported"
+assert "urllib3==2.7.0" in requirement, "urllib3 2.7.0 is not declared"
