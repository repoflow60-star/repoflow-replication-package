+"""Minimal reproduction of the pre-migration HTTP dependency."""
+import filestack.utils as utils
+
+print('requests implementation:', utils.original_requests.__name__)
+print('requests version:', utils.original_requests.__version__)
+print('aiohttp importable:', end=' ')
+try:
+    import aiohttp
+except ImportError as exc:
+    print('no ({}: {})'.format(type(exc).__name__, exc))
+else:
+    print(aiohttp.__version__)
+
+assert utils.original_requests.__name__ == 'requests'
