--- a/kling/http.py
+++ b/kling/http.py
@@ -0,0 +1,132 @@
+"""Small requests-like HTTP facade backed by :mod:`pycurl`.
+
+PycURL intentionally exposes a fairly low-level API.  Keeping the small
+response/session facade here means the rest of the client can continue to
+work with the response operations it actually needs (JSON, text, content,
+and status code) without bringing in a second HTTP implementation.
+"""
+
+from __future__ import annotations
+
+from io import BytesIO
+import json
+from typing import Any, Mapping
+from urllib.parse import urlencode, urlsplit, urlunsplit
+
+import pycurl
+
+
+class CurlResponse:
+    """The portion of a ``requests.Response`` used by the client."""
+
+    def __init__(self, content: bytes, status_code: int, headers: Mapping[str, str]):
+        self.content = content
+        self.status_code = status_code
+        self.headers = dict(headers)
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status_code < 400
+
+    @property
+    def text(self) -> str:
+        return self.content.decode("utf-8", errors="replace")
+
+    def json(self) -> Any:
+        return json.loads(self.content.decode("utf-8"))
+
+
+class CurlSession:
+    """A stateful, cookie and header aware HTTP client implemented with pycurl."""
+
+    def __init__(self) -> None:
+        self.cookies: dict[str, str] = {}
+        self.headers: dict[str, str] = {}
+
+    @staticmethod
+    def _url_with_params(url: str, params: Mapping[str, Any] | None) -> str:
+        if not params:
+            return url
+        parts = urlsplit(url)
+        query = urlencode(params, doseq=True)
+        joined_query = f"{parts.query}&{query}" if parts.query else query
+        return urlunsplit((parts.scheme, parts.netloc, parts.path, joined_query, parts.fragment))
+
+    def request(
+        self,
+        method: str,
+        url: str,
+        *,
+        params: Mapping[str, Any] | None = None,
+        data: Any = None,
+        json_data: Any = None,
+        headers: Mapping[str, str] | None = None,
+    ) -> CurlResponse:
+        body = b""
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        if json_data is not None:
+            body = json.dumps(json_data).encode("utf-8")
+            if not any(key.lower() == "content-type" for key in request_headers):
+                request_headers["Content-Type"] = "application/json"
+        elif data is not None:
+            if isinstance(data, bytes):
+                body = data
+            elif isinstance(data, str):
+                body = data.encode("utf-8")
+            else:
+                body = urlencode(data, doseq=True).encode("utf-8")
+
+        curl = pycurl.Curl()
+        response_buffer = BytesIO()
+        response_headers: dict[str, str] = {}
+
+        def receive_headers(line: bytes) -> None:
+            # Header blocks can contain an interim response (for example
+            # 100 Continue), so simply retain the last value for each header.
+            decoded = line.decode("iso-8859-1", errors="replace").strip()
+            if ":" in decoded:
+                name, value = decoded.split(":", 1)
+                response_headers[name.strip()] = value.strip()
+
+        try:
+            curl.setopt(pycurl.URL, self._url_with_params(url, params))
+            curl.setopt(pycurl.WRITEFUNCTION, response_buffer.write)
+            curl.setopt(pycurl.HEADERFUNCTION, receive_headers)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            curl.setopt(pycurl.HTTPHEADER, [f"{key}: {value}" for key, value in request_headers.items()])
+
+            if self.cookies:
+                cookie_header = "; ".join(f"{key}={value}" for key, value in self.cookies.items())
+                curl.setopt(pycurl.COOKIE, cookie_header)
+
+            if method.upper() == "POST":
+                curl.setopt(pycurl.POST, 1)
+                curl.setopt(pycurl.POSTFIELDS, body)
+            else:
+                curl.setopt(pycurl.HTTPGET, 1)
+
+            curl.perform()
+            status_code = int(curl.getinfo(pycurl.RESPONSE_CODE))
+        finally:
+            curl.close()
+
+        return CurlResponse(response_buffer.getvalue(), status_code, response_headers)
+
+    def get(self, url: str, *, params: Mapping[str, Any] | None = None, headers: Mapping[str, str] | None = None) -> CurlResponse:
+        return self.request("GET", url, params=params, headers=headers)
+
+    def post(
+        self,
+        url: str,
+        *,
+        params: Mapping[str, Any] | None = None,
+        data: Any = None,
+        json: Any = None,
+        headers: Mapping[str, str] | None = None,
+    ) -> CurlResponse:
+        return self.request("POST", url, params=params, data=data, json_data=json, headers=headers)
+
