+class _TreqResponse:
+    """Small synchronous response wrapper used by the existing client API."""
+
+    def __init__(self, status_code: int, content: bytes):
+        self.status_code = status_code
+        self.content = content
+
+
+class _TreqConnectionError(Exception):
+    """A transport error raised while adapting treq's Deferred API."""
+
+
+_reactor_start_lock = threading.Lock()
+_reactor_started = False
+
+
+def _ensure_reactor_running() -> None:
+    """Start a background reactor for the synchronous public API.
+
+    treq is deliberately asynchronous, while ``Client.results`` has always
+    been a synchronous generator.  Keeping the reactor in a daemon thread
+    lets us use treq without changing that public API or trying to restart a
+    reactor for every request.
+    """
+    global _reactor_started
+    if reactor.running:
+        return
+    with _reactor_start_lock:
+        if _reactor_started or reactor.running:
+            return
+        ready = threading.Event()
+
+        def run_reactor() -> None:
+            reactor.callWhenRunning(ready.set)
+            reactor.run(installSignalHandlers=False)
+
+        threading.Thread(target=run_reactor, daemon=True).start()
+        ready.wait()
+        _reactor_started = True
+
+
+def _treq_get(url: str, headers: dict) -> _TreqResponse:
+    """Perform one treq request and wait for its response body."""
+    _ensure_reactor_running()
+    finished = threading.Event()
+    result = {}
+
+    def request() -> None:
+        try:
+            deferred = treq.get(url, headers=headers)
+
+            def read_body(response):
+                body_deferred = treq.content(response)
+                body_deferred.addCallback(
+                    lambda body: _TreqResponse(response.code, body)
+                )
+                return body_deferred
+
+            if hasattr(deferred, "addCallback"):
+                deferred.addCallback(read_body)
+                deferred.addBoth(finish)
+            else:
+                # This is useful for lightweight test doubles and costs
+                # nothing for normal treq operation.
+                finish(_TreqResponse(deferred.code, deferred.content))
+        except BaseException as error:
+            result["error"] = error
+            finished.set()
+
+    def finish(value):
+        if isinstance(value, Failure):
+            result["error"] = value.value
+        else:
+            result["response"] = value
+        finished.set()
+        return None
+
+    reactor.callFromThread(request)
+    finished.wait()
+    if "error" in result:
+        raise _TreqConnectionError() from result["error"]
+    return result["response"]
+
