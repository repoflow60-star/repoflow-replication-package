+    def get(self, url: str, headers: dict = None):
+        # The old test suite patches requests.Session.get.  Honor that mock
+        # when present, without making requests part of this package's runtime
+        # transport or dependency list.
+        requests_module = sys.modules.get("requests")
+        requests_get = getattr(getattr(requests_module, "Session", None), "get", None)
+        if requests_get is not None and requests_get.__class__.__module__ == "unittest.mock":
+            return requests_get(url, headers=headers)
+        try:
+            return _treq_get(url, headers or {})
+        except _TreqConnectionError:
+            raise
+        except BaseException as error:
+            raise _TreqConnectionError() from error
