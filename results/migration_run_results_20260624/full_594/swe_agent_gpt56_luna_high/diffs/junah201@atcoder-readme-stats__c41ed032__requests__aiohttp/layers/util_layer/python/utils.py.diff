+def get_user_data(username: str) -> Optional[UserData]:
+    """Get user data from AtCoder."""
+    coroutine = _get_user_data(username)
+
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coroutine)
+
+    # ``get_user_data`` remains synchronous for the Lambda handlers and for
+    # existing callers.  If a caller already owns an event loop, run the
+    # request in a short-lived worker so that asyncio.run is not nested.
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        return executor.submit(asyncio.run, coroutine).result()
