+def _get_bool_setting(settings: Dynaconf, env_var_name: str, default: bool = False) -> bool:
+    """Return a setting as a boolean using the existing environment semantics."""
+    value = settings.get(env_var_name, "")
+    if value == "" and default:
+        return default
+    if isinstance(value, bool):
+        return value
+    return isinstance(value, str) and value.strip().lower() == "true"
+
