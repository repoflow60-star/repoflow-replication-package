+def _get_int_setting(settings: Dynaconf, env_var_name: str) -> int | None:
+    """Return a setting as an integer, or None when it is missing or invalid."""
+    value = settings.get(env_var_name)
+    if value is None or value == "" or isinstance(value, bool):
+        return None
+    try:
+        return int(value)
+    except (TypeError, ValueError):
+        return None
 
 
