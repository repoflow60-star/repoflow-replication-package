+def _get_settings(load_dotenv: bool = False) -> Dynaconf:
+    """Create a Dynaconf instance for the current environment.
+
+    The project uses unprefixed environment variable names.  A new instance is
+    created for each read so callers (and tests) see changes made to
+    ``os.environ`` after this module is imported.
+    """
+    kwargs = {
+        "envvar_prefix": False,
+        "load_dotenv": load_dotenv,
+    }
+    if load_dotenv:
+        kwargs["DOTENV_PATH_FOR_DYNACONF"] = join(dirname(__file__), ".env")
+    return Dynaconf(**kwargs)
+
 
 
