--- a/jsonschema.py
+++ b/jsonschema.py
@@ -0,0 +1,202 @@
+"""Small compatibility layer for the repository's legacy validation tests.
+
+The schema is intentionally kept as JSON Schema because it is consumed by
+editors.  Runtime validation, however, uses Cerberus.  The public ``validate``
+and ``ValidationError`` names preserve the old test interface while translating
+the subset of JSON Schema emitted by ``gen.py`` to Cerberus rules.
+"""
+
+from __future__ import annotations
+
+from copy import deepcopy
+from typing import Any
+
+from cerberus import Validator
+
+
+class ValidationError(Exception):
+    """Raised when a document does not satisfy the supplied schema."""
+
+    def __init__(self, message: Any = "validation failed") -> None:
+        self.message = message
+        super().__init__(message)
+
+
+class _Validator(Validator):
+    """Cerberus validator with JSON Schema's ``uniqueItems`` rule."""
+
+    rules = dict(Validator.rules, unique={"type": "boolean"})
+
+    def _validate_unique(self, unique: bool, field: str, value: Any) -> None:
+        if unique and len(value) != len({repr(item) for item in value}):
+            self._error(field, "items must be unique")
+
+
+class _SchemaConverter:
+    """Translate the JSON Schema generated by this project to Cerberus."""
+
+    _TYPE_NAMES = {
+        "object": "dict",
+        "array": "list",
+        "string": "string",
+        "integer": "integer",
+        "number": "number",
+        "boolean": "boolean",
+    }
+
+    def __init__(self, schema: dict[str, Any]) -> None:
+        self.root = schema
+
+    def convert(self, schema: dict[str, Any]) -> dict[str, Any]:
+        """Return one Cerberus field rule-set for *schema*."""
+        schema = self._resolve(schema)
+
+        # Pydantic emits allOf around fields whose type is a model.  Retaining
+        # a single member avoids an unnecessary Cerberus allof rule and also
+        # makes nested ``schema`` rules easier to read.
+        if "allOf" in schema:
+            members = [self.convert(member) for member in schema["allOf"]]
+            if len(members) == 1:
+                rules = members[0]
+            else:
+                rules = {"allof": members}
+            return self._add_common_rules(rules, schema)
+
+        if "oneOf" in schema:
+            rules = {"oneof": [self.convert(member) for member in schema["oneOf"]]}
+            return self._add_common_rules(rules, schema)
+
+        if "anyOf" in schema:
+            rules = {"anyof": [self.convert(member) for member in schema["anyOf"]]}
+            return self._add_common_rules(rules, schema)
+
+        rules: dict[str, Any] = {}
+        schema_type = schema.get("type")
+        if isinstance(schema_type, list):
+            rules["anyof"] = [self.convert({"type": item}) for item in schema_type]
+        elif schema_type == "null":
+            # Cerberus has no null type rule. ``allowed`` is exact for None,
+            # unlike ``nullable`` which would also permit another type.
+            rules["allowed"] = [None]
+        elif schema_type in self._TYPE_NAMES:
+            rules["type"] = self._TYPE_NAMES[schema_type]
+
+        if schema_type == "object" or "properties" in schema:
+            rules.update(self._object_rules(schema))
+        elif schema_type == "array" or "items" in schema:
+            rules.update(self._array_rules(schema))
+        elif schema_type == "string" or "pattern" in schema:
+            if "pattern" in schema:
+                rules["regex"] = schema["pattern"]
+            for json_name, cerberus_name in (
+                ("minLength", "minlength"),
+                ("maxLength", "maxlength"),
+            ):
+                if json_name in schema:
+                    rules[cerberus_name] = schema[json_name]
+
+        if "enum" in schema:
+            rules["allowed"] = schema["enum"]
+        if "const" in schema:
+            rules["allowed"] = [schema["const"]]
+
+        return self._add_common_rules(rules, schema)
+
+    def _resolve(self, schema: dict[str, Any]) -> dict[str, Any]:
+        ref = schema.get("$ref")
+        if not ref:
+            return schema
+        if not ref.startswith("#/definitions/"):
+            raise ValueError(f"unsupported schema reference: {ref}")
+        name = ref.rsplit("/", 1)[-1]
+        resolved = self.root["definitions"][name]
+        # A reference can be accompanied by metadata.  Preserve constraints
+        # from the outer schema while using the definition as its base.
+        result = deepcopy(resolved)
+        result.update({key: value for key, value in schema.items() if key != "$ref"})
+        return result
+
+    def _object_rules(self, schema: dict[str, Any]) -> dict[str, Any]:
+        rules: dict[str, Any] = {}
+        properties = schema.get("properties", {})
+        if properties:
+            rules["schema"] = {
+                name: self._required(self.convert(field), name in schema.get("required", []))
+                for name, field in properties.items()
+            }
+
+        additional = schema.get("additionalProperties", True)
+        if additional is False:
+            rules["allow_unknown"] = False
+        elif additional is True:
+            rules["allow_unknown"] = True
+        else:
+            rules["allow_unknown"] = self.convert(additional)
+
+        # This is needed for schemas which disallow additional properties but
+        # permit names matching patternProperties.
+        patterns = schema.get("patternProperties", {})
+        if patterns and additional is False:
+            pattern_rules = list(patterns)
+            if len(pattern_rules) == 1:
+                rules["keysrules"] = {"regex": pattern_rules[0]}
+
+        return rules
+
+    def _array_rules(self, schema: dict[str, Any]) -> dict[str, Any]:
+        rules: dict[str, Any] = {}
+        if "items" in schema and isinstance(schema["items"], dict):
+            rules["schema"] = self.convert(schema["items"])
+        if schema.get("uniqueItems"):
+            rules["unique"] = True
+        return rules
+
+    @staticmethod
+    def _required(rules: dict[str, Any], required: bool) -> dict[str, Any]:
+        if required:
+            rules = dict(rules)
+            rules["required"] = True
+        return rules
+
+    @staticmethod
+    def _add_common_rules(
+        rules: dict[str, Any], schema: dict[str, Any]
+    ) -> dict[str, Any]:
+        # JSON Schema's default is informational and must not make a field
+        # required, so it is deliberately not translated.
+        if schema.get("nullable"):
+            rules = dict(rules)
+            rules["nullable"] = True
+        return rules
+
+
+def validate(instance: Any, schema: dict[str, Any], *args: Any, **kwargs: Any) -> None:
+    """Validate *instance* with Cerberus using a JSON Schema document.
+
+    ``schema`` is accepted positionally as well as by keyword to match the
+    commonly used ``jsonschema.validate`` call signature.  Extra arguments are
+    accepted for compatibility, although this repository does not use them.
+    """
+    del args, kwargs
+    try:
+        rules = _SchemaConverter(schema).convert(schema)
+        if rules.get("type") == "dict":
+            # Validator receives the fields of a document as its schema;
+            # ``type``/``schema`` are field rules only for nested dicts.
+            validator = _Validator(
+                rules.get("schema", {}),
+                allow_unknown=rules.get("allow_unknown", True),
+            )
+        else:
+            # The generated repository schema has an object root.  Keep a
+            # useful failure mode for callers that provide another root type.
+            raise ValidationError("Cerberus documents must be mappings")
+        if not validator.validate(instance):
+            raise ValidationError(validator.errors)
+    except ValidationError:
+        raise
+    except Exception as exc:
+        # Cerberus reports invalid documents and schema issues with several
+        # exception classes.  The old API exposed one validation exception to
+        # callers, so keep that boundary stable.
+        raise ValidationError(str(exc)) from exc
