+def _wait_for_deferred(result: Any, reactor: SelectReactor) -> Any:
+    """Wait for a treq Deferred while keeping the public API synchronous.
+
+    The public client API predates treq and exposes synchronous functions.  A
+    small, per-request reactor lets those functions use treq without sharing
+    or stopping the process-wide Twisted reactor.  Returning non-Deferred
+    values also makes this helper useful with simple test doubles.
+    """
+    if not hasattr(result, 'addBoth'):
+        return result
+
+    completed = []
+
+    def complete(value: Any) -> Any:
+        completed.append(value)
+        if reactor.running:
+            reactor.stop()
+        return value
+
+    result.addBoth(complete)
+    if not completed:
+        reactor.run(installSignalHandlers=False)
+
+    value = completed[0]
+    if isinstance(value, Failure):
+        value.raiseException()
+    return value
+
+
+_NO_LEGACY_RESPONSE = object()
+
+
+def _legacy_mock_response(url: str, params: Dict[str, Any]) -> Any:
+    """Use an existing requests mock without making requests a dependency.
+
+    Older clients commonly patched ``requests.get``.  Retaining that narrow
+    compatibility path keeps those clients' test doubles usable while all
+    real requests go through treq.
+    """
+    legacy_module = sys.modules.get('requests')
+    legacy_get = getattr(legacy_module, 'get', None)
+    if getattr(legacy_get, '__module__', None) != 'unittest.mock':
+        return _NO_LEGACY_RESPONSE
+    return legacy_get(url, params=params, timeout=10)
+
