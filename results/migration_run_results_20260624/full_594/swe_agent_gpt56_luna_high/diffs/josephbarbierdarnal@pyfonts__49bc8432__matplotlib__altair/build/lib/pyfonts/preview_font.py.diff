--- a/build/lib/pyfonts/preview_font.py
+++ b/build/lib/pyfonts/preview_font.py
@@ -0,0 +1,50 @@
+from typing import Any, Optional
+
+import altair as alt
+
+from .main import load_font
+
+
+def _font_family(font: Any) -> str:
+    """Get the family name accepted by Altair's text mark."""
+    if hasattr(font, "get_name"):
+        return font.get_name()
+    return str(font)
+
+
+def preview_font(
+    font_url: Optional[str] = None,
+    font_path: Optional[str] = None,
+) -> alt.Chart:
+    """Build an Altair chart that previews a font.
+
+    Altair accepts a font family name on a text mark.  The returned chart is
+    intentionally not shown automatically, allowing callers to render it in
+    a notebook, save it, or call ``chart.show()`` themselves.
+    """
+    font = load_font(font_url, font_path)
+    data = {
+        "values": [
+            {
+                "text": "Hello, World From PyFonts!",
+                "size": 30,
+                "x": 0.5,
+                "y": 0.5,
+            },
+            {"text": "This is a test.", "size": 25, "x": 0.5, "y": 0.35},
+            {"text": "How about this?", "size": 20, "x": 0.5, "y": 0.65},
+        ]
+    }
+
+    return (
+        alt.Chart(data)
+        .mark_text(font=_font_family(font), align="center", baseline="middle")
+        .encode(
+            x=alt.X("x:Q", axis=None, scale=alt.Scale(domain=[0, 1])),
+            y=alt.Y("y:Q", axis=None, scale=alt.Scale(domain=[0, 1])),
+            text="text:N",
+            size=alt.Size("size:Q", scale=None, legend=None),
+        )
+        .properties(width=1000, height=500)
+        .configure_view(stroke=None)
+    )
