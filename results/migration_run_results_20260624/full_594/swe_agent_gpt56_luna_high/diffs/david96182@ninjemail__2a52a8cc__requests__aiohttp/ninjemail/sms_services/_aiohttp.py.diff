--- a/ninjemail/sms_services/_aiohttp.py
+++ b/ninjemail/sms_services/_aiohttp.py
@@ -0,0 +1,68 @@
+"""Small synchronous bridge for the asynchronous :mod:`aiohttp` client.
+
+The SMS providers are used by the Selenium workflows, which are synchronous.
+Keeping the bridge here lets those public APIs stay synchronous while all HTTP
+I/O is performed through aiohttp and its async context managers.
+"""
+
+import asyncio
+from concurrent.futures import ThreadPoolExecutor
+from typing import Any, Awaitable, Callable
+
+import aiohttp
+
+
+def run(coro_factory: Callable[..., Awaitable[Any]], *args: Any, **kwargs: Any) -> Any:
+    """Run an aiohttp coroutine from the providers' synchronous API.
+
+    ``asyncio.run`` cannot be called from a thread that already owns a running
+    event loop (for example, when a provider is used by an async application).
+    In that case the short-lived coroutine is run in a worker thread instead.
+    """
+
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coro_factory(*args, **kwargs))
+
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        return executor.submit(
+            asyncio.run, coro_factory(*args, **kwargs)
+        ).result()
+
+
+async def get_json(url: str, **kwargs: Any) -> Any:
+    """Make a GET request and decode its JSON response."""
+
+    async with aiohttp.ClientSession() as session:
+        async with session.get(url, **kwargs) as response:
+            response.raise_for_status()
+            return await response.json()
+
+
+async def get_text_and_json(url: str, **kwargs: Any) -> tuple[str, Any]:
+    """Make a GET request and return both the text and JSON response bodies."""
+
+    async with aiohttp.ClientSession() as session:
+        async with session.get(url, **kwargs) as response:
+            response.raise_for_status()
+            text = await response.text()
+            return text, await response.json()
+
+
+async def post_text(url: str, **kwargs: Any) -> str:
+    """Make a POST request and decode its text response."""
+
+    async with aiohttp.ClientSession() as session:
+        async with session.post(url, **kwargs) as response:
+            response.raise_for_status()
+            return await response.text()
+
+
+async def post_json(url: str, **kwargs: Any) -> Any:
+    """Make a POST request and decode its JSON response."""
+
+    async with aiohttp.ClientSession() as session:
+        async with session.post(url, **kwargs) as response:
+            response.raise_for_status()
+            return await response.json()