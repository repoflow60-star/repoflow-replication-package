+def _run(coroutine: Coroutine[Any, Any, _T]) -> _T:
+    """Run an aiohttp coroutine from the synchronous REST API.
+
+    The normal synchronous API can use ``asyncio.run`` directly.  A caller may,
+    however, use it from a thread that already has a running event loop (for
+    example, from an async application).  asyncio does not permit nesting event
+    loops, so run the request in a short-lived worker thread in that case.
+    """
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coroutine)
+
+    result: List[_T] = []
+    error: List[BaseException] = []
+
+    def run_in_thread() -> None:
+        try:
+            result.append(asyncio.run(coroutine))
+        except BaseException as err:  # Re-raise the original request exception.
+            error.append(err)
+
+    thread = threading.Thread(target=run_in_thread)
+    thread.start()
+    thread.join()
+
+    if error:
+        raise error[0]
+    return result[0]
 
 
