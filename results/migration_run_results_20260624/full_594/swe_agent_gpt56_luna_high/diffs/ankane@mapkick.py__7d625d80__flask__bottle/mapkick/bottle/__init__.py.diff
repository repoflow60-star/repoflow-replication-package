--- a/mapkick/bottle/__init__.py
+++ b/mapkick/bottle/__init__.py
@@ -0,0 +1,128 @@
+"""Bottle integration for Mapkick."""
+
+import json
+import os
+import re
+import secrets
+
+try:
+    from bottle import Bottle, static_file
+except ImportError:  # Keep map classes importable before dependencies are installed.
+    Bottle = None
+    static_file = None
+
+
+static_folder = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', 'django', 'static'))
+
+
+def _json_dumps(value):
+    """Serialize values safely for use inside a script element."""
+    return (json.dumps(value)
+            .replace('<', '\\u003c')
+            .replace('>', '\\u003e')
+            .replace('&', '\\u0026')
+            .replace('\u2028', '\\u2028')
+            .replace('\u2029', '\\u2029'))
+
+
+def _html_escape(value):
+    # Match MarkupSafe's escaping used by the former integration without
+    # adding another framework-specific dependency.
+    return (str(value)
+            .replace('&', '&amp;')
+            .replace('<', '&lt;')
+            .replace('>', '&gt;')
+            .replace('\"', '&#34;')
+            .replace("'", '&#39;'))
+
+
+# Bottle does not have Flask's Blueprint abstraction.  A small Bottle app is
+# used instead and can be mounted on the application's root path.
+if Bottle is not None:
+    mapkick_app = Bottle()
+
+    @mapkick_app.route('/static/mapkick/<filename:path>')
+    def mapkick_static(filename):
+        return static_file(filename, root=static_folder)
+else:
+    mapkick_app = None
+
+# These aliases make the integration convenient to mount and preserve the
+# name used by the previous web-framework integration where possible.
+mapkick_bottle = mapkick_app
+mapkick = mapkick_app
+mapkick_blueprint = mapkick_app
+app = mapkick_app
+
+
+class BaseMap:
+    def __init__(self, type, data, **options):
+        # Important: check escaping before making configurable.
+        element_id = 'map-' + secrets.token_hex(16)
+
+        height = str(options.pop('height', '500px'))
+        width = str(options.pop('width', '100%'))
+
+        for (key, value) in [('height', height), ('width', width)]:
+            # Limit to alphanumeric and % for simplicity.  This prevents
+            # values such as calc() from being used as CSS.
+            if not re.match('^[a-zA-Z0-9%.]*$', value):
+                raise ValueError('Invalid ' + key)
+
+        loading = _html_escape(options.get('loading', 'Loading...'))
+        html_content = (
+            '<div id="{element_id}" style="height: {height}; width: {width};">'
+            '<div style="height: {height}; text-align: center; color: #999; '
+            'line-height: {height}; font-size: 14px; font-family: '
+            "'Lucida Grande', 'Lucida Sans Unicode', Verdana, Arial, Helvetica, sans-serif;\">"
+            '{loading}</div></div>'
+        ).format(element_id=element_id, height=height, width=width, loading=loading)
+
+        access_token = options.pop(
+            'access_token',
+            options.pop('accessToken', os.environ.get('MAPBOX_ACCESS_TOKEN'))
+        )
+        if access_token is not None:
+            if access_token.startswith('sk.'):
+                raise ValueError('Expected public access token')
+            elif not access_token.startswith('pk.'):
+                raise ValueError('Invalid access token')
+            options['accessToken'] = access_token
+
+        js_vars = {
+            'type': type,
+            'id': element_id,
+            'data': data,
+            'options': options
+        }
+        js = """<script>
+  (function() {
+    var createMap = function() {
+      var o = %s;
+      new Mapkick[o.type](o.id, o.data, o.options);
+    };
+    if ("Mapkick" in window) {
+      createMap();
+    } else {
+      window.addEventListener("mapkick:load", createMap, true);
+    }
+  })();
+</script>""" % _json_dumps(js_vars)
+
+        self.__str = html_content + js
+
+    def __str__(self):
+        return self.__str
+
+    def __html__(self):
+        return self.__str
+
+
+class Map(BaseMap):
+    def __init__(self, data, **options):
+        super().__init__('Map', data, **options)
+
+
+class AreaMap(BaseMap):
+    def __init__(self, data, **options):
+        super().__init__('AreaMap', data, **options)
