+_reactor_start_lock = threading.Lock()
+_reactor_thread = None
+_reactor_started = threading.Event()
+
+
+def _ensure_reactor_running():
+    """Start treq's reactor once when Certbot is used synchronously."""
+    global _reactor_thread
+    if _default_reactor.running:
+        return
+    with _reactor_start_lock:
+        if _default_reactor.running:
+            return
+        if _reactor_thread is None or not _reactor_thread.is_alive():
+            _reactor_started.clear()
+
+            def run_reactor():
+                _reactor_started.set()
+                _default_reactor.run(installSignalHandlers=False)
+
+            _reactor_thread = threading.Thread(
+                target=run_reactor,
+                name="infomaniak-treq-reactor",
+                daemon=True,
+            )
+            _reactor_thread.start()
+    _reactor_started.wait()
+
+
+class _TreqSession:
+    """Small session-like container for treq request defaults.
+
+    ``treq`` does not expose a requests-style ``Session``.  Keeping the
+    headers and mounted transports together here gives the API client one
+    place to hold request configuration without bringing requests back as a
+    runtime dependency.  ``mount`` is intentionally supported for backwards
+    compatibility with callers that use a requests-mock adapter.
+    """
+
+    def __init__(self):
+        self.headers = {}
+        self.adapters = {}
+
+    def mount(self, prefix, adapter):
+        self.adapters[prefix] = adapter
+
