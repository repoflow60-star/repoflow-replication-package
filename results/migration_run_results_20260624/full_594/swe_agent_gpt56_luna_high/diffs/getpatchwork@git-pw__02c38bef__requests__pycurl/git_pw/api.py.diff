+def _encode_params(
+    url: str,
+    params: ty.Optional[Filters],
+) -> str:
+    """Append request parameters to *url* using curl-compatible encoding."""
+    if not params:
+        return url
+
+    # Omit parameters whose value is None rather than sending the literal
+    # string "None".
+    encoded = urlencode(
+        [(key, value) for key, value in params if value is not None],
+        doseq=True,
+    )
+    if not encoded:
+        return url
+
+    parts = urlsplit(url)
+    query = '&'.join(filter(None, (parts.query, encoded)))
+    return urlunsplit(
+        (parts.scheme, parts.netloc, parts.path, query, parts.fragment)
+    )
+
+
+def _request(
+    method: str,
+    url: str,
+    *,
+    params: ty.Optional[Filters] = None,
+    data: ty.Optional[ty.List[ty.Tuple[str, ty.Any]]] = None,
+) -> Response:
+    """Execute one HTTP request using pycurl."""
+    url = _encode_params(url, params)
+    body = io.BytesIO()
+    response_headers: ty.Dict[str, str] = {}
+
+    def header_callback(raw_header: bytes) -> int:
+        # A redirect or an interim 1xx response starts a new header block.
+        # Keep only the headers belonging to the final response.
+        header = raw_header.decode('latin-1').rstrip('\r\n')
+        if header.startswith('HTTP/'):
+            response_headers.clear()
+        elif ':' in header:
+            name, value = header.split(':', 1)
+            response_headers[name.strip().lower()] = value.strip()
+        return len(raw_header)
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.HTTPGET, method == 'GET')
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, header_callback)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        # Ask libcurl to negotiate and transparently decode supported
+        # compression formats, as a high-level HTTP client would.
+        curl.setopt(pycurl.ACCEPT_ENCODING, '')
+
+        headers = _get_headers()
+        auth = _get_auth(optional=method == 'GET')
+        if auth:
+            if auth[0] == 'token':
+                headers['Authorization'] = 'Token {}'.format(auth[1])
+            else:
+                username, password = auth[1]
+                curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+                curl.setopt(pycurl.USERPWD, '{}:{}'.format(username, password))
+
+        if data is not None:
+            # Encode a list of form fields, including repeated fields, as
+            # application/x-www-form-urlencoded data.
+            curl.setopt(pycurl.POSTFIELDS, urlencode(data, doseq=True))
+            headers.setdefault(
+                'Content-Type', 'application/x-www-form-urlencoded'
+            )
+
+        if method == 'POST':
+            curl.setopt(pycurl.POST, True)
+        elif method not in ('GET', 'POST'):
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+        curl.setopt(
+            pycurl.HTTPHEADER,
+            ['{}: {}'.format(name, value) for name, value in headers.items()],
+        )
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+
+    return Response(body.getvalue(), status_code, response_headers)
+
