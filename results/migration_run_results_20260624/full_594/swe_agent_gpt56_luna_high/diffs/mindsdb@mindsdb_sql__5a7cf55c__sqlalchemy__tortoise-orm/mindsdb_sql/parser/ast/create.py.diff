+def _type_name(column_type):
+    """Return a SQL type name from a string or an ORM field type.
+
+    Tortoise fields are classes/instances rather than SQLAlchemy type objects,
+    so checking inheritance against SQLAlchemy's type hierarchy is not
+    possible (or desirable) here.
+    """
+    if isinstance(column_type, str):
+        return column_type
+
+    name = getattr(column_type, "__name__", column_type.__class__.__name__).upper()
+    names = {
+        "INTFIELD": "int",
+        "BIGINTFIELD": "bigint",
+        "SMALLINTFIELD": "smallint",
+        "FLOATFIELD": "float",
+        "DECIMALFIELD": "decimal",
+        "CHARFIELD": "varchar",
+        "TEXTFIELD": "text",
+        "DATEFIELD": "date",
+        "DATETIMEFIELD": "datetime",
+        "TIMEDELTAFIELD": "interval",
+        "BOOLEANFIELD": "boolean",
+        "JSONFIELD": "json",
+    }
+    return names.get(name, str(column_type))
 
 
