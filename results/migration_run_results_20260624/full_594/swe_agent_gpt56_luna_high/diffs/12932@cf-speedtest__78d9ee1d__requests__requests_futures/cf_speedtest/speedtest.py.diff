+def _get_response(request):
+    """Return the response from a requests-futures request.
+
+    The production session returns a ``Future``, while accepting a response
+    directly keeps the session easy to substitute in callers and tests.
+    """
+    if isinstance(request, Future):
+        return request.result()
+    return request
+
+
+def _request(method, *args, **kwargs):
+    return _get_response(getattr(REQ_SESSION, method)(*args, **kwargs))
 
