+
+class _AiohttpResponse:
+    """Small synchronous response facade used by the existing public API."""
+
+    def __init__(self, payload: Any):
+        self._payload = payload
+
+    def raise_for_status(self):
+        """Keep the response interface used by :class:`Questrade`."""
+
+    def json(self):
+        """Return the already decoded JSON payload."""
+        return self._payload
+
+
+async def _request_json(
+    method: str,
+    url: str,
+    headers: Optional[Dict[str, str]] = None,
+    params: Optional[Dict] = None,
+    data: Optional[Dict] = None,
+    json: Optional[Dict] = None,
+) -> Any:
+    """Make one request with aiohttp and decode its JSON response."""
+    async with aiohttp.ClientSession(headers=headers) as session:
+        async with session.request(
+            method.upper(),
+            url,
+            params=params,
+            data=data,
+            json=json,
+            timeout=30,
+        ) as response:
+            response.raise_for_status()
+            return await response.json()
+
+
+def _run(coroutine):
+    """Run an aiohttp coroutine from the package's synchronous API.
+
+    The original qtrade API is synchronous.  ``aiohttp`` is asynchronous, so requests are
+    executed in a short-lived event loop while retaining that API.  If a caller already has a
+    running event loop (for example, a notebook), the coroutine is run in a worker thread instead
+    of attempting to nest event loops.
+    """
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coroutine)
+
+    result = []
+    error = []
+
+    def run_in_thread():
+        try:
+            result.append(asyncio.run(coroutine))
+        except BaseException as exc:  # propagate the original exception to the caller
+            error.append(exc)
+
+    thread = threading.Thread(target=run_in_thread)
+    thread.start()
+    thread.join()
+    if error:
+        raise error[0]
+    return result[0]
+
+
+class _AiohttpSession:
+    """Synchronous session facade backed exclusively by aiohttp."""
+
+    def __init__(self):
+        self.headers: Dict[str, str] = {}
+
+    def request(
+        self,
+        method: str,
+        url: str,
+        params: Optional[Dict] = None,
+        data: Optional[Dict] = None,
+        json: Optional[Dict] = None,
+        timeout: Optional[int] = None,
+    ) -> _AiohttpResponse:
+        del timeout  # The aiohttp adapter applies the package-wide timeout.
+        payload = _run(
+            _request_json(
+                method,
+                url,
+                headers=self.headers,
+                params=params,
+                data=data,
+                json=json,
+            )
+        )
+        return _AiohttpResponse(payload)
+
+    def get(self, url: str, **kwargs) -> _AiohttpResponse:
+        return self.request("get", url, **kwargs)
+
+    def post(self, url: str, **kwargs) -> _AiohttpResponse:
+        return self.request("post", url, **kwargs)
+
+    def close(self):
+        """Close the logical session (individual aiohttp sessions are request-scoped)."""
+
 
