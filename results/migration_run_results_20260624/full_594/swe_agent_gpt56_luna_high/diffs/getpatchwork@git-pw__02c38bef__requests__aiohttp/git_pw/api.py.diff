+class _Response:
+    """Small synchronous response facade for an eagerly-read aiohttp response.
+
+    The command modules have a synchronous API, while aiohttp responses are
+    tied to the event loop and client session that created them.  Reading the
+    body before closing the session lets us retain the existing synchronous
+    API without leaking sessions or event loops.
+    """
+
+    def __init__(self, content: bytes, status_code: int, headers):
+        self.content = content
+        self.status_code = status_code
+        self.headers = headers
+
+    def json(self):
+        return json.loads(self.content)
+
+    def iter_content(self, chunk_size: int):
+        for offset in range(0, len(self.content), chunk_size):
+            yield self.content[offset : offset + chunk_size]
+
+
+class _RequestError(aiohttp.ClientError):
+    """An aiohttp error carrying the response facade used by error handling."""
+
+    def __init__(self, response: _Response):
+        super().__init__(
+            'HTTP status {}'.format(response.status_code),
+        )
+        self.response = response
+
+
+def _run(coro):
+    """Run one HTTP coroutine from the synchronous command interface."""
+    return asyncio.run(coro)
+
+
+async def _request(
+    method: str,
+    url: str,
+    params: ty.Optional[Filters] = None,
+    data: ty.Optional[ty.List[ty.Tuple[str, ty.Any]]] = None,
+) -> _Response:
+    """Make a request with aiohttp and return a session-independent
+    response.
+    """
+    auth = _get_auth(optional=method == 'GET')
+    headers = _get_headers()
+
+    # Omit None values explicitly: the previous client omitted them while
+    # aiohttp rejects them.
+    request_params = [
+        (key, value) for key, value in (params or []) if value is not None
+    ]
+
+    async with aiohttp.ClientSession(auth=auth, headers=headers) as session:
+        async with session.request(
+            method,
+            url,
+            params=request_params,
+            data=data,
+        ) as response:
+            content = await response.read()
+            result = _Response(content, response.status, response.headers)
+            if response.status >= 400:
+                raise _RequestError(result)
+            return result
+
