+class _AppendOption(argparse.Action):
+    """Collect values when an option is supplied more than once."""
+
+    def __call__(self, parser, namespace, value, option_string=None):
+        values = getattr(namespace, self.dest, None)
+        if values is None:
+            values = []
+        values.append(value)
+        setattr(namespace, self.dest, values)
+
+
+def _configure_parser():
+    """Preserve the repeated-option behavior of the previous CLI."""
+    parser = plac.parser_from(cli)
+    for option in ("extras", "deps"):
+        action = parser._option_string_actions[f"--{option}"]
+        action.__class__ = _AppendOption
+
+
+# ``plac`` parses arguments at the application boundary.  Keeping the parser
+# entry point separate from the implementation also makes the function useful
+# to callers that want to invoke it directly.
+_configure_parser()
+
+
+def main():
+    """Parse command-line arguments and run :func:`cli`."""
+    return plac.call(cli)
+
+
+# A small ``main`` adapter on the function keeps compatibility with callers
+# that invoke the command through a runner object.
+def _runner_main(args=None, **_kwargs):
+    if args is None:
+        args = sys.argv[1:]
+    return plac.call(cli, arglist=list(args))
+
+
+cli.main = _runner_main
