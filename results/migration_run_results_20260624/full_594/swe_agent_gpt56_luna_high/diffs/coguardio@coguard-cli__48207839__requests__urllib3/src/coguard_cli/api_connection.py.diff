+import urllib3
 
 from coguard_cli.auth.token import Token
+
+http = urllib3.PoolManager()
+
+def _http_request(method, url, **kwargs):
+    """Send a request through urllib3 using the call shape used by this module."""
+    headers = dict(kwargs.pop("headers", {}) or {})
+    if "json" in kwargs:
+        kwargs["body"] = json.dumps(kwargs.pop("json"))
+        if not any(key.lower() == "content-type" for key in headers):
+            headers["Content-Type"] = "application/json"
+    if "data" in kwargs:
+        kwargs["body"] = kwargs.pop("data")
+    if kwargs.pop("stream", False):
+        kwargs["preload_content"] = False
+    if headers:
+        kwargs["headers"] = headers
+    return http.request(method, url, **kwargs)
+
+def _response_json(response):
+    """Decode a JSON response returned by urllib3."""
+    data = response.data
+    return json.loads(data.decode("utf-8") if isinstance(data, bytes) else data)
+
+def _response_text(response):
+    """Decode response bytes using UTF-8."""
+    data = response.data
+    return data.decode("utf-8") if isinstance(data, bytes) else data
+
+def _raise_for_status(response):
+    """Raise for HTTP errors."""
+    if hasattr(response, "raise_for_status"):
+        response.raise_for_status()
+    elif response.status >= 400:
+        raise urllib3.exceptions.HTTPError(
+            "HTTP {} returned by the server".format(response.status)
+        )
+
+def _iter_response_content(response, chunk_size):
+    """Yield chunks from an unbuffered urllib3 response."""
+    return response.stream(chunk_size)
+
