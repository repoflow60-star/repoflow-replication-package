+            data = response.json()
+        else:
+            data = response.text
+
+        # httpx exposes json() and text as synchronous properties.  Awaiting
+        # an awaitable here also supports legacy async response adapters.
+        if inspect.isawaitable(data):
+            data = await data
+    except Exception as e:
+        raise ConnectionError(f"Error occurred while getting response from url {url}: {e}")
