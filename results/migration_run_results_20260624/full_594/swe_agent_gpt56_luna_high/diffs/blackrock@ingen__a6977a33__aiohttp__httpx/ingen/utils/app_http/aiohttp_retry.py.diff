+async def _make_http_response(response, url):
+    """Convert an httpx response into the public ``HTTPResponse`` value."""
+    logger.info(f"awaiting response for {url}")
+
+    try:
+        status = getattr(response, 'status_code', None)
+        # ``status_code`` is the httpx attribute.  The fallback is useful for
+        # response adapters that expose the older ``status`` spelling.
+        if not isinstance(status, int):
+            status = response.status
+        headers = response.headers
+
