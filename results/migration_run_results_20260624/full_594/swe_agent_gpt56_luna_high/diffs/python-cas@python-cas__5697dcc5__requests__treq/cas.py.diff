+def _is_deferred(value):
+    """Return whether *value* is a Twisted Deferred.
+
+    ``treq`` is asynchronous, while the ``session`` argument has historically
+    accepted requests-like objects.  Keeping this check in one place lets
+    callers continue to use a synchronous custom session and also supports the
+    Deferreds returned by treq.
+    """
+    return isinstance(value, Deferred)
+
+
+def _response_status(response):
+    """Get an HTTP status from either a requests or treq response."""
+    return getattr(response, 'status_code', getattr(response, 'code', None))
+
+
+def _response_body(response):
+    """Get a response body from either a requests or treq response."""
+    content = response.content
+    return content() if callable(content) else content
+
+
+def _close_response(response):
+    """Close requests responses; treq responses have no close method."""
+    close = getattr(response, 'close', None)
+    if close is not None:
+        close()
+
+
+def _read_response(response):
+    """Read and close a response, returning a value or a Deferred."""
+    body = _response_body(response)
+    if _is_deferred(body):
+        def close_response(result):
+            _close_response(response)
+            return result
+
+        body.addBoth(close_response)
+        return body
+
+    _close_response(response)
+    return body
+
+
+def _session_request(session, method, url, *args, **kwargs):
+    """Call a requests-like or treq session.
+
+    ``verify`` and ``stream`` are requests options and are not accepted by
+    treq.  The default session below handles TLS verification when it is
+    constructed, so those options must not be forwarded to treq.
+    """
+    is_treq = (getattr(session, '_is_treq_session', False) is True or
+               isinstance(session, treq.client.HTTPClient) or
+               session is treq)
+    if is_treq:
+        kwargs.pop('verify', None)
+        kwargs.pop('stream', None)
+    return getattr(session, method)(url, *args, **kwargs)
+
+
+class _TreqSession(object):
+    """Small requests-session-compatible facade backed by treq."""
+
+    _is_treq_session = True
+
+    def __init__(self, verify_ssl_certificate=True):
+        from twisted.internet import reactor
+        from twisted.web.client import Agent
+
+        if verify_ssl_certificate:
+            agent = Agent(reactor)
+        else:
+            from twisted.internet import ssl
+            agent = Agent(reactor, contextFactory=ssl.CertificateOptions(verify=False))
+        self._client = treq.client.HTTPClient(agent)
+
+    def get(self, url, **kwargs):
+        return self._client.get(url, **kwargs)
+
+    def post(self, url, data=None, **kwargs):
+        return self._client.post(url, data=data, **kwargs)
 
