+class KlingFuturesSession(FuturesSession):
+    """A futures session that keeps the existing requests session contract.
+
+    ``requests-futures`` normally delegates to ``Session.request``.  Keeping
+    the underlying session here lets callers continue to provide/configure a
+    normal requests session while each request is still scheduled by the
+    futures executor.
+    """
+
+    def __init__(self) -> None:
+        # Supplying the session also keeps the session easy to configure and
+        # preserves compatibility with code that patches requests.Session.
+        super().__init__(session=requests.Session())
+
+    def request(self, method, url, **kwargs):
+        # Use the underlying high-level method so custom Session subclasses
+        # retain their normal behaviour.  Keep the wrapper's mutable headers
+        # and cookies in sync with that session.
+        headers = self.headers.copy()
+        headers.update(kwargs.get("headers") or {})
+        kwargs["headers"] = headers
+        kwargs.setdefault("cookies", self.cookies)
+        request_method = getattr(self.session, method.lower())
+        return self.executor.submit(request_method, url, **kwargs)
+
+
+def _response(response):
+    """Return a response from either requests or requests-futures."""
+    if isinstance(response, Future):
+        return response.result()
+    return response
