+++ b/reproduce_migration.py
@@ -0,0 +1,13 @@
+"""Reproduce the failure when tqdm is unavailable after the dependency migration."""
+import sys
+
+
+class BlockTqdm:
+    def find_spec(self, fullname, path=None, target=None):
+        if fullname == "tqdm" or fullname.startswith("tqdm."):
+            raise ModuleNotFoundError("No module named 'tqdm' (blocked for reproduction)")
+        return None
+
+
+sys.meta_path.insert(0, BlockTqdm())
+import words_n_fun  # noqa: F401
