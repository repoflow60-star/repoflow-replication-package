+@dataclass
+class Response:
+    """A synchronous snapshot of an aiohttp response.
+
+    ``aiohttp.ClientResponse`` is tied to the event loop and to its open
+    client session.  The public pyschlage API is synchronous, so responses are
+    fully consumed before they are returned and exposed through this small
+    response object.
+    """
+
+    status_code: int
+    reason: str
+    headers: Any
+    _body: bytes
+
+    def json(self) -> Any:
+        """Decode the response body as JSON."""
+        return json.loads(self._body)
+
+    def raise_for_status(self) -> None:
+        """Raise aiohttp's HTTP exception for an unsuccessful response."""
+        if self.status_code >= 400:
+            raise aiohttp.ClientResponseError(
+                request_info=cast(aiohttp.RequestInfo, None),
+                history=(),
+                status=self.status_code,
+                message=self.reason,
+                headers=self.headers,
+            )
+
+
+@dataclass
+class _AuthRequest:
+    """The part of an auth request used by pycognito's auth plugin."""
+
+    headers: dict[str, str]
