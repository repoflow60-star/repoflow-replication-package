+def _run(coroutine):
+    """Run an aiohttp coroutine from the library's synchronous API."""
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coroutine)
+
+    # asyncio.run cannot be nested in an active event loop.  Run the
+    # synchronous facade in a worker thread when called from async code.
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        return executor.submit(asyncio.run, coroutine).result()
+
 
