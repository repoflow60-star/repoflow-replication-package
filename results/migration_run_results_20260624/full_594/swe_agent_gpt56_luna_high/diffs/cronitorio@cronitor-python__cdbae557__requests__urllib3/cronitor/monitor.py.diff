+class _Response:
+    """Small compatibility view of an urllib3 response.
+
+    The monitor code only needs status, text, JSON, and headers. Keeping those
+    attributes here avoids leaking urllib3's lower-level response interface.
+    """
+
+    def __init__(self, response):
+        self._response = response
+        self.status_code = response.status
+        self.headers = response.headers
+        self.content = response.data
+
+    @property
+    def text(self):
+        content_type = self.headers.get('Content-Type', '')
+        encoding = 'utf-8'
+        if 'charset=' in content_type:
+            encoding = content_type.split('charset=', 1)[1].split(';', 1)[0].strip()
+        return self.content.decode(encoding, errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+    def __bool__(self):
+        return self.status_code < 400
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
+
+class _HTTPClient:
+    """Requests-style convenience methods backed by urllib3.PoolManager."""
+
+    def __init__(self, retries):
+        self._pool = urllib3.PoolManager(retries=retries)
+
+    @staticmethod
+    def _headers(headers, auth):
+        result = dict(headers or {})
+        if auth is not None:
+            username, password = auth
+            credentials = '{}:{}'.format(username, password).encode('utf-8')
+            result['Authorization'] = 'Basic ' + base64.b64encode(credentials).decode('ascii')
+        return result
+
+    def request(self, method, url, data=None, headers=None, timeout=None,
+                auth=None, params=None):
+        # urllib3 calls query parameters ``fields``. Omit None values so
+        # optional ping arguments are not sent as literal ``None`` values.
+        fields = None
+        if params:
+            fields = []
+            for key, value in params.items():
+                if value is None:
+                    continue
+                if isinstance(value, (list, tuple)):
+                    fields.extend((key, item) for item in value)
+                else:
+                    fields.append((key, value))
+
+        response = self._pool.request(
+            method,
+            url,
+            body=data,
+            fields=fields,
+            headers=self._headers(headers, auth),
+            timeout=timeout,
+        )
+        return _Response(response)
+
+    def get(self, url, **kwargs):
