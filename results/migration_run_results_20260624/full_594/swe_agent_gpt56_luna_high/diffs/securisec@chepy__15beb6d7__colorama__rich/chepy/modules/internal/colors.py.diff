 import sys
-from colorama import Fore, Back
+from io import StringIO
+
+from rich.console import Console
+from rich.text import Text
+
+
+def _styled(s: str, style: str) -> str:
+    """Render *s* using Rich and return terminal escape sequences.
+
+    The color helpers are used in places that still call Python's built-in
+    ``print`` (and in regular-expression replacements), so returning a Rich
+    ``Text`` instance would discard the styling.  Rendering to a buffer keeps
+    the existing string-based API while delegating ANSI generation to Rich.
+    """
+    if not sys.stdout.isatty():
+        return s
+
+    output = StringIO()
+    console = Console(
+        file=output,
+        force_terminal=True,
+        color_system="standard",
+        markup=False,
+    )
+    console.print(Text(s, style=style), end="")
+    return output.getvalue()
 
 
