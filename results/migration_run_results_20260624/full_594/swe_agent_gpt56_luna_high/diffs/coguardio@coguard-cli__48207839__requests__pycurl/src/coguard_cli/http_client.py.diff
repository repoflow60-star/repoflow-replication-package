--- a/src/coguard_cli/http_client.py
+++ b/src/coguard_cli/http_client.py
@@ -0,0 +1,129 @@
+"""Small HTTP client adapter backed by :mod:`pycurl`.
+
+The CLI only needs a small subset of the interface provided by ``requests``.
+Keeping that subset here makes the transport used by the application explicit
+while preserving the response operations used by the rest of the code.
+"""
+
+import http
+import json
+from io import BytesIO
+from typing import Any, Dict, Iterable, Optional
+from urllib.parse import urlencode
+
+import pycurl
+
+
+class HTTPError(Exception):
+    """Raised when :meth:`Response.raise_for_status` sees an HTTP error."""
+
+
+class Response:
+    """The response values consumed by the CLI."""
+
+    def __init__(self, status_code: int, content: bytes):
+        self.status_code = status_code
+        self.content = content
+
+    @property
+    def text(self) -> str:
+        return self.content.decode("utf-8", errors="replace")
+
+    @property
+    def reason(self) -> str:
+        try:
+            return http.HTTPStatus(self.status_code).phrase
+        except ValueError:
+            return ""
+
+    def json(self) -> Any:
+        return json.loads(self.text)
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            raise HTTPError(
+                f"{self.status_code} {self.reason}".strip()
+            )
+
+    def iter_content(self, chunk_size: int = 8192) -> Iterable[bytes]:
+        for start in range(0, len(self.content), chunk_size):
+            yield self.content[start:start + chunk_size]
+
+    def __enter__(self) -> "Response":
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback) -> None:
+        return None
+
+
+def request(
+        method: str,
+        url: str,
+        headers: Optional[Dict[str, str]] = None,
+        data: Any = None,
+        json_data: Any = None,
+        timeout: Optional[int] = None,
+        stream: bool = False) -> Response:
+    """Perform an HTTP request using a fresh PycURL handle.
+
+    ``stream`` is accepted for compatibility with the callers.  PycURL writes
+    the response to memory here; ``Response.iter_content`` still exposes it in
+    chunks to callers downloading reports.
+    """
+    del stream  # The complete response is buffered by the write callback.
+
+    body = None
+    request_headers = dict(headers or {})
+    if json_data is not None:
+        body = json.dumps(json_data).encode("utf-8")
+        if not any(key.lower() == "content-type" for key in request_headers):
+            request_headers["Content-Type"] = "application/json"
+    elif data is not None:
+        if isinstance(data, dict):
+            body = urlencode(data).encode("utf-8")
+        elif isinstance(data, str):
+            body = data.encode("utf-8")
+        else:
+            body = bytes(data)
+
+    response_body = BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+        curl.setopt(pycurl.CUSTOMREQUEST, method.upper())
+        if request_headers:
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                [f"{key}: {value}" for key, value in request_headers.items()]
+            )
+        if body is not None:
+            curl.setopt(pycurl.POSTFIELDS, body)
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT, timeout)
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+
+    return Response(status_code, response_body.getvalue())
+
+
+def get(url: str, **kwargs: Any) -> Response:
+    """Perform a GET request."""
+    return request("GET", url, **kwargs)
+
+
+def post(url: str, **kwargs: Any) -> Response:
+    """Perform a POST request."""
+    # Keep the public spelling used by the former requests calls.
+    if "json" in kwargs:
+        kwargs["json_data"] = kwargs.pop("json")
+    return request("POST", url, **kwargs)
+
+
+def put(url: str, **kwargs: Any) -> Response:
+    """Perform a PUT request."""
+    if "json" in kwargs:
+        kwargs["json_data"] = kwargs.pop("json")
+    return request("PUT", url, **kwargs)
