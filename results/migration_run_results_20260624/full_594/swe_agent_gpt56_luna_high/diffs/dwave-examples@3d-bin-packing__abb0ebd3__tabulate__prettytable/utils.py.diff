+def _format_table(rows: list, align: Optional[str] = None) -> str:
+    """Format rows as a PrettyTable."""
+    table = PrettyTable()
+    table.field_names = rows[0]
+    table.add_rows(rows[1:])
+    # Keep a header rule but omit vertical borders. This preserves the
+    # whitespace-oriented format used by the input and solution files.
+    table.hrules = HRuleStyle.HEADER
+    table.vrules = VRuleStyle.NONE
+    if align is not None:
+        table.align = align
+    return str(table)
 
 
