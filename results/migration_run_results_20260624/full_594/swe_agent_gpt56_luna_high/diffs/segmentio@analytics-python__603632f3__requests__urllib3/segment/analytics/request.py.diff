+def _status(response):
+    """Return the status code from an urllib3 response (or a test double)."""
+    return getattr(response, 'status', getattr(response, 'status_code', None))
+
+
+def _json(response):
+    """Decode an urllib3 response body as JSON."""
+    if hasattr(response, 'json'):
+        return response.json()
+    body = response.data
+    if isinstance(body, bytes):
+        body = body.decode('utf-8')
+    return json.loads(body)
+
+
+def _text(response):
+    body = getattr(response, 'data', '')
+    if isinstance(body, bytes):
+        return body.decode('utf-8', errors='replace')
+    return body
+
+
+def _http_client(proxies, url):
+    """Return a pool configured for the requested proxy, if any."""
+    if not proxies:
+        return _session
+
+    if isinstance(proxies, dict):
+        scheme = urlsplit(url).scheme
+        proxy = proxies.get(scheme) or proxies.get('all')
+    else:
+        proxy = proxies
+
+    if not proxy:
+        return _session
+    if '://' not in proxy:
+        proxy = 'http://' + proxy
+    return urllib3.ProxyManager(proxy)
 
 
