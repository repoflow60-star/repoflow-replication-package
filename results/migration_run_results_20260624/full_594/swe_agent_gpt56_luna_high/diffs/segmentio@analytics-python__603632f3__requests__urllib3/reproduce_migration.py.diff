--- a/reproduce_migration.py
+++ b/reproduce_migration.py
@@ -0,0 +1,25 @@
+"""Reproduce the dependency that prevents running without requests."""
+import builtins
+
+real_import = builtins.__import__
+
+
+def reject_requests(name, *args, **kwargs):
+    if name == "requests" or name.startswith("requests."):
+        raise ModuleNotFoundError("No module named 'requests'")
+    return real_import(name, *args, **kwargs)
+
+
+builtins.__import__ = reject_requests
+try:
+    import segment.analytics.request  # noqa: F401
+except ModuleNotFoundError as error:
+    print(f"reproduced: {error}")
+else:
+    raise AssertionError("the package still imports requests")
+finally:
+    builtins.__import__ = real_import
+
+with open("requirements.txt", encoding="utf-8") as requirements:
+    assert "requests" in requirements.read()
+print("reproduced: requests is a declared runtime dependency")
