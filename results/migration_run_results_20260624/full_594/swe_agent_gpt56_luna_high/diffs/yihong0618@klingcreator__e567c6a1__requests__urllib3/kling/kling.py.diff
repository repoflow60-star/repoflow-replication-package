+class _CookieJar(dict):
+    """Small mapping used to retain the cookie values for urllib3 requests."""
+
+
+class _Response:
+    """Requests-like response attributes used by the generator code."""
+
+    def __init__(self, response: urllib3.BaseHTTPResponse) -> None:
+        self._response = response
+        self.status_code = response.status
+        self.content = response.data
+
+    @property
+    def ok(self) -> bool:
+        return self.status_code < 400
+
+    @property
+    def text(self) -> str:
+        return self.content.decode("utf-8", errors="replace")
+
+    def json(self) -> Any:
+        return json_module.loads(self.content.decode("utf-8"))
+
+    def __str__(self) -> str:
+        return f"<Response [{self.status_code}]>"
+
+
+class _Session:
+    """A small session facade backed by urllib3's connection pool."""
+
+    def __init__(self) -> None:
+        self._pool = urllib3.PoolManager()
+        self.headers: dict[str, str] = {}
+        self.cookies: Optional[_CookieJar] = None
+
+    def _url_with_params(self, url: str, params: Optional[dict]) -> str:
+        if not params:
+            return url
+        parts = urlsplit(url)
+        query = urlencode(params, doseq=True)
+        combined_query = f"{parts.query}&{query}" if parts.query else query
+        return urlunsplit(
+            (parts.scheme, parts.netloc, parts.path, combined_query, parts.fragment)
+        )
+
+    def request(
+        self,
+        method: str,
+        url: str,
+        *,
+        params: Optional[dict] = None,
+        data: Any = None,
+        json: Any = None,
+        headers: Optional[dict[str, str]] = None,
+    ) -> _Response:
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+        has_cookie_header = any(
+            key.lower() == "cookie" for key in request_headers
+        )
+        if self.cookies and not has_cookie_header:
+            request_headers["Cookie"] = "; ".join(
+                f"{key}={value}" for key, value in self.cookies.items()
+            )
+
+        body = data
+        if json is not None:
+            body = json_module.dumps(json).encode("utf-8")
+            request_headers.setdefault("Content-Type", "application/json")
+
+        response = self._pool.request(
+            method,
+            self._url_with_params(url, params),
+            body=body,
+            headers=request_headers,
+        )
+        return _Response(response)
+
+    def get(self, url: str, **kwargs: Any) -> _Response:
+        return self.request("GET", url, **kwargs)
+
+    def post(self, url: str, **kwargs: Any) -> _Response:
+        return self.request("POST", url, **kwargs)
 
