--- a/jsonfmt/toml_writer.py
+++ b/jsonfmt/toml_writer.py
@@ -0,0 +1,129 @@
+"""Small TOML writer used alongside :mod:`tomli`.
+
+``tomli`` deliberately only implements TOML parsing.  jsonfmt also supports
+converting other formats to TOML, so it needs a writer as well.  This module
+covers the Python values produced by the supported input parsers and keeps the
+output style historically used by jsonfmt's former TOML dependency.
+"""
+
+import json
+import math
+import re
+from collections.abc import Mapping
+from datetime import date, datetime, time
+from typing import Any, List, Tuple
+
+
+_BARE_KEY = re.compile(r'^[A-Za-z0-9_-]+$')
+
+
+def _format_key(key: Any) -> str:
+    """Return a TOML bare or quoted key."""
+    key = str(key)
+    return key if _BARE_KEY.match(key) else json.dumps(key, ensure_ascii=False)
+
+
+def _format_scalar(value: Any) -> str:
+    """Format a scalar TOML value."""
+    if isinstance(value, str):
+        return json.dumps(value, ensure_ascii=False)
+    if isinstance(value, bool):
+        return 'true' if value else 'false'
+    if isinstance(value, int):
+        return str(value)
+    if isinstance(value, float):
+        if math.isnan(value):
+            return 'nan'
+        if math.isinf(value):
+            return '-inf' if value < 0 else 'inf'
+        return repr(value)
+    if isinstance(value, datetime):
+        return value.isoformat()
+    if isinstance(value, date):
+        return value.isoformat()
+    if isinstance(value, time):
+        return value.isoformat()
+    # This is consistent with the old writer's treatment of values such as
+    # None in arrays, while None in a mapping is omitted by _write_table.
+    if value is None:
+        return json.dumps('None')
+    return json.dumps(str(value), ensure_ascii=False)
+
+
+def _format_array(values: Any) -> str:
+    if not values:
+        return '[]'
+    return '[ ' + ', '.join(_format_value(value) for value in values) + ',]'
+
+
+def _format_value(value: Any) -> str:
+    if isinstance(value, (list, tuple)):
+        return _format_array(value)
+    if isinstance(value, Mapping):
+        raise TypeError('inline TOML tables are not supported')
+    return _format_scalar(value)
+
+
+def _is_table_array(value: Any) -> bool:
+    return (isinstance(value, (list, tuple)) and bool(value)
+            and all(isinstance(item, Mapping) for item in value))
+
+
+def _is_table_value(value: Any) -> bool:
+    return isinstance(value, Mapping) or _is_table_array(value)
+
+
+def _path(path: Tuple[Any, ...]) -> str:
+    return '.'.join(_format_key(key) for key in path)
+
+
+def _write_table(table: Mapping, path: Tuple[Any, ...], lines: List[str],
+                 header: str = '') -> bool:
+    """Write a table and return whether it contained nested tables."""
+    if header:
+        lines.append(header)
+
+    # TOML requires scalar fields to precede child tables.  It also makes the
+    # generated output deterministic for OrderedDict and normal dict inputs.
+    for key, value in table.items():
+        if value is None or _is_table_value(value):
+            continue
+        lines.append(f'{_format_key(key)} = {_format_value(value)}')
+
+    has_nested = False
+    for key, value in table.items():
+        child_path = path + (key,)
+        if isinstance(value, Mapping):
+            has_nested = True
+            if lines and lines[-1] != '':
+                lines.append('')
+            _write_table(value, child_path, lines,
+                         f'[{_path(child_path)}]')
+        elif _is_table_array(value):
+            has_nested = True
+            for index, item in enumerate(value):
+                # Array-of-table headers follow the scalar fields directly;
+                # separate subsequent entries just as the previous writer did.
+                if index and lines and lines[-1] != '':
+                    lines.append('')
+                item_has_nested = _write_table(
+                    item, child_path, lines, f'[[{_path(child_path)}]]')
+                if not item_has_nested and index != len(value) - 1:
+                    lines.append('')
+    return has_nested
+
+
+def dumps(value: Mapping) -> str:
+    """Serialize a mapping to TOML text.
+
+    TOML documents have a table at their root, which is also the only shape
+    jsonfmt accepts for TOML output.
+    """
+    if not isinstance(value, Mapping):
+        raise TypeError('TOML root must be a mapping')
+    lines: List[str] = []
+    _write_table(value, (), lines)
+    return '\n'.join(lines) + ('\n' if lines else '')
+
+
+__all__ = ['dumps']
