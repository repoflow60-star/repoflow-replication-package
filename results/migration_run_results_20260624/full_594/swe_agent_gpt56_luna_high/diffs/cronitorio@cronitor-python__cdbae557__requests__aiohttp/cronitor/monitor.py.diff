+class _Response:
+    """Small, synchronous response object used by the public API.
+
+    The original client exposed the parts of a response that are used below
+    (``status_code``, ``text`` and ``json``).  ``aiohttp`` exposes those
+    values asynchronously, so the response body is consumed before the
+    request coroutine is returned.
+    """
+
+    def __init__(self, status, body, encoding=None, headers=None):
+        self.status = status
+        self.status_code = status
+        self._body = body
+        self._encoding = encoding or 'utf-8'
+        self.headers = headers or {}
+
+    @property
+    def text(self):
+        return self._body.decode(self._encoding, errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+
+async def _request(session, method, url, kwargs, retries, backoff_factor):
+    """Make an aiohttp request and return a response with a buffered body."""
+    timeout = kwargs.pop('timeout', None)
+    if timeout is not None and not isinstance(timeout, aiohttp.ClientTimeout):
+        kwargs['timeout'] = aiohttp.ClientTimeout(total=timeout)
+
+    auth = kwargs.get('auth')
+    if isinstance(auth, tuple):
+        kwargs['auth'] = aiohttp.BasicAuth(auth[0], auth[1])
+
+    headers = kwargs.get('headers')
+    if isinstance(headers, dict):
+        kwargs['headers'] = {
+            key: value for key, value in headers.items() if value is not None
+        }
+
+    # The previous HTTP client omitted query parameters whose value is None
+    # and accepted a list for repeated parameters.  Normalize both forms for
+    # yarl, which is stricter about query values.
+    params = kwargs.get('params')
+    if isinstance(params, dict):
+        kwargs['params'] = [
+            (key, value)
+            for key, values in params.items()
+            if values is not None
+            for value in (values if isinstance(values, (list, tuple)) else (values,))
+        ]
+
+    for attempt in range(retries + 1):
+        try:
+            async with session.request(method, url, **kwargs) as response:
+                body = await response.read()
+                return _Response(
+                    response.status,
+                    body,
+                    response.charset,
+                    response.headers,
+                )
+        except (
+            aiohttp.ClientConnectionError,
+            aiohttp.ClientPayloadError,
+            asyncio.TimeoutError,
+        ):
+            if attempt == retries:
+                raise
+            if backoff_factor:
+                await asyncio.sleep(backoff_factor * (2 ** attempt))
+
