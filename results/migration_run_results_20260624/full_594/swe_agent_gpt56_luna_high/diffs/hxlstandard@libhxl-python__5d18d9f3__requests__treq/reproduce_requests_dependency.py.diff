--- a/reproduce_requests_dependency.py
+++ b/reproduce_requests_dependency.py
@@ -0,0 +1,17 @@
+"""Reproduce the dependency that the treq migration must remove."""
+import builtins
+
+real_import = builtins.__import__
+
+def reject_requests(name, *args, **kwargs):
+    if name == "requests" or name.startswith("requests."):
+        raise ModuleNotFoundError("requests is unavailable")
+    return real_import(name, *args, **kwargs)
+
+builtins.__import__ = reject_requests
+try:
+    import hxl.input
+except ModuleNotFoundError as error:
+    print("reproduced:", error)
+else:
+    raise SystemExit("hxl.input still imports without requests; reproduction failed")
