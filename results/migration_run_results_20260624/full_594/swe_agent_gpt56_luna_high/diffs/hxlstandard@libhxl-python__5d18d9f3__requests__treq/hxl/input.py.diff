+########################################################################
+# Synchronous adapter for treq
+########################################################################
+
+# libhxl's public input API is synchronous, while treq is deliberately
+# asynchronous.  Keep the public API unchanged by running one Twisted
+# reactor in a background thread and waiting for each request to finish.
+_reactor_lock = threading.Lock()
+_reactor_thread = None
+_reactor_ready = None
+
+
+def _get_reactor():
+    """Return a running reactor suitable for synchronous treq calls."""
+    from twisted.internet import reactor
+
+    global _reactor_thread, _reactor_ready
+    with _reactor_lock:
+        if reactor.running:
+            return reactor
+        if _reactor_thread is not None:
+            # A Twisted reactor cannot be restarted after it has stopped.
+            if not _reactor_thread.is_alive():
+                raise RuntimeError("The Twisted reactor has stopped")
+            ready = _reactor_ready
+        else:
+            ready = threading.Event()
+            _reactor_ready = ready
+
+            def run_reactor():
+                reactor.callWhenRunning(ready.set)
+                reactor.run(installSignalHandlers=False)
+
+            _reactor_thread = threading.Thread(
+                target=run_reactor,
+                name="libhxl-treq-reactor",
+                daemon=True,
+            )
+            _reactor_thread.start()
+    ready.wait()
+    return reactor
+
+
+def _http_headers(response):
+    """Convert Twisted headers into the case-insensitive mapping we expose."""
+    return _HTTPHeaders({
+        key.decode("latin-1") if isinstance(key, bytes) else key:
+        (values[0].decode("latin-1") if isinstance(values[0], bytes) else values[0])
+        for key, values in response.headers.getAllRawHeaders()
+        if values
+    })
+
+
+class _HTTPHeaders(dict):
+    """Small case-insensitive HTTP header mapping."""
+
+    def _key(self, key):
+        key = key.decode("latin-1") if isinstance(key, bytes) else key
+        for existing in self:
+            if existing.lower() == key.lower():
+                return existing
+        return key
+
+    def __getitem__(self, key):
+        return super().__getitem__(self._key(key))
+
+    def get(self, key, default=None):
+        return super().get(self._key(key), default)
+
+
+class _HTTPResponse:
+    """The small subset of an HTTP response used by libhxl."""
+
+    def __init__(self, response, content):
+        self.status_code = response.code
+        self.headers = _http_headers(response)
+        self.content = content
+        self.is_redirect = (
+            response.code in (301, 302, 303, 307, 308)
+            and self.headers.get("Location") is not None
+        )
+
+    def json(self):
+        return json.loads(self.content.decode("utf-8"))
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise IOError("HTTP error {}".format(self.status_code))
+
+    def iter_content(self, chunk_size=0x1000):
+        for start in range(0, len(self.content), chunk_size):
+            yield self.content[start:start + chunk_size]
+
+    def close(self):
+        return None
+
+
+def _http_request(method, url, verify=True, headers=None, timeout=None,
+                  params=None, data=None, allow_redirects=True):
+    """Make a blocking HTTP request through treq."""
+    from twisted.internet import defer
+    from twisted.web.client import Agent
+    from twisted.internet.ssl import ClientContextFactory
+
+    reactor = _get_reactor()
+    result = []
+    finished = threading.Event()
+
+    def request_in_reactor():
+        kwargs = {
+            "headers": headers,
+            "params": params,
+            "data": data,
+            "allow_redirects": allow_redirects,
+            "timeout": timeout,
+            "reactor": reactor,
+        }
+        if not verify:
+            # ClientContextFactory deliberately does not validate server
+            # certificates, matching verify_ssl=False behaviour.
+            kwargs["agent"] = Agent(
+                reactor, contextFactory=ClientContextFactory()
+            )
+
+        @defer.inlineCallbacks
+        def fetch():
+            try:
+                response = yield treq.request(method, url, **kwargs)
+                content = yield treq.content(response)
+                defer.returnValue(_HTTPResponse(response, content))
+            except Exception as error:
+                defer.returnValue(error)
+
+        deferred = fetch()
+
+        def complete(value):
+            result.append(value)
+            finished.set()
+            return value
+
+        deferred.addCallback(complete)
+        deferred.addErrback(complete)
+
+    reactor.callFromThread(request_in_reactor)
+    finished.wait()
+    response = result[0]
+    if isinstance(response, Exception):
+        raise response
+    # Deferred failures are passed to the errback as Failure instances.
+    if hasattr(response, "raiseException"):
+        response.raiseException()
+    return response
+
+
+def _http_get(url, **kwargs):
+    return _http_request("GET", url, **kwargs)
+
+
+def _http_head(url, **kwargs):
+    return _http_request("HEAD", url, **kwargs)
+
+
+def _http_post(url, **kwargs):
+    return _http_request("POST", url, **kwargs)
 
