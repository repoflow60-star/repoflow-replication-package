--- a/reproduce_migration.py
+++ b/reproduce_migration.py
@@ -0,0 +1,13 @@
+"""Reproduce the dependency migration failure."""
+try:
+    import sqlobject
+    assert sqlobject.__version__ == '3.13.1', sqlobject.__version__
+except (ImportError, AssertionError) as error:
+    raise SystemExit('sqlobject 3.13.1 is not installed: %s' % error)
+
+from mindsdb_sql.render.sqlalchemy_render import SqlalchemyRender
+from mindsdb_sql import parse_sql
+
+# The renderer currently imports SQLAlchemy and cannot operate with the target
+# dependency alone.
+SqlalchemyRender('mysql').get_string(parse_sql('SELECT 1'))
