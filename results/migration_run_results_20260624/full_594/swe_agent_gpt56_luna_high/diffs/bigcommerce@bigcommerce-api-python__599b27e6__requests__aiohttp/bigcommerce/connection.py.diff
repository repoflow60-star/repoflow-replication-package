+class _AiohttpResponse(object):
+    """Small, synchronous response snapshot used by the legacy API.
+
+    ``aiohttp.ClientResponse`` exposes its body through coroutines.  The
+    public Bigcommerce client predates aiohttp and is synchronous, so the
+    response is fully read before it is returned from the session adapter.
+    Keeping a snapshot also means the underlying ClientSession can be closed
+    promptly and avoids leaking connections for the existing synchronous API.
+    """
+
+    def __init__(self, response, content):
+        self.status_code = response.status
+        self.reason = response.reason
+        self.headers = response.headers
+        self.content = content
+
+    def json(self):
+        return loads(self.content.decode('utf-8'))
+
+
+def _run_awaitable(awaitable):
+    """Run an aiohttp coroutine from the client's synchronous API.
+
+    Most callers do not already have an event loop.  When the client is used
+    from asynchronous code, however, ``asyncio.run`` cannot be called on the
+    current thread; use a short-lived worker thread in that case.
+    """
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(awaitable)
+
+    result = []
+    error = []
+
+    def runner():
+        try:
+            result.append(asyncio.run(awaitable))
+        except BaseException as exc:  # re-raise in the calling thread
+            error.append(exc)
+
+    thread = threading.Thread(target=runner)
+    thread.start()
+    thread.join()
+    if error:
+        raise error[0]
+    return result[0]
+
+
+class _AiohttpSession(object):
+    """Session-shaped adapter for the package's backwards-compatible API.
+
+    aiohttp sessions are tied to an event loop and their request/response
+    methods are asynchronous.  This adapter retains the old ``Connection``
+    calling convention while making every network operation use aiohttp.
+    """
+
+    def __init__(self, auth=None):
+        self.auth = auth
+        self.headers = {}
+
+    @staticmethod
+    def _auth_value(auth):
+        if auth is None or isinstance(auth, aiohttp.BasicAuth):
+            return auth
+        if isinstance(auth, (tuple, list)) and len(auth) == 2:
+            return aiohttp.BasicAuth(auth[0], auth[1])
+        return auth
+
+    async def _request(self, method, url, data, timeout, headers):
+        async with aiohttp.ClientSession(
+                auth=self._auth_value(self.auth), headers=self.headers) as session:
+            async with session.request(method, url, data=data, timeout=timeout,
+                                       headers=headers) as response:
+                content = await response.read()
+                return _AiohttpResponse(response, content)
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        return self._request(method, url, data, timeout, headers)
+
