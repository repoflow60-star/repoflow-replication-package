--- a/src/coguard_cli/http.py
+++ b/src/coguard_cli/http.py
@@ -0,0 +1,40 @@
+"""Synchronous HTTP access backed by :mod:`requests_futures`.
+
+The CLI's callers are synchronous, while ``requests-futures`` exposes
+``Future`` objects.  This small adapter waits at the request boundary so the
+existing API can continue to work with response objects.
+"""
+
+import requests as _requests
+from requests_futures.sessions import FuturesSession
+
+
+class _RequestsModuleSession:
+    """Use the requests module as the transport for ``FuturesSession``."""
+
+    def request(self, method, url, **kwargs):
+        # Session.get/post add these defaults before delegating to request().
+        # The module-level requests functions already provide the same
+        # defaults, and omitting them keeps their original call signature.
+        if kwargs.get("allow_redirects") is True:
+            kwargs.pop("allow_redirects", None)
+        if kwargs.get("json") is None:
+            kwargs.pop("json", None)
+        if kwargs.get("data") is None:
+            kwargs.pop("data", None)
+        return getattr(_requests, method.lower())(url, **kwargs)
+
+
+class _BlockingFuturesSession(FuturesSession):
+    """A ``FuturesSession`` whose public calls return responses."""
+
+    def request(self, *args, **kwargs):
+        return super().request(*args, **kwargs).result()
+
+
+requests = _BlockingFuturesSession(session=_RequestsModuleSession())
+
+
+__all__ = ["requests"]
+
+
