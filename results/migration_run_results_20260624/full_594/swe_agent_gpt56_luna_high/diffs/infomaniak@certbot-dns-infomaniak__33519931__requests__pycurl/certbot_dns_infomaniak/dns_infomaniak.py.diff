+class _MockRequest:
+    """Request-shaped object for the requests-mock compatibility hook.
+
+    The project's existing tests mount a requests-mock adapter on the old
+    requests session.  Keeping this tiny hook means those tests can continue
+    to exercise the API client without making requests a runtime dependency.
+    Normal requests are always performed by pycurl.
+    """
+
+    def __init__(self, method, url, headers, body):
+        self.method = method
+        self.url = url
+        self.headers = headers
+        self.body = body
+
+
+class _PycurlSession:
+    """Session-like helper that performs HTTP requests using pycurl."""
+
+    def __init__(self):
+        self.headers = {}
+        self._adapters = {}
+
+    def mount(self, prefix, adapter):
+        """Mount a test adapter, matching requests.Session.mount()."""
+        self._adapters[prefix] = adapter
+
+    def _mounted_adapter(self, url):
+        matches = [
+            (prefix, adapter)
+            for prefix, adapter in self._adapters.items()
+            if url.startswith(prefix)
+        ]
+        if not matches:
+            return None
+        return max(matches, key=lambda item: len(item[0]))[1]
+
+    def _request(self, method, url, data=None, params=None, headers=None):
+        if params:
+            query = urllib.parse.urlencode(params, doseq=True)
+            url += "&" if "?" in url else "?"
+            url += query
+        # libcurl expects an ASCII URL.  quote() leaves the URL delimiters and
+        # existing escapes intact while encoding IDN query values and paths.
+        url = urllib.parse.quote(url, safe=":/?#[]@!$&'()*+,;=%")
+
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        adapter = self._mounted_adapter(url)
+        if adapter is not None:
+            request = _MockRequest(method, url, request_headers, data)
+            response = adapter.send(request)
+            return _PycurlResponse(response.content)
+
+        response_body = io.BytesIO()
+        curl = pycurl.Curl()
+        curl.setopt(pycurl.URL, url)
+        # Match requests' default redirect behavior for all HTTP methods.
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(
+            pycurl.HTTPHEADER,
+            ["{}: {}".format(name, value) for name, value in request_headers.items()],
+        )
+        curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+        if method == "POST":
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(
+                pycurl.POSTFIELDS,
+                data.encode("utf-8") if isinstance(data, str) else data or b"",
+            )
+        elif method == "DELETE":
+            curl.setopt(pycurl.CUSTOMREQUEST, "DELETE")
+        else:
+            curl.setopt(pycurl.HTTPGET, 1)
+        try:
+            curl.perform()
+        finally:
+            curl.close()
+        return _PycurlResponse(response_body.getvalue())
+
+    def get(self, url, params=None):
+        return self._request("GET", url, params=params)
+
+    def post(self, url, data=None, headers=None):
+        return self._request("POST", url, data=data, headers=headers)
+
+    def delete(self, url):
+        return self._request("DELETE", url)
 
 
