+class _TreqResponse:
+    """Synchronous response facade used by the existing provider API.
+
+    ``treq`` returns a Twisted response and exposes its body asynchronously.
+    HTTPProvider has historically been synchronous, so the body is collected
+    before this facade is returned.  Keeping the small facade local also keeps
+    response parsing independent from either HTTP client implementation.
+    """
+
+    def __init__(self, response, content: bytes):
+        self._response = response
+        self.content = content
+        self.code = response.code
+        self.ok = 200 <= response.code < 400
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
 
 
