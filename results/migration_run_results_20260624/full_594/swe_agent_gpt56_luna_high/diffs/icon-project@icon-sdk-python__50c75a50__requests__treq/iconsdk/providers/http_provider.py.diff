+
+    @staticmethod
+    def _wait_for_deferred(deferred, reactor):
+        """Resolve a Deferred using the request's private reactor."""
+        result = []
+        failure = []
+
+        def succeeded(value):
+            result.append(value)
+            if reactor.running:
+                reactor.stop()
+            return value
+
+        def failed(error):
+            failure.append(error)
+            if reactor.running:
+                reactor.stop()
+            return error
+
+        deferred.addCallbacks(succeeded, failed)
+        # A mocked/short-circuited Deferred may already have fired before the
+        # callbacks were added.  In that case there is no reactor to run.
+        if not result and not failure:
+            reactor.run()
+
+        if failure:
+            failure[0].raiseException()
+        return result[0]
 
