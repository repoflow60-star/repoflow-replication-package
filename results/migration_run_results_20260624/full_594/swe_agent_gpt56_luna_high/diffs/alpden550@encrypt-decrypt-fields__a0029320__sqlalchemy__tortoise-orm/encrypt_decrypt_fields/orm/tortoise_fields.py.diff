--- a/encrypt_decrypt_fields/orm/tortoise_fields.py
+++ b/encrypt_decrypt_fields/orm/tortoise_fields.py
@@ -0,0 +1,24 @@
+from tortoise import fields
+
+from encrypt_decrypt_fields import Crypto
+
+
+class EncryptedTortoiseBinaryField(fields.BinaryField):
+    """Store encrypted values in a Tortoise binary field."""
+
+    def __init__(self, key: str, **kwargs):
+        super().__init__(**kwargs)
+        self.key = key
+        self.crypto = Crypto(key=self.key)
+
+    def to_python_value(self, value):
+        # Tortoise calls this for values passed to a model constructor as well
+        # as values read from the database.  Leave plaintext assignments alone
+        # so that they can be encrypted by ``to_db_value``.
+        return value
+
+    def to_db_value(self, value, instance):
+        if not value or isinstance(value, (bytes, memoryview)):
+            return value
+
+        return self.crypto.encrypt(str(value))
