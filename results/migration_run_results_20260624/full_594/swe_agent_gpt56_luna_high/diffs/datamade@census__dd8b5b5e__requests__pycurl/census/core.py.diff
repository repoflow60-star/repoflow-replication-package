+class PyCurlResponse(object):
+    """Small response object exposing the API used by the Census clients.
+
+    PycURL is intentionally a low-level binding and returns response data via a
+    callback.  Keeping that detail here means the Census clients can continue
+    to work with a response-like object (and custom sessions).
+    """
+
+    def __init__(self, status_code, content, headers):
+        self.status_code = status_code
+        self.content = content
+        self.headers = headers
+
+    @property
+    def text(self):
+        content_type = self.headers.get('content-type', '')
+        message = Message()
+        message['content-type'] = content_type
+        encoding = message.get_param('charset')
+
+        if encoding:
+            try:
+                return self.content.decode(encoding)
+            except (LookupError, UnicodeDecodeError):
+                pass
+
+        # Census responses are normally UTF-8.  A few older endpoints have
+        # returned Windows-1252 bytes without declaring a charset, so retain a
+        # useful text value for those responses as well.
+        try:
+            return self.content.decode('utf-8')
+        except UnicodeDecodeError:
+            return self.content.decode('cp1252')
+
+    def json(self, **kwargs):
+        return json.loads(self.text, **kwargs)
+
