+class PyCurlSession(object):
+    """A minimal session adapter backed by :mod:`pycurl`.
+
+    The public attributes and methods provide the small session interface used
+    by this package: ``headers``, ``get`` and ``close``.  This also keeps the
+    existing ``Census(..., session=...)``
+    extension point available for callers that provide their own adapter.
+    """
+
+    def __init__(self, *args, **kwargs):
+        self.headers = dict(kwargs.pop('headers', {}))
+        if args or kwargs:
+            raise TypeError('PyCurlSession accepts only an optional headers argument')
+
+    def get(self, url, params=None, **kwargs):
+        if params:
+            parts = urlsplit(url)
+            query = urlencode(params, doseq=True)
+            if parts.query:
+                query = '{}&{}'.format(parts.query, query)
+            url = urlunsplit((parts.scheme, parts.netloc, parts.path,
+                              query, parts.fragment))
+
+        body = BytesIO()
+        response_headers = {}
+
+        def capture_header(line):
+            # Header lines are bytes and include the terminating CRLF.
+            line = line.decode('iso-8859-1').strip()
+            if ':' in line:
+                name, value = line.split(':', 1)
+                response_headers[name.lower()] = value.strip()
+
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(curl.URL, url)
+            curl.setopt(curl.WRITEDATA, body)
+            curl.setopt(curl.HEADERFUNCTION, capture_header)
+            curl.setopt(curl.FOLLOWLOCATION, 1)
+            # Ask libcurl to negotiate and transparently decompress responses.
+            curl.setopt(curl.ACCEPT_ENCODING, '')
+
+            headers = kwargs.pop('headers', None)
+            request_headers = dict(self.headers)
+            if headers:
+                request_headers.update(headers)
+            if request_headers:
+                curl.setopt(curl.HTTPHEADER, [
+                    '{}: {}'.format(name, value)
+                    for name, value in request_headers.items()
+                ])
+
+            timeout = kwargs.pop('timeout', None)
+            if timeout is not None:
+                if isinstance(timeout, (tuple, list)):
+                    timeout = max(timeout)
+                curl.setopt(curl.TIMEOUT, timeout)
+            if kwargs:
+                raise TypeError('unsupported pycurl request options: {}'.format(
+                    ', '.join(sorted(kwargs))))
+
+            curl.perform()
+            status_code = curl.getinfo(curl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        return PyCurlResponse(status_code, body.getvalue(), response_headers)
+
+    def close(self):
+        # Each request owns and closes its Curl handle.
+        return None
+
