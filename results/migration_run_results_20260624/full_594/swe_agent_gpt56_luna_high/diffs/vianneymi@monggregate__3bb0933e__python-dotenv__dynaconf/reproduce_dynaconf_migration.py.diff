--- a/reproduce_dynaconf_migration.py
+++ b/reproduce_dynaconf_migration.py
@@ -0,0 +1,25 @@
+"""Exercise the migrated configuration dependency and its documented usage."""
+import os
+import tempfile
+from pathlib import Path
+
+from dynaconf import Dynaconf
+
+root = Path(__file__).parent
+for filename in ("requirements.txt", "requirements/testing.txt"):
+    contents = (root / filename).read_text()
+    assert "dynaconf==3.3.5" in contents
+    assert "python-dotenv" not in contents
+
+assert "from dotenv import" not in (root / "readme.md").read_text()
+assert "from dotenv import" not in (root / "docs/index.md").read_text()
+
+with tempfile.TemporaryDirectory() as directory:
+    previous_directory = Path.cwd()
+    try:
+        os.chdir(directory)
+        Path(".env").write_text("MONGODB_PASSWORD=loaded-by-dynaconf\n")
+        settings = Dynaconf(load_dotenv=True, envvar_prefix=False)
+        assert settings.MONGODB_PASSWORD == "loaded-by-dynaconf"
+    finally:
+        os.chdir(previous_directory)
