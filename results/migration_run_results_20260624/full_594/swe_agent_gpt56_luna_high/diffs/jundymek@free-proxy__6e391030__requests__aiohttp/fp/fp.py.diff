+_NETWORK_ERRORS = (aiohttp.ClientError, asyncio.TimeoutError, OSError)
+
+
+def _run_async(coroutine):
+    """Run an async operation while preserving the synchronous public API.
+
+    ``FreeProxy`` predates the move to aiohttp and its public methods are
+    synchronous.  ``asyncio.run`` is sufficient for normal callers, but it
+    cannot be called while another event loop is running (for example, from a
+    notebook).  In that case run the coroutine in a short-lived worker thread.
+    """
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coroutine)
+
+    import threading
+
+    result = []
+    error = []
+
+    def runner():
+        try:
+            result.append(asyncio.run(coroutine))
+        except BaseException as exc:  # re-raise in the calling thread
+            error.append(exc)
+
+    thread = threading.Thread(target=runner)
+    thread.start()
+    thread.join()
+    if error:
+        raise error[0]
+    return result[0]
+
+
+def _peer_host(peername):
+    """Return the host portion of an asyncio transport peer name."""
+    if isinstance(peername, tuple):
+        return peername[0]
+    return peername
+
+
+def _same_host(left, right):
+    """Compare IP addresses without making IPv4/IPv6 formatting assumptions."""
+    try:
+        return ipaddress.ip_address(left) == ipaddress.ip_address(right)
+    except (TypeError, ValueError):
+        return left == right
 
 
