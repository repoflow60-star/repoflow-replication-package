+class _LegacySyncRequestAdapter:
+    """Small compatibility hook for callers that patch ``client.requests``.
+
+    The public implementation uses urllib3 directly.  Keeping this adapter
+    avoids breaking applications (and older integrations) that patched the
+    old requests module at this import location.
+    """
+
+    @staticmethod
+    def get(url, **kwargs):
+        return urllib3.request("GET", url, **kwargs)
+
+
+# This is not the requests package.  It is retained only as a compatibility
+# seam for code that used to patch chessdotcom.client.requests.
+_LEGACY_SYNC_REQUEST_ADAPTER = _LegacySyncRequestAdapter()
+requests = _LEGACY_SYNC_REQUEST_ADAPTER
+
+
+def _response_status(response):
+    """Return the status from either an urllib3 or legacy response object."""
+    status = getattr(response, "status", None)
+    if isinstance(status, int):
+        return status
+    return response.status_code
+
+
+def _response_text(response):
+    """Return response text from either an urllib3 or legacy response object."""
+    text = getattr(response, "text", None)
+    if isinstance(text, str):
+        return text
+
+    data = response.data
+    if isinstance(data, str):
+        return data
+    return data.decode("utf-8")
+
+
+def _urllib3_request(url, options):
+    """Issue a GET request while translating the old SSL/proxy options."""
+    options = dict(options)
+    verify = options.pop("verify", True)
+
+    pool_options = {}
+    if verify is False:
+        pool_options["cert_reqs"] = ssl.CERT_NONE
+    elif isinstance(verify, str):
+        pool_options["cert_reqs"] = ssl.CERT_REQUIRED
+        pool_options["ca_certs"] = verify
+    # urllib3's default SSL configuration already verifies certificates, so
+    # the common ``verify=True`` case can use its shared pool.
+
+    # requests silently omits headers whose values are None.  urllib3 expects
+    # header values to be strings, so apply the same behavior here.
+    if "headers" in options and options["headers"] is not None:
+        options["headers"] = {
+            key: value for key, value in options["headers"].items() if value is not None
+        }
+
+    proxy_url = options.pop("proxy", None)
+    proxies = options.pop("proxies", None)
+    if proxy_url is None and isinstance(proxies, dict):
+        proxy_url = proxies.get("https") or proxies.get("http")
+
+    if proxy_url is not None:
+        pool_options["proxy_headers"] = options.pop("proxy_headers", None)
+        pool_options = {
+            key: value for key, value in pool_options.items() if value is not None
+        }
+        pool = urllib3.ProxyManager(proxy_url, **pool_options)
+        return pool.request("GET", url, timeout=30, **options)
+
+    # The top-level helper uses urllib3's shared pool.  Use a PoolManager only
+    # when low-level SSL configuration is needed, since the helper does not
+    # accept cert_reqs/ca_certs itself.
+    if pool_options:
+        pool = urllib3.PoolManager(**pool_options)
+        return pool.request("GET", url, timeout=30, **options)
+    return urllib3.request("GET", url, timeout=30, **options)
 
 
