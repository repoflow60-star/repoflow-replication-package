+# Keep one connection pool for each TLS verification mode.  urllib3 exposes
+# lower-level responses, so the small helpers below centralise
+# the options and response handling used by the URL loaders.
+_HTTP_POOLS = {}
+
+
+def _get_http_pool(verify_ssl):
+    """Return a connection pool configured for the requested TLS mode."""
+    verify_ssl = bool(verify_ssl)
+    if verify_ssl not in _HTTP_POOLS:
+        _HTTP_POOLS[verify_ssl] = urllib3.PoolManager(
+            cert_reqs=ssl.CERT_REQUIRED if verify_ssl else ssl.CERT_NONE
+        )
+    return _HTTP_POOLS[verify_ssl]
+
+
+def _http_request(method, url, verify_ssl=True, timeout=None, headers=None,
+                  fields=None, redirect=True):
+    """Make an HTTP request using urllib3 with the loader's options."""
+    return _get_http_pool(verify_ssl).request(
+        method,
+        url,
+        headers=headers,
+        fields=fields,
+        timeout=timeout,
+        redirect=redirect,
+        preload_content=True,
+        decode_content=True
+    )
+
+
+def _raise_for_status(response):
+    """Raise an urllib3 error for an unsuccessful HTTP response."""
+    if response.status >= 400:
+        raise urllib3.exceptions.HTTPError(
+            "HTTP Error {}: {}".format(response.status, response.reason)
+        )
+
+
+def _response_json(response):
+    """Decode JSON from an urllib3 response."""
+    return response.json()
+
 
