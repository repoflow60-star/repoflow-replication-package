-import requests
+import pycurl
+
+
+class _PycurlResponse:
+    """Small response object used by the collector's HTTP client."""
+
+    def __init__(self, body: bytes, status_code: int) -> None:
+        self._body = body
+        self.status_code = status_code
+
+    def json(self) -> dict:
+        """Decode the response body as JSON."""
+        return json.loads(self._body)
+
+
+class _PycurlHttpClient:
+    """Provide the small GET interface needed by the collector."""
+
+    @staticmethod
+    def get(url: str, timeout: int) -> _PycurlResponse:
+        """Perform a GET request and return its body and status code."""
+        response_body = BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEDATA, response_body)
+            curl.setopt(pycurl.TIMEOUT, timeout)
+            curl.setopt(pycurl.FOLLOWLOCATION, True)
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        return _PycurlResponse(response_body.getvalue(), status_code)
+
+
+# Keep the old module attribute as an alias for callers that patched the
+# previous client while the implementation itself uses PycURL.
+http_client = _PycurlHttpClient()
+requests = http_client
 
