+from functools import wraps
+from typing import Any, Callable, Optional, TypeVar, cast, get_type_hints
+
+from apiclient_pydantic import serialize_all_methods
+from pydantic import parse_obj_as
+
+
+T = TypeVar('T')
+
+
+def serialize_response_async(schema=None):
+    """Async counterpart of apiclient-pydantic's response decorator."""
+    def decorator(func: Callable[..., Any]):
+        resolved_schema = schema or get_type_hints(func).get('return')
+
+        @wraps(func)
+        async def wrap(*args, **kwargs):
+            response = await func(*args, **kwargs)
+            if isinstance(response, (list, dict, tuple, set)) and resolved_schema:
+                return parse_obj_as(resolved_schema, response)
+            return response
+
+        return cast(Callable[..., T], wrap)
+
+    return decorator
 
