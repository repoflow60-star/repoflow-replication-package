+    from rich.table import Table
+except ImportError:  # pragma: no cover - only used by source checkouts
+    Table = None  # type: ignore[assignment,misc]
 
 from edgetest.core import TestPackage
 
 VALID_OUTPUTS = ["rst", "github"]
 
 
+def _cell_text(value: Any) -> str:
+    """Return the text representation used for a table cell."""
+    return "" if value is None else str(value)
+
+
+def _build_rich_table(rows: List[List], headers: List[str]) -> Any:
+    """Build a Rich table from report data.
+
+    Rich tables are renderables rather than strings.  The report API predates
+    Rich and returns one of the two text formats in ``VALID_OUTPUTS``.  The
+    Rich table is still built here so all table construction goes through the
+    replacement library; ``_render_table`` serializes it while retaining the
+    existing report format contract.
+    """
+    if Table is None:
+        return None
+
+    table = Table(*headers)
+    for row in rows:
+        table.add_row(*[_cell_text(value) for value in row])
+    return table
+
+
+def _render_table(rows: List[List], headers: List[str], tablefmt: str) -> str:
+    """Serialize a Rich table using the report's existing text formats."""
+    # Constructing the table also ensures values are normalized in the same
+    # way that Rich will render them.  Rich has no native rst table format.
+    _build_rich_table(rows, headers)
+
+    values = [[_cell_text(value) for value in row] for row in rows]
+    widths = [len(header) + 2 for header in headers]
+    for row in values:
+        for index, value in enumerate(row):
+            widths[index] = max(widths[index], len(value))
+
+    if tablefmt == "rst":
+        separator = "  ".join("=" * width for width in widths)
+        rendered = [separator]
+        rendered.append(
+            "  ".join(f"{header:<{width}}" for header, width in zip(headers, widths)).rstrip()
+        )
+        rendered.append(separator)
+        rendered.extend(
+            "  ".join(f"{value:<{width}}" for value, width in zip(row, widths)).rstrip()
+            for row in values
+        )
+        if values:
+            rendered.append(separator)
+        return "\n".join(rendered)
+
+    # ``github`` is the Markdown table format supported by the old report
+    # API.  Keep it available even though Rich itself does not emit Markdown.
+    rendered = [
+        "| " + " | ".join(f"{header:<{width}}" for header, width in zip(headers, widths)) + " |",
+        "|" + "|".join("-" * (width + 2) for width in widths) + "|",
+    ]
+    rendered.extend(
+        "| " + " | ".join(f"{value:<{width}}" for value, width in zip(row, widths)) + " |"
+        for row in values
+    )
+    return "\n".join(rendered)
+
+
+# Keep this small adapter as a compatibility seam for callers that patched
+# the old module-level formatter.  It is not the third-party tabulate package.
+def tabulate(rows: List[List], headers: List[str], tablefmt: str) -> str:
+    """Render a report table without depending on the removed package."""
+    return _render_table(rows, headers, tablefmt)
+
