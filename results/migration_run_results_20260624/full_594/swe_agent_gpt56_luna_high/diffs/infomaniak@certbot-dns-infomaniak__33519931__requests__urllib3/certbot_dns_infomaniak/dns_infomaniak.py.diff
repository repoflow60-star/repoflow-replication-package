+class _MountedRequest:
+    """Small request object used for compatibility with requests mock adapters.
+
+    The plugin itself uses urllib3.  Keeping this object private lets older
+    consumers that mount a requests-mock adapter on ``session`` continue to
+    exercise the client without making requests a runtime dependency.
+    """
+
+    def __init__(self, method, url, headers, body):
+        self.method = method
+        self.url = url
+        self.headers = headers
+        self.body = body
+
+
+class _PoolManager(urllib3.PoolManager):
+    """A urllib3 pool with a small ``mount`` compatibility hook."""
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self._mounted_adapters = {}
+
+    def mount(self, prefix, adapter):
+        """Mount a requests-mock adapter for compatibility with old tests."""
+        self._mounted_adapters[prefix] = adapter
+
+    def request(self, method, url, body=None, fields=None, headers=None, **kwargs):
+        for prefix in sorted(self._mounted_adapters, key=len, reverse=True):
+            if url.startswith(prefix):
+                if fields:
+                    separator = "&" if "?" in url else "?"
+                    url = url + separator + urlencode(fields, doseq=True)
+                request_headers = dict(self.headers)
+                if headers:
+                    request_headers.update(headers)
+                request = _MountedRequest(method, url, request_headers, body)
+                return self._mounted_adapters[prefix].send(request, **kwargs)
+        return super().request(
+            method, url, body=body, fields=fields, headers=headers, **kwargs
+        )
 
 
