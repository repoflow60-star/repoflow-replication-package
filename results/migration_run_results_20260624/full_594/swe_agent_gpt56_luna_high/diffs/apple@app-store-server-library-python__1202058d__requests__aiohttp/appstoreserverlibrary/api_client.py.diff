+def _run_async(coroutine):
+    """Run an aiohttp coroutine from a synchronous API.
+
+    The synchronous client can also be used by applications that already have
+    an event loop (for example, from an async web framework).  In that case a
+    short-lived worker thread is used rather than attempting to nest event
+    loops in the caller's thread.
+    """
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coroutine)
+
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        return executor.submit(asyncio.run, coroutine).result()
+
+
+class _AiohttpResponse:
+    """Small response adapter for the synchronous client."""
+
+    def __init__(self, status_code: int, headers: MutableMapping, content: bytes):
+        self.status_code = status_code
+        self.headers = headers
+        self._content = content
+
+    def json(self):
+        return json_lib.loads(self._content)
+
+
+def _is_json_content_type(headers: MutableMapping) -> bool:
+    content_type = next(
+        (value for key, value in headers.items() if key.lower() == 'content-type'),
+        None,
+    )
+    return content_type is not None and content_type.split(';', 1)[0].strip().lower() == 'application/json'
+
 
