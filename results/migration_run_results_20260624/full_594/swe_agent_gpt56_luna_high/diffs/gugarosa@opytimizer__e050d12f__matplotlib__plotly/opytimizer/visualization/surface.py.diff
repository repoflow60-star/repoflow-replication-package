+
+# ``winter`` was the public default before the Plotly migration. Keep it
+# available as a small custom Plotly colorscale so existing calls do not fail,
+# while allowing all of Plotly's named scales.
+_LEGACY_COLOR_SCALES = {
+    "winter": [[0.0, "rgb(0, 0, 255)"], [1.0, "rgb(0, 255, 255)"]],
+}
+
+
+def _get_colorscale(style: str):
+    """Return a Plotly colorscale for a legacy or Plotly style name."""
+
+    if not isinstance(style, str):
+        return style
+
+    if style.lower() in _LEGACY_COLOR_SCALES:
+        return _LEGACY_COLOR_SCALES[style.lower()]
+
+    # ``get_colorscale`` provides validation and supports Plotly's built-in
+    # names (case-insensitively), rather than passing an invalid name to the
+    # graph object and producing a less useful validation error later.
+    return colors.get_colorscale(style)
 
 
