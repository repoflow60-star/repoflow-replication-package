+class _PycurlResponse:
+    """Small response object exposing the values used by the client."""
+
+    def __init__(self, status_code, text, headers):
+        self.status_code = status_code
+        self.text = text
+        self.headers = headers
+
+
+class _PycurlTransport:
+    """Synchronous HTTP transport implemented with :mod:`pycurl`.
+
+    The transport deliberately has a ``get`` method with the same call shape as
+    the old synchronous transport.  Apart from keeping the client code small,
+    this also leaves a stable seam for applications that replace the transport
+    in tests; no ``requests`` package is used here.
+    """
+
+    @staticmethod
+    def _header_callback(response_headers):
+        def callback(line):
+            if isinstance(line, bytes):
+                line = line.decode("iso-8859-1")
+
+            # A response can contain an interim status (for example 100
+            # Continue) or several header blocks when redirects are enabled.
+            # Keep the headers belonging to the last status line.
+            if line.startswith(("HTTP/", "ICY ")):
+                response_headers.clear()
+                return len(line)
+
+            if ":" in line:
+                name, value = line.split(":", 1)
+                response_headers[name.strip()] = value.strip()
+            return len(line)
+
+        return callback
+
+    @staticmethod
+    def _header_values(headers):
+        if isinstance(headers, Mapping):
+            return [
+                f"{name}: {value}"
+                for name, value in headers.items()
+                if value is not None
+            ]
+        return list(headers or [])
+
+    def get(self, url, headers=None, timeout=30, **options):
+        body = io.BytesIO()
+        response_headers = {}
+        curl = pycurl.Curl()
+
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEDATA, body)
+            curl.setopt(
+                pycurl.HEADERFUNCTION,
+                self._header_callback(response_headers),
+            )
+            curl.setopt(pycurl.TIMEOUT, timeout)
+            curl.setopt(pycurl.HTTPHEADER, self._header_values(headers))
+
+            verify = options.get("verify", options.get("verify_ssl", True))
+            curl.setopt(pycurl.SSL_VERIFYPEER, int(bool(verify)))
+            curl.setopt(pycurl.SSL_VERIFYHOST, 2 if verify else 0)
+
+            # ``proxy`` is convenient for pycurl callers, while ``proxies``
+            # keeps the commonly used requests-style configuration working.
+            proxy = options.get("proxy")
+            if proxy is None:
+                proxies = options.get("proxies") or {}
+                scheme = urlparse(url).scheme
+                if isinstance(proxies, Mapping):
+                    proxy = proxies.get(scheme) or proxies.get("all")
+            if proxy:
+                curl.setopt(pycurl.PROXY, proxy)
+
+            if options.get("proxy_port") is not None:
+                curl.setopt(pycurl.PROXYPORT, int(options["proxy_port"]))
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            text = body.getvalue().decode("utf-8")
+            return _PycurlResponse(status_code, text, response_headers)
+        finally:
+            curl.close()
+
+
+# Kept as a module-level transport seam for backwards-compatible test patches.
+# This is an in-process pycurl adapter, not the third-party requests library.
+requests = _PycurlTransport()
