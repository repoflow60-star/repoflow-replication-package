+class SynchronousFuturesSession(FuturesSession):
+    """A ``FuturesSession`` with the response-oriented Session API.
+
+    ``requests_futures`` returns a ``Future`` from every request method.  The
+    SDK's public methods, however, have always returned a response and make
+    use of response methods such as ``json`` and ``raise_for_status``.  Waiting
+    here keeps that API stable while making all HTTP traffic use the migrated
+    client.
+    """
+    def request(self, *args, **kwargs):
+        return super().request(*args, **kwargs).result()
+
+
+# Keep a single client for the module-level request helpers, just as requests
+# does for its adapter configuration.  A synchronous session is also exposed
+# below for code that uses ``requests.Session()`` through this wrapper.
+_session = SynchronousFuturesSession()
+
