+def _new_tdes(key: bytes, mode: int, iv: _typing.Optional[bytes] = None) -> _typing.Any:
+    # PyCryptodome's DES3 implementation only accepts 16- or 24-byte
+    # keys.  A single DES key is equivalent to K1=K2=K3.  It also rejects
+    # keys that are mathematically equivalent to single DES, so handle those
+    # explicitly.
+    des_key: _typing.Optional[bytes] = None
+    if len(key) == 8:
+        des_key = key
+    elif len(key) in {16, 24}:
+        components = [
+            bytes(value & 0xFE for value in key[offset : offset + 8])
+            for offset in range(0, len(key), 8)
+        ]
+        if components[0] == components[1]:
+            des_key = key[-8:] if len(key) == 24 else key[:8]
+        elif len(key) == 24 and components[1] == components[2]:
+            des_key = key[:8]
+
+    cipher: _typing.Any = _DES if des_key is not None else _DES3
+    key = des_key if des_key is not None else key
+    if iv is None:
+        return cipher.new(key, mode)
+    return cipher.new(key, mode, iv)
