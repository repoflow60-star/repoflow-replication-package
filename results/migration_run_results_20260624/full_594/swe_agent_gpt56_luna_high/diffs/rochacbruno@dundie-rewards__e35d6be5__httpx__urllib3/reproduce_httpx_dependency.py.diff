--- a/reproduce_httpx_dependency.py
+++ b/reproduce_httpx_dependency.py
@@ -0,0 +1,25 @@
+"""Exercise the exchange client after the httpx -> urllib3 migration."""
+import json
+from types import SimpleNamespace
+
+from dundie.utils import exchange
+
+calls = []
+
+
+def fake_request(method, url):
+    calls.append((method, url))
+    return SimpleNamespace(
+        status=200,
+        data=json.dumps(
+            {"USDBRL": {"high": "5.50", "code": "USD", "codein": "BRL"}}
+        ).encode(),
+    )
+
+
+exchange.urllib3.request = fake_request
+rates = exchange.get_rates(["USD", "BRL"])
+assert calls == [("GET", "https://economia.awesomeapi.com.br/json/last/USD-BRL")]
+assert rates["USD"].value == 1
+assert rates["BRL"].value == 5.50
+print("urllib3 exchange request succeeded")
