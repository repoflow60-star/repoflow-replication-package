+class Urllib3Session:
+    """Small convenience-method facade backed by urllib3 managers.
+
+    Keeping the two convenience methods makes the rest of the module easy to
+    read, while the actual HTTP implementation (including proxy handling) is
+    provided by urllib3.
+    """
+
+    def __init__(self):
+        self._managers = {}
+
+    def _manager(self, url: str, verify: bool, proxies: dict | None):
+        proxy_url = None
+        if proxies:
+            proxy_url = proxies.get('https' if url.startswith('https:') else 'http')
+
+        key = (proxy_url, verify)
+        if key in self._managers:
+            return self._managers[key]
+
+        cert_reqs = ssl.CERT_REQUIRED if verify else ssl.CERT_NONE
+        if proxy_url:
+            if proxy_url.startswith(('socks4://', 'socks4a://', 'socks5://', 'socks5h://')):
+                from urllib3.contrib.socks import SOCKSProxyManager
+
+                manager = SOCKSProxyManager(proxy_url, cert_reqs=cert_reqs)
+            else:
+                manager = urllib3.ProxyManager(proxy_url, cert_reqs=cert_reqs)
+        else:
+            manager = urllib3.PoolManager(cert_reqs=cert_reqs)
+
+        self._managers[key] = manager
+        return manager
+
+    def request(
+        self,
+        method: str,
+        url: str,
+        *,
+        body=None,
+        headers: dict | None = None,
+        verify: bool = True,
+        proxies: dict | None = None,
+    ):
+        manager = self._manager(url, verify, proxies)
+        return manager.request(method, url, body=body, headers=headers)
+
+    def get(self, url: str, **kwargs):
+        return self.request('GET', url, **kwargs)
+
+    def post(self, url: str, *, data=None, **kwargs):
+        return self.request('POST', url, body=data, **kwargs)
+
+
+REQ_SESSION = Urllib3Session()
 
