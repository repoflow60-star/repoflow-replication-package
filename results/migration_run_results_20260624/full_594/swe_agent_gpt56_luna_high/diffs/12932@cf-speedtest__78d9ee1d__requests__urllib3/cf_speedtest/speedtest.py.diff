+def _raise_for_status(response) -> None:
+    """Raise urllib3's HTTP error for an unsuccessful response."""
+    # The first branch also keeps the facade useful
+    # with callers that provide a response mock.
+    raise_for_status = getattr(response, 'raise_for_status', None)
+    if callable(raise_for_status):
+        raise_for_status()
+        return
+
+    status = getattr(response, 'status', None)
+    if isinstance(status, int) and status >= 400:
+        raise urllib3.exceptions.HTTPError(
+            f'HTTP {status} response from {getattr(response, "url", "")}',
+        )
+
+
+def _response_content(response):
+    """Return response bytes for either urllib3 or a response-like object."""
+    data = getattr(response, 'data', None)
+    if isinstance(data, (bytes, bytearray)):
+        return bytes(data)
+    return getattr(response, 'content', b'')
+
+
+def _response_text(response) -> str:
+    text = getattr(response, 'text', None)
+    if isinstance(text, str):
+        return text
+
+    data = _response_content(response)
+    if isinstance(data, str):
+        return data
+    return data.decode('utf-8', errors='replace')
+
 
