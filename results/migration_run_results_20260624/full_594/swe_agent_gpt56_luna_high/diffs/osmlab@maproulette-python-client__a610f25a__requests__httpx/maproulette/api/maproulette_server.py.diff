+    @classmethod
+    def _connection_error(cls, error):
+        """Convert an httpx transport error to the public API exception.
+
+        httpx transport errors do not expose a response attribute, so status
+        and response message are optional here.
+        """
+        response = getattr(error, "response", None)
+        if response is None:
+            return ConnectionUnavailableError()
+        return ConnectionUnavailableError(
+            message=cls.parse_response_message(response),
+            status=response.status_code
+        )
 
