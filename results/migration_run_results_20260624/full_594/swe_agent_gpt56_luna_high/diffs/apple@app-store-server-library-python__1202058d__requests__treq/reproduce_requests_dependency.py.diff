--- a/reproduce_requests_dependency.py
+++ b/reproduce_requests_dependency.py
@@ -0,0 +1,15 @@
+"""Show the HTTP dependencies currently used by the library."""
+import ast
+from pathlib import Path
+
+sources = [Path("appstoreserverlibrary/api_client.py"), Path("appstoreserverlibrary/signed_data_verifier.py")]
+for source in sources:
+    tree = ast.parse(source.read_text())
+    imports = [node.names[0].name for node in ast.walk(tree)
+               if isinstance(node, ast.Import) and node.names[0].name in {"requests", "treq"}]
+    print(f"{source}: {imports}")
+
+try:
+    import treq
+except ModuleNotFoundError as error:
+    print(f"treq unavailable: {error}")
