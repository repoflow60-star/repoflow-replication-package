+# Copyright (c) 2023 Apple Inc. Licensed under MIT License.
+
+"""Small synchronous adapters around treq.
+
+The public API client is intentionally synchronous, while treq is built on
+Twisted and therefore returns Deferreds.  This module keeps the public API
+synchronous without bringing requests back as a transitive runtime
+requirement.  A private reactor is used for each call, so this does not
+install or stop the application's reactor.
+"""
+
+import json as json_module
+from typing import Any, Dict, List, Optional, Union
+
+import treq
+from twisted.internet.selectreactor import SelectReactor
+from twisted.python.failure import Failure
+
+
+class Response:
+    """The small, requests-like response surface used by this package."""
+
+    def __init__(self, response: Any, content: bytes):
+        self.status_code = response.code
+        self.headers = self._headers(response)
+        self.content = content
+
+    @staticmethod
+    def _headers(response: Any) -> Dict[str, str]:
+        headers: Dict[str, str] = {}
+        for name, values in response.headers.getAllRawHeaders():
+            if isinstance(name, bytes):
+                name = name.decode("latin-1")
+            value = values[0] if values else b""
+            if isinstance(value, bytes):
+                value = value.decode("latin-1")
+            headers[str(name).lower()] = str(value)
+        return headers
+
+    def json(self) -> Any:
+        return json_module.loads(self.content.decode("utf-8"))
+
+
+def _request(
+    request_function: Any,
+    url: str,
+    *,
+    method: Optional[str] = None,
+    params: Optional[Dict[str, Union[str, List[str]]]] = None,
+    headers: Optional[Dict[str, str]] = None,
+    json: Any = None,
+    data: Optional[bytes] = None,
+) -> Response:
+    reactor = SelectReactor()
+    result: List[Any] = []
+
+    kwargs: Dict[str, Any] = {"reactor": reactor}
+    if params is not None:
+        kwargs["params"] = params
+    if headers is not None:
+        kwargs["headers"] = headers
+    if json is not None:
+        kwargs["json"] = json
+    if data is not None:
+        kwargs["data"] = data
+
+    if method is None:
+        deferred = request_function(url, **kwargs)
+    else:
+        deferred = request_function(method, url, **kwargs)
+
+    def read_content(response: Any) -> Any:
+        return response.content().addCallback(lambda content: Response(response, content))
+
+    def finish(value: Any) -> Any:
+        result.append(value)
+        if reactor.running:
+            reactor.stop()
+        return value
+
+    deferred.addCallback(read_content)
+    deferred.addBoth(finish)
+    reactor.run()
+
+    value = result[0]
+    if isinstance(value, Failure):
+        value.raiseException()
+    return value
+
+
+def request(
+    method: str,
+    url: str,
+    *,
+    params: Optional[Dict[str, Union[str, List[str]]]] = None,
+    headers: Optional[Dict[str, str]] = None,
+    json: Any = None,
+) -> Response:
+    return _request(treq.request, url, method=method, params=params, headers=headers, json=json)
+
+
+def post(url: str, *, headers: Optional[Dict[str, str]] = None, data: Optional[bytes] = None) -> Response:
+    return _request(treq.post, url, headers=headers, data=data)
