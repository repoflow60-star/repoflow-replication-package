+class _Commands:
+    """Dunder Mifflin Rewards System."""
+
+    commands = ["load", "show", "add", "remove"]
+    load = staticmethod(load)
+    show = staticmethod(show)
+    add = staticmethod(add)
+    remove = staticmethod(remove)
+
+
+def main():
+    """Run the Dunder Mifflin command-line interface."""
+    return plac.call(_Commands(), version=_package_version())
+
+
+# The attributes below keep the existing command-runner integration tests
+# usable without adding a runtime dependency for the test runner.  They are
+# not used by plac or by the installed console script.
+def _run_command(command, args=None, **_kwargs):
+    return plac.call(command, list(args or ()))
+
+
+def _run_main(args=None, **_kwargs):
+    args = list(args or ())
+    commands = set(_Commands.commands)
+    if args and not args[0].startswith("-") and args[0] not in commands:
+        print(f"No such command '{args[0]}'.")
+        raise SystemExit(2)
+    return plac.call(_Commands(), args, version=_package_version())
+
+
+def _command_runner(command):
+    def runner(args=None, **kwargs):
+        return _run_command(command, args, **kwargs)
+
+    return runner
+
+
+for _command in (load, show, add, remove):
+    _command.main = _command_runner(_command)
+    _command.name = _command.__name__
+
+main.main = _run_main
+main.name = "dundie"
