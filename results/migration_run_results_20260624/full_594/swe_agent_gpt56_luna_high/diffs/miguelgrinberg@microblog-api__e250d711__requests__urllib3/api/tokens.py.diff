+class _HTTPResponse:
+    def __init__(self, response):
+        self.status_code = response.status
+        self._response = response
+
+    def json(self):
+        return json.loads(self._response.data.decode('utf-8'))
+
+
+class _HTTPClient:
+    def __init__(self):
+        self._pool = urllib3.PoolManager()
+
+    def post(self, url, data=None, headers=None):
+        response = self._pool.request(
+            'POST', url, fields=data, encode_multipart=False,
+            headers=headers)
+        return _HTTPResponse(response)
+
+    def get(self, url, headers=None):
+        response = self._pool.request('GET', url, headers=headers)
+        return _HTTPResponse(response)
+
+
+# Keep the old module attribute as an alias for callers that patch the OAuth
+# client, while using urllib3 for all actual HTTP requests.
+http = _HTTPClient()
+requests = http
 
 tokens = Blueprint('tokens', __name__)
 token_schema = TokenSchema()
