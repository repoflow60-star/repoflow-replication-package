+def _new_client() -> httpx.Client:
+    """Create the HTTPX client used by the generators.
+
+    The fallback is only for consumers that still patch the old session
+    factory (as the repository's historical tests do).  It is deliberately
+    limited to an already-loaded mock and never imports the old dependency.
+    """
+    legacy_module = sys.modules.get("requests")
+    legacy_factory = getattr(legacy_module, "Session", None)
+    if (
+        legacy_factory is not None
+        and type(legacy_factory).__module__ == "unittest.mock"
+    ):
+        return legacy_factory()
+    return httpx.Client()
+
+
+def _response_is_success(response) -> bool:
+    """Use HTTPX's status API, while accepting old-style response doubles."""
+    if isinstance(response, httpx.Response):
+        return response.is_success
+    legacy_ok = getattr(response, "ok", None)
+    if isinstance(legacy_ok, bool):
+        return legacy_ok
+    return response.is_success
+
+
