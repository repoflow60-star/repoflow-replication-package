+def _figure(fig=None):
+    """Return a Plotly figure, reusing one supplied by the caller.
+
+    ``ax`` is retained in the public plotting signatures so existing calls do
+    not fail, but Plotly figures do not have
+    an equivalent axis object and it is consequently ignored.
+    """
+    if fig is None:
+        return go.Figure()
+    if not isinstance(fig, go.Figure):
+        raise TypeError("'fig' must be a plotly.graph_objects.Figure")
+    return fig
+
