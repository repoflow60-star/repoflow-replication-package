+def render_syntax(text: str, lexer: str, width: int) -> str:
+    '''Render syntax-highlighted text for a terminal.'''
+    # ``format_to_text`` and the diff command both include a final newline.
+    # Syntax adds the line ending when it renders, so avoid turning that into
+    # an extra blank line.
+    code = text[:-1] if text.endswith('\n') else text
+    # Syntax otherwise crops lines wider than the Console.  Formatting output
+    # must never discard data, so allow the longest source line to render.
+    console_width = max(width, max((cell_len(line) for line in code.splitlines()),
+                                   default=1))
+    console = Console(file=io.StringIO(), record=True, force_terminal=True,
+                      color_system='standard', width=console_width)
+    console.print(Syntax(code, lexer, theme='ansi_dark'), end='')
+    return console.export_text(styles=True)
 
 
