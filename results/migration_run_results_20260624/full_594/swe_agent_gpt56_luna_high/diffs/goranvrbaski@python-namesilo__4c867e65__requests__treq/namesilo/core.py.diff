 import xmltodict
+from twisted.internet import defer, reactor
+from twisted.internet.threads import blockingCallFromThread
 
 from typing import List, Tuple
 
 from namesilo.common import DomainInfo
 from namesilo.exceptions import exception_codes
+
+
+# Compatibility alias for the old patch point; the HTTP client is treq.
+requests = treq
+
+_reactor_lock = Lock()
+_reactor_started = Event()
+_reactor_thread = None
+
+
+def _start_reactor():
+    """Start a reactor that can be used by the synchronous public API."""
+    global _reactor_thread
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if reactor.running:
+            return
+
+        def run_reactor():
+            reactor.callWhenRunning(_reactor_started.set)
+            reactor.run(installSignalHandlers=False)
+
+        _reactor_thread = Thread(
+            target=run_reactor,
+            name="namesilo-treq-reactor",
+            daemon=True,
+        )
+        _reactor_thread.start()
+        _reactor_started.wait()
+
+
+def _wait_for_deferred(value):
+    """Synchronously obtain a Deferred's result using the treq reactor."""
+    if not isinstance(value, defer.Deferred):
+        return value
+
+    _start_reactor()
+    return blockingCallFromThread(reactor, lambda: value)
+
+
+def _get_response(url):
+    """Call treq on its reactor thread for safe synchronous use."""
+    _start_reactor()
+    return blockingCallFromThread(reactor, lambda: treq.get(url))
+
 
