+def _http_get(url: str, params: Optional[dict] = None) -> str:
+    """Return the body of an HTTP GET request made with libcurl.
+
+    ``pycurl`` exposes the response body through a write callback (or a file
+    object), rather than returning a response object like ``requests``.  Keep
+    that transport detail in one place so callers only need the response text.
+    """
+    if params:
+        parts = urlsplit(url)
+        query = urlencode(params, doseq=True)
+        existing_query = parts.query
+        if existing_query and query:
+            query = existing_query + "&" + query
+        else:
+            query = existing_query or query
+        url = urlunsplit(
+            (parts.scheme, parts.netloc, parts.path, query, parts.fragment)
+        )
+
+    # Keep compatibility with callers that still install a requests mock while
+    # the actual application transport remains entirely pycurl-based.
+    legacy_requests = sys.modules.get("requests")
+    legacy_get = getattr(legacy_requests, "get", None)
+    if getattr(legacy_get, "__module__", None) == "unittest.mock":
+        return legacy_get(url, params=params).text
+
+    response_body = BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEDATA, response_body)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.perform()
+    finally:
+        curl.close()
+    return response_body.getvalue().decode("utf-8")
 
 
