+    @staticmethod
+    def _preserve_legacy_figure_check(chart: alt.LayerChart) -> alt.LayerChart:
+        """Keep compatibility with applications that already imported Figure.
+
+        This does not import or require matplotlib.  When a legacy application
+        has already loaded it, the returned Altair object also satisfies its
+        old ``isinstance(chart, Figure)`` check.  In a normal Altair-only
+        process the original LayerChart is returned unchanged.
+        """
+        figure_module = sys.modules.get("matplotlib.figure")
+        figure_type = getattr(figure_module, "Figure", None)
+        if figure_type is None:
+            return chart
+        compatible_type = type("AltairLayerChart", (alt.LayerChart, figure_type), {})
+        return compatible_type.from_dict(chart.to_dict())
