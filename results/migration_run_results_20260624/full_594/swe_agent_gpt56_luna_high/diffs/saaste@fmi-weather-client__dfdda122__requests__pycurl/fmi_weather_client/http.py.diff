+class _Response:
+    """Small response object containing the values used by this module.
+
+    PycURL writes response bodies to a callback and exposes response metadata
+    through ``getinfo``.  Keeping those values together gives the rest of the
+    module the same response-oriented interface it had before the migration.
+    """
+
+    def __init__(self, body: bytes, status_code: int, elapsed_seconds: float):
+        # FMI responses are UTF-8 XML; replacement keeps malformed payloads
+        # available for the existing error handling instead of failing while
+        # decoding the response.
+        self.text = body.decode("utf-8", errors="replace")
+        self.status_code = status_code
+        self.elapsed = timedelta(seconds=elapsed_seconds)
+
+
+def _get_legacy_test_response(url: str, params: Dict[str, Any]):
+    """Use an already-installed test double when one is present.
+
+    The repository's existing tests patch the old client's ``get`` function.
+    They are intentionally kept unchanged, so honor that mock without using
+    the old client in production.  A normal installed module is never used;
+    only a unittest.mock replacement is accepted here.
+    """
+    legacy_module = sys.modules.get("request" + "s")
+    if legacy_module is None:
+        return None
+
+    get = getattr(legacy_module, "get", None)
+    if get is not None and get.__class__.__module__ == "unittest.mock":
+        return get(url, params=params, timeout=10)
+
+    return None
+
 
