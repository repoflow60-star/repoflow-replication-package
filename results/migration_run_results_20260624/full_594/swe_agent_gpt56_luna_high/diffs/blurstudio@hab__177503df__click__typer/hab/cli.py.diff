+def _uri_callback(value, ctx: typer.Context, param: typer_click.Parameter):
+    prompt = True
+    """Typer callback implementing Hab's URI conversion and preference rules."""
+    settings = ctx.obj
+    required = getattr(param, "required", False)
+    if value is None:
+        result = UsageError("Missing argument 'URI'")
+        if required:
+            raise result
+        return result
+
+    if value == "-":
+        uri_check = settings.resolver.user_prefs().uri_check()
+        if not prompt:
+            return uri_check
+        if uri_check.uri is None:
+            value = typer.prompt(
+                "No URI exists.\nPlease Enter a URI", type=str, err=True
+            )
+            settings.resolver.user_prefs().uri = value
+            typer.echo("Saved hab user prefs", err=True)
+            return value
+        if uri_check.timedout:
+            logger.info(
+                f"{Fore.RED}Invalid 'URI' preference: {Fore.RESET}"
+                f"The saved URI {Fore.LIGHTBLUE_EX}{uri_check.uri}{Fore.RESET} "
+                "has expired."
+            )
+            value = typer.prompt(
+                "Please enter a new URI...\n"
+                "Or press ENTER to reuse the expired URI:"
+                f" [{Fore.LIGHTBLUE_EX}{uri_check.uri}{Fore.RESET}]",
+                default=uri_check.uri,
+                show_default=False,
+                type=str,
+                err=True,
+            )
+            if value:
+                settings.resolver.user_prefs().uri = value
+                typer.echo("Saving hab user prefs", err=True)
+                return value
+            if required:
+                raise UsageError("A URI is required for Hab use.")
+        else:
+            typer.echo(
+                f"Using {Fore.LIGHTBLUE_EX}{uri_check.uri}{Fore.RESET} "
+                "from hab user prefs",
+                err=True,
+            )
+            return uri_check.uri
+
+    if re.match(r"^v\d+:", value):
+        return utils.decode_freeze(value)
+
+    try:
+        cpath = Path(value).expanduser().resolve()
+        if cpath.exists():
+            return utils.json.load(cpath.open())
+    except (OSError, ValueError):
+        raise typer.BadParameter(
+            f"{value!r} is not a valid frozen file path."
+        ) from None
+
+    if settings.enable_user_prefs_save:
+        settings.resolver.user_prefs().uri = value
+    settings.uri = value
+    return value
+
