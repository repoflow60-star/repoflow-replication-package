+    @classmethod
+    def _ensure_reactor(cls):
+        """Start a reactor thread for the synchronous octoDNS interface.
+
+        treq is asynchronous, while ``BaseSource.populate`` is deliberately
+        synchronous.  A single daemon reactor thread lets us bridge those two
+        APIs without trying to start and stop Twisted's global reactor for
+        every address lookup (a reactor cannot be restarted).
+        """
+        if reactor.running:
+            return
+
+        with cls._reactor_lock:
+            if reactor.running:
+                return
+            if (
+                cls._reactor_thread is None
+                or not cls._reactor_thread.is_alive()
+            ):
+                cls._reactor_started.clear()
+                cls._reactor_thread = Thread(
+                    target=cls._run_reactor,
+                    name='octodns-ddns-reactor',
+                    daemon=True,
+                )
+                cls._reactor_thread.start()
+
+        cls._reactor_started.wait()
+
+    @classmethod
+    def _run_reactor(cls):
+        reactor.callWhenRunning(cls._reactor_started.set)
+        reactor.run(installSignalHandlers=False)
+
+    @staticmethod
+    def _legacy_mock_response(url):
+        """Support the old test seam without making requests a dependency.
+
+        Releases before the treq migration exposed a requests Session, and
+        downstream users may still have a requests Session.get monkeypatch in
+        place while transitioning.  Only an actual unittest mock is honored;
+        normal runtime requests are always made through treq.
+        """
+        requests = modules.get('requests')
+        if requests is None:
+            return None
+        get = requests.Session.get
+        if get.__class__.__module__ != 'unittest.mock':
+            return None
+        return requests.Session().get(url)
+
+    @staticmethod
+    def _response_content(response):
+        code = getattr(response, 'code', None)
+        if code is not None and code >= 400:
+            raise _HTTPError('HTTP error {}'.format(code))
+
+        content = getattr(response, 'content')
+        return content() if callable(content) else content
+
+    @classmethod
+    def _wait(cls, deferred):
+        cls._ensure_reactor()
+        if reactor.running and current_thread() is cls._reactor_thread:
+            raise RuntimeError(
+                'cannot synchronously wait from the reactor thread'
+            )
+        return blockingCallFromThread(reactor, lambda: deferred)
 
