+def _format_color(output, lexer):
+    from rich.cells import cell_len
+    from rich.console import Console
+    from rich.syntax import Syntax
+
+    code = output.rstrip('\n')
+    width = max((cell_len(line.expandtabs(4)) for line in code.splitlines()), default=1)
+    console = Console(force_terminal=True, color_system='standard', width=width)
+    with console.capture() as capture:
+        console.print(Syntax(code, lexer, theme='ansi_dark', padding=0), end='')
+    return capture.get()
+
