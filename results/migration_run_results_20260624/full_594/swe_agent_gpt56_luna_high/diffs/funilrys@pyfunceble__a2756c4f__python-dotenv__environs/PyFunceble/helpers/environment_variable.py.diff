+def _read_env_file(path: Optional[str]) -> dict:
+    """Read an environment file using :mod:`environs`.
+
+    ``Env.read_env`` intentionally keeps values on the ``Env`` instance rather
+    than modifying ``os.environ``.  Keeping that behavior here lets callers
+    read a file without changing the process environment, while
+    :func:`load_env_file` below provides the old loading behavior where it is
+    needed by the application.
+    """
+
+    if not path:
+        return {}
+
+    environment = Env(eager=False)
+    if not environment.read_env(path, recurse=False):
+        return {}
+
+    return dict(environment._environ)  # pylint: disable=protected-access
+
+
+def load_env_file(path: Optional[str]) -> None:
+    """Load an environment file without overriding existing variables."""
+
+    for name, value in _read_env_file(path).items():
+        if value is not None:
+            os.environ.setdefault(name, value)
+
+
+def _quoted_env_value(value: str) -> str:
+    """Return a value in the quoted format used by dotenv files."""
+
+    return '"{}"'.format(
+        value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
+    )
+
+
+def _set_env_file_value(path: str, name: str, value: str) -> None:
+    """Set one value in an environment file while preserving other entries."""
+
+    try:
+        with open(path, "r", encoding="utf-8") as file_stream:
+            content = file_stream.read()
+    except FileNotFoundError:
+        content = ""
+
+    assignment = re.compile(
+        rf"^[ \t]*(?:export[ \t]+)?{re.escape(name)}[ \t]*=.*$",
+        re.MULTILINE,
+    )
+    replacement = f'{name}={_quoted_env_value(value)}'
+
+    if assignment.search(content):
+        content = assignment.sub(lambda _: replacement, content, count=1)
+    else:
+        if content and not content.endswith("\n"):
+            content += "\n"
+        content += replacement + "\n"
+
+    with open(path, "w", encoding="utf-8") as file_stream:
+        file_stream.write(content)
+
+
+def _delete_env_file_value(path: str, name: str) -> None:
+    """Remove one value from an environment file."""
+
+    try:
+        with open(path, "r", encoding="utf-8") as file_stream:
+            lines = file_stream.readlines()
+    except FileNotFoundError:
+        return
+
+    assignment = re.compile(
+        rf"^[ \t]*(?:export[ \t]+)?{re.escape(name)}[ \t]*=",
+    )
+    with open(path, "w", encoding="utf-8") as file_stream:
+        file_stream.writelines(line for line in lines if not assignment.match(line))
 
 
