+
+
+# Flask blueprints use Click groups for their CLI commands.  Typer builds on
+# Click, so add the commands generated by Typer to the blueprint's group.  The
+# callbacks are wrapped with ``with_appcontext`` above because adding an
+# already-built command bypasses Flask's AppGroup.command wrapper.
+for command_name, command in get_command(fake_cli).commands.items():
+    make_context = command.make_context
+
+    def make_flask_context(*args, _make_context=make_context, **kwargs):
+        try:
+            return _make_context(*args, **kwargs)
+        except typer.Exit as error:
+            # Typer vendors Click, so its Exit exception is not caught by the
+            # Click instance used by Flask.  Translate it for --help.
+            raise SystemExit(error.exit_code)
+
+    command.make_context = make_flask_context
+    fake.cli.add_command(command, name=command_name)
