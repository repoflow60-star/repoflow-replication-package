+def _metric_color(value):
+    """Return a green-to-red color for a score in the [0, 1] range."""
+    if value is None or not np.isfinite(value):
+        return "#ffffff"
+    value = float(np.clip(value, 0, 1))
+    red = int(255 * (1 - value))
+    green = int(190 * value + 65)
+    return f"rgb({red}, {green}, 0)"
+
+
+def _metrics_table(dataframe, title):
+    headers = list(dataframe.columns)
+    values = [dataframe[column].tolist() for column in headers]
+    fills = []
+    for column in headers:
+        fills.append(
+            ["#ffffff" if column == "metric" else _metric_color(value) for value in dataframe[column]]
+        )
+    return go.Figure(
+        go.Table(
+            header=dict(values=headers, fill_color="#d9eaf7", align="left"),
+            cells=dict(values=values, fill_color=fills, align="left"),
+        )
+    ).update_layout(title=title)
 
 
