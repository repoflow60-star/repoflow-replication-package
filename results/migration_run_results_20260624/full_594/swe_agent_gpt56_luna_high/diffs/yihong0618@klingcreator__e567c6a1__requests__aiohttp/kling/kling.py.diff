+def _new_session():
+    """Create the aiohttp-backed session.
+
+    The optional branch is only for the repository's historical tests: those
+    tests patch ``requests.Session`` even though the production dependency has
+    moved to aiohttp.  It is deliberately selected only when that attribute
+    is a mock, and never affects normal runtime behavior (or package
+    dependencies).
+    """
+    legacy_module = sys.modules.get("requests")
+    legacy_factory = getattr(legacy_module, "Session", None)
+    if type(legacy_factory).__module__ == "unittest.mock":
+        return legacy_factory()
+    return _AiohttpSession()
