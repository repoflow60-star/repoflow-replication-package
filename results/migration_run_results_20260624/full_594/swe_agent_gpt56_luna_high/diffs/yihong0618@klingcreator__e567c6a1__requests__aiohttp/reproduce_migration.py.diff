--- a/reproduce_migration.py
+++ b/reproduce_migration.py
@@ -0,0 +1,29 @@
+"""Exercise the aiohttp-backed synchronous session against a local endpoint."""
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+from kling.kling import _AiohttpSession
+
+
+class Handler(BaseHTTPRequestHandler):
+    def do_GET(self):
+        body = b'{"status": "ok"}'
+        self.send_response(200)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    def log_message(self, *_args):
+        pass
+
+
+server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+try:
+    session = _AiohttpSession()
+    response = session.get(f"http://127.0.0.1:{server.server_port}/health")
+    assert response.ok
+    assert response.json() == {"status": "ok"}
+    print("aiohttp session request succeeded")
+finally:
+    server.shutdown()
+    server.server_close()
