+def _palette_colors(name):
+    """Return a Plotly palette and whether it is a continuous colorscale."""
+    if name.lower() == "tab10":
+        return plotly_colors.DEFAULT_PLOTLY_COLORS, False
+
+    # Qualitative and ColorBrewer palettes are exposed as lists by Plotly.
+    # Look up names case-insensitively to retain the convenient behavior of
+    # Plotly's palette lookup.
+    for collection in (plotly_colors.qualitative, plotly_colors.colorbrewer):
+        for palette_name in dir(collection):
+            if palette_name.startswith("_"):
+                continue
+            if palette_name.lower() == name.lower():
+                return getattr(collection, palette_name), False
+
+    try:
+        return plotly_colors.get_colorscale(name), True
+    except Exception:
+        raise ValueError(f"Unrecognized palette name {name}")
+
+
+def _palette_to_rgb(name, max_colors):
+    palette, continuous = _palette_colors(name)
+    if not continuous:
+        if len(palette) <= max_colors:
+            return array([_to_rgb(color) for color in palette], dtype=float32, order="C")
