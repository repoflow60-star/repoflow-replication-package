+def _rgb_to_hex(color):
+    """Convert an RGB triple in the range 0--1 to a hexadecimal color."""
+    # ``numpy.round`` matches the rounding used by the previous converter while
+    # avoiding a dependency on a plotting library for this small operation.
+    channels = (asarray(color, dtype=float32)[:3] * 255).round().astype(int)
+    return "#{:02x}{:02x}{:02x}".format(*channels)
+
+
+def _to_rgb(color):
+    """Convert a Plotly/HTML color to an RGB triple in the range 0--1."""
+    if not isinstance(color, str):
+        values = asarray(color, dtype=float32).reshape(-1)
+        if len(values) not in (3, 4):
+            raise ValueError("Colors must contain three or four channels")
+        values = values[:3]
+        if any(isinstance(channel, (int, integer)) for channel in color) or max(values) > 1.0:
+            values = values / 255.0
+        if max(values) > 1.0 or min(values) < 0.0:
+            raise ValueError("RGB channels must be between 0 and 1 or 0 and 255")
+        return tuple(values)
+
+    value = color.strip()
+    if value.startswith("#"):
+        # Plotly's hex_to_rgb intentionally handles six/eight digit hex colors;
+        # expand the shorthand forms here as HTML does.
+        if len(value) in (4, 5):
+            value = "#" + "".join(2 * channel for channel in value[1:])
+        if len(value) not in (7, 9):
+            raise ValueError("Invalid hexadecimal color")
+        return tuple(channel / 255.0 for channel in plotly_colors.hex_to_rgb(value)[:3])
+
+    if value.lower() in _CSS_COLORS:
+        return _to_rgb(_CSS_COLORS[value.lower()])
+
+    rgb_match = re.match(r"^rgba?\((.*)\)$", value, flags=re.IGNORECASE)
+    if rgb_match:
+        parts = [part.strip() for part in rgb_match.group(1).split(",")]
+        if len(parts) not in (3, 4):
+            raise ValueError("Invalid rgb color")
+        channels = []
+        for part in parts[:3]:
+            if part.endswith("%"):
+                channels.append(float(part[:-1]) * 2.55 / 255.0)
+            else:
+                channels.append(float(part) / 255.0)
+        if any(channel < 0.0 or channel > 1.0 for channel in channels):
+            raise ValueError("RGB channels must be between 0 and 255")
+        return tuple(channels)
