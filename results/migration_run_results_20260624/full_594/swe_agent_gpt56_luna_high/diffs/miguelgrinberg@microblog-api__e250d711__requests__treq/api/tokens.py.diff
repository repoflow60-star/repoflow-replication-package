     PasswordResetSchema, OAuth2Schema, EmptySchema
+
+# Keep the old module attribute as an alias so existing callers that patch
+# api.tokens.requests continue to work while all HTTP requests use treq.
+requests = treq
+
+_reactor_lock = Lock()
+_reactor_ready = Event()
+_reactor_thread = None
+
+
+def _start_treq_reactor():
+    """Start the Twisted reactor used by treq in a background thread.
+
+    Flask view functions are synchronous, while treq returns Deferreds.  A
+    reactor running in its own thread lets the views wait for treq without
+    trying to start and stop the process-wide reactor for every request.
+    """
+    global _reactor_thread
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is None:
+            def run_reactor():
+                reactor.callWhenRunning(_reactor_ready.set)
+                reactor.run(installSignalHandlers=False)
+
+            _reactor_thread = Thread(target=run_reactor, daemon=True)
+            _reactor_thread.start()
+        _reactor_ready.wait()
+
+
+def _treq_request(method, url, **kwargs):
+    """Perform a treq request and return its response synchronously."""
+    _start_treq_reactor()
+    request_method = treq.post if method == 'POST' else treq.get
+    return blockingCallFromThread(reactor, request_method, url, **kwargs)
+
+
+def _response_status(response):
+    """Return a status code from either treq or requests-style responses."""
+    if hasattr(response, 'status_code'):
+        return response.status_code
+    return response.code
+
+
+def _response_json(response):
+    """Decode JSON from either a treq response or a test double."""
+    if hasattr(response, 'json'):
+        result = response.json()
+        if isinstance(result, Deferred):
+            return blockingCallFromThread(reactor, lambda: result)
+        return result
+    return blockingCallFromThread(reactor, treq.json_content, response)
+
 
