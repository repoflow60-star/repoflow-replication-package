--- a/reproduce_migration.py
+++ b/reproduce_migration.py
@@ -0,0 +1,17 @@
+"""Reproduce the failure when requests is unavailable."""
+import builtins
+
+real_import = builtins.__import__
+
+def without_requests(name, *args, **kwargs):
+    if name == "requests" or name.startswith("requests."):
+        raise ModuleNotFoundError("No module named 'requests'")
+    return real_import(name, *args, **kwargs)
+
+builtins.__import__ = without_requests
+try:
+    from py_clob_client.http_helpers import helpers  # noqa: F401
+except ModuleNotFoundError as error:
+    print(f"FAIL: {error}")
+else:
+    print("OK: HTTP helpers do not require requests")
