+async def _request(endpoint: str, method: str, headers=None, data=None):
+    """Perform one HTTP request with aiohttp."""
+    headers = overloadHeaders(method, headers)
+    try:
+        async with aiohttp.ClientSession() as session:
+            async with session.request(
+                method=method,
+                url=endpoint,
+                headers=headers,
+                json=data if data else None,
+            ) as resp:
+                if resp.status != 200:
+                    error_message = await _response_body(resp)
+                    raise PolyApiException(
+                        error_msg=error_message, status_code=resp.status
+                    )
+                return await _response_body(resp)
+    except PolyApiException:
+        raise
+    except (aiohttp.ClientError, asyncio.TimeoutError, OSError):
+        raise PolyApiException(error_msg="Request exception!")
+
+
+async def _response_body(resp):
+    """Return JSON when possible, otherwise return the response text."""
+    try:
+        # Parse JSON irrespective of the response Content-Type.
+        return await resp.json(content_type=None)
+    except (ValueError, aiohttp.ClientError):
+        return await resp.text()
+
+
+def _run(coro):
+    """Run an aiohttp coroutine while retaining the synchronous API."""
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coro)
+
+    # asyncio.run cannot be nested.  A synchronous client call made from an
+    # async application is run on a separate loop/thread instead.
+    result = []
+    error = []
+
+    def run_in_thread():
+        try:
+            result.append(asyncio.run(coro))
+        except BaseException as exc:
+            error.append(exc)
+
+    thread = threading.Thread(target=run_in_thread)
+    thread.start()
+    thread.join()
+    if error:
+        raise error[0]
+    return result[0]
+
