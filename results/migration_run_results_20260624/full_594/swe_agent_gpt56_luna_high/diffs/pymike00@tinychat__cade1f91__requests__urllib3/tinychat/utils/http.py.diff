--- a/tinychat/utils/http.py
+++ b/tinychat/utils/http.py
@@ -0,0 +1,47 @@
+"""Small HTTP helpers used by the language-model clients.
+
+The clients only need to send JSON POST requests and, for most providers,
+leave the response body available for streaming.  urllib3 exposes those
+operations directly, without the higher-level requests dependency.
+"""
+
+import json
+from typing import Any
+
+import urllib3
+
+
+class HTTPClient:
+    """Send the JSON POST requests used by the API clients."""
+
+    def __init__(self) -> None:
+        self._pool = urllib3.PoolManager()
+
+    def post(
+        self,
+        url: str,
+        *,
+        headers: dict[str, str],
+        json_data: Any,
+        stream: bool = False,
+    ) -> urllib3.response.HTTPResponse:
+        """Send a JSON POST request.
+
+        ``preload_content=False`` is important for the streaming endpoints:
+        it keeps urllib3 from consuming the response before SSEClient (or the
+        Cohere handler) can iterate over it.
+        """
+        return self._pool.request(
+            "POST",
+            url,
+            headers=headers,
+            body=json.dumps(json_data).encode("utf-8"),
+            preload_content=not stream,
+        )
+
+
+http_client = HTTPClient()
+
+
+__all__ = ["HTTPClient", "http_client"]
+
