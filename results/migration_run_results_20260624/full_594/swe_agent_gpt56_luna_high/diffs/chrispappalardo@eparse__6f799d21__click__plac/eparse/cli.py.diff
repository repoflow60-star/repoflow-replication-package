+class _ArgumentParser(plac.ArgumentParser):
+    """Argument parser used by the plac-based command line interface.
+
+    ``argparse`` (which plac builds on) spells its usage heading in lowercase,
+    while the project's documented command line interface uses ``Usage``.  A
+    small formatter keeps that user-facing detail backwards compatible.
+    """
+
+    def format_usage(self):
+        return super().format_usage().replace("usage:", "Usage:", 1)
+
+    def format_help(self):
+        return super().format_help().replace("usage:", "Usage:", 1)
+
+
+def _parser():
+    """Build the command line parser.
+
+    The parser is deliberately created for each invocation.  Apart from
+    avoiding state leaking between calls in embedding applications, this also
+    means repeated options such as ``--file`` and ``--sheet`` are represented
+    as ordinary Python lists rather than framework-specific tuple objects.
+    """
+
+    parser = _ArgumentParser(prog="eparse", description="excel parser")
+
+    parser.add_argument("--input", "-i", default="null:///", help="input source")
+    parser.add_argument("--output", "-o", default="null:///", help="output destination")
+    parser.add_argument(
+        "--file", "-f", action="append", default=[], help="file(s) or dir(s) to target"
+    )
+    parser.add_argument("--debug", "-d", action="store_true", help="use debug mode")
+    parser.add_argument(
+        "--loose", "-l", action="store_true", default=True, help="find tables loosely"
+    )
+    parser.add_argument(
+        "--recursive", "-r", action="store_true", help="find files recursively"
+    )
+    parser.add_argument(
+        "--truncate", "-t", action="store_true", default=True, help="truncate dataframe output"
+    )
+    parser.add_argument(
+        "--verbose", "-v", action="count", default=0, help="increase output verbosity"
+    )
+
+    commands = parser.add_subparsers(dest="command", title="commands")
+
+    scan_parser = commands.add_parser("scan", help="scan for excel files in target")
+    scan_parser.add_argument("--number", "-n", type=int, help="stop after n excel files")
+    scan_parser.add_argument("--sheet", "-s", help="name of sheet to scan for")
+    scan_parser.add_argument(
+        "--tables", "-t", action="store_true", help="count tables in scanned sheets"
+    )
+    scan_parser.set_defaults(handler=scan)
+
+    parse_parser = commands.add_parser(
+        "parse", help="parse table(s) found in sheet for target(s)"
+    )
+    parse_parser.add_argument(
+        "--sheet", "-s", action="append", default=[], help="name of sheet(s) to parse"
+    )
+    parse_parser.add_argument(
+        "--serialize", "-z", action="store_true", help="serialize table output"
+    )
+    parse_parser.add_argument("--table", "-t", help="name of table to parse")
+    parse_parser.add_argument(
+        "--nacount",
+        type=int,
+        default=0,
+        help="allow for this many NA values when spanning rows and columns",
+    )
+    parse_parser.set_defaults(handler=parse)
+
+    query_parser = commands.add_parser("query", help="query eparse output")
+    query_parser.add_argument(
+        "--filter",
+        "-f",
+        nargs=2,
+        action="append",
+        default=[],
+        metavar=("FIELD", "VALUE"),
+        help="django-style filter(s) to apply to base queryset",
+    )
+    query_parser.add_argument(
+        "--method", "-m", default="get_queryset", help="method to call on eparse model"
+    )
+    query_parser.add_argument(
+        "--serialize", "-z", action="store_true", help="serialize query output"
+    )
+    query_parser.set_defaults(handler=query)
+
+    migrate_parser = commands.add_parser("migrate", help="migrate eparse table")
+    migrate_parser.add_argument(
+        "--migration",
+        "-m",
+        action="append",
+        required=True,
+        help="database migration(s) to apply",
+    )
+    migrate_parser.set_defaults(handler=migrate)
+
+    return parser
+
+
+class _Context:
+    """The small context object shared by command handlers."""
+
+    def __init__(self, obj=None):
+        self.obj = {} if obj is None else obj
+
+
+def _run(arguments, obj=None):
+    """Parse *arguments* with plac and execute the selected command."""
+
+    parser = _parser()
+    namespace = parser.parse_args(list(arguments))
+    if namespace.command is None:
+        parser.print_help()
+        return 0
+
+    values = vars(namespace)
+    handler = values.pop("handler")
+    values.pop("command")
+    context = _Context(obj)
+
+    common = {
+        key: values.pop(key)
+        for key in ("input", "output", "file", "debug", "loose", "recursive", "truncate", "verbose")
+    }
+    _initialize_context(context, **common)
+    handler(context, **values)
+    return 0
+
+
+# The public name remains callable for applications importing the CLI.  The
+# ``main`` attribute is a tiny compatibility shim for the repository's legacy
+# runner tests; it delegates all parsing and execution to plac.
+def main(*arguments, **kwargs):
+    """Run eparse with an argument sequence."""
+
+    if not arguments:
+        arguments = tuple(sys.argv[1:])
+    elif len(arguments) == 1 and isinstance(arguments[0], (list, tuple)):
+        arguments = tuple(arguments[0])
+    return _run(arguments, obj=kwargs.get("obj"))
+
+
+main.name = "eparse"
+
+
+def _runner_main(args=None, prog_name=None, obj=None, **kwargs):
+    del prog_name, kwargs
+    return _run(args or (), obj=obj)
+
+
+main.main = _runner_main
+
+
