+def _get(url):
+    """Fetch a URL and raise an urllib3 error for unsuccessful responses."""
+    response = urllib3.request("GET", url)
+    if response.status >= 400:
+        raise urllib3.exceptions.HTTPError(f"HTTP {response.status} for URL {url}")
+    return response
+
+
+# urllib3 responses expose the payload as ``data`` rather than ``content`` or
+# ``text``.  The parsers accept bytes, so no response decoding is needed here.
 
 
