+    async def _async_query(self, url: str, params: dict[str, Any]):
+        """Perform one API request with aiohttp."""
+        request_kwargs = dict(self._request_kwargs)
+
+        # ``proxies`` was accepted by requests, but aiohttp takes one proxy
+        # URL per request.  Preserve the old mapping form where possible.
+        proxies = request_kwargs.pop("proxies", None)
+        if proxies is not None and "proxy" not in request_kwargs:
+            if isinstance(proxies, str):
+                request_kwargs["proxy"] = proxies
+            else:
+                scheme = parse.urlparse(url).scheme
+                request_kwargs["proxy"] = proxies.get(scheme) or proxies.get("all")
+
+        timeout = request_kwargs.get("timeout")
+        if isinstance(timeout, tuple):
+            connect, read = timeout
+            request_kwargs["timeout"] = aiohttp.ClientTimeout(
+                total=None,
+                connect=connect,
+                sock_read=read,
+            )
+
+        async with self._session.get(
+            url,
+            params=params,
+            **request_kwargs,
+        ) as response:
+            return await response.json()
 
