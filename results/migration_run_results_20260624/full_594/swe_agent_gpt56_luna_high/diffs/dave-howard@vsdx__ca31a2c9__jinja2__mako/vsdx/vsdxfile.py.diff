+def _render_mako_template(source: str, context: dict) -> str:
+    """Render a source document with Mako.
+
+    The project historically stored Jinja-style expressions in existing VSDX
+    templates.  Keep those templates readable and backwards compatible while
+    using Mako as the only template engine: expressions and the small set of
+    control statements used by the VSDX format are translated to Mako syntax
+    before rendering.  Native Mako syntax is left untouched.
+    """
+    legacy_template = "{{" in source or "{%" in source
+
+    # Mako's line-oriented control statements need to start on their own line.
+    # The XML serializer can place template statements in element text/tails,
+    # so add line boundaries while translating the legacy statements.
+    def translate_statement(match):
+        statement = match.group(1).strip()
+        if statement == "else":
+            return "\n% else:\n"
+        if statement.startswith("elif "):
+            return f"\n% elif {statement[5:].strip()}:\n"
+        if statement == "endif":
+            return "\n% endif\n"
+        if statement == "endfor":
+            return "\n% endfor\n"
+        if statement.startswith("if "):
+            return f"\n% if {statement[3:].strip()}:\n"
+        if statement.startswith("for "):
+            return f"\n% for {statement[4:].strip()}:\n"
+        # Unknown statements are retained as literal text rather than being
+        # silently interpreted as Python by the compatibility layer.
+        return match.group(0)
+
+    source = re.sub(r"{%\s*(.*?)\s*%}", translate_statement, source, flags=re.DOTALL)
+
+    # Jinja's count filter is used by the repository's existing templates;
+    # Mako expressions are Python, where len() is the equivalent operation.
+    source = re.sub(r"([A-Za-z_]\w*(?:\.[A-Za-z_]\w*)*)\s*\|\s*(?:count|length)\b", r"len(\1)", source)
+    source = re.sub(r"{{\s*(.*?)\s*}}", r"${\1}", source, flags=re.DOTALL)
+
+    # Jinja rendered an absent value as an empty string.  Preserve that
+    # behavior for legacy templates without changing the caller's dictionary;
+    # native Mako templates retain Mako's normal undefined-value behavior.
+    render_context = dict(context)
+    if legacy_template:
+        expressions = re.findall(r"\$\{(.*?)\}", source, flags=re.DOTALL)
+        names = [name for expression in expressions
+                 for name in re.findall(r"\b[A-Za-z_]\w*\b", expression)]
+        reserved = set(dir(builtins)) | set(keyword.kwlist)
+        for name in names:
+            if name not in render_context and name not in reserved:
+                render_context[name] = ""
+    return Template(source).render(**render_context)
 
