+def _toml_key(key: str) -> str:
+    """Return a TOML key, quoting it when it is not a bare key."""
+    if re.fullmatch(r"[A-Za-z0-9_-]+", key):
+        return key
+    return json.dumps(key, ensure_ascii=False)
+
+
+def _toml_value(value: object) -> str:
+    """Serialize a TOML scalar or an inline value."""
+    if isinstance(value, str):
+        return json.dumps(value, ensure_ascii=False)
+    if isinstance(value, bool):
+        return str(value).lower()
+    if isinstance(value, int):
+        return str(value)
+    if isinstance(value, float):
+        if math.isnan(value):
+            return "nan"
+        if math.isinf(value):
+            return "inf" if value > 0 else "-inf"
+        return repr(value)
+    if isinstance(value, datetime):
+        return value.isoformat()
+    if isinstance(value, date):
+        return value.isoformat()
+    if isinstance(value, time):
+        return value.isoformat()
+    if isinstance(value, list):
+        return "[{}]".format(", ".join(_toml_value(item) for item in value))
+    if isinstance(value, dict):
+        items = ", ".join(
+            "{} = {}".format(_toml_key(str(key)), _toml_value(item))
+            for key, item in value.items()
+        )
+        return "{{{}}}".format(items)
+    raise TypeError("Unsupported TOML value: {!r}".format(type(value).__name__))
+
+
+def _toml_dumps(metadata: dict[str, object]) -> str:
+    """Serialize metadata without requiring a second TOML dependency.
+
+    ``tomli`` deliberately only implements TOML parsing. This small writer keeps
+    the existing TOMLHandler export API while using tomli as the sole TOML
+    library.
+    """
+    lines: list[str] = []
+
+    def dump_table(table: dict[str, object], prefix: tuple[str, ...] = ()) -> None:
+        # Emit scalar values first so values belonging to the parent table are
+        # not accidentally made part of a child table.
+        for key, value in table.items():
+            if not isinstance(value, (dict, list)) or (
+                isinstance(value, list)
+                and not value
+            ):
+                lines.append("{} = {}".format(_toml_key(str(key)), _toml_value(value)))
+
+        for key, value in table.items():
+            path = prefix + (_toml_key(str(key)),)
+            if isinstance(value, dict):
+                if lines and lines[-1] != "":
+                    lines.append("")
+                lines.append("[{}]".format(".".join(path)))
+                dump_table(value, prefix + (_toml_key(str(key)),))
+            elif isinstance(value, list) and value and all(
+                isinstance(item, dict) for item in value
+            ):
+                for item in value:
+                    if lines and lines[-1] != "":
+                        lines.append("")
+                    lines.append("[[{}]]".format(".".join(path)))
+                    dump_table(item, prefix + (_toml_key(str(key)),))
+
+    dump_table(metadata)
+    return "\n".join(lines)
+
