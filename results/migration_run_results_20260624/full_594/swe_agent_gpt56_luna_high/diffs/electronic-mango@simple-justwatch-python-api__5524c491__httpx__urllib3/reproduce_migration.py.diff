--- a/reproduce_migration.py
+++ b/reproduce_migration.py
@@ -0,0 +1,11 @@
+"""Reproduce the HTTP client API mismatch for the urllib3 migration."""
+
+import urllib3
+
+# The old implementation imports httpx.post.  urllib3 has no equivalent
+# module-level post helper; requests go through urllib3.request instead.
+from simplejustwatchapi import justwatch
+
+assert justwatch.post.__module__.split(".")[0] == "urllib3", (
+    "simplejustwatchapi still uses httpx.post instead of urllib3"
+)
