-import requests
+from threading import Event, Lock, Thread
+from typing import Any
+
+import treq
 from bs4 import BeautifulSoup
+from twisted.internet import reactor
+from twisted.internet.defer import inlineCallbacks
+from twisted.internet.threads import blockingCallFromThread
+
+
+# treq is asynchronous, while this function is also used by the synchronous
+# Lambda handlers (and is part of the layer's public API).  Keep one reactor
+# alive in the background so callers do not have to change their calling
+# convention when the HTTP client changes.
+_reactor_lock = Lock()
+_reactor_ready = Event()
+
+
+def _start_reactor() -> None:
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if reactor.running:
+            return
+
+        def run_reactor() -> None:
+            reactor.callWhenRunning(_reactor_ready.set)
+            reactor.run(installSignalHandlers=False)
+
+        Thread(target=run_reactor, daemon=True).start()
+        _reactor_ready.wait()
+
+
+@inlineCallbacks
+def _get_page(url: str) -> Any:
+    response = yield treq.get(url)
+    page = yield response.content()
+    return page
+
+
+def _fetch_page(url: str) -> Any:
+    _start_reactor()
+    return blockingCallFromThread(reactor, _get_page, url)
 
 
