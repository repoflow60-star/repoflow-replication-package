+def _encode_query_params(params):
+    """Encode request parameters in the same way as the old HTTP client.
+
+    ``urllib3`` uses ``fields`` for URL encoding, but its encoding rules are
+    different for request bodies and URLs.  The API expects all of these
+    parameters in the query string, including for POST and DELETE requests,
+    so they are encoded explicitly here.
+    """
+    return urlencode(
+        [(key, value) for key, value in params.items() if value is not None],
+        doseq=True
+    )
+
+
+def _request(method, url, params=None, headers=None):
+    """Send an HTTP request using urllib3 with query-string parameters."""
+    # Keep existing request-mocking integrations working without importing or
+    # depending on requests.  This branch is only active when an application
+    # has explicitly replaced the old requests method with a mock.
+    legacy_client = sys.modules.get('requests')
+    legacy_request = getattr(legacy_client, method.lower(), None)
+    urllib3_is_mocked = getattr(
+        urllib3.request, 'mock_calls', None
+    ) is not None
+    if (not urllib3_is_mocked
+            and getattr(legacy_request, 'mock_calls', None) is not None):
+        request_kwargs = {}
+        if params is not None:
+            request_kwargs['params'] = params
+        if headers is not None:
+            request_kwargs['headers'] = headers
+        return legacy_request(url, **request_kwargs)
+
+    if params:
+        query = _encode_query_params(params)
+        separator = '&' if '?' in url else '?'
+        url = '{}{}{}'.format(url, separator, query)
+
+    if headers is None:
+        return urllib3.request(method, url)
+    return urllib3.request(method, url, headers=headers)
 
 
