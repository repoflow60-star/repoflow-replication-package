+def tabulate(
+    output: ty.List[ty.Tuple[str, ty.Any]],
+    headers: ty.List[str],
+    tablefmt: str,
+) -> str:
+    """Render rows with PrettyTable.
+
+    This adapter keeps the existing internal call shape while replacing the
+    tabulate dependency.  ``tablefmt`` is the format name used by
+    :func:`_tabulate`: ``psql`` is represented by PrettyTable's default style,
+    while ``simple`` uses its plain-column style.
+    """
+    table = PrettyTable(headers)
+    table.add_rows(output)
+
+    if tablefmt == 'simple':
+        table.set_style(TableStyle.PLAIN_COLUMNS)
+
+    return table.get_string()
 
 
