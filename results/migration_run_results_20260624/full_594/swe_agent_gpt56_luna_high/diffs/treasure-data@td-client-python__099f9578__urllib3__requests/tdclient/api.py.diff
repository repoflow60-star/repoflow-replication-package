+class _RequestsResponse:
+    """Expose the response interface used by the client over requests."""
+
+    def __init__(self, response):
+        self._response = response
+
+    @property
+    def status(self):
+        return self._response.status_code
+
+    @property
+    def data(self):
+        return self._response.content
+
+    def read(self, size=None):
+        if size is None:
+            return self._response.content
+        return self._response.raw.read(size, decode_content=True)
+
+    def stream(self, size=None):
+        return self._response.iter_content(chunk_size=size)
+
+    def getheaders(self):
+        return self._response.headers
+
+    def close(self):
+        self._response.close()
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
+
+def _response_compat(response):
+    response_type = getattr(requests, "Response", None)
+    if isinstance(response_type, type) and isinstance(response, response_type):
+        return _RequestsResponse(response)
+    return response
+
