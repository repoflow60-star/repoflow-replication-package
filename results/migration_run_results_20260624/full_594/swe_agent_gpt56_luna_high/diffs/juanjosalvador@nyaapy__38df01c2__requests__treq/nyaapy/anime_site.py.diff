+class HTTPError(RuntimeError):
+    """Raised when a request returns an unsuccessful HTTP status code."""
+
+
+class _Response:
+    """Small synchronous view of a treq response.
+
+    treq is deliberately asynchronous, while the public API of this package
+    has historically been synchronous.  The network operation is completed by
+    ``_get`` before this object is returned, preserving that API for callers.
+    """
+
+    def __init__(self, response, content):
+        self.status_code = response.code
+        self.content = content
+
+        # Nyaa serves UTF-8 pages.  Honor a response-provided encoding when one
+        # is available, and retain a replacement fallback for malformed data.
+        encoding = getattr(response, "encoding", None) or "utf-8"
+        self.text = content.decode(encoding, errors="replace")
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise HTTPError(f"HTTP status {self.status_code}")
+
+
+_reactor_thread = None
+_reactor_ready = Event()
+_reactor_lock = threading.Lock()
+
+
+def _start_reactor():
+    """Start one reusable reactor thread for synchronous treq calls."""
+    global _reactor_thread
+
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is not None and _reactor_thread.is_alive():
+            _reactor_ready.wait()
+            return
+
+        _reactor_ready.clear()
+
+        def run_reactor():
+            reactor.callWhenRunning(_reactor_ready.set)
+            reactor.run(installSignalHandlers=False)
+
+        _reactor_thread = threading.Thread(target=run_reactor, daemon=True)
+        _reactor_thread.start()
+        _reactor_ready.wait()
+
+
+def _wait_for(factory):
+    """Run a treq operation and return its result synchronously.
+
+    ``treq`` returns Deferreds.  Keeping this adapter private lets the
+    existing synchronous Nyaa API and its callers continue to work while all
+    HTTP traffic is performed through treq.
+    """
+    _start_reactor()
+    result = []
+    finished = Event()
+    deferred = Deferred()
+
+    def start():
+        try:
+            value = factory()
+            if isinstance(value, Deferred):
+                value.chainDeferred(deferred)
+            else:
+                deferred.callback(value)
+        except BaseException:
+            deferred.errback(Failure())
+
+    def done(value):
+        result.append(value)
+        finished.set()
+        # Turn an errback into a handled callback.  The Failure is re-raised
+        # below after the waiting thread has received it.
+        return None if isinstance(value, Failure) else value
+
+    deferred.addBoth(done)
+    reactor.callFromThread(start)
+    finished.wait()
+
+    value = result[0]
+    if isinstance(value, Failure):
+        value.raiseException()
+    return value
+
+
+def _get(url):
+    """Fetch ``url`` using treq and expose a synchronous response locally."""
+    response = _wait_for(lambda: treq.get(url))
+
+    def read_content():
+        content = getattr(response, "content", None)
+        if callable(content):
+            return content()
+        if content is not None:
+            return content
+        return treq.content(response)
+
+    content = _wait_for(read_content)
+    result = _Response(response, content)
+    result.raise_for_status()
+    return result
 
 
