--- a/reproduce_progressbar_migration.py
+++ b/reproduce_progressbar_migration.py
@@ -0,0 +1,16 @@
+"""Reproduce importing the package with tqdm unavailable."""
+import importlib.abc
+import sys
+
+
+class BlockTqdm(importlib.abc.MetaPathFinder):
+    def find_spec(self, fullname, path=None, target=None):
+        if fullname == "tqdm" or fullname.startswith("tqdm."):
+            raise ModuleNotFoundError("No module named 'tqdm' (blocked for reproduction)")
+        return None
+
+
+sys.meta_path.insert(0, BlockTqdm())
+import words_n_fun  # noqa: F401
+
+print("package imported")
