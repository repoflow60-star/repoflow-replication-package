+# Plotly uses CSS color names rather than the old backend's one-letter color
+# abbreviations. Keeping these aliases makes the public plotting API
+# backwards-compatible for the common colors accepted by the old backend.
+_COLOR_ALIASES = {
+    "k": "black",
+    "w": "white",
+    "r": "red",
+    "g": "green",
+    "b": "blue",
+    "c": "cyan",
+    "m": "magenta",
+    "y": "yellow",
+}
+
+
+def _plotly_color(color: PlotlyColor) -> PlotlyColor:
+    """Convert colors commonly used with the former plotting backend."""
+    if isinstance(color, str):
+        return _COLOR_ALIASES.get(color, color)
+
+    # Plotly accepts CSS strings for line colors. Convert numeric RGB(A)
+    # tuples as well, since those are frequently returned by color maps.
+    if isinstance(color, (tuple, list, numpy.ndarray)):
+        values = list(color)
+        if len(values) in (3, 4) and all(
+            isinstance(value, (int, float, numpy.number)) for value in values
+        ):
+            # Color maps return RGB(A) floats in [0, 1], while Plotly's
+            # rgb() notation uses [0, 255] and rgba() uses a [0, 1] alpha.
+            rgb = values[:3]
+            if all(0 <= value <= 1 for value in rgb):
+                rgb = [round(value * 255) for value in rgb]
+            else:
+                rgb = [round(value) for value in rgb]
+            if len(values) == 3:
+                return "rgb({0}, {1}, {2})".format(*rgb)
+            alpha = values[3]
+            if alpha > 1:
+                alpha /= 255
+            alpha = min(1.0, max(0.0, alpha))
+            return "rgba({0}, {1}, {2}, {3})".format(*rgb, alpha)
+    return color
+
+
+def _force_color(force: float, scaler: float) -> str:
+    """Return the red-gray-blue color used to visualize member force."""
+    # A truss can legitimately have no force. In that case the midpoint of
+    # the scale is the neutral gray instead of producing NaN/Infinity.
+    normalized = 0.5 if scaler == 0 else force / (2 * scaler) + 0.5
+    normalized = float(numpy.clip(normalized, 0.0, 1.0))
+
+    if normalized <= 0.5:
+        fraction = normalized * 2
+        start, end = (255, 0, 0), (204, 204, 204)
+    else:
+        fraction = (normalized - 0.5) * 2
+        start, end = (204, 204, 204), (0, 0, 255)
+
+    rgb = tuple(
+        round(begin + fraction * (finish - begin))
+        for begin, finish in zip(start, end)
+    )
+    return "rgb({0}, {1}, {2})".format(*rgb)
 
 
