+# treq is built on Twisted and returns Deferreds, whereas this class is part of
+# the synchronous API.  Keep one reactor running in the background so that the
+# public REST methods retain their synchronous behaviour.
+_REACTOR_LOCK = threading.Lock()
+_REACTOR_READY = threading.Event()
+_REACTOR_THREAD: Optional[threading.Thread] = None
+_REACTOR_THREAD_ID: Optional[int] = None
+_REACTOR_ERROR: Optional[BaseException] = None
+
+_CONNECTION_ERRORS = (
+    ConnectError,
+    ConnectionAbortedError,
+    ConnectionDone,
+    ConnectionLost,
+    ConnectionRefusedError,
+    ConnectionResetError,
+    DNSLookupError,
+    TCPTimedOutError,
+    TimeoutError,
+    defer.CancelledError,
+    ResponseNeverReceived,
+)
+
+
+def _run_reactor() -> None:
+    global _REACTOR_ERROR, _REACTOR_THREAD_ID
+    _REACTOR_THREAD_ID = threading.get_ident()
+    try:
+        reactor.callWhenRunning(_REACTOR_READY.set)
+        reactor.run(installSignalHandlers=False)  # type: ignore[misc,call-arg]
+    except BaseException as error:
+        _REACTOR_ERROR = error
+        _REACTOR_READY.set()
+
+
+def _ensure_reactor() -> None:
+    if reactor.running:
+        if _REACTOR_THREAD_ID == threading.get_ident():
+            raise RuntimeError("REST calls cannot block the Twisted reactor thread")
+        return
+
+    global _REACTOR_ERROR, _REACTOR_THREAD
+    with _REACTOR_LOCK:
+        if not reactor.running and (
+            _REACTOR_THREAD is None or not _REACTOR_THREAD.is_alive()
+        ):
+            _REACTOR_ERROR = None
+            _REACTOR_READY.clear()
+            _REACTOR_THREAD = threading.Thread(
+                target=_run_reactor,
+                name="samsungtvws-treq-reactor",
+                daemon=True,
+            )
+            _REACTOR_THREAD.start()
+    _REACTOR_READY.wait()
+    if _REACTOR_ERROR is not None:
+        raise _REACTOR_ERROR
+
+
+def _blocking_treq_request(
+    url: str, method: str, timeout: Optional[float]
+) -> Union[str, Failure]:
+    """Run one treq request and wait for its Deferred to complete."""
+    _ensure_reactor()
+    completed = threading.Event()
+    result: List[Union[str, Failure]] = []
+
+    def finish(value: Union[str, Failure]) -> None:
+        result.append(value)
+        completed.set()
+
+    def request() -> None:
+        try:
+            # The previous client disabled certificate verification.  The
+            # context factory provides the same behaviour for TV certificates.
+            agent = Agent(  # type: ignore[no-untyped-call]
+                reactor, contextFactory=ClientContextFactory()
+            )
+            deferred = treq.request(  # type: ignore[no-untyped-call]
+                method,
+                url,
+                timeout=timeout,
+                agent=agent,
+            )
+            deferred.addCallback(treq.text_content)
+            deferred.addBoth(finish)
+        except Exception:
+            finish(Failure())  # type: ignore[no-untyped-call]
+
+    reactor.callFromThread(request)
+    completed.wait()
+    return result[0]
 
 
