 from fp.errors import FreeProxyException
+
+
+# treq is asynchronous, while FreeProxy's public API has historically been
+# synchronous.  Keep the public API compatible by running one reactor in a
+# daemon thread and waiting for each Deferred to finish.  Keeping the reactor
+# alive is important: Twisted reactors cannot be started again after they have
+# been stopped.
+_reactor_lock = threading.Lock()
+_reactor_thread = None
+
+
+def _wait_for_deferred(operation):
+    """Run a treq operation and return its Deferred's result synchronously."""
+    global _reactor_thread
+    result = []
+    finished = threading.Event()
+
+    def complete(value):
+        result.append(value)
+        finished.set()
+        return value
+
+    def start_operation():
+        try:
+            value = operation() if callable(operation) else operation
+            if hasattr(value, 'addBoth'):
+                value.addBoth(complete)
+            else:
+                complete(value)
+        except BaseException as error:
+            complete(error)
+
+    # Calls made after the first request have to be submitted to the reactor
+    # thread.  Calling connectTCP from a different thread can corrupt Twisted's
+    # event loop (and, in particular, its file descriptor registrations).
+    if reactor.running:
+        if threading.current_thread() is _reactor_thread:
+            raise RuntimeError('FreeProxy synchronous methods cannot run in the reactor thread')
+        reactor.callFromThread(start_operation)
+    else:
+        start_operation()
+
+    if not finished.is_set() and not reactor.running:
+        with _reactor_lock:
+            if not reactor.running and _reactor_thread is None:
+                _reactor_thread = threading.Thread(
+                    target=lambda: reactor.run(installSignalHandlers=False),
+                    name='free-proxy-treq-reactor',
+                    daemon=True,
+                )
+                _reactor_thread.start()
+
+    finished.wait()
+    value = result[0]
+    if isinstance(value, Failure):
+        value.raiseException()
+    if isinstance(value, BaseException):
+        raise value
+    return value
 
 
