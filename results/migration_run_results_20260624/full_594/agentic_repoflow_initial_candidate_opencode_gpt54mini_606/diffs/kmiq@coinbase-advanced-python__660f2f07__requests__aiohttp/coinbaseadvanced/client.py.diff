     def _next_param(self, query_params: str) -> str:
         return query_params + ('?' if query_params == '' else '&')
+
+    def _request_json(self,
+                      method: str,
+                      request_path: str,
+                      headers: dict,
+                      query_params: str = '',
+                      payload: Optional[dict] = None):
+        return asyncio.run(
+            self._request_json_async(method, request_path, headers, query_params, payload)
+        )
+
+    async def _request_json_async(self,
+                                  method: str,
+                                  request_path: str,
+                                  headers: dict,
+                                  query_params: str = '',
+                                  payload: Optional[dict] = None):
+        timeout = aiohttp.ClientTimeout(total=self.timeout)
+
+        async with aiohttp.ClientSession(timeout=timeout) as session:
+            async with session.request(
+                method,
+                self._base_url + request_path + query_params,
+                headers=headers,
+                json=payload,
+            ) as response:
+                body_text = await response.text()
+
+                if response.status >= 400:
+                    raise CoinbaseAdvancedTradeAPIError.from_status_text(
+                        response.status,
+                        body_text,
+                    )
+
+                if not body_text:
+                    return {}
+
+                try:
+                    return json.loads(body_text)
+                except ValueError:
+                    return {}
