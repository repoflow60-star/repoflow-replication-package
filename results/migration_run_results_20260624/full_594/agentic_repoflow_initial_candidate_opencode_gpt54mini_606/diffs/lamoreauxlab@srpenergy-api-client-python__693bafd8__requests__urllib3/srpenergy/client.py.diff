+def _response_set_cookie_headers(response):
+    """Return any Set-Cookie headers from a response."""
+    headers = getattr(response, "headers", None)
+    if headers is None:
+        return []
+
+    getlist = getattr(headers, "getlist", None)
+    if callable(getlist):
+        return list(getlist("set-cookie"))
+
+    if hasattr(headers, "get"):
+        header_value = headers.get("set-cookie") or headers.get("Set-Cookie")
+        if header_value is None:
+            return []
+        if isinstance(header_value, (list, tuple)):
+            return list(header_value)
+        return [header_value]
+
+    return []
+
+
+def _cookie_header(response, existing=None):
+    """Build a merged Cookie header from urllib3 response cookies."""
+    cookie = SimpleCookie()
+    if existing:
+        cookie.load(existing)
+
+    for header in _response_set_cookie_headers(response):
+        cookie.load(header)
+
+    response_cookies = getattr(response, "cookies", None)
+    if response_cookies is not None and hasattr(response_cookies, "items"):
+        for name, value in response_cookies.items():
+            cookie[name] = getattr(value, "value", value)
+
+    if not cookie:
+        return None
+
+    return "; ".join(f"{morsel.key}={morsel.value}" for morsel in cookie.values())
+
+
+def _cookie_value(response, name):
+    """Return the value of a cookie set on a urllib3 response."""
+    cookie = SimpleCookie()
+    for header in _response_set_cookie_headers(response):
+        cookie.load(header)
+
+    response_cookies = getattr(response, "cookies", None)
+    if response_cookies is not None:
+        cookie_get = getattr(response_cookies, "get", None)
+        if callable(cookie_get):
+            cookie_value = cookie_get(name)
+            if cookie_value is not None:
+                return cookie_value
+
+    if name not in cookie:
+        return None
+
+    return cookie[name].value
 
 
