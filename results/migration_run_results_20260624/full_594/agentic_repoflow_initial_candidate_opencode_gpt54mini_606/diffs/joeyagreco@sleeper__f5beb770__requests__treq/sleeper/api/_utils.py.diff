+from twisted.internet import asyncioreactor
+
+import treq
+
+
+_EVENT_LOOP = asyncio.new_event_loop()
+asyncio.set_event_loop(_EVENT_LOOP)
+asyncioreactor.install(_EVENT_LOOP)
+
+
+async def _await_value(value: Any) -> Any:
+    return await value
+
+
+def _resolve(value: Any) -> Any:
+    if inspect.isawaitable(value):
+        return _EVENT_LOOP.run_until_complete(_await_value(value))
+    return value
+
+
+def _raise_for_status(response: Any) -> None:
+    raise_for_status = getattr(response, "raise_for_status", None)
+    if callable(raise_for_status):
+        raise_for_status()
+        return
+
+    code = getattr(response, "code", getattr(response, "status_code", None))
+    if code is not None and code >= 400:
+        reason = getattr(response, "phrase", "")
+        message = f"HTTP {code}"
+        if reason:
+            message = f"{message} {reason}"
+        raise RuntimeError(message)
+
+
+def _get_response(url: str) -> Any:
+    return _resolve(treq.get(url))
+
+
+def _get_json(url: str) -> Any:
+    response = _get_response(url)
+    _raise_for_status(response)
+
+    json_content = getattr(response, "json", None)
+    if json_content is not None:
+        return _resolve(json_content() if callable(json_content) else json_content)
+
+    return _resolve(treq.json_content(response))
+
+
+def _get_content(url: str) -> bytes:
+    response = _get_response(url)
+    _raise_for_status(response)
+
+    content = getattr(response, "content", None)
+    if content is not None:
+        return _resolve(content() if callable(content) else content)
+
+    return _resolve(treq.content(response))
 
 
