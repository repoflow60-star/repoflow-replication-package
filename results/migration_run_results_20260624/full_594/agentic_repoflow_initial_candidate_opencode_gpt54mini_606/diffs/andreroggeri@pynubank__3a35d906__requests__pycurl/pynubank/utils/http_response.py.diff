--- a/pynubank/utils/http_response.py
+++ b/pynubank/utils/http_response.py
@@ -0,0 +1,13 @@
+import json
+
+
+class Response:
+    def __init__(self, url: str = '', status_code: int = 0, headers=None, content: bytes = b''):
+        self.url = url
+        self.status_code = status_code
+        self.headers = {} if headers is None else dict(headers)
+        self._content = content
+        self.content = content
+
+    def json(self):
+        return json.loads(self._content.decode())
