 _cached_wordclouds = {}
 
 
+def _white_background(chart: alt.Chart) -> alt.Chart:
+    return chart.configure_view(strokeWidth=0, background="white")
+
+
+def _empty_chart(title: str = None, width: int = 800, height: int = 150) -> alt.Chart:
+    chart = alt.Chart(pd.DataFrame({"x": [0], "y": [0]})).mark_point(opacity=0)
+    if title is not None:
+        chart = chart.properties(title=title)
+    return _white_background(chart.properties(width=width, height=height))
+
+
+def _wordcloud_chart(
+    cloud, title: str, width: int = 800, height: int = 400
+) -> alt.Chart:
+    image = cloud.to_image()
+    buffer = io.BytesIO()
+    image.save(buffer, format="PNG")
+    encoded = base64.b64encode(buffer.getvalue()).decode("ascii")
+    data = pd.DataFrame({"url": [f"data:image/png;base64,{encoded}"]})
+    return _white_background(
+        alt.Chart(data)
+        .mark_image(width=width, height=height)
+        .encode(url="url:N")
+        .properties(title=title, width=width, height=height)
+    )
+
+
+def _labels_from_classes(classes, encodings: Dict[str, int]):
+    return [utils.get_cat_by_index(int(class_id), encodings) for class_id in list(classes)]
