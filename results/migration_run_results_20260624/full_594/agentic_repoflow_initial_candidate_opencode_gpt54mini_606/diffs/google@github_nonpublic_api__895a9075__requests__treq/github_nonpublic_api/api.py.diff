+except Exception:
+    _ASYNCIO_LOOP = None
+
+import treq
+
+
+class _Response(object):
+    def __init__(self, url: str, content: str, status_code: int):
+        self.url = url
+        self.content = content
+        self.text = content
+        self.history = []
+        self.status_code = status_code
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise RuntimeError(f"HTTP {self.status_code} for {self.url}")
+
+
+async def _await_deferred(deferred):
+    return await deferred
+
+
+def _run_deferred(deferred):
+    if _ASYNCIO_LOOP is None:
+        raise RuntimeError("treq requires an asyncio-enabled Twisted reactor")
+    future = deferred.asFuture(_ASYNCIO_LOOP) if hasattr(deferred, "asFuture") else _await_deferred(deferred)
+    return _ASYNCIO_LOOP.run_until_complete(future)
+
+
+def _response_from_treq(response, url: str):
+    body = _run_deferred(treq.content(response)).decode("utf-8", errors="replace")
+    return _Response(url=url, content=body, status_code=getattr(response, "code", 200))
+
+
+class _TreqSession(object):
+    def __init__(self):
+        self.cookies = CookieJar()
+
+    def get(self, url):
+        return _response_from_treq(
+            _run_deferred(treq.get(url, cookies=self.cookies)), url
+        )
+
+    def post(self, url, data=None):
+        return _response_from_treq(
+            _run_deferred(treq.post(url, data=data, cookies=self.cookies)), url
+        )
 
 
