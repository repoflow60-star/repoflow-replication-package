+@dataclass(slots=True)
+class Response:
+    """Minimal synchronous response wrapper around aiohttp results."""
+
+    status_code: int
+    reason: str
+    headers: dict[str, str]
+    text: str
+
+    @property
+    def status(self) -> int:
+        return self.status_code
+
+    def json(self) -> Any:
+        return json.loads(self.text)
+
+    def raise_for_status(self) -> None:
+        if self.status_code < 400:
+            return
+
+        message = self.reason
+        try:
+            payload = self.json()
+        except json.JSONDecodeError:
+            payload = None
+
+        if isinstance(payload, dict):
+            message = payload.get("message", message)
+        raise UnknownError(message)
+
+
+@dataclass(slots=True)
+class _Request:
+    method: str
+    url: str
+    headers: dict[str, str]
+    data: Any = None
+    json: Any = None
+    params: Any = None
+
+    @property
+    def body(self) -> Any:
+        if self.data is not None:
+            return self.data
+        return self.json
+
+    def prepare(self) -> _Request:
+        return self
+
