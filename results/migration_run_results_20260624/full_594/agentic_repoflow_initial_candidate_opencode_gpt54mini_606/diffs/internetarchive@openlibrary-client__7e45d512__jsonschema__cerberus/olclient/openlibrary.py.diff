+
+    target_root = root_schema if not schema_name else _load_schema_document(schema_name)
+    target_schema = target_root
+    fragment = fragment.lstrip('/')
+    if fragment:
+        for part in fragment.split('/'):
+            target_schema = target_schema[part]
+    return target_schema, target_root
