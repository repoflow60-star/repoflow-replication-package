+        required = set(schema.get('required', []))
+        for name, child_schema in schema.get('properties', {}).items():
+            child_rule = _cerberus_rule(child_schema, root_schema)
+            if name in required:
+                child_rule['required'] = True
+            rule['schema'][name] = child_rule
+        return rule
+
+    if schema_type == 'array':
+        rule = {'type': 'list'}
+        if 'items' in schema:
+            rule['schema'] = _cerberus_rule(schema['items'], root_schema)
+        if 'minItems' in schema:
+            rule['minlength'] = schema['minItems']
+        if 'maxItems' in schema:
+            rule['maxlength'] = schema['maxItems']
+        return rule
+
+    rule = {}
+    if schema_type == 'string':
+        rule['type'] = 'string'
+    elif schema_type == 'number':
+        rule['type'] = 'number'
+    elif schema_type == 'integer':
+        rule['type'] = 'integer'
+    elif schema_type == 'boolean':
+        rule['type'] = 'boolean'
+
+    if 'pattern' in schema:
+        rule['regex'] = schema['pattern']
+    if 'enum' in schema:
+        rule['allowed'] = schema['enum']
+    return rule
