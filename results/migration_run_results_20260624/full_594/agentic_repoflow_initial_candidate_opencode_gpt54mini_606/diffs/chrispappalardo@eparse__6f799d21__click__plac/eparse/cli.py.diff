+
+    name = "eparse"
+
+    def __call__(self, *args, **kwargs):
+        if len(args) == 1 and isinstance(args[0], (list, tuple)):
+            return self.main(args=args[0], **kwargs)
+        return self.main(args=args, **kwargs)
+
+    def main(self, args=None, prog_name=None, obj=None, **kwargs):
+        if args is None:
+            argv = []
+        elif isinstance(args, (list, tuple)):
+            argv = list(args)
+        else:
+            argv = [args]
+        if not argv or argv[0] in ("-h", "--help"):
+            _print_help()
+            return 0
+
+        ctx = obj if isinstance(obj, dict) else {}
+        return self.run(*argv, ctx=ctx)
+
+    def run(self, *argv, ctx=None):
+        raw = list(argv)
+
+        if not raw:
+            _print_help()
+            return 0
+
+        if raw[0] in ("-h", "--help"):
+            _print_help()
+            return 0
+
+        ctx = _default_ctx() if ctx is None else ctx
+        parsed_ctx, command, command_args = _parse_global(raw)
