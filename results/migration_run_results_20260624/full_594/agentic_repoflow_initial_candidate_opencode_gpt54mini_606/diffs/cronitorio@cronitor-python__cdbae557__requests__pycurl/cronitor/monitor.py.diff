+class _PycurlSession(object):
+    def __init__(self, retries=0, backoff_factor=0.3):
+        self.retries = retries
+        self.backoff_factor = backoff_factor
+
+    def get(self, url, params=None, timeout=None, headers=None, auth=None):
+        return self._request('GET', url, params=params, timeout=timeout, headers=headers, auth=auth)
+
+    def put(self, url, data=None, timeout=None, headers=None, auth=None):
+        return self._request('PUT', url, data=data, timeout=timeout, headers=headers, auth=auth)
+
+    def delete(self, url, timeout=None, headers=None, auth=None):
+        return self._request('DELETE', url, timeout=timeout, headers=headers, auth=auth)
+
+    def _request(self, method, url, params=None, data=None, timeout=None, headers=None, auth=None):
+        attempt = 0
+        while True:
+            try:
+                return self._perform(method, url, params=params, data=data, timeout=timeout, headers=headers, auth=auth)
+            except pycurl.error:
+                if attempt >= self.retries:
+                    raise
+                time.sleep(self.backoff_factor * (2 ** attempt))
+                attempt += 1
+
+    def _perform(self, method, url, params=None, data=None, timeout=None, headers=None, auth=None):
+        buffer = io.BytesIO()
+        curl = pycurl.Curl()
+        request_url = self._build_url(url, params=params)
+        request_headers = self._format_headers(headers)
+
+        curl.setopt(pycurl.URL, request_url)
+        curl.setopt(pycurl.WRITEDATA, buffer)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.NOSIGNAL, True)
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT, int(timeout))
+        if request_headers:
+            curl.setopt(pycurl.HTTPHEADER, request_headers)
+        if auth:
+            curl.setopt(pycurl.USERPWD, '{}:{}'.format(auth[0], auth[1]))
+            curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+
+        if method == 'PUT':
+            body = (data or '').encode('utf-8')
+            curl.setopt(pycurl.CUSTOMREQUEST, 'PUT')
+            curl.setopt(pycurl.POSTFIELDS, body)
+            curl.setopt(pycurl.POSTFIELDSIZE, len(body))
+        elif method == 'DELETE':
+            curl.setopt(pycurl.CUSTOMREQUEST, 'DELETE')
+        else:
+            curl.setopt(pycurl.HTTPGET, True)
+
+        try:
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            body = buffer.getvalue().decode('utf-8')
+            return _PycurlResponse(status_code, body)
+        finally:
+            curl.close()
+
+    def _build_url(self, url, params=None):
+        if not params:
+            return url
+
+        query = urlencode([(key, value) for key, value in params.items() if value is not None], doseq=True)
+        return '{}?{}'.format(url, query) if query else url
+
+    def _format_headers(self, headers):
+        if not headers:
+            return []
+
+        return ['{}: {}'.format(key, value) for key, value in headers.items() if value is not None]
