+def _post_with_retry(url, payload, retries=7, backoff_factor=0.2):
+    response = None
+    delay = backoff_factor
+
+    for attempt in range(retries + 1):
+        response = http.post(url, json=payload, headers=dict(config.HEADERS))
+        if response.status_code != 202 or attempt == retries:
+            return response
+        time.sleep(delay)
+        delay *= 2
+
+    return response
 
 
