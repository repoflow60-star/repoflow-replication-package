--- a/tinychat/llms/_aiohttp.py
+++ b/tinychat/llms/_aiohttp.py
@@ -0,0 +1,37 @@
+from __future__ import annotations
+
+import asyncio
+from collections.abc import Generator
+from typing import Any
+
+import aiohttp
+
+
+async def _post_text(url: str, headers: dict[str, str], data: dict[str, Any]) -> tuple[int, str]:
+    async with aiohttp.ClientSession(headers=headers) as session:
+        async with session.post(url, json=data) as response:
+            return response.status, await response.text()
+
+
+def post_text(url: str, headers: dict[str, str], data: dict[str, Any]) -> tuple[int, str]:
+    return asyncio.run(_post_text(url, headers, data))
+
+
+def iter_sse_data(body: str) -> Generator[str, None, None]:
+    event_lines: list[str] = []
+    for line in body.splitlines():
+        if line == "":
+            if event_lines:
+                yield "\n".join(event_lines)
+                event_lines = []
+            continue
+        if line.startswith("data:"):
+            event_lines.append(line[5:].lstrip())
+    if event_lines:
+        yield "\n".join(event_lines)
+
+
+def iter_lines(body: str) -> Generator[str, None, None]:
+    for line in body.splitlines():
+        if line:
+            yield line
