+    def _handle_header_line(self, line, headers, response_status):
+        decoded = line.decode('iso-8859-1').strip()
+        if not decoded:
+            return len(line)
+
+        if decoded.startswith('HTTP/'):
+            parts = decoded.split(' ', 2)
+            if len(parts) > 1 and parts[1].isdigit():
+                response_status['code'] = int(parts[1])
+            headers.clear()
+            return len(line)
+
+        if ':' in decoded:
+            key, value = decoded.split(':', 1)
+            headers[key.strip()] = value.strip()
+
+        return len(line)
