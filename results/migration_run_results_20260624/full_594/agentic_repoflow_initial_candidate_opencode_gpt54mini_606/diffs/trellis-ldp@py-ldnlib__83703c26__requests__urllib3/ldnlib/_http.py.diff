--- a/ldnlib/_http.py
+++ b/ldnlib/_http.py
@@ -0,0 +1,62 @@
+import json
+
+import urllib3
+
+
+def _parse_links(link_header):
+    links = {}
+    if not link_header:
+        return links
+
+    for part in link_header.split(','):
+        section = part.strip()
+        if not section.startswith('<'):
+            continue
+
+        target, *params = section.split(';')
+        url = target[1:-1].strip()
+        attrs = {'url': url}
+
+        for param in params:
+            if '=' not in param:
+                continue
+            key, value = param.strip().split('=', 1)
+            attrs[key.lower()] = value.strip().strip('"')
+
+        rels = attrs.get('rel', '').split()
+        for rel in rels:
+            links[rel] = attrs
+
+    return links
+
+
+class ResponseAdapter(object):
+
+    def __init__(self, response):
+        self._response = response
+        self.status_code = response.status
+        self.headers = response.headers
+        self.links = _parse_links(response.headers.get('Link'))
+
+    @property
+    def text(self):
+        data = self._response.data or b''
+        if isinstance(data, bytes):
+            content_type = self.headers.get('content-type', '')
+            charset = 'utf-8'
+            for part in content_type.split(';')[1:]:
+                key_value = part.strip().split('=', 1)
+                if len(key_value) == 2 and key_value[0].lower() == 'charset':
+                    charset = key_value[1].strip()
+                    break
+            return data.decode(charset, errors='replace')
+        return data
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            reason = getattr(self._response, 'reason', '')
+            message = '{} Client Error: {} for url'.format(self.status_code, reason)
+            raise urllib3.exceptions.HTTPError(message)
