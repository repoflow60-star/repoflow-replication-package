+def _pycurl_version() -> str:
+    version = getattr(pycurl, '__version__', None)
+    if isinstance(version, str) and version:
+        return version
+    version = getattr(pycurl, 'version', None)
+    if isinstance(version, str):
+        for token in version.split():
+            if token.startswith('PycURL/'):
+                return token.split('/', 1)[1]
+        return version
+    return 'unknown'
+
