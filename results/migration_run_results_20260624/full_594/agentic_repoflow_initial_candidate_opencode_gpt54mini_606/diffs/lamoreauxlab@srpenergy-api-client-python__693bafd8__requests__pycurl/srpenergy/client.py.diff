+    @staticmethod
+    def _create_session():
+        """Create a curl session with cookie support enabled."""
+        session = pycurl.Curl()
+        session.setopt(pycurl.COOKIEFILE, "")
+        session.setopt(pycurl.COOKIEJAR, "")
+        return session
+
+    @staticmethod
+    def _perform_request(session, url, method="GET", data=None, headers=None):
+        """Perform a request and return the response body as text."""
+        buffer = io.BytesIO()
+        session.setopt(pycurl.URL, url.encode("utf-8"))
+        session.setopt(pycurl.WRITEDATA, buffer)
+        session.setopt(pycurl.HTTPHEADER, headers or [])
+
+        if method == "POST":
+            session.setopt(pycurl.HTTPGET, 0)
+            session.setopt(pycurl.POST, 1)
+            session.setopt(pycurl.POSTFIELDS, urlencode(data or {}))
+        else:
+            session.setopt(pycurl.POST, 0)
+            session.setopt(pycurl.HTTPGET, 1)
+
+        session.perform()
+        return buffer.getvalue().decode("utf-8")
+
+    @staticmethod
+    def _get_cookie(session, cookie_name):
+        """Return a cookie value from the active curl session."""
+        for cookie in session.getinfo(pycurl.INFO_COOKIELIST):
+            fields = cookie.split("\t")
+            if len(fields) >= 7 and fields[5] == cookie_name:
+                return unquote(fields[6])
+
+        raise KeyError(cookie_name)
+
