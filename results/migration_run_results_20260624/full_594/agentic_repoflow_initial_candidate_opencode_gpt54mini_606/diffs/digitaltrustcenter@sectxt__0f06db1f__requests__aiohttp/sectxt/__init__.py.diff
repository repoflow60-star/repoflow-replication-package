+            request_kwargs = {
+                "headers": headers,
+                "timeout": timeout,
+            }
+            if not verify:
+                request_kwargs["ssl"] = False
+            async with session.get(url, **request_kwargs) as resp:
+                content = await resp.read()
+                response_headers = {key.lower(): value for key, value in resp.headers.items()}
+                history_urls = [str(item.url) for item in resp.history]
+                return resp.status, response_headers, content, history_urls, str(resp.url)
+
+    def _fetch(self, url: str, verify: bool = True):
+        return asyncio.run(self._fetch_async(url, verify=verify))
