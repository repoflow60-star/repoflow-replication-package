+    def _make_post_request(request_url: str, data: dict, **kwargs) -> _PycurlResponseAdapter:
+        timeout = kwargs.pop('timeout', 10)
+        allow_redirects = kwargs.pop('allow_redirects', True)
+        verify = kwargs.pop('verify', True)
+        headers = kwargs.pop('headers', None)
+
+        buffer = io.BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, request_url)
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, json.dumps(data).encode('utf-8'))
+            curl.setopt(pycurl.WRITEFUNCTION, buffer.write)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            if timeout is not None:
+                curl.setopt(pycurl.TIMEOUT_MS, int(timeout * 1000))
+            curl.setopt(pycurl.FOLLOWLOCATION, 0 if allow_redirects is False else 1)
+            if verify is False:
+                curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+                curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+            else:
+                curl.setopt(pycurl.SSL_VERIFYPEER, 1)
+                curl.setopt(pycurl.SSL_VERIFYHOST, 2)
+            if headers:
+                if isinstance(headers, dict):
+                    headers = [f'{key}: {value}' for key, value in headers.items()]
+                curl.setopt(pycurl.HTTPHEADER, headers)
+            curl.perform()
+            return _PycurlResponseAdapter(buffer.getvalue(), curl.getinfo(pycurl.RESPONSE_CODE))
+        finally:
+            curl.close()
 
