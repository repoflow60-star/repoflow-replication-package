+import treq
+from twisted.internet import reactor, threads
+
 logger = logging.getLogger(__name__)
 
 _DEFAULT_TIME = datetime.min
+_REACTOR_THREAD = None
+_REACTOR_LOCK = threading.Lock()
+
+
+def _ensure_reactor_running() -> None:
+    global _REACTOR_THREAD
+
+    if reactor.running:
+        return
+
+    with _REACTOR_LOCK:
+        if reactor.running:
+            return
+        if _REACTOR_THREAD is None:
+            _REACTOR_THREAD = threading.Thread(
+                target=reactor.run,
+                kwargs={"installSignalHandlers": False},
+                daemon=True,
+                name="arxiv-treq-reactor",
+            )
+            _REACTOR_THREAD.start()
+
+    while not reactor.running:
+        time.sleep(0.01)
+
+
+def _treq_fetch(url: str, try_index: int) -> bytes:
+    _ensure_reactor_running()
+
+    def _request():
+        def _on_response(resp):
+            if resp.code != 200:
+                raise HTTPError(url, try_index, resp.code)
+            return treq.content(resp)
+
+        return treq.get(url, headers={"user-agent": "arxiv.py/2.1.3"}).addCallback(
+            _on_response
+        )
+
+    try:
+        return threads.blockingCallFromThread(reactor, _request)
+    except HTTPError:
+        raise
+    except Exception as exc:
+        raise ConnectionError(str(exc)) from exc
 
 
