+    def _ssl_context(self):
+        if not self.verify and not self.certs:
+            return False
+
+        context = ssl.create_default_context()
+        if not self.verify:
+            context.check_hostname = False
+            context.verify_mode = ssl.CERT_NONE
+
+        if self.certs:
+            if isinstance(self.certs, tuple):
+                context.load_cert_chain(*self.certs)
+            else:
+                context.load_cert_chain(self.certs)
+
+        return context
+
+    @staticmethod
+    def _response_payload(status, response_text):
+        try:
+            return {
+                "data": json.loads(response_text),
+                "status": status
+            }
+        except ValueError:
+            return {
+                "data": response_text,
+                "status": status
+            }
+
+    @staticmethod
+    def _form_data(body):
+        form_data = aiohttp.FormData()
+        for key, value in body.items():
+            if isinstance(value, tuple):
+                filename = value[0] if len(value) > 0 else None
+                content = value[1] if len(value) > 1 else None
+                content_type = value[2] if len(value) > 2 else None
+                headers = value[3] if len(value) > 3 else None
+                field_kwargs = {}
+                if filename is not None:
+                    field_kwargs["filename"] = filename
+                if content_type is not None:
+                    field_kwargs["content_type"] = content_type
+                if headers is not None:
+                    field_kwargs["headers"] = headers
+                form_data.add_field(key, content, **field_kwargs)
+            else:
+                form_data.add_field(key, value)
+        return form_data
+
+    async def _request(self, method, endpoint, params=None, body=None, use_form_data=False):
+        request_kwargs = {
+            "params": params,
+            "ssl": self._ssl_context(),
+        }
+        if use_form_data:
+            request_kwargs["data"] = self._form_data(body or {})
+        elif body is not None:
+            request_kwargs["json"] = body
+
+        async with aiohttp.ClientSession(headers=self.headers) as session:
+            async with session.request(method, self.url + endpoint, **request_kwargs) as response:
+                return response.status, await response.text()
+
+    def _perform_request(self, method, endpoint, params=None, body=None, use_form_data=False):
+        try:
+            return asyncio.run(self._request(method, endpoint, params=params, body=body, use_form_data=use_form_data))
+        except (aiohttp.ClientError, asyncio.TimeoutError) as exc:
+            raise ConnectionUnavailableError(payload=str(exc)) from None
 
