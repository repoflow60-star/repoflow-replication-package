+def _render_table(headers: list, rows: list) -> str:
+    table_rows = [headers, *rows]
+    widths = [max(len(str(row[i])) for row in table_rows)
+              for i in range(len(headers))]
+
+    def format_row(row):
+        return "  ".join(str(value).rjust(widths[i])
+                          for i, value in enumerate(row))
+
+    lines = [format_row(headers),
+             "  ".join("-" * width for width in widths)]
+    lines.extend(format_row(row) for row in rows)
+
+    rendered = "\n".join(lines)
+    console = Console(record=True, file=StringIO(), width=1000)
+    console.print(rendered, end="")
+    return console.export_text(styles=False).rstrip("\n")
 
 
