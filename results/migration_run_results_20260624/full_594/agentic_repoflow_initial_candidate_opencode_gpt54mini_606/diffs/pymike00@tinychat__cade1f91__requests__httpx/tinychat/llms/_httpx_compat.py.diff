--- a/tinychat/llms/_httpx_compat.py
+++ b/tinychat/llms/_httpx_compat.py
@@ -0,0 +1,37 @@
+import httpx
+
+
+Response = httpx.Response
+
+
+class StreamResponseAdapter:
+    def __init__(self, response, stream_cm):
+        self._response = response
+        self._stream_cm = stream_cm
+
+    def __iter__(self):
+        yield from self._response.iter_bytes()
+
+    def iter_content(self, chunk_size=1, decode_unicode=False):
+        if decode_unicode:
+            yield from self._response.iter_text(chunk_size)
+        else:
+            yield from self._response.iter_bytes(chunk_size)
+
+    def close(self):
+        self._stream_cm.__exit__(None, None, None)
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
+
+def post(url, *, headers=None, json=None, stream=False):
+    if not stream:
+        return httpx.post(url, headers=headers, json=json)
+
+    try:
+        return httpx.post(url, headers=headers, json=json, stream=True)
+    except TypeError:
+        stream_cm = httpx.stream("POST", url, headers=headers, json=json)
+        response = stream_cm.__enter__()
+        return StreamResponseAdapter(response, stream_cm)
