--- a/tinychat/llms/httpx_sse.py
+++ b/tinychat/llms/httpx_sse.py
@@ -0,0 +1,58 @@
+from typing import Any
+
+import httpx
+from sseclient import SSEClient
+
+
+class _HttpxEventSource:
+    def __init__(self, response: httpx.Response, client: httpx.Client) -> None:
+        self._response = response
+        self._client = client
+
+    def iter_content(self, chunk_size: int = 1, decode_unicode: bool = False):
+        for chunk in self._response.iter_bytes(chunk_size):
+            if decode_unicode and isinstance(chunk, bytes):
+                yield chunk.decode(self._response.encoding or "utf-8", errors="replace")
+            else:
+                yield chunk
+
+    def iter_lines(self):
+        yield from self._response.iter_lines()
+
+    def __iter__(self):
+        yield from self.iter_content()
+
+    @property
+    def status_code(self) -> int:
+        return self._response.status_code
+
+    @property
+    def headers(self):
+        return self._response.headers
+
+    @property
+    def encoding(self):
+        return self._response.encoding
+
+    def close(self) -> None:
+        self._response.close()
+        self._client.close()
+
+
+def post_stream_response(
+    url: str, headers: dict[str, str], json_data: dict[str, Any]
+) -> _HttpxEventSource:
+    client = httpx.Client(timeout=None)
+    request = client.build_request("POST", url, headers=headers, json=json_data)
+    response = client.send(request, stream=True)
+    if response.status_code != 200:
+        response.close()
+        client.close()
+        raise ValueError(
+            f"Server responded with an error. Status Code: {response.status_code}"
+        )
+    return _HttpxEventSource(response, client)
+
+
+def post_sse(url: str, headers: dict[str, str], json_data: dict[str, Any]) -> SSEClient:
+    return SSEClient(event_source=post_stream_response(url, headers, json_data))  # type: ignore[arg-type]
