+def _prometheus_get(url: str) -> str:
+    buffer = io.BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEFUNCTION, buffer.write)
+        curl.perform()
+        return buffer.getvalue().decode("utf-8")
+    finally:
+        curl.close()
