+    def _build_url(self, endpoint, params=None, root_url=None):
+        url = (root_url or self.url) + endpoint
+        if params:
+            filtered_params = [(key, value) for key, value in params.items() if value is not None]
+            query_string = urlencode(filtered_params, doseq=True)
+            if query_string:
+                separator = '&' if '?' in url else '?'
+                url = f"{url}{separator}{query_string}"
+        return url
+
+    def _build_headers(self, content_type=None):
+        headers = []
+        for key, value in self.headers.items():
+            if value is not None:
+                headers.append(f"{key}: {value}")
+        if content_type and not any(header.lower().startswith('content-type:') for header in headers):
+            headers.append(f"Content-Type: {content_type}")
+        return headers
+
+    def _configure_certs(self, curl):
+        curl.setopt(pycurl.SSL_VERIFYPEER, 1 if self.verify else 0)
+        curl.setopt(pycurl.SSL_VERIFYHOST, 2 if self.verify else 0)
+        if self.certs:
+            if isinstance(self.certs, tuple):
+                cert, key = self.certs
+                curl.setopt(pycurl.SSLCERT, cert)
+                curl.setopt(pycurl.SSLKEY, key)
+            else:
+                curl.setopt(pycurl.SSLCERT, self.certs)
+
+    def _perform_request(self, method, endpoint, params=None, body=None, multipart=False, root_url=None):
+        response_buffer = io.BytesIO()
+        curl = self.session
+        curl.reset()
+        curl.setopt(pycurl.URL, self._build_url(endpoint, params, root_url=root_url))
+        curl.setopt(pycurl.WRITEFUNCTION, response_buffer.write)
+        curl.setopt(pycurl.FOLLOWLOCATION, 0)
+        self._configure_certs(curl)
+
+        if multipart:
+            curl.setopt(pycurl.HTTPHEADER, self._build_headers())
+            curl.setopt(pycurl.HTTPPOST, [(key, value[1] if isinstance(value, tuple) and len(value) == 2 else value)
+                                          for key, value in body.items()])
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+        elif body is not None:
+            payload = json.dumps(body).encode('utf-8')
+            curl.setopt(pycurl.HTTPHEADER, self._build_headers('application/json'))
+            curl.setopt(pycurl.POSTFIELDS, payload)
+            curl.setopt(pycurl.POSTFIELDSIZE, len(payload))
+            if method != 'POST':
+                curl.setopt(pycurl.CUSTOMREQUEST, method)
+        else:
+            curl.setopt(pycurl.HTTPHEADER, self._build_headers())
+            if method != 'GET':
+                curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+        try:
+            curl.perform()
+        except pycurl.error as e:
+            raise ConnectionUnavailableError(message=str(e)) from None
+
+        status = curl.getinfo(pycurl.RESPONSE_CODE)
+        response_text = response_buffer.getvalue().decode('utf-8', errors='replace')
+        return status, response_text
+
+    def _response_data(self, response_text):
+        try:
+            return json.loads(response_text)
+        except ValueError:
+            return response_text
+
+    def _raise_http_error(self, method, status, response_text):
+        message = self.parse_response_message(response_text)
+        if method == 'GET' and status == 404:
+            raise NotFoundError(message=message, status=status, payload=response_text) from None
+        if method == 'POST' and status == 400:
+            raise InvalidJsonError(message=message, status=status, payload=response_text) from None
+        if method == 'POST' and status == 401:
+            raise UnauthorizedError(message=message, status=status, payload=response_text) from None
+        if method == 'PUT' and status == 400:
+            raise InvalidJsonError(message=message, status=status, payload=response_text) from None
+        if method == 'PUT' and status == 401:
+            raise UnauthorizedError(message=message, status=status, payload=response_text) from None
+        if method == 'PUT_FILE' and status == 400:
+            raise InvalidJsonError(message=message, status=status, payload=response_text) from None
+        if method == 'PUT_FILE' and status == 401:
+            raise UnauthorizedError(message=message, status=status, payload=response_text) from None
+        if method == 'DELETE' and status == 401:
+            raise UnauthorizedError(message=message, status=status, payload=response_text) from None
+        if method == 'DELETE' and status == 404:
+            raise NotFoundError(message=message, status=status, payload=response_text) from None
+        raise HttpError(message=message, status=status, payload=response_text) from None
 
