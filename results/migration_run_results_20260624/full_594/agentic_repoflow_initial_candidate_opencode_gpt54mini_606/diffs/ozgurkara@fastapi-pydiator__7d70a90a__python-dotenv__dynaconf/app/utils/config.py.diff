+from dynaconf import Dynaconf
 
 
+settings = Dynaconf(envvar_prefix=False, load_dotenv=True)
+
+
+def _get_bool(name, default):
+    value = settings.get(name, default)
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, str):
+        return value.lower() in {"1", "true", "yes", "on"}
+    return bool(value)
+
+
+REDIS_HOST = settings.get("REDIS_HOST", "0.0.0.0")
+REDIS_PORT = int(settings.get("REDIS_PORT", 6379))
+REDIS_DB = int(settings.get("REDIS_DB", 0))
+REDIS_KEY_PREFIX = settings.get("REDIS_KEY_PREFIX", "fastapi_pydiator:")
+
+DISTRIBUTED_CACHE_IS_ENABLED = _get_bool("DISTRIBUTED_CACHE_IS_ENABLED", True)
+CACHE_PIPELINE_IS_ENABLED = _get_bool("CACHE_PIPELINE_IS_ENABLED", False)
+LOG_PIPELINE_IS_ENABLED = _get_bool("LOG_PIPELINE_IS_ENABLED", True)
+
