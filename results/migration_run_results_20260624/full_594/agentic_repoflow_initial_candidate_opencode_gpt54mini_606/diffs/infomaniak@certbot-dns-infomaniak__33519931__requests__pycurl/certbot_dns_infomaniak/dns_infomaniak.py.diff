+    def _headers(self, content_type=None):
+        headers = ["Authorization: Bearer {token}".format(token=self.token)]
+        if content_type:
+            headers.append("Content-Type: {content_type}".format(content_type=content_type))
+        return headers
+
+    def _request_json(self, method, url, payload=None):
+        """Perform a JSON API request against Infomaniak.
+
+        :param str url: relative url
+        :param dict payload: request payload or query parameters
+        """
+        if method == "GET" and payload:
+            query = urllib.parse.urlencode(payload, doseq=True)
+            url = "{base}{path}?{query}".format(base=self.baseUrl, path=url, query=query)
+        else:
+            url = self.baseUrl + url
+        logger.debug("%s %s", method, url)
+
+        body = io.BytesIO()
+        headers = self._headers("application/json" if method == "POST" else None)
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEFUNCTION, body.write)
+            curl.setopt(pycurl.HTTPHEADER, headers)
+            curl.setopt(pycurl.FOLLOWLOCATION, False)
+            curl.setopt(pycurl.NOSIGNAL, True)
+            if method == "POST":
+                curl.setopt(pycurl.POST, 1)
+                curl.setopt(pycurl.POSTFIELDS, json.dumps(payload))
+            elif method == "DELETE":
+                curl.setopt(pycurl.CUSTOMREQUEST, "DELETE")
+            curl.perform()
+        except pycurl.error as exc:
+            raise errors.PluginError("error in API request: {}".format(exc)) from exc
+        finally:
+            curl.close()
+
+        try:
+            result = json.loads(body.getvalue().decode("utf-8"))
+        except json.decoder.JSONDecodeError as exc:
+            raise errors.PluginError("no JSON in API response") from exc
+
+        if result["result"] == "success":
+            return result["data"]
+        if result["error"]["code"] == "not_authorized":
+            raise errors.PluginError("cannot authenticate")
+        raise errors.PluginError(
+            "error in API request: {} / {}".format(
+                result["error"]["code"], result["error"]["description"]
+            )
+        )
 
