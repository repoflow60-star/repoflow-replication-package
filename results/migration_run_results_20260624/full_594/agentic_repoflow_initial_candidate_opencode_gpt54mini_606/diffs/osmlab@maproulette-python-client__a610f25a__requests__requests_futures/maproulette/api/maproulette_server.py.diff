+    def _request(self, request_method, *args, **kwargs):
+        try:
+            return request_method(*args, **kwargs).result()
+        except Exception as e:
+            if type(e).__name__ in ("ConnectionError", "Timeout"):
+                response = getattr(e, "response", None)
+                message = self.parse_response_message(response) if response is not None else str(e)
+                raise ConnectionUnavailableError(
+                    message=message,
+                    status=getattr(response, "status_code", None)
+                ) from None
+            raise
+
+    def _raise_for_status(self, response, error_map):
