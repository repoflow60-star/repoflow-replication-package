+_reactor_thread = None
+_reactor_ready = threading.Event()
+_reactor_thread_lock = threading.Lock()
+
+
+def _ensure_reactor_thread():
+    global _reactor_thread
+
+    with _reactor_thread_lock:
+        if reactor.running:
+            _reactor_ready.set()
+        elif _reactor_thread is None or not _reactor_thread.is_alive():
+            _reactor_ready.clear()
+
+            def _run_reactor():
+                reactor.callWhenRunning(_reactor_ready.set)
+                reactor.run(installSignalHandlers=False)
+
+            _reactor_thread = threading.Thread(
+                target=_run_reactor,
+                daemon=True)
+            _reactor_thread.start()
+    _reactor_ready.wait()
+
+
+def _read_url(uri, encoding, timeout):
+    def _fetch(_reactor):
+        def _check_status(response):
+            if response.code >= 400:
+                phrase = response.phrase
+                if isinstance(phrase, bytes):
+                    phrase = phrase.decode('utf-8', errors='replace')
+                raise TwistedHTTPError(response.code, phrase)
+            return treq.content(response)
+
+        def _decode(body):
+            return body.decode(encoding)
+
+        deferred = treq.get(uri, timeout=timeout)
+        deferred.addCallback(_check_status)
+        deferred.addCallback(_decode)
+        return deferred
+
+    _ensure_reactor_thread()
+    return threads.blockingCallFromThread(reactor, _fetch)
 
 
