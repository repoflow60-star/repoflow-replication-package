--- a/src/coguard_cli/http_client.py
+++ b/src/coguard_cli/http_client.py
@@ -0,0 +1,92 @@
+"""
+Shared HTTP helpers built on urllib3.
+"""
+
+import json
+
+import urllib3
+
+
+_HTTP_POOL = urllib3.PoolManager(retries=False)
+
+
+class ResponseAdapter:
+    """
+    Minimal response wrapper that provides the subset of the requests API
+    used by the CLI.
+    """
+
+    def __init__(self, response):
+        self._response = response
+        self.status_code = response.status
+        self.reason = str(response.reason) if response.reason is not None else ""
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        self.close()
+        return False
+
+    def __repr__(self):
+        return f"<Response [{self.status_code}]>"
+
+    __str__ = __repr__
+
+    def close(self):
+        self._response.close()
+
+    @property
+    def content(self):
+        data = self._response.data
+        if data is None:
+            data = self._response.read()
+        return data
+
+    @property
+    def text(self):
+        return (self.content or b"").decode("utf-8", errors="replace")
+
+    def json(self):
+        return json.loads(self.text)
+
+    def iter_content(self, chunk_size=8192):
+        for chunk in self._response.stream(chunk_size, decode_content=True):
+            if chunk:
+                yield chunk
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise urllib3.exceptions.HTTPError(
+                f"{self.status_code} {self.reason}".strip()
+            )
+
+
+def request(method, url, *, headers=None, timeout=None, data=None, json_body=None,
+            stream=False):
+    request_kwargs = {
+        "headers": headers or {},
+        "timeout": timeout,
+        "preload_content": not stream,
+    }
+    if json_body is not None:
+        request_kwargs["body"] = json.dumps(json_body).encode("utf-8")
+    elif isinstance(data, dict):
+        request_kwargs["fields"] = data
+        request_kwargs["encode_multipart"] = False
+    elif data is not None:
+        request_kwargs["body"] = data
+    response = _HTTP_POOL.request(method, url, **request_kwargs)
+    return ResponseAdapter(response)
+
+
+def get(url, **kwargs):
+    return request("GET", url, **kwargs)
+
+
+def post(url, **kwargs):
+    return request("POST", url, **kwargs)
+
+
+def put(url, **kwargs):
+    return request("PUT", url, **kwargs)
