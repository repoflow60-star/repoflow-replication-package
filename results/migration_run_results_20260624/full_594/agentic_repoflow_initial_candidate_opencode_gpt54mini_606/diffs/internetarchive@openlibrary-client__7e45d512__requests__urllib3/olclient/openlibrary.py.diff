+class _Urllib3Session:
+    def __init__(self):
+        self._pool = urllib3.PoolManager()
+        self.cookies = {}
+
+    def _cookie_header(self):
+        if not self.cookies:
+            return None
+        return '; '.join(f'{key}={value}' for key, value in self.cookies.items())
+
+    def _update_cookies(self, response):
+        set_cookie_headers = []
+        if hasattr(response.headers, 'getlist'):
+            set_cookie_headers = response.headers.getlist('Set-Cookie') or response.headers.getlist('set-cookie')
+        else:
+            header = response.headers.get('Set-Cookie') or response.headers.get('set-cookie')
+            if header:
+                set_cookie_headers = [header]
+
+        for header in set_cookie_headers:
+            cookie = SimpleCookie()
+            cookie.load(header)
+            for name, morsel in cookie.items():
+                self.cookies[name] = morsel.value
+
+    def request(self, method, url, data=None, headers=None, files=None, json_data=None, params=None):
+        request_headers = dict(headers or {})
+        cookie_header = self._cookie_header()
+        if cookie_header:
+            request_headers.setdefault('Cookie', cookie_header)
+
+        if params:
+            url_parts = urlsplit(url)
+            query = parse_qsl(url_parts.query, keep_blank_values=True)
+            if isinstance(params, dict):
+                for key, value in params.items():
+                    if isinstance(value, (list, tuple)):
+                        query.extend((key, item) for item in value)
+                    else:
+                        query.append((key, value))
+            else:
+                query.extend(params)
+            url = urlunsplit(url_parts._replace(query=urlencode(query, doseq=True)))
+
+        request_kwargs = {}
+        if json_data is not None:
+            request_kwargs['body'] = json.dumps(json_data).encode('utf-8')
+            request_headers.setdefault('Content-Type', 'application/json')
+        elif files is not None:
+            request_kwargs['fields'] = files
+            request_kwargs['encode_multipart'] = True
+        elif isinstance(data, dict):
+            request_kwargs['fields'] = data
+            request_kwargs['encode_multipart'] = False
+        elif data is not None:
+            request_kwargs['body'] = data.encode('utf-8') if isinstance(data, str) else data
+
+        response = self._pool.request(method.upper(), url, headers=request_headers, **request_kwargs)
+        self._update_cookies(response)
+        return _ResponseAdapter(response, url)
+
+    def get(self, url, **kwargs):
