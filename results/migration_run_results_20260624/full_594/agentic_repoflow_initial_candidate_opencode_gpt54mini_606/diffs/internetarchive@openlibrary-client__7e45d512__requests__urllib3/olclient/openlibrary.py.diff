+class _HTTPResponseError(urllib3.exceptions.HTTPError):
+    def __init__(self, response):
+        self.response = response
+        super().__init__(f"{response.status_code} Error for url: {response.url}")
+
+
+class _ResponseAdapter:
+    def __init__(self, response, url):
+        self._response = response
+        self.url = response.geturl() if hasattr(response, 'geturl') else url
+        self.status_code = response.status
+        self.headers = response.headers
+
+    def json(self):
+        return json.loads(self._response.data.decode('utf-8'))
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise _HTTPResponseError(self)
+
