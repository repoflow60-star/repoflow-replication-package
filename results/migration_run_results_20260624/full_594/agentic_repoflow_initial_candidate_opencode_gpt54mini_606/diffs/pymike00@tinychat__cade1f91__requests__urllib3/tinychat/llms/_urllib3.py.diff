--- a/tinychat/llms/_urllib3.py
+++ b/tinychat/llms/_urllib3.py
@@ -0,0 +1,62 @@
+import json
+
+import urllib3
+
+
+_HTTP = urllib3.PoolManager()
+
+
+class StreamResponseAdapter:
+    def __init__(self, response: urllib3.response.HTTPResponse) -> None:
+        self._response = response
+        self.status_code = response.status
+        self.headers = response.headers
+        self.raw = response
+
+    def iter_content(self, chunk_size: int = 1, decode_unicode: bool = False):
+        for chunk in self._response.stream(chunk_size, decode_content=True):
+            yield chunk.decode("utf-8") if decode_unicode else chunk
+
+    def iter_lines(self, chunk_size: int = 1, decode_unicode: bool = False):
+        pending = b""
+        for chunk in self.iter_content(chunk_size=chunk_size, decode_unicode=False):
+            pending += chunk
+            lines = pending.splitlines(keepends=True)
+            if lines and not lines[-1].endswith((b"\n", b"\r")):
+                pending = lines.pop()
+            else:
+                pending = b""
+            for line in lines:
+                line = line.rstrip(b"\r\n")
+                yield line.decode("utf-8") if decode_unicode else line
+        if pending:
+            pending = pending.rstrip(b"\r\n")
+            yield pending.decode("utf-8") if decode_unicode else pending
+
+    def close(self) -> None:
+        self._response.close()
+
+    def release_conn(self) -> None:
+        self._response.release_conn()
+
+    def __iter__(self):
+        return self.iter_content()
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
+
+def post_stream(url: str, headers: dict[str, str], payload: dict) -> StreamResponseAdapter:
+    response = _HTTP.request(
+        "POST",
+        url,
+        body=json.dumps(payload).encode("utf-8"),
+        headers=headers,
+        preload_content=False,
+    )
+    if response.status != 200:
+        response.release_conn()
+        raise ValueError(
+            f"Server responded with an error. Status Code: {response.status}"
+        )
+    return StreamResponseAdapter(response)
