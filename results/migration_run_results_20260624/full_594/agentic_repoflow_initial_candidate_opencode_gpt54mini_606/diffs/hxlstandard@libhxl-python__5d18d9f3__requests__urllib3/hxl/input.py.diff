+import ssl
+
+import urllib3
+
 logger = logging.getLogger(__name__)
+
+
+def _http_pool(verify_ssl):
+    kwargs = {
+        "cert_reqs": ssl.CERT_REQUIRED if verify_ssl else ssl.CERT_NONE,
+        "retries": False,
+    }
+    if not verify_ssl:
+        kwargs["assert_hostname"] = False
+    return urllib3.PoolManager(**kwargs)
+
+
+class _HTTPResponseAdapter:
+    def __init__(self, response):
+        self._response = response
+        self.status_code = response.status
+        self.headers = response.headers
+        self.raw = response
+
+    @property
+    def content(self):
+        return self._response.data
+
+    @property
+    def is_redirect(self):
+        return self.status_code in (301, 302, 303, 307, 308) and self.headers.get('Location') is not None
+
+    def json(self):
+        return json.loads(self._response.data.decode('utf-8'))
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise urllib3.exceptions.HTTPError("HTTP {}".format(self.status_code))
+
+    def close(self):
+        self._response.close()
+
+
+def _request(method, url, input_options, headers=None, fields=None, body=None, redirect=True):
+    response = _http_pool(input_options.verify_ssl).request(
+        method,
+        url,
+        headers=headers,
+        fields=fields,
+        body=body,
+        timeout=input_options.timeout,
+        redirect=redirect,
+    )
+    return _HTTPResponseAdapter(response)
 
