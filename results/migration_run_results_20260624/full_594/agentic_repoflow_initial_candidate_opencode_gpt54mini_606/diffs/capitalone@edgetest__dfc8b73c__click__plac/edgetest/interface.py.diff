+def _translate_args(args):
+    """Translate short CLI aliases to plac-friendly long options."""
+    aliases = {
+        "-c": "--config",
+        "-r": "--requirements",
+        "-e": "--environment",
+        "-n": "--notest",
+        "-s": "--nosetup",
+        "-x": "--extras",
+        "-d": "--deps",
+        "-m": "--command",
+        "-o": "--export",
+    }
+    translated = []
+    for arg in args:
+        for short, long in aliases.items():
+            if arg == short:
+                translated.append(long)
+                break
+            if arg.startswith(f"{short}="):
+                translated.append(f"{long}={arg[len(short) + 1 :]}")
+                break
+            if arg.startswith(short) and len(arg) > len(short):
+                translated.append(f"{long}={arg[len(short) :]}")
+                break
+        else:
+            translated.append(arg)
+    return translated
+
+
+def _normalize_multi(value):
+    """Normalize a possibly repeated plac option into a list."""
+    if value in (None, [], ()):
+        return None
+    if isinstance(value, str):
+        return [value]
+    return list(value)
+
+
+def _invoke_cli(args=None, prog_name=None, **_kwargs):
+    """Invoke the plac command with runner-compatible semantics."""
+    argv = [prog_name or "edgetest"]
+    if args is None:
+        raw_args = sys.argv[1:]
+    elif isinstance(args, str):
+        raw_args = [args]
+    else:
+        raw_args = list(args)
+    argv.extend(_translate_args(raw_args))
+
+    old_argv = sys.argv
+    try:
+        sys.argv = argv
+        return plac.call(_cli)
+    finally:
+        sys.argv = old_argv
+
