--- a/ldnlib/_treq.py
+++ b/ldnlib/_treq.py
@@ -0,0 +1,145 @@
+import json
+import threading
+
+import treq
+from twisted.internet.threads import blockingCallFromThread
+
+
+_reactor_lock = threading.Lock()
+_reactor_thread = None
+_reactor_ready = threading.Event()
+
+
+def _get_reactor():
+    from twisted.internet import reactor
+    return reactor
+
+
+def _normalize_headers(headers):
+    normalized = {}
+    for name, values in headers.getAllRawHeaders():
+        if isinstance(name, bytes):
+            key = name.decode("ascii")
+        else:
+            key = str(name)
+
+        if isinstance(values, (list, tuple)):
+            value = ", ".join(
+                item.decode("utf-8") if isinstance(item, bytes) else str(item)
+                for item in values)
+        else:
+            value = values.decode("utf-8") if isinstance(values, bytes) else str(values)
+
+        normalized[key.lower()] = value
+
+    return normalized
+
+
+def _parse_links(link_header):
+    links = {}
+    if not link_header:
+        return links
+
+    for part in link_header.split(","):
+        part = part.strip()
+        if not part.startswith("<") or ">" not in part:
+            continue
+
+        url, params = part[1:].split(">", 1)
+        link = {"url": url}
+        rel = None
+
+        for param in params.split(";"):
+            param = param.strip()
+            if "=" not in param:
+                continue
+
+            key, value = param.split("=", 1)
+            value = value.strip().strip('"')
+            if key == "rel":
+                rel = value
+            else:
+                link[key] = value
+
+        if rel:
+            links[rel] = link
+
+    return links
+
+
+class _Response(object):
+
+    def __init__(self, response, body):
+        self.status_code = response.code
+        self.headers = _normalize_headers(response.headers)
+        self.links = _parse_links(self.headers.get("link"))
+        self._body = body or b""
+
+    @property
+    def text(self):
+        if isinstance(self._body, bytes):
+            return self._body.decode("utf-8")
+        return self._body
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise RuntimeError("HTTP {0}".format(self.status_code))
+
+
+def _start_reactor_thread():
+    reactor = _get_reactor()
+    if reactor.running:
+        return
+
+    def _run():
+        reactor.callWhenRunning(_reactor_ready.set)
+        reactor.run(installSignalHandlers=False)
+
+    global _reactor_thread
+    with _reactor_lock:
+        if _reactor_thread is not None and _reactor_thread.is_alive():
+            return
+
+        _reactor_ready.clear()
+        _reactor_thread = threading.Thread(
+            target=_run,
+            name="ldnlib-treq-reactor",
+            daemon=True)
+        _reactor_thread.start()
+        _reactor_ready.wait()
+
+
+def _request(method, url, **kwargs):
+    reactor = _get_reactor()
+    if _reactor_thread is not None and threading.current_thread() is _reactor_thread:
+        raise RuntimeError("ldnlib treq helpers require a non-reactor thread")
+
+    _start_reactor_thread()
+
+    def _do_request():
+        deferred = getattr(treq, method)(url, **kwargs)
+        deferred.addCallback(
+            lambda response: treq.content(response).addCallback(
+                lambda body: _Response(response, body)))
+        return deferred
+
+    return blockingCallFromThread(reactor, _do_request)
+
+
+def head(url, **kwargs):
+    return _request("head", url, **kwargs)
+
+
+def get(url, **kwargs):
+    return _request("get", url, **kwargs)
+
+
+def options(url, **kwargs):
+    return _request("options", url, **kwargs)
+
+
+def post(url, **kwargs):
+    return _request("post", url, **kwargs)
