+    @staticmethod
+    def __sanitize_headers(headers, content_type=None):
+        request_headers = {key: value for key, value in headers.items() if value is not None}
+        if content_type:
+            request_headers["Content-Type"] = content_type
+        return request_headers
+
+    @classmethod
+    def __ensure_reactor_running(cls):
+        global _REACTOR_THREAD
+
+        with _REACTOR_LOCK:
+            if reactor.running:
+                return
+            # treq is Deferred-based, so keep a reactor alive in the background for blocking callers.
+            if _REACTOR_THREAD is None or not _REACTOR_THREAD.is_alive():
+                _REACTOR_THREAD = threading.Thread(
+                    target=reactor.run,
+                    kwargs={"installSignalHandlers": False},
+                    daemon=True,
+                )
+                _REACTOR_THREAD.start()
+
+        for _ in range(500):
+            if reactor.running:
+                return
+            time.sleep(0.01)
+
+        raise ConnectionUnavailableError(message='Specified server unavailable')
+
+    @staticmethod
+    def __response_body_text(response_body):
+        if isinstance(response_body, bytes):
+            return response_body.decode('utf-8', errors='replace')
+        return response_body
+
+    @inlineCallbacks
+    def __fetch(self, method, url, params=None, body=None, files=None):
+        request_kwargs = {
+            "headers": self.__sanitize_headers(self.headers)
+        }
+        if params is not None:
+            request_kwargs["params"] = params
+        if files is not None:
+            request_kwargs["files"] = files
+        elif body is not None:
+            request_kwargs["data"] = json.dumps(body).encode('utf-8')
+            request_kwargs["headers"] = self.__sanitize_headers(self.headers, content_type='application/json')
+
+        response = yield getattr(treq, method)(url, **request_kwargs)
+        response_body = yield treq.content(response)
+        response_text = self.__response_body_text(response_body)
+        return {
+            "data": self._decode_response_body(response_text),
+            "status": response.code,
+            "text": response_text,
+        }
+
+    def __request(self, method, url, params=None, body=None, files=None, raise_for_status=True, allow_not_found=False):
+        self.__ensure_reactor_running()
+        try:
+            response = blockingCallFromThread(
+                reactor,
+                self.__fetch,
+                method,
+                url,
+                params,
+                body,
+                files,
+            )
+        except (ConnectError, ConnectionClosed, ConnectionDone, ConnectionLost, DNSLookupError,
+                ResponseFailed, ResponseNeverReceived, TCPTimedOutError, TimeoutError) as e:
+            raise ConnectionUnavailableError(message=str(e)) from None
+
+        status = response["status"]
+        if not raise_for_status:
+            return response
+
+        if status >= 400:
+            message = self.parse_response_message(response["text"])
+            if allow_not_found and status == 404:
+                raise NotFoundError(message=message, status=status) from None
+            if status == 400:
+                raise InvalidJsonError(message=message, status=status) from None
+            if status == 401:
+                raise UnauthorizedError(message=message, status=status) from None
+            raise HttpError(message=message, status=status) from None
+
+        return {
+            "data": response["data"],
+            "status": status,
+        }
 
