+                    pass
+
+            if isinstance(file_bytes, str):
+                file_bytes = file_bytes.encode('utf-8')
+            append_line(file_bytes)
+
+    append_line('--{}--'.format(boundary))
+    return bytes(body), 'multipart/form-data; boundary={}'.format(boundary)
