+def _encode_multipart(data=None, files=None):
+    boundary = 'filestack-{}'.format(unique_id(16))
+    body = bytearray()
+
+    def append_line(value):
+        if isinstance(value, bytes):
+            body.extend(value)
+        else:
+            body.extend(str(value).encode('utf-8'))
+        body.extend(b'\r\n')
+
+    def append_field(name, value):
+        append_line('--{}'.format(boundary))
+        append_line('Content-Disposition: form-data; name="{}"'.format(name))
+        append_line('')
+        append_line(value)
+
+    if data:
+        for key, value in data.items():
+            append_field(key, value)
+
+    if files:
+        for key, file_info in files.items():
+            if len(file_info) == 3:
+                filename, file_obj, content_type = file_info
+            elif len(file_info) == 2:
+                filename, file_obj = file_info
+                content_type = 'application/octet-stream'
+            else:
+                filename, file_obj, content_type = file_info[0], file_info[1], file_info[2]
+
+            append_line('--{}'.format(boundary))
+            append_line('Content-Disposition: form-data; name="{}"; filename="{}"'.format(key, filename))
+            append_line('Content-Type: {}'.format(content_type))
+            append_line('')
+
+            position = None
+            if hasattr(file_obj, 'tell') and hasattr(file_obj, 'seek'):
+                try:
+                    position = file_obj.tell()
+                except Exception:
+                    position = None
+
+            file_bytes = file_obj.read() if hasattr(file_obj, 'read') else file_obj
+            if position is not None:
+                try:
