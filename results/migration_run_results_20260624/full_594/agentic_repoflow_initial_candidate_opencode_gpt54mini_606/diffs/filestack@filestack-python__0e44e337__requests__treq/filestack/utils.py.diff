+def _wait_for(deferred):
+    future = _EVENT_LOOP.create_future()
+
+    def _resolve(value):
+        if not future.done():
+            future.set_result(value)
+        return value
+
+    def _reject(failure):
+        if not future.done():
+            future.set_exception(getattr(failure, 'value', failure))
+        return failure
+
+    deferred.addCallbacks(_resolve, _reject)
+    return _EVENT_LOOP.run_until_complete(future)
+
