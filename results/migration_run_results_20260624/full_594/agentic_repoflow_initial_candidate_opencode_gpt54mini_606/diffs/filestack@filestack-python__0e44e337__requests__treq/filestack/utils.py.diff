+def _append_params(url, params):
+    if not params:
+        return url
+
+    parts = list(urlsplit(url))
+    query = parts[3]
+    encoded = urlencode(params, doseq=True)
+    parts[3] = '&'.join([item for item in (query, encoded) if item])
+    return urlunsplit(parts)
