+_REACTOR_THREAD = None
+_REACTOR_STARTED = threading.Event()
+_REACTOR_LOCK = threading.Lock()
+_REACTOR_ERROR = None
+
+
+def _ensure_reactor_thread():
+    if reactor.running:
+        return
+
+    global _REACTOR_THREAD, _REACTOR_ERROR
+    with _REACTOR_LOCK:
+        if _REACTOR_THREAD is None or not _REACTOR_THREAD.is_alive():
+            _REACTOR_STARTED.clear()
+            _REACTOR_ERROR = None
+
+            def _run_reactor():
+                global _REACTOR_ERROR
+                reactor.callWhenRunning(_REACTOR_STARTED.set)
+                try:
+                    reactor.run(installSignalHandlers=False)
+                except Exception as exc:
+                    _REACTOR_ERROR = exc
+                    _REACTOR_STARTED.set()
+
+            _REACTOR_THREAD = threading.Thread(target=_run_reactor, name='treq-reactor', daemon=True)
+            _REACTOR_THREAD.start()
+
+    _REACTOR_STARTED.wait()
+    if _REACTOR_ERROR is not None:
+        raise _REACTOR_ERROR
 
 
