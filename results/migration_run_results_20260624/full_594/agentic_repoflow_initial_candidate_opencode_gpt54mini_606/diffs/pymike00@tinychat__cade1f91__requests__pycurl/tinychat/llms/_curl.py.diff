--- a/tinychat/llms/_curl.py
+++ b/tinychat/llms/_curl.py
@@ -0,0 +1,70 @@
+import io
+import json
+from dataclasses import dataclass
+from typing import Iterator, Mapping
+
+import pycurl
+
+
+@dataclass
+class CurlResponse:
+    status_code: int
+    body: bytes
+
+
+def post_json(url: str, headers: Mapping[str, str], payload: dict) -> CurlResponse:
+    body = json.dumps(payload).encode("utf-8")
+    response_body = io.BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.POST, 1)
+        curl.setopt(pycurl.POSTFIELDS, body)
+        curl.setopt(pycurl.POSTFIELDSIZE, len(body))
+        curl.setopt(
+            pycurl.HTTPHEADER,
+            [f"{key}: {value}" for key, value in headers.items()],
+        )
+        curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+        curl.perform()
+        return CurlResponse(
+            status_code=int(curl.getinfo(pycurl.RESPONSE_CODE)),
+            body=response_body.getvalue(),
+        )
+    finally:
+        curl.close()
+
+
+@dataclass
+class StreamEvent:
+    data: str
+
+
+class SSEStream:
+    def __init__(self, body: bytes) -> None:
+        self._body = body
+
+    def events(self) -> Iterator[StreamEvent]:
+        data_lines: list[str] = []
+        for raw_line in self._body.decode("utf-8", errors="replace").splitlines():
+            line = raw_line.rstrip("\r")
+            if not line:
+                if data_lines:
+                    yield StreamEvent(data="\n".join(data_lines))
+                    data_lines = []
+                continue
+            if line.startswith("data:"):
+                data_lines.append(line[5:].lstrip())
+        if data_lines:
+            yield StreamEvent(data="\n".join(data_lines))
+
+
+class LineStream:
+    def __init__(self, body: bytes) -> None:
+        self._body = body
+
+    def __iter__(self) -> Iterator[bytes]:
+        for line in self._body.splitlines():
+            line = line.strip()
+            if line:
+                yield line
