+def _proxy_for_url(proxies, url):
+    if not proxies:
+        return None
+
+    if isinstance(proxies, dict):
+        if url.startswith('https://'):
+            return proxies.get('https') or proxies.get('all')
+        if url.startswith('http://'):
+            return proxies.get('http') or proxies.get('all')
+
+    return proxies
+
+
+class _Response(object):
+    def __init__(self, status_code, headers, reason, text):
+        self.status_code = status_code
+        self.headers = headers
+        self.reason = reason
+        self.text = text
+
+    def json(self):
+        return json.loads(self.text)
+
+
+async def _request_post(url, data, headers, timeout, proxies):
+    client_timeout = aiohttp.ClientTimeout(total=timeout)
+    proxy = _proxy_for_url(proxies, url)
+
+    async with aiohttp.ClientSession(timeout=client_timeout) as session:
+        async with session.post(url, data=data, headers=headers, proxy=proxy) as res:
+            text = await res.text()
+            return _Response(res.status, dict(res.headers), res.reason, text)
 
 
