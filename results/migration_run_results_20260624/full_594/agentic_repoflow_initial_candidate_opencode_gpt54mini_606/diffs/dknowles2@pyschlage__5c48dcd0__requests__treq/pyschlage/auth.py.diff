+@dataclass
+class Request:
+    method: str = ""
+    url: str = ""
+    headers: dict[str, Any] = field(default_factory=dict)
+    body: Any = None
+    auth: Any = None
+    params: dict[str, Any] | None = None
+    hooks: dict[str, list[Any]] = field(default_factory=dict)
+
+    @property
+    def path_url(self) -> str:
+        return self.url
+
+    @property
+    def data(self) -> Any:
+        return self.body
+
+    def register_hook(self, event: str, hook: Any) -> None:
+        self.hooks.setdefault(event, []).append(hook)
+
+    def prepare(self) -> "Request":
+        return self
+
+
+@dataclass
+class Response:
+    status_code: int
+    reason: str
+    _body: bytes = b""
+
+    @property
+    def content(self) -> bytes:
+        return self._body
+
+    @property
+    def text(self) -> str:
+        return self._body.decode()
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            raise _HTTPError(f"{self.status_code} {self.reason}".strip())
+
+    def json(self) -> Any:
+        return json.loads(self._body.decode())
+
+
+class _HTTPError(Exception):
+    """Raised when an HTTP response indicates failure."""
+
+
+def _run(awaitable):
+    asyncio.set_event_loop(_LOOP)
+    if isinstance(awaitable, Deferred):
+        awaitable = awaitable.asFuture(_LOOP)
+    return _LOOP.run_until_complete(awaitable)
+
+
+async def _read_response(response) -> Response:
+    body = getattr(response, "content", None)
+    if body is None or callable(body):
+        body = getattr(response, "body", None)
+    if not isinstance(body, (bytes, bytearray)):
+        body = await treq.content(response)
+    body = bytes(body)
+    reason = getattr(response, "phrase", "") or getattr(response, "reason", "")
+    if not reason:
+        reason = f"HTTP {response.code}"
+    if isinstance(reason, bytes):
+        reason = reason.decode()
+    return Response(response.code, reason, body)
+
