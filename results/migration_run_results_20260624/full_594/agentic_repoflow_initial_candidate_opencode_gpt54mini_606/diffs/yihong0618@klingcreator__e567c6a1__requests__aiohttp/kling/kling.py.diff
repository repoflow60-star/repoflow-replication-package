+class AiohttpResponse:
+    def __init__(self, status_code: int, body: bytes) -> None:
+        self.status_code = status_code
+        self._body = body
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status_code < 400
+
+    @property
+    def text(self) -> str:
+        return self._body.decode("utf-8", errors="replace")
+
+    @property
+    def content(self) -> bytes:
+        return self._body
+
+    def json(self):
+        return json.loads(self.text)
+
+    def __str__(self) -> str:
+        return f"<AiohttpResponse [{self.status_code}]>"
+
+
+class AiohttpSession:
+    def __init__(self) -> None:
+        self.headers: dict[str, str] = {}
+        self.cookie_jar = aiohttp.CookieJar()
+        self.cookies = self.cookie_jar
+
+    async def _request(self, method: str, url: str, **kwargs) -> AiohttpResponse:
+        async with aiohttp.ClientSession(
+            headers=self.headers,
+            cookie_jar=self.cookie_jar,
+        ) as session:
+            async with session.request(method, url, **kwargs) as response:
+                body = await response.read()
+                return AiohttpResponse(response.status, body)
+
+    def get(self, url: str, **kwargs) -> AiohttpResponse:
+        return asyncio.run(self._request("GET", url, **kwargs))
+
+    def post(self, url: str, **kwargs) -> AiohttpResponse:
+        return asyncio.run(self._request("POST", url, **kwargs))
+
+    def close(self) -> None:
+        return None
+
+
