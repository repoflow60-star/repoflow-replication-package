+def _hex_to_rgb(color: str):
+    color = color.lstrip("#")
+    if len(color) == 3:
+        color = "".join(channel * 2 for channel in color)
+    if len(color) != 6:
+        raise ValueError(f"Invalid hex color {color}")
+
+    return array(
+        [int(color[i : i + 2], 16) / 255.0 for i in (0, 2, 4)],
+        dtype=float32,
+        order="C",
+    )
+
+
+def _rgb_to_hex(color):
+    color = np.rint(clip(color, 0.0, 1.0) * 255).astype(np.uint8)
+    return f"#{int(color[0]):02x}{int(color[1]):02x}{int(color[2]):02x}"
+
+
+def _to_rgb(color):
+    if type(color) is str:
+        return _hex_to_rgb(color)
+
+    if hasattr(color, "__len__") and (len(color) == 3 or len(color) == 4):
+        rgb = asarray(color, dtype=float32)
+        if any(isinstance(channel, (int, integer)) for channel in color) or max(color) > 1.0:
+            rgb = rgb / 255.0
+
+        return rgb[:3]
+
+    raise ValueError(f"Invalid color specification {color}")
+
+
+def _named_palette_to_srgb1(palette: str, max_colors: int):
+    scheme_name = palette.lower()
+    if scheme_name not in _NAMED_PALETTES:
+        raise ValueError(f"Unrecognized palette name {palette}")
+
+    # Use Altair to keep named palette resolution aligned with the target library.
+    alt.Scale(scheme=_ALTAIR_SCHEME_ALIASES.get(scheme_name, scheme_name)).to_dict()
+
+    colors = _NAMED_PALETTES[scheme_name]
+    if len(colors) <= max_colors:
+        chosen = colors
+    else:
+        indices = np.linspace(0, len(colors) - 1, max_colors).astype(int)
+        chosen = [colors[i] for i in indices]
+
+    return array([_hex_to_rgb(color) for color in chosen], dtype=float32, order="C")
 
 
