     @staticmethod
+    def render_mako_template(source: str, context: dict):
+        return VisioFile._render_template_block(source, context)
+
+    @staticmethod
+    def _render_template_block(source: str, context: dict):
+        token_re = re.compile(r'(\{\{.*?\}\}|\{%\s*(?:for|if|endfor|endif)\b.*?%\})', re.DOTALL)
+        output = []
+        position = 0
+
+        while True:
+            match = token_re.search(source, position)
+            if not match:
+                output.append(source[position:])
+                break
+
+            output.append(source[position:match.start()])
+            token = match.group(0)
+
+            if token.startswith('{{'):
+                expression = token[2:-2].strip()
+                output.append(VisioFile._render_template_expression(expression, context))
+                position = match.end()
+                continue
+
+            inner = token[2:-2].strip()
+            if inner.startswith('if '):
+                block, new_position = VisioFile._extract_template_block(source, match.end(), 'if')
+                if VisioFile._evaluate_template_expression(inner[3:].strip(), context):
+                    output.append(VisioFile._render_template_block(block, context))
+                position = new_position
+                continue
+
+            if inner.startswith('for '):
+                block, new_position = VisioFile._extract_template_block(source, match.end(), 'for')
+                target, iterable_expression = inner[4:].strip().split(' in ', 1)
+                iterable = VisioFile._evaluate_template_expression(iterable_expression.strip(), context)
+                for item in iterable:
+                    loop_context = dict(context)
+                    loop_context[target.strip()] = item
+                    output.append(VisioFile._render_template_block(block, loop_context))
+                position = new_position
+                continue
+
+            raise ValueError(f'Unexpected template end tag: {inner}')
+
+        return ''.join(output)
+
+    @staticmethod
+    def _extract_template_block(source: str, start: int, block_type: str):
+        token_re = re.compile(r'(\{\{.*?\}\}|\{%\s*(?:for|if|endfor|endif)\b.*?%\})', re.DOTALL)
+        nesting = [block_type]
+        position = start
+
+        while True:
+            match = token_re.search(source, position)
+            if not match:
+                raise ValueError(f'Unclosed template block: {block_type}')
+
+            token = match.group(0)
+            if token.startswith('{{'):
+                position = match.end()
+                continue
+
+            inner = token[2:-2].strip()
+            if inner.startswith('if '):
+                nesting.append('if')
+            elif inner.startswith('for '):
+                nesting.append('for')
+            elif inner == 'endif':
+                if nesting[-1] != 'if':
+                    raise ValueError('Mismatched endif in template block')
+                nesting.pop()
+                if not nesting:
+                    return source[start:match.start()], match.end()
+            elif inner == 'endfor':
+                if nesting[-1] != 'for':
+                    raise ValueError('Mismatched endfor in template block')
+                nesting.pop()
+                if not nesting:
+                    return source[start:match.start()], match.end()
+
+            position = match.end()
+
+    @staticmethod
+    def _render_template_expression(expression: str, context: dict):
+        template = Template('${' + expression + '}')
+        return template.render(**context)
+
+    @staticmethod
+    def _evaluate_template_expression(expression: str, context: dict):
+        return eval(expression, {}, dict(context))
