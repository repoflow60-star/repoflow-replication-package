+        if len(options) == 2 and any(option.get("type") == "null" for option in options):
+            non_null = next(option for option in options if option.get("type") != "null")
+            translated = _translate_schema(non_null, defs)
+            translated["nullable"] = True
+            if "default" in schema:
+                translated["default"] = schema["default"]
+            return translated
+
+        rule = {"oneof": [_translate_schema(option, defs) for option in options]}
+        if "default" in schema:
+            rule["default"] = schema["default"]
+        return rule
+
+    if "anyOf" in schema:
+        rule = {"anyof": [_translate_schema(option, defs) for option in schema["anyOf"]]}
+        if "default" in schema:
+            rule["default"] = schema["default"]
+        return rule
+
+    rule = {}
