+def _proxy_manager(proxies):
+    if not proxies:
+        return _pool
+
+    if isinstance(proxies, dict):
+        proxy_url = proxies.get('https') or proxies.get('http')
+        if not proxy_url:
+            proxy_url = next(iter(proxies.values()), None)
+    else:
+        proxy_url = proxies
+
+    if not proxy_url:
+        return _pool
+
+    if '://' not in proxy_url:
+        proxy_url = 'http://' + proxy_url
+
+    return urllib3.ProxyManager(proxy_url)
+
+
+class HTTPResponseWrapper(object):
+    def __init__(self, response):
+        self._response = response
+        self.status_code = response.status
+        self.reason = response.reason
+        self.headers = response.headers
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
+    @property
+    def content(self):
+        return self._response.data
+
+    @property
+    def ok(self):
+        return 200 <= self.status_code < 400
+
+    @property
+    def text(self):
+        return self._response.data.decode('utf-8', errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+
+def _request(method, url, data=None, headers=None, timeout=None, proxies=None):
+    manager = _proxy_manager(proxies)
+    response = manager.request(
+        method,
+        url,
+        body=data,
+        headers=headers,
+        timeout=timeout,
+        retries=False,
+    )
+    return HTTPResponseWrapper(response)
 
 
