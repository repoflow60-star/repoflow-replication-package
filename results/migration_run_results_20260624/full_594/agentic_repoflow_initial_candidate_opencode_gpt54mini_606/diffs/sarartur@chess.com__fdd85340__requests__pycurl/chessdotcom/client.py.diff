+    @staticmethod
+    def _parse_curl_headers(raw_headers: bytes):
+        header_text = raw_headers.decode("iso-8859-1")
+        blocks = [block for block in header_text.split("\r\n\r\n") if block.strip()]
+
+        if not blocks:
+            return {}
+
+        headers = {}
+        for line in blocks[-1].split("\r\n")[1:]:
+            if ":" in line:
+                key, value = line.split(":", 1)
+                headers[key.strip()] = value.strip()
+        return headers
