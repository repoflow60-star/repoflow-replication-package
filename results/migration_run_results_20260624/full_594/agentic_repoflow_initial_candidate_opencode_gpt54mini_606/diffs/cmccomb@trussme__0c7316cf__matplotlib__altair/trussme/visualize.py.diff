+ColorSpec = Any
+"""Type: Color specification alias used for plotting."""
+
+_MATPLOTLIB_SHORT_COLORS = {
+    "b": "blue",
+    "g": "green",
+    "r": "red",
+    "c": "cyan",
+    "m": "magenta",
+    "y": "yellow",
+    "k": "black",
+    "w": "white",
+}
+
+
+def _resolve_color(color: ColorSpec) -> str:
+    if isinstance(color, str):
+        return _MATPLOTLIB_SHORT_COLORS.get(color, color)
+    return str(color)
+
+
+def _member_color(member, shape, fos_threshold: float, scaler: float):
+    if shape == "fos":
+        return (
+            "green"
+            if numpy.min([member.fos_buckling, member.fos_yielding]) > fos_threshold
+            else "red"
+        )
+    if shape == "force":
+        if scaler == 0:
+            return 0.5
+        return member.force / (2 * scaler) + 0.5
+    return _resolve_color(shape)
+
+
+def _layer_records(truss, shape, exaggeration_factor: float, fos_threshold: float):
+    if shape is None:
+        return []
+
+    scaler: float = (
+        numpy.max(numpy.abs([member.force for member in truss.members]))
+        if truss.members
+        else 0.0
+    )
+
+    records = []
+    for member in truss.members:
+        color = _member_color(member, shape, fos_threshold, scaler)
+        records.append(
+            {
+                "x": member.begin_joint.coordinates[0],
+                "y": member.begin_joint.coordinates[1],
+                "x2": member.end_joint.coordinates[0],
+                "y2": member.end_joint.coordinates[1],
+                "color": color,
+            }
+        )
+
+    return records
+
+
+def _deflected_layer_records(truss, shape, exaggeration_factor: float, fos_threshold: float):
+    if shape is None:
+        return []
+
+    scaler: float = (
+        numpy.max(numpy.abs([member.force for member in truss.members]))
+        if truss.members
+        else 0.0
+    )
+
+    records = []
+    for member in truss.members:
+        color = _member_color(member, shape, fos_threshold, scaler)
+        records.append(
+            {
+                "x": member.begin_joint.coordinates[0]
+                + exaggeration_factor * member.begin_joint.deflections[0],
+                "y": member.begin_joint.coordinates[1]
+                + exaggeration_factor * member.begin_joint.deflections[1],
+                "x2": member.end_joint.coordinates[0]
+                + exaggeration_factor * member.end_joint.deflections[0],
+                "y2": member.end_joint.coordinates[1]
+                + exaggeration_factor * member.end_joint.deflections[1],
+                "color": color,
+            }
+        )
+
+    return records
+
+
+def _xy_domain(*layers):
+    points = []
+    for layer in layers:
+        for row in layer:
+            points.extend([row["x"], row["y"], row["x2"], row["y2"]])
+
+    if not points:
+        return (-1.0, 1.0)
+
+    min_value = min(points)
+    max_value = max(points)
+    if min_value == max_value:
+        padding = 1.0
+    else:
+        padding = (max_value - min_value) * 0.05
+    return (min_value - padding, max_value + padding)
+
+
+def _layer_chart(records, domain):
+    if not records:
+        return None
+
+    if all(isinstance(row["color"], (int, float)) for row in records):
+        return altair.Chart(records).mark_rule().encode(
