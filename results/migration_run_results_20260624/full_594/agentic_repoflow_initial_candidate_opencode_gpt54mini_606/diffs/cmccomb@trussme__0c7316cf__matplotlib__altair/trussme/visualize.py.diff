+            axis=None,
+            scale=altair.Scale(domain=domain, nice=False, zero=False),
+        ),
+        y2="y2:Q",
+        color=altair.Color("color:N", scale=None, legend=None),
+    )
+
+
+def _svg_escape(value: str) -> str:
+    return (
+        value.replace("&", "&amp;")
+        .replace("<", "&lt;")
+        .replace(">", "&gt;")
+        .replace('"', "&quot;")
+    )
+
+
+def _render_svg(starting_records, deflected_records, domain, size: int = 480) -> str:
+    min_value, max_value = domain
+    span = max_value - min_value
+    if span == 0:
+        span = 1.0
+
+    def project(x: float, y: float) -> tuple[float, float]:
+        px = (x - min_value) / span * size
+        py = size - (y - min_value) / span * size
+        return px, py
+
+    lines = []
+    for records in (starting_records, deflected_records):
+        for row in records:
+            x1, y1 = project(row["x"], row["y"])
+            x2, y2 = project(row["x2"], row["y2"])
+            color = _svg_escape(str(row["color"]))
+            lines.append(
+                f'<line x1="{x1:.3f}" y1="{y1:.3f}" x2="{x2:.3f}" y2="{y2:.3f}" '
+                f'stroke="{color}" stroke-width="2" stroke-linecap="round" />'
+            )
+
+    return (
+        f'<svg xmlns="http://www.w3.org/2000/svg" width="{size}" height="{size}" '
+        f'viewBox="0 0 {size} {size}">'
+        + '<rect width="100%" height="100%" fill="white" />'
+        + "<g>"
+        + "".join(lines)
+        + "</g></svg>"
+    )
+
+
+def truss_to_svg(
