+    def _execute_request(self, method: str, url: str, params: Dict[str, Union[str, List[str]]], headers: Dict[str, str], json: Dict[str, Any]) -> _PycurlResponse:
+        response_body = io.BytesIO()
+        response_headers: Dict[str, str] = {}
+        status_code = 0
+
+        def capture_headers(line: bytes):
+            nonlocal response_headers, status_code
+            decoded_line = line.decode("iso-8859-1").strip()
+            if not decoded_line:
+                return
+            if decoded_line.startswith("HTTP/"):
+                response_headers = {}
+                parts = decoded_line.split(" ", 2)
+                if len(parts) > 1:
+                    try:
+                        status_code = int(parts[1])
+                    except ValueError:
+                        pass
+                return
+            if ":" in decoded_line:
+                header_name, header_value = decoded_line.split(":", 1)
+                response_headers[header_name.strip().lower()] = header_value.strip()
+
+        curl = pycurl.Curl()
+        try:
+            full_url = url
+            if params:
+                full_url = full_url + ("&" if "?" in full_url else "?") + urlencode(params, doseq=True)
+            curl.setopt(pycurl.URL, full_url)
+            curl.setopt(pycurl.WRITEDATA, response_body)
+            curl.setopt(pycurl.HEADERFUNCTION, capture_headers)
+            curl.setopt(pycurl.HTTPHEADER, [f"{name}: {value}" for name, value in headers.items()])
+            if json is not None:
+                request_body = json_module.dumps(json).encode("utf-8")
+                curl.setopt(pycurl.POSTFIELDS, request_body)
+                curl.setopt(pycurl.POSTFIELDSIZE, len(request_body))
+            if method != "GET":
+                curl.setopt(pycurl.CUSTOMREQUEST, method)
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            return _PycurlResponse(status_code, response_headers, response_body.getvalue())
+        finally:
+            curl.close()
 
