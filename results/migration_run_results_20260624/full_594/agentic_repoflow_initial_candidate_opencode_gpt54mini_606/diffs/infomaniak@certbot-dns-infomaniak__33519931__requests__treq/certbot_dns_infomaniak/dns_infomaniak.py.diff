+    def _request_in_reactor(self, method, url, kwargs):
+        request = getattr(treq, method)
+        response = request(url, **kwargs)
+        response.addCallback(treq.content)
+        response.addCallback(self._parse_json)
+        response.addCallback(self._handle_result)
+        return response
+
