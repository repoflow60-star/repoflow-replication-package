+def _toml_format_value(value: Any) -> str:
+    if isinstance(value, str):
+        return json.dumps(value, ensure_ascii=False)
+    elif isinstance(value, bool):
+        return 'true' if value else 'false'
+    elif isinstance(value, (int, float)):
+        return str(value)
+    elif isinstance(value, list):
+        return '[' + ', '.join(_toml_format_value(item) for item in value) + ']'
+    else:
+        return str(value)
+
+
+def _toml_dump_table(py_obj: dict, path: Optional[List[str]] = None,
+                     *, is_array_item: bool = False) -> List[str]:
+    header = None
+    if path:
+        header = ('[[' if is_array_item else '[') + '.'.join(path) + (']]' if is_array_item else ']')
+
+    scalar_lines: List[str] = []
+    nested_blocks: List[List[str]] = []
+
+    for key, value in py_obj.items():
+        if isinstance(value, dict):
+            nested_blocks.append(_toml_dump_table(value, (path or []) + [key]))
+        elif isinstance(value, list) and value and all(isinstance(item, dict) for item in value):
+            for item in value:
+                nested_blocks.append(_toml_dump_table(item, (path or []) + [key],
+                                                      is_array_item=True))
+        else:
+            scalar_lines.append(f'{key} = {_toml_format_value(value)}')
+
+    lines: List[str] = []
+    if header is not None:
+        lines.append(header)
+    lines.extend(scalar_lines)
+
+    for block in nested_blocks:
+        if lines and block:
+            lines.append('')
+        lines.extend(block)
+
+    return lines
+
+
+def _toml_dumps(py_obj: dict) -> str:
+    return '\n'.join(_toml_dump_table(py_obj))
+
