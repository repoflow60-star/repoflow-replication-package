--- a/src/coguard_cli/pycurl_client.py
+++ b/src/coguard_cli/pycurl_client.py
@@ -0,0 +1,104 @@
+"""Small pycurl-based HTTP helpers used by the CLI."""
+
+from __future__ import annotations
+
+import io
+import json
+import re
+import urllib.parse
+from dataclasses import dataclass
+from typing import Dict, Optional, Union
+
+import pycurl
+
+
+@dataclass
+class PycurlResponse:
+    status_code: int
+    reason: str
+    content: bytes
+
+    @property
+    def text(self) -> str:
+        return self.content.decode("utf-8", errors="replace")
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise RuntimeError(f"{self.status_code} {self.reason}".strip())
+
+
+def _reason_from_headers(header_blob: bytes) -> str:
+    status_line = ""
+    for line in header_blob.decode("iso-8859-1", errors="replace").splitlines():
+        if line.startswith("HTTP/"):
+            status_line = line
+    match = re.match(r"HTTP/\S+\s+\d+\s+(.*)$", status_line)
+    return match.group(1).strip() if match else ""
+
+
+def _has_header(headers, header_name: str) -> bool:
+    prefix = f"{header_name.lower()}:"
+    return any(header.lower().startswith(prefix) for header in headers)
+
+
+def request(
+        method: str,
+        url: str,
+        headers: Optional[Dict[str, str]] = None,
+        timeout: Optional[int] = None,
+        data: Optional[Union[bytes, str, Dict[str, str]]] = None,
+        json_body: Optional[Dict[str, object]] = None
+) -> PycurlResponse:
+    body_buffer = io.BytesIO()
+    header_buffer = io.BytesIO()
+    payload = None
+    effective_headers = [] if headers is None else [f"{key}: {value}" for key, value in headers.items()]
+
+    if json_body is not None:
+        payload = json.dumps(json_body).encode("utf-8")
+        if not _has_header(effective_headers, "Content-Type"):
+            effective_headers.append("Content-Type: application/json")
+    elif isinstance(data, dict):
+        payload = urllib.parse.urlencode(data).encode("utf-8")
+        if not _has_header(effective_headers, "Content-Type"):
+            effective_headers.append("Content-Type: application/x-www-form-urlencoded")
+    elif isinstance(data, str):
+        payload = data.encode("utf-8")
+    elif isinstance(data, bytes):
+        payload = data
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEFUNCTION, body_buffer.write)
+        curl.setopt(pycurl.HEADERFUNCTION, header_buffer.write)
+        curl.setopt(pycurl.FOLLOWLOCATION, 0)
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT, int(timeout))
+        if effective_headers:
+            curl.setopt(pycurl.HTTPHEADER, effective_headers)
+
+        method_upper = method.upper()
+        if method_upper == "GET":
+            curl.setopt(pycurl.HTTPGET, 1)
+        elif method_upper == "POST":
+            curl.setopt(pycurl.POST, 1)
+        else:
+            curl.setopt(pycurl.CUSTOMREQUEST, method_upper)
+
+        if payload is not None:
+            curl.setopt(pycurl.POSTFIELDS, payload)
+            curl.setopt(pycurl.POSTFIELDSIZE, len(payload))
+
+        curl.perform()
+        status_code = int(curl.getinfo(pycurl.RESPONSE_CODE))
+        return PycurlResponse(
+            status_code=status_code,
+            reason=_reason_from_headers(header_buffer.getvalue()),
+            content=body_buffer.getvalue(),
+        )
+    finally:
+        curl.close()
