+def _response_error(resp: aiohttp.ClientResponse) -> aiohttp.ClientResponseError:
+    return aiohttp.ClientResponseError(
+        resp.request_info,
+        resp.history,
+        status=resp.status,
+        message=resp.reason,
+        headers=resp.headers,
+    )
+
+
+async def _read_error_payload(
+    resp: aiohttp.ClientResponse,
+) -> ty.Tuple[bytes, ty.Optional[ty.Any]]:
+    content = await resp.read()
+    if not content:
+        return content, None
+
+    if resp.status == 404 or resp.status in range(500, 512):
+        return content, None
+
+    return content, await resp.json(content_type=None)
+
+
+def _handle_error(
+    operation: str,
+    exc: aiohttp.ClientResponseError,
+    status_code: int,
+    content: bytes,
+    payload: ty.Optional[ty.Any] = None,
+) -> None:
+    if content:
+        # server errors should always be reported
+        if status_code in range(500, 512):  # 5xx Server Error
+            LOG.error(
+                'Server error. Please report this issue to '
+                'https://github.com/getpatchwork/patchwork'
+            )
+            raise exc
+
+        # we make the assumption that all responses will be JSON encoded
+        if status_code == 404:
+            LOG.error('Resource not found')
+        else:
+            LOG.error(payload)
+    else:
+        LOG.error(
+            'Failed to %s resource. Is your configuration '
+            'correct?' % operation
+        )
+        LOG.error("Use the '--debug' flag for more information")
+
+    if CONF.debug:
+        raise exc
+    else:
+        sys.exit(1)
+
+
