+async def _oauth2_email(provider_data, code, redirect_uri):
+    async with aiohttp.ClientSession() as session:
+        async with session.post(provider_data['access_token_url'], data={
+            'client_id': provider_data['client_id'],
+            'client_secret': provider_data['client_secret'],
+            'code': code,
+            'grant_type': 'authorization_code',
+            'redirect_uri': redirect_uri,
+        }, headers={'Accept': 'application/json'}) as response:
+            if response.status != 200:
+                return None
+            oauth2_token = (await response.json()).get('access_token')
+            if not oauth2_token:
+                return None
+
+        async with session.get(provider_data['get_user']['url'], headers={
+            'Authorization': 'Bearer ' + oauth2_token,
+            'Accept': 'application/json',
+        }) as response:
+            if response.status != 200:
+                return None
+            data = await response.json()
+
+    return provider_data['get_user']['email'](data)
 
 
