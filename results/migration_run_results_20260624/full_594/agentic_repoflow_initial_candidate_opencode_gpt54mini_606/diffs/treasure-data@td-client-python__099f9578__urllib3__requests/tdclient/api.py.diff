+class _ResponseAdapter:
+    def __init__(self, response):
+        self._response = response
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        self.close()
+
+    @property
+    def status(self):
+        return self._response.status_code
+
+    @property
+    def data(self):
+        return self._response.content
+
+    def read(self, amt=None, decode_content=None):
+        if amt is None:
+            return self._response.raw.read(decode_content=True)
+        return self._response.raw.read(amt, decode_content=True)
+
+    def stream(self, chunk_size=65536, decode_content=None):
+        return self._response.iter_content(chunk_size)
+
+    def getheaders(self):
+        return list(self._response.headers.items())
+
+    def close(self):
+        self._response.close()
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
