+import progressbar
 from tensorboard.backend.event_processing.event_accumulator import EventAccumulator, SCALARS
-from tqdm.auto import tqdm
+
+
+class _ProgressWrapper:
+    def __init__(self, iterable):
+        self._iterable = iter(iterable)
+        self._count = 0
+        self._description = ''
+        total = len(iterable) if hasattr(iterable, '__len__') else progressbar.UnknownLength
+        if total == progressbar.UnknownLength:
+            widgets = [progressbar.FormatLabel('%(description)s'), ' ', progressbar.AnimatedMarker()]
+        else:
+            widgets = [progressbar.FormatLabel('%(description)s'), ' ', progressbar.Bar(), ' ', progressbar.Percentage()]
+        self._bar = progressbar.ProgressBar(max_value=total, widgets=widgets).start()
+        self._bar.update(0, description=self._description)
+
+    def __iter__(self):
+        return self
+
+    def __next__(self):
+        try:
+            item = next(self._iterable)
+        except StopIteration:
+            self._bar.finish()
+            raise
+
+        self._count += 1
+        self._bar.update(self._count, description=self._description)
+        return item
+
+    def set_description(self, description):
+        self._description = description
+        self._bar.update(self._count, description=description)
 
 
