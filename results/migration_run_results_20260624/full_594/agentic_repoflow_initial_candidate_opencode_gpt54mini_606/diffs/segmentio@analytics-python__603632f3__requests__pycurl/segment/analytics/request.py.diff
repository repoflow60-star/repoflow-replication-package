+def _request(url, data, headers, timeout, proxies=None):
+    body = BytesIO()
+    raw_headers = []
+
+    if isinstance(data, (bytes, bytearray)):
+        payload = bytes(data)
+    else:
+        payload = data.encode('utf-8')
+
+    def capture_headers(line):
+        raw_headers.append(line)
+        return len(line)
+
+    def capture_body(chunk):
+        return body.write(chunk)
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.POST, 1)
+        curl.setopt(pycurl.POSTFIELDS, payload)
+        curl.setopt(pycurl.POSTFIELDSIZE, len(payload))
+        curl.setopt(pycurl.WRITEFUNCTION, capture_body)
+        curl.setopt(pycurl.HEADERFUNCTION, capture_headers)
+        if timeout is not None:
+            timeout_ms = int(timeout * 1000)
+            curl.setopt(pycurl.TIMEOUT_MS, timeout_ms)
+            curl.setopt(pycurl.CONNECTTIMEOUT_MS, timeout_ms)
+        curl.setopt(pycurl.NOSIGNAL, 1)
+        curl.setopt(pycurl.HTTPHEADER, [f'{key}: {value}' for key, value in headers.items()])
+
+        proxy = _normalize_proxy(proxies, url)
+        if proxy:
+            curl.setopt(pycurl.PROXY, proxy)
+
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        return _Response(status_code, raw_headers, body.getvalue())
+    finally:
+        curl.close()
+
+
+def _normalize_proxy(proxies, url):
+    if not proxies:
+        return None
+
+    if isinstance(proxies, dict):
+        scheme = urlsplit(url).scheme
+        proxy = proxies.get(scheme) or proxies.get('https') or proxies.get('http')
+    else:
+        proxy = proxies
+
+    if not proxy:
+        return None
+
+    parsed = urlsplit(proxy)
+    if parsed.scheme:
+        return parsed.netloc or parsed.path
+
+    return proxy
+
+
+class _Response(object):
+
+    def __init__(self, status_code, raw_headers, body):
+        self.status_code = status_code
+        self.headers, self.reason = _parse_headers(raw_headers)
+        self._body = body
+
+    @property
+    def text(self):
+        return self._body.decode('utf-8', 'replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+
+def _parse_headers(raw_headers):
+    headers = {}
+    reason = ''
+    for line in raw_headers:
+        if isinstance(line, bytes):
+            line = line.decode('iso-8859-1', 'replace')
+        line = line.strip('\r\n')
+        if not line:
+            continue
+        if line.startswith('HTTP/'):
+            parts = line.split(' ', 2)
+            if len(parts) > 2:
+                reason = parts[2]
+            headers = {}
+            continue
+        if ':' in line:
+            key, value = line.split(':', 1)
+            headers[key.strip()] = value.strip()
+    return headers, reason
+
+
 class APIError(Exception):
 
