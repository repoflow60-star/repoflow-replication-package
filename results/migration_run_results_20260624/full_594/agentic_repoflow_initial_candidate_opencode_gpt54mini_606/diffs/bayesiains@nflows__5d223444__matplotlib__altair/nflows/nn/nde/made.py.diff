+    def sample_chart(self, num_samples, context=None):
+        if context is None:
+            raise ValueError("sample_chart requires context.")
+
+        samples = self.sample(num_samples, context=context).detach().cpu()
+        samples = samples.reshape(-1, self.features)
+
+        chart_data = [
+            {
+                "sample": int(sample_index),
+                "feature": int(feature_index),
+                "value": float(value),
+            }
+            for sample_index, row in enumerate(samples)
+            for feature_index, value in enumerate(row)
+        ]
+
+        return alt.Chart(alt.Data(values=chart_data)).mark_circle(size=60).encode(
+            x=alt.X("feature:O", title="Feature"),
+            y=alt.Y("value:Q", title="Value"),
+            color=alt.Color("sample:N", legend=None),
+            tooltip=["sample:N", "feature:N", "value:Q"],
+        )
