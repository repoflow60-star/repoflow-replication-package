+def _get_extension_data(attestation_cert, extension_oid: str) -> bytes:
+    for index in range(attestation_cert.get_extension_count()):
+        extension = attestation_cert.get_extension(index)
+        short_name = extension.get_short_name()
+        if isinstance(short_name, bytes):
+            short_name = short_name.decode("ascii")
+        if short_name == extension_oid:
+            return extension.get_data()
+
+    raise InvalidRegistrationResponse(
+        f"Certificate missing extension {extension_oid} (TPM)"
+    )
 
 
