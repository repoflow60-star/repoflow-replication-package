+    def _run(self, coroutine):
+        try:
+            previous_loop = asyncio.get_event_loop()
+        except RuntimeError:
+            previous_loop = None
+        loop = asyncio.new_event_loop()
+        try:
+            asyncio.set_event_loop(loop)
+            return loop.run_until_complete(coroutine)
+        finally:
+            loop.close()
+            asyncio.set_event_loop(previous_loop)
+
+    async def _request(self, method, url, **kwargs):
+        url = self.baseUrl + url
+        logger.debug("%s %s", method, url)
+        headers = {"Authorization": "Bearer {token}".format(token=self.token)}
+        async with aiohttp.ClientSession(headers=headers) as session:
+            async with session.request(method, url, **kwargs) as req:
+                try:
+                    result = await req.json(content_type=None)
+                except json.decoder.JSONDecodeError as exc:
+                    raise errors.PluginError("no JSON in API response") from exc
+                if result["result"] == "success":
+                    return result["data"]
+                if result["error"]["code"] == "not_authorized":
+                    raise errors.PluginError("cannot authenticate")
+                raise errors.PluginError(
+                    "error in API request: {} / {}".format(
+                        result["error"]["code"], result["error"]["description"]
+                    )
+                )
 
