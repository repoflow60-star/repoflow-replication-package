 from .utility import TokenDict, get_access_token_yaml, validate_access_token
 
 log = logging.getLogger(__name__)  # pylint: disable=C0103
 
 TOKEN_URL = "https://login.questrade.com/oauth2/token?grant_type=refresh_token&refresh_token="
+
+_REACTOR_READY = threading.Event()
+_REACTOR_LOCK = threading.Lock()
+_REACTOR_STARTED = False
+
+
+class _TreqResponse:
+    """Minimal response wrapper for synchronous treq usage."""
+
+    def __init__(self, code: int, payload: Any):
+        self.code = code
+        self._payload = payload
+
+    def raise_for_status(self):
+        if self.code >= 400:
+            raise Exception(f"HTTP error {self.code}")
+
+    def json(self):
+        return self._payload
+
+
+def _start_reactor():
+    reactor.callWhenRunning(_REACTOR_READY.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _raise_http_error(response_code: int, body: bytes):
+    raise Exception(f"HTTP error {response_code}: {body.decode(errors='replace')}")
+
+
+def _ensure_reactor_running():
+    global _REACTOR_STARTED
+
+    if reactor.running:
+        return
+
+    with _REACTOR_LOCK:
+        if not reactor.running and not _REACTOR_STARTED:
+            thread = threading.Thread(
+                target=_start_reactor, name="qtrade-treq-reactor", daemon=True
+            )
+            thread.start()
+            _REACTOR_STARTED = True
+
+    _REACTOR_READY.wait()
+
+
+class _TreqSession:
+    """Blocking treq-backed request helper that preserves the synchronous API."""
+
+    def __init__(self):
+        self.headers: Dict[str, str] = {}
+
+    def _request(self, method: str, url: str, **kwargs) -> _TreqResponse:
+        _ensure_reactor_running()
+
+        def _do_request():
+            request = treq.request(method, url, headers=self.headers, **kwargs)
+            request.addCallback(self._wrap_response)
+            return request
+
+        return threads.blockingCallFromThread(reactor, _do_request)
+
+    @staticmethod
+    def _wrap_response(response) -> _TreqResponse:
+        def _wrap_payload(payload):
+            return _TreqResponse(response.code, payload)
+
+        if response.code >= 400:
+            return treq.content(response).addCallback(
+                lambda body: _raise_http_error(response.code, body)
+            )
+
+        return treq.json_content(response).addCallback(_wrap_payload)
+
+    def request(self, method: str, url: str, **kwargs) -> _TreqResponse:
+        return self._request(method, url, **kwargs)
+
+    def get(self, url: str, **kwargs) -> _TreqResponse:
+        return self._request("get", url, **kwargs)
+
+    def post(self, url: str, **kwargs) -> _TreqResponse:
+        return self._request("post", url, **kwargs)
+
+    def close(self):
+        return None
 
 
