+@defer.inlineCallbacks
+def _perform_treq_request(method, url, **kwargs):
+    start = time.perf_counter()
+    response = yield treq.request(method, url, **kwargs)
+    content = yield treq.content(response)
+    elapsed = timedelta(seconds=time.perf_counter() - start)
+    return Response(
+        status_code=int(getattr(response, 'code', 0) or 0),
+        headers=_normalize_response_headers(getattr(response, 'headers', {})),
+        content=content,
+        request=SimpleNamespace(method=method.upper(), url=url),
+        elapsed=elapsed,
+    )
 
