+def _response_encoding(headers):
+    content_type = headers.get('content-type', '')
+    if 'charset=' in content_type:
+        return content_type.split('charset=', 1)[1].split(';', 1)[0].strip().strip('"')
+    return 'utf-8'
+
+
+def _header_text(value):
+    if isinstance(value, bytes):
+        return value.decode('latin-1')
+    return str(value)
+
+
+def _normalize_response_headers(headers):
+    normalized = {}
+    if hasattr(headers, 'getAllRawHeaders'):
+        raw_headers = headers.getAllRawHeaders() or []
+        for key, values in raw_headers:
+            normalized[_header_text(key).lower()] = ', '.join(
+                _header_text(value) for value in values
+            )
+    elif hasattr(headers, 'items'):
+        for key, value in headers.items():
+            normalized[_header_text(key).lower()] = _header_text(value)
+    return normalized
+
