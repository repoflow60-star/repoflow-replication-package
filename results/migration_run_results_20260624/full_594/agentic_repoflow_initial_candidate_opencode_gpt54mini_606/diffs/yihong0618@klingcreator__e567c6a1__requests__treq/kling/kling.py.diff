+
+def _ensure_reactor_running() -> None:
+    global _reactor_started
+    if _reactor_started or reactor.running:
+        _reactor_started = True
+        return
+
+    with _reactor_lock:
+        if _reactor_started or reactor.running:
+            _reactor_started = True
+            return
+
+        def _run_reactor() -> None:
+            reactor.callWhenRunning(_reactor_ready.set)
+            reactor.run(installSignalHandlers=False)
+
+        threading.Thread(target=_run_reactor, daemon=True).start()
+        _reactor_ready.wait()
+        _reactor_started = True
+
+
+class TreqResponse:
+    def __init__(self, status_code: int, body: bytes) -> None:
+        self.status_code = status_code
+        self.content = body
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status_code < 400
+
+    @property
+    def text(self) -> str:
+        return self.content.decode("utf-8", errors="replace")
+
+    def json(self):
+        return json.loads(self.text)
+
+    def __str__(self) -> str:
+        return f"<TreqResponse [{self.status_code}]>"
+
+
+class TreqSession:
+    def __init__(self) -> None:
+        self.headers = {}
+        self.cookies = None
+
+    @defer.inlineCallbacks
+    def _request_async(self, method: str, url: str, **kwargs):
+        response = yield treq.request(method, url, **kwargs)
+        body = yield treq.content(response)
+        defer.returnValue(TreqResponse(response.code, body))
+
+    def _request(self, method: str, url: str, **kwargs) -> TreqResponse:
+        _ensure_reactor_running()
+        headers = dict(self.headers)
+        extra_headers = kwargs.pop("headers", None)
+        json_body = kwargs.pop("json", None)
+        if extra_headers:
+            headers.update(extra_headers)
+        if json_body is not None:
+            kwargs["data"] = json.dumps(json_body).encode("utf-8")
+            headers.setdefault("Content-Type", "application/json")
+        if headers:
+            kwargs["headers"] = headers
+        if self.cookies is not None:
+            kwargs["cookies"] = self.cookies
+        return threads.blockingCallFromThread(
+            reactor, self._request_async, method, url, **kwargs
+        )
+
+    def get(self, url: str, **kwargs) -> TreqResponse:
+        return self._request("GET", url, **kwargs)
+
+    def post(self, url: str, **kwargs) -> TreqResponse:
+        return self._request("POST", url, **kwargs)
+
