+def _ensure_reactor_running() -> None:
+    # treq needs a running Twisted reactor; keep one alive in a daemon thread.
+    global _reactor_thread
+    if reactor.running:
+        return
+    with _reactor_thread_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is None or not _reactor_thread.is_alive():
+            _reactor_thread = threading.Thread(
+                target=lambda: reactor.run(installSignalHandlers=False),
+                name="twisted-reactor",
+                daemon=True,
+            )
+            _reactor_thread.start()
+    while not reactor.running:
+        time.sleep(0.01)
+
+
+def _treq_get_json(url: str, **kwargs) -> dict:
+    _ensure_reactor_running()
+
+    def _request():
+        return treq.get(url, **kwargs).addCallback(treq.json_content)
+
+    return blockingCallFromThread(reactor, _request)
+
