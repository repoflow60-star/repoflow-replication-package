+class CurlRequest:
+    def __init__(self, url, params=None):
+        self.url = url
+        if params:
+            query = urlencode(params, doseq=True)
+            separator = '&' if '?' in url else '?'
+            self.url = '{}{}{}'.format(url, separator, query)
+        self.headers = {}
+        self.method = 'GET'
+        self.data = None
+        self.body = None
+
+
+class CurlSession:
+    def __init__(self):
+        self.curl = pycurl.Curl()
+
+    def send(self, request, timeout, proxies=None, proxy=None):
+        response_body = BytesIO()
+        response_headers = {}
+
+        def receive_header(header_line):
+            if isinstance(header_line, bytes):
+                header_line = header_line.decode('iso-8859-1')
+            header_line = header_line.rstrip('\r\n')
+            if ':' in header_line:
+                name, value = header_line.split(':', 1)
+                response_headers[name] = value.strip()
+
+        self.curl.reset()
+        self.curl.setopt(pycurl.URL, request.url)
+        self.curl.setopt(
+            pycurl.HTTPHEADER,
+            ['{}: {}'.format(name, value) for name, value in request.headers.items()]
+        )
+        self.curl.setopt(pycurl.NOSIGNAL, 1)
+        self.curl.setopt(pycurl.TIMEOUT, timeout)
+        self.curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+        self.curl.setopt(pycurl.HEADERFUNCTION, receive_header)
+        self.curl.setopt(pycurl.FOLLOWLOCATION, 1)
+
+        if proxies:
+            scheme = 'https' if request.url.lower().startswith('https://') else 'http'
+            proxy_url = proxies.get(scheme)
+            if proxy_url:
+                self.curl.setopt(pycurl.PROXY, proxy_url)
+                if proxy and proxy.username:
+                    credentials = '{}:{}'.format(proxy.username, proxy.password or '')
+                    self.curl.setopt(pycurl.PROXYUSERPWD, credentials)
+
+        if request.method == 'POST':
+            payload = request.data
+            if isinstance(payload, str):
+                payload = payload.encode('utf-8')
+            elif not isinstance(payload, bytes):
+                payload = str(payload).encode('utf-8')
+            self.curl.setopt(pycurl.POST, 1)
+            self.curl.setopt(pycurl.POSTFIELDS, payload)
+            self.curl.setopt(pycurl.POSTFIELDSIZE, len(payload))
+        else:
+            self.curl.setopt(pycurl.HTTPGET, 1)
+
+        self.curl.perform()
+        return build_smarty_response(
+            response_body.getvalue(),
+            self.curl.getinfo(pycurl.RESPONSE_CODE),
+            response_headers,
+        )
+
