+            decoded_line = line.decode('iso-8859-1')
+            if ':' in decoded_line:
+                name, value = decoded_line.split(':', 1)
+                parsed_headers[name.lower()] = value.strip()
+
+        effective_url = self.session.getinfo(pycurl.EFFECTIVE_URL) or url
+        if isinstance(effective_url, bytes):
+            effective_url = effective_url.decode('utf-8')
+        return PycurlResponse(
+            status_code=self.session.getinfo(pycurl.RESPONSE_CODE),
+            headers=parsed_headers,
+            content=response_body.getvalue(),
+            url=effective_url,
+        )
 
