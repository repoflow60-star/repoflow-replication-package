+        headers=None,
+        body: Optional[str] = None,
+    ) -> PycurlResponse:
+        if params:
+            query = urlencode(params, doseq=True)
+            url = f'{url}&{query}' if '?' in url else f'{url}?{query}'
+
+        request_headers = self.headers.copy()
+        if headers:
+            request_headers.update(headers)
+
+        response_body = BytesIO()
+        response_headers = BytesIO()
+        self.session.setopt(pycurl.URL, url)
+        self.session.setopt(
+            pycurl.HTTPHEADER,
+            [f'{name}: {value}' for name, value in request_headers.items()],
+        )
+        self.session.setopt(pycurl.WRITEFUNCTION, response_body.write)
+        self.session.setopt(pycurl.HEADERFUNCTION, response_headers.write)
+        self.session.setopt(pycurl.FOLLOWLOCATION, True)
+        self.session.setopt(pycurl.POSTFIELDS, None)
+        self.session.setopt(pycurl.HTTPGET, method == 'GET')
+        self.session.setopt(pycurl.POST, method in ('POST', 'PATCH'))
+        self.session.setopt(
+            pycurl.CUSTOMREQUEST,
+            method if method not in ('GET', 'POST') else '',
+        )
+        if method in ('POST', 'PATCH'):
+            self.session.setopt(pycurl.POSTFIELDS, body or '')
+        self.session.perform()
+
+        parsed_headers = {}
