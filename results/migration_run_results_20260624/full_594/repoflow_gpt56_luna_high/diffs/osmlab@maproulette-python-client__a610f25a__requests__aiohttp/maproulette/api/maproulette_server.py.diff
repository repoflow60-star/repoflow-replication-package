+    @staticmethod
+    def __run(coroutine):
+        """Run a coroutine while keeping the public API synchronous."""
+        try:
+            running_loop = asyncio.get_event_loop()
+        except RuntimeError:
+            running_loop = None
+
+        if running_loop is None or not running_loop.is_running():
+            loop = asyncio.new_event_loop()
+            try:
+                return loop.run_until_complete(coroutine)
+            finally:
+                loop.close()
+
+        result = []
+        error = []
+
+        def run_in_thread():
+            loop = asyncio.new_event_loop()
+            asyncio.set_event_loop(loop)
+            try:
+                result.append(loop.run_until_complete(coroutine))
+            except BaseException as exception:
+                error.append(exception)
+            finally:
+                loop.close()
+                asyncio.set_event_loop(None)
+
+        thread = threading.Thread(target=run_in_thread)
+        thread.start()
+        thread.join()
+        if error:
+            raise error[0]
+        return result[0]
+
+    def __ssl_context(self):
+        if self.certs is not None:
+            context = ssl.create_default_context()
+            if not self.verify:
+                context.check_hostname = False
+                context.verify_mode = ssl.CERT_NONE
+            if isinstance(self.certs, (tuple, list)):
+                context.load_cert_chain(certfile=self.certs[0], keyfile=self.certs[1])
+            else:
+                context.load_cert_chain(certfile=self.certs)
+            return context
+
+        if self.verify is False:
+            return False
+        if isinstance(self.verify, str):
+            return ssl.create_default_context(cafile=self.verify)
+        return None
+
+    @staticmethod
+    def __multipart_data(body):
+        form = aiohttp.FormData()
+        for field, value in body.items():
+            if isinstance(value, (tuple, list)) and len(value) >= 2:
+                options = {"filename": value[0]}
+                if len(value) >= 3:
+                    options["content_type"] = value[2]
+                if len(value) >= 4:
+                    options["headers"] = value[3]
+                form.add_field(field, value[1], **options)
+            else:
+                form.add_field(field, value)
+        return form
+
+    async def __request_async(self, method, url, params=None, body=None, files=None):
+        headers = {
+            key: value for key, value in (self.headers or {}).items()
+            if value is not None
+        }
+        connector = aiohttp.TCPConnector(ssl=self.__ssl_context())
+        async with aiohttp.ClientSession(headers=headers, connector=connector) as session:
+            request_kwargs = {"params": params}
+            if files is not None:
+                request_kwargs["data"] = self.__multipart_data(files)
+            else:
+                request_kwargs["json"] = body
+            async with session.request(method, url, **request_kwargs) as response:
+                text = await response.text()
+                try:
+                    data = json.loads(text)
+                except (TypeError, ValueError):
+                    data = text
+                return response.status, data, text
+
+    def __request(self, method, url, params=None, body=None, files=None):
+        try:
+            return self.__run(self.__request_async(method, url, params, body, files))
+        except (aiohttp.ClientError, asyncio.TimeoutError) as exception:
+            raise ConnectionUnavailableError(exception) from None
+
+    def __send(self, method, endpoint, params=None, body=None, files=None, error_types=None):
+        status, data, text = self.__request(
+            method,
+            self.url + endpoint,
+            params=params,
+            body=body,
+            files=files
+        )
+        if status >= 400:
+            error_type = (error_types or {}).get(status, HttpError)
+            raise error_type(
+                message=self.parse_response_message(text),
+                status=status
+            ) from None
+        return {
+            "data": data,
+            "status": status
+        }
 
