+class _AiohttpResponse:
+    """Response facade matching the synchronous response used by the API."""
+
+    def __init__(self, response, body):
+        self.status = response.status
+        self.headers = dict(response.headers)
+        self.data = body
+        self._body = io.BytesIO(body)
+
+    def getheaders(self):
+        return self.headers
+
+    def read(self, amt=None):
+        if amt is None:
+            return self._body.read()
+        return self._body.read(amt)
+
+    def stream(self, amt=65536):
+        while True:
+            chunk = self._body.read(amt)
+            if not chunk:
+                return
+            yield chunk
+
+    def close(self):
+        self._body.close()
+
+
+class _AiohttpTransport:
+    def __init__(
+        self,
+        timeout=60,
+        ca_certs=None,
+        cert_reqs=None,
+        proxy=None,
+        proxy_auth=None,
+        **kwargs,
+    ):
+        self.proxy = proxy
+        self.proxy_auth = proxy_auth
+        self.closed = False
+
+        if hasattr(timeout, "total"):
+            timeout = timeout.total
+            if callable(timeout):
+                timeout = timeout()
+        self.timeout = timeout
+
+        if cert_reqs == ssl.CERT_NONE:
+            self.ssl = False
+        elif ca_certs is not None:
+            self.ssl = ssl.create_default_context(cafile=ca_certs)
+        else:
+            self.ssl = None
+
+    def _run(self, coroutine_factory):
+        try:
+            asyncio.get_running_loop()
+        except RuntimeError:
+            return asyncio.run(coroutine_factory())
+
+        result = []
+        error = []
+
+        def run_in_thread():
+            try:
+                result.append(asyncio.run(coroutine_factory()))
+            except BaseException as exception:
+                error.append(exception)
+
+        thread = threading.Thread(target=run_in_thread)
+        thread.start()
+        thread.join()
+        if error:
+            raise error[0]
+        return result[0]
+
+    async def _request(self, method, url, fields, body, headers):
+        timeout = aiohttp.ClientTimeout(total=self.timeout)
+        method = method.upper()
+        query = fields if method in ("GET", "HEAD", "DELETE", "OPTIONS", "TRACE") else None
+        data = body if body is not None else fields
+
+        async with aiohttp.ClientSession(
+            timeout=timeout, trust_env=False
+        ) as session:
+            async with session.request(
+                method,
+                url,
+                params=query,
+                data=data,
+                headers=headers,
+                proxy=self.proxy,
+                proxy_auth=self.proxy_auth,
+                ssl=self.ssl,
+            ) as response:
+                return _AiohttpResponse(response, await response.read())
+
+    def request(self, method, url, fields=None, body=None, headers=None, **kwargs):
+        if isinstance(body, (array, bytearray)):
+            body = bytes(body)
+        return self._run(
+            lambda: self._request(method, url, fields, body, headers)
+        )
+
+    def urlopen(self, method, url, body=None, headers=None, **kwargs):
+        return self.request(method, url, body=body, headers=headers, **kwargs)
+
+    def close(self):
+        self.closed = True
+
