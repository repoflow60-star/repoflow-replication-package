--- a/yarg/_http.py
+++ b/yarg/_http.py
@@ -0,0 +1,41 @@
+# -*- coding: utf-8 -*-
+
+import io
+
+import pycurl
+
+
+class _Response(object):
+    def __init__(self, content, status_code, reason):
+        self.content = content
+        self.status_code = status_code
+        self.reason = reason
+
+
+class _HeaderCollector(object):
+    def __init__(self):
+        self.reason = ''
+
+    def __call__(self, line):
+        text = line.decode('iso-8859-1') if isinstance(line, bytes) else line
+        if text.startswith('HTTP/'):
+            parts = text.rstrip('\r\n').split(' ', 2)
+            self.reason = parts[2] if len(parts) == 3 else ''
+        return len(line)
+
+
+class CurlSession(object):
+    def get(self, url):
+        body = io.BytesIO()
+        headers = _HeaderCollector()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEFUNCTION, body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, headers)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+        return _Response(body.getvalue(), status_code, headers.reason)
