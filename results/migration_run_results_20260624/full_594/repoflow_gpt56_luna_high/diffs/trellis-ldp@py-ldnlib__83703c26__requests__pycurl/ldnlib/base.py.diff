     def __init__(self, **kwargs):
         self.accept_headers = kwargs.get('accept_headers', self.ACCEPT_HEADERS)
 
+    def _request(self, method, url, **kwargs):
+        """Execute an HTTP request through libcurl."""
+        headers = kwargs.pop('headers', {})
+        allow_redirects = kwargs.pop('allow_redirects', True)
+        auth = kwargs.pop('auth', None)
+        params = kwargs.pop('params', None)
+        data = kwargs.pop('data', None)
+        timeout = kwargs.pop('timeout', None)
+        verify = kwargs.pop('verify', True)
+
+        if params:
+            from urllib.parse import urlencode, urlsplit, urlunsplit
+
+            if isinstance(params, bytes):
+                query = params.decode('utf-8')
+            elif isinstance(params, str):
+                query = params
+            else:
+                query = urlencode(params, doseq=True)
+            parts = urlsplit(url)
+            if parts.query:
+                query = '{}&{}'.format(parts.query, query)
+            url = urlunsplit((parts.scheme, parts.netloc, parts.path,
+                              query, parts.fragment))
+
+        body = io.BytesIO()
+        response_headers = {}
+        links = {}
+
+        def receive_headers(raw_header):
+            if isinstance(raw_header, bytes):
+                line = raw_header.decode('iso-8859-1').strip()
+            else:
+                line = raw_header.strip()
+            if line.startswith('HTTP/'):
+                # A redirect or provisional response starts a new response.
+                response_headers.clear()
+                links.clear()
+                body.seek(0)
+                body.truncate()
+            elif ':' in line:
+                name, value = line.split(':', 1)
+                name = name.strip().lower()
+                value = value.strip()
+                if name in response_headers:
+                    response_headers[name] = '{}, {}'.format(
+                        response_headers[name], value)
+                else:
+                    response_headers[name] = value
+                if name == 'link':
+                    for match in re.finditer(r'<([^>]+)>\s*([^,]*)', value):
+                        relation = re.search(
+                            r'(?:^|;)\s*rel\s*=\s*(?:"([^"]+)"|'
+                            r"'([^']+)'|([^;\s]+))",
+                            match.group(2), re.I)
+                        if relation:
+                            rel_value = next(
+                                item for item in relation.groups()
+                                if item is not None)
+                            for rel in rel_value.split():
+                                links[rel] = {'url': match.group(1)}
+            return len(raw_header)
+
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            curl.setopt(pycurl.FOLLOWLOCATION, bool(allow_redirects))
+            curl.setopt(pycurl.WRITEFUNCTION, body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, receive_headers)
+
+            if headers:
+                curl.setopt(
+                    pycurl.HTTPHEADER,
+                    ['{}: {}'.format(name, value)
+                     for name, value in headers.items()])
+
+            if method == 'HEAD':
+                curl.setopt(pycurl.NOBODY, True)
+            elif data is not None:
+                if isinstance(data, str):
+                    data = data.encode('utf-8')
+                elif isinstance(data, bytearray):
+                    data = bytes(data)
+                elif not isinstance(data, bytes):
+                    from urllib.parse import urlencode
+
+                    data = urlencode(data, doseq=True).encode('utf-8')
+                curl.setopt(pycurl.POSTFIELDS, data)
+
+            if auth is not None:
+                if isinstance(auth, (tuple, list)):
+                    auth = '{}:{}'.format(auth[0], auth[1])
+                curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_ANY)
+                curl.setopt(pycurl.USERPWD, auth)
+            if timeout is not None:
+                if isinstance(timeout, (tuple, list)):
+                    curl.setopt(pycurl.CONNECTTIMEOUT, timeout[0])
+                    curl.setopt(pycurl.TIMEOUT, timeout[1])
+                elif isinstance(timeout, float):
+                    curl.setopt(pycurl.TIMEOUT_MS, int(timeout * 1000))
+                else:
+                    curl.setopt(pycurl.TIMEOUT, timeout)
+            if verify is False:
+                curl.setopt(pycurl.SSL_VERIFYPEER, False)
+                curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+            elif isinstance(verify, str):
+                curl.setopt(pycurl.CAINFO, verify)
+
+            curl.perform()
+            return (curl.getinfo(pycurl.RESPONSE_CODE), response_headers,
+                    links, body.getvalue())
+        finally:
+            curl.close()
+
