+def _serialize_pkcs12(key, certificate, passphrase=None):
+    if passphrase:
+        if isinstance(passphrase, str):
+            passphrase = passphrase.encode()
+        encryption = BestAvailableEncryption(passphrase)
+    else:
+        encryption = NoEncryption()
+
+    return pkcs12.serialize_key_and_certificates(
+        name=None,
+        key=key.to_cryptography_key(),
+        cert=certificate.to_cryptography() if certificate is not None else None,
+        cas=None,
+        encryption_algorithm=encryption,
+    )
+
+
+class _PKCS12Certificate:
+    def __init__(self, key, certificate):
+        self.key = key
+        self.certificate = certificate
+
+    def export(self):
+        return _serialize_pkcs12(self.key, self.certificate)
+
+
+class _PKCS12Compat:
+    """Compatibility object for pyOpenSSL versions without crypto.PKCS12."""
+
+    def __init__(self):
+        self.key = None
+        self.certificate = None
+
+    def set_privatekey(self, key):
+        self.key = key
+
+    def set_certificate(self, certificate):
+        self.certificate = certificate
+
+    def export(self, passphrase=None):
+        return _serialize_pkcs12(self.key, self.certificate, passphrase)
+
+
+if not hasattr(OpenSSL.crypto, 'PKCS12'):
+    OpenSSL.crypto.PKCS12 = _PKCS12Compat
 
 
