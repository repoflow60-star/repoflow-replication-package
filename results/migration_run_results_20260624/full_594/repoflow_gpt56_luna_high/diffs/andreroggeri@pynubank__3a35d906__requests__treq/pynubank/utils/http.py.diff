+_reactor_lock = Lock()
+_reactor_ready = Event()
+_reactor_thread = None
+
+
+def _run_reactor():
+    _reactor_ready.set()
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _reactor_thread
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is None:
+            _reactor_thread = Thread(target=_run_reactor, daemon=True)
+            _reactor_thread.start()
+        _reactor_ready.wait()
+
+
+def _call_in_reactor(function, *args, **kwargs):
+    _ensure_reactor()
+    completed = Event()
+    result = []
+    error = []
+
+    def succeed(value):
+        result.append(value)
+        completed.set()
+        return value
+
+    def fail(failure):
+        error.append(getattr(failure, 'value', failure))
+        completed.set()
+        return failure
+
+    def invoke():
+        try:
+            deferred = function(*args, **kwargs)
+            if isinstance(deferred, Deferred):
+                deferred.addCallbacks(succeed, fail)
+            else:
+                succeed(deferred)
+        except Exception as ex:
+            error.append(ex)
+            completed.set()
+
+    reactor.callFromThread(invoke)
+    completed.wait()
+    if error:
+        raise error[0]
+    return result[0]
 
 
