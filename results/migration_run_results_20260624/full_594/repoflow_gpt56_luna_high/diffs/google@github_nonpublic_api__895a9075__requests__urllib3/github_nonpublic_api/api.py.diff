+class _Response:
+    """Small response facade for the response attributes used by this module."""
+
+    def __init__(self, response, url: str, history):
+        self._response = response
+        self.url = url
+        self.history = history
+
+    @property
+    def content(self) -> bytes:
+        return self._response.data
+
+    @property
+    def text(self) -> str:
+        content_type = self._response.headers.get("Content-Type", "")
+        match = re.search(r"charset=([^;\s]+)", content_type, re.IGNORECASE)
+        encoding = match.group(1) if match else "utf-8"
+        return self.content.decode(encoding, errors="replace")
+
+    @property
+    def status_code(self) -> int:
+        return self._response.status
+
+    @property
+    def headers(self):
+        return self._response.headers
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise urllib3.exceptions.HTTPError(
+                f"HTTP {self.status_code} returned for {self.url}"
+            )
+
+
+class _Urllib3Session:
+    """Cookie-preserving session built on urllib3's connection pool."""
+
+    def __init__(self):
+        self._pool = urllib3.PoolManager()
+        self.cookies = SimpleCookie()
+
+    def _update_cookies(self, response):
+        for header in response.headers.getlist("Set-Cookie"):
+            self.cookies.load(header)
+
+    def _request(self, method: str, url: str, data: Optional[Any] = None):
+        history = []
+        current_method = method.upper()
+        current_url = url
+        body = None
+        if data is not None:
+            body = urlencode(data).encode("utf-8") if isinstance(data, dict) else data
+
+        for _ in range(30):
+            headers = {}
+            if body is not None:
+                headers["Content-Type"] = "application/x-www-form-urlencoded"
+            cookie_header = self.cookies.output(header="", sep=";").strip()
+            if cookie_header:
+                headers["Cookie"] = cookie_header
+
+            response = self._pool.request(
+                current_method,
+                current_url,
+                body=body,
+                headers=headers,
+                redirect=False,
+            )
+            self._update_cookies(response)
+            location = response.headers.get("Location")
+            if response.status not in (301, 302, 303, 307, 308) or not location:
+                return _Response(response, current_url, history)
+
+            history.append(_Response(response, current_url, []))
+            current_url = urljoin(current_url, location)
+            if response.status in (301, 302, 303) and current_method == "POST":
+                current_method = "GET"
+                body = None
+
+        raise urllib3.exceptions.MaxRetryError(
+            self._pool, current_url, reason="too many redirects"
+        )
+
+    def get(self, url: str):
+        return self._request("GET", url)
+
+    def post(self, url: str, data=None):
+        return self._request("POST", url, data=data)
+
+    def close(self):
+        self._pool.clear()
 
 
