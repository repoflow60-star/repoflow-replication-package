+
+    def mask_chart(self):
+        """Returns an Altair heatmap of the layer's autoregressive mask."""
+        mask = self.mask.detach().cpu()
+        values = [
+            {
+                "input": input_index,
+                "output": output_index,
+                "active": mask[output_index, input_index].item(),
+            }
+            for output_index in range(mask.shape[0])
+            for input_index in range(mask.shape[1])
+        ]
+        return (
+            alt.Chart(values)
+            .mark_rect()
+            .encode(
+                x=alt.X("input:O", title="Input feature"),
+                y=alt.Y("output:O", title="Output feature"),
+                color=alt.Color("active:Q", title="Mask"),
+            )
+        )
 
 
