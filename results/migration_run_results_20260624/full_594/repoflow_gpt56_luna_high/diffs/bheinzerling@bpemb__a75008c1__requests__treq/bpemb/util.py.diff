 from pathlib import Path
+from threading import Event, Lock, Thread
 from typing import IO
+
+
+_reactor_lock = Lock()
+_reactor_started = Event()
+_reactor_thread = None
+
+
+class _Headers(dict):
+    def get(self, name, default=None):
+        name = name.lower()
+        for key, value in self.items():
+            if key.lower() == name:
+                return value
+        return default
+
+
+def _decode_header(value):
+    if isinstance(value, bytes):
+        return value.decode("latin1")
+    return value
+
+
+def _response_headers(response):
+    headers = _Headers()
+    for name, values in response.headers.getAllRawHeaders():
+        headers[_decode_header(name)] = ", ".join(
+            _decode_header(value) for value in values)
+    return headers
+
+
+def _start_reactor():
+    global _reactor_thread
+    from twisted.internet import reactor
+
+    with _reactor_lock:
+        if _reactor_thread is None:
+            reactor.callWhenRunning(_reactor_started.set)
+            _reactor_thread = Thread(
+                target=reactor.run,
+                kwargs={"installSignalHandlers": False})
+            _reactor_thread.daemon = True
+            _reactor_thread.start()
+    _reactor_started.wait()
 
 
