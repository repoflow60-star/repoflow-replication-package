--- a/appstoreserverlibrary/_twisted.py
+++ b/appstoreserverlibrary/_twisted.py
@@ -0,0 +1,45 @@
+from threading import Event, Lock, Thread
+from typing import Any
+
+from twisted.internet import reactor
+from twisted.python.failure import Failure
+
+
+_reactor_lock = Lock()
+_reactor_thread = None
+
+
+def _ensure_reactor_running() -> None:
+    global _reactor_thread
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if reactor.running or _reactor_thread is not None:
+            return
+        # Keep one reactor alive because a Twisted reactor cannot be restarted.
+        _reactor_thread = Thread(
+            target=reactor.run,
+            kwargs={"installSignalHandlers": False},
+            daemon=True,
+        )
+        _reactor_thread.start()
+
+
+def wait_for_deferred(deferred: Any) -> Any:
+    result = []
+    completed = Event()
+
+    def store_result(value: Any) -> Any:
+        result.append(value)
+        completed.set()
+        return value
+
+    deferred.addBoth(store_result)
+    if not completed.is_set():
+        _ensure_reactor_running()
+        completed.wait()
+
+    value = result[0]
+    if isinstance(value, Failure):
+        value.raiseException()
+    return value
