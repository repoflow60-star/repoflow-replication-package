+# Synchronous adapter for treq's Deferred-based API.
+_reactor_lock = threading.Lock()
+_reactor_thread = None
+_reactor_ready = threading.Event()
+_reactor_failure = None
+
+
+def _run_reactor():
+    global _reactor_failure
+    try:
+        reactor.callWhenRunning(_reactor_ready.set)
+        reactor.run(installSignalHandlers=False)
+    except BaseException as error:
+        _reactor_failure = error
+        _reactor_ready.set()
+
+
+def _ensure_reactor():
+    """Start the module's private reactor before submitting a request."""
+    global _reactor_thread
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_failure is not None:
+            raise RuntimeError("Unable to start the treq reactor") from _reactor_failure
+        if _reactor_thread is None or not _reactor_thread.is_alive():
+            _reactor_ready.clear()
+            _reactor_thread = threading.Thread(target=_run_reactor, name='hxl-treq-reactor')
+            _reactor_thread.daemon = True
+            _reactor_thread.start()
+    _reactor_ready.wait()
+    if _reactor_failure is not None:
+        raise RuntimeError("Unable to start the treq reactor") from _reactor_failure
+    if not reactor.running:
+        raise RuntimeError("The treq reactor stopped before the request was submitted")
+
+
+def _wait_for_deferred(operation):
+    """Wait for a treq Deferred without changing the public sync API."""
+    _ensure_reactor()
+    if _reactor_thread is not None and threading.current_thread() is _reactor_thread:
+        raise RuntimeError("Synchronous HTTP cannot run on the treq reactor thread")
+    return blockingCallFromThread(reactor, operation)
+
+
+def _http_request(method, url, headers=None, params=None, data=None, timeout=None, verify=True):
+    """Make a treq request and wait until its response headers are available."""
+    kwargs = {'reactor': reactor}
+    if headers is not None:
+        kwargs['headers'] = _treq_headers(headers)
+    if params is not None:
+        kwargs['params'] = params
+    if data is not None:
+        kwargs['data'] = data
+    if timeout is not None:
+        kwargs['timeout'] = timeout
+    if not verify:
+        kwargs['agent'] = Agent(reactor, contextFactory=ClientContextFactory())
+    try:
+        return _wait_for_deferred(lambda: treq.request(method, url, **kwargs))
+    except Exception as error:
+        if isinstance(error, IOError):
+            raise
+        raise IOError(str(error)) from error
+
+
+def _treq_headers(headers):
+    if hasattr(headers, 'getAllRawHeaders'):
+        return headers
+    return {
+        name: value if isinstance(value, (list, tuple)) else [value]
+        for name, value in headers.items()
+    }
+
+
+def _response_status(response):
+    return response.code
+
+
+def _response_header(response, name):
+    values = response.headers.getRawHeaders(name)
+    if not values:
+        values = response.headers.getRawHeaders(name.encode('ascii'))
+    if not values:
+        return None
+    value = values[0]
+    return value.decode('latin1') if isinstance(value, bytes) else value
+
+
+def _response_content(response):
+    return _wait_for_deferred(lambda: treq.content(response))
+
+
+def _response_json(response):
+    return _wait_for_deferred(lambda: treq.json_content(response))
+
+
+def _response_is_redirect(response):
+    return (
+        _response_status(response) in (301, 302, 303, 307, 308)
+        and _response_header(response, 'Location') is not None
+    )
+
+
+def _raise_for_status(response):
+    status = _response_status(response)
+    if status >= 400:
+        raise IOError("HTTP error {}".format(status))
+
+
