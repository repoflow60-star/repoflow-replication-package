+def _run_async(coroutine):
+    """Run an aiohttp coroutine without changing this module's sync API."""
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coroutine)
+
+    # A synchronous caller can also be invoked from a running event loop.
+    with concurrent.futures.ThreadPoolExecutor(max_workers=1) as executor:
+        return executor.submit(asyncio.run, coroutine).result()
+
+
+async def _http_request_async(method, url, verify_ssl=True, timeout=None,
+                              headers=None, params=None, data=None,
+                              allow_redirects=True):
+    """Perform one HTTP request and return data needed by sync callers."""
+    request_args = {
+        "ssl": verify_ssl,
+        "timeout": timeout,
+        "headers": headers,
+        "allow_redirects": allow_redirects,
+    }
+    if params is not None:
+        request_args["params"] = params
+    if data is not None:
+        request_args["data"] = data
+
+    async with aiohttp.ClientSession() as session:
+        async with session.request(method, url, **request_args) as response:
+            body = await response.read()
+            response_headers = {
+                key.lower(): value for key, value in response.headers.items()
+            }
+            error = None
+            if response.status >= 400:
+                try:
+                    response.raise_for_status()
+                except aiohttp.ClientResponseError as exception:
+                    error = exception
+            return (
+                response.status,
+                response_headers,
+                body,
+                response.charset,
+                error,
+            )
+
+
+def _http_request(method, url, verify_ssl=True, timeout=None, headers=None,
+                  params=None, data=None, allow_redirects=True):
+    """Make an aiohttp request while retaining the existing sync boundary."""
+    return _run_async(_http_request_async(
+        method,
+        url,
+        verify_ssl=verify_ssl,
+        timeout=timeout,
+        headers=headers,
+        params=params,
+        data=data,
+        allow_redirects=allow_redirects,
+    ))
+
+
+def _json_response(body, encoding):
+    return json.loads(body.decode(encoding or "utf-8"))
 
