 from .utility import TokenDict, get_access_token_yaml, validate_access_token
 
 log = logging.getLogger(__name__)  # pylint: disable=C0103
 
 TOKEN_URL = "https://login.questrade.com/oauth2/token?grant_type=refresh_token&refresh_token="
+
+
+_REACTOR = SelectReactor()
+_REACTOR_LOCK = threading.Lock()
+_REACTOR_READY = threading.Event()
+_REACTOR_THREAD = None
+
+
+def _run_reactor():
+    """Run the reactor used to bridge treq's Deferred API to this sync wrapper."""
+    _REACTOR.callWhenRunning(_REACTOR_READY.set)
+    _REACTOR.run(installSignalHandlers=False)
+
+
+def _start_reactor():
+    global _REACTOR_THREAD  # pylint: disable=global-statement
+
+    if _REACTOR_THREAD is None:
+        with _REACTOR_LOCK:
+            if _REACTOR_THREAD is None:
+                _REACTOR_THREAD = threading.Thread(target=_run_reactor, daemon=True)
+                _REACTOR_THREAD.start()
+    _REACTOR_READY.wait()
+
+
+@inlineCallbacks
+def _treq_request(
+    method,
+    url,
+    headers=None,
+    params=None,
+    data=None,
+    json=None,
+    timeout=None,
+    decode_json=True,
+):
+    request_headers = None
+    if headers is not None:
+        request_headers = {
+            str(key).encode("ascii"): [str(value).encode("utf-8")]
+            for key, value in headers.items()
+        }
+
+    request_kwargs = {
+        "headers": request_headers,
+        "params": params,
+        "data": data,
+        "json": json,
+        "reactor": _REACTOR,
+    }
+    if timeout is not None:
+        request_kwargs["timeout"] = timeout
+
+    response = yield treq.request(method, url, **request_kwargs)
+    if response.code >= 400:
+        raise RuntimeError("HTTP request failed with status {}".format(response.code))
+    if decode_json:
+        result = yield treq.json_content(response)
+        returnValue(result)
+    yield treq.content(response)
+    returnValue(response)
+
+
+def _request(
+    method,
+    url,
+    headers=None,
+    params=None,
+    data=None,
+    json=None,
+    timeout=None,
+    decode_json=True,
+):
+    _start_reactor()
+    return blockingCallFromThread(
+        _REACTOR,
+        _treq_request,
+        method,
+        url,
+        headers=headers,
+        params=params,
+        data=data,
+        json=json,
+        timeout=timeout,
+        decode_json=decode_json,
+    )
 
 
