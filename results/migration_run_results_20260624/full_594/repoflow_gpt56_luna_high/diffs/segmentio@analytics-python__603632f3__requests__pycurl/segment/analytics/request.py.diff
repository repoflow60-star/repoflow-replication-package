+class _Headers(dict):
+    def get(self, key, default=None):
+        key = key.lower()
+        for header, value in self.items():
+            if header.lower() == key:
+                return value
+        return default
+
+
+class _Response:
+    def __init__(self, body, headers, status_code, reason):
+        self._body = body
+        self.content = body
+        self.headers = headers
+        self.status_code = status_code
+        self.reason = reason
+        self.text = body.decode('utf-8', errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+
+def _proxy_for(url, proxies):
+    if not proxies:
+        return None
+    if isinstance(proxies, dict):
+        scheme = urlsplit(url).scheme.lower()
+        return proxies.get(scheme) or proxies.get('all')
+    return proxies
+
+
+class _PycurlSession:
+    def post(self, url, data=None, headers=None, timeout=None, proxies=None):
+        body = BytesIO()
+        response_headers = BytesIO()
+        curl = pycurl.Curl()
+        try:
+            if isinstance(data, str):
+                data = data.encode('utf-8')
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, data or b'')
+            curl.setopt(pycurl.HTTPHEADER, [
+                '{}: {}'.format(key, value)
+                for key, value in (headers or {}).items()
+            ])
+            curl.setopt(pycurl.WRITEFUNCTION, body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, response_headers.write)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            if timeout is not None:
+                curl.setopt(pycurl.TIMEOUT_MS, max(1, int(timeout * 1000)))
+            proxy = _proxy_for(url, proxies)
+            if proxy:
+                curl.setopt(pycurl.PROXY, proxy)
+            curl.perform()
+
+            parsed_headers = _Headers()
+            reason = ''
+            for line in response_headers.getvalue().decode('iso-8859-1').splitlines():
+                if line.startswith('HTTP/'):
+                    parsed_headers.clear()
+                    parts = line.split(' ', 2)
+                    reason = parts[2] if len(parts) == 3 else ''
+                elif ':' in line:
+                    key, value = line.split(':', 1)
+                    parsed_headers[key] = value.strip()
+            return _Response(
+                body.getvalue(),
+                parsed_headers,
+                curl.getinfo(pycurl.RESPONSE_CODE),
+                reason,
+            )
+        finally:
+            curl.close()
