+def _rgb_to_hex(color):
+    channels = [round(max(0, min(1, float(channel))) * 255) for channel in color]
+    return '#{:02x}{:02x}{:02x}'.format(*channels)
+
+
+def _interpolate_colors(colors, position):
+    if len(colors) < 2:
+        raise ValueError('An Altair color scale must define at least two colors')
+
+    position = max(0, min(1, float(position)))
+    segment = min(int(position * (len(colors) - 1)), len(colors) - 2)
+    segment_position = position * (len(colors) - 1) - segment
+
+    start = colors[segment].lstrip('#')
+    end = colors[segment + 1].lstrip('#')
+    start_rgb = tuple(int(start[i:i + 2], 16) / 255 for i in (0, 2, 4))
+    end_rgb = tuple(int(end[i:i + 2], 16) / 255 for i in (0, 2, 4))
+    color = [start_channel + (end_channel - start_channel) * segment_position
+             for start_channel, end_channel in zip(start_rgb, end_rgb)]
+    return _rgb_to_hex(color)
 
 
