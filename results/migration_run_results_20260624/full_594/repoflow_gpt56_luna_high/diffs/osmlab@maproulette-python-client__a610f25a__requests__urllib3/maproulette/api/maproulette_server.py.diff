+    @staticmethod
+    def _url_with_params(url, params):
+        if not params:
+            return url
+        if isinstance(params, bytes):
+            query = params.decode('utf-8')
+        elif isinstance(params, str):
+            query = params
+        else:
+            if hasattr(params, 'items'):
+                params = params.items()
+            params = [(key, value) for key, value in params if value is not None]
+            query = urlencode(params, doseq=True)
+        separator = '&' if '?' in url else '?'
+        return f'{url}{separator}{query}'
+
+    def _request(self, method, endpoint, params=None, body=None, fields=None):
+        headers = self._request_headers()
+        request_kwargs = {'headers': headers}
+        if body is not None:
+            request_kwargs['body'] = json.dumps(body)
+            headers['Content-Type'] = 'application/json'
+        if fields is not None:
+            request_kwargs['fields'] = fields
+
+        try:
+            return self.session.request(
+                method,
+                self._url_with_params(self.url + endpoint, params),
+                **request_kwargs
+            )
+        except urllib3.exceptions.HTTPError as error:
+            raise ConnectionUnavailableError(message=str(error)) from None
+
+    @staticmethod
+    def _response_text(response):
+        data = response.data
+        if isinstance(data, bytes):
+            return data.decode('utf-8', errors='replace')
+        return data if isinstance(data, str) else str(data)
+
+    def _raise_for_status(self, response, status_errors):
