+def _mark_options(kwargs: dict, default_opacity: float, point: bool = False) -> dict:
+    options = {"opacity": kwargs.get("alpha", default_opacity)}
+    for name in ("color", "stroke", "strokeWidth", "strokeDash"):
+        if name in kwargs:
+            options[name] = kwargs[name]
+    if point:
+        for name in ("size", "shape", "filled"):
+            if name in kwargs:
+                options[name] = kwargs[name]
+    if "c" in kwargs:
+        options["color"] = kwargs["c"]
+    if "linewidth" in kwargs:
+        options["strokeWidth"] = kwargs["linewidth"]
+    if "lw" in kwargs:
+        options["strokeWidth"] = kwargs["lw"]
+    if "edgecolor" in kwargs:
+        options["stroke"] = kwargs["edgecolor"]
+    if "facecolor" in kwargs:
+        options["color"] = kwargs["facecolor"]
+    return options
+
+
+def _properties(chart, kwargs: dict):
+    properties = {
+        name: kwargs[name]
+        for name in ("width", "height", "title", "background", "padding")
+        if name in kwargs
+    }
+    return chart.properties(**properties) if properties else chart
+
+
+def _scale(loglog: bool):
+    return alt.Scale(type="log") if loglog else None
+
