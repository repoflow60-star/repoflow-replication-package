+def _new_axes(figsize):
+    ax = sns.lineplot(x=[0], y=[0], legend=False)
+    ax.clear()
+    ax.figure.set_size_inches(*figsize)
+    return ax
+
+
+def _set_sparse_ticks(ax, ticks, labels):
+    ax.set_xticks(ticks)
+    ax.set_xticklabels(labels, rotation=45)
+    for i, label in enumerate(ax.get_xticklabels()):
+        if i % 5 != 0:
+            label.set_visible(False)
+
+
+def _draw_stack_area(ax, values, colors, labels, x):
+    baseline = np.zeros(len(x))
+    for entity, color, label in zip(values, colors, labels):
+        upper = baseline + entity[:len(x)]
+        ax.fill_between(x, baseline, upper, color=color, edgecolor='face', linewidth=0.0001, label=label)
+        baseline = upper
+
+
+def _capture_frame(fig):
+    frame = BytesIO()
+    fig.savefig(frame, format='png', bbox_inches='tight')
+    frame.seek(0)
+    image = Image.open(frame).convert('RGBA').copy()
+    frame.close()
+    return image
+
+
+def _save_gif(frames, filename):
+    if not frames:
+        return
+    frames[0].save(filename, save_all=True, append_images=frames[1:], duration=100, loop=0)
 
 
