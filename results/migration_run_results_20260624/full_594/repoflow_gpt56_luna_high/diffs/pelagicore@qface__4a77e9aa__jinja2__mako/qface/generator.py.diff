+def _split_filters(expression):
+    """Split a filter expression without splitting pipes in quoted strings."""
+    parts = []
+    start = 0
+    quote = None
+    depth = 0
+    for index, char in enumerate(expression):
+        if quote:
+            if char == quote and (index == 0 or expression[index - 1] != '\\'):
+                quote = None
+        elif char in "'\"":
+            quote = char
+        elif char in '([':
+            depth += 1
+        elif char in ')]':
+            depth -= 1
+        elif char == '|' and depth == 0:
+            parts.append(expression[start:index].strip())
+            start = index + 1
+    parts.append(expression[start:].strip())
+    return parts
+
+
+def _legacy_expression(expression):
+    """Translate the legacy Jinja filter form into ordinary Python calls."""
+    parts = _split_filters(expression.strip())
+    result = parts[0]
+    for part in parts[1:]:
+        match = re.match(r'^([\w.]+)(?:\((.*)\))?$', part, re.DOTALL)
+        if not match:
+            return expression.strip()
+        name, arguments = match.groups()
+        if arguments:
+            result = '{0}({1}, {2})'.format(name, result, arguments)
+        else:
+            result = '{0}({1})'.format(name, result)
+    return result
+
+
+_LEGACY_TOKEN = re.compile(r'({{[-+]?.*?[-+]?}}|{%[-+]?.*?[-+]?%}|{#.*?#})', re.DOTALL)
+
+
+def _legacy_preprocessor(source):
+    """Translate the small Jinja dialect used by existing QFace templates."""
+    output = []
+    position = 0
+    for match in _LEGACY_TOKEN.finditer(source):
+        output.append(source[position:match.start()])
+        token = match.group(0)
+        if token.startswith('{#'):
+            replacement = ''
+        elif token.startswith('{{'):
+            expression = token[2:-2].strip('-+ ')
+            replacement = '${' + _legacy_expression(expression) + '}'
+        else:
+            tag = token[2:-2].strip('-+ \t\r\n')
+            if tag.startswith('for '):
+                replacement = '% ' + tag + ':'
+            elif tag.startswith('if '):
+                replacement = '% ' + tag + ':'
+            elif tag.startswith('elif '):
+                replacement = '% ' + tag + ':'
+            elif tag in ('else', 'endif', 'endfor'):
+                replacement = '% ' + tag
+            elif tag.startswith('macro '):
+                replacement = '<%def name="' + tag[6:].strip() + '">'
+            elif tag == 'endmacro':
+                replacement = '</%def>'
+            elif tag.startswith('with '):
+                assignment = tag[5:].strip()
+                if '=' in assignment:
+                    name, expression = assignment.split('=', 1)
+                    replacement = '<% {0} = {1} %>'.format(
+                        name.strip(), _legacy_expression(expression))
+                else:
+                    replacement = '<% {0} %>'.format(assignment)
+            elif tag == 'endwith':
+                replacement = ''
+            elif tag.startswith('set '):
+                assignment = tag[4:].strip()
+                if '=' in assignment:
+                    name, expression = assignment.split('=', 1)
+                    replacement = '<% {0} = {1} %>'.format(
+                        name.strip(), _legacy_expression(expression))
+                else:
+                    replacement = '<% {0} %>'.format(assignment)
+            else:
+                line = source[:match.start()].count('\n') + 1
+                raise _LegacyTemplateSyntaxError(line, tag.split(None, 1)[0])
+        output.append(replacement)
+        position = match.end()
+    output.append(source[position:])
+    return ''.join(output)
 
 
