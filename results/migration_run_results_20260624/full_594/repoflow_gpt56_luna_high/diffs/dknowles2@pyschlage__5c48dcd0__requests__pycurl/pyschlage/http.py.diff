--- a/pyschlage/http.py
+++ b/pyschlage/http.py
@@ -0,0 +1,122 @@
+"""Small response and request adapters backed by pycurl."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from io import BytesIO
+import json
+from typing import Any
+from urllib.parse import urlencode
+
+import pycurl
+
+
+class CurlHTTPError(Exception):
+    """Raised when an HTTP response has an unsuccessful status code."""
+
+
+@dataclass
+class CurlRequest:
+    """The request attributes used by pycognito's authentication hook."""
+
+    method: str = "GET"
+    url: str = ""
+    headers: dict[str, str] = field(default_factory=dict)
+    body: bytes | str | None = None
+
+
+@dataclass
+class CurlResponse:
+    """The subset of an HTTP response used by pyschlage."""
+
+    status_code: int
+    headers: dict[str, str]
+    content: bytes
+    reason: str
+
+    @property
+    def text(self) -> str:
+        return self.content.decode("utf-8", errors="replace")
+
+    def json(self) -> Any:
+        return json.loads(self.content)
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            raise CurlHTTPError(
+                f"{self.status_code} {self.reason}".strip()
+            )
+
+
+def perform_request(
+    method: str,
+    url: str,
+    *,
+    headers: dict[str, str],
+    params: Any = None,
+    json_data: Any = None,
+    data: Any = None,
+    timeout: int | float = 60,
+) -> CurlResponse:
+    """Perform one HTTP request using libcurl through pycurl."""
+    if params:
+        query = urlencode(params, doseq=True)
+        url = f"{url}{'&' if '?' in url else '?'}{query}"
+
+    body: bytes | None = None
+    request_headers = dict(headers)
+    if json_data is not None:
+        body = json.dumps(json_data).encode("utf-8")
+        request_headers.setdefault("Content-Type", "application/json")
+    elif data is not None:
+        if isinstance(data, bytes):
+            body = data
+        elif isinstance(data, str):
+            body = data.encode("utf-8")
+        else:
+            body = urlencode(data, doseq=True).encode("utf-8")
+
+    response_body = BytesIO()
+    response_headers: dict[str, str] = {}
+    status_line = ""
+
+    def receive_header(raw_header: bytes) -> int:
+        nonlocal status_line
+        header = raw_header.decode("latin-1").rstrip("\r\n")
+        if header.startswith("HTTP/"):
+            status_line = header
+        elif ":" in header:
+            name, value = header.split(":", 1)
+            response_headers[name.strip()] = value.strip()
+        return len(raw_header)
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.CUSTOMREQUEST, method.upper())
+        curl.setopt(
+            pycurl.HTTPHEADER,
+            [f"{name}: {value}" for name, value in request_headers.items()],
+        )
+        curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, receive_header)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.TIMEOUT, timeout)
+        if body is not None:
+            curl.setopt(pycurl.POSTFIELDS, body)
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+
+    reason = ""
+    if status_line:
+        parts = status_line.split(" ", 2)
+        if len(parts) == 3:
+            reason = parts[2]
+    return CurlResponse(
+        status_code=status_code,
+        headers=response_headers,
+        content=response_body.getvalue(),
+        reason=reason,
+    )
