+class Response:
+    """Small Requests-compatible response wrapper for urllib3 responses."""
+
+    def __init__(self, response, method, url, elapsed):
+        self.raw = response
+        self.status_code = response.status
+        self.ok = self.status_code < 400
+        self.headers = response.headers
+        self.url = url
+        self.reason = response.reason
+        self.elapsed = timedelta(seconds=elapsed)
+        self.request = _Request(method, url)
+        self._content = response.data
+
+    @property
+    def content(self):
+        return self._content
+
+    @property
+    def text(self):
+        return self._content.decode('utf-8', errors='replace')
+
+    def json(self, **kwargs):
+        return json.loads(self.text, **kwargs)
+
+    def close(self):
+        self.raw.close()
+
+
+class _Urllib3Transport:
+    """Translate the session's Requests-style arguments to urllib3."""
+
+    def __init__(self):
+        self.pool = PoolManager(retries=False)
+
+    def request(self, method, url, **request_kwargs):
+        request_kwargs = dict(request_kwargs)
+
+        params = request_kwargs.pop('params', None)
+        if params:
+            parts = urlsplit(url)
+            query = urlencode(params, doseq=True)
+            if parts.query:
+                query = parts.query + '&' + query
+            url = urlunsplit((parts.scheme, parts.netloc, parts.path,
+                query, parts.fragment))
+
+        stream = request_kwargs.pop('stream', None)
+        if stream is not None:
+            request_kwargs['preload_content'] = not stream
+        allow_redirects = request_kwargs.pop('allow_redirects', None)
+        if allow_redirects is not None:
+            request_kwargs['redirect'] = allow_redirects
+
+        json_body = request_kwargs.pop('json', None)
+        data = request_kwargs.pop('data', None)
+        headers = request_kwargs.get('headers')
+        if json_body is not None:
+            request_kwargs['body'] = json.dumps(json_body).encode('utf-8')
+            if headers is not None and not any(
+                    key.lower() == 'content-type' for key in headers):
+                headers = dict(headers)
+                headers['Content-Type'] = 'application/json'
+                request_kwargs['headers'] = headers
+        elif data is not None:
+            if isinstance(data, dict):
+                request_kwargs['body'] = urlencode(data, doseq=True).encode('utf-8')
+                if headers is not None and not any(
+                        key.lower() == 'content-type' for key in headers):
+                    headers = dict(headers)
+                    headers['Content-Type'] = 'application/x-www-form-urlencoded'
+                    request_kwargs['headers'] = headers
+            else:
+                request_kwargs['body'] = data
+
+        started = time.monotonic()
+        response = self.pool.request(method, url, **request_kwargs)
+        return Response(response, method, url, time.monotonic() - started)
+
