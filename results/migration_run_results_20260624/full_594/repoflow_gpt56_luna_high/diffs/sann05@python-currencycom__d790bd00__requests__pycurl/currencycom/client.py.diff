+    @staticmethod
+    def _request(method, url, params=None, headers=None):
+        params = params or {}
+        query = urlencode(
+            [(key, value) for key, value in params.items()
+             if value is not None],
+            doseq=True
+        )
+        if query:
+            separator = '&' if '?' in url else '?'
+            url = '{}{}{}'.format(url, separator, query)
+
+        response = io.BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.FOLLOWLOCATION, True)
+            curl.setopt(pycurl.ACCEPT_ENCODING, '')
+            curl.setopt(pycurl.HTTP_VERSION, pycurl.CURL_HTTP_VERSION_1_1)
+            curl.setopt(pycurl.USERAGENT, 'python-currencycom')
+            curl.setopt(pycurl.WRITEFUNCTION, response.write)
+            if headers:
+                curl.setopt(
+                    pycurl.HTTPHEADER,
+                    ['{}: {}'.format(name, value)
+                     for name, value in headers.items()]
+                )
+
+            if method == 'GET':
+                curl.setopt(pycurl.HTTPGET, True)
+            elif method == 'POST':
+                curl.setopt(pycurl.POST, True)
+            else:
+                curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+            curl.perform()
+        finally:
+            curl.close()
+
+        return json.loads(response.getvalue().decode('utf-8'))
