+def _global_help():
+    _echo(
+        "Usage: hab [global options] <command> [command options]\n\n"
+        "Commands: set-uri, env, dump, activate, launch, cache\n\n"
+        "Use 'hab <command> --help' for command help."
+    )
+
+
+def _take_value(args, index, option):
+    if index + 1 >= len(args):
+        raise UsageError(f"Option {option} requires a value.")
+    return args[index + 1], index + 2
+
+
+def _parse_global_options(argv):
+    settings = SharedSettings()
+    index = 0
+    while index < len(argv):
+        arg = argv[index]
+        if not arg.startswith("-"):
+            return settings, arg, list(argv[index + 1 :])
+        if arg in ("-h", "--help"):
+            _global_help()
+            return settings, None, []
+        if arg == "--version":
+            _echo(__version__)
+            return settings, None, []
+        if arg in ("-v", "--verbose"):
+            SharedSettings.set_ctx_instance(
+                settings, "verbosity", settings.verbosity + 1
+            )
+            index += 1
+            continue
+        if arg in ("--site", "--logging-config", "--script-dir", "--script-ext"):
+            value, index = _take_value(argv, index, arg)
+            key = arg[2:].replace("-", "_")
+            if key == "site":
+                settings.site_paths.append(Path(value).expanduser().resolve())
+            else:
+                SharedSettings.set_ctx_instance(settings, key, value)
+            continue
+        if arg.startswith("--site="):
+            settings.site_paths.append(Path(arg.split("=", 1)[1]).expanduser().resolve())
+            index += 1
+            continue
+        if arg.startswith(("--logging-config=", "--script-dir=", "--script-ext=")):
+            key, value = arg[2:].split("=", 1)
+            SharedSettings.set_ctx_instance(settings, key.replace("-", "_"), value)
+            index += 1
+            continue
+        if arg in ("--cache", "--no-cache", "--pre", "--no-pre"):
+            key = "cached" if "cache" in arg else "prereleases"
+            SharedSettings.set_ctx_instance(settings, key, not arg.startswith("--no-"))
+            index += 1
+            continue
+        if arg in (
+            "--dump-scripts",
+            "--no-dump-scripts",
+            "--prefs",
+            "--no-prefs",
+            "--save-prefs",
+            "--no-save-prefs",
+        ):
+            key = {
+                "--dump-scripts": "dump_scripts",
+                "--no-dump-scripts": "dump_scripts",
+                "--prefs": "enable_user_prefs",
+                "--no-prefs": "enable_user_prefs",
+                "--save-prefs": "enable_user_prefs_save",
+                "--no-save-prefs": "enable_user_prefs_save",
+            }[arg]
+            SharedSettings.set_ctx_instance(settings, key, not arg.startswith("--no-"))
+            index += 1
+            continue
+        if arg in ("-r", "--requirement") or arg.startswith("--requirement="):
+            if "=" in arg:
+                value, index = arg.split("=", 1)[1], index + 1
+            else:
+                value, index = _take_value(argv, index, arg)
+            settings.forced_requirements = tuple(
+                settings.forced_requirements or ()
+            ) + (value,)
+            continue
+        raise UsageError(f"Unknown option: {arg}")
+    return settings, None, []
+
