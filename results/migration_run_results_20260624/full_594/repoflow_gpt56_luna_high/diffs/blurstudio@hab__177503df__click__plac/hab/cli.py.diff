+def _plac_command_call(settings, command, args):
+    """Run one command through plac's function annotation parser."""
+    if command == "set-uri":
+        @plac.annotations(uri=("URI to save", "positional", None, str))
+        def command_line(uri=None):
+            return set_uri(settings, uri)
+
+        return plac.call(command_line, args)
+
+    if command in ("env", "activate"):
+        function = env if command == "env" else activate
+
+        @plac.annotations(
+            uri=("URI to resolve", "positional", None, str),
+            launch=("Alias to launch after setup", "option", "l", str),
+        )
+        def command_line(uri, launch=None):
+            uri = UriArgument().type_cast_value(settings, uri)
+            return function(settings, uri, launch)
+
+        return plac.call(command_line, args)
+
+    if command == "cache":
+        @plac.annotations(path=("Site configuration path", "positional", None, str))
+        def command_line(path):
+            return cache(settings, Path(path).expanduser().resolve())
+
+        return plac.call(command_line, args)
+
+    if command == "launch":
