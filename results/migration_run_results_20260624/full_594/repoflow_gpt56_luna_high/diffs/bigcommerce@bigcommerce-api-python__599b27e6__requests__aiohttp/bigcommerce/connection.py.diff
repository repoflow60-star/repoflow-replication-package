+class _ResponseSnapshot(object):
+    """Synchronous view of an aiohttp response after its body is read."""
+
+    def __init__(self, response, content):
+        self.status_code = response.status
+        self.reason = response.reason
+        self.headers = dict(response.headers)
+        self.content = content
+
+    def json(self):
+        return loads(self.content)
+
+
+class _AiohttpSession(object):
+    """Keep the package's synchronous API while using aiohttp for transport."""
+
+    def __init__(self):
+        self.auth = None
+        self.headers = {}
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        try:
+            running = asyncio.get_event_loop().is_running()
+        except RuntimeError:
+            running = False
+        if running:
+            result = []
+            error = []
+
+            def run_request():
+                loop = asyncio.new_event_loop()
+                try:
+                    result.append(loop.run_until_complete(self._request(method, url, data, timeout, headers)))
+                except BaseException as exc:
+                    error.append(exc)
+                finally:
+                    loop.close()
+
+            thread = threading.Thread(target=run_request)
+            thread.start()
+            thread.join()
+            if error:
+                raise error[0]
+            return result[0]
+
+        loop = asyncio.new_event_loop()
+        try:
+            return loop.run_until_complete(self._request(method, url, data, timeout, headers))
+        finally:
+            loop.close()
+
+    async def _request(self, method, url, data, timeout, headers):
+        auth = aiohttp.BasicAuth(*self.auth) if self.auth else None
+        client_timeout = aiohttp.ClientTimeout(total=timeout) if timeout is not None else None
+        async with aiohttp.ClientSession(headers=self.headers, auth=auth) as session:
+            async with session.request(method, url, data=data, timeout=client_timeout, headers=headers) as response:
+                content = await response.read()
+                return _ResponseSnapshot(response, content)
 
 
