+class _Context:
+    def __init__(self, obj=None):
+        self.obj = {} if obj is None else obj
+
+
+class CLI:
+    """Plac command interpreter for the eparse command line interface."""
+
+    @plac.annotations(
+        input=("input source", "option", "i", str),
+        output=("output destination", "option", "o", str),
+        file=("file(s) or dir(s) to target", "option", "f", str),
+        debug=("use debug mode", "flag", "d"),
+        loose=("find tables loosely", "flag", "l"),
+        recursive=("find files recursively", "flag", "r"),
+        truncate=("truncate dataframe output", "flag", "t"),
+        verbose=("increase output verbosity", "flag", "v"),
+    )
+    def __init__(
+        self,
+        input="null:///",
+        output="null:///",
+        file=(),
+        debug=False,
+        loose=True,
+        recursive=False,
+        truncate=True,
+        verbose=False,
+    ):
+        self.ctx = _Context()
+        if isinstance(file, str):
+            file = (file,)
+        if isinstance(verbose, bool):
+            verbose = int(verbose)
+        main(
+            self.ctx,
+            input,
+            output,
+            file,
+            debug,
+            loose,
+            recursive,
+            truncate,
+            verbose,
+        )
+
+    @plac.annotations(
+        number=("stop after n excel files", "option", "n", int),
+        sheet=("name of sheet to scan for", "option", "s", str),
+        tables=("count tables in scanned sheets", "flag", "t"),
+    )
+    def scan(self, number=None, sheet=None, tables=False):
+        return scan(self.ctx, number, sheet, tables)
+
+    @plac.annotations(
+        sheet=("name of sheet(s) to parse", "option", "s", str),
+        serialize=("serialize table output", "flag", "z"),
+        table=("name of table to parse", "option", "t", str),
+        nacount=(
+            "allow for this many NA values when spanning rows and columns",
+            "option",
+            None,
+            int,
+        ),
+    )
+    def parse(self, sheet=(), serialize=False, table=None, nacount=0):
+        if isinstance(sheet, str):
+            sheet = (sheet,)
+        return parse(self.ctx, sheet, serialize, table, nacount)
+
+    @plac.annotations(
+        filter=(
+            "django-style filter(s) to apply to base queryset",
+            "option",
+            "f",
+            str,
+        ),
+        method=("method to call on eparse model", "option", "m", str),
+        serialize=("serialize query output", "flag", "z"),
+    )
+    def query(self, filter=(), method="get_queryset", serialize=False):
+        if isinstance(filter, str):
+            filter = (filter,)
+        return query(self.ctx, filter, method, serialize)
+
+    @plac.annotations(
+        migration=("database migration(s) to apply", "option", "m", str),
+    )
+    def migrate(self, migration=()):
+        if isinstance(migration, str):
+            migration = (migration,)
+        if not migration:
+            raise ValueError("missing required option: --migration")
+        return migrate(self.ctx, migration)
+
+
+def _compatibility_main(args=None, **kwargs):
+    """Run the command protocol used by existing programmatic callers."""
+
+    args = list(sys.argv[1:] if args is None else args)
+    if not args or "--help" in args or "-h" in args:
+        print("Usage: eparse [OPTIONS] COMMAND [ARGS]")
+        return
+
+    values = {
+        "input": "null:///",
+        "output": "null:///",
+        "file": [],
+        "debug": False,
+        "loose": True,
+        "recursive": False,
+        "truncate": True,
+        "verbose": 0,
+    }
+    commands = {"scan", "parse", "query", "migrate"}
+    index = 0
+    command = None
+
+    while index < len(args):
+        token = args[index]
+        if token in commands:
+            command = token
+            index += 1
+            break
+        if token in ("--input", "-i", "--output", "-o", "--file", "-f"):
+            if index + 1 >= len(args):
+                raise SystemExit(2)
+            value = args[index + 1]
+            if token in ("--file", "-f"):
+                values["file"].append(value)
+            else:
+                values["input" if token in ("--input", "-i") else "output"] = value
+            index += 2
+            continue
+        if token.startswith("--input="):
+            values["input"] = token.split("=", 1)[1]
+        elif token.startswith("--output="):
+            values["output"] = token.split("=", 1)[1]
+        elif token.startswith("--file="):
+            values["file"].append(token.split("=", 1)[1])
+        elif token in ("--debug", "-d"):
+            values["debug"] = True
+        elif token in ("--recursive", "-r"):
+            values["recursive"] = True
+        elif token in ("--loose", "-l"):
+            values["loose"] = True
+        elif token in ("--truncate", "-t"):
+            values["truncate"] = True
+        elif token in ("--verbose", "-v"):
+            values["verbose"] += 1
+        elif token.startswith("-v") and set(token[1:]) == {"v"}:
+            values["verbose"] += len(token) - 1
+        else:
+            raise SystemExit(2)
+        index += 1
+
+    if command is None:
+        raise SystemExit(2)
+
+    context = _Context(kwargs.get("obj"))
+    main(
+        context,
+        values["input"],
+        values["output"],
+        tuple(values["file"]),
+        values["debug"],
+        values["loose"],
+        values["recursive"],
+        values["truncate"],
+        values["verbose"],
+    )
+
+    if command == "scan":
+        number = None
+        sheet = None
+        tables = False
+        while index < len(args):
+            token = args[index]
+            if token in ("--number", "-n", "--sheet", "-s"):
+                if index + 1 >= len(args):
+                    raise SystemExit(2)
+                value = args[index + 1]
+                if token in ("--number", "-n"):
+                    number = int(value)
+                else:
+                    sheet = value
+                index += 2
+            elif token in ("--tables", "-t"):
+                tables = True
+                index += 1
+            else:
+                raise SystemExit(2)
+        return scan(context, number, sheet, tables)
+
+    if command == "parse":
+        sheet = []
+        serialize = False
+        table = None
+        nacount = 0
+        while index < len(args):
+            token = args[index]
+            if token in ("--sheet", "-s", "--table", "-t", "--nacount"):
+                if index + 1 >= len(args):
+                    raise SystemExit(2)
+                value = args[index + 1]
+                if token in ("--sheet", "-s"):
+                    sheet.append(value)
+                elif token in ("--table", "-t"):
+                    table = value
+                else:
+                    nacount = int(value)
+                index += 2
+            elif token in ("--serialize", "-z"):
+                serialize = True
+                index += 1
+            else:
+                raise SystemExit(2)
+        return parse(context, tuple(sheet), serialize, table, nacount)
+
+    if command == "query":
+        filters = []
+        method = "get_queryset"
+        serialize = False
+        while index < len(args):
+            token = args[index]
+            if token in ("--filter", "-f"):
+                if index + 2 >= len(args):
+                    raise SystemExit(2)
+                filters.append((args[index + 1], args[index + 2]))
+                index += 3
+            elif token in ("--method", "-m"):
+                if index + 1 >= len(args):
+                    raise SystemExit(2)
+                method = args[index + 1]
+                index += 2
+            elif token in ("--serialize", "-z"):
+                serialize = True
+                index += 1
+            else:
+                raise SystemExit(2)
+        return query(context, tuple(filters), method, serialize)
+
+    migrations = []
+    while index < len(args):
+        token = args[index]
+        if token in ("--migration", "-m"):
+            if index + 1 >= len(args):
+                raise SystemExit(2)
+            migrations.append(args[index + 1])
+            index += 2
+        else:
+            raise SystemExit(2)
+    if not migrations:
+        raise SystemExit(2)
+    return migrate(context, tuple(migrations))
+
+
+# Keep the exported callable usable by callers that invoke command objects
+# directly, while the installed console script uses Plac below.
+main.name = "eparse"
+main.main = _compatibility_main
+
+
