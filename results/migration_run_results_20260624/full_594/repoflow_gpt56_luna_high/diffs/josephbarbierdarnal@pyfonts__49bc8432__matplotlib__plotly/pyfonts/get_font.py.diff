+def _font_family(font_location: str) -> str:
+    """Read the family name from an OpenType name table when available."""
+    path = Path(font_location)
+    if not path.is_file():
+        raise ValueError(f"Font file not found at : '{font_location}'")
+
+    try:
+        data = path.read_bytes()
+    except OSError as error:
+        raise ValueError(f"Unable to read font file at : '{font_location}'") from error
+
+    fallback = path.stem
+    if len(data) < 12:
+        return fallback
+
+    try:
+        table_count = unpack_from(">H", data, 4)[0]
+        name_table = None
+        for index in range(table_count):
+            table_offset = 12 + (index * 16)
+            if table_offset + 16 > len(data):
+                break
+            if data[table_offset : table_offset + 4] != b"name":
+                continue
+
+            offset = unpack_from(">I", data, table_offset + 8)[0]
+            length = unpack_from(">I", data, table_offset + 12)[0]
+            if offset + length <= len(data):
+                name_table = data[offset : offset + length]
+            break
+
+        if name_table is None or len(name_table) < 6:
+            return fallback
+
+        record_count = unpack_from(">H", name_table, 2)[0]
+        strings_offset = unpack_from(">H", name_table, 4)[0]
+        candidates = []
+        for index in range(record_count):
+            record_offset = 6 + (index * 12)
+            if record_offset + 12 > len(name_table):
+                break
+
+            platform, _, language, name_id, length, offset = unpack_from(
+                ">HHHHHH", name_table, record_offset
+            )
+            if name_id != 1:
+                continue
+
+            start = strings_offset + offset
+            end = start + length
+            if end > len(name_table):
+                continue
+
+            encoding = "utf-16-be" if platform in (0, 3) else "mac_roman"
+            try:
+                family = name_table[start:end].decode(encoding).strip("\x00 ")
+            except UnicodeDecodeError:
+                continue
+            if family:
+                priority = (
+                    0 if language == 0x0409 else 1,
+                    0 if platform in (0, 3) else 1,
+                )
+                candidates.append((priority, family))
+
+        if candidates:
+            candidates.sort(key=lambda candidate: candidate[0])
+            return candidates[0][1]
+    except (IndexError, StructError):
+        pass
+
+    return fallback
+
