-import requests
+from io import BytesIO
+from urllib.parse import quote
+
+import pycurl
+
 from nyaapy import torrent
 from nyaapy.parser import parse_nyaa, parse_single, parse_nyaa_rss
+
+
+def _get(url: str) -> bytes:
+    response_body = BytesIO()
+    curl = pycurl.Curl()
+    status_code = 0
+
+    try:
+        curl.setopt(pycurl.URL, quote(url, safe=":/?&=+#%"))
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.USERAGENT, "nyaapy/0.7")
+        curl.setopt(pycurl.HTTPHEADER, ["Accept: */*"])
+        curl.setopt(pycurl.ACCEPT_ENCODING, "")
+        curl.setopt(pycurl.WRITEDATA, response_body)
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+
+    if 400 <= status_code < 600:
+        raise RuntimeError(f"HTTP error {status_code}")
+
+    return response_body.getvalue()
 
 
