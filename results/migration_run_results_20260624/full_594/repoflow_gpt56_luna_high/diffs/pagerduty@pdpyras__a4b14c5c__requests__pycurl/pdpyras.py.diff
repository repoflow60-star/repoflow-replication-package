+class _Headers(dict):
+    """A case-insensitive mapping for HTTP headers."""
+
+    def _existing_key(self, key):
+        key_lower = key.lower()
+        for existing in self:
+            if existing.lower() == key_lower:
+                return existing
+        return None
+
+    def __contains__(self, key):
+        return self._existing_key(key) is not None
+
+    def __getitem__(self, key):
+        existing = self._existing_key(key)
+        if existing is None:
+            raise KeyError(key)
+        return dict.__getitem__(self, existing)
+
+    def __setitem__(self, key, value):
+        existing = self._existing_key(key)
+        dict.__setitem__(self, existing or key, value)
+
+    def __delitem__(self, key):
+        existing = self._existing_key(key)
+        if existing is None:
+            raise KeyError(key)
+        dict.__delitem__(self, existing)
+
+    def get(self, key, default=None):
+        try:
+            return self[key]
+        except KeyError:
+            return default
+
+    def update(self, other=None, **kwargs):
+        if other is not None:
+            items = other.items() if hasattr(other, 'items') else other
+            for key, value in items:
+                self[key] = value
+        for key, value in kwargs.items():
+            self[key] = value
+
+
+class _Request:
+    def __init__(self, method, url):
+        self.method = method
+        self.url = url
+
+
+class Response:
+    """HTTP response representation returned by the PycURL transport."""
+
+    def __init__(self, status_code=0, content=b'', headers=None, method=None,
+            url=None, elapsed=0):
+        self.status_code = status_code
+        self.content = content
+        self.headers = _Headers(headers or {})
+        self.request = _Request(method, url)
+        self.url = url
+        self.elapsed = timedelta(seconds=elapsed)
+
+    @property
+    def ok(self):
+        return self.status_code < 400
+
+    @property
+    def text(self):
+        return self.content.decode('utf-8', errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+
+def _response_headers(raw_headers):
+    headers = _Headers()
+    for raw_line in raw_headers.splitlines():
+        line = raw_line.decode('iso-8859-1').strip()
+        if line.upper().startswith('HTTP/'):
+            headers = _Headers()
+        elif ':' in line:
+            key, value = line.split(':', 1)
+            headers[key.strip()] = value.strip()
+    return headers
+
+
+class _PycurlSession:
+    """HTTP session boundary backed by PycURL."""
+
+    def delete(self, url, **kwargs) -> Response:
+        return self.request('DELETE', url, **kwargs)
+
+    def get(self, url, **kwargs) -> Response:
+        kwargs.setdefault('allow_redirects', True)
+        return self.request('GET', url, **kwargs)
+
+    def post(self, url, **kwargs) -> Response:
+        return self.request('POST', url, **kwargs)
+
+    def put(self, url, **kwargs) -> Response:
+        return self.request('PUT', url, **kwargs)
+
+    def request(self, method, url, **kwargs) -> Response:
+        params = kwargs.get('params')
+        if params:
+            parts = urlsplit(url)
+            query = urlencode(params, doseq=True)
+            if parts.query:
+                query = parts.query + '&' + query
+            url = urlunsplit((parts.scheme, parts.netloc, parts.path, query,
+                parts.fragment))
+
+        headers = kwargs.get('headers', {})
+        curl_headers = [
+            '%s: %s' % (key, value) for key, value in headers.items()
+        ]
+        body = None
+        if 'json' in kwargs and kwargs['json'] is not None:
+            body = json.dumps(kwargs['json']).encode('utf-8')
+            if not any(key.lower() == 'content-type' for key in headers):
+                curl_headers.append('Content-Type: application/json')
+        elif 'data' in kwargs and kwargs['data'] is not None:
+            body = kwargs['data']
+            if isinstance(body, dict):
+                body = urlencode(body, doseq=True)
+            if isinstance(body, str):
+                body = body.encode('utf-8')
+
+        response_body = BytesIO()
+        response_headers = BytesIO()
+        curl = pycurl.Curl()
+        started = time.monotonic()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            curl.setopt(pycurl.HTTPHEADER, curl_headers)
+            curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, response_headers.write)
+            curl.setopt(pycurl.FOLLOWLOCATION,
+                kwargs.get('allow_redirects', True))
+            timeout = kwargs.get('timeout')
+            if isinstance(timeout, (tuple, list)):
+                connect_timeout, timeout = timeout
+                curl.setopt(pycurl.CONNECTTIMEOUT, int(connect_timeout))
+            if timeout is not None:
+                timeout = float(timeout)
+                if timeout < 1:
+                    curl.setopt(pycurl.TIMEOUT_MS, int(timeout * 1000))
+                else:
+                    curl.setopt(pycurl.TIMEOUT, int(timeout))
+            if kwargs.get('verify') is False:
+                curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+                curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+            if body is not None:
+                curl.setopt(pycurl.POSTFIELDS, body)
+            elif method in ('POST', 'PUT'):
+                curl.setopt(pycurl.POSTFIELDS, b'')
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        return Response(
+            status_code=status_code,
+            content=response_body.getvalue(),
+            headers=_response_headers(response_headers.getvalue()),
+            method=method,
+            url=url,
+            elapsed=time.monotonic() - started,
+        )
 
