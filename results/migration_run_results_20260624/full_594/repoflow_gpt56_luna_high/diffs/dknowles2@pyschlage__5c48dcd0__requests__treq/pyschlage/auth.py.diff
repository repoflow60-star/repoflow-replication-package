+
+class _SynchronousResponse:
+    """Synchronous response facade retained for the package's public API."""
+
+    def __init__(self, response: Any, body: bytes) -> None:
+        self.status_code = response.code
+        phrase = response.phrase
+        self.reason = phrase.decode("utf-8", errors="replace") if isinstance(
+            phrase, bytes
+        ) else str(phrase)
+        self._body = body
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            raise _HTTPError(f"{self.status_code} {self.reason}".strip())
+
+    def json(self) -> Any:
+        return json.loads(self._body.decode("utf-8"))
+
+
+_reactor_started = threading.Event()
+_reactor_thread: threading.Thread | None = None
+_reactor_lock = threading.Lock()
+
+
+def _start_reactor() -> None:
+    global _reactor_thread
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if reactor.running or _reactor_thread is not None:
+            return
+
+        def run_reactor() -> None:
+            reactor.callWhenRunning(_reactor_started.set)
+            reactor.run(installSignalHandlers=False)
+
+        _reactor_thread = threading.Thread(
+            target=run_reactor,
+            name="pyschlage-treq-reactor",
+            daemon=True,
+        )
+        _reactor_thread.start()
+    _reactor_started.wait()
+
+
+def _wait_for_deferred(value: Any) -> Any:
+    """Resolve a treq Deferred without changing the package's sync API."""
+    if not isinstance(value, Deferred):
+        return value
+    if reactor.running and threading.current_thread() is _reactor_thread:
+        raise RuntimeError("Cannot synchronously wait from the Twisted reactor")
+
+    _start_reactor()
+    completed = threading.Event()
+    result: list[Any] = []
+    failure: list[Any] = []
+
+    def callback(response: Any) -> Any:
+        result.append(response)
+        completed.set()
+        return response
+
+    def errback(error: Any) -> Any:
+        failure.append(error)
+        completed.set()
+        return error
+
+    reactor.callFromThread(value.addCallbacks, callback, errback)
+    completed.wait()
+    if failure:
+        failure[0].raiseException()
+    return result[0]
+
