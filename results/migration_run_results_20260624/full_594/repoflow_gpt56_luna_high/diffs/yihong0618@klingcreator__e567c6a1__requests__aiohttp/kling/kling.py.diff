+class _SyncResponse:
+    def __init__(self, status: int, content: bytes, encoding: str) -> None:
+        self.status_code = status
+        self.ok = status < 400
+        self.content = content
+        self.text = content.decode(encoding, errors="replace")
+
+    def json(self):
+        return json.loads(self.text)
+
+
+class _CookieJar(aiohttp.CookieJar):
+    def __init__(self) -> None:
+        # CookieJar construction is synchronous, while aiohttp normally gets
+        # its loop from an active async context.
+        super().__init__(loop=asyncio.new_event_loop())
+
+    def __iter__(self):
+        for morsel in super().__iter__():
+            yield morsel.key, morsel.value
+
+
+class _SyncAiohttpClient:
+    """Expose the small synchronous session API used by the generators."""
+
+    def __init__(self, cookie_jar: aiohttp.CookieJar, headers: dict) -> None:
+        self.cookies = cookie_jar
+        self.headers = headers
+        self._request_lock = threading.RLock()
+
+    def get(self, url: str, **kwargs):
+        return self._request("GET", url, **kwargs)
+
+    def post(self, url: str, **kwargs):
+        return self._request("POST", url, **kwargs)
+
+    def _request(self, method: str, url: str, **kwargs):
+        with self._request_lock:
+            coroutine = self._request_async(method, url, **kwargs)
+            try:
+                asyncio.get_running_loop()
+            except RuntimeError:
+                return asyncio.run(coroutine)
+
+            result = []
+            error = []
+
+            def run_request() -> None:
+                try:
+                    result.append(asyncio.run(coroutine))
+                except BaseException as exc:
+                    error.append(exc)
+
+            thread = threading.Thread(target=run_request)
+            thread.start()
+            thread.join()
+            if error:
+                raise error[0]
+            return result[0]
+
+    async def _request_async(self, method: str, url: str, **kwargs):
+        request_kwargs = dict(kwargs)
+        request_kwargs.setdefault("allow_redirects", True)
+        async with aiohttp.ClientSession(
+            cookie_jar=self.cookies, headers=dict(self.headers)
+        ) as session:
+            async with session.request(method, url, **request_kwargs) as response:
+                content = await response.read()
+                encoding = response.charset or "utf-8"
+                return _SyncResponse(response.status, content, encoding)
+
+
