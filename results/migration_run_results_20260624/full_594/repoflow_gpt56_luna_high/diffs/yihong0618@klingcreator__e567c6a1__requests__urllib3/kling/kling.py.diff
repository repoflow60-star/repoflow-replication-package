+class _Urllib3ResponseAdapter:
+    """Expose the response attributes used by the existing API on HTTPResponse."""
+
+    def __init__(self, response) -> None:
+        self._response = response
+
+    @property
+    def status(self):
+        status = getattr(self._response, "status", None)
+        if isinstance(status, int):
+            return status
+        return getattr(self._response, "status_code", status)
+
+    @property
+    def status_code(self):
+        return self.status
+
+    @property
+    def ok(self) -> bool:
+        response_ok = getattr(self._response, "ok", None)
+        if isinstance(response_ok, bool):
+            return response_ok
+        return self.status < 400
+
+    @property
+    def content(self):
+        return self._response.data
+
+    @property
+    def text(self) -> str:
+        return self.content.decode("utf-8", errors="replace")
+
+    def json(self):
+        response_json = getattr(self._response, "json", None)
+        if callable(response_json):
+            return response_json()
+        return json_module.loads(self.content)
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
+
+class _Urllib3Session:
+    def __init__(self) -> None:
+        self._pool = urllib3.PoolManager()
+        self.cookies: dict[str, str] = {}
+        self.headers: dict[str, str] = {}
+
+    def _request(self, method: str, url: str, **kwargs):
+        params = kwargs.pop("params", None)
+        if params:
+            separator = "&" if "?" in url else "?"
+            url = f"{url}{separator}{urlencode(params, doseq=True)}"
+
+        headers = dict(self.headers)
+        headers.update(kwargs.pop("headers", {}))
+        if "data" in kwargs:
+            kwargs["body"] = kwargs.pop("data")
+        if self.cookies and not any(
+            key.lower() == "cookie" for key in headers
+        ):
+            headers["Cookie"] = "; ".join(
+                f"{key}={value}" for key, value in self.cookies.items()
+            )
+
+        response = self._pool.request(method, url, headers=headers, **kwargs)
+        return _Urllib3ResponseAdapter(response)
+
+    def get(self, url: str, **kwargs):
+        return self._request("GET", url, **kwargs)
+
+    def post(
+        self, url: str, json: Optional[dict] = None, **kwargs
+    ):
+        if json is not None:
+            kwargs["body"] = json_module.dumps(json).encode("utf-8")
+            headers = dict(kwargs.pop("headers", {}))
+            headers.setdefault("Content-Type", "application/json")
+            kwargs["headers"] = headers
+        return self._request("POST", url, **kwargs)
+
