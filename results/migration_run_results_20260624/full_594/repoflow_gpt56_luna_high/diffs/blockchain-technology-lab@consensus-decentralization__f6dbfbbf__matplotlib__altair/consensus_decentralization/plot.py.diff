+def _color_scale(colors):
+    if colors is None:
+        return alt.Scale(scheme='category20')
+    normalized = []
+    for color in colors:
+        if isinstance(color, str):
+            normalized.append(color)
+            continue
+        components = list(color)
+        if max(components) <= 1:
+            components = [round(component * 255) for component in components]
+        normalized.append('rgb({}, {}, {})'.format(*components[:3]))
+    return alt.Scale(range=normalized)
+
+
