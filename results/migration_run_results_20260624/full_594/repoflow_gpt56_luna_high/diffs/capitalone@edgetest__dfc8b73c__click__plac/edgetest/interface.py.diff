+_MULTI_VALUE_SEPARATOR = "\x1f"
+
+
+def _normalize_cli_args(args):
+    """Convert long-option spelling to plac's argument form."""
+    normalized = []
+    repeated = {"--extras": [], "--deps": [], "-d": []}
+    index = 0
+    while index < len(args):
+        value = args[index]
+        option, separator, inline_value = value.partition("=")
+        if option in repeated:
+            if separator:
+                repeated[option].append(inline_value)
+                index += 1
+                continue
+            if index + 1 < len(args) and not args[index + 1].startswith("-"):
+                repeated[option].append(args[index + 1])
+                index += 2
+                continue
+        if separator and option.startswith("-"):
+            normalized.extend((option, inline_value))
+        else:
+            normalized.append(value)
+        index += 1
+
+    for option, values in repeated.items():
+        if values:
+            normalized.extend(
+                (
+                    "--deps" if option == "-d" else option,
+                    _MULTI_VALUE_SEPARATOR.join(values),
+                )
+            )
+    return normalized
+
+
+def _call_cli(args=None, prog_name=None):
+    """Run plac's parser, optionally with an explicit argument list."""
+    original_argv = sys.argv
+    if args is None:
+        argv = list(sys.argv)
+    else:
+        argv = [prog_name or "edgetest"] + list(args)
+    sys.argv = [argv[0]] + _normalize_cli_args(argv[1:])
+    try:
+        return plac.call(cli)
+    finally:
+        sys.argv = original_argv
+
+
+def _cli_main(args=None, prog_name=None, **_kwargs):
+    """Expose a ``main`` method for callers that wrap command functions."""
+    return _call_cli(args=args, prog_name=prog_name)
+
+
+cli.name = "edgetest"
+cli.main = _cli_main
+
+
+def main():
+    """Parse command-line arguments and run the CLI."""
+    return _call_cli()
