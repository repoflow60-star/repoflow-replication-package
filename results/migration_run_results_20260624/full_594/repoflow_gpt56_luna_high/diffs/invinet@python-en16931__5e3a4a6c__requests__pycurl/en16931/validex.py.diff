+def _request(url, headers, payload=None, verify=True):
+    response_body = io.BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(
+            pycurl.HTTPHEADER,
+            ["{}: {}".format(name, value) for name, value in headers.items()],
+        )
+        curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+        if payload is None:
+            curl.setopt(pycurl.HTTPGET, 1)
+        else:
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, json.dumps(payload).encode('utf8'))
+        if not verify:
+            curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+            curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+    return status_code, json.loads(response_body.getvalue().decode('utf8'))
 
 
