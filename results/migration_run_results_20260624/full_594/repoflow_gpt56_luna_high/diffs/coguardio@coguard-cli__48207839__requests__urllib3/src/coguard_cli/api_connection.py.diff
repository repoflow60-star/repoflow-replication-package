 from coguard_cli.auth.token import Token
 from coguard_cli.util import replace_special_chars_with_underscore
 from coguard_cli.print_colors import COLOR_TERMINATION, \
     COLOR_RED
+
+HTTP = urllib3.PoolManager(retries=False)
+
+
+def _request(
+        method: str,
+        url: str,
+        headers=None,
+        data=None,
+        json_data=None,
+        timeout=None,
+        preload_content=True):
+    request_headers = dict(headers or {})
+    if json_data is not None:
+        data = json.dumps(json_data)
+        if not any(key.lower() == "content-type" for key in request_headers):
+            request_headers["Content-Type"] = "application/json"
+    elif isinstance(data, dict):
+        data = urllib.parse.urlencode(data, doseq=True)
+        if not any(key.lower() == "content-type" for key in request_headers):
+            request_headers["Content-Type"] = \
+                "application/x-www-form-urlencoded"
+    return HTTP.request(
+        method,
+        url,
+        headers=request_headers,
+        body=data,
+        timeout=timeout,
+        preload_content=preload_content)
+
+
+def _response_json(response):
+    return json.loads(response.data)
+
+
+def _response_text(response):
+    if isinstance(response.data, bytes):
+        return response.data.decode("utf-8")
+    return response.data
+
+
+def _raise_for_status(response):
+    if response.status >= 400:
+        raise urllib3.exceptions.HTTPError(
+            "HTTP status %s: %s" % (response.status, response.reason)
+        )
+
 
