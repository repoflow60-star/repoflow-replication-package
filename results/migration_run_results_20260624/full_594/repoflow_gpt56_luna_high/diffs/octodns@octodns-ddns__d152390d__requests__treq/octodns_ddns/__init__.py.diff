 # TODO: remove __VERSION__ with the next major version release
 __version__ = __VERSION__ = '0.2.1'
+
+
+class _TreqConnectionError(Exception):
+    pass
+
+
+class _TreqClient:
+    def __init__(self):
+        self.headers = {}
+
+    def get(self, url):
+        reactor = SelectReactor()
+        result = []
+        error = []
+
+        def received(response):
+            def content_received(content):
+                response.content = content
+                return response
+
+            return treq.content(response).addCallback(content_received)
+
+        def succeeded(response):
+            result.append(response)
+            reactor.stop()
+
+        def failed(failure):
+            error.append(failure)
+            reactor.stop()
+
+        headers = {
+            key: [value] if isinstance(value, str) else value
+            for key, value in self.headers.items()
+        }
+
+        def request():
+            try:
+                deferred = treq.get(
+                    url, headers=headers, agent=Agent(reactor)
+                )
+            except Exception as exc:
+                error.append(exc)
+                reactor.stop()
+                return
+            deferred.addCallback(received)
+            deferred.addCallbacks(succeeded, failed)
+
+        reactor.callWhenRunning(request)
+        reactor.run(installSignalHandlers=False)
+
+        if error:
+            failure = error[0]
+            if hasattr(failure, 'raiseException'):
+                try:
+                    failure.raiseException()
+                except Exception as exc:
+                    raise _TreqConnectionError() from exc
+            raise _TreqConnectionError() from failure
+        return result[0]
 
 
