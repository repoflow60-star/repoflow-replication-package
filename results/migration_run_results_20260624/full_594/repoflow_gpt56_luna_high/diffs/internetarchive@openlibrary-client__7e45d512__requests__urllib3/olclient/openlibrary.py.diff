+    def _request(self, method, url, data=None, headers=None, files=None, params=None):
+        """Send a request through urllib3 while retaining session cookies."""
+        request_headers = dict(headers or {})
+        if self.cookies and not any(
+            key.lower() == 'cookie' for key in request_headers
+        ):
+            request_headers['Cookie'] = '; '.join(
+                f'{name}={value}' for name, value in self.cookies.items()
+            )
+
+        if params:
+            query = urlencode(params, doseq=True)
+            separator = '&' if '?' in url else '?'
+            url = f'{url}{separator}{query}'
+
+        request_kwargs = {}
+        if request_headers:
+            request_kwargs['headers'] = request_headers
+        if files is not None:
+            request_kwargs['fields'] = files
+        elif isinstance(data, dict):
+            request_kwargs['fields'] = data
+            request_kwargs['encode_multipart'] = False
+        elif data is not None:
+            request_kwargs['body'] = data
+
+        request_method = getattr(self.session, method.lower())
+        response = request_method(url, **request_kwargs)
+
+        response_headers = getattr(response, 'headers', None)
+        cookie_headers = []
+        getlist = getattr(response_headers, 'getlist', None)
+        if callable(getlist):
+            values = getlist('Set-Cookie')
+            if isinstance(values, str):
+                cookie_headers = [values]
+            elif isinstance(values, (list, tuple)):
+                cookie_headers = list(values)
+        if not cookie_headers:
+            get_header = getattr(response_headers, 'get', None)
+            cookie_header = get_header('Set-Cookie') if callable(get_header) else None
+            if cookie_header:
+                cookie_headers = [cookie_header]
+        for cookie_header in cookie_headers:
+            cookie_pair = cookie_header.split(';', 1)[0]
+            if '=' in cookie_pair:
+                name, value = cookie_pair.split('=', 1)
+                self.cookies[name] = value
+        return response
+
+    @staticmethod
+    def _response_json(response):
+        response_json = getattr(response, 'json', None)
+        if callable(response_json):
+            return response_json()
+        return json.loads(response.data)
+
+    @staticmethod
+    def _raise_for_status(response):
+        raise_for_status = getattr(response, 'raise_for_status', None)
+        if callable(raise_for_status):
+            raise_for_status()
+        elif response.status >= 400:
+            error = urllib3.exceptions.HTTPError(
+                f'HTTP status {response.status}'
+            )
+            error.response = response
+            raise error
+
+    @staticmethod
+    def _response_url(response, fallback):
+        response_url = getattr(response, 'url', None)
+        if isinstance(response_url, str) and response_url:
+            return response_url
+        geturl = getattr(response, 'geturl', None)
+        if callable(geturl):
+            response_url = geturl()
+            if response_url:
+                return response_url
+        response_headers = getattr(response, 'headers', None)
+        get_header = getattr(response_headers, 'get', None)
+        location = get_header('Location') if callable(get_header) else None
+        if location:
+            return urljoin(fallback, location)
+        return fallback
