+# Keep the existing request seam while using aiohttp's session methods.
+requests = aiohttp.ClientSession
+
+
+class _ResponseData:
+    """Synchronous response data consumed by the existing model parsers."""
+
+    def __init__(self, status: int, text: str) -> None:
+        self.status_code = status
+        self.text = text
+
+    @property
+    def ok(self) -> bool:
+        return self.status_code < 400
+
+    def json(self):
+        return json.loads(self.text)
+
+
+def _request(method: str, url: str, headers: dict, timeout: Optional[float],
+             json_payload: Any = None) -> Any:
+    """Run one aiohttp request and return a synchronous response view."""
+
+    async def send_request() -> Any:
+        request_kwargs = {'headers': headers, 'timeout': timeout}
+        if json_payload is not None:
+            request_kwargs['json'] = json_payload
+
+        async with requests() as session:
+            request_context = getattr(session, method.lower())(url, **request_kwargs)
+            if not hasattr(request_context, '__aenter__'):
+                return request_context
+
+            async with request_context as response:
+                return _ResponseData(response.status, await response.text())
+
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(send_request())
+
+    result = []
+    error = []
+
+    def run_request() -> None:
+        try:
+            result.append(asyncio.run(send_request()))
+        except BaseException as exc:
+            error.append(exc)
+
+    thread = threading.Thread(target=run_request)
+    thread.start()
+    thread.join()
+    if error:
+        raise error[0]
+    return result[0]
 
 
