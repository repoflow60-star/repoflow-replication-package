+import treq
+from twisted.internet import reactor
 
 from .errors import ChessDotComClientError
 from .response_builder import DefaultResponseBuilder
+
+
+_treq_reactor_lock = threading.Lock()
+_treq_reactor_ready = threading.Event()
+_treq_reactor_started = False
+
+
+def _ensure_treq_reactor():
+    global _treq_reactor_started
+
+    if reactor.running:
+        return
+
+    with _treq_reactor_lock:
+        if not _treq_reactor_started:
+            _treq_reactor_started = True
+            reactor.callWhenRunning(_treq_reactor_ready.set)
+            threading.Thread(
+                target=reactor.run,
+                kwargs={"installSignalHandlers": False},
+                daemon=True,
+            ).start()
+
+    _treq_reactor_ready.wait()
+
+
+def _run_treq_request(request):
+    _ensure_treq_reactor()
+    result = Future()
+
+    def invoke_request():
+        try:
+            deferred = request()
+            deferred.addCallbacks(
+                result.set_result,
+                lambda failure: result.set_exception(failure.value),
+            )
+        except BaseException as error:
+            result.set_exception(error)
+
+    reactor.callFromThread(invoke_request)
+    return result.result()
+
+
+def _response_headers(response):
+    headers = response.headers
+    if not hasattr(headers, "getAllRawHeaders"):
+        return headers
+
+    def decode(value):
+        return value.decode("latin-1") if isinstance(value, bytes) else value
+
+    return {
+        decode(name): ", ".join(decode(value) for value in values)
+        for name, values in headers.getAllRawHeaders()
+    }
+
+
+def _response_text(response, body):
+    if not isinstance(body, bytes):
+        return body
+
+    encoding = "utf-8"
+    content_type = next(
+        (
+            value
+            for name, value in _response_headers(response).items()
+            if name.lower() == "content-type"
+        ),
+        "",
+    )
+    for parameter in content_type.split(";")[1:]:
+        name, separator, value = parameter.partition("=")
+        if separator and name.strip().lower() == "charset":
+            encoding = value.strip().strip('"')
+            break
+    return body.decode(encoding, errors="replace")
 
 
