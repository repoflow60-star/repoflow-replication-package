+def _run(coroutine: Coroutine[Any, Any, _T]) -> _T:
+    """Run an async operation while keeping this library's API synchronous."""
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coroutine)
+
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        return executor.submit(asyncio.run, coroutine).result()
+
+
+def response_json(response: Any) -> Any:
+    """Decode JSON from either a synchronous or asynchronous response."""
+    try:
+        result = response.json(content_type=None)
+    except TypeError:
+        result = response.json()
+    if isinstance(result, Awaitable):
+        return _run(result)
+    return result
 
 
