+    async def _read_response(self, response):
+        status = getattr(response, 'status', None)
+        if status is None:
+            status = getattr(response, 'status_code', None)
+
+        content = getattr(response, 'content', None)
+        if isinstance(content, (bytes, str)):
+            return status, content
+
+        read = getattr(response, 'read', None)
+        if callable(read):
+            content = read()
+            if inspect.isawaitable(content):
+                content = await content
+        else:
+            content = response.content
+        return status, content
+
+    async def _request_async(self, method, url, **kwargs):
+        if self.session is None:
+            aiohttp_kwargs = dict(kwargs)
+            if 'verify' in aiohttp_kwargs:
+                aiohttp_kwargs['ssl'] = aiohttp_kwargs.pop('verify')
+            aiohttp_kwargs.pop('stream', None)
+            async with aiohttp.ClientSession() as session:
+                request = getattr(session, method)
+                async with request(url, **aiohttp_kwargs) as response:
+                    return await self._read_response(response)
+
+        request_kwargs = kwargs
+        if isinstance(self.session, aiohttp.ClientSession):
+            request_kwargs = dict(kwargs)
+            if 'verify' in request_kwargs:
+                request_kwargs['ssl'] = request_kwargs.pop('verify')
+            request_kwargs.pop('stream', None)
+
+        request = getattr(self.session, method)
+        request_result = request(url, **request_kwargs)
+        if hasattr(request_result, '__aenter__'):
+            async with request_result as response:
+                return await self._read_response(response)
+        if inspect.isawaitable(request_result):
+            request_result = await request_result
+        try:
+            return await self._read_response(request_result)
+        finally:
+            close = getattr(request_result, 'close', None)
+            if callable(close):
+                close()
+
+    def _request(self, method, url, **kwargs):
+        return asyncio.run(self._request_async(method, url, **kwargs))
 
