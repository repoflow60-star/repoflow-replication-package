+class _HTTPClient:
+    """Expose the existing verb-based client calls on top of urllib3."""
+
+    def __init__(self):
+        self._pool = urllib3.PoolManager()
+
+    def get(self, url, headers=None, timeout=None):
+        return self._pool.request('GET', url, headers=headers, timeout=timeout,
+                                  retries=False)
+
+    def post(self, url, json=None, headers=None, timeout=None):
+        return self._pool.request('POST', url, body=self._json_body(json),
+                                  headers=self._json_headers(headers),
+                                  timeout=timeout, retries=False)
+
+    def put(self, url, json=None, headers=None, timeout=None):
+        return self._pool.request('PUT', url, body=self._json_body(json),
+                                  headers=self._json_headers(headers),
+                                  timeout=timeout, retries=False)
+
+    def delete(self, url, json=None, headers=None, timeout=None):
+        return self._pool.request('DELETE', url, body=self._json_body(json),
+                                  headers=self._json_headers(headers),
+                                  timeout=timeout, retries=False)
+
+    @staticmethod
+    def _json_body(payload):
+        return json.dumps(payload).encode('utf-8') if payload is not None else None
+
+    @staticmethod
+    def _json_headers(headers):
+        request_headers = dict(headers or {})
+        request_headers['Content-Type'] = 'application/json'
+        return request_headers
+
+
+http = _HTTPClient()
+requests = http
 
 
