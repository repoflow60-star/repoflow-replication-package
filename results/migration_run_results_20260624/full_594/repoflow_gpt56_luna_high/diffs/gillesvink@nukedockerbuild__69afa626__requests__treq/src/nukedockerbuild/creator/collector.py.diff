@@ -7,7 +7,11 @@
 import logging
 import re
 
-import requests
+import treq
+from twisted.internet import defer
+from twisted.internet.task import react
+
+requests = treq
 
 from nukedockerbuild.datamodel.constants import (
     JSON_DATA_SOURCE,
@@ -22,8 +26,31 @@
 
 def fetch_json_data() -> dict:
     """Fetch data from JSON on Github and return as dict."""
-    fetched_data = requests.get(JSON_DATA_SOURCE, timeout=10)
-    if fetched_data.status_code != 200:
+    fetched_data = treq.get(JSON_DATA_SOURCE, timeout=10)
+    if isinstance(fetched_data, defer.Deferred):
+        return react(lambda reactor: _read_json_data(fetched_data))
+    return _read_sync_json_data(fetched_data)
+
+
+@defer.inlineCallbacks
+def _read_json_data(fetched_data):
+    fetched_data = yield fetched_data
+    status_code = getattr(fetched_data, "code", None)
+    if status_code is None:
+        status_code = fetched_data.status_code
+    if status_code != 200:
+        msg = "Request returned 404. Please check the URL and try again."
+        raise ValueError(msg)
+    data = yield treq.json_content(fetched_data)
+    logger.info("Fetched JSON data containing Nuke releases.")
+    return data
+
+
+def _read_sync_json_data(fetched_data) -> dict:
+    status_code = getattr(fetched_data, "code", None)
+    if status_code is None:
+        status_code = fetched_data.status_code
+    if status_code != 200:
         msg = "Request returned 404. Please check the URL and try again."
         raise ValueError(msg)
     logger.info("Fetched JSON data containing Nuke releases.")
