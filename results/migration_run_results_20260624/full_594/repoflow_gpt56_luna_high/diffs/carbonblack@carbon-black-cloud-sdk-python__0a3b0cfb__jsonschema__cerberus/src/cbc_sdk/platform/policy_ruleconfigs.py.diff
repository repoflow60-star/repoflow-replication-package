+def _convert_json_schema_rule(schema):
+    """Convert one JSON Schema property into a Cerberus rule."""
+    if not isinstance(schema, dict):
+        raise ValueError("schema rule must be a mapping")
+
+    rule = {}
+    schema_type = schema.get('type')
+    if schema_type is None and 'properties' in schema:
+        schema_type = 'object'
+
+    if isinstance(schema_type, list):
+        nullable = 'null' in schema_type
+        schema_types = [item for item in schema_type if item != 'null']
+        if len(schema_types) == 1:
+            schema_type = schema_types[0]
+        elif schema_types:
+            rule['anyof'] = [
+                {'type': _CERBERUS_TYPES.get(item, item)} for item in schema_types
+            ]
+            schema_type = None
+        else:
+            schema_type = None
+        if nullable:
+            rule['nullable'] = True
+
+    if schema_type is not None:
+        if schema_type not in _CERBERUS_TYPES:
+            raise ValueError(f"'{schema_type}' is not valid under any of the given schemas")
+        rule['type'] = _CERBERUS_TYPES[schema_type]
+
+    if schema.get('enum') is not None:
+        rule['allowed'] = schema['enum']
+
+    if schema.get('pattern') is not None:
+        rule['regex'] = schema['pattern']
+    if schema.get('minLength') is not None:
+        rule['minlength'] = schema['minLength']
+    if schema.get('maxLength') is not None:
+        rule['maxlength'] = schema['maxLength']
+    if schema.get('minimum') is not None:
+        rule['min'] = schema['minimum']
+    if schema.get('maximum') is not None:
+        rule['max'] = schema['maximum']
+    if schema.get('minItems') is not None:
+        rule['minlength'] = schema['minItems']
+    if schema.get('maxItems') is not None:
+        rule['maxlength'] = schema['maxItems']
+
+    if schema_type == 'object' or 'properties' in schema:
+        rule['type'] = 'dict'
+        rule['schema'], rule['allow_unknown'] = _convert_json_schema_object(schema)
+    elif schema_type == 'array' and isinstance(schema.get('items'), dict):
+        rule['schema'] = _convert_json_schema_rule(schema['items'])
+
+    return rule
+
