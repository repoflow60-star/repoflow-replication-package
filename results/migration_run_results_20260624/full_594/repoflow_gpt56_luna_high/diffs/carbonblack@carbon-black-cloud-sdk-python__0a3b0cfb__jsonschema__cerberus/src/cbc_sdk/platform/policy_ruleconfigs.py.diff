+def _convert_json_schema_object(schema):
+    """Convert the properties and unknown-field policy of a JSON object schema."""
+    properties = schema.get('properties', {})
+    if not isinstance(properties, dict):
+        raise ValueError("schema properties must be a mapping")
+
+    required = schema.get('required', [])
+    if not isinstance(required, list):
+        raise ValueError("schema required fields must be a list")
+
+    converted = {}
+    for name, property_schema in properties.items():
+        converted[name] = _convert_json_schema_rule(property_schema)
+        if name in required:
+            converted[name]['required'] = True
+
+    additional_properties = schema.get('additionalProperties', True)
+    if isinstance(additional_properties, dict):
+        additional_properties = _convert_json_schema_rule(additional_properties)
+    elif not isinstance(additional_properties, bool):
+        raise ValueError("schema additionalProperties must be a boolean or mapping")
+    return converted, additional_properties
+
+
+def _json_schema_type_matches(value, schema_type):
+    """Return whether a value satisfies a JSON Schema type name."""
+    if schema_type == 'null':
+        return value is None
+    if schema_type == 'boolean':
+        return isinstance(value, bool)
+    if schema_type == 'integer':
+        return isinstance(value, int) and not isinstance(value, bool)
+    if schema_type == 'number':
+        return isinstance(value, (int, float)) and not isinstance(value, bool)
+    if schema_type == 'string':
+        return isinstance(value, str)
+    if schema_type == 'array':
+        return isinstance(value, list)
+    if schema_type == 'object':
+        return isinstance(value, dict)
+    return True
+
+
+def _json_schema_error_message(value, schema):
+    """Format common Cerberus failures using the SDK's former JSON Schema wording."""
+    schema_type = schema.get('type')
+    schema_types = schema_type if isinstance(schema_type, list) else [schema_type]
+    if schema_type is not None and not any(_json_schema_type_matches(value, item) for item in schema_types):
+        expected = " or ".join(f"'{item}'" for item in schema_types)
+        return f"{value!r} is not of type {expected}"
+
+    if schema.get('enum') is not None and value not in schema['enum']:
+        return f"{value!r} is not one of {schema['enum']!r}"
+
+    if isinstance(value, dict):
+        for name in schema.get('required', []):
+            if name not in value:
+                return f"'{name}' is a required property"
+        for name, property_schema in schema.get('properties', {}).items():
+            if name in value:
+                message = _json_schema_error_message(value[name], property_schema)
+                if message is not None:
+                    return message
+    elif isinstance(value, list) and isinstance(schema.get('items'), dict):
+        for item in value:
+            message = _json_schema_error_message(item, schema['items'])
+            if message is not None:
+                return message
+
+    return None
 
 
