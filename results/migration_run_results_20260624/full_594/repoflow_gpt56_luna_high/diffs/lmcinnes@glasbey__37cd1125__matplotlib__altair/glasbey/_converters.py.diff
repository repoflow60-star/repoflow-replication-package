+            try:
+                color = tuple(int(digits[index:index + 2], 16) for index in (0, 2, 4))
+                if len(digits) == 8:
+                    color += (int(digits[6:8], 16),)
+            except ValueError as exc:
+                raise ValueError(f"Invalid color value {color}") from exc
+        elif value.startswith("rgb(") and value.endswith(")"):
+            try:
+                color = tuple(float(channel.strip()) for channel in value[4:-1].split(","))
+            except ValueError as exc:
+                raise ValueError(f"Invalid color value {color}") from exc
+        else:
+            raise ValueError(f"Invalid color value {color}")
