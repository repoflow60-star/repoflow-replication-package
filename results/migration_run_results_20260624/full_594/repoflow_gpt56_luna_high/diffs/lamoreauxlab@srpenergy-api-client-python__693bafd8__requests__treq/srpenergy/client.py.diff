+from twisted.internet import defer, reactor
+from twisted.internet.threads import blockingCallFromThread
+import treq
 
 BASE_USAGE_URL = "https://myaccount.srpnet.com/myaccountapi/api/"
+
+_reactor_lock = threading.Lock()
+_reactor_ready = threading.Event()
+_reactor_thread = None
+
+
+def _start_reactor():
+    """Run the Twisted reactor used by the synchronous public API."""
+    global _reactor_thread  # pylint: disable=global-statement
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if reactor.running:
+            return
+
+        if _reactor_thread is None:
+
+            def run_reactor():
+                reactor.callWhenRunning(_reactor_ready.set)
+                reactor.run(installSignalHandlers=False)
+
+            _reactor_thread = threading.Thread(
+                target=run_reactor,
+                name="srpenergy-treq-reactor",
+                daemon=True,
+            )
+            _reactor_thread.start()
+
+    _reactor_ready.wait()
+
+
+def _run_deferred(operation):
+    """Execute a Deferred without changing the client's synchronous API."""
+    _start_reactor()
+    return blockingCallFromThread(reactor, operation)
+
+
+def _cookie_header(response, current=""):
+    """Merge response cookies into the Cookie header for the next request."""
+    cookies = SimpleCookie()
+    if current:
+        cookies.load(current)
+
+    for raw_cookie in response.headers.getRawHeaders(b"set-cookie") or []:
+        if isinstance(raw_cookie, bytes):
+            raw_cookie = raw_cookie.decode("latin-1")
+        cookies.load(raw_cookie)
+
+    return "; ".join(
+        f"{name}={morsel.value}" for name, morsel in cookies.items()
+    )
+
+
+@defer.inlineCallbacks
+def _validate_request(username, password):
+    """Perform the credential request with treq."""
+    response = yield treq.post(
