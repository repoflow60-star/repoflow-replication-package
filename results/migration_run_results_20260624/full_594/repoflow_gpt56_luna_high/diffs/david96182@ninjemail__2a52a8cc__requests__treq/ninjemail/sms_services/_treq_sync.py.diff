--- a/ninjemail/sms_services/_treq_sync.py
+++ b/ninjemail/sms_services/_treq_sync.py
@@ -0,0 +1,73 @@
+import threading
+
+from twisted.internet import reactor
+
+
+_reactor_lock = threading.Lock()
+_reactor_ready = threading.Event()
+_reactor_thread = None
+
+
+def _start_reactor():
+    global _reactor_thread
+
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is None:
+            def run_reactor():
+                reactor.callWhenRunning(_reactor_ready.set)
+                reactor.run(installSignalHandlers=False)
+
+            _reactor_thread = threading.Thread(
+                target=run_reactor,
+                name="ninjemail-treq-reactor",
+                daemon=True,
+            )
+            _reactor_thread.start()
+
+    _reactor_ready.wait()
+
+
+def run(operation):
+    """Resolve a treq Deferred while retaining the service's sync API."""
+    _start_reactor()
+
+    finished = threading.Event()
+    value = []
+    error = []
+
+    def invoke():
+        try:
+            deferred = operation()
+        except BaseException as exc:
+            error.append(exc)
+            finished.set()
+            return
+
+        if not hasattr(deferred, "addCallbacks"):
+            value.append(deferred)
+            finished.set()
+            return
+
+        def succeeded(result):
+            value.append(result)
+            finished.set()
+            return result
+
+        def failed(failure):
+            error.append(failure)
+            finished.set()
+            return None
+
+        deferred.addCallbacks(succeeded, failed)
+
+    reactor.callFromThread(invoke)
+    finished.wait()
+
+    if error:
+        failure = error[0]
+        if hasattr(failure, "raiseException"):
+            failure.raiseException()
+        raise failure
+    return value[0]
