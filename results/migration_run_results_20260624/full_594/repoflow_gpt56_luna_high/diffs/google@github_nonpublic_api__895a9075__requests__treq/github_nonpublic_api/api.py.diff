+_reactor_lock = threading.Lock()
+_reactor_ready = threading.Event()
+_reactor_thread = None
+
+
+def _start_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _reactor_thread
+
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if not reactor.running and _reactor_thread is None:
+            _reactor_ready.clear()
+            _reactor_thread = threading.Thread(
+                target=_start_reactor, name="github-nonpublic-treq-reactor", daemon=True
+            )
+            _reactor_thread.start()
+    _reactor_ready.wait()
+
+
+def _wait_for_deferred(operation):
+    """Run a treq operation without changing this module's synchronous API."""
+    _ensure_reactor()
+    completed = threading.Event()
+    result = []
+
+    def _run_operation():
+        try:
+            deferred = operation()
+        except BaseException as error:
+            result.append(error)
+            completed.set()
+            return
+
+        def _complete(value):
+            result.append(value)
+            completed.set()
+            return value
+
+        deferred.addBoth(_complete)
+
+    reactor.callFromThread(_run_operation)
+    completed.wait()
+    value = result[0]
+    if isinstance(value, Failure):
+        value.raiseException()
+    if isinstance(value, BaseException):
+        raise value
+    return value
+
+
+def _response_url(response, fallback):
+    request = getattr(response, "request", None)
+    url = getattr(request, "absoluteURI", None)
+    if isinstance(url, bytes):
+        url = url.decode("ascii")
+    return url or fallback
+
+
+class _ResponseInfo:
+    def __init__(self, url):
+        self.url = url
+
+
+class TreqResponse:
+    """Synchronous response view over a response returned by treq."""
+
+    def __init__(self, response, url):
+        self._response = response
+        self.status_code = response.code
+        self.url = _response_url(response, url)
+        self.history = []
+        previous = getattr(response, "previousResponse", None)
+        while previous is not None:
+            self.history.append(_ResponseInfo(_response_url(previous, url)))
+            previous = getattr(previous, "previousResponse", None)
+        self.headers = response.headers
+        self.content = _wait_for_deferred(lambda: treq.content(response))
+        self.text = self.content.decode("utf-8", errors="replace")
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise RuntimeError("HTTP request failed with status %s" % self.status_code)
+
+
+class TreqSession:
+    """Synchronous session backed by treq with persistent cookies and redirects."""
+
+    def __init__(self):
+        self.cookies = CookieJar()
+        self._agent = None
+
+    def _get_agent(self):
+        if self._agent is None:
+            self._agent = RedirectAgent(CookieAgent(Agent(reactor), self.cookies))
+        return self._agent
+
+    def _request(self, method, url, data=None):
+        response = _wait_for_deferred(
+            lambda: treq.request(method, url, agent=self._get_agent(), data=data)
+        )
+        return TreqResponse(response, url)
+
+    def get(self, url):
+        return self._request("GET", url)
+
+    def post(self, url, data=None):
+        return self._request("POST", url, data=data)
 
 
