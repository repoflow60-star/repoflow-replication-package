+def _request(method: str, url: str, timeout: int, data=None):
+    """Make an aiohttp request while retaining the synchronous token API."""
+    async def make_request():
+        client_timeout = aiohttp.ClientTimeout(total=timeout)
+        async with aiohttp.ClientSession(timeout=client_timeout) as session:
+            async with session.request(method, url, data=data) as response:
+                return response.status, response.reason, await response.read()
+
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(make_request())
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        return executor.submit(asyncio.run, make_request()).result()
 
 class Token():
