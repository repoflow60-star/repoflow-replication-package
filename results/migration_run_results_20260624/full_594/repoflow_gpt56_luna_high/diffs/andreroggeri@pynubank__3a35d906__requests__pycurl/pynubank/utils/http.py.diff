+class HttpResponse:
+    def __init__(self, status_code, url, headers, content):
+        self.status_code = status_code
+        self.url = url
+        self.headers = headers
+        self.content = content
+
+    def json(self):
+        return json_lib.loads(self.content.decode('utf-8'))
+
+
+def _request(url, method, headers, payload=None, cert_data=None, cert_password=''):
+    body = BytesIO()
+    response_headers = {}
+
+    def capture_header(line):
+        line = line.decode('iso-8859-1').strip()
+        if ':' in line:
+            name, value = line.split(':', 1)
+            response_headers[name.strip()] = value.strip()
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.HTTPHEADER, [f'{name}: {value}' for name, value in (headers or {}).items()])
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, capture_header)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+
+        if method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, json_lib.dumps(payload).encode('utf-8'))
+        else:
+            curl.setopt(pycurl.HTTPGET, 1)
+
+        if cert_data:
+            curl.setopt(pycurl.SSLCERTTYPE, 'P12')
+            curl.setopt(pycurl.SSLCERT_BLOB, cert_data)
+            curl.setopt(pycurl.KEYPASSWD, cert_password)
+
+        curl.perform()
+        return HttpResponse(
+            curl.getinfo(pycurl.RESPONSE_CODE),
+            curl.getinfo(pycurl.EFFECTIVE_URL),
+            response_headers,
+            body.getvalue(),
+        )
+    finally:
+        curl.close()
+
+
+def get(url, headers=None, pkcs12_data=None, pkcs12_password=''):
+    return _request(url, 'GET', headers, cert_data=pkcs12_data, cert_password=pkcs12_password)
+
+
+def post(url, json=None, headers=None, pkcs12_data=None, pkcs12_password=''):
+    return _request(url, 'POST', headers, payload=json, cert_data=pkcs12_data, cert_password=pkcs12_password)
 
 
