+_reactor_lock = threading.Lock()
+_reactor_thread = None
+
+
+def _start_reactor() -> None:
+    """Run the Twisted reactor used by the synchronous public API."""
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor() -> None:
+    """Start a reusable reactor when the caller is not already running one."""
+    global _reactor_thread
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if not reactor.running and _reactor_thread is None:
+            _reactor_thread = threading.Thread(
+                target=_start_reactor,
+                name="wikipediaapi-treq-reactor",
+                daemon=True,
+            )
+            _reactor_thread.start()
+
+
+def _wait_for_deferred(operation):
+    """Execute a Deferred from synchronous package methods."""
+    _ensure_reactor()
+
+    result = []
+    error = []
+    finished = threading.Event()
+
+    def succeeded(value):
+        result.append(value)
+        finished.set()
+        return value
+
+    def failed(failure: Failure):
+        error.append(failure)
+        finished.set()
+        return failure
+
+    def invoke():
+        defer.maybeDeferred(operation).addCallbacks(succeeded, failed)
+
+    reactor.callFromThread(invoke)
+    finished.wait()
+
+    if error:
+        error[0].raiseException()
+    return result[0]
 
 
