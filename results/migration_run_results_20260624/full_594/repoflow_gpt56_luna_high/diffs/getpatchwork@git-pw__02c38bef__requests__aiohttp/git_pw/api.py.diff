+class _Response:
+    """Synchronous response view used by the existing API wrappers."""
+
+    def __init__(
+        self,
+        status_code: int,
+        headers: ty.Mapping[str, str],
+        content: bytes,
+    ) -> None:
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+
+    def json(self) -> ty.Any:
+        return json.loads(self.content.decode('utf-8'))
+
+    def iter_content(self, chunk_size: int) -> ty.Iterator[bytes]:
+        for offset in range(0, len(self.content), chunk_size):
+            yield self.content[offset:offset + chunk_size]
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            raise _HTTPError(self)
+
+
+class _HTTPError(aiohttp.ClientError):
+    def __init__(self, response: _Response) -> None:
+        super().__init__('HTTP status {}'.format(response.status_code))
+        self.response = response
+
+
+async def _request_async(
+    method: str,
+    url: str,
+    *,
+    auth: ty.Optional[ty.Union[HTTPTokenAuth, aiohttp.BasicAuth]],
+    headers: ty.Mapping[str, str],
+    params: ty.Optional[Filters] = None,
+    data: ty.Optional[ty.List[ty.Tuple[str, ty.Any]]] = None,
+) -> _Response:
+    request_headers = dict(headers)
+    if isinstance(auth, HTTPTokenAuth):
+        auth(request_headers)
+        auth = None
+
+    async with aiohttp.ClientSession() as session:
+        async with session.request(
+            method,
+            url,
+            auth=auth,
+            headers=request_headers,
+            params=params,
+            data=data,
+        ) as response:
+            content = await response.read()
+            return _Response(response.status, response.headers, content)
+
+
+def _request(
+    method: str,
+    url: str,
+    *,
+    auth: ty.Optional[ty.Union[HTTPTokenAuth, aiohttp.BasicAuth]],
+    headers: ty.Mapping[str, str],
+    params: ty.Optional[Filters] = None,
+    data: ty.Optional[ty.List[ty.Tuple[str, ty.Any]]] = None,
+) -> _Response:
+    return asyncio.run(
+        _request_async(
+            method,
+            url,
+            auth=auth,
+            headers=headers,
+            params=params,
+            data=data,
+        )
+    )
+
