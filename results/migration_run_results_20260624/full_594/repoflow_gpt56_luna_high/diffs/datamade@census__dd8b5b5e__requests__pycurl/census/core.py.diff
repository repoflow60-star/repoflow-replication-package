+class CurlResponse(object):
+    def __init__(self, body, status_code):
+        self.content = body
+        self.status_code = status_code
+
+    @property
+    def text(self):
+        return self.content.decode('utf-8', errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+
+class CurlSession(object):
+    def __init__(self, *args, **kwargs):
+        self.headers = kwargs.pop('headers', None) or {}
+        if args or kwargs:
+            raise TypeError('CurlSession does not accept positional or unknown arguments')
+        self._curl = None
+
+    def get(self, url, params=None):
+        if params:
+            query = urlencode(params, doseq=True)
+            url = '{}{}{}'.format(url, '&' if '?' in url else '?', query)
+
+        body = BytesIO()
+        if self._curl is None:
+            self._curl = pycurl.Curl()
+
+        self._curl.setopt(pycurl.URL, url)
+        self._curl.setopt(pycurl.WRITEDATA, body)
+        self._curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        self._curl.setopt(pycurl.ACCEPT_ENCODING, '')
+        if self.headers:
+            self._curl.setopt(
+                pycurl.HTTPHEADER,
+                ['{}: {}'.format(key, value) for key, value in self.headers.items()]
+            )
+        else:
+            self._curl.setopt(pycurl.HTTPHEADER, [])
+
+        self._curl.perform()
+        status_code = self._curl.getinfo(pycurl.RESPONSE_CODE)
+        return CurlResponse(body.getvalue(), status_code)
+
+    def close(self):
+        if self._curl is not None:
+            self._curl.close()
