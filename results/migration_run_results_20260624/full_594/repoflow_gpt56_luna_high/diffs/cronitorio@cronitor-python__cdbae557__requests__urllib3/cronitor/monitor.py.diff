+class _Urllib3Session(object):
+    def __init__(self, retries, backoff_factor):
+        retry = Retry(
+            total=retries,
+            read=retries,
+            connect=retries,
+            backoff_factor=backoff_factor,
+        )
+        self._pool = urllib3.PoolManager(retries=retry)
+
+    def request(self, method, url, params=None, data=None, headers=None,
+                auth=None, timeout=None):
+        if params is not None:
+            params = {
+                key: value
+                for key, value in params.items()
+                if value is not None
+            }
+        return self._pool.request(
+            method=method,
+            url=url,
+            fields=params,
+            body=data,
+            headers=_request_headers(headers, auth=auth),
+            timeout=timeout,
+        )
+
+    def get(self, url, params=None, headers=None, auth=None, timeout=None):
+        return self.request(
