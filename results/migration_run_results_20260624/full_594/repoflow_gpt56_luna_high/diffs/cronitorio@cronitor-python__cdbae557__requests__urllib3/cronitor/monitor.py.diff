+def _request_headers(headers=None, auth=None):
+    result = {
+        key: value
+        for key, value in (headers or {}).items()
+        if value is not None
+    }
+    if auth is not None:
+        result.update(make_headers(basic_auth='{}:{}'.format(*auth)))
+    return result
