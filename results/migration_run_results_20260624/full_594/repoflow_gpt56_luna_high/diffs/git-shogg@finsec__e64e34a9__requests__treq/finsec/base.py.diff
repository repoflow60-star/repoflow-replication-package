+
+_reactor_started = threading.Event()
+_reactor_start_lock = threading.Lock()
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_started.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    if reactor.running:
+        return
+    with _reactor_start_lock:
+        if not reactor.running:
+            threading.Thread(target=_run_reactor, daemon=True).start()
+    _reactor_started.wait()
+
+
+@inlineCallbacks
+def _request_content(url, headers):
+    response = yield treq.get(url, headers=headers)
+    content = yield treq.content(response)
+    returnValue(content)
+
+
+def _get_response_content(url, headers):
+    """Fetch response bytes through treq without changing the public sync API."""
+    _ensure_reactor()
+    request_headers = Headers({name: [value] for name, value in headers.items()})
+    return threads.blockingCallFromThread(
+        reactor, _request_content, url, request_headers
+    )
 
