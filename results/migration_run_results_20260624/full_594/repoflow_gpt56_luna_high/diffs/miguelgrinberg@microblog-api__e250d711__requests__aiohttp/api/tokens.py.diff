+async def _oauth2_response(request_context):
+    if inspect.isawaitable(request_context):
+        async with request_context as response:
+            if response.status != 200:
+                return False, None
+            return True, await response.json()
+    if request_context.status_code != 200:
+        return False, None
+    response_data = request_context.json()
+    if inspect.isawaitable(response_data):
+        response_data = await response_data
+    return True, response_data
+
+
+async def _oauth2_exchange(provider_data, args, redirect_uri):
+    async with aiohttp.ClientSession() as client:
+        token_response_ok, token_data = await _oauth2_response(client.post(
+            provider_data['access_token_url'], data={
+                'client_id': provider_data['client_id'],
+                'client_secret': provider_data['client_secret'],
+                'code': args['code'],
+                'grant_type': 'authorization_code',
+                'redirect_uri': redirect_uri,
+            }, headers={'Accept': 'application/json'}))
+        if not token_response_ok:
+            return None, None
+        oauth2_token = token_data.get('access_token')
+        if not oauth2_token:
+            return None, None
+
+        user_response_ok, user_data = await _oauth2_response(client.get(
+            provider_data['get_user']['url'], headers={
+                'Authorization': 'Bearer ' + oauth2_token,
+                'Accept': 'application/json',
+            }))
+        if not user_response_ok:
+            return None, None
+    return oauth2_token, user_data
+
+
