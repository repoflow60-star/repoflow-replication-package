+class _Headers(dict):
+    """A case-insensitive mapping for response headers."""
+
+    def get(self, key, default=None):
+        for header, value in self.items():
+            if header.lower() == key.lower():
+                return value
+        return default
+
+
+class _TreqResponse:
+    """Synchronous response facade used by the existing API functions."""
+
+    def __init__(self, status_code: int, headers: _Headers, content: bytes):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+
+    def json(self):
+        import json
+
+        return json.loads(self.content.decode('utf-8'))
+
+    def iter_content(self, chunk_size: int):
+        for offset in range(0, len(self.content), chunk_size):
+            yield self.content[offset:offset + chunk_size]
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            raise _RequestError(self)
+
+
+class _RequestError(Exception):
+    def __init__(self, response: ty.Optional[_TreqResponse], message=None):
+        self.response = response
+        super().__init__(message or 'HTTP request failed')
+
+
