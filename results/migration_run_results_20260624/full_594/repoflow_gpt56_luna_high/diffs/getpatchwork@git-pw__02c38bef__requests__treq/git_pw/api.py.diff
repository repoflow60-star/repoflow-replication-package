+_REACTOR_LOCK = threading.Lock()
+_REACTOR_THREAD: ty.Optional[threading.Thread] = None
+
+
+def _start_reactor() -> None:
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor() -> None:
+    global _REACTOR_THREAD
+
+    if reactor.running:
+        return
+
+    with _REACTOR_LOCK:
+        if reactor.running:
+            return
+
+        if _REACTOR_THREAD is None or not _REACTOR_THREAD.is_alive():
+            _REACTOR_THREAD = threading.Thread(
+                target=_start_reactor,
+                name='git-pw-treq-reactor',
+                daemon=True,
+            )
+            _REACTOR_THREAD.start()
+
+
+def _run_deferred(factory: ty.Callable[[], ty.Any]) -> ty.Any:
+    """Run a treq Deferred while retaining the API's synchronous contract."""
+    complete = threading.Event()
+    result = []
+
+    def finish(success: bool, value: ty.Any) -> None:
+        result.append((success, value))
+        complete.set()
+
+    def invoke() -> None:
+        try:
+            deferred = factory()
+        except BaseException as exc:
+            finish(False, exc)
+            return
+
+        def succeeded(value):
+            finish(True, value)
+            return value
+
+        def failed(failure):
+            try:
+                failure.raiseException()
+            except BaseException as exc:
+                finish(False, exc)
+            return None
+
+        deferred.addCallbacks(succeeded, failed)
+
+    _ensure_reactor()
+    reactor.callFromThread(invoke)
+    complete.wait()
+
+    success, value = result[0]
+    if not success:
+        raise value
+    return value
+
+
+def _response_headers(response) -> _Headers:
+    headers = _Headers()
+    for name, values in response.headers.getAllRawHeaders():
+        header = name.decode('latin-1')
+        headers[header] = ', '.join(
+            value.decode('latin-1') for value in values
+        )
+    return headers
+
+
+def _request(
+    method: str,
+    url: str,
+    params: ty.Optional[Filters] = None,
+    data: ty.Optional[ty.List[ty.Tuple[str, ty.Any]]] = None,
+    auth_optional: bool = False,
+) -> _TreqResponse:
+    headers = _get_headers()
+    auth = _get_auth(optional=auth_optional)
+    if auth:
+        auth(headers)
+
+    def request():
+        deferred = treq.request(
+            method,
+            url,
+            headers=headers,
+            params=params,
+            data=data,
+        )
+
+        def collect(response):
+            chunks = []
+            collected = treq.collect(response, chunks.append)
+            return collected.addCallback(
+                lambda _: _TreqResponse(
+                    response.code,
+                    _response_headers(response),
+                    b''.join(chunks),
+                )
+            )
+
+        return deferred.addCallback(collect)
+
+    try:
+        return _run_deferred(request)
+    except _RequestError:
+        raise
+    except Exception as exc:
+        raise _RequestError(None, str(exc)) from exc
+
