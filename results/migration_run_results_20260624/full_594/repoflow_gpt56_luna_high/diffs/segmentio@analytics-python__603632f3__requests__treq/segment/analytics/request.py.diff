+class _ResponseHeaders(object):
+    def __init__(self, headers):
+        self._headers = headers
+
+    def get(self, name, default=None):
+        values = self._headers.getRawHeaders(name)
+        if not values:
+            return default
+        value = values[0]
+        if isinstance(value, bytes):
+            return value.decode('latin1')
+        return value
+
+
+class _Response(object):
+    """Expose the response attributes used by the synchronous API."""
+
+    def __init__(self, response, content):
+        self.status_code = response.code
+        self.headers = _ResponseHeaders(response.headers)
+        self.reason = response.phrase
+        if isinstance(self.reason, bytes):
+            self.reason = self.reason.decode('latin1')
+        self.content = content
+        self.text = content.decode('utf-8', errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _reactor_thread
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is None:
+            _reactor_thread = Thread(target=_run_reactor)
+            _reactor_thread.daemon = True
+            _reactor_thread.start()
+    _reactor_ready.wait()
+
+
+def _request(method, url, data, headers, timeout):
+    """Perform a treq request while retaining the library's sync API."""
+    if isinstance(data, str):
+        data = data.encode('utf-8')
+    _ensure_reactor()
+    if _reactor_thread and get_ident() == _reactor_thread.ident:
+        raise RuntimeError('synchronous requests cannot run on the reactor thread')
+
+    def make_request():
+        producer = FileBodyProducer(BytesIO(data))
+        request_headers = Headers({name: [value] for name, value in headers.items()})
+        deferred = treq.request(
+            method,
+            url,
+            headers=request_headers,
+            bodyProducer=producer,
+            timeout=timeout,
+        )
+
+        def read_content(response):
+            return response.content().addCallback(
+                lambda content: _Response(response, content))
+
+        return deferred.addCallback(read_content)
+
+    return blockingCallFromThread(reactor, make_request)
 
 
