+def _render_table(rows: List[List[Any]], headers: List[str], tablefmt: str) -> str:
+    """Render the supported report formats using Rich table data."""
+    table = Table(
+        box=box.SIMPLE,
+        padding=(0, 1),
+        pad_edge=False,
+        show_edge=False,
+    )
+    for header in headers:
+        table.add_column(str(header))
+
+    string_rows = []
+    for row in rows:
+        string_row = [str(cell) for cell in row]
+        table.add_row(*string_row)
+        string_rows.append(string_row)
+
+    string_headers = [column.header for column in table.columns]
+    if tablefmt == "github":
+        widths = [
+            max(
+                len(string_headers[index]),
+                *(len(row[index]) for row in string_rows),
+            )
+            + 2
+            for index in range(len(string_headers))
+        ]
+        formatted_rows = [
+            "|"
+            + "|".join(
+                f" {cell.ljust(width - 2)} "
+                for cell, width in zip(row, widths)
+            )
+            + "|"
+            for row in [string_headers, *string_rows]
+        ]
+        separator = "|" + "|".join("-" * width for width in widths) + "|"
+        return "\n".join([formatted_rows[0], separator, *formatted_rows[1:]])
+
+    widths = [
+        max(
+            len(string_headers[index]) + 2,
+            *(len(row[index]) for row in string_rows),
+        )
+        for index in range(len(string_headers))
+    ]
+    separator = "  ".join("=" * width for width in widths)
+    formatted_rows = [
+        "  ".join(cell.ljust(width) for cell, width in zip(row, widths)).rstrip()
+        for row in [string_headers, *string_rows]
+    ]
+    return "\n".join([separator, formatted_rows[0], separator, *formatted_rows[1:], separator])
+
+
+# Keep the module-level entry point used by existing integrations.
+def tabulate(rows: List[List[Any]], headers: List[str], tablefmt: str) -> str:
+    """Render a report table through Rich while retaining legacy layouts."""
+    return _render_table(rows, headers, tablefmt)
 
 
