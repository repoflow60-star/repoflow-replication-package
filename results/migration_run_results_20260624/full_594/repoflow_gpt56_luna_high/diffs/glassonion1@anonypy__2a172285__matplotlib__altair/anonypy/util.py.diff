+def get_partition_chart(
+    df, partitions, column_x, column_y, indexes, offsets=[0.1, 0.1]
+):
+    """Build an Altair chart showing the bounds of each partition."""
+    rects = get_partition_rects(
+        df, partitions, column_x, column_y, indexes, offsets=offsets
+    )
+    values = [
+        {"x": left[0], "x2": right[0], "y": left[1], "y2": right[1]}
+        for left, right in rects
+    ]
+    return alt.Chart(values).mark_rect(fillOpacity=0.15).encode(
+        x=alt.X("x:Q", title=column_x),
+        x2=alt.X2("x2:Q"),
+        y=alt.Y("y:Q", title=column_y),
+        y2=alt.Y2("y2:Q"),
+    )
+
