+def _config(name, cast, default):
+    value = os.getenv(name)
+    if value is None:
+        return default
+    if cast is bool:
+        return value.lower() in {"1", "true", "yes", "on"}
+    return cast(value)
+
+
+REDIS_HOST = _config('REDIS_HOST', str, '0.0.0.0')
