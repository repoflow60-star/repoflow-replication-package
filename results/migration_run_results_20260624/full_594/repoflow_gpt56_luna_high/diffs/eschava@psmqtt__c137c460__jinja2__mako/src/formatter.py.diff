+def _split_filters(expression: str) -> List[str]:
+    parts = []
+    start = 0
+    depth = 0
+    quote = None
+    escaped = False
+
+    for i, char in enumerate(expression):
+        if quote is not None:
+            if escaped:
+                escaped = False
+            elif char == '\\':
+                escaped = True
+            elif char == quote:
+                quote = None
+        elif char in ('"', "'"):
+            quote = char
+        elif char in '([{':
+            depth += 1
+        elif char in ')]}':
+            depth -= 1
+        elif char == '|' and depth == 0:
+            parts.append(expression[start:i].strip())
+            start = i + 1
+
+    parts.append(expression[start:].strip())
+    return parts
+
+
+def _mako_expression(expression: str, filters: Dict[str, Any]) -> str:
+    parts = _split_filters(expression)
+    result = parts[0]
+
+    for filter_expression in parts[1:]:
+        opening = filter_expression.find('(')
+        if opening == -1:
+            name = filter_expression
+            arguments = ''
+        else:
+            name = filter_expression[:opening].strip()
+            arguments = filter_expression[opening + 1:-1].strip()
+
+        function = ("_formatter_filters[%r]" % name
+                    if name in filters else name)
+        if arguments:
+            result = "%s(%s, %s)" % (function, result, arguments)
+        else:
+            result = "%s(%s)" % (function, result)
+
+    return result
+
+
+def _mako_template(template: str, filters: Dict[str, Any]) -> str:
+    return re.sub(
+        r'\{\{(.*?)\}\}',
+        lambda match: '${%s}' % _mako_expression(match.group(1), filters),
+        template,
+        flags=re.DOTALL,
+    )
 
