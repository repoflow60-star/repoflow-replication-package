+    def _execute_request(self, method: str, url: str, params: Dict[str, Union[str, List[str]]], headers: Dict[str, str], json: Dict[str, Any]) -> _CurlResponse:
+        if params:
+            url += ('&' if '?' in url else '?') + urlencode(params, doseq=True)
+
+        response_body = io.BytesIO()
+        response_headers: Dict[str, str] = {}
+
+        def capture_header(line: bytes):
+            decoded_line = line.decode('iso-8859-1').strip()
+            if ':' in decoded_line:
+                name, value = decoded_line.split(':', 1)
+                response_headers[name.lower()] = value.strip()
+
+        request_headers = [f'{name}: {value}' for name, value in headers.items()]
+        if json is not None and not any(name.lower() == 'content-type' for name in headers):
+            request_headers.append('Content-Type: application/json')
+
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            curl.setopt(pycurl.HTTPHEADER, request_headers)
+            curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, capture_header)
+            if json is not None:
+                curl.setopt(pycurl.POSTFIELDS, json_module.dumps(json).encode('utf-8'))
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        return _CurlResponse(status_code, response_headers, response_body.getvalue())
 
