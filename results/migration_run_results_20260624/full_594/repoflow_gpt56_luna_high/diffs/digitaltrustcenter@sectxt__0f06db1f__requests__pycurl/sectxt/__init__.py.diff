+def _fetch_url(url: str, verify: bool = True):
+    body = BytesIO()
+    response_headers = {}
+
+    def capture_header(header):
+        line = header.decode("iso-8859-1") if isinstance(header, bytes) else header
+        if line.startswith("HTTP/"):
+            # A redirect starts a new response header block.
+            response_headers.clear()
+        else:
+            name, separator, value = line.rstrip("\r\n").partition(":")
+            if separator:
+                response_headers[name.lower()] = value.strip()
+        return len(header)
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(
+            pycurl.HTTPHEADER,
+            [
+                "User-Agent: Mozilla/5.0 (Windows NT 6.1; WOW64; rv:12.0) "
+                "Gecko/20100101 Firefox/12.0"
+            ],
+        )
+        curl.setopt(pycurl.TIMEOUT, 5)
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, capture_header)
+        if not verify:
+            curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+            curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+        curl.perform()
+        response_url = curl.getinfo(pycurl.EFFECTIVE_URL) or url
+        if isinstance(response_url, bytes):
+            response_url = response_url.decode("utf-8")
+        return (
+            curl.getinfo(pycurl.RESPONSE_CODE),
+            response_headers,
+            body.getvalue(),
+            response_url,
+            curl.getinfo(pycurl.REDIRECT_COUNT) > 0,
+        )
+    finally:
+        curl.close()
+
+
+def _is_ssl_error(error: Exception) -> bool:
+    return (
+        isinstance(error, pycurl.error)
+        and bool(error.args)
+        and error.args[0] in _SSL_ERROR_CODES
+    )
 
 
