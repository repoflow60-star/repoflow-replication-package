+            reactor.callWhenRunning(started.set)
+            reactor.run(installSignalHandlers=False)
+
+        _reactor_thread = Thread(target=run_reactor)
+        _reactor_thread.daemon = True
+        _reactor_thread.start()
+        started.wait()
+
+
+def _as_bytes(value):
+    if isinstance(value, bytes):
+        return value
+    return str(value).encode('utf-8')
+
+
+def _request_url(request):
+    if not request.params:
+        return request.url
+
+    query = urlencode(request.params, doseq=True)
+    separator = '&' if '?' in request.url else '?'
+    return '{}{}{}'.format(request.url, separator, query)
+
+
+def _request_headers(request):
+    headers = Headers()
+    for name, value in request.headers.items():
+        values = value if isinstance(value, (list, tuple)) else [value]
+        for item in values:
+            headers.addRawHeader(_as_bytes(name), _as_bytes(item))
+    return headers
+
+
+def _proxy_agent(proxy):
+    parsed = urlparse(proxy)
+    if not parsed.hostname:
+        parsed = urlparse('http://' + proxy)
+    endpoint = TCP4ClientEndpoint(reactor, parsed.hostname, parsed.port)
+    return ProxyAgent(reactor, endpoint)
+
+
+def _decode_header_value(value):
+    if isinstance(value, bytes):
+        return value.decode('latin-1')
+    return value
+
+
+def _response_headers(response):
+    headers = {}
+    for name, values in response.headers.getAllRawHeaders():
+        decoded_name = _decode_header_value(name)
+        decoded_values = [_decode_header_value(value) for value in values]
+        if decoded_values:
+            headers[decoded_name] = ', '.join(decoded_values)
+    return headers
+
+
+@defer.inlineCallbacks
+def _perform_request(session, request, timeout, proxy):
+    body = request.data
+    if body is not None and not isinstance(body, bytes):
+        body = body.encode('utf-8')
+    agent = _proxy_agent(proxy) if proxy else None
+
+    response = yield session.request(
+        request.method,
+        _request_url(request),
+        headers=_request_headers(request),
+        data=body,
+        timeout=timeout,
+        agent=agent,
+    )
+    payload = yield treq.content(response)
+    if isinstance(payload, bytes):
+        payload = payload.decode('utf-8')
+    defer.returnValue((payload, response.code, _response_headers(response)))
+
