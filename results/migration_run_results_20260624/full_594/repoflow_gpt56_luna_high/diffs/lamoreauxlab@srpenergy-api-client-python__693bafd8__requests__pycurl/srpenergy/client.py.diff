+class _PycurlSession:
+    """Keep one curl handle and its cookies for a sequence of HTTP calls."""
+
+    def __init__(self):
+        self._curl = pycurl.Curl()
+        self._curl.setopt(pycurl.COOKIEFILE, "")
+        self._curl.setopt(pycurl.FOLLOWLOCATION, True)
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        self._curl.close()
+
+    def _request(self, url, data=None, headers=None):
+        response = BytesIO()
+        self._curl.setopt(pycurl.URL, url)
+        self._curl.setopt(pycurl.WRITEDATA, response)
+        self._curl.setopt(
+            pycurl.HTTPHEADER,
+            [f"{key}: {value}" for key, value in (headers or {}).items()],
+        )
+
+        if data is None:
+            self._curl.setopt(pycurl.POST, False)
+            self._curl.setopt(pycurl.HTTPGET, True)
+        else:
+            self._curl.setopt(pycurl.HTTPGET, False)
+            self._curl.setopt(pycurl.POST, True)
+            self._curl.setopt(pycurl.POSTFIELDS, urlencode(data).encode("utf-8"))
+
+        self._curl.perform()
+        return response.getvalue()
+
+    def post(self, url, data):
+        """Perform a form-encoded POST and decode its JSON response."""
+        return json.loads(self._request(url, data=data))
+
+    def get(self, url, headers=None, parse_json=True):
+        """Perform a GET and optionally decode its JSON response."""
+        response = self._request(url, headers=headers)
+        return json.loads(response) if parse_json else response
+
+    def cookie(self, name):
+        """Return a named cookie from curl's in-memory cookie jar."""
+        for cookie in self._curl.getinfo(pycurl.INFO_COOKIELIST) or []:
+            if isinstance(cookie, bytes):
+                cookie = cookie.decode("utf-8")
+            fields = cookie.split("\t")
+            if len(fields) >= 7 and fields[5] == name:
+                return fields[6]
+        raise KeyError(name)
 
 
