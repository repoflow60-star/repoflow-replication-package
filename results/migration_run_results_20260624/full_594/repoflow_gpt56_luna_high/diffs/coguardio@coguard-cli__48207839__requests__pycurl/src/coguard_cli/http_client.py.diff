--- a/src/coguard_cli/http_client.py
+++ b/src/coguard_cli/http_client.py
@@ -0,0 +1,111 @@
+"""Small synchronous HTTP client implemented with pycurl."""
+
+import io
+import json
+from typing import Dict, Iterable, Optional
+import urllib.parse
+
+import pycurl
+
+
+class HTTPError(RuntimeError):
+    """Raised when an HTTP response has an unsuccessful status code."""
+
+
+class Response:
+    """The response attributes used by the CLI's API code."""
+
+    def __init__(self, status_code: int, reason: str, content: bytes):
+        self.status_code = status_code
+        self.reason = reason
+        self.content = content
+
+    @property
+    def text(self) -> str:
+        return self.content.decode("utf-8", errors="replace")
+
+    def json(self):
+        return json.loads(self.text)
+
+    def iter_content(self, chunk_size: int = 8192) -> Iterable[bytes]:
+        for start in range(0, len(self.content), chunk_size):
+            yield self.content[start:start + chunk_size]
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            message = "HTTP {}{}".format(
+                self.status_code,
+                " " + self.reason if self.reason else ""
+            )
+            raise HTTPError(message)
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback) -> None:
+        return None
+
+
+def _header_lines(headers: Optional[Dict[str, str]]) -> list:
+    if not headers:
+        return []
+    return ["{}: {}".format(name, value) for name, value in headers.items()]
+
+
+def request(
+        method: str,
+        url: str,
+        headers: Optional[Dict[str, str]] = None,
+        data=None,
+        json_data=None,
+        timeout: Optional[int] = None,
+        stream: bool = False
+):
+    """Execute one HTTP request through libcurl and return a response object."""
+    del stream
+    body = data
+    request_headers = dict(headers or {})
+    if json_data is not None:
+        body = json.dumps(json_data).encode("utf-8")
+        if not any(name.lower() == "content-type" for name in request_headers):
+            request_headers["Content-Type"] = "application/json"
+    elif isinstance(body, dict):
+        body = urllib.parse.urlencode(body).encode("utf-8")
+    elif isinstance(body, str):
+        body = body.encode("utf-8")
+
+    response_body = io.BytesIO()
+    response_headers = []
+    curl = pycurl.Curl()
+    curl.setopt(pycurl.URL, url)
+    curl.setopt(pycurl.CUSTOMREQUEST, method.upper())
+    curl.setopt(pycurl.FOLLOWLOCATION, 1)
+    curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+
+    if request_headers:
+        curl.setopt(pycurl.HTTPHEADER, _header_lines(request_headers))
+    if body is not None:
+        curl.setopt(pycurl.POSTFIELDS, body)
+    if timeout is not None:
+        curl.setopt(pycurl.TIMEOUT, int(timeout))
+
+    def collect_header(header_line: bytes) -> None:
+        response_headers.append(header_line)
+
+    curl.setopt(pycurl.HEADERFUNCTION, collect_header)
+    try:
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+
+    reason = ""
+    for header_line in response_headers:
+        if isinstance(header_line, bytes):
+            decoded_line = header_line.decode("iso-8859-1", errors="replace").strip()
+        else:
+            decoded_line = str(header_line).strip()
+        if decoded_line.startswith("HTTP/"):
+            parts = decoded_line.split(" ", 2)
+            reason = parts[2] if len(parts) == 3 else ""
+    return Response(status_code, reason, response_body.getvalue())
