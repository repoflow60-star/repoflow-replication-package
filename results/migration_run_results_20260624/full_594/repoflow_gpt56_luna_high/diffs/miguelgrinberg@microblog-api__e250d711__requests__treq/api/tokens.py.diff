+
+# Keep the historical module-level client path stable while using treq.
+requests = treq
+
+_reactor_started = Event()
+_reactor_start_lock = Lock()
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_started.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _treq_call(function, *args, **kwargs):
+    """Call a treq operation while keeping this Flask endpoint synchronous."""
+    if not reactor.running:
+        with _reactor_start_lock:
+            if not reactor.running:
+                Thread(target=_run_reactor, daemon=True).start()
+                _reactor_started.wait()
+    return blockingCallFromThread(
+        reactor,
+        lambda: defer.maybeDeferred(function, *args, **kwargs))
+
+
+def _response_code(response):
+    """Return the status code from a treq or compatible HTTP response."""
+    code = getattr(response, 'code', None)
+    return code if isinstance(code, int) else response.status_code
 
 
