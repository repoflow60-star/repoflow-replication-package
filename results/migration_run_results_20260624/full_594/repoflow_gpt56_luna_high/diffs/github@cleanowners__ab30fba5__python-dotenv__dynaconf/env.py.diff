+def _get_bool_value(value: object, default: bool = False) -> bool:
+    """Convert a configuration value to a boolean."""
+    if value is None or value == "":
+        return default
+    return str(value).strip().lower() == "true"
+
+
+def _get_int_value(value: object) -> int | None:
+    """Convert a configuration value to an integer when possible."""
+    if value is None:
+        return None
+    value_string = str(value)
+    if not value_string.strip():
+        return None
+    try:
+        return int(value_string)
+    except ValueError:
+        return None
 
 
