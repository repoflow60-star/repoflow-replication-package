+
+def _pool_manager(cert_data=None, cert_password=b''):
+    if not cert_data:
+        return urllib3.PoolManager()
+
+    if isinstance(cert_password, str):
+        cert_password = cert_password.encode()
+
+    pkcs12 = crypto.load_pkcs12(cert_data, cert_password)
+    ssl_context = PyOpenSSLContext(ssl.PROTOCOL_TLS_CLIENT)
+    ssl_context._ctx.set_default_verify_paths()
+    ssl_context.verify_mode = ssl.CERT_REQUIRED
+    ssl_context.check_hostname = True
+    ssl_context._ctx.use_certificate(pkcs12.get_certificate())
+    ssl_context._ctx.use_privatekey(pkcs12.get_privatekey())
+    ssl_context._ctx.check_privatekey()
+
+    return urllib3.PoolManager(ssl_context=ssl_context)
+
+
+def _request(method, url, headers=None, body=None, **kwargs):
+    cert_data = kwargs.pop('pkcs12_data', None)
+    cert_password = kwargs.pop('pkcs12_password', b'')
+    return _pool_manager(cert_data, cert_password).request(
+        method,
+        url,
+        headers=headers,
+        body=body,
+    )
+
+
+def get(url, headers=None, **kwargs) -> HTTPResponse:
+    return _request('GET', url, headers=headers, **kwargs)
+
+
+def post(url, json=None, headers=None, **kwargs) -> HTTPResponse:
+    body = None if json is None else json_module.dumps(json).encode('utf-8')
+    return _request('POST', url, headers=headers, body=body, **kwargs)
+
+
+def _response_status(response):
+    status = getattr(response, 'status', None)
+    return status if status is not None else response.status_code
+
+
+def _response_json(response):
+    data = getattr(response, 'data', None)
+    if data is None:
+        data = response.content
+    if isinstance(data, bytes):
+        data = data.decode('utf-8')
+    return json_module.loads(data)
 
 
