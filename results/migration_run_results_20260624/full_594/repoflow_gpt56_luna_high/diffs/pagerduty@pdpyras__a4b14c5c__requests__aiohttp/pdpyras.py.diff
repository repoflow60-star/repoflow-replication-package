+def _run_async(coro):
+    """Run an aiohttp coroutine without changing the synchronous API."""
+    try:
+        running_loop = asyncio.get_event_loop()
+    except RuntimeError:
+        running_loop = None
+
+    if running_loop is None or running_loop.is_closed():
+        loop = asyncio.new_event_loop()
+        try:
+            return loop.run_until_complete(coro)
+        finally:
+            loop.close()
+    if not running_loop.is_running():
+        return running_loop.run_until_complete(coro)
+
+    result = []
+    error = []
+
+    def run_in_thread():
+        loop = asyncio.new_event_loop()
+        try:
+            result.append(loop.run_until_complete(coro))
+        except BaseException as exc:
+            error.append(exc)
+        finally:
+            loop.close()
+
+    thread = threading.Thread(target=run_in_thread)
+    thread.start()
+    thread.join()
+    if error:
+        raise error[0]
+    return result[0]
+
+
+class _HTTPResponse:
+    """Synchronous response data captured from an aiohttp response."""
+
+    def __init__(self, response, body, elapsed):
+        self.status_code = response.status
+        self.headers = response.headers.copy()
+        self.content = body
+        self.url = str(response.url)
+        self.reason = response.reason
+        self.request = SimpleNamespace(method=response.method, url=self.url)
+        self.elapsed = timedelta(seconds=elapsed)
+        try:
+            self.encoding = response.get_encoding()
+        except (LookupError, RuntimeError, UnicodeError):
+            self.encoding = 'utf-8'
+
+    @property
+    def ok(self):
+        return self.status_code < 400
+
+    @property
+    def text(self):
+        return self.content.decode(self.encoding or 'utf-8', errors='replace')
+
+    def json(self, **kwargs):
+        return json.loads(self.text, **kwargs)
+
+
+Response = _HTTPResponse
+
+# Keep the historical exception names available while using aiohttp's
+# exception hierarchy for network failures.
+HTTPError = aiohttp.ClientError
+PoolError = aiohttp.ClientError
+RequestException = aiohttp.ClientError
+
+
+class _AiohttpTransport:
+    """Synchronous transport adapter backed by aiohttp."""
+
+    def request(self, method, url, **kwargs):
+        return _run_async(self._request(method, url, **kwargs))
+
+    async def _request(self, method, url, **kwargs):
+        timeout = kwargs.pop('timeout', None)
+        kwargs.pop('stream', None)
+        if timeout is None:
+            timeout = aiohttp.ClientTimeout(total=None)
+        elif isinstance(timeout, tuple):
+            timeout = aiohttp.ClientTimeout(
+                sock_connect=timeout[0],
+                sock_read=timeout[1],
+            )
+        elif not isinstance(timeout, aiohttp.ClientTimeout):
+            timeout = aiohttp.ClientTimeout(total=timeout)
+
+        verify = kwargs.pop('verify', True)
+        if verify is False:
+            kwargs['ssl'] = False
+
+        async with aiohttp.ClientSession(timeout=timeout) as session:
+            started = time.monotonic()
+            async with session.request(method, url, **kwargs) as response:
+                body = await response.read()
+                elapsed = time.monotonic() - started
+                return _HTTPResponse(response, body, elapsed)
