+class _SyncTreq:
+    """Run treq calls synchronously for Certbot's synchronous plugin API."""
+
+    _lock = threading.Lock()
+    _reactor_started = False
+    _reactor_ready = threading.Event()
+
+    @classmethod
+    def _ensure_reactor(cls):
+        if reactor.running:
+            return
+
+        with cls._lock:
+            if not cls._reactor_started:
+                cls._reactor_started = True
+
+                def run_reactor():
+                    cls._reactor_ready.set()
+                    reactor.run(installSignalHandlers=False)
+
+                thread = threading.Thread(
+                    target=run_reactor,
+                    name="infomaniak-treq-reactor",
+                )
+                thread.daemon = True
+                thread.start()
+
+        cls._reactor_ready.wait()
+
+    @classmethod
+    def call(cls, operation):
+        cls._ensure_reactor()
+        completed = threading.Event()
+        result = []
+
+        def succeeded(value):
+            result.append((True, value))
+            completed.set()
+            return value
+
+        def failed(failure):
+            result.append((False, failure))
+            completed.set()
+            return failure
+
+        def start_operation():
+            request = defer.maybeDeferred(operation)
+            request.addCallbacks(succeeded, failed)
+
+        reactor.callFromThread(start_operation)
+        completed.wait()
+        if result[0][0]:
+            return result[0][1]
+        result[0][1].raiseException()
+
+
+class _TreqSession:
+    """Keep common headers while issuing requests through treq."""
+
+    def __init__(self, headers=None):
+        self.headers = headers or {}
+
+    def request(self, method, url, **kwargs):
+        headers = dict(self.headers)
+        headers.update(kwargs.pop("headers", {}))
+        return treq.request(method, url, headers=headers, **kwargs)
+
+    def get(self, url, **kwargs):
+        return self.request("GET", url, **kwargs)
+
+    def post(self, url, **kwargs):
+        return self.request("POST", url, **kwargs)
+
+    def delete(self, url, **kwargs):
+        return self.request("DELETE", url, **kwargs)
 
 
