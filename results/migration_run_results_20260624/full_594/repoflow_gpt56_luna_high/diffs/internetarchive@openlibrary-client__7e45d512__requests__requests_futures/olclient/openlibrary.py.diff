+class _OpenLibraryFuturesSession(FuturesSession):
+    """Keep positional request bodies compatible with the old session API."""
+
+    def post(self, url, data=None, json=None, **kwargs):
+        parent = super(FuturesSession, self)
+        if json is None:
+            if data is None:
+                return parent.post(url, **kwargs)
+            return parent.post(url, data, **kwargs)
+        return parent.post(url, data=data, json=json, **kwargs)
 
 
