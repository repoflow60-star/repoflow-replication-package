+class _CopyDetectSyntaxTheme(SyntaxTheme):
+    """Map Rich lexer token names to copy-detection categories."""
+
+    def get_background_style(self):
+        return Style()
+
+    def get_style_for_token(self, token_type):
+        token_name = str(token_type)
+        if token_name.startswith("Token.Name.Function"):
+            return _RICH_FUNCTION_STYLE
+        if token_name.startswith("Token.Name.Class"):
+            return _RICH_CLASS_STYLE
+        if token_name.startswith("Token.Name"):
+            return _RICH_VARIABLE_STYLE
+        if (token_name == "Token.Comment.Preproc"
+                or token_name == "Token.Comment.Hashbang"):
+            return _RICH_PREPROC_STYLE
+        if (token_name.startswith("Token.Text")
+                or token_name.startswith("Token.Comment")):
+            return _RICH_IGNORED_STYLE
+        if token_name.startswith("Token.Literal.String"):
+            return _RICH_STRING_STYLE
+        return Style()
+
+
+_RICH_SYNTAX_THEME = _CopyDetectSyntaxTheme()
