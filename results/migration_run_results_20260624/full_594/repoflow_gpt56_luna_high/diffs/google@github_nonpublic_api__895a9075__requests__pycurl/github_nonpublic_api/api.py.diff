+class _CurlResult:
+    """Response data returned by a request made with pycurl."""
+
+    def __init__(self, content, status_code, url, headers, history):
+        self.content = content
+        self.status_code = status_code
+        self.url = url
+        self.headers = headers
+        self.history = history
+
+    @property
+    def text(self):
+        content_type = self.headers.get("Content-Type", "")
+        encoding_match = re.search(r"charset=([\w.-]+)", content_type, re.IGNORECASE)
+        encoding = encoding_match.group(1) if encoding_match else "utf-8"
+        return self.content.decode(encoding, errors="replace")
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise RuntimeError(
+                "HTTP error %s while requesting %s" % (self.status_code, self.url)
+            )
+
+
+class _CurlRedirect:
+    def __init__(self, url):
+        self.url = url
+
+
+class _HeaderCollector:
+    def __init__(self):
+        self.headers = {}
+        self.redirect_urls = []
+        self._status_code = 0
+
+    def __call__(self, line):
+        line_length = len(line)
+        line = line.rstrip(b"\r\n")
+        if line.startswith(b"HTTP/"):
+            self.headers = {}
+            parts = line.split()
+            try:
+                self._status_code = int(parts[1])
+            except (IndexError, ValueError):
+                self._status_code = 0
+            return line_length
+
+        separator = line.find(b":")
+        if separator > 0:
+            name = line[:separator].decode("iso-8859-1")
+            value = line[separator + 1 :].strip().decode("iso-8859-1")
+            self.headers[name] = value
+            if 300 <= self._status_code < 400 and name.lower() == "location":
+                self.redirect_urls.append(value)
+        return line_length
+
+
+class _CurlCookies:
+    def __init__(self, session):
+        self._session = session
+
+    def clear(self):
+        self._session._curl.setopt(pycurl.COOKIELIST, "ALL")
+
+
+class _PyCurlSession:
+    """A synchronous, cookie-preserving HTTP session backed by pycurl."""
+
+    def __init__(self):
+        self._curl = pycurl.Curl()
+        self._curl.setopt(pycurl.COOKIEFILE, "")
+        self.cookies = _CurlCookies(self)
+
+    def _request(self, url, data=None):
+        body = io.BytesIO()
+        header_collector = _HeaderCollector()
+
+        self._curl.setopt(pycurl.URL, url)
+        self._curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        self._curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        self._curl.setopt(pycurl.HEADERFUNCTION, header_collector)
+
+        if data is None:
+            self._curl.setopt(pycurl.POST, 0)
+            self._curl.setopt(pycurl.HTTPGET, 1)
+        else:
+            self._curl.setopt(pycurl.HTTPGET, 0)
+            self._curl.setopt(pycurl.POST, 1)
+            self._curl.setopt(pycurl.POSTFIELDS, urlencode(data, doseq=True))
+
+        self._curl.perform()
+        response_url = self._curl.getinfo(pycurl.EFFECTIVE_URL) or url
+        history = [
+            _CurlRedirect(urljoin(url, redirect_url))
+            for redirect_url in header_collector.redirect_urls
+        ]
+        return _CurlResult(
+            content=body.getvalue(),
+            status_code=self._curl.getinfo(pycurl.RESPONSE_CODE),
+            url=response_url,
+            headers=header_collector.headers,
+            history=history,
+        )
+
+    def get(self, url):
+        return self._request(url)
+
+    def post(self, url, data=None):
+        return self._request(url, data=data)
+
+    def close(self):
+        self._curl.close()
