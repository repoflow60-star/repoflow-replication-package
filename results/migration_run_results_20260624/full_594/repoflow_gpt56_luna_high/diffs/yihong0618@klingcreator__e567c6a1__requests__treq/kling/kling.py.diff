+        return _TreqResponse(response, content)
+
+    def get(self, url: str, **kwargs) -> _TreqResponse:
+        return self._request("GET", url, **kwargs)
+
+    def post(self, url: str, **kwargs) -> _TreqResponse:
+        return self._request("POST", url, **kwargs)
