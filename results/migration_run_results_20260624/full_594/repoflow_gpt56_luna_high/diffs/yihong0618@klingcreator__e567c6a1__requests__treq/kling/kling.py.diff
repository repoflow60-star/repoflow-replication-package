+def _ensure_reactor() -> None:
+    global _reactor_thread
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if not reactor.running and _reactor_thread is None:
+            reactor.callWhenRunning(_reactor_ready.set)
+            _reactor_thread = Thread(
+                target=reactor.run,
+                kwargs={"installSignalHandlers": False},
+                daemon=True,
+            )
+            _reactor_thread.start()
+    _reactor_ready.wait()
+
