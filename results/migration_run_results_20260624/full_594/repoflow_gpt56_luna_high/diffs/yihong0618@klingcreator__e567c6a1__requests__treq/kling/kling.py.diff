+def _as_header_bytes(value):
+    if isinstance(value, bytes):
+        return value
+    return str(value).encode("utf-8")
+
+
+class _CookieJar(dict):
+    def get_dict(self):
+        return dict(self)
+
+
+def _request_with_treq(
+    method: str,
+    url: str,
+    headers: dict,
+    params=None,
+    data=None,
+    json_data=None,
+):
+    request_headers = Headers()
+    for name, value in headers.items():
+        values = value if isinstance(value, (list, tuple)) else [value]
+        for header_value in values:
+            request_headers.addRawHeader(
+                _as_header_bytes(name), _as_header_bytes(header_value)
+            )
+
+    request_kwargs = {"headers": request_headers}
+    if params is not None:
+        request_kwargs["params"] = params
+    if data is not None:
+        request_kwargs["data"] = data
+    if json_data is not None:
+        request_kwargs["json"] = json_data
+
+    response_deferred = treq.request(method, url, **request_kwargs)
+
+    def read_response(response):
+        return treq.content(response).addCallback(
+            lambda body: (response, body)
+        )
+
+    return response_deferred.addCallback(read_response)
+
+
+class _TreqResponse:
+    def __init__(self, response, content: bytes) -> None:
+        self.status_code = response.code
+        self.content = content
+        self.text = content.decode("utf-8", errors="replace")
+        self.ok = self.status_code < 400
+
+    def json(self):
+        return json.loads(self.content)
+
+
+class _TreqSession:
+    def __init__(self) -> None:
+        self.cookies = None
+        self.headers = {}
+
+    def _request(self, method: str, url: str, **kwargs) -> _TreqResponse:
+        headers = dict(self.headers)
+        headers.update(kwargs.get("headers") or {})
+        if self.cookies:
+            headers.setdefault(
+                "Cookie",
+                "; ".join(
+                    f"{name}={value}" for name, value in self.cookies.items()
+                ),
+            )
+
+        _ensure_reactor()
+        response, content = blockingCallFromThread(
+            reactor,
+            _request_with_treq,
+            method,
+            url,
+            headers,
+            kwargs.get("params"),
+            kwargs.get("data"),
+            kwargs.get("json"),
+        )
+        response_headers = getattr(response, "headers", None)
+        if response_headers is not None:
+            set_cookies = response_headers.getRawHeaders(b"Set-Cookie") or []
+            if set_cookies and self.cookies is None:
