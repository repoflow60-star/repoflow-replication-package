--- a/webauthn/helpers/certificates.py
+++ b/webauthn/helpers/certificates.py
@@ -0,0 +1,55 @@
+from typing import Any
+
+from asn1crypto import x509
+from Crypto.PublicKey import ECC, RSA
+
+
+class CertificateExtensionNotFound(ValueError):
+    pass
+
+
+def load_der_certificate(cert_bytes: bytes) -> x509.Certificate:
+    return x509.Certificate.load(cert_bytes)
+
+
+def load_certificate_public_key(cert: x509.Certificate) -> Any:
+    public_key_info = cert["tbs_certificate"]["subject_public_key_info"]
+    algorithm = public_key_info["algorithm"]["algorithm"].native
+    encoded_key = public_key_info.dump()
+
+    if algorithm == "rsa":
+        return RSA.import_key(encoded_key)
+    return ECC.import_key(encoded_key)
+
+
+def public_key_bytes(public_key: Any) -> bytes:
+    return public_key.export_key(format="DER")
+
+
+def get_extension(cert: x509.Certificate, oid: str) -> Any:
+    try:
+        extensions = cert["tbs_certificate"]["extensions"]
+    except KeyError:
+        extensions = None
+    if extensions is not None:
+        for extension in extensions:
+            if extension["extn_id"].dotted == oid:
+                return extension
+    raise CertificateExtensionNotFound(oid)
+
+
+def extension_value(cert: x509.Certificate, oid: str) -> bytes:
+    return get_extension(cert, oid)["extn_value"].native
+
+
+def certificate_subject_length(cert: x509.Certificate) -> int:
+    return len(cert["tbs_certificate"]["subject"].chosen)
+
+
+def certificate_common_name(cert: x509.Certificate) -> str:
+    subject = cert["tbs_certificate"]["subject"].chosen
+    for relative_distinguished_name in subject:
+        for attribute in relative_distinguished_name:
+            if attribute["type"].dotted == "2.5.4.3":
+                return attribute["value"].native
+    raise CertificateExtensionNotFound("2.5.4.3")
