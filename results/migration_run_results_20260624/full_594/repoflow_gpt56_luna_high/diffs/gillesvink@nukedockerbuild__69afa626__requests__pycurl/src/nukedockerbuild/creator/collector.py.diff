 logger = logging.getLogger(__name__)
 
 
+class _PycurlResponse:
+    """Expose the response data needed by the collector."""
+
+    def __init__(self, status_code: int, content: bytes) -> None:
+        self.status_code = status_code
+        self._content = content
+
+    def json(self) -> dict:
+        return json.loads(self._content)
+
+
+class _PycurlClient:
+    """Provide a requests-like get seam backed by pycurl."""
+
+    def get(self, url: str, *, timeout: int) -> _PycurlResponse:
+        response_buffer = io.BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.TIMEOUT, timeout)
+            curl.setopt(pycurl.WRITEDATA, response_buffer)
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+        return _PycurlResponse(status_code, response_buffer.getvalue())
+
+
+http_client = _PycurlClient()
+requests = http_client
+
