+
+class HTTPError(Exception):
+    """Raised when a URL returns an unsuccessful HTTP status."""
+
+    def __init__(self, response):
+        self.response = response
+        self.status_code = response.code
+        phrase = response.phrase
+        if isinstance(phrase, bytes):
+            phrase = phrase.decode('ascii', errors='replace')
+        self.reason = phrase
+        super().__init__('{} {}'.format(self.status_code, self.reason))
+
+
+class ConnectionError(OSError):
+    """Raised when a URL cannot be reached."""
+
+
+_reactor_lock = Lock()
+_reactor_ready = Event()
+_reactor_thread = None
+
+
+def _run_reactor():
+    """Run Twisted's reactor on a background thread for sync callers."""
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    """Start the reactor once without changing the public sync API."""
+    global _reactor_thread
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if not reactor.running and _reactor_thread is None:
+            _reactor_thread = Thread(target=_run_reactor, daemon=True)
+            _reactor_thread.start()
+
+    _reactor_ready.wait()
+
+
+@inlineCallbacks
+def _read_url(uri, encoding, timeout):
+    """Fetch and decode a URL using treq's Deferred-based API."""
+    try:
+        response = yield treq.get(uri, timeout=timeout)
+        content = yield treq.content(response)
+    except Exception as error:
+        raise ConnectionError(str(error)) from error
+
+    if response.code >= 400:
+        raise HTTPError(response)
+
+    return content.decode(encoding, errors='replace')
 
 
