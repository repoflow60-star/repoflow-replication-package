+def _resolve_schema_reference(reference, document_schema, schema_documents):
+    """Resolve a local schema reference and return its target document."""
+    document_name, _, pointer = reference.partition('#')
+    target_document = (
+        schema_documents[document_name] if document_name else document_schema
+    )
+
+    target = target_document
+    for part in pointer.lstrip('/').split('/'):
+        if part:
+            target = target[part.replace('~1', '/').replace('~0', '~')]
+    return target, target_document
+
+
+def _cerberus_rule(schema, document_schema, schema_documents):
+    """Translate one schema rule into the corresponding Cerberus rule."""
+    if '$ref' in schema:
+        schema, document_schema = _resolve_schema_reference(
+            schema['$ref'], document_schema, schema_documents
+        )
+
+    rule = {}
+    schema_type = schema.get('type')
+    type_map = {
+        'array': 'list',
+        'boolean': 'boolean',
+        'integer': 'integer',
+        'number': 'number',
+        'object': 'dict',
+        'string': 'string',
+    }
+    if schema_type in type_map:
+        rule['type'] = type_map[schema_type]
+    if 'enum' in schema:
+        rule['allowed'] = schema['enum']
+    if 'pattern' in schema:
+        rule['regex'] = schema['pattern']
+
+    if schema_type == 'array':
+        if 'items' in schema:
+            rule['schema'] = _cerberus_rule(
+                schema['items'], document_schema, schema_documents
+            )
+        if 'minItems' in schema:
+            rule['minlength'] = schema['minItems']
+        if 'maxItems' in schema:
+            rule['maxlength'] = schema['maxItems']
+    elif schema_type == 'object':
+        if 'properties' in schema:
+            rule['schema'] = _cerberus_schema(
+                schema, document_schema, schema_documents
+            )
+        additional_properties = schema.get('additionalProperties', True)
+        if isinstance(additional_properties, dict):
+            rule['allow_unknown'] = _cerberus_rule(
+                additional_properties, document_schema, schema_documents
+            )
+        else:
+            rule['allow_unknown'] = additional_properties
+
+    return rule
+
+
+def _cerberus_schema(schema, document_schema, schema_documents):
+    """Translate an object schema into a Cerberus schema."""
+    required = set(schema.get('required', []))
+    result = {}
+    for name, property_schema in schema.get('properties', {}).items():
+        rule = _cerberus_rule(
+            property_schema, document_schema, schema_documents
+        )
+        if name in required:
+            rule['required'] = True
+        result[name] = rule
+    return result
 
 
