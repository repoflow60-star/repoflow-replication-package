+class HttpResponse:
+
+    def __init__(self, status_code: int, url: str, headers, content: bytes):
+        self.status_code = status_code
+        self.url = url
+        self.headers = headers
+        self._content = content
+
+    def json(self):
+        return json_module.loads(self._content.decode('utf-8'))
+
+
+def _ssl_context_from_pkcs12(cert_data: bytes, password: str) -> ssl.SSLContext:
+    password = password.encode() if isinstance(password, str) else password
+    pkcs12 = OpenSSL.crypto.load_pkcs12(cert_data, password)
+    certificate = OpenSSL.crypto.dump_certificate(
+        OpenSSL.crypto.FILETYPE_PEM,
+        pkcs12.get_certificate(),
+    )
+    private_key = OpenSSL.crypto.dump_privatekey(
+        OpenSSL.crypto.FILETYPE_PEM,
+        pkcs12.get_privatekey(),
+    )
+    ca_certificates = pkcs12.get_ca_certificates() or ()
+    certificate += b''.join(
+        OpenSSL.crypto.dump_certificate(OpenSSL.crypto.FILETYPE_PEM, ca_certificate)
+        for ca_certificate in ca_certificates
+    )
+
+    certificate_fd = os.memfd_create('pynubank-certificate', os.MFD_CLOEXEC)
+    private_key_fd = os.memfd_create('pynubank-private-key', os.MFD_CLOEXEC)
+    try:
+        os.write(certificate_fd, certificate)
+        os.write(private_key_fd, private_key)
+        context = ssl.create_default_context()
+        context.load_cert_chain(
+            f'/proc/self/fd/{certificate_fd}',
+            f'/proc/self/fd/{private_key_fd}',
+        )
+        return context
+    finally:
+        os.close(certificate_fd)
+        os.close(private_key_fd)
+
+
+async def _request(
+        method: str,
+        url: str,
+        headers=None,
+        json=None,
+        pkcs12_data=None,
+        pkcs12_password='') -> HttpResponse:
+    ssl_context = None
+    if pkcs12_data:
+        ssl_context = _ssl_context_from_pkcs12(pkcs12_data, pkcs12_password)
+
+    async with aiohttp.ClientSession(headers=headers) as session:
+        async with session.request(method, url, json=json, ssl=ssl_context) as response:
+            return HttpResponse(
+                response.status,
+                str(response.url),
+                response.headers.copy(),
+                await response.read(),
+            )
+
+
+def _run(coroutine):
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coroutine)
+
+    result = []
+    error = []
+
+    def run_in_thread():
+        try:
+            result.append(asyncio.run(coroutine))
+        except BaseException as exc:
+            error.append(exc)
+
+    thread = Thread(target=run_in_thread)
+    thread.start()
+    thread.join()
+    if error:
+        raise error[0]
+    return result[0]
+
+
+def get(url: str, headers=None, **kwargs) -> HttpResponse:
+    return _run(_request('GET', url, headers=headers, **kwargs))
+
+
+def post(url: str, json: dict, headers=None, **kwargs) -> HttpResponse:
+    return _run(_request('POST', url, headers=headers, json=json, **kwargs))
 
 
