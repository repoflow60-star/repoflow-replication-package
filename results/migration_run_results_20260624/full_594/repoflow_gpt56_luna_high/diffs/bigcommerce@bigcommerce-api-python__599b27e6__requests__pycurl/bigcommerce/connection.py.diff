+class _PycurlResponse(object):
+    def __init__(self, status_code, headers, content, reason):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+        self.reason = reason
+
+    def json(self):
+        return loads(self.content.decode('utf-8') if isinstance(self.content, bytes) else self.content)
+
+
+class _PycurlSession(object):
+    """Small session interface backed directly by libcurl."""
+
+    def __init__(self):
+        self.auth = None
+        self.headers = {}
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        body = BytesIO()
+        response_headers = {}
+        response_reason = ['']
+
+        def receive_headers(line):
+            header_line = line.decode('iso-8859-1').rstrip('\r\n')
+            if header_line.startswith('HTTP/'):
+                parts = header_line.split(' ', 2)
+                response_reason[0] = parts[2] if len(parts) == 3 else ''
+            elif ':' in header_line:
+                name, value = header_line.split(':', 1)
+                response_headers[name] = value.strip()
+
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        curl = pycurl.Curl()
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.CUSTOMREQUEST, method)
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, receive_headers)
+        curl.setopt(pycurl.HTTPHEADER,
+                    ['%s: %s' % (name, value) for name, value in request_headers.items()])
+        curl.setopt(pycurl.ACCEPT_ENCODING, 'gzip, deflate')
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT, int(timeout))
+
+        if self.auth:
+            curl.setopt(pycurl.USERPWD, '%s:%s' % self.auth)
+            curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+
+        if data is not None:
+            if isinstance(data, dict):
+                content_type = request_headers.get('Content-Type', '')
+                if content_type == 'application/x-www-form-urlencoded':
+                    data = urlencode(data)
+                else:
+                    data = dumps(data)
+            if isinstance(data, str):
+                data = data.encode('utf-8')
+            curl.setopt(pycurl.POSTFIELDS, data)
+
+        try:
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        return _PycurlResponse(status_code, response_headers, body.getvalue(), response_reason[0])
 
 
