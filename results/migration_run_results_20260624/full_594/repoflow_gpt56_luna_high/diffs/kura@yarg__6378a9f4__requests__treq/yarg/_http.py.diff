--- a/yarg/_http.py
+++ b/yarg/_http.py
@@ -0,0 +1,67 @@
+from threading import Event
+from threading import Lock
+from threading import Thread
+
+from twisted.internet import defer
+from twisted.internet import reactor
+from twisted.python.failure import Failure
+
+import treq
+
+
+_reactor_lock = Lock()
+_reactor_ready = Event()
+_reactor_thread = None
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _start_reactor():
+    global _reactor_thread
+    if reactor.running:
+        _reactor_ready.set()
+        return
+    with _reactor_lock:
+        if reactor.running:
+            _reactor_ready.set()
+        elif _reactor_thread is None:
+            _reactor_thread = Thread(target=_run_reactor)
+            _reactor_thread.daemon = True
+            _reactor_thread.start()
+    _reactor_ready.wait()
+
+
+def _wait(value):
+    """Resolve a Deferred while retaining yarg's synchronous API."""
+    if not isinstance(value, defer.Deferred):
+        return value
+
+    result = []
+    completed = Event()
+
+    def complete(outcome):
+        result.append(outcome)
+        completed.set()
+        return outcome
+
+    value.addBoth(complete)
+    if not result:
+        _start_reactor()
+        completed.wait()
+    outcome = result[0]
+    if isinstance(outcome, Failure):
+        outcome.raiseException()
+    return outcome
+
+
+def get(url, requester):
+    response = _wait(requester(url))
+    content = getattr(response, 'content', None)
+    if content is None:
+        content = _wait(treq.content(response))
+    else:
+        content = _wait(content)
+    return response, content
