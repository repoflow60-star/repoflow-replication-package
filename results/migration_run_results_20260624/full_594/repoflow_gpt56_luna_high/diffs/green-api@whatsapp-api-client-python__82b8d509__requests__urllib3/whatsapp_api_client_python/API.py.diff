+    @staticmethod
+    def __prepare_multipart_fields(
+            payload: Optional[dict], files: dict
+    ) -> dict:
+        fields = dict(payload or {})
+        for field_name, file_value in files.items():
+            if isinstance(file_value, tuple):
+                file_parts = list(file_value)
+                if len(file_parts) > 1 and hasattr(file_parts[1], "read"):
+                    file_parts[1] = file_parts[1].read()
+                fields[field_name] = tuple(file_parts)
+            elif hasattr(file_value, "read"):
+                fields[field_name] = file_value.read()
+            else:
+                fields[field_name] = file_value
+        return fields
+
+    @staticmethod
+    def __response_status(response: HTTPResponse) -> int:
+        status = getattr(response, "status", None)
+        if isinstance(status, int):
+            return status
+        return response.status_code
+
+    @staticmethod
+    def __response_text(response: HTTPResponse) -> str:
+        data = getattr(response, "data", None)
+        if isinstance(data, bytes):
+            return data.decode("utf-8")
+        if isinstance(data, str):
+            return data
+
+        text = getattr(response, "text", None)
+        if isinstance(text, str):
+            return text
+        return str(data)
 
 
