+class _Rendered:
+    """SQL text represented by Tortoise's raw expression type.
+
+    RawSQL needs a Tortoise compiler context when its ``get_sql`` method is
+    called.  The renderer has no query context because it accepts a parser
+    AST, so the expression's SQL payload is used instead.
+    """
+
+    def __init__(self, sql, precedence=100, alias=None):
+        self.base_sql = sql
+        self.alias = alias
+        rendered_sql = sql
+        if alias is not None:
+            rendered_sql += ' AS ' + alias
+        self.expression = RawSQL(rendered_sql)
+        self.precedence = precedence
+
+    def sql(self, include_alias=True):
+        if not include_alias:
+            return self.base_sql
+        return self.expression.sql
+
+    def __str__(self):
+        return self.sql()
+
