+    def _identifier(self, value):
+        value = str(value)
+        if value == '*' or value.startswith('%'):
+            return value
+        if _IDENTIFIER.match(value) and value.upper() not in _RESERVED:
+            return value
+        quote = self.dialect.identifier_quote
+        return '{}{}{}'.format(quote, value.replace(quote, quote + quote), quote)
+
+    def _alias(self, alias):
+        if alias is None:
+            return None
+        return self._identifier(alias)
+
+    def _fragment(self, sql, precedence=100):
+        return _Rendered(sql, precedence=precedence)
+
+    def _sql(self, expression, parent_precedence=0, include_alias=False):
+        if not isinstance(expression, _Rendered):
+            return str(expression)
+        sql = expression.sql(include_alias=include_alias)
+        if expression.precedence < parent_precedence:
+            return '({})'.format(sql)
+        return sql
 
