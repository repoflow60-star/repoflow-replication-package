+
+def _create_session():
+    session_options = {
+        'cert_reqs': ssl.CERT_REQUIRED if VERIFY_SSL else ssl.CERT_NONE,
+    }
+    if PROXY_DICT:
+        proxy_url = PROXY_DICT.get('https') or PROXY_DICT.get('http')
+        if proxy_url.startswith('socks'):
+            return SOCKSProxyManager(proxy_url, **session_options)
+        return urllib3.ProxyManager(proxy_url, **session_options)
+    return urllib3.PoolManager(**session_options)
+
+
+REQ_SESSION = _create_session()
+
+
+def _request(method, url, **kwargs):
+    # PoolManager exposes request; retain compatibility with injected sessions
+    # that provide the conventional GET convenience method.
+    if method == 'GET':
+        get = getattr(REQ_SESSION, 'get', None)
+        if get is not None:
+            return get(url)
+    return REQ_SESSION.request(method, url, **kwargs)
+
+
+def _raise_for_status(response):
+    status = getattr(response, 'status', None)
+    if isinstance(status, int) and status >= 400:
+        raise urllib3.exceptions.HTTPError(
+            f'HTTP status {status} returned for request',
+        )
 
