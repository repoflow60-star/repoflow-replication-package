+def tabulate(rows: List[List[Any]], headers: List[str], tablefmt: str) -> str:
+    """Render report rows with PrettyTable using the existing report formats."""
+    table = PrettyTable()
+    table.field_names = headers
+    table.add_rows(rows)
+    table.align = "l"
+
+    if tablefmt == "github":
+        table.set_style(TableStyle.MARKDOWN)
+        return table.get_string()
+
+    rendered_rows = [list(row) for row in table.rows]
+    columns = zip(*rendered_rows) if rendered_rows else [[] for _ in headers]
+    widths = [
+        max(
+            [len(str(header)) + 2]
+            + [len("" if value is None else str(value)) for value in column]
+        )
+        for header, column in zip(headers, columns)
+    ]
+
+    def format_row(row: List[Any]) -> str:
+        return "  ".join(
+            f"{'' if value is None else str(value):<{width}}"
+            for value, width in zip(row, widths)
+        ).rstrip()
+
+    separator = "  ".join("=" * width for width in widths)
+    return "\n".join(
+        [separator, format_row(headers), separator]
+        + [format_row(row) for row in rendered_rows]
+        + [separator]
+    )
 
 
