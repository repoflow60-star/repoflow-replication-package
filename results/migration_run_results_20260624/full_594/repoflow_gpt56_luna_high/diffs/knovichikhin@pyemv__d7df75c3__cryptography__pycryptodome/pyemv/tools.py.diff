+def _new_tdes_cipher(key: bytes, mode: int, *args: bytes) -> _typing.Any:
+    if len(key) == 8:
+        return _DES.new(key, mode, *args)
+
+    if len(key) in (16, 24):
+        # DES ignores the least significant parity bit of each key byte.
+        effective_key = bytes(byte & 0xFE for byte in key)
+        if effective_key[:8] == effective_key[8:16]:
+            des_key = key[16:] if len(key) == 24 else key[:8]
+            return _DES.new(des_key, mode, *args)
+        if len(key) == 24 and effective_key[8:16] == effective_key[16:]:
+            return _DES.new(key[:8], mode, *args)
+
+    return _DES3.new(key, mode, *args)
 
 
