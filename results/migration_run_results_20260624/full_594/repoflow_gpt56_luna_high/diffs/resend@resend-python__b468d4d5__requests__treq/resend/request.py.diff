+_reactor_lock = threading.Lock()
+_reactor_ready = threading.Event()
+_reactor_thread: Optional[threading.Thread] = None
+
+
+def _run_reactor() -> None:
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor() -> None:
+    global _reactor_thread
+
+    with _reactor_lock:
+        if reactor.running:
+            _reactor_ready.set()
+        elif _reactor_thread is None:
+            _reactor_thread = threading.Thread(target=_run_reactor, daemon=True)
+            _reactor_thread.start()
+    _reactor_ready.wait()
+
+
+def _decode_header(value: Any) -> str:
+    if isinstance(value, bytes):
+        return value.decode("latin1")
+    return str(value)
+
+
+class _TreqResponseAdapter:
+    """Synchronous view of the response returned by treq."""
+
+    def __init__(self, response: Any, body: bytes):
+        self.status_code = response.code
+        self.headers = {
+            _decode_header(name).lower(): ", ".join(
+                _decode_header(value) for value in values
+            )
+            for name, values in response.headers.getAllRawHeaders()
+        }
+        self.text = body.decode("utf-8")
+
+    def json(self) -> Any:
+        return json.loads(self.text)
+
+
+def _request_sync(
+    verb: RequestVerb,
+    url: str,
+    params: Union[Dict[Any, Any], List[Dict[Any, Any]]],
+    headers: Dict[Any, Any],
+) -> _TreqResponseAdapter:
+    _ensure_reactor()
+
+    completed = threading.Event()
+    responses: List[_TreqResponseAdapter] = []
+    errors: List[Any] = []
+
+    def finish_response(response: Any, body: bytes) -> Any:
+        responses.append(_TreqResponseAdapter(response, body))
+        completed.set()
+        return response
+
+    def finish_error(error: Any) -> Any:
+        errors.append(error)
+        completed.set()
+        return error
+
+    def issue_request() -> None:
+        try:
+            deferred = treq.request(
+                verb.upper(),
+                url,
+                json=params,
+                headers=headers,
+            )
+            deferred.addCallback(
+                lambda response: treq.content(response).addCallback(
+                    lambda body: finish_response(response, body)
+                )
+            )
+            deferred.addErrback(finish_error)
+        except BaseException as error:
+            finish_error(error)
+
+    reactor.callFromThread(issue_request)
+    completed.wait()
+
+    if errors:
+        error = errors[0]
+        if hasattr(error, "raiseException"):
+            error.raiseException()
+        raise error
+    return responses[0]
 
 
