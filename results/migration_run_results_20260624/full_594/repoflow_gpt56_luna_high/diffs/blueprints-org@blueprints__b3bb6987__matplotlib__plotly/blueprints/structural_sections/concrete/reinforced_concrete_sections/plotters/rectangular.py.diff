+    @staticmethod
+    def _line_style(style: dict[str, float | str]) -> dict[str, float | str]:
+        """Map common line options to Plotly line options."""
+        dash = style.get("linestyle", "solid")
+        if not isinstance(dash, str):
+            dash = "solid"
+        dash_aliases = {"-": "solid", "--": "dash", ":": "dot", "-.": "dashdot"}
+        linewidth = style.get("linewidth", style.get("width", 1.0))
+        return {
+            "width": linewidth if isinstance(linewidth, (float, int)) else 1.0,
+            "color": style.get("color", "black"),
+            "dash": dash_aliases.get(dash, dash),
+        }
+
+    def _add_center_arrow(
+        self,
+        axes_i: int,
+        text: str,
+        x: float,
+        y: float,
+        ax: float,
+        ay: float,
+        arrowhead: int,
+        line_style: dict[str, float | str],
+    ) -> None:
+        """Add a directed center-line annotation."""
+        self.axes[axes_i].add_annotation(
+            text=text,
+            x=x,
+            y=y,
+            ax=ax,
+            ay=ay,
+            xref="x",
+            yref="y",
+            axref="x",
+            ayref="y",
+            showarrow=True,
+            arrowhead=arrowhead,
+            arrowwidth=line_style["width"],
+            arrowcolor=line_style["color"],
+            yanchor="bottom" if text == "z" else "middle",
+            xanchor="center" if text == "z" else "right",
+        )
+
+    @staticmethod
+    def _arrowhead(style: object) -> int:
+        """Map common arrow styles to a Plotly arrowhead."""
+        return 0 if style in (None, "-") else 2
 
