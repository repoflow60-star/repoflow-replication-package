+    def _write_env_file(self, value: Optional[str] = None) -> None:
+        """Updates this variable in the dotenv file without changing its shape."""
+
+        try:
+            with open(
+                self.env_file_path, "r", encoding="utf-8", newline=""
+            ) as env_file:
+                lines = env_file.readlines()
+        except FileNotFoundError:
+            if value is None:
+                return
+            lines = []
+
+        variable_pattern = re.compile(
+            r"^(?P<indent>\s*)(?P<export>export\s+)?"
+            r"(?P<name>[A-Za-z_][A-Za-z0-9_]*)\s*="
+        )
+        updated_lines = []
+        found = False
+
+        for line in lines:
+            match = variable_pattern.match(line)
+            if not match or match.group("name") != self.name:
+                updated_lines.append(line)
+                continue
+
+            found = True
+            if value is None:
+                continue
+
+            line_ending = ""
+            if line.endswith("\r\n"):
+                line_ending = "\r\n"
+            elif line.endswith(("\n", "\r")):
+                line_ending = line[-1]
+
+            escaped_value = (
+                value.replace("\\", "\\\\")
+                .replace("'", "\\'")
+                .replace("\r", "\\r")
+                .replace("\n", "\\n")
+            )
+            updated_lines.append(
+                f"{match.group('indent')}{match.group('export') or ''}"
+                f"{self.name}='{escaped_value}'{line_ending}"
+            )
+
+        if value is not None and not found:
+            if updated_lines and not updated_lines[-1].endswith(("\n", "\r")):
+                updated_lines[-1] += "\n"
+            updated_lines.append(f"{self.name}='{value}'\n")
+
+        with open(self.env_file_path, "w", encoding="utf-8", newline="") as env_file:
+            env_file.writelines(updated_lines)
