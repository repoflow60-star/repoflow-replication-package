+            for key, value in self.headers.items()
+            if value is not None
+        }
+        request_kwargs = {
+            "headers": headers,
+            "params": params,
+            "reactor": reactor,
+        }
+        if body is not None:
+            request_kwargs["data"] = json.dumps(body).encode("utf-8")
+            headers["Content-Type"] = ["application/json"]
+        if files is not None:
+            request_kwargs["files"] = files
+
+        def issue_request():
+            try:
+                deferred = treq.request(method, url, **request_kwargs)
+
+                def save_response(response):
+                    result["response"] = response
+                    return treq.content(response)
+
+                def save_content(content):
+                    result["content"] = content
+                    completed.set()
+                    return content
+
+                def save_failure(failure):
+                    result["failure"] = failure
+                    completed.set()
+                    return None
+
+                deferred.addCallback(save_response)
+                deferred.addCallback(save_content)
