+def _run_reactor():
+    try:
+        reactor.callWhenRunning(_reactor_ready.set)
+        reactor.run(installSignalHandlers=False)
+    except Exception as error:
+        _reactor_error.append(error)
+        _reactor_ready.set()
+
+
+def _ensure_reactor():
+    """Start the shared reactor used to bridge treq's Deferred API."""
+    global _reactor_started
+
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_started:
+            message = "The HTTP reactor is no longer available"
+            if _reactor_error:
+                message = str(_reactor_error[0])
+            raise ConnectionUnavailableError(message=message) from None
+        _reactor_started = True
+        threading.Thread(target=_run_reactor, daemon=True).start()
+
+    _reactor_ready.wait()
+    if _reactor_error:
+        raise ConnectionUnavailableError(message=str(_reactor_error[0])) from None
 
 
