+def _request_agent():
+    global _REQUEST_AGENT, _REQUEST_AGENT_KEY
+
+    proxy_key = tuple(sorted((PROXY_DICT or {}).items()))
+    agent_key = proxy_key, VERIFY_SSL
+    if _REQUEST_AGENT_KEY == agent_key:
+        return _REQUEST_AGENT
+
+    if PROXY_DICT:
+        proxy_url = PROXY_DICT.get('https') or PROXY_DICT.get('http')
+        parsed_proxy = urlparse(proxy_url)
+        if parsed_proxy.scheme not in ('http', 'https'):
+            raise ValueError('treq supports HTTP(S) proxies only')
+        if not parsed_proxy.hostname:
+            raise ValueError('proxy must include a host')
+        proxy_port = parsed_proxy.port or (443 if parsed_proxy.scheme == 'https' else 80)
+        agent = ProxyAgent(
+            TCP4ClientEndpoint(reactor, parsed_proxy.hostname, proxy_port),
+        )
+    elif not VERIFY_SSL:
+        agent = Agent(reactor, contextFactory=CertificateOptions(trustRoot=None))
+    else:
+        agent = Agent(reactor)
+
+    _REQUEST_AGENT = agent
+    _REQUEST_AGENT_KEY = agent_key
+    return agent
+
+
+def _start_reactor():
+    reactor.callWhenRunning(_REACTOR_READY.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _REACTOR_THREAD
+
+    if reactor.running:
+        _REACTOR_READY.set()
+        return
+
+    with _REACTOR_LOCK:
+        if _REACTOR_THREAD is None and not reactor.running:
+            _REACTOR_THREAD = threading.Thread(
+                target=_start_reactor,
+                name='cf-speedtest-reactor',
+                daemon=True,
+            )
+            _REACTOR_THREAD.start()
+    _REACTOR_READY.wait()
+
+
+def _run_deferred(operation):
+    _ensure_reactor()
+    return blockingCallFromThread(reactor, operation)
+
+
+def _response_header(response, name: str):
+    headers = getattr(response, 'headers', {})
+    get_raw_headers = getattr(headers, 'getRawHeaders', None)
+    if get_raw_headers:
+        try:
+            values = get_raw_headers(name)
+        except (TypeError, AttributeError):
+            values = None
+        if not values:
+            try:
+                values = get_raw_headers(name.encode('ascii'))
+            except (TypeError, AttributeError):
+                values = None
+        if values:
+            value = values[0]
+            return value.decode('utf-8') if isinstance(value, bytes) else value
+        return None
+
+    if name in headers:
+        value = headers[name]
+    elif name.lower() in headers:
+        value = headers[name.lower()]
+    else:
+        return None
+    if isinstance(value, (list, tuple)):
+        value = value[0]
+    return value.decode('utf-8') if isinstance(value, bytes) else value
+
+
+def _raise_for_status(response) -> None:
+    raise_for_status = getattr(response, 'raise_for_status', None)
+    if callable(raise_for_status):
+        raise_for_status()
+        return
+    if response.code >= 400:
+        raise RuntimeError(f'HTTP request failed with status code {response.code}')
+
+
+@defer.inlineCallbacks
+def _get_response(url: str):
+    response = yield defer.maybeDeferred(
+        REQ_SESSION.get, url, agent=_request_agent(),
+    )
+    _raise_for_status(response)
+    return response
+
+
+@defer.inlineCallbacks
+def _get_with_content(url: str):
+    response = yield _get_response(url)
+    content = getattr(response, 'content', None)
+    if not isinstance(content, (bytes, bytearray)):
+        content = yield treq.content(response)
+    return response, bytes(content)
+
+
+@defer.inlineCallbacks
+def _post_with_content(url: str, **kwargs):
+    response = yield defer.maybeDeferred(
+        REQ_SESSION.post, url, agent=_request_agent(), **kwargs,
+    )
+    _raise_for_status(response)
+    return response
+
+
+@defer.inlineCallbacks
+def _get_text(url: str):
+    response = yield _get_response(url)
+    text = getattr(response, 'text', None)
+    if not isinstance(text, str):
+        text = yield treq.text_content(response)
+    return text
