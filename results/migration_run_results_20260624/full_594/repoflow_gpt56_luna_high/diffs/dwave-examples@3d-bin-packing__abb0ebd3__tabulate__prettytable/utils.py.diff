+def _format_table(rows: list, align: Optional[str] = None) -> str:
+    table = PrettyTable()
+    table.field_names = rows[0]
+    table.add_rows(rows[1:])
+    table.border = False
+    table.hrules = HRuleStyle.NONE
+    if align is not None:
+        table.align = align
+
+    # Preserve the header rule expected by the input reader when borders are
+    # disabled.
+    widths = [max(len(str(row[index])) for row in rows)
+              for index in range(len(rows[0]))]
+    separator = '  '.join('-' * width for width in widths)
+    rendered = table.get_string().splitlines()
+    return '\n'.join([rendered[0], separator, *rendered[1:]])
 
 
