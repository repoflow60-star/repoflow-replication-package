+_reactor_lock = ThreadingLock()
+_reactor_thread = None
+_reactor_started = ThreadingEvent()
+_reactor_start_error = []
+
+
+def _ensure_reactor():
+    """Start the Twisted reactor lazily for the synchronous API bridge."""
+    global _reactor_thread
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if reactor.running:
+            return
+
+        if _reactor_thread is None:
+            _reactor_started.clear()
+            _reactor_start_error[:] = []
+
+            def run_reactor():
+                try:
+                    reactor.callWhenRunning(_reactor_started.set)
+                    reactor.run(installSignalHandlers=False)
+                except BaseException as error:
+                    _reactor_start_error.append(error)
+                    _reactor_started.set()
+
+            _reactor_thread = ThreadingThread(target=run_reactor)
+            _reactor_thread.daemon = True
+            _reactor_thread.start()
+
+    _reactor_started.wait()
+    if _reactor_start_error:
+        raise _reactor_start_error[0]
+
+
+def _wait_for_deferred(operation):
+    """Run a Deferred operation and return its result synchronously."""
+    _ensure_reactor()
+
+    completed = ThreadingEvent()
+    result = []
+
+    def finish(value):
+        result.append(value)
+        completed.set()
+        return value
+
+    def invoke():
+        try:
+            defer.maybeDeferred(operation).addBoth(finish)
+        except BaseException as error:
+            finish(Failure(error))
+
+    reactor.callFromThread(invoke)
+    completed.wait()
+
+    value = result[0]
+    if isinstance(value, Failure):
+        value.raiseException()
+    return value
 
 
