+class _CurlSession:
+    """Small session wrapper for the libcurl handle used by the API client."""
+
+    def __init__(self) -> None:
+        self._curl = pycurl.Curl()
+        self.headers: dict[str, Any] = {}
+
+    def get(self, url: str, params: dict[str, Any], **kwargs) -> dict[str, Any]:
+        """Perform a GET request and decode its JSON response."""
+        query = parse.urlencode(params, doseq=True)
+        request_url = url + ("?" + query if query else "")
+        body = io.BytesIO()
+
+        self._curl.setopt(pycurl.URL, request_url)
+        self._curl.setopt(
+            pycurl.HTTPHEADER,
+            [str(key) + ": " + str(value) for key, value in self.headers.items()],
+        )
+        self._curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        self._curl.setopt(
+            pycurl.FOLLOWLOCATION,
+            1 if kwargs.get("allow_redirects", True) else 0,
+        )
+        self._curl.setopt(pycurl.ACCEPT_ENCODING, "")
+
+        timeout = kwargs.get("timeout")
+        if isinstance(timeout, tuple):
+            connect_timeout, request_timeout = timeout
+            if connect_timeout is not None:
+                self._curl.setopt(
+                    pycurl.CONNECTTIMEOUT_MS,
+                    int(connect_timeout * 1000),
+                )
+            if request_timeout is not None:
+                self._curl.setopt(pycurl.TIMEOUT_MS, int(request_timeout * 1000))
+        elif timeout is not None:
+            self._curl.setopt(pycurl.TIMEOUT_MS, int(timeout * 1000))
+
+        proxies = kwargs.get("proxies")
+        if proxies:
+            scheme = parse.urlparse(url).scheme
+            proxy = proxies.get(scheme) or proxies.get("all")
+            if proxy:
+                self._curl.setopt(pycurl.PROXY, proxy)
+
+        if kwargs.get("verify") is False:
+            self._curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+            self._curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+
+        self._curl.perform()
+        return json.loads(body.getvalue().decode("utf-8"))
+
+    def close(self) -> None:
+        """Release the underlying libcurl handle."""
+        if self._curl is not None:
+            self._curl.close()
+            self._curl = None
+
