 from . import connection, exceptions, helper
 
 _LOGGING = logging.getLogger(__name__)
+
+
+def _request_text(method: str, url: str, timeout: Optional[float]) -> str:
+    # Keep the synchronous REST API independent of the process-wide reactor.
+    reactor = SelectReactor()
+    result: List[Any] = []
+
+    def finish(value: Any) -> Any:
+        result.append(value)
+        if reactor.running:
+            reactor.stop()
+        return value
+
+    client = HTTPClient(Agent(reactor, contextFactory=ClientContextFactory()))
+    request = client.request(method, url, timeout=timeout)
+    request.addCallback(lambda response: response.text())
+    request.addBoth(finish)
+
+    if not result:
+        reactor.run(installSignalHandlers=False)
+
+    value = result[0]
+    if isinstance(value, Failure):
+        value.raiseException()
+    return cast(str, value)
 
 
 class SamsungTVRest(connection.SamsungTVWSBaseConnection):
