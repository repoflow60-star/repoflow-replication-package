+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _reactor_thread
+
+    with _reactor_lock:
+        if not reactor.running:
+            if _reactor_thread is None or not _reactor_thread.is_alive():
+                _reactor_ready.clear()
+                _reactor_thread = threading.Thread(target=_run_reactor, name='fints-treq-reactor', daemon=True)
+                _reactor_thread.start()
+
+    if not reactor.running:
+        _reactor_ready.wait()
+
+
+def _post(url, data, headers):
+    """Perform a treq request while retaining the connection's sync API."""
+    _ensure_reactor()
+    result = {}
+    completed = threading.Event()
+
+    def failed(failure):
+        result['failure'] = failure
+        completed.set()
+
+    def received(response):
+        result['status_code'] = response.code
+        response.content().addCallbacks(received_content, failed)
+
+    def received_content(content):
+        result['content'] = content
+        completed.set()
+
+    def request():
+        try:
+            treq.post(url, data=data, headers=headers).addCallbacks(received, failed)
+        except BaseException as exc:
+            result['exception'] = exc
+            completed.set()
+
+    reactor.callFromThread(request)
+    completed.wait()
+
+    if 'exception' in result:
+        raise result['exception']
+    if 'failure' in result:
+        result['failure'].raiseException()
+
+    return result['status_code'], result['content']
 
 
