--- a/coinbaseadvanced/transport.py
+++ b/coinbaseadvanced/transport.py
@@ -0,0 +1,74 @@
+"""HTTP transport implemented with pycurl."""
+
+import io
+import json as json_module
+from typing import Any, Dict, Optional
+
+import pycurl
+
+
+class HTTPResponse:
+    """Small response object used by the API models."""
+
+    def __init__(self, status_code: int, body: bytes) -> None:
+        self.status_code = status_code
+        self.content = body
+        self.text = body.decode("utf-8", errors="replace")
+        self.ok = status_code < 400
+
+    def json(self) -> Any:
+        """Decode the response body as JSON."""
+        return json_module.loads(self.text)
+
+
+class PycurlTransport:
+    """Execute HTTP requests through pycurl."""
+
+    def request(self,
+                method: str,
+                url: str,
+                headers: Optional[Dict[str, str]] = None,
+                timeout: Optional[int] = None,
+                json: Any = None) -> HTTPResponse:
+        body = io.BytesIO()
+        curl = pycurl.Curl()
+
+        request_headers = [
+            f"{key}: {value}" for key, value in (headers or {}).items()
+        ]
+        if json is not None and not any(
+                header.lower().startswith("content-type:")
+                for header in request_headers):
+            request_headers.append("Content-Type: application/json")
+
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.CUSTOMREQUEST, method)
+        curl.setopt(pycurl.HTTPHEADER, request_headers)
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT, timeout)
+        if json is not None:
+            curl.setopt(pycurl.POSTFIELDS, json_module.dumps(json))
+
+        try:
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        return HTTPResponse(status_code, body.getvalue())
+
+    def get(self, url: str, **kwargs: Any) -> HTTPResponse:
+        return self.request("GET", url, **kwargs)
+
+    def post(self, url: str, **kwargs: Any) -> HTTPResponse:
+        return self.request("POST", url, **kwargs)
+
+    def put(self, url: str, **kwargs: Any) -> HTTPResponse:
+        return self.request("PUT", url, **kwargs)
+
+    def delete(self, url: str, **kwargs: Any) -> HTTPResponse:
+        return self.request("DELETE", url, **kwargs)
+
+
+http_client = PycurlTransport()
