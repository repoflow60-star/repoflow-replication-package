     # Helpers Methods #
+
+    def _request(self, method: str, url: str, headers: dict,
+                 payload: Optional[dict] = None):
+        request_method = getattr(http_client, method.lower())
+        kwargs = {
+            "headers": headers,
+            "timeout": self.timeout,
+        }
+        if payload is not None:
+            kwargs["json"] = payload
+        return request_method(url, **kwargs)
 
