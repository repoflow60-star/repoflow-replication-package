+class _HTTPHeaders(dict):
+    """Case-insensitive HTTP response headers."""
+
+    def __getitem__(self, key):
+        return super().__getitem__(key.lower())
+
+    def get(self, key, default=None):
+        return super().get(key.lower(), default)
+
+
+class _HTTPResponse:
+    """Small response object exposing the interface used by this module."""
+
+    def __init__(self, status_code, headers, content):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+
+    @property
+    def is_redirect(self):
+        return self.status_code in (301, 302, 303, 307, 308) and 'location' in self.headers
+
+    def json(self):
+        return json.loads(self.content.decode('utf-8'))
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise IOError('HTTP error {}'.format(self.status_code))
+
+    def iter_content(self, chunk_size):
+        for start in range(0, len(self.content), chunk_size):
+            yield self.content[start:start + chunk_size]
+
+    def close(self):
+        """Match the close method expected by the deprecated wrapper."""
+
+
+def _parse_http_headers(raw_headers):
+    """Parse the final response header block emitted by libcurl."""
+    headers = _HTTPHeaders()
+    blocks = re.split(br'\r?\n\r?\n', raw_headers)
+    for block in reversed(blocks):
+        lines = block.splitlines()
+        if not lines or not lines[0].startswith(b'HTTP/'):
+            continue
+        for line in lines[1:]:
+            try:
+                name, value = line.decode('iso-8859-1').split(':', 1)
+            except ValueError:
+                continue
+            headers[name.lower()] = value.strip()
+        break
+    return headers
+
+
+def _http_request(method, url, verify=True, timeout=None, headers=None,
+                  params=None, data=None, follow_redirects=True):
+    """Perform an HTTP request with pycurl and return an HTTP response."""
+    if params:
+        query = urllib.parse.urlencode(params, doseq=True)
+        url = '{}{}{}'.format(url, '&' if '?' in url else '?', query)
+
+    body = io.BytesIO()
+    raw_headers = io.BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, raw_headers.write)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1 if follow_redirects else 0)
+        curl.setopt(pycurl.SSL_VERIFYPEER, 1 if verify else 0)
+        curl.setopt(pycurl.SSL_VERIFYHOST, 2 if verify else 0)
+        curl.setopt(pycurl.ACCEPT_ENCODING, '')
+
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT_MS, int(timeout * 1000))
+
+        if headers:
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                ['{}: {}'.format(name, value) for name, value in headers.items()]
+            )
+
+        if method == 'HEAD':
+            curl.setopt(pycurl.NOBODY, 1)
+            curl.setopt(pycurl.CUSTOMREQUEST, 'HEAD')
+        elif method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            if isinstance(data, dict):
+                data = urllib.parse.urlencode(data, doseq=True)
+            if data is not None:
+                curl.setopt(pycurl.POSTFIELDS, data)
+        else:
+            curl.setopt(pycurl.HTTPGET, 1)
+
+        try:
+            curl.perform()
+        except pycurl.error as error:
+            raise IOError(str(error))
+
+        return _HTTPResponse(
+            curl.getinfo(pycurl.RESPONSE_CODE),
+            _parse_http_headers(raw_headers.getvalue()),
+            body.getvalue()
+        )
+    finally:
+        curl.close()
 
 
