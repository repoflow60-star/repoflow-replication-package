+
+class _Urllib3Response:
+    def __init__(self, response: HTTPResponse) -> None:
+        self._response = response
+
+    def raise_for_status(self) -> None:
+        if not 200 <= self._response.status < 300:
+            raise urllib3.exceptions.HTTPError(
+                f"Unexpected HTTP status {self._response.status}: {self._response.reason}"
+            )
+
+    def json(self) -> dict:
+        return json_module.loads(self._response.data.decode("utf-8"))
+
+
+def post(url: str, *, json: dict) -> _Urllib3Response:
+    response = _HTTP.request(
+        "POST",
+        url,
+        body=json_module.dumps(json).encode("utf-8"),
+        headers={"Content-Type": "application/json"},
+    )
+    return _Urllib3Response(response)
 
 
