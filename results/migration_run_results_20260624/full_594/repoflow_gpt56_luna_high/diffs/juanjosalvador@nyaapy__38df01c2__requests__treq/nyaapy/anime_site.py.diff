-import requests
+import threading
+
+import treq
+from twisted.internet import reactor
+
 from nyaapy import torrent
 from nyaapy.parser import parse_nyaa, parse_single, parse_nyaa_rss
+
+
+_reactor_lock = threading.Lock()
+_reactor_started = False
+_reactor_ready = threading.Event()
+
+
+def _run_reactor():
+    _reactor_ready.set()
+    reactor.run(installSignalHandlers=False)
+
+
+def _fetch(url):
+    global _reactor_started
+
+    with _reactor_lock:
+        if not _reactor_started and not reactor.running:
+            _reactor_started = True
+            threading.Thread(target=_run_reactor, daemon=True).start()
+            _reactor_ready.wait()
+
+    result = []
+    completed = threading.Event()
+
+    def fail(failure):
+        result.append(failure.value)
+        completed.set()
+        return failure
+
+    def read_body(response):
+        if response.code >= 400:
+            result.append(
+                RuntimeError("HTTP request failed with status {}".format(response.code))
+            )
+            completed.set()
+            return response
+
+        def complete(body):
+            result.append(body)
+            completed.set()
+            return body
+
+        treq.content(response).addCallbacks(complete, fail)
+        return response
+
+    def request():
+        try:
+            treq.get(url).addCallbacks(read_body, fail)
+        except BaseException as error:
+            result.append(error)
+            completed.set()
+
+    reactor.callFromThread(request)
+    completed.wait()
+
+    if isinstance(result[0], BaseException):
+        raise result[0]
+    return result[0]
 
 
