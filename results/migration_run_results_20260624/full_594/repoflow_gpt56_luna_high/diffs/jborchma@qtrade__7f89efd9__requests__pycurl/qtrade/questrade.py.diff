+    def _request_json(
+        self,
+        method: str,
+        url: str,
+        params: Optional[Dict] = None,
+        data: Optional[Union[Dict, str, bytes]] = None,
+        json_payload: Optional[Dict] = None,
+        include_headers: bool = True,
+    ) -> Dict[str, Any]:
+        """Perform a JSON request with the shared curl handle."""
+        if params:
+            query = urlencode(params, doseq=True)
+            url += "&" if "?" in url else "?"
+            url += query
+
+        response_body = BytesIO()
+        headers = []
+        if include_headers and self.headers:
+            headers.extend(f"{key}: {value}" for key, value in self.headers.items())
+
+        if json_payload is not None:
+            headers.append("Content-Type: application/json")
+            data = jsonlib.dumps(json_payload).encode("utf-8")
+        elif isinstance(data, dict):
+            headers.append("Content-Type: application/x-www-form-urlencoded")
+            data = urlencode(data, doseq=True).encode("utf-8")
+        elif isinstance(data, str):
+            headers.append("Content-Type: application/x-www-form-urlencoded")
+            data = data.encode("utf-8")
+
+        self.session.reset()
+        self.session.setopt(pycurl.URL, url)
+        self.session.setopt(pycurl.CUSTOMREQUEST, method.upper())
+        self.session.setopt(pycurl.HTTPHEADER, headers)
+        self.session.setopt(pycurl.WRITEDATA, response_body)
+        self.session.setopt(pycurl.TIMEOUT, 30)
+        self.session.setopt(pycurl.FOLLOWLOCATION, 1)
+        if data is not None:
+            self.session.setopt(pycurl.POSTFIELDS, data)
+
+        self.session.perform()
+        status_code = self.session.getinfo(pycurl.RESPONSE_CODE)
+        if status_code >= 400:
+            raise RuntimeError(f"HTTP {status_code} returned for {method.upper()} {url}")
+
+        return jsonlib.loads(response_body.getvalue().decode("utf-8"))
 
