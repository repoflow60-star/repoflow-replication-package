+class _PycurlSession(object):
+    def __init__(self):
+        self._curl = pycurl.Curl()
+
+    def get(self, url, params=None, verify=True, stream=False, headers=None):
+        return self._request(
+            'GET', url, params=params, verify=verify, headers=headers)
+
+    def post(self, url, data=None, params=None, verify=True, headers=None):
+        return self._request(
+            'POST', url, data=data, params=params, verify=verify,
+            headers=headers)
+
+    def _request(self, method, url, data=None, params=None, verify=True,
+                 headers=None):
+        if params:
+            separator = '&' if '?' in url else '?'
+            url = ''.join([
+                url,
+                separator,
+                urllib_parse.urlencode(params, doseq=True),
+            ])
+
+        body = io.BytesIO()
+        curl = self._curl
+        curl.reset()
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEDATA, body)
+        curl.setopt(pycurl.SSL_VERIFYPEER, 1 if verify else 0)
+        curl.setopt(pycurl.SSL_VERIFYHOST, 2 if verify else 0)
+
+        if headers:
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                ['%s: %s' % (name, value) for name, value in headers.items()],
+            )
+
+        if method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            if data is not None:
+                if isinstance(data, str):
+                    data = data.encode('utf8')
+                curl.setopt(pycurl.POSTFIELDS, data)
+
+        curl.perform()
+        return _PycurlResponse(body.getvalue(), curl.getinfo(pycurl.RESPONSE_CODE))
+
+    def close(self):
+        self._curl.close()
 
 
