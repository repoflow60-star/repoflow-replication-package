+def _get_text(url: str, params: Optional[dict] = None) -> str:
+    if params:
+        separator = "&" if "?" in url else "?"
+        url = url + separator + urlencode(params, doseq=True)
+
+    response_body = io.BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEDATA, response_body)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.perform()
+    finally:
+        curl.close()
+    return response_body.getvalue().decode("utf-8")
+
