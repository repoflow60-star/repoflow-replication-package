+def _colors(num_colors):
+    if num_colors == 0:
+        return []
+    return pc.sample_colorscale('Turbo', [i / max(num_colors - 1, 1) for i in range(num_colors)])
+
+
+def _plotly_color(color):
+    if isinstance(color, (tuple, list)):
+        values = [value * 255 if value <= 1 else value for value in color]
+        return 'rgb({}, {}, {})'.format(*(round(value) for value in values))
+    return color
+
+
+def _animation_layout(fig):
+    fig.update_layout(
+        updatemenus=[{
+            'type': 'buttons',
+            'buttons': [{
+                'label': 'Play',
+                'method': 'animate',
+                'args': [None, {'frame': {'duration': 100, 'redraw': True}, 'fromcurrent': True}],
+            }],
+        }]
+    )
+
+
+def _write_animation(fig, path, filename):
+    _animation_layout(fig)
+    fig.write_html(path / (filename + '.html'))
 
 
