+import treq
+from twisted.internet import reactor
+from twisted.python.failure import Failure
+from twisted.web.http_headers import Headers
+
+
+_reactor_lock = Lock()
+_reactor_started = Event()
+_reactor_thread = None
+
+
+def _start_reactor() -> None:
+    _reactor_started.set()
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor() -> None:
+    global _reactor_thread
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if _reactor_thread is None:
+            _reactor_thread = Thread(target=_start_reactor, daemon=True)
+            _reactor_thread.start()
+
+    _reactor_started.wait()
+
+
+def _get_response_text(url: str) -> str:
+    """Fetch response text through treq while retaining this module's sync API."""
+    _ensure_reactor()
+
+    response_text = []
+    error = []
+    completed = Event()
+
+    def store_response(text: str) -> str:
+        response_text.append(text)
+        completed.set()
+        return text
+
+    def store_error(failure):
+        error.append(failure)
+        completed.set()
+        return None
+
+    def fetch() -> None:
+        try:
+            request = treq.get(
+                url,
+                reactor=reactor,
+                headers=Headers({b"User-Agent": [b"atcoder-readme-stats/2.0.1"]}),
+            )
+            request.addCallback(treq.text_content)
+            request.addCallbacks(store_response, store_error)
+        except BaseException as failure:
+            store_error(failure)
+
+    reactor.callFromThread(fetch)
+    completed.wait()
+
+    if error:
+        failure = error[0]
+        if isinstance(failure, Failure):
+            failure.raiseException()
+        raise failure
+
+    return response_text[0]
 
 
