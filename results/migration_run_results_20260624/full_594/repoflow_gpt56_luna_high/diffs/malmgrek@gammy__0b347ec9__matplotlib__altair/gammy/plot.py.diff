+def _flat(values):
+    """Return values as a one-dimensional array of JSON-friendly scalars."""
+    values = np.asarray(values).reshape(-1)
+    return [value.item() if isinstance(value, np.generic) else value
+            for value in values]
+
+
+def _records(**columns):
+    """Build records for Altair without exposing NumPy scalar types."""
+    columns = {name: _flat(values) for name, values in columns.items()}
+    length = len(next(iter(columns.values()))) if columns else 0
+    return [
+        {name: values[i] for name, values in columns.items()}
+        for i in range(length)
+    ]
+
+
+def _data(records):
+    return alt.Data(values=records)
 
 
