 logger = logging.getLogger(__name__)
+
+
+async def _aiohttp_request(method, url, verify_ssl=True, timeout=None,
+                           headers=None, params=None, data=None,
+                           allow_redirects=True, raise_for_status=True,
+                           allowed_statuses=()):
+    """Make one request and read its body before closing the session."""
+    client_timeout = aiohttp.ClientTimeout(total=timeout)
+    async with aiohttp.ClientSession(timeout=client_timeout) as session:
+        async with session.request(
+                method,
+                url,
+                ssl=verify_ssl,
+                headers=headers,
+                params=params,
+                data=data,
+                allow_redirects=allow_redirects) as response:
+            content = await response.read()
+            if raise_for_status and response.status not in allowed_statuses:
+                response.raise_for_status()
+            response_headers = {
+                key.lower(): value for key, value in response.headers.items()
+            }
+            return response.status, response_headers, content
+
+
+def _http_request(method, url, **kwargs):
+    """Run an aiohttp request without changing the module's sync API."""
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(_aiohttp_request(method, url, **kwargs))
+
+    result = []
+    error = []
+
+    def run_request():
+        try:
+            result.append(asyncio.run(_aiohttp_request(method, url, **kwargs)))
+        except BaseException as exception:
+            error.append(exception)
+
+    thread = threading.Thread(target=run_request)
+    thread.start()
+    thread.join()
+    if error:
+        raise error[0]
+    return result[0]
 
