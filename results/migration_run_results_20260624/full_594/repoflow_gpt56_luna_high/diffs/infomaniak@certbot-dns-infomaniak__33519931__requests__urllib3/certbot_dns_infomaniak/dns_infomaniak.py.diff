+class _PreparedRequest:
+    def __init__(self, method, url, headers, body):
+        self.method = method
+        self.url = url
+        self.headers = headers
+        self.body = body
+
+    @property
+    def path_url(self):
+        parsed = urlsplit(self.url)
+        return (parsed.path or "/") + ("?" + parsed.query if parsed.query else "")
+
+
+class _HTTPClient:
+    def __init__(self, headers):
+        self.headers = headers.copy()
+        self._pool = urllib3.PoolManager(headers=self.headers)
+        self._adapters = {}
+
+    def mount(self, prefix, adapter):
+        self._adapters[prefix] = adapter
+
+    def _adapter_for(self, url):
+        matches = [prefix for prefix in self._adapters if url.startswith(prefix)]
+        if not matches:
+            return None
+        return self._adapters[max(matches, key=len)]
+
+    def request(self, method, url, fields=None, body=None, headers=None):
+        request_headers = self.headers.copy()
+        if headers:
+            request_headers.update(headers)
+
+        adapter = self._adapter_for(url)
+        if adapter is not None:
+            if fields:
+                query = urlencode(fields, doseq=True)
+                url += ("&" if "?" in url else "?") + query
+            request = _PreparedRequest(method, url, request_headers, body)
+            return adapter.send(request)
+
+        request_args = {"headers": request_headers}
+        if fields is not None:
+            request_args["fields"] = fields
+        if body is not None:
+            request_args["body"] = body
+        return self._pool.request(method, url, **request_args)
+
