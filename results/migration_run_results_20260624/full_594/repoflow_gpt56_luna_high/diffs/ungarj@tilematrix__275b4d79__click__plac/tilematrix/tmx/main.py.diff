+_COMMAND_FUNCTIONS = {
+    "bounds": bounds,
+    "bbox": bbox,
+    "tile": tile,
+    "tiles": tiles,
+    "snap-bounds": snap_bounds,
+    "snap_bbox": snap_bbox,
+    "snap-bbox": snap_bbox,
+}
+
+
+_DEFAULT_OPTIONS = {
+    "pixelbuffer": 0,
+    "tile_size": 256,
+    "metatiling": 1,
+    "grid": "geodetic",
+    "output_format": "Tile",
+}
+
+_OPTION_NAMES = {
+    "--pixelbuffer": ("pixelbuffer", int),
+    "-p": ("pixelbuffer", int),
+    "--tile_size": ("tile_size", int),
+    "-s": ("tile_size", int),
+    "--metatiling": ("metatiling", int),
+    "-m": ("metatiling", int),
+    "--grid": ("grid", str),
+    "-g": ("grid", str),
+    "--output_format": ("output_format", str),
+    "-f": ("output_format", str),
+}
+
+
+def _parse_options(argv):
+    options = dict(_DEFAULT_OPTIONS)
+    remaining = list(argv)
+    index = 0
+    while index < len(remaining):
+        argument = remaining[index]
+        if argument in _COMMANDS:
+            return argument, remaining[index + 1 :], options
+        if argument in ("--version", "-V"):
+            print(tilematrix.__version__)
+            return None, (), options
+        if argument in ("--help", "-h"):
+            print("Usage: tmx [OPTIONS] COMMAND [ARGS]...")
+            return None, (), options
+        if argument == "--":
+            break
+
+        option_name, separator, option_value = argument.partition("=")
+        if option_name not in _OPTION_NAMES:
+            raise SystemExit("unknown option: %s" % option_name)
+        option_key, converter = _OPTION_NAMES[option_name]
+        if not separator:
+            index += 1
+            if index == len(remaining):
+                raise SystemExit("missing value for option: %s" % option_name)
+            option_value = remaining[index]
+        try:
+            options[option_key] = converter(option_value)
+        except ValueError:
+            raise SystemExit("invalid value for option: %s" % option_name)
+        index += 1
+
+    raise SystemExit("missing command")
+
+
+def _plac_call(command, argv, options):
+    original_argv = sys.argv
+    sys.argv = [original_argv[0]] + list(argv)
+    try:
+        if command in ("bounds", "bbox"):
+            @plac.annotations(
+                zoom=("Tile zoom level.", "positional", None, int),
+                row=("Tile row.", "positional", None, int),
+                col=("Tile column.", "positional", None, int),
+            )
+            def parse(zoom, row, col):
+                return _COMMAND_FUNCTIONS[command](zoom, row, col, **options)
+        elif command == "tile":
+            @plac.annotations(
+                zoom=("Tile zoom level.", "positional", None, int),
+                x=("Point x coordinate.", "positional", None, float),
+                y=("Point y coordinate.", "positional", None, float),
+            )
+            def parse(zoom, x, y):
+                return tile(zoom, x, y, **options)
+        else:
+            @plac.annotations(
+                zoom=("Tile zoom level.", "positional", None, int),
+                left=("Left bound.", "positional", None, float),
+                bottom=("Bottom bound.", "positional", None, float),
+                right=("Right bound.", "positional", None, float),
+                top=("Top bound.", "positional", None, float),
+            )
+            def parse(zoom, left, bottom, right, top):
+                return _COMMAND_FUNCTIONS[command](
+                    zoom, left, bottom, right, top, **options
+                )
+        return plac.call(parse)
+    finally:
+        sys.argv = original_argv
+
+
+def _dispatch(argv):
+    command, command_argv, options = _parse_options(argv)
+    if command is None:
+        return None
+    return _plac_call(command, command_argv, options)
+
+
+def tmx():
+    """Run the tmx command line interface."""
+    return _dispatch(sys.argv[1:])
+
+
+def _tmx_main(args=None, prog_name=None, **kwargs):
+    original_argv = sys.argv
+    sys.argv = [prog_name or original_argv[0]] + list(args or ())
+    try:
+        return tmx()
+    finally:
+        sys.argv = original_argv
+
+
+tmx.name = "tmx"
+tmx.main = _tmx_main
