+    def cell_edges(values):
+        if len(values) == 1:
+            return np.array([values[0] - 0.5, values[0] + 0.5])
+        midpoints = (values[:-1] + values[1:]) / 2
+        return np.concatenate(
+            (
+                [values[0] - (values[1] - values[0]) / 2],
+                midpoints,
+                [values[-1] + (values[-1] - values[-2]) / 2],
+            )
+        )
+
+    x_edges = cell_edges(x_values)
