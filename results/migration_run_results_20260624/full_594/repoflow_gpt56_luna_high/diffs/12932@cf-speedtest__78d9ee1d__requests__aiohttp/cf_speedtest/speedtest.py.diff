+async def _resolve(value):
+    if hasattr(value, '__await__'):
+        return await value
+    return value
+
+
+async def _request_async(
+    method: str,
+    url: str,
+    *,
+    data=None,
+    headers=None,
+    as_text: bool = False,
+):
+    proxy = None
+    if PROXY_DICT:
+        proxy = PROXY_DICT.get('https') or PROXY_DICT.get('http')
+
+    async def request_with_session(session):
+        request_method = getattr(session, method.lower())
+        request = request_method(
+            url,
+            data=data,
+            headers=headers,
+            proxy=proxy,
+        )
+        response = await _resolve(request)
+        response.raise_for_status()
+
+        body = response.text if as_text else response.read()
+        if callable(body):
+            body = body()
+        body = await _resolve(body)
+        return body, response.headers
+
+    connector = aiohttp.TCPConnector(ssl=VERIFY_SSL)
+    if REQ_SESSION is not None:
+        return await request_with_session(REQ_SESSION)
+
+    async with aiohttp.ClientSession(connector=connector) as session:
+        return await request_with_session(session)
+
+
+def _request(method: str, url: str, *, data=None, headers=None, as_text=False):
+    loop = asyncio.new_event_loop()
+    try:
+        return loop.run_until_complete(
+            _request_async(
+                method,
+                url,
+                data=data,
+                headers=headers,
+                as_text=as_text,
+            ),
+        )
+    finally:
+        loop.close()
 
 
