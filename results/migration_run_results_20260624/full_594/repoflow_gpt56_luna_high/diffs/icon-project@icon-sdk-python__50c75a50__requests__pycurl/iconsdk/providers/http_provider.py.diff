+    def _make_post_request(request_url: str, data: dict, **kwargs) -> Tuple[bytes, int]:
+        headers = kwargs.get('headers') or {}
+        timeout = kwargs.get('timeout', 10)
+        response_body = BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, request_url)
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, json.dumps(data).encode('utf-8'))
+            if headers:
+                curl.setopt(
+                    pycurl.HTTPHEADER,
+                    [f'{key}: {value}' for key, value in headers.items()]
+                )
+
+            curl.setopt(pycurl.FOLLOWLOCATION, int(kwargs.get('allow_redirects', True)))
+
+            if timeout is not None:
+                if isinstance(timeout, tuple):
+                    connect_timeout, read_timeout = timeout
+                    if connect_timeout is not None:
+                        curl.setopt(pycurl.CONNECTTIMEOUT, connect_timeout)
+                    if read_timeout is not None:
+                        curl.setopt(pycurl.TIMEOUT, read_timeout)
+                else:
+                    curl.setopt(pycurl.CONNECTTIMEOUT, timeout)
+                    curl.setopt(pycurl.TIMEOUT, timeout)
+
+            verify = kwargs.get('verify', True)
+            if verify is False:
+                curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+                curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+            else:
+                curl.setopt(pycurl.SSL_VERIFYPEER, 1)
+                curl.setopt(pycurl.SSL_VERIFYHOST, 2)
+                if isinstance(verify, str):
+                    curl.setopt(pycurl.CAINFO, verify)
+
+            proxies = kwargs.get('proxies') or {}
+            proxy = proxies.get(urlparse(request_url).scheme) or proxies.get('all')
+            if proxy:
+                curl.setopt(pycurl.PROXY, proxy)
+
+            cert = kwargs.get('cert')
+            if cert:
+                if isinstance(cert, tuple):
+                    curl.setopt(pycurl.SSLCERT, cert[0])
+                    if len(cert) > 1:
+                        curl.setopt(pycurl.SSLKEY, cert[1])
+                else:
+                    curl.setopt(pycurl.SSLCERT, cert)
+
+            curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+            curl.perform()
+            return response_body.getvalue(), curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
 
