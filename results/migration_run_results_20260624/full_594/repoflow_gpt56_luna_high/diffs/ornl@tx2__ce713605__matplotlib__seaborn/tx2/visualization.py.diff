+def _scatter(
+    ax,
+    x,
+    y,
+    colors,
+    size,
+    alpha,
+    class_values=None,
+    class_names=None,
+    legend=False,
+    **kwargs,
+):
+    """Plot points with Seaborn while retaining per-class colors."""
+    if len(x) == 0:
+        return
+
+    if class_values is None:
+        sns.scatterplot(
+            x=x,
+            y=y,
+            color=colors[0] if np.ndim(colors) else colors,
+            s=size,
+            alpha=alpha,
+            legend=False,
+            ax=ax,
+            **kwargs,
+        )
+        return
+
+    values = np.asarray(class_values)
+    names = {
+        value: class_names.get(int(value), str(value))
+        for value in np.unique(values)
+    }
+    frame = pd.DataFrame(
+        {
+            "x": x,
+            "y": y,
+            "class": [names[value] for value in values],
+        }
+    )
+    palette = {
+        names[value]: colors[int(value)] for value in np.unique(values)
+    }
+    sns.scatterplot(
+        data=frame,
+        x="x",
+        y="y",
+        hue="class",
+        palette=palette,
+        s=size,
+        alpha=alpha,
+        legend=legend,
+        ax=ax,
+        **kwargs,
+    )
+
