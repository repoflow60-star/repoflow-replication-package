+def _new_figure(figsize, rows=1, cols=1):
+    """Create a figure and axes through Seaborn's figure interface."""
+    frame = pd.DataFrame({"facet": range(rows * cols)})
+    height = figsize[1] / rows
+    aspect = (figsize[0] / cols) / height
+    grid = sns.FacetGrid(
+        frame,
+        col="facet",
+        col_wrap=cols,
+        height=height,
+        aspect=aspect,
+        despine=False,
+    )
+    grid.set_titles("")
+    return grid.fig, np.asarray(grid.axes).reshape(rows, cols), grid
+
+
+def _wordcloud_image(cloud):
+    """Convert a word cloud to the two-dimensional data used by a heatmap."""
+    image = cloud.to_array() if hasattr(cloud, "to_array") else np.asarray(cloud)
+    if image.ndim == 3:
+        image = np.dot(image[..., :3], [0.299, 0.587, 0.114])
+    return image
+
