@@ -289,12 +300,63 @@
     return x, y, colors
 
 
+def _embedding_points(
+    x,
+    y,
+    colors,
+    size,
+    opacity,
+    category_values=None,
+    category_names=None,
+    category_colors=None,
+    show_legend=False,
+    stroke=None,
+):
+    records = []
+    for index in range(len(x)):
+        record = {"x": float(x[index]), "y": float(y[index]), "color": str(colors[index])}
+        if category_values is not None:
+            category = str(category_values[index])
+            if category not in category_names:
+                category = category_names[int(category_values[index])]
+            record["category"] = category
+        records.append(record)
+
+    data = pd.DataFrame(records, columns=["x", "y", "color", "category"])
+    mark_options = {"size": size, "opacity": opacity, "filled": True}
+    if stroke is not None:
+        mark_options.update({"stroke": stroke, "strokeWidth": 2})
+    chart = alt.Chart(data).mark_point(**mark_options).encode(
+        x=alt.X("x:Q"), y=alt.Y("y:Q")
+    )
+    if category_values is not None:
+        chart = chart.encode(
+            color=alt.Color(
+                "category:N",
+                scale=alt.Scale(domain=category_names, range=category_colors),
+                legend=alt.Legend(title=None) if show_legend else None,
+            )
+        )
+    else:
+        color_domain = list(dict.fromkeys(str(color) for color in colors))
+        chart = chart.encode(
+            color=alt.Color(
+                "color:N",
+                scale=alt.Scale(domain=color_domain, range=color_domain),
+                legend=None,
+            )
+        )
+    return chart
+
