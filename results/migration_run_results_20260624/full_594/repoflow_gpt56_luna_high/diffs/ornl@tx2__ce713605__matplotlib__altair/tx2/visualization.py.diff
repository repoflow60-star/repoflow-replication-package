+def _wordcloud_data_uri(cloud) -> str:
+    """Encode a word cloud as a data URI that Vega can render locally."""
+    if hasattr(cloud, "to_image"):
+        image = cloud.to_image()
+    else:
+        image = Image.fromarray(np.asarray(cloud, dtype=np.uint8))
+
+    buffer = io.BytesIO()
+    image.save(buffer, format="PNG")
+    encoded = base64.b64encode(buffer.getvalue()).decode("ascii")
+    return "data:image/png;base64," + encoded
+
+
+def _wordcloud_chart(cloud, title):
+    data = pd.DataFrame(
+        [{"url": _wordcloud_data_uri(cloud), "x": 0.5, "y": 0.5}]
+    )
+    return (
+        alt.Chart(data)
+        .mark_image(width=320, height=160)
+        .encode(
+            url=alt.Url("url:N"),
+            x=alt.X("x:Q", axis=None, scale=alt.Scale(domain=[0, 1])),
+            y=alt.Y("y:Q", axis=None, scale=alt.Scale(domain=[0, 1])),
+        )
+        .properties(width=320, height=160, title=str(title), background="white")
+    )
+
+
+def _chart_grid(charts, num_cols):
+    """Arrange charts into rows without relying on a renderer-specific subplot API."""
+    if not charts:
+        return alt.Chart(pd.DataFrame({"x": [], "y": []})).mark_point().properties(
+            width=320, height=160, background="white"
+        )
+
+    rows = [
+        alt.hconcat(*charts[index : index + num_cols])
+        for index in range(0, len(charts), num_cols)
+    ]
+    return alt.vconcat(*rows).resolve_scale(x="independent", y="independent")
+
