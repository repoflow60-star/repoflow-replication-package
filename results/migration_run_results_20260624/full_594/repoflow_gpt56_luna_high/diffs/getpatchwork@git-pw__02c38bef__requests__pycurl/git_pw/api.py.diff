+def _request(
+    method: str,
+    url: str,
+    params: ty.Optional[Filters] = None,
+    data: ty.Optional[ty.List[ty.Tuple[str, ty.Any]]] = None,
+    auth: ty.Optional[str] = None,
+) -> _Response:
+    if params:
+        query = urlencode(
+            [(key, value) for key, value in params if value is not None]
+        )
+        if query:
+            url += ('&' if '?' in url else '?') + query
+
+    response_body = BytesIO()
+    response_headers: ty.Dict[str, str] = {}
+
+    def handle_header(line: bytes) -> int:
+        header = line.decode('iso-8859-1').strip()
+        if not header:
+            return len(line)
+
+        if header.startswith('HTTP/'):
+            response_headers.clear()
+            response_body.seek(0)
+            response_body.truncate()
+        elif ':' in header:
+            name, value = header.split(':', 1)
+            response_headers[name.lower()] = value.strip()
+
+        return len(line)
+
+    headers = _get_headers()
+    if auth:
+        headers['Authorization'] = auth
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(
+            pycurl.HTTPHEADER,
+            ['{}: {}'.format(name, value) for name, value in headers.items()],
+        )
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.HEADERFUNCTION, handle_header)
+        curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+
+        if method == 'GET':
+            curl.setopt(pycurl.HTTPGET, 1)
+        elif method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, urlencode(data or []).encode())
+        else:
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            if data is not None:
+                curl.setopt(pycurl.POSTFIELDS, urlencode(data).encode())
+
+        curl.perform()
+        return _Response(
+            response_body.getvalue(),
+            response_headers,
+            curl.getinfo(pycurl.RESPONSE_CODE),
+        )
+    except pycurl.error as exc:
+        raise _RequestError(str(exc)) from exc
+    finally:
+        curl.close()
+
