+class _OAuth2Response:
+    def __init__(self, status_code, body):
+        self.status_code = status_code
+        self._body = body
+
+    def json(self):
+        return json.loads(self._body)
+
+
+class _OAuth2Transport:
+    def _request(self, url, data=None, headers=None):
+        response_body = BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+            if headers:
+                curl.setopt(pycurl.HTTPHEADER, [
+                    f'{name}: {value}' for name, value in headers.items()])
+            if data is not None:
+                curl.setopt(pycurl.POST, 1)
+                curl.setopt(pycurl.POSTFIELDS, urlencode(data))
+            curl.perform()
+            return _OAuth2Response(
+                curl.getinfo(pycurl.RESPONSE_CODE), response_body.getvalue())
+        finally:
+            curl.close()
+
+    def post(self, url, data=None, headers=None):
+        return self._request(url, data=data, headers=headers)
+
+    def get(self, url, headers=None):
+        return self._request(url, headers=headers)
+
+
+_oauth2_transport = _OAuth2Transport()
+# Keep the existing module-level client hook while the implementation uses
+# the pycurl-backed transport above.
+requests = _oauth2_transport
 
 
