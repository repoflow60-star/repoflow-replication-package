+def _new_tdes_cipher(
+    key: bytes, mode: int, iv: _typing.Optional[bytes] = None
+) -> _typing.Any:
+    """Create a DES/TDES cipher while accepting legacy degenerate keys."""
+    cipher_module = _DES3
+
+    if len(key) == 8:
+        cipher_module = _DES
+    elif len(key) in {16, 24}:
+        key1 = key[:8]
+        key2 = key[8:16]
+        key3 = key[16:24]
+
+        # EDE collapses to single DES when adjacent effective keys match.
+        if _same_des_key(key1, key2):
+            key = key3 or key1
+            cipher_module = _DES
+        elif len(key) == 24 and _same_des_key(key2, key3):
+            key = key1
+            cipher_module = _DES
+
+    if mode == _DES.MODE_ECB:
+        return cipher_module.new(key, mode)
+    return cipher_module.new(key, mode, iv)
+
 
