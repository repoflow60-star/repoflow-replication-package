+def _render_table(rows: list, right_align: bool = False) -> str:
+    """Render a plain text table with a separator below its header."""
+    table = Table(box=None, pad_edge=False, show_lines=False)
+    for header in rows[0]:
+        table.add_column(str(header), justify="right" if right_align else "left")
+    for row in rows[1:]:
+        table.add_row(*(str(value) for value in row))
+
+    output = StringIO()
+    Console(file=output, width=200, color_system=None).print(table)
+    lines = output.getvalue().splitlines()
+    while lines and not lines[-1].strip():
+        lines.pop()
+    if len(lines) > 1:
+        widths = [max(len(str(row[index])) for row in rows)
+                  for index in range(len(rows[0]))]
+        lines.insert(1, "  ".join("-" * width for width in widths))
+    return "\n".join(lines)
 
 
