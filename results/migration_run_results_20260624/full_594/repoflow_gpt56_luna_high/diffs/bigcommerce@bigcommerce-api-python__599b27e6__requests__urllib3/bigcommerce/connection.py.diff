+class _PoolManager(urllib3.PoolManager):
+    """Keep the connection's request interface while using urllib3."""
+
+    def request(self, method, url, data=None, **kwargs):
+        headers = kwargs.get('headers')
+        merged_headers = dict(self.headers)
+        if headers is not None:
+            merged_headers.update(headers)
+        auth = getattr(self, 'auth', None)
+        if auth and 'Authorization' not in merged_headers:
+            credentials = "%s:%s" % auth
+            merged_headers['Authorization'] = "Basic " + base64.b64encode(
+                credentials.encode()
+            ).decode()
+        kwargs['headers'] = merged_headers
+        return super(_PoolManager, self).request(method, url, body=data, **kwargs)
 
 
