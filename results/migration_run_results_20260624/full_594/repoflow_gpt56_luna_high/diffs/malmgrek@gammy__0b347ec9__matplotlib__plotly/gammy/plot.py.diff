+_PLOTLY_COLORS = {
+    "b": "blue",
+    "c": "cyan",
+    "g": "green",
+    "k": "black",
+    "m": "magenta",
+    "r": "red",
+    "w": "white",
+    "y": "yellow",
+}
+def _plotly_color(color):
+    return _PLOTLY_COLORS.get(color, color)
+
+
+def _band_trace(x, lower, upper):
+    return go.Scatter(
+        x=np.concatenate((x, x[::-1])),
+        y=np.concatenate((lower, upper[::-1])),
+        fill="toself",
+        fillcolor="rgba(0, 0, 0, 0.3)",
+        line=dict(color="rgba(0, 0, 0, 0)"),
+        hoverinfo="skip",
+        showlegend=False,
+    )
+
+
+def _symlog(values, linthresh, base=10):
+    values = np.asarray(values)
+    magnitude = np.abs(values)
+    transformed = np.array(values, dtype=float, copy=True)
+    outside = magnitude > linthresh
+    logarithmic = np.sign(values) * linthresh * (
+        1 + np.log(np.maximum(magnitude, linthresh) / linthresh)
+        / np.log(base)
+    )
+    transformed = np.where(
+        outside,
+        logarithmic,
+        transformed,
+    )
+    return transformed.item() if transformed.ndim == 0 else transformed
 
 
