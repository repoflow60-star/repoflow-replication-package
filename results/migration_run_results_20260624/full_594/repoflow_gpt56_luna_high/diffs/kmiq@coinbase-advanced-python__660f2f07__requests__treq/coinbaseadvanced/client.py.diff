     # Helpers Methods #
+
+    def _request(self, method: str, url: str, headers: dict,
+                 payload: Optional[dict] = None):
+        """Run treq's Deferred request while retaining this client's sync API."""
+        _ensure_reactor()
+
+        def perform_request():
+            request_headers = dict(headers)
+            request_method = getattr(treq, method.lower())
+
+            if payload is not None:
+                request_headers['Content-Type'] = 'application/json'
+                try:
+                    request = request_method(
+                        url,
+                        headers=request_headers,
+                        json=payload,
+                        timeout=self.timeout,
+                    )
+                except TypeError:
+                    request = request_method(
+                        url,
+                        headers=request_headers,
+                        data=json.dumps(payload).encode('utf-8'),
+                        timeout=self.timeout,
+                    )
+            else:
+                request = request_method(
+                    url,
+                    headers=request_headers,
+                    timeout=self.timeout,
+                )
+
+            if not isinstance(request, Deferred):
+                return request
+
+            def build_response(response):
+                return treq.content(response).addCallback(
+                    lambda content: _HttpResponseView(response.code, content))
+
+            return request.addCallback(build_response)
+
+        return blockingCallFromThread(reactor, perform_request)
 
