+class _HttpResponseView:
+    """Synchronous response view consumed by the existing model parsers."""
+
+    def __init__(self, status_code: int, body: bytes) -> None:
+        self.status_code = status_code
+        self.ok = status_code < 400
+        self.text = body.decode('utf-8', errors='replace')
+        self._json = None
+
+    def json(self):
+        if self._json is None:
+            self._json = json.loads(self.text)
+        return self._json
+
+
+_reactor_lock = threading.Lock()
+_reactor_started = threading.Event()
+_reactor_thread = None
+
+
+def _run_reactor() -> None:
+    reactor.callWhenRunning(_reactor_started.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor() -> None:
+    global _reactor_thread
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if not reactor.running and _reactor_thread is None:
+            _reactor_thread = threading.Thread(target=_run_reactor, daemon=True)
+            _reactor_thread.start()
+
+    if not _reactor_started.wait(timeout=5):
+        raise RuntimeError('Unable to start the Twisted reactor')
 
 
