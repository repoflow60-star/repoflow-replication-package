+class _TransportRequest:
+    """Request shape used by synchronous mounted transports."""
+
+    def __init__(self, request):
+        self.method = request.method
+        self.url = str(request.url)
+        self.headers = dict(request.headers)
+        self.body = request.content
+        self.path_url = request.url.raw_path.decode("ascii")
+        self._cookies = {}
+
+
+class _MountedTransport(httpx.BaseTransport):
+    """Adapt a synchronous transport mounted through the session API."""
+
+    def __init__(self, transport):
+        self.transport = transport
+
+    def handle_request(self, request):
+        response = self.transport.send(_TransportRequest(request))
+        return httpx.Response(
+            response.status_code,
+            headers=dict(response.headers),
+            content=response.content,
+            request=request,
+        )
+
+
+class _Client(httpx.Client):
+    """HTTPX client retaining the session's runtime mount operation."""
+
+    def __init__(self):
+        super().__init__()
+        self._runtime_mounts = []
+
+    def mount(self, prefix, transport):
+        if not hasattr(transport, "handle_request"):
+            transport = _MountedTransport(transport)
+        self._runtime_mounts.append((prefix, transport))
+
+    def _transport_for_url(self, url):
+        url = str(url)
+        for prefix, transport in reversed(self._runtime_mounts):
+            if url.startswith(prefix):
+                return transport
+        return super()._transport_for_url(url)
+
