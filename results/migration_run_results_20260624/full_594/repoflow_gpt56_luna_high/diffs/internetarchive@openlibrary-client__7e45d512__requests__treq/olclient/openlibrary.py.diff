+class _Response:
+    """Synchronous response facade for a completed treq response."""
+
+    def __init__(self, response, content, url):
+        self._response = response
+        self.content = content
+        self.status_code = response.code
+        request = getattr(response, 'request', None)
+        response_url = getattr(request, 'absoluteURI', url)
+        self.url = self._decode(response_url)
+        self.reason = self._decode(response.phrase)
+        self.headers = {
+            self._decode(name): self._decode(values[-1])
+            for name, values in response.headers.getAllRawHeaders()
+        }
+
+    @staticmethod
+    def _decode(value):
+        return value.decode('latin1') if isinstance(value, bytes) else value
+
+    @property
+    def text(self):
+        return self.content.decode('utf-8')
+
+    def json(self):
+        return json.loads(self.content.decode('utf-8'))
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise _HTTPError(
+                f'{self.status_code} {self.reason} for url: {self.url}',
+                response=self,
+            )
