+class _TreqSession:
+    def __init__(self):
+        self.cookies = CookieJar()
+        self._client = None
+
+    @staticmethod
+    def _has_header(headers, name):
+        return any(key.lower() == name.lower() for key in headers)
+
+    @staticmethod
+    def _bytes(value):
+        if isinstance(value, bytes):
+            return value
+        return str(value).encode('utf-8')
+
+    @classmethod
+    def _multipart_body(cls, data, files):
+        boundary = b'----openlibrary-client-treq'
+        parts = []
+
+        def add_field(name, value):
+            parts.extend([
+                b'--' + boundary,
+                b'Content-Disposition: form-data; name="' + cls._bytes(name) + b'"',
+                b'',
+                cls._bytes(value),
+            ])
+
+        for name, value in (data or {}).items():
+            values = value if isinstance(value, (list, tuple)) else [value]
+            for item in values:
+                add_field(name, item)
+
+        for name, value in (files or {}).items():
+            filename = name
+            content_type = None
+            if isinstance(value, tuple):
+                filename = value[0]
+                content_type = value[2] if len(value) > 2 else None
+                value = value[1]
+            if filename is None:
+                add_field(name, value)
+                continue
+            if hasattr(value, 'read'):
+                value = value.read()
+            disposition = (
+                b'Content-Disposition: form-data; name="'
+                + cls._bytes(name)
+                + b'"; filename="'
+                + cls._bytes(filename)
+                + b'"'
+            )
+            parts.extend([b'--' + boundary, disposition])
+            if content_type:
+                parts.append(b'Content-Type: ' + cls._bytes(content_type))
+            parts.extend([b'', cls._bytes(value)])
+
+        return b'\r\n'.join(parts + [b'--' + boundary + b'--', b''])
+
+    @classmethod
+    def _body_producer(cls, data, files, headers):
+        if files is not None:
+            body = cls._multipart_body(data, files)
+            if not cls._has_header(headers, 'Content-Type'):
+                headers['Content-Type'] = (
+                    'multipart/form-data; boundary=----openlibrary-client-treq'
+                )
+        elif isinstance(data, dict):
+            body = urlencode(data, doseq=True).encode('utf-8')
+            if not cls._has_header(headers, 'Content-Type'):
+                headers['Content-Type'] = 'application/x-www-form-urlencoded'
+        elif data is None:
+            return None
+        else:
+            body = cls._bytes(data)
+        return FileBodyProducer(BytesIO(body))
+
+    def _request(self, method, url, data=None, **kwargs):
+        headers = dict(kwargs.pop('headers', {}) or {})
+        params = kwargs.pop('params', None)
+        files = kwargs.pop('files', None)
+        timeout = kwargs.pop('timeout', None)
+        if kwargs:
+            raise TypeError('Unsupported request arguments: {}'.format(', '.join(kwargs)))
+        if params:
+            separator = '&' if '?' in url else '?'
+            url += separator + urlencode(params, doseq=True)
+        body_producer = self._body_producer(data, files, headers)
+        if self._client is None:
+            agent = CookieAgent(RedirectAgent(Agent(reactor)), self.cookies)
+            self._client = HTTPClient(agent)
+        request_headers = Headers()
+        for name, value in headers.items():
+            request_headers.addRawHeader(self._bytes(name), self._bytes(value))
+
+        # HTTPClient performs the method and URL byte encoding itself.
+        return self._client.request(
+            method,
+            url,
+            headers=request_headers,
+            data=body_producer,
+            timeout=timeout,
+        ).addCallback(
+            lambda response: treq.content(response).addCallback(
+                lambda content: _Response(response, content, url)
+            )
+        )
+
+    def request(self, method, url, data=None, **kwargs):
+        return _ReactorBridge.call(self._request, method, url, data=data, **kwargs)
+
+    def get(self, url, **kwargs):
+        return self.request('GET', url, **kwargs)
+
+    def post(self, url, data=None, **kwargs):
+        return self.request('POST', url, data=data, **kwargs)
+
+    def put(self, url, data=None, **kwargs):
+        return self.request('PUT', url, data=data, **kwargs)
 
 
