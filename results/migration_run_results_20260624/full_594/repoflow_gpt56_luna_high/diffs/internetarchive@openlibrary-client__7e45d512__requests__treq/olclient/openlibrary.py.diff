+class _ReactorBridge:
+    _lock = threading.Lock()
+    _thread = None
+
+    @classmethod
+    def _ensure_running(cls):
+        with cls._lock:
+            if reactor.running or cls._thread is not None:
+                return
+            cls._thread = threading.Thread(
+                target=reactor.run,
+                kwargs={'installSignalHandlers': False},
+                daemon=True,
+            )
+            cls._thread.start()
+
+    @classmethod
+    def call(cls, function, *args, **kwargs):
+        cls._ensure_running()
+        if cls._thread is not None and threading.get_ident() == cls._thread.ident:
+            raise RuntimeError(
+                'Synchronous OpenLibrary calls cannot run on the Twisted reactor thread'
+            )
+
+        result = Future()
+
+        def invoke():
+            try:
+                deferred = function(*args, **kwargs)
+            except BaseException as error:
+                result.set_exception(error)
+                return
+
+            if not hasattr(deferred, 'addCallbacks'):
+                result.set_result(deferred)
+                return
+
+            def succeeded(value):
+                result.set_result(value)
+                return value
+
+            def failed(failure):
+                error = failure.value
+                if not isinstance(error, _RequestError):
+                    error = _RequestError(str(error))
+                result.set_exception(error)
+                return failure
+
+            deferred.addCallbacks(succeeded, failed)
+
+        reactor.callFromThread(invoke)
+        return result.result()
+
