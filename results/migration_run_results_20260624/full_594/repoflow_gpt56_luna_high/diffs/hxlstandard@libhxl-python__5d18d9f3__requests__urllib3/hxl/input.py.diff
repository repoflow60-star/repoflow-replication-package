+def _http_request(method, url, verify=True, headers=None, timeout=None,
+                  fields=None, body=None, redirect=True):
+    """Make an HTTP request using urllib3 with the input options we need."""
+    http = urllib3.PoolManager(
+        cert_reqs=ssl.CERT_REQUIRED if verify else ssl.CERT_NONE,
+        retries=urllib3.Retry(
+            total=None,
+            connect=0,
+            read=0,
+            redirect=30,
+            status=0
+        )
+    )
+    request_kwargs = {
+        "headers": headers or {},
+        "timeout": timeout,
+        "redirect": redirect,
+        "preload_content": True,
+        "decode_content": True,
+    }
+    if fields is not None:
+        request_kwargs["fields"] = fields
+    if body is not None:
+        request_kwargs["body"] = body
+    try:
+        return http.request(method, url, **request_kwargs)
+    except urllib3.exceptions.HTTPError as e:
+        # Keep connection failures compatible with the previous IOError API.
+        raise IOError(str(e))
+
+
+def _raise_for_status(response):
+    """Raise an urllib3 error for an unsuccessful HTTP response."""
+    if response.status >= 400:
+        raise urllib3.exceptions.HTTPError(
+            "HTTP Error {}: {}".format(response.status, response.reason)
+        )
+
+
+def _response_json(response):
+    """Decode JSON content from an urllib3 response."""
+    return json.loads(response.data.decode("utf-8"))
+
+
+def _is_redirect(response):
+    """Return whether an HTTP response is a redirect with a destination."""
+    return response.status in (301, 302, 303, 307, 308) and "location" in response.headers
 
