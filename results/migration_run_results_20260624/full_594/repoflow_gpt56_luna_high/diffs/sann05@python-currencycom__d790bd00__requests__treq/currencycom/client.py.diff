+    @staticmethod
+    def _request(method, url, params=None, headers=None):
+        """Run a treq Deferred while retaining the client's sync API."""
+        reactor = SelectReactor()
+        completed = []
+        result = []
+        errors = []
+
+        if headers:
+            headers = {
+                key: value if isinstance(value, (list, tuple)) else [value]
+                for key, value in headers.items()
+            }
+
+        def finish(value):
+            completed.append(True)
+            if hasattr(value, 'raiseException'):
+                errors.append(value)
+            else:
+                result.append(value)
+            if reactor.running:
+                reactor.stop()
+            return value
+
+        deferred = treq.request(
+            method,
+            url,
+            params=params,
+            headers=headers,
+            reactor=reactor
+        )
+        deferred.addCallback(treq.json_content)
+        deferred.addBoth(finish)
+        if not completed:
+            reactor.run()
+
+        if errors:
+            errors[0].raiseException()
+        return result[0]
+
