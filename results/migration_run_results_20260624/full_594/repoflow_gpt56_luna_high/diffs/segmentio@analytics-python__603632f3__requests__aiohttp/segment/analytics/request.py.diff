+
+class _Response(object):
+    """Synchronous response view used by the existing request API."""
+
+    def __init__(self, status_code, headers, reason, text):
+        self.status_code = status_code
+        self.headers = headers
+        self.reason = reason
+        self.text = text
+
+    def json(self):
+        return json.loads(self.text)
+
+
+def _proxy_url(proxies):
+    if isinstance(proxies, dict):
+        proxies = proxies.get('https') or proxies.get('http')
+    if proxies and '://' not in proxies:
+        return 'http://' + proxies
+    return proxies
+
+
+async def _post_async(url, data, headers, timeout, proxies=None):
+    request_kwargs = {
+        'data': data,
+        'headers': headers,
+        'timeout': aiohttp.ClientTimeout(total=timeout),
+    }
+    proxy = _proxy_url(proxies)
+    if proxy:
+        request_kwargs['proxy'] = proxy
+
+    async with aiohttp.ClientSession() as session:
+        async with session.post(url, **request_kwargs) as response:
+            text = await response.text()
+            return _Response(
+                response.status,
+                response.headers.copy(),
+                response.reason,
+                text,
+            )
+
+
+def _run(coroutine):
+    """Run an aiohttp operation without changing the synchronous API."""
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coroutine)
+
+    result = []
+    error = []
+
+    def run_in_thread():
+        try:
+            result.append(asyncio.run(coroutine))
+        except BaseException as exc:
+            error.append(exc)
+
+    thread = threading.Thread(target=run_in_thread)
+    thread.start()
+    thread.join()
+    if error:
+        raise error[0]
+    return result[0]
+
+
+class _AiohttpSession(object):
+    def post(self, url, data=None, headers=None, timeout=None, proxies=None):
+        return _run(_post_async(url, data, headers, timeout, proxies))
+
+
+_session = _AiohttpSession()
 
 
