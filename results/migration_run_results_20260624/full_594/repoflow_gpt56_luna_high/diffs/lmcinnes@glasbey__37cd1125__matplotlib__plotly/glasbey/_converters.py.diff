+def _to_rgb(color):
+    """Convert a Plotly color to an sRGB triple in the 0 to 1 range."""
+    if isinstance(color, str):
+        if color.startswith("#"):
+            parsed_color = hex_to_rgb(color)
+        else:
+            parsed_color = convert_colors_to_same_type(
+                [color], colortype="tuple"
+            )
+            # Plotly versions differ in whether a color-scale marker is
+            # returned alongside the converted colors.
+            if isinstance(parsed_color, tuple) and len(parsed_color) == 2:
+                parsed_color = parsed_color[0]
+            if len(parsed_color) == 1:
+                parsed_color = parsed_color[0]
+    else:
+        parsed_color = tuple(color)
+
+    if len(parsed_color) == 4:
+        parsed_color = parsed_color[:3]
+
+    if any(isinstance(channel, (int, integer)) for channel in parsed_color):
+        parsed_color = asarray(parsed_color, dtype=float32) / 255
+    else:
+        parsed_color = asarray(parsed_color, dtype=float32)
+        if max(parsed_color) > 1.0:
+            parsed_color /= 255.0
+    return parsed_color
+
+
+def _rgb_to_hex(color):
+    """Convert an sRGB triple in the 0 to 1 range to a hex color."""
+    channels = tuple(int(round(float(channel) * 255)) for channel in color)
+    return "#{:02x}{:02x}{:02x}".format(*channels)
+
