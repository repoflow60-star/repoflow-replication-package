 import warnings
+import threading
 from functools import wraps, lru_cache
 from importlib.metadata import version
 
+import treq
+from twisted.internet import reactor
+from twisted.internet.threads import blockingCallFromThread
+
 __version__ = version('census')
 
 ALL = '*'
 
 
+_reactor_lock = threading.Lock()
+_reactor_ready = threading.Event()
+_reactor_thread = None
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _reactor_thread
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if not reactor.running and _reactor_thread is None:
+            _reactor_thread = threading.Thread(target=_run_reactor)
+            _reactor_thread.daemon = True
+            _reactor_thread.start()
+
+    _reactor_ready.wait()
+
+
+def _blocking_treq_call(function, *args, **kwargs):
+    _ensure_reactor()
+    if threading.current_thread() is _reactor_thread:
+        raise RuntimeError('Synchronous Census calls cannot run on the Twisted reactor thread')
+    return blockingCallFromThread(reactor, function, *args, **kwargs)
+
+
+class _TreqResponse(object):
+    def __init__(self, response):
+        self._response = response
+        self.status_code = response.code
+
+    def json(self):
+        return _blocking_treq_call(treq.json_content, self._response)
+
+    @property
+    def text(self):
+        return _blocking_treq_call(treq.text_content, self._response)
+
+
+class _TreqSession(object):
+    def __init__(self, *args, **kwargs):
+        self.headers = kwargs.pop('headers', {})
+
+    def get(self, url, params=None, **kwargs):
+        headers = self.headers.copy()
+        headers.update(kwargs.pop('headers', {}))
+        headers = {
+            name: value if isinstance(value, (list, tuple)) else [value]
+            for name, value in headers.items()
+        }
+        response = _blocking_treq_call(
+            treq.get, url, params=params, headers=headers, **kwargs)
+        return _TreqResponse(response)
+
+    def close(self):
+        return None
+
+
