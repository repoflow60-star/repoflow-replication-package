+
+_ANSI_SGR = re.compile(r'\033\[[0-9;]*m')
+
+
+def _restore_tabs(rendered: str, source: str) -> str:
+    source_pos = 0
+    output = []
+    pos = 0
+
+    def replace_text(fragment: str) -> str:
+        nonlocal source_pos
+        replaced = []
+        for char in fragment:
+            if char in '\r\n':
+                if source.startswith('\r\n', source_pos):
+                    source_pos += 2
+                elif source_pos < len(source) and source[source_pos] == char:
+                    source_pos += 1
+                replaced.append(char)
+                continue
+
+            if source_pos < len(source):
+                if source[source_pos] == '\t' and char == ' ':
+                    char = '\t'
+                source_pos += 1
+            replaced.append(char)
+        return ''.join(replaced)
+
+    for match in _ANSI_SGR.finditer(rendered):
+        output.append(replace_text(rendered[pos:match.start()]))
+        output.append(match.group())
+        pos = match.end()
+
+    output.append(replace_text(rendered[pos:]))
+    return ''.join(output)
+
+
+def render_syntax(text: str, lexer: str) -> str:
+    """Render syntax highlighting with the existing terminal ANSI contract."""
+    width = max((len(line.expandtabs(1)) for line in text.splitlines()),
+                default=1)
+    stream = io.StringIO()
+    console = Console(file=stream, width=width, force_terminal=True,
+                      color_system='standard')
+    console.print(Syntax(text, lexer, theme='ansi_dark',
+                         background_color=None, padding=0, tab_size=1),
+                  end='')
+
+    rendered = _restore_tabs(stream.getvalue(), text)
+    rendered = rendered.replace('\033[37m\033[39;49;00m', '')
+    rendered = rendered.replace('\033[34m', '\033[94m')
+    return rendered
 
 
