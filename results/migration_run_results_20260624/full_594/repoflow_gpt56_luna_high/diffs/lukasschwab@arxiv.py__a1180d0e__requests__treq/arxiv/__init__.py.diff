 logger = logging.getLogger(__name__)
 
 _DEFAULT_TIME = datetime.min
+
+_reactor_lock = Lock()
+_reactor_started = Event()
+_reactor_thread = None
+
+
+def _run_reactor() -> None:
+    reactor.callWhenRunning(_reactor_started.set)
+    try:
+        reactor.run(installSignalHandlers=False)
+    finally:
+        _reactor_started.set()
+
+
+def _ensure_reactor() -> None:
+    global _reactor_thread
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is None:
+            _reactor_thread = Thread(target=_run_reactor, daemon=True)
+            _reactor_thread.start()
+    _reactor_started.wait()
+    if not reactor.running:
+        raise RuntimeError("The treq reactor failed to start")
+
+
+def _treq_get(session, url: str):
+    """Perform a treq request while preserving the client's synchronous API."""
+    _ensure_reactor()
+    completed = Event()
+    response = []
+    failures = []
+
+    def read_body(resp):
+        return treq.content(resp).addCallback(lambda body: (resp.code, body))
+
+    def succeeded(value):
+        response.append(value)
+        completed.set()
+        return value
+
+    def failed(failure):
+        failures.append(failure)
+        completed.set()
+        return None
+
+    def request():
+        try:
+            deferred = session.get(
+                url,
+                headers=Headers({b"user-agent": [b"arxiv.py/2.1.3"]}),
+            )
+            deferred.addCallback(read_body)
+            deferred.addCallbacks(succeeded, failed)
+        except Exception as error:
+            failures.append(error)
+            completed.set()
+
+    reactor.callFromThread(request)
+    completed.wait()
+    if failures:
+        failure = failures[0]
+        if isinstance(failure, Failure):
+            failure.raiseException()
+        raise failure
+    return response[0]
+
+
+_TREQ_CONNECTION_ERRORS = (
+    ConnectionDone,
+    ConnectionLost,
+    ConnectError,
+    DNSLookupError,
+    ResponseNeverReceived,
+    TimeoutError,
+)
 
 
