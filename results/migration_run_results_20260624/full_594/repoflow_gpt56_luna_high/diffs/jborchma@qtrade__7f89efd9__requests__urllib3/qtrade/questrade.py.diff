+    def _request(
+        self,
+        method: str,
+        url: str,
+        params: Optional[Dict] = None,
+        data: Optional[Dict] = None,
+        json: Optional[Dict] = None,
+        include_session_headers: bool = True,
+    ) -> urllib3.response.HTTPResponse:  # pylint: disable=R0913
+        """Send a request using the shared urllib3 connection pool."""
+        if params:
+            separator = "&" if "?" in url else "?"
+            url += separator + urlencode(params, doseq=True)
+
+        headers = dict(self.session.headers) if include_session_headers else {}
+        body = None
+        if json is not None:
+            body = json_lib.dumps(json)
+            headers["Content-Type"] = "application/json"
+        elif data is not None:
+            if isinstance(data, dict):
+                body = urlencode(data, doseq=True)
+                headers["Content-Type"] = "application/x-www-form-urlencoded"
+            else:
+                body = data
+
+        response = self.session.request(
+            method,
+            url,
+            body=body,
+            headers=headers,
+            timeout=30,
+        )
+        if response.status >= 400:
+            raise urllib3.exceptions.HTTPError(
+                "{} {} for url: {}".format(response.status, response.reason, url)
+            )
+        return response
+
+    @staticmethod
+    def _response_json(response: urllib3.response.HTTPResponse) -> Any:
+        """Decode an urllib3 response body as JSON."""
+        body = response.data
+        if isinstance(body, bytes):
+            body = body.decode("utf-8")
+        return json_lib.loads(body)
 
