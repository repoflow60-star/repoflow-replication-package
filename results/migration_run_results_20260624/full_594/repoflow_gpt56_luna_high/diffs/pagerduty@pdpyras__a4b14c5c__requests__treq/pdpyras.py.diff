+class _Headers(dict):
+    """A case-insensitive mapping for request and response headers."""
+
+    @staticmethod
+    def _key(key):
+        return key.lower() if isinstance(key, str) else key
+
+    def __contains__(self, key):
+        normalized = self._key(key)
+        return any(self._key(existing) == normalized for existing in self)
+
+    def __getitem__(self, key):
+        normalized = self._key(key)
+        for existing, value in self.items():
+            if self._key(existing) == normalized:
+                return value
+        raise KeyError(key)
+
+    def __setitem__(self, key, value):
+        normalized = self._key(key)
+        for existing in list(self):
+            if self._key(existing) == normalized:
+                dict.__delitem__(self, existing)
+        dict.__setitem__(self, key, value)
+
+    def get(self, key, default=None):
+        try:
+            return self[key]
+        except KeyError:
+            return default
+
+    def update(self, other=(), **kwargs):
+        if hasattr(other, 'keys'):
+            for key in other.keys():
+                self[key] = other[key]
+        else:
+            for key, value in other:
+                self[key] = value
+        for key, value in kwargs.items():
+            self[key] = value
+
+
+class _RequestMetadata:
+    def __init__(self, method, url):
+        self.method = method
+        self.url = url
+
+
+class _ResponseAdapter:
+    """Synchronous response value built from a real treq response."""
+
+    def __init__(self, response, body, method, url, started):
+        self.status_code = response.code
+        self.ok = response.code < 400
+        self.url = url
+        self.content = body
+        self.text = body.decode('utf-8', errors='replace')
+        self.headers = _Headers()
+        for name, values in response.headers.getAllRawHeaders():
+            if isinstance(name, bytes):
+                name = name.decode('latin1')
+            decoded = [
+                value.decode('latin1') if isinstance(value, bytes) else str(value)
+                for value in values
+            ]
+            self.headers[name] = ', '.join(decoded)
+        self.request = _RequestMetadata(method, url)
+        self.elapsed = timedelta(seconds=time.monotonic() - started)
+
+    def json(self):
+        return json.loads(self.text)
+
+
+_reactor_lock = threading.Lock()
+_reactor_ready = None
+_reactor_thread = None
+
+
+def _ensure_reactor():
+    global _reactor_ready, _reactor_thread
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is None:
+            _reactor_ready = threading.Event()
+
+            def run_reactor():
+                reactor.callWhenRunning(_reactor_ready.set)
+                reactor.run(installSignalHandlers=False)
+
+            _reactor_thread = threading.Thread(
+                target=run_reactor,
+                name='pdpyras-treq-reactor',
+                daemon=True,
+            )
+            _reactor_thread.start()
+    _reactor_ready.wait()
+
+
+class _TreqSession:
+    """Synchronous session facade that performs requests with treq."""
+
+    def __init__(self):
+        self.headers = _Headers()
+
+    def request(self, method, url, **kwargs):
+        started = time.monotonic()
+        request_kwargs = {
+            key: kwargs[key]
+            for key in ('headers', 'params', 'data', 'json', 'timeout')
+            if key in kwargs
+        }
+        if 'headers' in request_kwargs:
+            request_kwargs['headers'] = {
+                name.encode('latin1') if isinstance(name, str) else name:
+                [
+                    item.encode('latin1') if isinstance(item, str) else item
+                    for item in (value if isinstance(value, (list, tuple)) else [value])
+                ]
+                for name, value in request_kwargs['headers'].items()
+            }
+        if 'allow_redirects' in kwargs:
+            request_kwargs['browser_like_redirects'] = kwargs['allow_redirects']
+
+        try:
+            _ensure_reactor()
+            response = blockingCallFromThread(
+                reactor,
+                treq.request,
+                method,
+                url,
+                **request_kwargs
+            )
+            body = blockingCallFromThread(reactor, treq.content, response)
+        except Exception as error:
+            raise _TreqNetworkError(str(error)) from error
+        return _ResponseAdapter(response, body, method, url, started)
+
+    def get(self, url, **kwargs):
+        kwargs.setdefault('allow_redirects', True)
+        return self.request('GET', url, **kwargs)
+
+    def post(self, url, data=None, json=None, **kwargs):
+        return self.request('POST', url, data=data, json=json, **kwargs)
+
+    def put(self, url, data=None, json=None, **kwargs):
+        return self.request('PUT', url, data=data, json=json, **kwargs)
+
+    def delete(self, url, **kwargs):
+        return self.request('DELETE', url, **kwargs)
+
+    def close(self):
+        pass
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        self.close()
 
