+class _Urllib3Session:
+    def __init__(self, headers=None, verify=True, cert=None):
+        self.headers = headers or {}
+        self.verify = verify
+        self.cert = cert
+        self.pool = self.__create_pool_manager()
+
+    def __create_pool_manager(self):
+        pool_kwargs = {}
+        if self.verify is False:
+            pool_kwargs['cert_reqs'] = ssl.CERT_NONE
+        elif isinstance(self.verify, str):
+            pool_kwargs['cert_reqs'] = ssl.CERT_REQUIRED
+            pool_kwargs['ca_certs'] = self.verify
+
+        if isinstance(self.cert, tuple):
+            pool_kwargs['cert_file'] = self.cert[0]
+            pool_kwargs['key_file'] = self.cert[1]
+        elif self.cert:
+            pool_kwargs['cert_file'] = self.cert
+
+        return urllib3.PoolManager(**pool_kwargs)
+
+    def request(self, method, url, params=None, json_body=None, files=None):
+        if params:
+            separator = '&' if '?' in url else '?'
+            url = url + separator + urlencode(params, doseq=True)
+
+        headers = dict(self.headers or {})
+        request_kwargs = {'headers': headers}
+        if json_body is not None:
+            request_kwargs['body'] = json.dumps(json_body)
+            headers['Content-Type'] = 'application/json'
+        if files is not None:
+            request_kwargs['fields'] = files
+            request_kwargs['encode_multipart'] = True
+
+        return self.pool.request(method, url, **request_kwargs)
+
+    def get(self, url, params=None):
+        return self.request('GET', url, params=params)
+
+    def post(self, url, params=None, json=None):
+        return self.request('POST', url, params=params, json_body=json)
+
+    def put(self, url, params=None, json=None, files=None):
+        return self.request('PUT', url, params=params, json_body=json, files=files)
+
+    def delete(self, url, params=None):
+        return self.request('DELETE', url, params=params)
+
+
+def _get(url, headers=None, verify=True, cert=None):
+    return _Urllib3Session(headers=headers, verify=verify, cert=cert).get(url)
+
+
+# Preserve the historical module attribute without importing the source library.
+requests = SimpleNamespace(Session=_Urllib3Session, get=_get)
 
 
