+    @staticmethod
+    def __response_status(response):
+        for attribute in ('status_code', 'status'):
+            value = getattr(response, attribute, None)
+            if isinstance(value, (int, str)):
+                return value
+        return None
+
+    @staticmethod
+    def __response_text(response):
+        text = getattr(response, 'text', None)
+        if isinstance(text, str):
+            return text
+        data = getattr(response, 'data', b'')
+        if isinstance(data, bytes):
+            return data.decode('utf-8')
+        if isinstance(data, str):
+            return data
+        return ''
+
+    @classmethod
+    def __response_ok(cls, response):
+        ok = getattr(response, 'ok', None)
+        if isinstance(ok, bool):
+            return ok
+        status = cls.__response_status(response)
+        try:
+            return status is not None and int(status) < 400
+        except (TypeError, ValueError):
+            return False
+
+    @classmethod
+    def __raise_for_status(cls, response):
+        status = cls.__response_status(response)
+        try:
+            has_error_status = status is not None and int(status) >= 400
+        except (TypeError, ValueError):
+            has_error_status = False
+        if has_error_status:
+            raise HttpError(
+                message=cls.parse_response_message(response),
+                status=status
+            )
+
+    @classmethod
+    def __format_response(cls, response):
+        try:
+            json_method = getattr(response, 'json', None)
+            data = json_method() if json_method else json.loads(cls.__response_text(response))
