 _cached_wordclouds = {}
 
 
+def _blank_axes(figsize):
+    grid = sns.relplot(
+        x=[0],
+        y=[0],
+        s=0,
+        legend=False,
+        height=figsize[1],
+        aspect=figsize[0] / figsize[1],
+    )
+    fig = grid.fig
+    ax = grid.ax
+    ax.clear()
+    return fig, ax
+
+
+def _blank_grid(num_rows, num_cols, figsize):
+    fig, ax = _blank_axes(figsize)
+    fig.clear()
+    return fig, fig.subplots(num_rows, num_cols, squeeze=False)
+
+
+def _scatter_color_points(ax, x, y, colors, size, alpha=1.0, **kwargs):
+    palette = {color: color for color in list(colors)}
+    return sns.scatterplot(
+        x=x,
+        y=y,
+        hue=colors,
+        palette=palette if palette else None,
+        legend=False,
+        alpha=alpha,
+        s=size,
+        ax=ax,
+        **kwargs,
+    )
+
+
