 """
 The longest permissible length of API content to include in error messages.
 """
+
+class RequestException(HTTPError):
+    """Network request error raised by the urllib3-backed session."""
+    pass
+
+class RequestInfo(object):
+    """Request metadata exposed on response objects."""
+
+    def __init__(self, method, url):
+        self.method = method
+        self.url = url
+
+class ElapsedTime(object):
+    """Elapsed request time with a ``total_seconds`` method."""
+
+    def __init__(self, seconds):
+        self._seconds = seconds
+
+    def total_seconds(self):
+        return self._seconds
+
+class Response(object):
+    """Response wrapper exposing the response attributes used by this module."""
+
+    def __init__(self, raw_response, method, url, elapsed):
+        self.raw = raw_response
+        self.request = RequestInfo(method, url)
+        self.elapsed = ElapsedTime(elapsed)
+        self.status_code = raw_response.status
+        self.headers = raw_response.headers
+        self.content = raw_response.data or b''
+
+    @property
+    def ok(self):
+        return 200 <= self.status_code < 400
+
+    @property
+    def text(self):
+        return self.content.decode('utf-8', errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+class Session(object):
+    """Small synchronous session API backed by urllib3."""
+
+    def __init__(self):
+        self.headers = {}
+        self.pool = urllib3.PoolManager()
+
+    def prepare_url(self, url, params):
+        if not params:
+            return url
+        scheme, netloc, path, query, fragment = urlsplit(url)
+        params_query = urlencode(params, doseq=True)
+        query = query+'&'+params_query if query else params_query
+        return urlunsplit((scheme, netloc, path, query, fragment))
+
+    def request(self, method, url, **kwargs):
+        method = method.upper()
+        headers = deepcopy(self.headers)
+        headers.update(kwargs.pop('headers', {}) or {})
+        params = kwargs.pop('params', None)
+        json_body = kwargs.pop('json', None)
+        data = kwargs.pop('data', None)
+        timeout = kwargs.pop('timeout', None)
+        kwargs.pop('stream', None)
+        redirect = kwargs.pop('allow_redirects', True)
+
+        body = None
+        url = self.prepare_url(url, params)
+        if json_body is not None:
+            body = json.dumps(json_body).encode('utf-8')
+        elif data is not None:
+            body = data
+
+        start = time.monotonic()
+        try:
+            raw_response = self.pool.request(
+                method,
+                url,
+                body=body,
+                headers=headers,
+                timeout=timeout,
+                redirect=redirect,
+                retries=False,
+                preload_content=True,
+            )
+        except HTTPError as e:
+            raise RequestException(str(e)) from e
+        elapsed = time.monotonic() - start
+        return Response(raw_response, method, url, elapsed)
+
+    def get(self, url, **kwargs):
+        kwargs.setdefault('allow_redirects', True)
+        return self.request('GET', url, **kwargs)
+
+    def post(self, url, data=None, json=None, **kwargs):
+        return self.request('POST', url, data=data, json=json, **kwargs)
+
+    def put(self, url, data=None, **kwargs):
+        return self.request('PUT', url, data=data, **kwargs)
+
+    def delete(self, url, **kwargs):
