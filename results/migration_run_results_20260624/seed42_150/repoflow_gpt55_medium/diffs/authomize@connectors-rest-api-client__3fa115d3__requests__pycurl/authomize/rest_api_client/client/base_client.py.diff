+class PycurlHTTPError(Exception):
+    pass
+
+
+class PycurlResponse:
+    def __init__(self, status_code: int, url: str, headers: dict[str, str], content: bytes):
+        self.status_code = status_code
+        self.url = url
+        self.headers = headers
+        self.content = content
+        self.reason = self.text
+
+    @property
+    def ok(self) -> bool:
+        return self.status_code < 400
+
+    @property
+    def text(self) -> str:
+        return self.content.decode('utf-8', errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if not self.ok:
+            raise PycurlHTTPError(f'{self.status_code} Error for url: {self.url}')
+
+
+class PycurlSession:
+    def __init__(self):
+        self.headers = {}
+
+    def get(self, url: str, params=None):
+        return self.request('GET', url, params=params)
+
+    def post(self, url: str, headers=None, data=None):
+        return self.request('POST', url, headers=headers, data=data)
+
+    def patch(self, url: str, headers=None, data=None):
+        return self.request('PATCH', url, headers=headers, data=data)
+
+    def delete(self, url: str, params=None):
+        return self.request('DELETE', url, params=params)
+
+    def request(self, method: str, url: str, headers=None, data=None, params=None):
+        if params:
+            separator = '&' if '?' in url else '?'
+            url = f'{url}{separator}{urlencode(params, doseq=True)}'
+
+        body = BytesIO()
+        response_headers = {}
+
+        def header_function(header_line: bytes):
+            header = header_line.decode('iso-8859-1').strip()
+            if not header:
+                return
+            if header.startswith('HTTP/'):
+                response_headers.clear()
+                return
+            name, separator, value = header.partition(':')
+            if separator:
+                response_headers[name.lower()] = value.strip()
+
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEDATA, body)
+            curl.setopt(pycurl.HEADERFUNCTION, header_function)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.HTTPHEADER, [
+                f'{name}: {value}'
+                for name, value in {**self.headers, **(headers or {})}.items()
+            ])
+            if method == 'GET':
+                curl.setopt(pycurl.HTTPGET, 1)
+            elif method == 'POST':
+                curl.setopt(pycurl.POST, 1)
+                curl.setopt(pycurl.POSTFIELDS, data or '')
+            else:
+                curl.setopt(pycurl.CUSTOMREQUEST, method)
+                if data is not None:
+                    curl.setopt(pycurl.POSTFIELDS, data)
+            curl.perform()
+            return PycurlResponse(
+                status_code=curl.getinfo(pycurl.RESPONSE_CODE),
+                url=curl.getinfo(pycurl.EFFECTIVE_URL),
+                headers=response_headers,
+                content=body.getvalue(),
+            )
+        finally:
+            curl.close()
+
+
