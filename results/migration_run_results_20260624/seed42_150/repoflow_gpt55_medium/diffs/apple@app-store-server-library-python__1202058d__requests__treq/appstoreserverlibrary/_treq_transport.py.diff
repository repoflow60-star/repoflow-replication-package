--- a/appstoreserverlibrary/_treq_transport.py
+++ b/appstoreserverlibrary/_treq_transport.py
@@ -0,0 +1,90 @@
+# Copyright (c) 2023 Apple Inc. Licensed under MIT License.
+
+import json as json_lib
+import threading
+from typing import Any, Dict, List, MutableMapping, Optional, Union
+
+import treq
+from twisted.internet import reactor, threads
+
+
+_reactor_started = threading.Event()
+_reactor_lock = threading.Lock()
+_reactor_thread: Optional[threading.Thread] = None
+
+
+class TreqResult:
+    def __init__(self, status_code: int, headers: MutableMapping[str, str], content: bytes):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+
+    def json(self):
+        return json_lib.loads(self.content.decode("utf-8"))
+
+
+def _ensure_reactor_running():
+    global _reactor_thread
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is None or not _reactor_thread.is_alive():
+            _reactor_started.clear()
+            reactor.callWhenRunning(_reactor_started.set)
+            _reactor_thread = threading.Thread(
+                target=reactor.run,
+                kwargs={"installSignalHandlers": False},
+                daemon=True,
+            )
+            _reactor_thread.start()
+    _reactor_started.wait()
+
+
+def _headers_to_mapping(headers) -> Dict[str, str]:
+    mapped_headers: Dict[str, str] = {}
+    for name, values in headers.getAllRawHeaders():
+        header_name = name.decode("ascii").lower() if isinstance(name, bytes) else name.lower()
+        if values:
+            value = values[-1]
+            mapped_headers[header_name] = value.decode("latin-1") if isinstance(value, bytes) else value
+    return mapped_headers
+
+
+def _run_treq(deferred_factory) -> TreqResult:
+    _ensure_reactor_running()
+
+    def request_and_collect():
+        deferred = deferred_factory()
+
+        def collect(response):
+            content_deferred = treq.content(response)
+
+            def build_result(content):
+                return TreqResult(response.code, _headers_to_mapping(response.headers), content)
+
+            return content_deferred.addCallback(build_result)
+
+        return deferred.addCallback(collect)
+
+    return threads.blockingCallFromThread(reactor, request_and_collect)
+
+
+def request(
+    method: str,
+    url: str,
+    params: Dict[str, Union[str, List[str]]],
+    headers: Dict[str, str],
+    json: Optional[Dict[str, Any]],
+) -> TreqResult:
+    request_headers = dict(headers)
+    data = None
+    if json is not None:
+        request_headers.setdefault("Content-Type", "application/json")
+        data = json_lib.dumps(json).encode("utf-8")
+    return _run_treq(lambda: treq.request(method, url, params=params, headers=request_headers, data=data))
+
+
+def post(url: str, headers: Dict[str, str], data: bytes) -> TreqResult:
+    return _run_treq(lambda: treq.post(url, headers=headers, data=data))
