+class HTTPResult:
+    def __init__(self, response):
+        self._response = response
+        self.headers = response.headers
+        self.status_code = response.status
+
+    @property
+    def content(self):
+        return self._response.data
+
+    @property
+    def data(self):
+        return self._response.data
+
+    @property
+    def text(self):
+        return self._response.data.decode('utf-8')
+
+    def raise_for_status(self):
+        if self._response.status >= 400:
+            raise urllib3.exceptions.HTTPError(
+                f'{self._response.status} HTTP error',
+            )
+
+
+class Urllib3Session:
+    def __init__(self):
+        self._manager = None
+        self._manager_config = None
+
+    def _get_manager(self, verify=True, proxies=None):
+        proxy = None
+        if proxies:
+            proxy = proxies.get('https') or proxies.get('http')
+
+        manager_config = (proxy, verify)
+        if self._manager is not None and self._manager_config == manager_config:
+            return self._manager
+
+        manager_kwargs = {}
+        if not verify:
+            manager_kwargs['cert_reqs'] = 'CERT_NONE'
+
+        if proxy:
+            if proxy.startswith('socks'):
+                self._manager = urllib3.contrib.socks.SOCKSProxyManager(
+                    proxy, **manager_kwargs,
+                )
+            else:
+                self._manager = urllib3.ProxyManager(proxy, **manager_kwargs)
+        else:
+            self._manager = urllib3.PoolManager(**manager_kwargs)
+        self._manager_config = manager_config
+
+        return self._manager
+
+    def request(self, method, url, verify=True, proxies=None, **kwargs):
+        manager = self._get_manager(verify=verify, proxies=proxies)
+        return HTTPResult(manager.request(method, url, **kwargs))
+
+    def get(self, url, **kwargs):
+        return self.request('GET', url, **kwargs)
+
+    def post(self, url, data=None, **kwargs):
+        if data is not None:
+            kwargs['body'] = data
+        return self.request('POST', url, **kwargs)
+
+
+REQ_SESSION = Urllib3Session()
 
