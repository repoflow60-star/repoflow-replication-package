+    @classmethod
+    def _ensure_reactor(cls):
+        if cls._reactor_started:
+            return
+
+        with cls._reactor_lock:
+            if cls._reactor_started:
+                return
+            if reactor.running:
+                cls._reactor_started = True
+                return
+
+            ready = Event()
+
+            def run_reactor():
+                reactor.callWhenRunning(ready.set)
+                reactor.run(installSignalHandlers=False)
+
+            thread = Thread(target=run_reactor, name="TreqReactor", daemon=True)
+            thread.start()
+            ready.wait()
+            cls._reactor_started = True
+
+    @inlineCallbacks
+    def _treq_request(self, method, url, headers, data, timeout):
+        request_kwargs = {"headers": headers, "data": data, "timeout": timeout, "persistent": False}
+        agent = self._proxy_agent(url)
+        if agent is not None:
+            request_kwargs["agent"] = agent
+
+        response = yield treq.request(method, url, **request_kwargs)
+        content = yield treq.content(response)
+        return content.decode("utf-8")
+
+    def _proxy_agent(self, url):
+        proxies = self.proxies or self.system_proxies
+        if not proxies:
+            return None
+
+        parsed_url = urlparse(url)
+        proxy_url = proxies.get(parsed_url.scheme)
+        if proxy_url is None:
+            return None
+
+        parsed_proxy = urlparse(proxy_url)
+        host = parsed_proxy.hostname
+        if host is None:
+            return None
+
+        port = parsed_proxy.port or (443 if parsed_proxy.scheme == "https" else 80)
+        return ProxyAgent(TCP4ClientEndpoint(reactor, host, port))
 
