+class PycurlHeaders(dict):
+    def _find_key(self, key):
+        for existing_key in self.keys():
+            if existing_key.lower() == key.lower():
+                return existing_key
+        return key
+
+    def __contains__(self, key):
+        return dict.__contains__(self, self._find_key(key))
+
+    def __getitem__(self, key):
+        return dict.__getitem__(self, self._find_key(key))
+
+    def get(self, key, default=None):
+        return dict.get(self, self._find_key(key), default)
+
+
+class PycurlResponse(object):
+    def __init__(self, status_code, headers, content, reason=''):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+        self.reason = reason
+
+    def json(self):
+        return loads(self.content.decode('utf-8') if isinstance(self.content, bytes) else self.content)
+
+
+class PycurlSession(object):
+    def __init__(self):
+        self.auth = None
+        self.headers = {}
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        body = BytesIO()
+        raw_headers = []
+
+        def collect_header(header):
+            raw_headers.append(header)
+            return len(header)
+
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            curl.setopt(pycurl.WRITEFUNCTION, body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, collect_header)
+            curl.setopt(pycurl.FOLLOWLOCATION, True)
+            if timeout is not None:
+                curl.setopt(pycurl.TIMEOUT_MS, int(timeout * 1000))
+            if self.auth:
+                curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+                curl.setopt(pycurl.USERPWD, "%s:%s" % self.auth)
+
+            request_headers = dict(self.headers)
+            if headers:
+                request_headers.update(headers)
+            if request_headers:
+                curl.setopt(pycurl.HTTPHEADER,
+                            ["%s: %s" % (key, value) for key, value in request_headers.items()])
+            if request_headers.get('Accept-Encoding'):
+                curl.setopt(pycurl.ENCODING, request_headers['Accept-Encoding'])
+
+            if data is not None:
+                content_type = request_headers.get('Content-Type', '')
+                if not isinstance(data, (str, bytes)):
+                    data = (urlencode(data) if content_type.startswith('application/x-www-form-urlencoded')
+                            else dumps(data))
+                curl.setopt(pycurl.POSTFIELDS, data)
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        response_headers, reason = self._parse_headers(raw_headers)
+        return PycurlResponse(status_code, response_headers, body.getvalue(), reason)
+
+    @staticmethod
+    def _parse_headers(raw_headers):
+        headers = PycurlHeaders()
+        reason = ''
+        for raw_header in raw_headers:
+            header = raw_header.decode('iso-8859-1').strip()
+            if not header:
+                continue
+            if header.startswith('HTTP/'):
+                parts = header.split(' ', 2)
+                reason = parts[2] if len(parts) > 2 else ''
+            elif ':' in header:
+                key, value = header.split(':', 1)
+                headers[key] = value.strip()
+        return headers, reason
 
 
