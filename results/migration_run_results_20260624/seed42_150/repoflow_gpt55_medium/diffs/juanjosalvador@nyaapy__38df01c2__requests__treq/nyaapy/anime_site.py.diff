-import requests
+import threading
+
+import treq
+from twisted.internet import defer, reactor, threads
+
 from nyaapy import torrent
 from nyaapy.parser import parse_nyaa, parse_single, parse_nyaa_rss
+
+
+_REACTOR_READY = threading.Event()
+_REACTOR_THREAD = None
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_REACTOR_READY.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _REACTOR_THREAD
+
+    if reactor.running:
+        return
+
+    if _REACTOR_THREAD is None:
+        _REACTOR_THREAD = threading.Thread(target=_run_reactor, daemon=True)
+        _REACTOR_THREAD.start()
+
+    _REACTOR_READY.wait()
+
+
+@defer.inlineCallbacks
+def _get_body(url, as_text=False):
+    response = yield treq.get(url)
+
+    if response.code >= 400:
+        phrase = response.phrase
+        if isinstance(phrase, bytes):
+            phrase = phrase.decode("ascii", "replace")
+        raise RuntimeError(f"{response.code} {phrase} for url: {url}")
+
+    if as_text:
+        body = yield treq.text_content(response)
+    else:
+        body = yield treq.content(response)
+
+    return body
+
+
+def _get(url, as_text=False):
+    _ensure_reactor()
+    return threads.blockingCallFromThread(reactor, _get_body, url, as_text)
 
 
