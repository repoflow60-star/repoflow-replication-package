+def _des_component(key: bytes, index: int) -> bytes:
+    return bytes(byte & 0xFE for byte in key[index : index + 8])
+
+
+def _collapsed_des_key(key: bytes) -> _typing.Optional[bytes]:
+    if len(key) == 8:
+        return key
+
+    component1 = _des_component(key, 0)
+    component2 = _des_component(key, 8)
+
+    if len(key) == 16:
+        if component1 == component2:
+            return key[:8]
+        return None
+
+    component3 = _des_component(key, 16)
+    if component1 == component2:
+        return key[16:24]
+    if component2 == component3:
+        return key[:8]
+    return None
+
+
+def _new_des_cipher(
+    key: bytes, mode: int, iv: _typing.Optional[bytes] = None
+) -> _typing.Any:
+    des_key = _collapsed_des_key(key)
+    cipher = _DES if des_key is not None else _DES3
+    cipher_key = des_key if des_key is not None else key
+
+    if iv is None:
+        return cipher.new(cipher_key, mode)
+    return cipher.new(cipher_key, mode, iv)
+
