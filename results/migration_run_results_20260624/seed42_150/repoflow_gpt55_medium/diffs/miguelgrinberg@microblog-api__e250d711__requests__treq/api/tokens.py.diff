+reactor_lock = threading.Lock()
+
+
+class TreqResponse:
+    def __init__(self, status_code, json_data):
+        self.status_code = status_code
+        self._json_data = json_data
+
+    def json(self):
+        return self._json_data
+
+
+class TreqClient:
+    def request(self, method, url, **kwargs):
+        if not reactor.running:
+            with reactor_lock:
+                if not reactor.running:
+                    reactor_started = threading.Event()
+
+                    def run_reactor():
+                        reactor.callWhenRunning(reactor_started.set)
+                        reactor.run(installSignalHandlers=False)
+
+                    threading.Thread(target=run_reactor, daemon=True).start()
+                    reactor_started.wait()
+
+        @inlineCallbacks
+        def request_json():
+            response = yield getattr(treq, method)(url, **kwargs)
+            content = yield treq.json_content(response)
+            return TreqResponse(response.code, content)
+
+        return blockingCallFromThread(reactor, request_json)
+
+    def post(self, url, **kwargs):
+        return self.request('post', url, **kwargs)
+
+    def get(self, url, **kwargs):
+        return self.request('get', url, **kwargs)
+
+
+http_client = TreqClient()
+requests = http_client
 
 
