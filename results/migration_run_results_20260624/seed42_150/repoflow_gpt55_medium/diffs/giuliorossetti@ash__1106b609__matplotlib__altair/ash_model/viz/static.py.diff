+
+def __altair_kwargs(kwargs, opacity=None):
+    mark_kwargs = {k: v for k, v in kwargs.items() if k != "ax"}
+    if "alpha" in mark_kwargs:
+        mark_kwargs["opacity"] = mark_kwargs.pop("alpha")
+    if opacity is not None and "opacity" not in mark_kwargs:
+        mark_kwargs["opacity"] = opacity
+    return mark_kwargs
+
+
+def __with_base_chart(chart, kwargs):
+    if "ax" in kwargs:
+        return alt.layer(kwargs["ax"], chart)
+    return chart
 
 
