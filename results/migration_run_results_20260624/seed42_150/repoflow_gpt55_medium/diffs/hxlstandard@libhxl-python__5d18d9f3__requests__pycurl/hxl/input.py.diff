+########################################################################
+# HTTP helpers
+########################################################################
+
+class _HTTPResponse(object):
+    """Small pycurl-backed response object for the attributes used here."""
+
+    def __init__(self, url, status_code, headers, content):
+        self.url = url
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+
+    @property
+    def is_redirect(self):
+        return self.status_code in range(300, 400) and self.headers.get('location') is not None
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise HXLIOException("HTTP error {} for {}".format(self.status_code, self.url), url=self.url)
+
+    def json(self):
+        return json.loads(self.content.decode('utf-8'))
+
+
+def _parse_http_headers(raw_headers):
+    headers = {}
+    blocks = [block for block in raw_headers.split(b'\r\n\r\n') if block.strip()]
+    if not blocks:
+        return headers
+    for line in blocks[-1].splitlines()[1:]:
+        try:
+            name, value = line.decode('iso-8859-1').split(':', 1)
+            headers[name.strip().lower()] = value.strip()
+        except ValueError:
+            pass
+    return headers
+
+
+def _encode_http_data(data):
+    if data is None:
+        return b''
+    if isinstance(data, bytes):
+        return data
+    if isinstance(data, str):
+        return data.encode('utf-8')
+    return urllib.parse.urlencode(data, doseq=True).encode('utf-8')
+
+
+def _http_request(method, url, verify=True, timeout=None, headers=None, params=None, data=None, follow_redirects=True):
+    if params:
+        separator = '&' if urllib.parse.urlparse(url).query else '?'
+        url = url + separator + urllib.parse.urlencode(params, doseq=True)
+
+    body = io.BytesIO()
+    raw_headers = io.BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url.encode('utf-8'))
+        curl.setopt(pycurl.WRITEDATA, body)
+        curl.setopt(pycurl.HEADERFUNCTION, raw_headers.write)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1 if follow_redirects else 0)
+        curl.setopt(pycurl.SSL_VERIFYPEER, 1 if verify else 0)
+        curl.setopt(pycurl.SSL_VERIFYHOST, 2 if verify else 0)
+        encoding_option = getattr(pycurl, 'ACCEPT_ENCODING', None) or getattr(pycurl, 'ENCODING', None)
+        if encoding_option is not None:
+            curl.setopt(encoding_option, '')
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT_MS, int(float(timeout) * 1000))
+        if headers:
+            curl.setopt(pycurl.HTTPHEADER, ["{}: {}".format(name, value) for name, value in headers.items()])
+        if method == 'HEAD':
+            curl.setopt(pycurl.NOBODY, 1)
+        elif method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, _encode_http_data(data))
+        else:
+            curl.setopt(pycurl.HTTPGET, 1)
+        curl.perform()
+        effective_url = curl.getinfo(pycurl.EFFECTIVE_URL) or url
+        return _HTTPResponse(
+            effective_url,
+            curl.getinfo(pycurl.RESPONSE_CODE),
+            _parse_http_headers(raw_headers.getvalue()),
+            body.getvalue()
+        )
+    except pycurl.error as e:
+        raise HXLIOException(str(e), url=url)
+    finally:
+        curl.close()
+
+
+def _http_get(url, verify=True, timeout=None, headers=None, params=None):
+    return _http_request('GET', url, verify=verify, timeout=timeout, headers=headers, params=params)
+
+
+def _http_head(url, verify=True, timeout=None, headers=None):
+    return _http_request('HEAD', url, verify=verify, timeout=timeout, headers=headers, follow_redirects=False)
+
+
+def _http_post(url, verify=True, timeout=None, headers=None, data=None):
+    return _http_request('POST', url, verify=verify, timeout=timeout, headers=headers, data=data)
 
 
