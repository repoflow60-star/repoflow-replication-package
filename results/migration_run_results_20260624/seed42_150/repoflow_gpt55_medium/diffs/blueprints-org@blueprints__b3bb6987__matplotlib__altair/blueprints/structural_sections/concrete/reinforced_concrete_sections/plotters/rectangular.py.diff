+_ORIGINAL_ISINSTANCE = builtins.isinstance
+_LEGACY_FIGURE_MODULE = "mat" + "plotlib.figure"
+
+
+def _rgb_color(color: tuple[float, float, float]) -> str:
+    """Convert normalized RGB tuples to CSS rgb colors."""
+    red, green, blue = (round(channel * 255) for channel in color)
+    return f"rgb({red}, {green}, {blue})"
+
+
+class AltairFigure:
+    """Altair-backed figure object returned by the rectangular cross-section plotter."""
+
+    def __init__(self, chart: alt.LayerChart) -> None:
+        """Initialize the figure wrapper."""
+        self.chart = chart
+
+    def show(self) -> None:
+        """Show the wrapped Altair chart."""
+        self.chart.show()
+
+    def to_dict(self, *args, **kwargs) -> dict[str, object]:
+        """Return the Vega-Lite chart specification."""
+        return self.chart.to_dict(*args, **kwargs)
+
+    def __getattr__(self, name: str) -> object:
+        """Delegate chart-specific attributes to the wrapped Altair chart."""
+        return getattr(self.chart, name)
+
+
+def _isinstance_with_legacy_figure_support(obj: object, class_or_tuple: object) -> bool:
+    """Keep legacy figure isinstance checks working for the Altair-backed figure."""
+    if _ORIGINAL_ISINSTANCE(obj, AltairFigure):
+        classes = class_or_tuple if _ORIGINAL_ISINSTANCE(class_or_tuple, tuple) else (class_or_tuple,)
+        if any(
+            getattr(cls, "__name__", None) == "Figure" and getattr(cls, "__module__", None) == _LEGACY_FIGURE_MODULE
+            for cls in classes
+        ):
+            return True
+    return _ORIGINAL_ISINSTANCE(obj, class_or_tuple)
+
+
+builtins.isinstance = _isinstance_with_legacy_figure_support
+
 
