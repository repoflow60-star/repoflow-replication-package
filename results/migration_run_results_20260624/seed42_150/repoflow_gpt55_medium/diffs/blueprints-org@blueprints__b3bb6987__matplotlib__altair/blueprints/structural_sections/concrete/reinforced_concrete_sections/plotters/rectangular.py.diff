+    def _line_chart(
+        self,
+        x: float,
+        y: float,
+        x2: float,
+        y2: float,
+        color: str = "black",
+        stroke_width: float = 1.0,
+        linestyle: str = "solid",
+    ) -> alt.Chart:
+        """Create a line layer in cross-section coordinates."""
+        mark_options: dict[str, float | str | list[int]] = {"color": color, "strokeWidth": stroke_width}
+        if linestyle in {"dashdot", "-."}:
