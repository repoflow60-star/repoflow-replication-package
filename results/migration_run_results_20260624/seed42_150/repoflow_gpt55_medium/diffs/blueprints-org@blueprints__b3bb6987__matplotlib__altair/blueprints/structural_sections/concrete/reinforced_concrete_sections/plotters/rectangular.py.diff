+            .mark_rect(fill=fill, stroke=stroke, strokeWidth=stroke_width)
+            .encode(
+                x=alt.X("x:Q", axis=None, scale=alt.Scale(domain=self._x_domain())),
+                y=alt.Y("y:Q", axis=None, scale=alt.Scale(domain=self._y_domain())),
