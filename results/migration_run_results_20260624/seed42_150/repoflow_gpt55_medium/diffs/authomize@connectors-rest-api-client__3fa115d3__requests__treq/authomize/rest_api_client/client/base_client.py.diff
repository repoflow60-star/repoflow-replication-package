+class HTTPStatusError(Exception):
+    pass
+
+
+class TreqResponse:
+    def __init__(self, response, content: bytes, url: str):
+        self.status_code = response.code
+        self.ok = 200 <= response.code < 400
+        self.url = url
+        self.content = content
+        self.text = content.decode('utf-8', errors='replace')
+        self.reason = self._decode(response.phrase)
+        self.headers = {
+            self._decode(name).lower(): self._decode(values[-1])
+            for name, values in response.headers.getAllRawHeaders()
+        }
+
+    @staticmethod
+    def _decode(value):
+        if isinstance(value, bytes):
+            return value.decode('utf-8', errors='replace')
+        return value
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if not self.ok:
+            raise HTTPStatusError(f'{self.status_code} Error: {self.reason} for url: {self.url}')
+
