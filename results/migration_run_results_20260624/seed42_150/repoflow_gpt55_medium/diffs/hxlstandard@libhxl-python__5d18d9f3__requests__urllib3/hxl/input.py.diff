+    os.path, re, shutil, six, sys, \
+    tempfile, time, urllib.parse, urllib3, xlrd3 as xlrd, zipfile
 
 logger = logging.getLogger(__name__)
+
+_HTTP_RETRIES = urllib3.util.Retry(total=3, connect=0, read=0, redirect=3, status=0)
+_HTTP = {}
+
+
+def _http_request(method, url, verify=True, headers=None, params=None, data=None, timeout=None, redirect=True, **kwargs):
+    """Make an HTTP request with urllib3 using request-like defaults."""
+    cert_reqs = 'CERT_REQUIRED' if verify else 'CERT_NONE'
+    http = _HTTP.get(cert_reqs)
+    if http is None:
+        http = urllib3.PoolManager(cert_reqs=cert_reqs)
+        _HTTP[cert_reqs] = http
+
+    request_headers = dict(headers or {})
+    request_kwargs = dict(kwargs)
+    request_kwargs['headers'] = request_headers
+    request_kwargs['retries'] = _HTTP_RETRIES if redirect else False
+    request_kwargs['redirect'] = redirect
+    if timeout is not None:
+        request_kwargs['timeout'] = timeout
+    if params is not None:
+        request_kwargs['fields'] = params
+    if data is not None:
+        request_headers.setdefault('Content-Type', 'application/x-www-form-urlencoded')
+        request_kwargs['body'] = urllib.parse.urlencode(data)
+
+    try:
+        return http.request(method, url, **request_kwargs)
+    except urllib3.exceptions.HTTPError as e:
+        raise HXLIOException(str(e), url=url)
+
+
+def _raise_for_status(response, url):
+    """Raise an IOError-compatible exception for non-success HTTP responses."""
+    if response.status >= 400:
+        raise HXLIOException("{} Error for url: {}".format(response.status, url), url=url)
+
+
+def _response_json(response):
+    """Decode an HTTP response body as JSON."""
+    return json.loads(response.data.decode('utf-8'))
 
