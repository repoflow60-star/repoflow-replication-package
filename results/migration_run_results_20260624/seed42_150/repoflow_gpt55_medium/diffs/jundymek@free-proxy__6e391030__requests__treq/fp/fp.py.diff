 import lxml.html as lh
-import requests
+import treq
+from twisted.internet import reactor
+from twisted.internet.defer import inlineCallbacks, returnValue
+from twisted.internet.endpoints import TCP4ClientEndpoint
+from twisted.internet.threads import blockingCallFromThread
+from twisted.web.client import ProxyAgent
 
 from fp.errors import FreeProxyException
+
+
+_reactor_started = False
+_reactor_lock = threading.Lock()
+
+
+def _ensure_reactor():
+    global _reactor_started
+    with _reactor_lock:
+        if not _reactor_started:
+            thread = threading.Thread(
+                target=reactor.run,
+                kwargs={'installSignalHandlers': False},
+                daemon=True
+            )
+            thread.start()
+            _reactor_started = True
+
+
+def _run_in_reactor(function, *args, **kwargs):
+    _ensure_reactor()
+    return blockingCallFromThread(reactor, function, *args, **kwargs)
+
+
+@inlineCallbacks
+def _get_content(url):
+    response = yield treq.get(url)
+    content = yield treq.content(response)
+    returnValue(content)
+
+
+@inlineCallbacks
+def _get_through_proxy(url, proxy_url, timeout):
+    proxy = urlparse(proxy_url)
+    endpoint = TCP4ClientEndpoint(
+        reactor,
+        proxy.hostname,
+        proxy.port,
+        timeout=timeout
+    )
+    agent = ProxyAgent(endpoint)
+    response = yield treq.get(url, agent=agent, timeout=timeout)
+    yield treq.content(response)
+    returnValue(response)
 
 
