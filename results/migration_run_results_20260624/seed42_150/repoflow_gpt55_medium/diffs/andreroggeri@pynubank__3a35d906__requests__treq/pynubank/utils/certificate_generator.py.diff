+class _PKCS12Certificate:
+    def __init__(self, key: PKey, cert: X509):
+        self.key = key
+        self.cert = cert
+
+    def export(self) -> bytes:
+        private_key = serialization.load_pem_private_key(
+            OpenSSL.crypto.dump_privatekey(OpenSSL.crypto.FILETYPE_PEM, self.key),
+            password=None,
+        )
+        certificate = x509.load_pem_x509_certificate(
+            OpenSSL.crypto.dump_certificate(OpenSSL.crypto.FILETYPE_PEM, self.cert),
+        )
+        return pkcs12.serialize_key_and_certificates(
+            name=None,
+            key=private_key,
+            cert=certificate,
+            cas=None,
+            encryption_algorithm=serialization.NoEncryption(),
+        )
