+    def _request(self, method: Any, url: str, **kwargs) -> Any:
+        self._ensure_reactor_running()
+
+        def make_request():
+            result = method(url, headers=self._headers, **kwargs, **self._cert_args)
+            if not hasattr(result, 'addCallback'):
+                return result
+
+            def collect(response):
+                return treq.content(response).addCallback(lambda body: self._to_http_response(response, body, url))
+
+            result.addCallback(collect)
+            return result
+
+        return threads.blockingCallFromThread(reactor, make_request)
