+    @staticmethod
+    def _to_http_response(response: Any, content: bytes, url: str) -> HttpResponse:
+        headers = {}
+        raw_headers = getattr(response, 'headers', {}) or {}
+        if hasattr(raw_headers, 'getAllRawHeaders'):
+            for name, values in raw_headers.getAllRawHeaders():
+                header_name = name.decode() if isinstance(name, bytes) else name
+                header_value = values[-1] if values else ''
+                headers[header_name] = header_value.decode() if isinstance(header_value, bytes) else header_value
+        else:
+            headers = dict(raw_headers)
+
+        request = getattr(response, 'request', None)
+        response_url = getattr(response, 'url', '') or (request.absoluteURI.decode() if request else url)
+        return HttpResponse(
+            status_code=getattr(response, 'code', getattr(response, 'status_code', 0)),
+            url=response_url,
+            headers=headers,
+            content=content,
+        )
+
+    @staticmethod
+    def _ensure_reactor_running():
+        if reactor.running:
+            return
+
+        with _reactor_lock:
