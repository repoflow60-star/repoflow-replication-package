+def __figure(kwargs):
+    return kwargs["ax"] if "ax" in kwargs else go.Figure()
+
+
+def __trace_kwargs(kwargs, line=True):
+    params = {k: v for k, v in kwargs.items() if k != "ax"}
+    trace = {}
+    if "label" in params:
+        trace["name"] = params.pop("label")
+    if "alpha" in params:
+        trace["opacity"] = params.pop("alpha")
+    if "color" in params:
+        color = params.pop("color")
+        trace["marker"] = {"color": color}
+        if line:
+            trace["line"] = {"color": color}
+    trace.update(params)
+    return trace
 
 
