 _GRAPHQL_API_URL = "https://apis.justwatch.com/graphql"
+_HTTP = urllib3.PoolManager()
+
+
+class _PostResult:
+    def __init__(self, response, url: str) -> None:
+        self._response = response
+        self._url = url
+
+    def raise_for_status(self) -> None:
+        if not 200 <= self._response.status < 300:
+            raise urllib3.exceptions.HTTPError(
+                f"Error response {self._response.status} while requesting {self._url}"
+            )
+
+    def json(self) -> object:
+        return jsonlib.loads(self._response.data.decode("utf-8"))
+
+
+def post(url: str, *, json: object | None = None) -> _PostResult:
+    body = None if json is None else jsonlib.dumps(json).encode("utf-8")
+    return _PostResult(
+        _HTTP.request(
+            "POST",
+            url,
+            body=body,
+            headers={"Content-Type": "application/json"},
+        ),
+        url,
+    )
 
 
