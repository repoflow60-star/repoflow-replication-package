+_reactor_lock = Lock()
+_reactor_started = Event()
+_reactor_thread = None
+
+
+def _ensure_reactor():
+    global _reactor_thread
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if reactor.running:
+            return
+
+        _reactor_thread = Thread(
+            target=reactor.run,
+            kwargs={'installSignalHandlers': False},
+            daemon=True,
+        )
+        reactor.callWhenRunning(_reactor_started.set)
+        _reactor_thread.start()
+        _reactor_started.wait()
+
+
+class _TreqResponse(object):
+    """Expose the response fields used by the existing synchronous API."""
+
+    def __init__(self, response, content):
+        self.status_code = response.code
+        self.reason = self._decode(getattr(response, 'phrase', ''))
+        self.text = self._decode(content)
+        self.headers = {}
+        for name, values in response.headers.getAllRawHeaders():
+            if values:
+                self.headers[self._decode(name)] = self._decode(values[-1])
+
+    @staticmethod
+    def _decode(value):
+        if isinstance(value, bytes):
+            return value.decode('utf-8', errors='replace')
+        return value
+
+    def json(self):
+        return json.loads(self.text)
+
+
+def _post(url, data, headers, timeout):
+    """Perform a treq request while retaining the library's sync boundary."""
+    _ensure_reactor()
+    response = threads.blockingCallFromThread(
+        reactor,
+        treq.post,
+        url,
+        data=data,
+        headers=headers,
+        timeout=timeout,
+    )
+    content = threads.blockingCallFromThread(reactor, treq.content, response)
+    return _TreqResponse(response, content)
 
 
