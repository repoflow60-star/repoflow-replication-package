+def tabulate(rows: List[List], headers: List[str], tablefmt: str) -> str:
+    """Render a report table with Rich using the historical output formats."""
+    display_rows = [
+        ["" if value is None else str(value) for value in row] for row in rows
+    ]
+    column_widths = [
+        max(len(header), *(len(row[index]) for row in display_rows))
+        for index, header in enumerate(headers)
+    ]
+
+    table = Table(
+        box=None,
+        show_header=True,
+        header_style="bold",
+        padding=(0, 1),
+        pad_edge=False,
+        expand=False,
+        highlight=False,
+    )
+    for header in headers:
+        table.add_column(header, no_wrap=True)
+    for row in display_rows:
+        table.add_row(*row)
+
+    output = StringIO()
+    console = Console(
+        file=output,
+        force_terminal=False,
+        color_system=None,
+        markup=False,
+        width=max(80, sum(column_widths) + 2 * len(headers)),
+    )
+    console.print(table)
+
+    if tablefmt == "rst":
+        separator = " ".join("=" * (width + 2) for width in column_widths)
+        header_separator = " ".join("-" * (width + 2) for width in column_widths)
+        header_row = " ".join(
+            f" {value:<{width}} " for value, width in zip(headers, column_widths)
+        )
+        body = [
+            " ".join(
+                f" {value:<{width}} " for value, width in zip(row, column_widths)
+            )
+            for row in display_rows
+        ]
+        return "\n".join(
+            [separator, header_row, header_separator, *body, separator]
+        )
+
+    body = [
+        "| "
+        + " | ".join(
+            f"{value:<{width}}" for value, width in zip(row, column_widths)
+        )
+        + " |"
+        for row in display_rows
+    ]
+    header = "| " + " | ".join(
+        f"{value:<{width}}" for value, width in zip(headers, column_widths)
+    ) + " |"
+    divider = "|" + "|".join("-" * (width + 2) for width in column_widths) + "|"
+    return "\n".join([header, divider, *body])
 
 
