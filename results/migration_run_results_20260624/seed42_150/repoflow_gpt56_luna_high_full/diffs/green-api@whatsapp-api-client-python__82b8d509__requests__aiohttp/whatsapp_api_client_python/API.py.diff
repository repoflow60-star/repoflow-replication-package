+                except (aiohttp.ClientError, asyncio.TimeoutError):
+                    if attempt == 3:
+                        raise
+
+                await asyncio.sleep(1.0 * (2 ** attempt))
+
+        raise RuntimeError("Request retry loop exited unexpectedly")
+
