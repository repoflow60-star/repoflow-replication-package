+class _PycurlResponse:
+    """Response data collected from a pycurl request."""
+
+    def __init__(self, content: bytes, status_code: int):
+        self.content = content
+        self.status_code = status_code
+
+    def raise_for_status(self):
+        """Raise an exception for an unsuccessful HTTP status."""
+        if self.status_code >= 400:
+            raise RuntimeError("HTTP error {}".format(self.status_code))
+
+    def json(self):
+        """Decode the response body as JSON."""
+        return json_module.loads(self.content.decode("utf-8"))
+
+
+class _PycurlSession:
+    """Small session implementation backed by a real pycurl handle."""
+
+    def __init__(self):
+        self._curl = pycurl.Curl()
+        self.headers: Dict[str, str] = {}
+
+    def request(
+        self,
+        method: str,
+        url: str,
+        params: Optional[Dict] = None,
+        data: Optional[Any] = None,
+        json: Optional[Dict] = None,
+        timeout: Optional[int] = None,
+        headers: Optional[Dict[str, str]] = None,
+    ) -> _PycurlResponse:
+        """Perform an HTTP request through pycurl."""
+        if params:
+            query = urlencode(params, doseq=True)
+            url += ("&" if "?" in url else "?") + query
+
+        request_headers = self.headers if headers is None else headers
+        header_values = ["{}: {}".format(key, value) for key, value in request_headers.items()]
+        request_method = method.upper()
+        response_body = io.BytesIO()
+        curl = self._curl
+
+        if curl is None:
+            raise RuntimeError("Session is closed")
+
+        curl.reset()
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.CUSTOMREQUEST, request_method)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+        curl.setopt(pycurl.TIMEOUT, 30 if timeout is None else timeout)
+
+        if json is not None:
+            body = json_module.dumps(json).encode("utf-8")
+            if not any(key.lower() == "content-type" for key in request_headers):
+                header_values.append("Content-Type: application/json")
+            curl.setopt(pycurl.POSTFIELDS, body)
+        elif data is not None:
+            if isinstance(data, dict):
+                data = urlencode(data, doseq=True)
+                if not any(key.lower() == "content-type" for key in request_headers):
+                    header_values.append("Content-Type: application/x-www-form-urlencoded")
+            body = data.encode("utf-8") if isinstance(data, str) else data
+            curl.setopt(pycurl.POSTFIELDS, body)
+
+        if request_method == "GET":
+            curl.setopt(pycurl.HTTPGET, True)
+        elif request_method == "POST":
+            curl.setopt(pycurl.POST, True)
+
+        curl.setopt(pycurl.HTTPHEADER, header_values)
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        return _PycurlResponse(response_body.getvalue(), status_code)
+
+    def get(self, url: str, **kwargs) -> _PycurlResponse:
+        """Perform a GET request."""
+        return self.request("GET", url, **kwargs)
+
+    def post(self, url: str, **kwargs) -> _PycurlResponse:
+        """Perform a POST request."""
+        return self.request("POST", url, **kwargs)
+
+    def close(self):
+        """Close the underlying curl handle."""
+        if self._curl is not None:
+            self._curl.close()
+            self._curl = None
 
 
