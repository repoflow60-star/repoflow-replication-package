+def _get_figure(kwargs: Dict[str, Any]) -> go.Figure:
+    figure = kwargs.get("ax")
+    if figure is None:
+        return go.Figure()
+    if not isinstance(figure, go.Figure):
+        raise TypeError("ax must be a plotly.graph_objects.Figure")
+    return figure
+
+
+def _trace_options(kwargs: Dict[str, Any], style: str) -> Dict[str, Any]:
+    options = {key: value for key, value in kwargs.items() if key != "ax"}
+    if "alpha" in options:
+        options["opacity"] = options.pop("alpha")
+    if "label" in options:
+        options.setdefault("name", options.pop("label"))
+
+    color = options.pop("color", None)
+    if color is not None:
+        existing = options.get(style)
+        target = dict(existing) if isinstance(existing, dict) else {}
+        target.setdefault("color", color)
+        options[style] = target
+
+    if "marker" in options and not isinstance(options["marker"], dict):
+        marker = options["marker"]
+        symbols = {".": "circle", "o": "circle", "s": "square", "x": "x", "+": "cross"}
+        options["marker"] = {"symbol": symbols.get(marker, marker)}
+    if "linestyle" in options:
+        dash = {"-": "solid", "--": "dash", "-.": "dashdot", ":": "dot"}
+        linestyle = options.pop("linestyle")
+        existing = options.get("line")
+        line = dict(existing) if isinstance(existing, dict) else {}
+        line.setdefault("dash", dash.get(linestyle, linestyle))
+        options["line"] = line
+    if "linewidth" in options:
+        existing = options.get("line")
+        line = dict(existing) if isinstance(existing, dict) else {}
+        line.setdefault("width", options.pop("linewidth"))
+        options["line"] = line
+    if "markersize" in options:
+        existing = options.get("marker")
+        marker = dict(existing) if isinstance(existing, dict) else {}
+        marker.setdefault("size", options.pop("markersize"))
+        options["marker"] = marker
+    return options
+
+
+def _kde(values):
+    data = np.asarray(values, dtype=float)
+    if data.size == 0:
+        return None
+
+    spread = np.std(data, ddof=1) if data.size > 1 else 0.0
+    bandwidth = 1.06 * spread * data.size ** (-0.2)
+    if not np.isfinite(bandwidth) or bandwidth <= 0:
+        bandwidth = max(float(np.max(np.abs(data))) * 1e-3, 0.01)
+
+    x = np.linspace(
+        np.min(data) - 3 * bandwidth,
+        np.max(data) + 3 * bandwidth,
+        200,
+    )
+    distances = (x[:, np.newaxis] - data[np.newaxis, :]) / bandwidth
+    density = np.exp(-0.5 * distances**2).sum(axis=1)
+    density /= data.size * bandwidth * np.sqrt(2 * np.pi)
+    return x, density
+
