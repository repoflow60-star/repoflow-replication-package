+def plot_hyperedge_size_distribution(
+    h: ASH, max_size: int = None, min_size: int = None, **kwargs: object
+) -> object:
+    """Plot the distribution of hyperedge sizes in a Plotly figure."""
+    figure = _get_figure(kwargs)
+
+    size_dist = dict(h.hyperedge_size_distribution())
+    if max_size:
+        size_dist = {k: v for k, v in size_dist.items() if k <= max_size}
+    if min_size:
+        size_dist = {k: v for k, v in size_dist.items() if k >= min_size}
+    x, y = zip(*size_dist.items())
+
+    options = _trace_options(kwargs, "marker")
+    options.setdefault("opacity", 0.4)
+    figure.add_trace(go.Bar(x=np.array(x), y=y, **options))
+    return figure
+
+
+def plot_degree_distribution(h: ASH, loglog: bool = True, **kwargs: object) -> object:
+    """Plot the degree distribution of an ASH in a Plotly figure."""
+    figure = _get_figure(kwargs)
+    nodes = h.get_node_set()
+    degs = {n: h.get_degree(n) for n in nodes}
+    deg = dict(sorted(degs.items(), key=lambda item: item[1], reverse=True))
+    y = np.bincount(list(deg.values()))
+
+    options = _trace_options(kwargs, "marker")
+    options.setdefault("opacity", 0.4)
+    options.setdefault("mode", "markers")
+    figure.add_trace(go.Scatter(x=list(range(0, len(y))), y=y, **options))
+    if loglog:
+        figure.update_xaxes(type="log")
+        figure.update_yaxes(type="log")
+    return figure
+
+
+def plot_s_ranks(h: ASH, smax: int, loglog: bool = True, **kwargs: object) -> object:
+    """Plot the ranked s-degree distributions in a Plotly figure."""
+    figure = _get_figure(kwargs)
+
+    nodes = h.get_node_set()
+    ss = np.arange(1, smax + 1, 1)
+    degs = {s: {n: 0 for n in nodes} for s in ss}
+    for n in nodes:
+        for s in ss:
+            degs[s][n] = h.get_s_degree(n, s)
+
+    for s in ss:
+        deg = dict(sorted(degs[s].items(), key=lambda item: item[1], reverse=True))
+        y = list(deg.values())
+        options = _trace_options(kwargs, "marker")
+        options.setdefault("opacity", 0.4)
+        options.setdefault("name", "s_" + str(s))
+        options.setdefault("mode", "markers")
+        options.setdefault("showlegend", False)
+        figure.add_trace(
+            go.Scatter(x=list(range(len(y))), y=y, **options)
+        )
+
+    if loglog:
+        figure.update_xaxes(type="log")
+        figure.update_yaxes(type="log")
+    return figure
