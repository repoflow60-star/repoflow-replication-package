+            connector = aiohttp.TCPConnector(**self._connector_options)
+        return aiohttp.ClientSession(
+            timeout=timeout,
+            connector=connector,
+            trust_env=False,
+        )
+
+    def _run_loop(self):
+        asyncio.set_event_loop(self._loop)
+        try:
+            self._session = self._loop.run_until_complete(self._create_session())
+        except BaseException as error:
+            self._startup_error = error
+            self._ready.set()
+            self._loop.close()
+            return
+
+        self._ready.set()
+        self._loop.run_forever()
+        self._loop.close()
+
+    def _run(self, awaitable):
+        return asyncio.run_coroutine_threadsafe(awaitable, self._loop).result()
+
+    async def _request(self, method, url, fields, body, headers, options):
+        request_options = dict(options)
+        decode_content = request_options.pop("decode_content", True)
+        request_options.pop("preload_content", None)
+        request_options["auto_decompress"] = decode_content
+        if body is not None:
