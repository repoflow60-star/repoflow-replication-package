+class _HttpResult:
+    def __init__(self, status_code: int, headers: dict, content: bytes, url: str):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+        self.url = url
+        self.reason = ''
+
+    @property
+    def ok(self) -> bool:
+        return self.status_code < 400
+
+    @property
+    def text(self) -> str:
+        return self.content.decode('utf-8', errors='replace')
+
+    def json(self):
+        return json.loads(self.content.decode('utf-8'))
+
+    def raise_for_status(self):
+        raise ClientError(f'HTTP {self.status_code} response from {self.url}')
+
+
+_reactor_lock = Lock()
+_reactor_ready = Event()
+_reactor_thread = None
+
+
+def _start_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _reactor_thread
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if not reactor.running and _reactor_thread is None:
+            _reactor_thread = Thread(target=_start_reactor, daemon=True)
+            _reactor_thread.start()
+    _reactor_ready.wait()
+
+
+@defer.inlineCallbacks
+def _request(request, method, url, headers=None, params=None, data=None):
+    request_headers = {
+        name: [value] if isinstance(value, (str, bytes)) else value
+        for name, value in (headers or {}).items()
+    }
+    response = yield request(
+        method,
+        url,
+        headers=request_headers,
+        params=params,
+        data=data,
+    )
+    content = yield treq.content(response)
+
+    response_headers = {}
+    for name, values in response.headers.getAllRawHeaders():
+        if isinstance(name, bytes):
+            name = name.decode('latin-1')
+        value = values[0] if isinstance(values, (list, tuple)) else values
+        if isinstance(value, bytes):
+            value = value.decode('latin-1')
+        response_headers[name.lower()] = value
+
+    result = _HttpResult(
+        status_code=response.code,
+        headers=response_headers,
+        content=content,
+        url=url,
+    )
+    return result
+
+
+def _blocking_request(request, method, url, headers=None, params=None, data=None):
+    _ensure_reactor()
+    return blockingCallFromThread(
+        reactor,
+        _request,
+        request,
+        method,
+        url,
+        headers,
+        params,
+        data,
+    )
+
