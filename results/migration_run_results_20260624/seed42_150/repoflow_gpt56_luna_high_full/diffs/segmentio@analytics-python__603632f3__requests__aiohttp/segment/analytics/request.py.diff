+class _HttpResult:
+    """Buffered response with the synchronous interface used by this package."""
+
+    def __init__(self, status_code, headers, body, reason):
+        self.status_code = status_code
+        self.headers = headers
+        self._body = body
+        self.reason = reason
+
+    def json(self, **kwargs):
+        return json.loads(self.text, **kwargs)
+
+    @property
+    def text(self):
+        return self._body.decode('utf-8', errors='replace')
+
+
+async def _post_async(url, data, headers, timeout, proxy):
+    client_timeout = aiohttp.ClientTimeout(total=timeout) if timeout is not None else None
+    async with aiohttp.ClientSession() as session:
+        async with session.post(
+            url,
+            data=data,
+            headers=headers,
+            timeout=client_timeout,
+            proxy=proxy,
+            allow_redirects=True,
+        ) as response:
+            body = await response.read()
+            return _HttpResult(response.status, response.headers, body, response.reason)
+
+
+def _run_async(coroutine_factory):
+    """Run an aiohttp operation without changing the package's sync API."""
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coroutine_factory())
+
+    result = []
+    error = []
+
+    def run_in_thread():
+        try:
+            result.append(asyncio.run(coroutine_factory()))
+        except BaseException as exc:
+            error.append(exc)
+
+    thread = threading.Thread(target=run_in_thread)
+    thread.start()
+    thread.join()
+    if error:
+        raise error[0]
+    return result[0]
+
+
+def _proxy_url(proxies):
+    if isinstance(proxies, dict):
+        proxy = proxies.get('https') or proxies.get('http')
+    else:
+        proxy = proxies
+    if proxy and '://' not in proxy:
+        proxy = 'http://' + proxy
+    return proxy
+
+
+class _AiohttpSession:
+    """Small sync facade around aiohttp for the package's existing call sites."""
+
+    def post(self, url, data=None, headers=None, timeout=None, proxies=None):
+        proxy = _proxy_url(proxies)
+        return _run_async(
+            lambda: _post_async(url, data, headers, timeout, proxy)
+        )
+
+
+_session = _AiohttpSession()
 
 
