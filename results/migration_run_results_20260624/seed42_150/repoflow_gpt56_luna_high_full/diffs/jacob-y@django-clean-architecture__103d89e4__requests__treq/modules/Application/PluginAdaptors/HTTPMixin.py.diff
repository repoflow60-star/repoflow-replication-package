+
+_reactor_started = threading.Event()
+_reactor_lock = threading.Lock()
+_reactor_thread = None
+
+
+def _run_reactor() -> None:
+    reactor.callWhenRunning(_reactor_started.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor() -> None:
+    global _reactor_thread
+
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if _reactor_thread is None:
+            _reactor_thread = threading.Thread(target=_run_reactor, daemon=True)
+            _reactor_thread.start()
+    _reactor_started.wait()
+
+
+def _wait_for(deferred_factory):
+    """Run one treq operation while keeping this module's sync API."""
+    _ensure_reactor()
+    completed = threading.Event()
+    result = []
+    error = []
+
+    def succeeded(value):
+        result.append(value)
+        completed.set()
+
+    def failed(failure):
+        error.append(failure.value)
+        completed.set()
+
+    def start_request():
+        try:
+            maybeDeferred(deferred_factory).addCallbacks(succeeded, failed)
+        except Exception as exception:
+            error.append(exception)
+            completed.set()
+
+    reactor.callFromThread(start_request)
+    completed.wait()
+    if error:
+        raise error[0]
+    return result[0]
 
 
