 class Struct(object):
     def __init__(self, **kwargs):
         self.__dict__.update(kwargs)
+
+
+def _auth_headers(headers, api_key):
+    credentials = base64.b64encode('{}:'.format(api_key).encode('utf-8')).decode('ascii')
+    clean_headers = {
+        key: value for key, value in (headers or {}).items()
+        if value is not None
+    }
+    clean_headers['Authorization'] = 'Basic {}'.format(credentials)
+    return clean_headers
+
+
+def _query_fields(params):
+    fields = []
+    for key, value in params.items():
+        if value is None:
+            continue
+        if isinstance(value, (list, tuple)):
+            fields.extend((key, item) for item in value)
+        else:
+            fields.append((key, value))
+    return fields
+
+
+def _response_status(response):
+    status = getattr(response, 'status', None)
+    if isinstance(status, int):
+        return status
+    return getattr(response, 'status_code', status)
+
+
+def _response_text(response):
+    data = getattr(response, 'data', None)
+    if isinstance(data, bytes):
+        return data.decode('utf-8')
+    if isinstance(data, str):
+        return data
+    text = getattr(response, 'text', '')
+    if isinstance(text, bytes):
+        return text.decode('utf-8')
+    return text
+
+
+def _response_json(response):
+    data = getattr(response, 'data', None)
+    if isinstance(data, bytes):
+        return json.loads(data.decode('utf-8'))
+    if isinstance(data, str):
+        return json.loads(data)
+    decoder = getattr(response, 'json', None)
+    if callable(decoder):
+        return decoder()
+    return json.loads(_response_text(response))
