+class _HttpxClient(httpx.Client):
+    """Keep the session attributes exposed by the requests-based API."""
+
+    @property
+    def auth(self):
+        return getattr(self, '_compat_auth', None)
+
+    @auth.setter
+    def auth(self, value):
+        self._compat_auth = value
+        if isinstance(value, (tuple, list)):
+            self._auth = httpx.BasicAuth(*value)
+        else:
+            self._auth = value
+
+    @property
+    def headers(self):
+        return self._headers
+
+    @headers.setter
+    def headers(self, value):
+        self._headers = dict(value)
 
 
