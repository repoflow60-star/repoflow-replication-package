+class _RequestInfo:
+    """Metadata describing the request that produced a response."""
+
+    def __init__(self, method, url):
+        self.method = method
+        self.url = url
+
+
+class PDResponse:
+    """Response facade exposing the response API used by this client."""
+
+    def __init__(self, response, method, url, elapsed):
+        status = getattr(response, 'status', None)
+        if status is None:
+            status = getattr(response, 'status_code', 0)
+        data = getattr(response, 'data', None)
+        if data is None:
+            data = getattr(response, 'content', b'')
+        if data is None:
+            data = b''
+        if isinstance(data, str):
+            data = data.encode('utf-8')
+
+        self.status_code = status
+        self.headers = getattr(response, 'headers', {})
+        self.content = data
+        self.request = _RequestInfo(method, url)
+        self.url = url
+        self.elapsed = timedelta(seconds=elapsed)
+        self.reason = getattr(response, 'reason', None)
+        self.encoding = 'utf-8'
+
+    @property
+    def ok(self):
+        return self.status_code < 400
+
+    @property
+    def text(self):
+        return self.content.decode(self.encoding, errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+
+def _is_response_compatible(response):
+    """Return whether a response already has the client's response interface."""
+    return all(
+        hasattr(response, attribute)
+        for attribute in ('status_code', 'ok', 'text', 'json', 'request',
+                          'elapsed')
+    ) and callable(response.json)
+
+
+def _adapt_response(response, method, url, elapsed):
+    if _is_response_compatible(response):
+        return response
+    return PDResponse(response, method, url, elapsed)
+
+
+class _Urllib3PoolManager(urllib3.PoolManager):
+    """Translate session request arguments to urllib3 at the transport edge."""
+
+    def request(self, method, url, **kwargs):
+        params = kwargs.pop('params', None)
+        if params:
+            query = urlencode(params, doseq=True)
+            url += ('&' if '?' in url else '?') + query
+
+        if 'json' in kwargs:
+            kwargs['body'] = json.dumps(kwargs.pop('json')).encode('utf-8')
+        elif 'data' in kwargs:
+            body = kwargs.pop('data')
+            if isinstance(body, dict):
+                body = urlencode(body, doseq=True).encode('utf-8')
+            kwargs['body'] = body
+
+        kwargs['preload_content'] = not kwargs.pop('stream', False)
+        if 'allow_redirects' in kwargs:
+            kwargs['redirect'] = kwargs.pop('allow_redirects')
+        return super(_Urllib3PoolManager, self).request(method, url, **kwargs)
 
