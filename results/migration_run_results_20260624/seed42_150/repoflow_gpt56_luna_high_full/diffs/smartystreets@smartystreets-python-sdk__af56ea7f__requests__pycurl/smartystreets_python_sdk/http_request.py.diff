--- a/smartystreets_python_sdk/http_request.py
+++ b/smartystreets_python_sdk/http_request.py
@@ -0,0 +1,25 @@
+try:
+    from urllib.parse import urlencode
+except ImportError:
+    from urllib import urlencode
+
+
+class HttpRequest:
+    def __init__(self, url, headers=None):
+        self.url = url
+        self.headers = headers if headers is not None else {}
+        self.data = None
+        self.method = 'GET'
+
+    @property
+    def body(self):
+        return self.data
+
+
+def add_query_parameters(url, parameters):
+    if not parameters:
+        return url
+
+    query = urlencode(parameters, doseq=True)
+    separator = '&' if '?' in url else '?'
+    return '{}{}{}'.format(url, separator, query)
