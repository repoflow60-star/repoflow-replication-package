--- a/yarg/_http.py
+++ b/yarg/_http.py
@@ -0,0 +1,21 @@
+# -*- coding: utf-8 -*-
+
+from twisted.internet import defer
+from twisted.internet import reactor
+from twisted.internet import threads
+import treq
+
+
+@defer.inlineCallbacks
+def _request(url):
+    response = yield treq.get(url)
+    content = yield response.content()
+    reason = response.phrase
+    if isinstance(reason, bytes):
+        reason = reason.decode('ascii', 'replace')
+    defer.returnValue((response.code, reason, content))
+
+
+def get(url):
+    """Perform a treq request while retaining yarg's synchronous API."""
+    return threads.blockingCallFromThread(reactor, _request, url)
