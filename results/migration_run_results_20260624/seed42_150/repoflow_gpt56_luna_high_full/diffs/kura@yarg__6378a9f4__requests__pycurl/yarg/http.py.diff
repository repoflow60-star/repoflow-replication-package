--- a/yarg/http.py
+++ b/yarg/http.py
@@ -0,0 +1,45 @@
+# -*- coding: utf-8 -*-
+
+"""Small response/session adapter backed by pycurl."""
+
+from io import BytesIO
+
+import pycurl
+
+
+class CurlResult(object):
+    """The transfer attributes consumed by yarg."""
+
+    def __init__(self, content, status_code, reason):
+        self.content = content
+        self.status_code = status_code
+        self.reason = reason
+
+
+class Session(object):
+    """Provide the small ``get`` interface used by the public API."""
+
+    def get(self, url):
+        content = BytesIO()
+        headers = BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(curl.URL, url.encode('utf-8'))
+            curl.setopt(curl.WRITEFUNCTION, content.write)
+            curl.setopt(curl.HEADERFUNCTION, headers.write)
+            curl.setopt(curl.FOLLOWLOCATION, 1)
+            curl.perform()
+            status_code = curl.getinfo(curl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        reason = None
+        for line in headers.getvalue().splitlines():
+            if line.startswith(b'HTTP/'):
+                parts = line.decode('iso-8859-1').split(' ', 2)
+                reason = parts[2] if len(parts) == 3 else ''
+
+        return CurlResult(content.getvalue(), status_code, reason)
+
+
+session = Session()
