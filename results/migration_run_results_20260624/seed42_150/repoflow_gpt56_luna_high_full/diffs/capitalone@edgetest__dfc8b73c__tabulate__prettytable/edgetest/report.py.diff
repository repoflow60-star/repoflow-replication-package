+def tabulate(rows: List[List], headers: List[str], tablefmt: str) -> str:
+    """Render a report table using PrettyTable."""
+    table = PrettyTable(headers)
+    table.add_rows(rows)
+    table.align = "l"
+    table.set_style(
+        TableStyle.MARKDOWN if tablefmt == "github" else TableStyle.DEFAULT
+    )
+    rendered = table.get_string()
+
+    if tablefmt == "github":
+        return rendered
+
+    widths = [len(str(header)) + 2 for header in headers]
+    for row in rows:
+        for index, value in enumerate(row):
+            widths[index] = max(widths[index], len(str(value)))
+
+    rst_lines = []
+    for line in rendered.splitlines():
+        if line.startswith("+") and line.endswith("+"):
+            rst_lines.append("  ".join("=" * width for width in widths))
+        elif line.startswith("|") and line.endswith("|"):
+            columns = line[1:-1].split("|")
+            rst_lines.append(
+                "  ".join(
+                    column[1:-1].rstrip().ljust(width)
+                    for column, width in zip(columns, widths)
+                ).rstrip()
+            )
+        else:
+            rst_lines.append(line)
+    return "\n".join(rst_lines)
 
 
