+    @staticmethod
+    def _request_deferred(reactor, url: str, verify: bool = True):
+        request_args = {
+            "headers": Headers(
+                {
+                    b"User-Agent": [
+                        b"Mozilla/5.0 (Windows NT 6.1; WOW64; rv:12.0) "
+                        b"Gecko/20100101 Firefox/12.0"
+                    ]
+                }
+            ),
+            "timeout": 5,
+            "reactor": reactor,
+        }
+        if verify:
+            request_args["browser_like_redirects"] = True
+        else:
+            agent = Agent(reactor, contextFactory=CertificateOptions(verify=False))
+            request_args["agent"] = BrowserLikeRedirectAgent(agent)
+            request_args["allow_redirects"] = False
+
+        response_deferred = treq.get(url, **request_args)
+
+        def read_content(response):
+            return treq.content(response).addCallback(
+                lambda content: (response, content)
+            )
+
+        return response_deferred.addCallback(read_content)
+
+    @classmethod
+    def _request(cls, url: str, verify: bool = True):
+        reactor = SelectReactor()
+        result = []
+
+        def finish(value):
+            result.append(value)
+            if reactor.running:
+                reactor.stop()
+            return value
+
+        cls._request_deferred(reactor, url, verify).addBoth(finish)
+        if not result:
+            reactor.run(installSignalHandlers=False)
+
+        response = result[0]
+        if isinstance(response, Failure):
+            response.raiseException()
+        return response
+
+    @staticmethod
+    def _is_certificate_error(error) -> bool:
+        if isinstance(error, (CertificateError, ssl.SSLError)):
+            return True
+        value = getattr(error, "value", None)
+        if value is not None and value is not error:
+            if SecurityTXT._is_certificate_error(value):
+                return True
+        for reason in getattr(error, "reasons", ()) or ():
+            reason = getattr(reason, "value", reason)
+            if SecurityTXT._is_certificate_error(reason):
+                return True
+        return type(error).__name__ == "VerificationError"
+
+    @staticmethod
+    def _header(headers, name: str):
+        if hasattr(headers, "getRawHeaders"):
+            values = None
+            for key in (name.encode("ascii"), name):
+                try:
+                    values = headers.getRawHeaders(key)
+                except (KeyError, TypeError):
+                    values = None
+                if values:
+                    break
+            if not values:
+                return None
+            value = values[0]
+        else:
+            value = headers.get(name)
+            if value is None:
+                value = headers.get(name.encode("ascii"))
+            if value is None:
+                for key, candidate in headers.items():
+                    if isinstance(key, bytes):
+                        key = key.decode("ascii")
+                    if key.lower() == name.lower():
+                        value = candidate
+                        break
+            if value is None:
+                return None
+            if isinstance(value, (list, tuple)):
+                value = value[0] if value else None
+                if value is None:
+                    return None
+        if isinstance(value, bytes):
+            return value.decode("latin1")
+        return value
+
+    @staticmethod
+    def _response_history(response):
+        history = []
+        previous = getattr(response, "previousResponse", None)
+        while previous is not None:
+            history.append(previous)
+            previous = getattr(previous, "previousResponse", None)
+        return history
+
+    @staticmethod
+    def _response_url(response, fallback: str) -> str:
+        request = getattr(response, "request", None)
+        value = getattr(request, "absoluteURI", None)
+        if value is None:
+            value = getattr(response, "url", None) or fallback
+        if isinstance(value, bytes):
+            return value.decode("ascii")
+        return value
