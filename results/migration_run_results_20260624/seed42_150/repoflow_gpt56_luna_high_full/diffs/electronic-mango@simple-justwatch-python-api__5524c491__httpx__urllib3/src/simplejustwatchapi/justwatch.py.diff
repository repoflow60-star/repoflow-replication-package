+class _ResponseAdapter:
+    """Expose the response methods used by this module for urllib3 responses."""
+
+    def __init__(self, response: urllib3.HTTPResponse) -> None:
+        self._response = response
+
+    def raise_for_status(self) -> None:
+        if not 200 <= self._response.status < 300:
+            raise urllib3.exceptions.HTTPError(f"HTTP status {self._response.status}")
+
+    def json(self) -> object:
+        return json_module.loads(self._response.data.decode("utf-8"))
+
+
+def post(url: str, *, json: object | None = None) -> _ResponseAdapter:
+    """Send a JSON POST request using urllib3."""
+    response = urllib3.request(
+        "POST",
+        url,
+        body=json_module.dumps(json).encode("utf-8"),
+        headers={"Content-Type": "application/json"},
+    )
+    return _ResponseAdapter(response)
 
 
