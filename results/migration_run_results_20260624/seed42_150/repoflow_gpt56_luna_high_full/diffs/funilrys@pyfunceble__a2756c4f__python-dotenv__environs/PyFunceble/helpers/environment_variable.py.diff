+    def _update_env_file(self, value: Optional[str] = None) -> None:
+        """Updates or removes this helper's assignment in its env file."""
+
+        assignment = re.compile(
+            rf"^[ \t]*(?:export[ \t]+)?{re.escape(self.name)}"
+            rf"(?:[ \t]*=[ \t]*.*|[ \t]*)(?:\r?\n)?$"
+        )
+
+        try:
+            with open(self.env_file_path, "r", encoding="utf-8") as env_file:
+                lines = env_file.readlines()
+        except FileNotFoundError:
+            if value is None:
+                return
+            lines = []
+
+        if value is None:
+            updated_lines = [line for line in lines if not assignment.match(line)]
+            if updated_lines == lines:
+                return
+        else:
+            escaped_value = value.replace("'", "\\'")
+            value_repr = value if value.isalnum() else f"'{escaped_value}'"
+            replacement = f"{self.name}={value_repr}\n"
+            updated_lines = []
+            replaced = False
+            for line in lines:
+                if assignment.match(line):
+                    updated_lines.append(replacement)
+                    replaced = True
+                else:
+                    updated_lines.append(line)
+
+            if not replaced:
+                if updated_lines and not updated_lines[-1].endswith(("\n", "\r")):
+                    updated_lines[-1] += "\n"
+                updated_lines.append(replacement)
+
+        with open(self.env_file_path, "w", encoding="utf-8") as env_file:
+            env_file.writelines(updated_lines)
