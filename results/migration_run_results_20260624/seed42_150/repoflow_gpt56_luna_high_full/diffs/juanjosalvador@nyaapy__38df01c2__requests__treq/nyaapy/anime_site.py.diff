-import requests
+import threading
+
+import treq
+from twisted.internet import defer, reactor
+from twisted.internet.threads import blockingCallFromThread
+
 from nyaapy import torrent
 from nyaapy.parser import parse_nyaa, parse_single, parse_nyaa_rss
+
+
+_reactor_lock = threading.Lock()
+_reactor_ready = threading.Event()
+_reactor_thread = None
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _reactor_thread
+
+    # Keep the existing synchronous API over treq's Deferred-based I/O.
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is None:
+            _reactor_ready.clear()
+            _reactor_thread = threading.Thread(target=_run_reactor, daemon=True)
+            _reactor_thread.start()
+        elif not _reactor_thread.is_alive():
+            raise RuntimeError("The Twisted reactor cannot be restarted")
+
+    _reactor_ready.wait()
+
+
+@defer.inlineCallbacks
+def _request(url: str, as_text: bool):
+    response = yield treq.get(url)
+
+    if response.code >= 400:
+        phrase = response.phrase
+        if isinstance(phrase, bytes):
+            phrase = phrase.decode("ascii", errors="replace")
+        raise RuntimeError(f"{response.code} {phrase}")
+
+    if as_text:
+        body = yield treq.text_content(response)
+    else:
+        body = yield treq.content(response)
+    return body
+
+
+def _get(url: str, as_text: bool = False):
+    _ensure_reactor()
+    return blockingCallFromThread(reactor, _request, url, as_text)
 
 
