+class _PycurlResponse(object):
+    """Small response object exposing the attributes used by the client."""
+
+    def __init__(self, status_code, reason, headers, content):
+        self.status_code = status_code
+        self.reason = reason
+        self.headers = headers
+        self.content = content
+
+    def json(self):
+        return loads(self.content)
+
+
+class _PycurlSession(object):
+    """Session-shaped wrapper around pycurl's per-request Curl handle."""
+
+    def __init__(self):
+        self.auth = None
+        self.headers = {}
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        request_headers = dict(self.headers)
+        for name, value in (headers or {}).items():
+            for existing_name in list(request_headers):
+                if existing_name.lower() == name.lower():
+                    del request_headers[existing_name]
+            request_headers[name] = value
+
+        body = BytesIO()
+        response_headers = BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.CUSTOMREQUEST, method.upper())
+            curl.setopt(pycurl.WRITEFUNCTION, body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, response_headers.write)
+            if timeout is not None:
+                curl.setopt(pycurl.TIMEOUT, timeout)
+            if request_headers:
+                curl.setopt(pycurl.HTTPHEADER,
+                            ["%s: %s" % (name, value)
+                             for name, value in request_headers.items()])
+                encoding = next((value for name, value in request_headers.items()
+                                 if name.lower() == 'accept-encoding'), None)
+                if encoding:
+                    curl.setopt(pycurl.ENCODING, encoding)
+            if self.auth:
+                curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+                curl.setopt(pycurl.USERPWD, "%s:%s" % self.auth)
+            if data is not None:
+                if not isinstance(data, bytes):
+                    data = data.encode('utf-8')
+                curl.setopt(pycurl.POSTFIELDS, data)
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        parsed_headers = {}
+        reason = ''
+        status_line = ''
+        for line in response_headers.getvalue().splitlines():
+            if line.startswith(b'HTTP/'):
+                status_line = line.decode('iso-8859-1')
+                parsed_headers = {}
+            elif b':' in line and status_line:
+                name, value = line.decode('iso-8859-1').split(':', 1)
+                value = value.strip()
+                if name in parsed_headers:
+                    parsed_headers[name] += ', ' + value
+                else:
+                    parsed_headers[name] = value
+        if status_line:
+            parts = status_line.split(' ', 2)
+            if len(parts) == 3:
+                reason = parts[2].strip()
+
+        return _PycurlResponse(status_code, reason, parsed_headers, body.getvalue())
 
 
