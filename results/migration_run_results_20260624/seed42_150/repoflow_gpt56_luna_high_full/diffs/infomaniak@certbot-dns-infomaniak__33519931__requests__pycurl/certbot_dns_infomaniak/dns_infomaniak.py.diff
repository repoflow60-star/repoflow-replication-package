+class _MountedRequest:
+    """Small request object for session transports."""
+
+    def __init__(self, method, url, headers, body):
+        self.method = method
+        self.url = url
+        self.headers = headers
+        self.body = body
+        self._cookies = {}
+
+    @property
+    def path_url(self):
+        parsed = urlsplit(self.url)
+        path = parsed.path or "/"
+        if parsed.query:
+            path += "?" + parsed.query
+        return path
+
+
+class _PycurlSession:
+    """Synchronous HTTP session backed by pycurl."""
+
+    def __init__(self, token):
+        self._curl = pycurl.Curl()
+        self._mounts = {}
+        self.headers = {
+            "Authorization": "Bearer {token}".format(token=token),
+        }
+
+    def mount(self, prefix, transport):
+        """Register a transport for URLs beginning with ``prefix``."""
+        self._mounts[prefix] = transport
+
+    def request(self, method, url, params=None, data=None):
+        url = self._add_params(url, params)
+        transport = self._transport_for(url)
+        headers = dict(self.headers)
+        body = data.encode("utf-8") if isinstance(data, str) else data
+        if method == "POST":
+            headers["Content-Type"] = "application/json"
+
+        if transport is not None:
+            request = _MountedRequest(method, url, headers, body)
+            response = transport.send(request)
+            content = getattr(response, "content", response)
+            return content if isinstance(content, bytes) else content.encode("utf-8")
+
+        output = BytesIO()
+        self._curl.reset()
+        self._curl.setopt(pycurl.URL, url)
+        self._curl.setopt(pycurl.WRITEFUNCTION, output.write)
+        self._curl.setopt(
+            pycurl.HTTPHEADER,
+            ["{}: {}".format(name, value) for name, value in headers.items()],
+        )
+        if method == "GET":
+            self._curl.setopt(pycurl.HTTPGET, 1)
+        elif method == "POST":
+            self._curl.setopt(pycurl.POST, 1)
+            self._curl.setopt(pycurl.POSTFIELDS, body or b"")
+        else:
+            self._curl.setopt(pycurl.CUSTOMREQUEST, method)
+        self._curl.perform()
+        return output.getvalue()
+
+    def _transport_for(self, url):
+        matches = [prefix for prefix in self._mounts if url.startswith(prefix)]
+        if not matches:
+            return None
+        return self._mounts[max(matches, key=len)]
+
+    @staticmethod
+    def _add_params(url, params):
+        if not params:
+            return url
+        separator = "&" if "?" in url else "?"
+        return "{}{}{}".format(url, separator, urlencode(params, doseq=True))
+
