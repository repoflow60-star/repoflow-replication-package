 from coguard_cli.auth import auth_config, util
 
 COGUARD_REALM_TOKEN_URL = "/realms/coguard/protocol/openid-connect/token"
+
+
+async def _request_async(method: str, url: str, data=None, timeout: int = 300):
+    client_timeout = aiohttp.ClientTimeout(total=timeout)
+    async with aiohttp.ClientSession(timeout=client_timeout) as session:
+        async with session.request(method, url, data=data) as response:
+            content = await response.read()
+            return response.status, response.reason, content, response.charset
+
+
+def _run_async(coroutine):
+    """Run an aiohttp coroutine while retaining the synchronous API."""
+    result = []
+    error = []
+
+    def run_in_thread():
+        try:
+            result.append(asyncio.run(coroutine))
+        except BaseException as exception:
+            error.append(exception)
+
+    thread = threading.Thread(target=run_in_thread)
+    thread.start()
+    thread.join()
+    if error:
+        raise error[0]
+    return result[0] if result else None
+
+
+def _request(method: str, url: str, data=None, timeout: int = 300):
+    return _run_async(_request_async(method, url, data=data, timeout=timeout))
+
+
+def _response_json(content: bytes, charset: Optional[str]):
+    return json.loads(content.decode(charset or "utf-8"))
 
