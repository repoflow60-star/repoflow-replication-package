 import lxml.html as lh
-import requests
+import treq
+from twisted.internet import reactor
+from twisted.python.failure import Failure
+from twisted.web.client import ProxyAgent
 
 from fp.errors import FreeProxyException
+
+
+_reactor_lock = Lock()
+_reactor_thread = None
+
+
+def _wait_for_deferred(operation, timeout=None):
+    """Run a treq operation while keeping FreeProxy's synchronous API."""
+    result = []
+    finished = Event()
+
+    def complete(value):
+        if isinstance(value, Failure):
+            result.append(value.value)
+        else:
+            result.append(value)
+        finished.set()
+        return None
+
+    def invoke():
+        try:
+            deferred = operation()
+            if timeout is not None:
+                deferred.addTimeout(timeout, reactor)
+            deferred.addBoth(complete)
+        except Exception as error:
+            complete(error)
+
+    global _reactor_thread
+    with _reactor_lock:
+        if not reactor.running and _reactor_thread is None:
+            _reactor_thread = Thread(
+                target=reactor.run,
+                kwargs={'installSignalHandlers': False},
+                daemon=True,
+            )
+            _reactor_thread.start()
+    reactor.callFromThread(invoke)
+    finished.wait()
+
+    value = result[0]
+    if isinstance(value, Exception):
+        raise value
+    return value
+
+
+def _get_content(url, proxy=None, timeout=None):
+    def request():
+        if proxy is None:
+            return treq.get(url)
+        return treq.get(
+            url,
+            agent=ProxyAgent(reactor, proxy.encode('ascii')),
+        )
+
+    response = _wait_for_deferred(request, timeout)
+    return _wait_for_deferred(response.content, timeout)
 
 
