+def _new_tdes_cipher(
+    key: bytes, mode: int, iv: _typing.Optional[bytes] = None
+) -> _typing.Any:
+    """Create a cipher for single, double, and triple DES keys."""
+    if len(key) == 8:
+        cipher_type = _DES
+    elif len(key) in {16, 24}:
+        # PyCryptodome rejects keys that reduce to single DES. The source
+        # implementation accepts them, so handle those cases with DES.
+        adjusted_key = adjust_key_parity(key)
+        if len(adjusted_key) == 16 and adjusted_key[:8] == adjusted_key[8:]:
+            cipher_type = _DES
+            key = adjusted_key[:8]
+        elif (
+            len(adjusted_key) == 24
+            and (
+                adjusted_key[:8] == adjusted_key[8:16]
+                or adjusted_key[8:16] == adjusted_key[16:]
+            )
+        ):
+            cipher_type = _DES
+            key = (
+                adjusted_key[16:]
+                if adjusted_key[:8] == adjusted_key[8:16]
+                else adjusted_key[:8]
+            )
+        else:
+            cipher_type = _DES3
+            key = adjusted_key
+    else:
+        cipher_type = _DES3
+
+    if iv is None:
+        return cipher_type.new(key, mode)
+    return cipher_type.new(key, mode, iv)
+
