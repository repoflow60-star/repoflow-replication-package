--- a/appstoreserverlibrary/_treq.py
+++ b/appstoreserverlibrary/_treq.py
@@ -0,0 +1,84 @@
+# Copyright (c) 2023 Apple Inc. Licensed under MIT License.
+
+import json as json_module
+import threading
+from typing import Any, Dict, List, Optional, Union
+
+import treq
+from twisted.internet import defer, reactor
+from twisted.internet.threads import blockingCallFromThread
+from twisted.web.http_headers import Headers
+
+
+class TreqResponse:
+    def __init__(self, status_code: int, headers: Dict[str, str], content: bytes):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+
+    def json(self):
+        return json_module.loads(self.content.decode("utf-8"))
+
+
+_reactor_lock = threading.Lock()
+_reactor_thread: Optional[threading.Thread] = None
+_reactor_ready = threading.Event()
+
+
+def _start_reactor() -> None:
+    global _reactor_thread
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is None:
+            def run_reactor() -> None:
+                reactor.callWhenRunning(_reactor_ready.set)
+                reactor.run(installSignalHandlers=False)
+
+            _reactor_thread = threading.Thread(target=run_reactor, daemon=True)
+            _reactor_thread.start()
+    _reactor_ready.wait()
+
+
+def _make_headers(headers: Optional[Dict[str, str]]) -> Optional[Headers]:
+    if headers is None:
+        return None
+    return Headers({
+        name.encode("ascii"): [value.encode("latin-1")]
+        for name, value in headers.items()
+    })
+
+
+def request(
+    method: str,
+    url: str,
+    params: Optional[Dict[str, Union[str, List[str]]]] = None,
+    headers: Optional[Dict[str, str]] = None,
+    json: Optional[Dict[str, Any]] = None,
+    data: Optional[bytes] = None,
+) -> TreqResponse:
+    _start_reactor()
+    if reactor.running and _reactor_thread is not None and threading.current_thread() is _reactor_thread:
+        raise RuntimeError("Synchronous treq requests cannot run on the reactor thread")
+
+    @defer.inlineCallbacks
+    def perform_request():
+        request_kwargs = {
+            "params": params,
+            "headers": _make_headers(headers),
+        }
+        if json is not None:
+            request_kwargs["json"] = json
+        if data is not None:
+            request_kwargs["data"] = data
+        response = yield treq.request(method, url, **request_kwargs)
+        content = yield treq.content(response)
+        response_headers = {
+            name.decode("latin-1").lower(): values[0].decode("latin-1")
+            for name, values in response.headers.getAllRawHeaders()
+        }
+        return TreqResponse(response.code, response_headers, content)
+
+    return blockingCallFromThread(reactor, perform_request)
