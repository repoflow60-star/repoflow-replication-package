+
+    @inlineCallbacks
+    def _request_deferred(self, reactor, url: str, verify: bool):
+        request_args = {
+            "headers": {
+                "User-Agent": "Mozilla/5.0 (Windows NT 6.1; WOW64; rv:12.0) "
+                "Gecko/20100101 Firefox/12.0"
+            },
+            "timeout": 5,
+            "reactor": reactor,
+            "browser_like_redirects": True,
+        }
+        if not verify:
+            request_args["agent"] = Agent(
+                reactor, contextFactory=CertificateOptions(verify=False)
+            )
+        response = yield treq.get(url, **request_args)
+        content = yield treq.content(response)
+        returnValue((response, content))
+
+    def _request(self, url: str, verify: bool = True):
+        reactor = SelectReactor()
+        result = []
+
+        def finish(value):
+            result.append(value)
+            if reactor.running:
+                reactor.stop()
+            return None
+
+        self._request_deferred(reactor, url, verify).addBoth(finish)
+        if not result:
+            reactor.run()
+        response = result[0]
+        if isinstance(response, Failure):
+            response.raiseException()
+        return response
+
+    @staticmethod
+    def _is_certificate_error(error) -> bool:
+        if isinstance(error, (CertificateError, ssl.SSLError)):
+            return True
+        for reason in getattr(error, "reasons", ()):
+            reason = getattr(reason, "value", reason)
+            if SecurityTXT._is_certificate_error(reason):
+                return True
+        return type(error).__name__ == "VerificationError"
+
+    @staticmethod
+    def _header(headers, name: str):
+        if hasattr(headers, "getRawHeaders"):
+            values = headers.getRawHeaders(name)
+            if values:
+                value = values[0]
+            else:
+                return None
+        else:
+            value = headers.get(name)
+            if value is None:
+                return None
+        if isinstance(value, bytes):
+            return value.decode("latin1")
+        return value
+
+    @staticmethod
+    def _response_history(response):
+        history = []
+        previous = getattr(response, "previousResponse", None)
+        while previous is not None:
+            history.append(previous)
+            previous = getattr(previous, "previousResponse", None)
+        return history
+
+    @staticmethod
+    def _response_url(response, fallback: str) -> str:
+        request = getattr(response, "request", None)
+        value = getattr(request, "absoluteURI", fallback)
+        if isinstance(value, bytes):
+            return value.decode("ascii")
+        return value
