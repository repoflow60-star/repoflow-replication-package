+class _Response:
+    """Synchronous response view used by the existing API functions."""
+
+    def __init__(self, response: ty.Any, content: bytes):
+        self.status_code = response.code
+        self.headers = {
+            _decode(header).lower(): ', '.join(
+                _decode(value) for value in values
+            )
+            for header, values in response.headers.getAllRawHeaders()
+        }
+        self.content = content
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            raise _RequestError(self)
+
+    def json(self) -> ty.Any:
+        return json.loads(self.content)
+
+    def iter_content(self, chunk_size: int):
+        for offset in range(0, len(self.content), chunk_size):
+            yield self.content[offset : offset + chunk_size]
+
+
+class _RequestError(Exception):
+    def __init__(self, response: _Response):
+        super().__init__(
+            'HTTP request failed with status {}'.format(response.status_code)
+        )
+        self.response = response
+
+
+def _decode(value: ty.Any) -> str:
+    if isinstance(value, bytes):
+        return value.decode('latin-1')
+    return value
+
+
+_REACTOR_LOCK = threading.Lock()
+_REACTOR_READY = threading.Event()
+_REACTOR_THREAD: ty.Optional[threading.Thread] = None
+
+
+def _run_reactor() -> None:
+    reactor.callWhenRunning(_REACTOR_READY.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor() -> None:
+    global _REACTOR_THREAD
+
+    with _REACTOR_LOCK:
+        if _REACTOR_THREAD is None:
+            _REACTOR_THREAD = threading.Thread(
+                target=_run_reactor,
+                name='git-pw-treq-reactor',
+                daemon=True,
+            )
+            _REACTOR_THREAD.start()
+
+    _REACTOR_READY.wait()
+
+
+def _blocking(operation: ty.Callable[[], ty.Any]) -> ty.Any:
+    """Wait for a treq Deferred without changing the public sync API."""
+    _ensure_reactor()
+
+    completed = threading.Event()
+    result: ty.Dict[str, ty.Any] = {}
+
+    def invoke() -> None:
+        try:
+            deferred = operation()
+        except BaseException as exc:
+            result['exception'] = exc
+            completed.set()
+            return
+
+        def succeeded(value: ty.Any) -> ty.Any:
+            result['value'] = value
+            completed.set()
+            return value
+
+        def failed(failure: ty.Any) -> None:
+            result['failure'] = failure
+            completed.set()
+
+        deferred.addCallbacks(succeeded, failed)
+
+    reactor.callFromThread(invoke)
+    completed.wait()
+
+    if 'exception' in result:
+        raise result['exception']
+    if 'failure' in result:
+        result['failure'].raiseException()
+
+    return result['value']
+
