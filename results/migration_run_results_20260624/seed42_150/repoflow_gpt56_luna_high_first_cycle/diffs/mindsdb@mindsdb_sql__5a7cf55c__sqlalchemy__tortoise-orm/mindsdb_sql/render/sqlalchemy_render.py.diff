+class _Dialect:
+    """Small dialect description used by the SQL text renderer."""
+
+    def __init__(self, name):
+        self.name = 'postgresql' if name == 'postgres' else name
+
+    @property
+    def quote(self):
+        if self.name == 'mysql':
+            return '`'
+        if self.name == 'mssql':
+            return '['
+        return '"'
+
+
+class _Expression:
+    def __init__(self, sql, alias=None):
+        self.sql = sql
+        self.alias = alias
+
+    def base(self):
+        return self.sql
+
+    def render(self):
+        if self.alias is None:
+            return self.sql
+        return f'{self.sql} AS {self.alias}'
+
+    def __str__(self):
+        return self.render()
+
+    def _other(self, value):
+        if isinstance(value, _Expression):
+            return value.base()
+        if isinstance(value, (list, tuple)):
+            return ', '.join(_expression_sql(item) for item in value)
+        return str(value)
+
+    def _binary(self, operator, value):
+        return _Expression(f'({self.base()} {operator} {self._other(value)})')
+
+    def __add__(self, value):
+        return self._binary('+', value)
+
+    def __sub__(self, value):
+        return self._binary('-', value)
+
+    def __mul__(self, value):
+        return self._binary('*', value)
+
+    def __truediv__(self, value):
+        return self._binary('/', value)
+
+    def __mod__(self, value):
+        return self._binary('%', value)
+
+    def __eq__(self, value):
+        return self._binary('=', value)
+
+    def __ne__(self, value):
+        return self._binary('<>', value)
+
+    def __gt__(self, value):
+        return self._binary('>', value)
+
+    def __lt__(self, value):
+        return self._binary('<', value)
+
+    def __ge__(self, value):
+        return self._binary('>=', value)
+
+    def __le__(self, value):
+        return self._binary('<=', value)
+
+    def __invert__(self):
+        return _Expression(f'NOT ({self.base()})')
+
+    def __neg__(self):
+        return _Expression(f'-({self.base()})')
+
+    def is_(self, value):
+        return self._binary('IS', value)
+
+    def is_not(self, value):
+        return self._binary('IS NOT', value)
+
+    def like(self, value):
+        return self._binary('LIKE', value)
+
+    def notlike(self, value):
+        return self._binary('NOT LIKE', value)
+
+    def in_(self, value):
+        if isinstance(value, (list, tuple)):
+            value = ', '.join(_expression_sql(item) for item in value)
+            return _Expression(f'({self.base()} IN ({value}))')
+        return self._binary('IN', f'({self._other(value)})')
+
+    def notin_(self, value):
+        if isinstance(value, (list, tuple)):
+            value = ', '.join(_expression_sql(item) for item in value)
+            return _Expression(f'({self.base()} NOT IN ({value}))')
+        return self._binary('NOT IN', f'({self._other(value)})')
+
+    def concat(self, value):
+        return self._binary('||', value)
+
+    def op(self, operator):
+        return lambda value: self._binary(operator, value)
+
+    def label(self, alias):
+        return _Expression(self.base(), alias)
+
+    def asc(self):
+        return _Expression(f'{self.base()} ASC')
+
+    def desc(self):
+        return _Expression(f'{self.base()} DESC')
+
+    def distinct(self):
+        return _Expression(f'DISTINCT {self.base()}')
+
