+class _Statement:
+    """Prepared SQL plus a Tortoise expression representation."""
+
+    def __init__(self, sql):
+        self.sql = sql
+        # RawSQL is the target ORM's supported representation for a statement
+        # that is intentionally not tied to a registered model.
+        self.expression = RawSQL(sql)
+
+    def __str__(self):
+        return self.sql
+
+    def scalar_subquery(self):
+        return _Expression(f'({self.sql})')
+
+    def exists(self):
+        return _Expression(f'EXISTS ({self.sql})')
+
+    def subquery(self, alias=None):
+        text = f'({self.sql})'
+        if alias:
+            text += f' AS {alias}'
+        return text
+
+    def cte(self, alias, nesting=False):
+        return self.subquery(alias)
