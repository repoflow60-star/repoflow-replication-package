+class _TreqRunner:
+    def __init__(self) -> None:
+        self._lock = threading.Lock()
+        self._reactor_started = threading.Event()
+        self._thread: Optional[threading.Thread] = None
+
+    def _ensure_reactor(self) -> None:
+        if reactor.running:
+            return
+
+        with self._lock:
+            if reactor.running:
+                return
+            if self._thread is None:
+                reactor.callWhenRunning(self._reactor_started.set)
+                self._thread = threading.Thread(
+                    target=reactor.run,
+                    kwargs={"installSignalHandlers": False},
+                    daemon=True,
+                )
+                self._thread.start()
+
+        self._reactor_started.wait()
+
+    def request(
+        self, method: str, url: str, timeout: Optional[float]
+    ) -> bytes:
+        self._ensure_reactor()
+        result: "Queue[Union[bytes, _TreqConnectionError]]" = Queue(maxsize=1)
+        pending: List[Any] = []
+
+        def succeeded(body: bytes) -> bytes:
+            result.put(body)
+            return body
+
+        def failed(failure: Any) -> None:
+            error = getattr(failure, "value", failure)
+            result.put(_TreqConnectionError(error))
+
+        def issue_request() -> None:
+            try:
+                deferred = treq.request(
+                    method,
+                    url,
+                    agent=Agent(
