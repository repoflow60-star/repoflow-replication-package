+                        contextFactory=ClientContextFactory(),
+                    ),
+                    timeout=timeout,
+                )
+                pending.append(deferred)
+                deferred.addCallback(treq.content)
+                deferred.addCallbacks(succeeded, failed)
+            except Exception as err:
+                failed(err)
+
+        reactor.callFromThread(issue_request)
+        try:
+            response = result.get(timeout=timeout)
+        except Empty as err:
+            if pending:
+                reactor.callFromThread(pending[0].cancel)
+            raise _TreqConnectionError("Request timed out") from err
+
+        if isinstance(response, _TreqConnectionError):
+            raise response
+        return cast(bytes, response)
+
+
+_TREQ_RUNNER = _TreqRunner()
 
 
