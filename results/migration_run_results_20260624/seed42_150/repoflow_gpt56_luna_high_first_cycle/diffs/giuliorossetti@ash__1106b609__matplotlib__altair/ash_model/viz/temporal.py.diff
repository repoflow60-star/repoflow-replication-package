+def _mark_kwargs(kwargs: dict, allowed=("color", "size", "shape", "filled", "strokeWidth", "strokeDash")) -> dict:
+    """Translate common plotting options into Altair mark options."""
+    options = {
+        key: kwargs[key]
+        for key in allowed
+        if key in kwargs
+    }
+    if "alpha" in kwargs:
+        options["opacity"] = kwargs["alpha"]
+    elif "opacity" in kwargs:
+        options["opacity"] = kwargs["opacity"]
+    return options
