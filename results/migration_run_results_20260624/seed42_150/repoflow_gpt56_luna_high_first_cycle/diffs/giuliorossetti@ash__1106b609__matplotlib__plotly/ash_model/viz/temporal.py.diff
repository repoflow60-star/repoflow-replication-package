+def _get_figure(kwargs: dict) -> go.Figure:
+    figure = kwargs.get("ax")
+    if figure is None:
+        return go.Figure()
+    if not isinstance(figure, go.Figure):
+        raise TypeError("ax must be a plotly.graph_objects.Figure")
+    return figure
+
+
+def _trace_options(kwargs: dict, target: str) -> dict:
+    options = {k: v for k, v in kwargs.items() if k != "ax"}
+    if "alpha" in options:
+        options["opacity"] = options.pop("alpha")
+    if "color" in options:
+        color = options.pop("color")
+        style = dict(options.get(target, {}))
+        style.setdefault("color", color)
+        options[target] = style
+    return options
 
 
