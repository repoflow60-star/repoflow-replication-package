+_treq_reactor_lock = threading.Lock()
+_treq_reactor_started = threading.Event()
+
+
+def _ensure_treq_reactor():
+    if reactor.running:
+        _treq_reactor_started.set()
+        return
+    with _treq_reactor_lock:
+        if reactor.running:
+            _treq_reactor_started.set()
+        else:
+            reactor.callWhenRunning(_treq_reactor_started.set)
+            threading.Thread(
+                target=reactor.run,
+                kwargs={'installSignalHandlers': False},
+                daemon=True).start()
+    _treq_reactor_started.wait()
+
+
+@defer.inlineCallbacks
+def _oauth2_user(provider_data, code, redirect_uri):
+    response = yield treq.post(provider_data['access_token_url'], data={
+        'client_id': provider_data['client_id'],
+        'client_secret': provider_data['client_secret'],
+        'code': code,
+        'grant_type': 'authorization_code',
+        'redirect_uri': redirect_uri,
+    }, headers={'Accept': ['application/json']})
+    if response.code != 200:
+        defer.returnValue(None)
+    oauth2_token = (yield treq.json_content(response)).get('access_token')
+    if not oauth2_token:
+        defer.returnValue(None)
+    response = yield treq.get(provider_data['get_user']['url'], headers={
+        'Authorization': ['Bearer ' + oauth2_token],
+        'Accept': ['application/json'],
+    })
+    if response.code != 200:
+        defer.returnValue(None)
+    user_data = yield treq.json_content(response)
+    defer.returnValue(user_data)
 
 
