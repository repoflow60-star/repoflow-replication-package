--- a/yarg/_http.py
+++ b/yarg/_http.py
@@ -0,0 +1,48 @@
+from threading import Event, Lock, Thread
+
+import treq
+from twisted.internet import reactor
+from twisted.internet.threads import blockingCallFromThread
+
+
+_reactor_lock = Lock()
+_reactor_ready = Event()
+_reactor_thread = None
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _reactor_thread
+
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is None:
+            _reactor_thread = Thread(target=_run_reactor, daemon=True)
+            _reactor_thread.start()
+        elif not _reactor_thread.is_alive():
+            raise RuntimeError("The Twisted reactor is no longer available")
+    if not _reactor_ready.wait(5):
+        raise RuntimeError("The Twisted reactor did not start")
+
+
+def _request(url):
+    response = treq.get(url)
+    return treq.content(response).addCallback(
+        lambda content: (response.code, response.phrase, content))
+
+
+def request(url):
+    """Perform a GET with treq while retaining yarg's synchronous API."""
+    _ensure_reactor()
+    status_code, reason, content = blockingCallFromThread(
+        reactor, _request, url)
+    if isinstance(reason, bytes):
+        reason = reason.decode('latin1')
+    return status_code, reason, content
