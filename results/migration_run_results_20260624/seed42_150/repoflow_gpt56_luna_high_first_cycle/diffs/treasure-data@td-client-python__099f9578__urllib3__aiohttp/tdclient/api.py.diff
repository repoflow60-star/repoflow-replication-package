+class _BufferedResponse:
+    """Synchronous response view used by the existing client APIs."""
+
+    def __init__(self, status, headers, body):
+        self.status = status
+        self.headers = dict(headers)
+        self.data = body
+        self._body = io.BytesIO(body)
+
+    def read(self, amount=None):
+        return self._body.read(amount)
+
+    def readline(self, amount=-1):
+        return self._body.readline(amount)
+
+    def stream(self, amount):
+        while True:
+            chunk = self._body.read(amount)
+            if not chunk:
+                break
+            yield chunk
+
+    def getheaders(self):
+        return self.headers
+
+    def close(self):
+        self._body.close()
+
+    def __iter__(self):
+        return self
+
+    def __next__(self):
+        chunk = self._body.readline()
+        if not chunk:
+            raise StopIteration
+        return chunk
+
