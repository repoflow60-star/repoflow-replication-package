+class _AiohttpTransport:
+    """Run aiohttp's async session behind the client's synchronous API."""
+
+    def __init__(self, http_proxy=None, **options):
+        self.proxy = http_proxy
+        self.proxy_auth = None
+        self._timeout = options.pop("timeout", 60)
+        ca_certs = options.pop("ca_certs", None)
+        cert_reqs = options.pop("cert_reqs", None)
+        maxsize = options.pop("maxsize", None)
+
+        if http_proxy:
+            parsed_proxy = urlparse.urlparse(http_proxy)
+            if parsed_proxy.username is not None:
+                self.proxy_auth = aiohttp.BasicAuth(
+                    urlparse.unquote(parsed_proxy.username),
+                    urlparse.unquote(parsed_proxy.password or ""),
+                )
+
+        self._ssl_context = None
+        if ca_certs is not None:
+            self._ssl_context = ssl.create_default_context(cafile=ca_certs)
+        elif cert_reqs == ssl.CERT_REQUIRED:
+            self._ssl_context = ssl.create_default_context()
+
+        self._maxsize = maxsize
+        self._loop = asyncio.new_event_loop()
+        self._ready = threading.Event()
+        self._closed = False
+        self._startup_error = None
+        self._thread = threading.Thread(target=self._run_loop, daemon=True)
+        self._thread.start()
+        self._ready.wait()
+        if self._startup_error is not None:
+            raise self._startup_error
+
+    async def _create_session(self):
+        timeout = self._timeout
+        if not isinstance(timeout, aiohttp.ClientTimeout):
+            timeout = aiohttp.ClientTimeout(total=timeout)
+
+        connector = None
+        if self._ssl_context is not None or self._maxsize is not None:
+            connector_options = {}
+            if self._ssl_context is not None:
+                connector_options["ssl"] = self._ssl_context
+            if self._maxsize is not None:
+                connector_options["limit"] = self._maxsize
+            connector = aiohttp.TCPConnector(**connector_options)
+
+        return aiohttp.ClientSession(timeout=timeout, connector=connector)
+
+    def _run_loop(self):
+        asyncio.set_event_loop(self._loop)
+        try:
+            self._session = self._loop.run_until_complete(self._create_session())
+        except BaseException as error:
+            self._startup_error = error
+            self._ready.set()
+            self._loop.close()
+            return
+
+        self._ready.set()
+        self._loop.run_forever()
+        self._loop.close()
+
+    async def _request(self, method, url, fields, body, headers, options):
+        request_options = dict(options)
+        request_options.pop("decode_content", None)
+        request_options.pop("preload_content", None)
+        if body is not None:
+            request_options["data"] = body
+        elif method.upper() in {"DELETE", "GET", "HEAD", "OPTIONS", "TRACE"}:
+            request_options["params"] = fields
+        else:
+            request_options["data"] = fields
+        request_options["headers"] = headers
+        request_options["proxy"] = self.proxy
+        request_options["proxy_auth"] = self.proxy_auth
+
+        async with self._session.request(method, url, **request_options) as response:
+            return _BufferedResponse(
+                response.status, response.headers, await response.read()
+            )
+
+    def request(self, method, url, fields=None, body=None, headers=None, **options):
+        if self._closed:
+            raise RuntimeError("HTTP transport is closed")
+        if isinstance(body, (array, bytearray, memoryview)):
+            body = bytes(body)
+        future = asyncio.run_coroutine_threadsafe(
+            self._request(method, url, fields, body, headers, options), self._loop
+        )
+        return future.result()
+
+    def close(self):
+        if self._closed:
+            return
+        self._closed = True
+        future = asyncio.run_coroutine_threadsafe(self._session.close(), self._loop)
+        try:
+            future.result()
+        finally:
+            self._loop.call_soon_threadsafe(self._loop.stop)
+            self._thread.join()
+
