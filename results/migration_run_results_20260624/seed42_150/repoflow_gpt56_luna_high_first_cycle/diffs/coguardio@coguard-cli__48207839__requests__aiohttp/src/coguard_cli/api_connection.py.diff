+async def _request_async(
+        method: str,
+        url: str,
+        headers=None,
+        data=None,
+        json_payload=None,
+        timeout: int = 300):
+    client_timeout = aiohttp.ClientTimeout(total=timeout)
+    async with aiohttp.ClientSession(timeout=client_timeout) as session:
+        async with session.request(
+                method,
+                url,
+                headers=headers,
+                data=data,
+                json=json_payload) as response:
+            return (
+                response.status,
+                response.reason,
+                await response.read(),
+                response.charset
+            )
+
+
+def _request(
+        method: str,
+        url: str,
+        headers=None,
+        data=None,
+        json_payload=None,
+        timeout: int = 300):
+    return asyncio.run(_request_async(
+        method,
+        url,
+        headers=headers,
+        data=data,
+        json_payload=json_payload,
+        timeout=timeout
+    ))
+
+
+def _response_text(content: bytes, charset: Optional[str]) -> str:
+    return content.decode(charset or "utf-8")
+
+
+def _response_json(content: bytes, charset: Optional[str]):
+    return json.loads(_response_text(content, charset))
+
+
+async def _download_async(
+        url: str,
+        headers,
+        location: str,
+        timeout: int = 300):
+    client_timeout = aiohttp.ClientTimeout(total=timeout)
+    async with aiohttp.ClientSession(timeout=client_timeout) as session:
+        async with session.get(url, headers=headers) as response:
+            response.raise_for_status()
+            with open(location, 'wb') as write_stream:
+                async for chunk in response.content.iter_chunked(8192):
+                    write_stream.write(chunk)
+
+
+def _download(url: str, headers, location: str, timeout: int = 300):
+    asyncio.run(_download_async(url, headers, location, timeout))
 
