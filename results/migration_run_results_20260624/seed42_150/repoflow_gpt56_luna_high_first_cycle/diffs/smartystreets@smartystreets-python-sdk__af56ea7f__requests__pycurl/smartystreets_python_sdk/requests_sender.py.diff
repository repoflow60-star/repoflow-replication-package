+def build_smarty_response(inner_response, error=None, status_code=None, headers=None):
+    if status_code is None:
+        return Response(inner_response.text, inner_response.status_code, inner_response.headers, error)
+    return Response(inner_response, status_code, headers, error)
+
+
+def format_headers(headers):
+    return ['{}: {}'.format(name, value) for name, value in headers.items()]
+
+
+def parse_response_headers(raw_headers):
+    headers = {}
+    for raw_header in raw_headers:
+        if isinstance(raw_header, bytes):
+            header = raw_header.decode('iso-8859-1').strip()
+        else:
+            header = raw_header.strip()
+        if not header or header.startswith('HTTP/'):
+            if header.startswith('HTTP/'):
+                headers = {}
+            continue
+        if ':' in header:
+            name, value = header.split(':', 1)
+            headers[name.strip()] = value.strip()
+    return headers
 
 
