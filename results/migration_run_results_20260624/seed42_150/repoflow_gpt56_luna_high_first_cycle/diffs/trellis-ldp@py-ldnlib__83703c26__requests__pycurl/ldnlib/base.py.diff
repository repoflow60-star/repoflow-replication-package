     def __init__(self, **kwargs):
         self.accept_headers = kwargs.get('accept_headers', self.ACCEPT_HEADERS)
 
+    def _request(self, method, url, **kwargs):
+        """Perform an HTTP request with libcurl and return its result data."""
+        headers = kwargs.pop('headers', {})
+        allow_redirects = kwargs.pop('allow_redirects', True)
+        auth = kwargs.pop('auth', None)
+        data = kwargs.pop('data', None)
+        params = kwargs.pop('params', None)
+        timeout = kwargs.pop('timeout', None)
+        verify = kwargs.pop('verify', True)
+        kwargs.pop('stream', None)
+
+        if kwargs:
+            unsupported = ', '.join(sorted(kwargs))
+            raise TypeError("Unsupported request options: {}".format(
+                unsupported))
+
+        if params:
+            query = urlencode(params, doseq=True)
+            parts = urlsplit(url)
+            existing_query = parts.query
+            if existing_query and query:
+                query = existing_query + '&' + query
+            elif existing_query:
+                query = existing_query
+            url = urlunsplit((parts.scheme, parts.netloc, parts.path,
+                              query, parts.fragment))
+
+        body = BytesIO()
+        response_headers = BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            curl.setopt(pycurl.WRITEFUNCTION, body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, response_headers.write)
+            curl.setopt(pycurl.FOLLOWLOCATION, int(bool(allow_redirects)))
+
+            if method == 'HEAD':
+                curl.setopt(pycurl.NOBODY, 1)
+
+            if headers:
+                curl.setopt(pycurl.HTTPHEADER, [
+                    '{}: {}'.format(name, value)
+                    for name, value in headers.items()])
+
+            if data is not None:
+                if isinstance(data, str):
+                    data = data.encode('utf-8')
+                curl.setopt(pycurl.POSTFIELDS, data)
+
+            if auth is not None:
+                curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+                curl.setopt(pycurl.USERPWD, '{}:{}'.format(*auth))
+
+            if timeout is not None:
+                if isinstance(timeout, tuple):
+                    curl.setopt(pycurl.CONNECTTIMEOUT, timeout[0])
+                    curl.setopt(pycurl.TIMEOUT, timeout[1])
+                else:
+                    curl.setopt(pycurl.TIMEOUT, timeout)
+
+            if verify is False:
+                curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+                curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+            elif isinstance(verify, str):
+                curl.setopt(pycurl.CAINFO, verify)
+
+            curl.perform()
+            status = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        headers = self._parse_headers(response_headers.getvalue())
+        text = self._decode_body(body.getvalue(), headers)
+        return status, headers, text
+
+    @staticmethod
+    def _parse_headers(raw_headers):
+        headers = {}
+        for line in raw_headers.decode('iso-8859-1').splitlines():
+            if line.startswith('HTTP/'):
+                headers = {}
+            elif ':' in line:
+                name, value = line.split(':', 1)
+                headers[name.lower()] = value.strip()
+        return headers
+
+    @staticmethod
+    def _decode_body(body, headers):
+        encoding = 'utf-8'
+        content_type = headers.get('content-type', '')
+        match = re.search(r'charset=([^;\s]+)', content_type, re.IGNORECASE)
+        if match:
+            encoding = match.group(1).strip('"\'')
+        return body.decode(encoding, errors='replace')
+
+    @staticmethod
+    def _raise_for_status(status, url):
+        if status >= 400:
+            raise RuntimeError("HTTP {} for {}".format(status, url))
+
+    @staticmethod
+    def _link(headers, relation):
+        for link in headers.get('link', '').split(','):
+            match = re.match(
+                r'\s*<([^>]+)>\s*;\s*rel=(?:"([^"]+)"|([^;\s]+))',
+                link)
+            if match and relation in (match.group(2) or match.group(3)).split():
+                return match.group(1)
