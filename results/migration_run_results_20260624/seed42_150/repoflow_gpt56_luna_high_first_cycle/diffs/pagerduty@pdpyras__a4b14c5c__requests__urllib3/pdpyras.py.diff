+class _RequestInfo:
+    """Metadata describing the request that produced a response."""
+
+    def __init__(self, method, url):
+        self.method = method
+        self.url = url
+
+
+class PDResponse:
+    """Response facade preserving the response attributes used by the client."""
+
+    def __init__(self, response, method, url, elapsed):
+        self.status_code = response.status
+        self.headers = response.headers
+        self.content = response.data
+        self.request = _RequestInfo(method, url)
+        self.url = url
+        self.elapsed = timedelta(seconds=elapsed)
+        self.reason = response.reason
+        self.encoding = 'utf-8'
+
+    @property
+    def ok(self):
+        return self.status_code < 400
+
+    @property
+    def text(self):
+        return self.content.decode(self.encoding, errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
 
