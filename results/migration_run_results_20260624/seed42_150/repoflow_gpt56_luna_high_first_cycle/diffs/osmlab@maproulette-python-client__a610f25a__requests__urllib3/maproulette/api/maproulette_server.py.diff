+    def _create_session(self):
+        """Create a connection pool with the configured TLS and request settings."""
+        pool_options = {
+            "headers": {key: value for key, value in self.headers.items() if value is not None}
+        }
+        if self.verify is False:
+            pool_options["cert_reqs"] = "CERT_NONE"
+        else:
+            pool_options["cert_reqs"] = "CERT_REQUIRED"
+            if isinstance(self.verify, str):
+                pool_options["ca_certs"] = self.verify
+
+        if self.certs:
+            if isinstance(self.certs, tuple):
+                pool_options["cert_file"], pool_options["key_file"] = self.certs
+            else:
+                pool_options["cert_file"] = self.certs
+        return urllib3.PoolManager(**pool_options)
 
