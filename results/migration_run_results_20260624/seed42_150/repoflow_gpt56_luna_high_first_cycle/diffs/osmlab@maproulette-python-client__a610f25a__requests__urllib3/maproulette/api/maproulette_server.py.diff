+    def _request(self, method, url, params=None, body=None, files=None):
+        request_url = url
+        if params:
+            request_url += ('&' if '?' in request_url else '?') + urlencode(params, doseq=True)
+
+        request_options = {"retries": False}
+        if files is not None:
+            request_options["fields"] = files
+        elif body is not None:
+            request_options["body"] = json.dumps(body)
+            request_options["headers"] = {"Content-Type": "application/json"}
+
+        try:
+            return self.session.request(method, request_url, **request_options)
+        except urllib3.exceptions.HTTPError as error:
+            raise ConnectionUnavailableError(message=str(error)) from None
+
+    @staticmethod
+    def _response_body(response):
