+
+_reactor_lock = Lock()
+_reactor_ready = Event()
+_reactor_thread = None
+
+
+class _EndpointFactory:
+    def __init__(self, reactor_instance, ip_version):
+        self.reactor = reactor_instance
+        self.ip_version = ip_version
+
+    def endpointForURI(self, uri):  # noqa: N802
+        return _endpoint_for_host(self.reactor, self.ip_version, uri.host, uri.port)
+
+
+def _endpoint_for_host(reactor_instance, ip_version, host, port):
+    endpoint = HostnameEndpoint
+    if ip_version == socket.AF_INET:
+        endpoint = TCP4ClientEndpoint
+    elif ip_version == socket.AF_INET6:
+        endpoint = TCP6ClientEndpoint
+    return endpoint(reactor_instance, host, port)
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _reactor_thread
+
+    with _reactor_lock:
+        if reactor.running:
+            _reactor_ready.set()
+        elif _reactor_thread is None:
+            _reactor_thread = Thread(target=_run_reactor, name="pastepwn-twisted-reactor", daemon=True)
+            _reactor_thread.start()
+
+    _reactor_ready.wait()
+
+
+def _headers_to_treq(headers):
+    values = {}
+    for name, value in headers.items():
+        if not isinstance(value, (list, tuple)):
+            value = [value]
+        values[_to_bytes(name)] = [_to_bytes(item) for item in value]
+    return Headers(values)
+
+
+def _to_bytes(value):
+    if isinstance(value, bytes):
+        return value
+    return str(value).encode("utf-8")
+
+
+def _proxy_for_url(url, proxies):
+    if not isinstance(proxies, dict):
+        return None
+
+    scheme = urlsplit(url).scheme.lower()
+    return proxies.get(scheme) or proxies.get(scheme.upper()) or proxies.get("all")
+
+
+def _proxy_agent(url, proxies):
+    proxy_url = _proxy_for_url(url, proxies)
+    if not proxy_url:
+        return None
+
+    proxy = urlsplit(proxy_url)
+    endpoint = _endpoint_for_host(reactor, get_ip_version(), proxy.hostname, proxy.port or 80)
+    return ProxyAgent(reactor, endpoint)
+
+
+def _request_in_reactor(method, url, data, timeout, headers, proxies):
+    agent = _proxy_agent(url, proxies)
+    if agent is None:
+        agent = Agent.usingEndpointFactory(reactor, _EndpointFactory(reactor, get_ip_version()))
+    deferred = treq.request(
+        method,
+        url,
+        data=data,
+        headers=_headers_to_treq(headers),
+        timeout=timeout,
+        agent=agent,
+    )
+    deferred.addCallback(treq.content)
+    deferred.addCallback(lambda content: content.decode("utf-8"))
+    return deferred
 
 
