+def _new_plot(figsize):
+    """Create a fresh plotting surface through Seaborn's figure manager."""
+    width, height = figsize
+    grid = sns.FacetGrid(
+        pd.DataFrame({"_panel": [0]}),
+        height=height,
+        aspect=width / height,
+    )
+    ax = grid.axes.flat[0]
+    ax.clear()
+    return grid, ax
+
+
+def _new_plot_grid(num_rows, num_cols, figsize):
+    """Create a fixed-size grid, including unused panels for stable layouts."""
+    rows = np.repeat(np.arange(num_rows), num_cols)
+    cols = np.tile(np.arange(num_cols), num_rows)
+    grid = sns.FacetGrid(
+        pd.DataFrame({"_row": rows, "_col": cols}),
+        row="_row",
+        col="_col",
+        row_order=list(range(num_rows)),
+        col_order=list(range(num_cols)),
+        height=figsize[1] / num_rows,
+        aspect=(figsize[0] / num_cols) / (figsize[1] / num_rows),
+        sharex=False,
+        sharey=False,
+    )
+    grid.set_titles("")
+    return grid, grid.axes
+
+
+def _wordcloud_intensity(cloud):
+    """Convert a word cloud image to the 2-D data expected by heatmap."""
+    image = np.asarray(cloud)
+    if image.ndim == 3:
+        return (
+            0.299 * image[:, :, 0]
+            + 0.587 * image[:, :, 1]
+            + 0.114 * image[:, :, 2]
+        )
+    return image
+
+
+def _plot_wordcloud(ax, cloud):
+    sns.heatmap(
+        _wordcloud_intensity(cloud),
+        ax=ax,
+        cmap="gray",
+        cbar=False,
+        xticklabels=False,
+        yticklabels=False,
+    )
+    ax.set_axis_off()
+
+
+def _plot_colored_scatter(ax, x, y, colors, **kwargs):
+    if len(x) == 0:
+        return
+    color_keys = [str(color) for color in colors]
+    data = pd.DataFrame({"x": x, "y": y, "color": color_keys})
+    palette = {key: key for key in set(color_keys)}
+    sns.scatterplot(
+        data=data,
+        x="x",
+        y="y",
+        hue="color",
+        palette=palette,
+        legend=False,
+        ax=ax,
+        **kwargs,
+    )
+
+
