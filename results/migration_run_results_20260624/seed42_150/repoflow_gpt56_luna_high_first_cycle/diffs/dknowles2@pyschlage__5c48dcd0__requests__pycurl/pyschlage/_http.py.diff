--- a/pyschlage/_http.py
+++ b/pyschlage/_http.py
@@ -0,0 +1,155 @@
+"""Small pycurl-backed HTTP primitives used by the API client."""
+
+from __future__ import annotations
+
+from io import BytesIO
+import json
+from typing import Any, Callable, Mapping
+from urllib.parse import urlencode
+
+import pycurl
+
+
+class CurlHTTPError(Exception):
+    """Raised when a pycurl response has an HTTP error status."""
+
+    def __init__(self, response: "CurlResponse") -> None:
+        self.response = response
+        reason = f" {response.reason}" if response.reason else ""
+        super().__init__(f"{response.status_code}{reason}")
+
+
+class CurlResponse:
+    """Response data returned by a pycurl request."""
+
+    def __init__(
+        self,
+        content: bytes,
+        headers: Mapping[str, str],
+        reason: str,
+        status_code: int,
+    ) -> None:
+        self.content = content
+        self.headers = dict(headers)
+        self.reason = reason
+        self.status_code = status_code
+
+    @property
+    def text(self) -> str:
+        """Returns the response body decoded as UTF-8 text."""
+        return self.content.decode("utf-8")
+
+    def json(self) -> Any:
+        """Decodes the response body as JSON."""
+        return json.loads(self.content)
+
+    def raise_for_status(self) -> None:
+        """Raises for client and server error responses."""
+        if self.status_code >= 400:
+            raise CurlHTTPError(self)
+
+
+class CurlRequest:
+    """Request context accepted by pycognito's auth callback."""
+
+    def __init__(
+        self,
+        method: str = "",
+        url: str = "",
+        headers: dict[str, str] | None = None,
+        body: bytes | None = None,
+    ) -> None:
+        self.method = method
+        self.url = url
+        self.headers = headers if headers is not None else {}
+        self.body = body
+
+
+def apply_auth(
+    auth: Callable[[CurlRequest], CurlRequest], request: CurlRequest
+) -> CurlRequest:
+    """Apply an auth callback to a curl request context."""
+    authenticated = auth(request)
+    return authenticated if authenticated is not None else request
+
+
+def request(
+    method: str,
+    url: str,
+    *,
+    headers: Mapping[str, str] | None = None,
+    params: Mapping[str, Any] | None = None,
+    json_body: Any = None,
+    data: Any = None,
+    timeout: float = 60,
+    auth: Callable[[CurlRequest], CurlRequest] | None = None,
+) -> CurlResponse:
+    """Perform an HTTP request using pycurl."""
+    if params:
+        separator = "&" if "?" in url else "?"
+        url = f"{url}{separator}{urlencode(params, doseq=True)}"
+
+    request_headers = dict(headers or {})
+    body: bytes | None = None
+    if json_body is not None:
+        body = json.dumps(json_body).encode("utf-8")
+        request_headers.setdefault("Content-Type", "application/json")
+    elif data is not None:
+        if isinstance(data, Mapping):
+            body = urlencode(data, doseq=True).encode("utf-8")
+        elif isinstance(data, str):
+            body = data.encode("utf-8")
+        else:
+            body = bytes(data)
+
+    request_context = CurlRequest(
+        method=method,
+        url=url,
+        headers=request_headers,
+        body=body,
+    )
+    if auth is not None:
+        request_context = apply_auth(auth, request_context)
+
+    response_body = BytesIO()
+    response_headers = BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, request_context.url)
+        curl.setopt(pycurl.CUSTOMREQUEST, request_context.method.upper())
+        curl.setopt(
+            pycurl.HTTPHEADER,
+            [f"{key}: {value}" for key, value in request_context.headers.items()],
+        )
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.TIMEOUT, timeout)
+        curl.setopt(pycurl.WRITEDATA, response_body)
+        curl.setopt(pycurl.HEADERFUNCTION, response_headers.write)
+        if request_context.body is not None:
+            curl.setopt(pycurl.POSTFIELDS, request_context.body)
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+
+    headers_by_name, reason = _parse_headers(response_headers.getvalue())
+    return CurlResponse(
+        content=response_body.getvalue(),
+        headers=headers_by_name,
+        reason=reason,
+        status_code=status_code,
+    )
+
+
+def _parse_headers(raw_headers: bytes) -> tuple[dict[str, str], str]:
+    headers: dict[str, str] = {}
+    reason = ""
+    for raw_line in raw_headers.splitlines():
+        line = raw_line.decode("iso-8859-1")
+        if line.startswith("HTTP/"):
+            parts = line.split(" ", 2)
+            reason = parts[2] if len(parts) == 3 else ""
+        elif ":" in line:
+            name, value = line.split(":", 1)
+            headers[name.strip()] = value.strip()
+    return headers, reason
