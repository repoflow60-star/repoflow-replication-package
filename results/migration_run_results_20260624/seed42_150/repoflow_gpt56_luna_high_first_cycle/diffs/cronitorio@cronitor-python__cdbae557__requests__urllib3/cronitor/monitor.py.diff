 class Struct(object):
     def __init__(self, **kwargs):
         self.__dict__.update(kwargs)
+
+
+def _auth_headers(headers, api_key):
+    credentials = base64.b64encode('{}:'.format(api_key).encode('utf-8')).decode('ascii')
+    return dict(headers, **{'Authorization': 'Basic {}'.format(credentials)})
+
+
+def _response_text(response):
+    return response.data.decode('utf-8')
