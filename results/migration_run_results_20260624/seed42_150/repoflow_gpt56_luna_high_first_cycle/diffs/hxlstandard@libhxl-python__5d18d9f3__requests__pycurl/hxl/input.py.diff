+class _CaseInsensitiveHeaders(dict):
+    """HTTP headers with case-insensitive lookup."""
+
+    def __setitem__(self, key, value):
+        super().__setitem__(key.lower(), value)
+
+    def __getitem__(self, key):
+        return super().__getitem__(key.lower())
+
+    def get(self, key, default=None):
+        return super().get(key.lower(), default)
+
+
+class _CurlResult:
+    """Small response value containing the data needed by the input code."""
+
+    def __init__(self, status_code, headers, content):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+
+    @property
+    def is_redirect(self):
+        return self.status_code in (301, 302, 303, 307, 308) and 'location' in self.headers
+
+    def json(self):
+        return json.loads(self.content.decode('utf-8'))
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise IOError("HTTP error {}".format(self.status_code))
+
+
+def _http_request(url, method='GET', verify_ssl=True, timeout=None,
+                  headers=None, params=None, data=None):
+    """Execute an HTTP request through libcurl and collect its result."""
+    if params:
+        query = urllib.parse.urlencode(params, doseq=True)
+        url = '{}{}{}'.format(url, '&' if '?' in url else '?', query)
+
+    body = io.BytesIO()
+    response_headers = _CaseInsensitiveHeaders()
+    curl = pycurl.Curl()
+    curl.setopt(pycurl.URL, url)
+    curl.setopt(pycurl.WRITEFUNCTION, body.write)
+
+    def save_header(header):
+        line = header.decode('iso-8859-1').strip()
+        if line.upper().startswith('HTTP/'):
+            response_headers.clear()
+        elif ':' in line:
+            name, value = line.split(':', 1)
+            response_headers[name.strip()] = value.strip()
+        return len(header)
+
+    curl.setopt(pycurl.HEADERFUNCTION, save_header)
+    curl.setopt(pycurl.SSL_VERIFYPEER, bool(verify_ssl))
+    curl.setopt(pycurl.SSL_VERIFYHOST, 2 if verify_ssl else 0)
+    if timeout is not None:
+        curl.setopt(pycurl.TIMEOUT, timeout)
+
+    if headers:
+        curl.setopt(
+            pycurl.HTTPHEADER,
+            ['{}: {}'.format(name, value) for name, value in headers.items()]
+        )
+
+    if method == 'HEAD':
+        curl.setopt(pycurl.NOBODY, True)
+    elif method == 'POST':
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.POST, True)
+        if data is not None:
+            curl.setopt(pycurl.POSTFIELDS, urllib.parse.urlencode(data, doseq=True))
+    else:
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.HTTPGET, True)
+
+    try:
+        curl.perform()
+        return _CurlResult(
+            curl.getinfo(pycurl.RESPONSE_CODE),
+            response_headers,
+            body.getvalue()
+        )
+    finally:
+        curl.close()
 
