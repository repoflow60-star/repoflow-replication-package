--- a/src/coguard_cli/http_client.py
+++ b/src/coguard_cli/http_client.py
@@ -0,0 +1,52 @@
+"""Synchronous HTTP access backed by aiohttp."""
+
+import asyncio
+from typing import Any, Dict, Optional, Tuple
+
+import aiohttp
+
+
+async def _request(
+        method: str,
+        url: str,
+        headers: Optional[Dict[str, str]],
+        data: Any,
+        json_data: Any,
+        timeout: float,
+        raise_for_status: bool) -> Tuple[int, str, str, bytes]:
+    request_kwargs = {
+        "headers": headers,
+        "data": data,
+        "timeout": timeout,
+    }
+    if json_data is not None:
+        request_kwargs["json"] = json_data
+
+    async with aiohttp.ClientSession() as session:
+        async with session.request(method, url, **request_kwargs) as response:
+            if raise_for_status:
+                response.raise_for_status()
+            content = await response.read()
+            encoding = response.charset or "utf-8"
+            response_text = content.decode(encoding, errors="replace")
+            return response.status, response.reason or "", response_text, content
+
+
+def request(
+        method: str,
+        url: str,
+        headers: Optional[Dict[str, str]] = None,
+        data: Any = None,
+        json_data: Any = None,
+        timeout: float = 300,
+        raise_for_status: bool = False) -> Tuple[int, str, str, bytes]:
+    """Make one HTTP request while preserving the package's sync API."""
+    return asyncio.run(_request(
+        method,
+        url,
+        headers,
+        data,
+        json_data,
+        timeout,
+        raise_for_status,
+    ))
