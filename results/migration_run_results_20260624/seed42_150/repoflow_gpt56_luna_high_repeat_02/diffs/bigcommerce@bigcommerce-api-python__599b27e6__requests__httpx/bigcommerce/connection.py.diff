+class _SessionHeaders(dict):
+    """Expose a dict-compatible header store while updating the HTTP client."""
+
+    def __init__(self, session, values=None):
+        self._session = session
+        dict.__init__(self, values or {})
+
+    def __setitem__(self, key, value):
+        dict.__setitem__(self, key, value)
+        self._session._sync_headers()
+
+    def __delitem__(self, key):
+        dict.__delitem__(self, key)
+        self._session._sync_headers()
+
+    def clear(self):
+        dict.clear(self)
+        self._session._sync_headers()
+
+    def pop(self, key, *args):
+        result = dict.pop(self, key, *args)
+        self._session._sync_headers()
+        return result
+
+    def popitem(self):
+        result = dict.popitem(self)
+        self._session._sync_headers()
+        return result
+
+    def setdefault(self, key, default=None):
+        result = dict.setdefault(self, key, default)
+        self._session._sync_headers()
+        return result
+
+    def update(self, values=None, **kwargs):
+        if values is not None:
+            dict.update(self, values)
+        if kwargs:
+            dict.update(self, kwargs)
+        self._session._sync_headers()
+
+
+class _HttpxSession(httpx.Client):
+    """Use httpx while retaining the session attributes exposed by this client."""
+
+    def __init__(self):
+        super().__init__()
+        self._compat_auth = None
+        self.headers = {}
+
+    @property
+    def auth(self):
+        return self._compat_auth
+
+    @auth.setter
+    def auth(self, value):
+        self._compat_auth = value
+        if isinstance(value, tuple):
+            self._auth = httpx.BasicAuth(*value)
+        else:
+            self._auth = value
+
+    @property
+    def headers(self):
+        return self._compat_headers
+
+    @headers.setter
+    def headers(self, value):
+        self._compat_headers = _SessionHeaders(self, value)
+        self._sync_headers()
+
+    def _sync_headers(self):
+        self._headers = httpx.Headers(self._compat_headers)
 
 
