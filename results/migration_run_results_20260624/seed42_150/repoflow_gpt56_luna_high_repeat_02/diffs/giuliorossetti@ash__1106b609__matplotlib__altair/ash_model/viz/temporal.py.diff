+def _mark_options(kwargs):
+    options = {}
+    if "color" in kwargs:
+        options["color"] = kwargs["color"]
+    if "alpha" in kwargs:
+        options["opacity"] = kwargs["alpha"]
+    if "linewidth" in kwargs:
+        options["strokeWidth"] = kwargs["linewidth"]
+    return options
+
+
+def _properties(kwargs):
+    return {
+        key: kwargs[key]
+        for key in ("width", "height", "title", "background", "padding")
+        if key in kwargs
+    }
 
 
