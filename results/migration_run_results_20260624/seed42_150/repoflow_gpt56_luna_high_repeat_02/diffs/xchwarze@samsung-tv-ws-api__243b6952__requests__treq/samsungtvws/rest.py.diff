 from . import connection, exceptions, helper
 
 _LOGGING = logging.getLogger(__name__)
+_REACTOR_LOCK = threading.Lock()
+_REACTOR_READY = threading.Event()
+_REACTOR_THREAD: Optional[threading.Thread] = None
+_HTTP_CLIENT: Optional[HTTPClient] = None
+
+
+def _run_reactor() -> None:
+    reactor.callWhenRunning(_REACTOR_READY.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _get_http_client() -> HTTPClient:
+    global _HTTP_CLIENT
+    if _HTTP_CLIENT is None:
+        _HTTP_CLIENT = HTTPClient(
+            Agent(reactor, contextFactory=ClientContextFactory())
+        )
+    return _HTTP_CLIENT
+
+
+def _request_text(method: str, url: str, timeout: Optional[float]) -> str:
+    @defer.inlineCallbacks
+    def request() -> Any:
+        response = yield _get_http_client().request(
+            method, url, timeout=timeout
+        )
+        body = yield text_content(response)
+        return body
+
+    global _REACTOR_THREAD
+    if not reactor.running:
+        with _REACTOR_LOCK:
+            if _REACTOR_THREAD is None:
+                _REACTOR_THREAD = threading.Thread(
+                    target=_run_reactor,
+                    name="samsungtvws-treq-reactor",
+                    daemon=True,
+                )
+                _REACTOR_THREAD.start()
+        _REACTOR_READY.wait()
+
+    return cast(str, blockingCallFromThread(reactor, request))
 
 
