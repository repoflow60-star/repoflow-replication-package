+class _CurlResponse(object):
+    """Small response object exposing the attributes used by the client."""
+
+    def __init__(self, status_code, headers, content, reason=''):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+        self.reason = reason
+
+    def json(self):
+        return loads(self.content.decode('utf-8'))
+
+
+class _CurlSession(object):
+    """Session-like wrapper that keeps connection configuration between calls."""
+
+    def __init__(self):
+        self.auth = None
+        self.headers = {}
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        response_body = BytesIO()
+        response_headers = {}
+        response_reason = ['']
+        curl = pycurl.Curl()
+
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        def receive_header(line):
+            line = line.decode('iso-8859-1').strip('\r\n')
+            if line.startswith('HTTP/'):
+                parts = line.split(' ', 2)
+                response_reason[0] = parts[2] if len(parts) > 2 else ''
+            elif ':' in line:
+                name, value = line.split(':', 1)
+                response_headers[name.strip()] = value.strip()
+
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, receive_header)
+            curl.setopt(pycurl.HTTPHEADER,
+                        ['%s: %s' % (name, value) for name, value in request_headers.items()])
+            if timeout is not None:
+                curl.setopt(pycurl.TIMEOUT_MS, int(timeout * 1000))
+
+            if self.auth:
+                curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+                curl.setopt(pycurl.USERPWD, '%s:%s' % self.auth)
+            if data is not None:
+                if isinstance(data, str):
+                    data = data.encode('utf-8')
+                curl.setopt(pycurl.POSTFIELDS, data)
+
+            curl.perform()
+            return _CurlResponse(curl.getinfo(pycurl.RESPONSE_CODE),
+                                 response_headers, response_body.getvalue(), response_reason[0])
+        finally:
+            curl.close()
 
 
 class Connection(object):
