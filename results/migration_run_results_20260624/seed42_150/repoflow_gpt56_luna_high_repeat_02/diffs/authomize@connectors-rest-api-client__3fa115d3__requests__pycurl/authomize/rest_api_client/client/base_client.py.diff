+class _PycurlSession:
+    def __init__(self):
+        self.headers = {}
+
+    def _request(self, method, url, params=None, headers=None, data=None):
+        if params:
+            if hasattr(params, 'items'):
+                params = [
+                    (key, value)
+                    for key, value in params.items()
+                    if value is not None
+                ]
+            else:
+                params = [(key, value) for key, value in params if value is not None]
+            query = urlencode(params, doseq=True)
+            if query:
+                url = f'{url}{"&" if "?" in url else "?"}{query}'
+
+        request_headers = dict(self.headers)
+        for key, value in (headers or {}).items():
+            for existing_key in list(request_headers):
+                if existing_key.lower() == key.lower():
+                    del request_headers[existing_key]
+            request_headers[key] = value
+
+        response_body = BytesIO()
+        response_headers = BytesIO()
