+def tabulate(rows: List[List[Any]], headers: List[str], tablefmt: str) -> str:
+    """Render a report table with PrettyTable."""
+    table = PrettyTable()
+    table.field_names = headers
+    table.add_rows(rows)
+
+    if tablefmt == "github":
+        table.align = "l"
+        table.set_style(TableStyle.MARKDOWN)
+        return table.get_string()
+
+    table_rows = [table.field_names, *table.rows]
+    widths = [
+        max(
+            len(str(table.field_names[index])) + 2,
+            max(
+                (len(str(row[index])) for row in table.rows),
+                default=0,
+            ),
+        )
+        for index in range(len(table.field_names))
+    ]
+    rule = "  ".join("=" * width for width in widths)
+    formatted_rows = [
+        "  ".join(
+            str(value).ljust(width) if index < len(widths) - 1 else str(value)
+            for index, (value, width) in enumerate(zip(row, widths))
+        )
+        for row in table_rows
+    ]
+    return "\n".join([rule, *formatted_rows[:1], rule, *formatted_rows[1:], rule])
 
 
