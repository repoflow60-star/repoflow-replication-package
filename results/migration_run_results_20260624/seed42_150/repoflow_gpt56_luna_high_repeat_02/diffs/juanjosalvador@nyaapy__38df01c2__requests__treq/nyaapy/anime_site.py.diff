-import requests
+from threading import Event, Lock, Thread
+
+import treq
+from twisted.internet import defer, reactor, threads
+
 from nyaapy import torrent
 from nyaapy.parser import parse_nyaa, parse_single, parse_nyaa_rss
+
+
+_reactor_lock = Lock()
+_reactor_ready = Event()
+_reactor_thread = None
+
+
+def _ensure_reactor():
+    global _reactor_thread
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if _reactor_thread is None:
+            _reactor_ready.clear()
+
+            def run_reactor():
+                reactor.callWhenRunning(_reactor_ready.set)
+                reactor.run(installSignalHandlers=False)
+
+            _reactor_thread = Thread(target=run_reactor, daemon=True)
+            _reactor_thread.start()
+
+    _reactor_ready.wait()
+
+
+def _get_content(url):
+    @defer.inlineCallbacks
+    def request():
+        response = yield treq.get(url)
+        if response.code >= 400:
+            phrase = response.phrase
+            if isinstance(phrase, bytes):
+                phrase = phrase.decode("ascii", errors="replace")
+            raise RuntimeError(f"HTTP {response.code}: {phrase}")
+        content = yield treq.content(response)
+        defer.returnValue(content)
+
+    _ensure_reactor()
+    return threads.blockingCallFromThread(reactor, request)
 
 
