+def tabulate(rows: List[List], headers: List[str], tablefmt: str) -> str:
+    """Render a report table with Rich using the legacy output formats."""
+    string_headers = [str(header) for header in headers]
+    string_rows = [[str(value) for value in row] for row in rows]
+    table = Table(
+        *string_headers,
+        box=box.MARKDOWN if tablefmt == "github" else box.ASCII,
+    )
+    for row in string_rows:
+        table.add_row(*row)
+
+    column_widths = [len(header) + 2 for header in string_headers]
+    for row in string_rows:
+        for index, value in enumerate(row):
+            if index < len(column_widths):
+                column_widths[index] = max(column_widths[index], len(value))
+
+    output = StringIO()
+    rendered_width = sum(column_widths) + 3 * len(column_widths)
+    Console(
+        file=output,
+        width=rendered_width,
+        color_system=None,
+        force_terminal=False,
+        markup=False,
+    ).print(table)
+    rendered = output.getvalue().rstrip("\n")
+
+    if tablefmt == "github":
+        return rendered
+
+    separator = "  ".join("=" * width for width in column_widths)
+    report_rows = [
+        "  ".join(
+            value.ljust(width)
+            for value, width in zip(row, column_widths)
+        ).rstrip()
+        for row in [string_headers, *string_rows]
+    ]
+    return "\n".join([separator, report_rows[0], separator, *report_rows[1:], separator])
 
 
