+    def _request(
+        self,
+        method: str,
+        url: str,
+        params: Optional[Dict] = None,
+        data: Any = None,
+        json: Any = None,
+        timeout: Optional[int] = None,
+        use_session_headers: bool = True,
+    ) -> Tuple[bytes, int]:
+        """Perform an HTTP request using the shared pycurl handle."""
+        if params:
+            query = urlencode(params, doseq=True)
+            url += ("&" if "?" in url else "?") + query
+
+        request_headers = []
+        if use_session_headers:
+            request_headers = [
+                "{}: {}".format(key, value) for key, value in self.headers.items()
+            ]
+
+        body = None
+        if data is not None:
+            if isinstance(data, dict):
+                body = urlencode(data, doseq=True).encode("utf-8")
+                request_headers.append("Content-Type: application/x-www-form-urlencoded")
+            elif isinstance(data, bytes):
+                body = data
+            else:
+                body = str(data).encode("utf-8")
+        elif json is not None:
+            body = jsonlib.dumps(json).encode("utf-8")
+            request_headers.append("Content-Type: application/json")
+
+        response_buffer = io.BytesIO()
+        self.session.reset()
+        self.session.setopt(pycurl.URL, url)
+        self.session.setopt(pycurl.CUSTOMREQUEST, method.upper())
+        self.session.setopt(pycurl.HTTPHEADER, request_headers)
+        self.session.setopt(pycurl.FOLLOWLOCATION, True)
+        if timeout is not None:
+            self.session.setopt(pycurl.TIMEOUT, timeout)
+        self.session.setopt(pycurl.WRITEFUNCTION, response_buffer.write)
+        if body is not None:
+            self.session.setopt(pycurl.POSTFIELDS, body)
+        self.session.perform()
+
+        return response_buffer.getvalue(), int(self.session.getinfo(pycurl.RESPONSE_CODE))
+
+    @staticmethod
+    def _raise_for_status(status_code: int):
+        """Raise an exception for an unsuccessful HTTP response."""
+        if status_code >= 400:
+            raise RuntimeError("HTTP error {}".format(status_code))
 
