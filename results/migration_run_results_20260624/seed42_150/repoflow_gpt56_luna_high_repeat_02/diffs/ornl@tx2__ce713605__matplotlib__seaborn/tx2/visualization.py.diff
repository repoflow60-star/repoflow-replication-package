+def _scatter(ax, x, y, colors=None, legend=False, **kwargs):
+    """Render points through seaborn while preserving per-point colors."""
+    if np.isscalar(x):
+        x = [x]
+    if np.isscalar(y):
+        y = [y]
+
+    if colors is None:
+        return sns.scatterplot(x=x, y=y, ax=ax, legend=legend, **kwargs)
+
+    color_values = list(colors)
+    if not color_values:
+        return sns.scatterplot(x=x, y=y, ax=ax, legend=legend, **kwargs)
+    palette = {color: color for color in dict.fromkeys(color_values)}
+    return sns.scatterplot(
+        x=x,
+        y=y,
+        hue=color_values,
+        palette=palette,
+        ax=ax,
+        legend=legend,
+        **kwargs,
+    )
+
