+def _create_facet_grid(num_rows: int, num_cols: int, figsize):
+    """Create a seaborn-backed grid with a predictable two-dimensional shape."""
+    slots = pd.DataFrame({"_slot": range(num_rows * num_cols)})
+    cell_height = figsize[1] / num_rows
+    grid = sns.FacetGrid(
+        slots,
+        col="_slot",
+        col_wrap=num_cols,
+        height=cell_height,
+        aspect=figsize[0] / (num_cols * cell_height),
+        despine=False,
+    )
+    grid.set_titles("")
+    return grid.fig, np.asarray(grid.axes).reshape(num_rows, num_cols)
+
