+def _http_request(method, url, input_options, params=None, fields=None, redirect=False):
+    """Make an HTTP request with the options used by HXL inputs."""
+    if params:
+        separator = '&' if '?' in url else '?'
+        url = '{}{}{}'.format(url, separator, urllib.parse.urlencode(params))
+
+    headers = dict(input_options.http_headers or {})
+    body = None
+    if fields is not None:
+        body = urllib.parse.urlencode(fields).encode('utf-8')
+        headers.setdefault('Content-Type', 'application/x-www-form-urlencoded')
+
+    request_args = {
+        'decode_content': True,
+        'headers': headers,
+        'preload_content': True,
+        'redirect': redirect,
+        # Disable transport/status retries while retaining normal redirects.
+        'retries': urllib3.util.Retry(
+            total=30, connect=0, read=0, redirect=30, status=0
+        ),
+    }
+    if input_options.timeout is not None:
+        request_args['timeout'] = input_options.timeout
+    if body is not None:
+        request_args['body'] = body
+
+    pool = urllib3.PoolManager(
+        cert_reqs='CERT_REQUIRED' if input_options.verify_ssl else 'CERT_NONE'
+    )
+    try:
+        return pool.request(method, url, **request_args)
+    except urllib3.exceptions.HTTPError as error:
+        # Preserve the previous client's IOError-compatible failures.
+        raise IOError(str(error)) from error
+
+
+def _raise_for_status(response):
+    """Raise an IOError for an HTTP error response."""
+    if response.status >= 400:
+        raise IOError(
+            'HTTP Error {}: {}'.format(response.status, response.reason)
+        )
+
+
+def _response_json(response):
+    """Decode a JSON response body."""
+    return json.loads(response.data)
+
