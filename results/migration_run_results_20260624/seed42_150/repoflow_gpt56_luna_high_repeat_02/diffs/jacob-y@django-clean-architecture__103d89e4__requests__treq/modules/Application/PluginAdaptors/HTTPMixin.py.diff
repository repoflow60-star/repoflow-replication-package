+import treq
+from twisted.internet import reactor
+from twisted.internet.threads import blockingCallFromThread
+
+
+_reactor_lock = Lock()
+_reactor_started = Event()
+_reactor_launching = False
+
+
+def _ensure_reactor():
+    global _reactor_launching
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if not reactor.running and not _reactor_started.is_set() and not _reactor_launching:
+            _reactor_launching = True
+
+            def run_reactor():
+                reactor.callWhenRunning(_reactor_started.set)
+                reactor.run(installSignalHandlers=False)
+
+            Thread(target=run_reactor, daemon=True).start()
+
+    _reactor_started.wait()
+
+
+def _call_treq(function, *args, **kwargs):
+    _ensure_reactor()
+    return blockingCallFromThread(reactor, function, *args, **kwargs)
 
 
