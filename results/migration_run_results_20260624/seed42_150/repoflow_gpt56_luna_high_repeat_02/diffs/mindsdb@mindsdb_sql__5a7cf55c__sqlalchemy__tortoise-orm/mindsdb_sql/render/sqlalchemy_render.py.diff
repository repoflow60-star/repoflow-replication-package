+    def _order_expression(self, order):
+        expression = self._expression(order.field)
+        direction = order.direction.upper()
+        if direction in ('ASC', 'DESC'):
+            expression += ' ' + direction
+        nulls = order.nulls.upper()
+        if nulls in ('NULLS FIRST', 'NULLS LAST'):
+            expression += ' ' + nulls
+        return expression
+
+    def prepare_case(self, value):
+        parts = []
+        if value.arg is not None:
+            parts.append(self._expression(value.arg))
+        parts.append(' '.join(
+            f'WHEN {self._expression(condition)} THEN {self._expression(result)}'
+            for condition, result in value.rules
+        ))
+        if value.default is not None:
+            parts.append('ELSE ' + self._expression(value.default))
+        return 'CASE ' + ' '.join(parts) + ' END'
+
+    def to_function(self, value):
+        namespace = f'{value.namespace}.' if value.namespace else ''
+        if value.from_arg is not None:
+            args = [self._expression(item) for item in value.args]
+            args.append('FROM ' + self._expression(value.from_arg))
+            return f'{namespace}{value.op}(' + ' '.join(args) + ')'
+        args = [self._expression(item) for item in value.args]
+        if value.distinct and args:
+            args[0] = 'DISTINCT ' + args[0]
+        return f'{namespace}{value.op}(' + ', '.join(args) + ')'
 
