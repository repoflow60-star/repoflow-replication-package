+def _to_mako(template: str) -> str:
+    def replace_expression(match: Match[str]) -> str:
+        expression = match.group(1).strip()
+        parts = [part.strip() for part in expression.split('|')]
+        expression = parts[0]
+        for filter_name in parts[1:]:
+            expression = f'{filter_name}({expression})'
+        return '${' + expression + '}'
+
+    return re.sub(r'\{\{(.*?)\}\}', replace_expression, template)
 
