+    def _request(self, method, endpoint, params=None, body=None, multipart=False):
+        url = self.url + endpoint
+        if params:
+            url += ('&' if '?' in url else '?') + urlencode(params, doseq=True)
+
+        headers = self._request_headers()
+        request_kwargs = {"headers": headers}
+        if multipart:
+            request_kwargs["fields"] = body
+        elif body is not None:
+            request_kwargs["body"] = json.dumps(body).encode("utf-8")
+            headers["Content-Type"] = "application/json"
+
+        try:
+            return self.session.request(method, url, **request_kwargs)
+        except urllib3.exceptions.HTTPError as error:
+            raise ConnectionUnavailableError(error) from None
+
+    @staticmethod
+    def _response_text(response):
+        data = response.data
+        if isinstance(data, bytes):
+            return data.decode("utf-8", errors="replace")
+        return data
+
+    def _response_data(self, response):
+        data = response.data
+        try:
+            return {
+                "data": json.loads(data),
+                "status": response.status
+            }
+        except (TypeError, ValueError):
+            return {
+                "data": self._response_text(response),
+                "status": response.status
+            }
