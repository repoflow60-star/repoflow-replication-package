+        headers = _Headers()
+        for raw_line in raw_headers.splitlines():
+            line = raw_line.decode('latin1') if isinstance(raw_line, bytes) else raw_line
+            line = line.strip()
+            if not line:
+                continue
+            if line.startswith('HTTP/'):
+                headers = _Headers()
+                continue
+            if ':' in line:
+                key, value = line.split(':', 1)
+                headers[key.strip()] = value.strip()
+        return headers
