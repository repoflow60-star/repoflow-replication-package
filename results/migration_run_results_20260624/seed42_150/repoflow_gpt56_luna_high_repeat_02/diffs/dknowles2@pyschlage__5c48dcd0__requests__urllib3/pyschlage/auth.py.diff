+def _response_json(resp: HTTPResponse):
+    """Decode JSON from an urllib3 response."""
+    response_json = getattr(resp, "json", None)
+    if callable(response_json):
+        return response_json()
+    data = resp.data
+    if isinstance(data, bytes):
+        data = data.decode("utf-8")
+    return json.loads(data)
