+def _wait_for_treq(value):
+    if not hasattr(value, "addCallbacks"):
+        return value
+    from threading import Event, Thread
+    from twisted.internet import reactor
+
+    result = []
+    failure = []
+    done = Event()
+
+    def succeeded(response):
+        result.append(response)
+        done.set()
+        return response
+
+    def failed(error):
+        failure.append(error)
+        done.set()
+        return error
+
+    value.addCallbacks(succeeded, failed)
+    if not done.is_set():
+        if not reactor.running:
+            Thread(target=lambda: reactor.run(installSignalHandlers=False), daemon=True).start()
+        done.wait()
+    if failure:
+        failure[0].raiseException()
+    return result[0]
+
+
+def _get_treq_content(response):
+    if hasattr(response, "code"):
+        content = treq.content(response)
+    else:
+        content = getattr(response, "content")
+    if callable(content):
+        content = treq.content(response)
+    return _wait_for_treq(content)
+
+
+def _request_with_treq(request):
+    if not hasattr(request, "addCallback"):
+        return request
+
+    def include_content(response):
+        content = treq.content(response)
+        if hasattr(content, "addCallback"):
+            content.addCallback(lambda body: (response, body))
+            return content
+        return response, content
+
+    return _wait_for_treq(request.addCallback(include_content))
 
