+class _PycurlResponse:
+    """Response data collected from a pycurl request."""
+
+    def __init__(self, status_code, headers, content):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+        self.is_redirect = status_code in (301, 302, 303, 307, 308)
+
+    def iter_content(self, chunk_size=1):
+        """Yield the response body in chunks compatible with the old wrapper."""
+        for offset in range(0, len(self.content), chunk_size):
+            yield self.content[offset:offset + chunk_size]
+
+    def json(self):
+        return json.loads(self.content.decode('utf-8-sig'))
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise IOError("HTTP error {}".format(self.status_code))
+
+
+def _pycurl_request(url, method='GET', verify_ssl=True, timeout=None,
+                    headers=None, params=None, data=None,
+                    allow_redirects=True):
+    """Perform an HTTP request through pycurl."""
+    if params:
+        parsed_url = urllib.parse.urlsplit(url)
+        query = urllib.parse.urlencode(params, doseq=True)
+        if parsed_url.query:
+            query = '{}&{}'.format(parsed_url.query, query)
+        url = urllib.parse.urlunsplit((
+            parsed_url.scheme,
+            parsed_url.netloc,
+            parsed_url.path,
+            query,
+            parsed_url.fragment
+        ))
+
+    response_body = io.BytesIO()
+    response_headers = {}
+
+    def collect_headers(line):
+        if isinstance(line, bytes):
+            line = line.decode('iso-8859-1')
+        line = line.strip()
+        if not line:
+            return
+        if line.upper().startswith('HTTP/'):
+            response_headers.clear()
+        elif ':' in line:
+            name, value = line.split(':', 1)
+            response_headers[name.lower()] = value.strip()
+
+    curl = pycurl.Curl()
+    try:
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, collect_headers)
+            curl.setopt(pycurl.FOLLOWLOCATION, int(bool(allow_redirects)))
+            curl.setopt(pycurl.SSL_VERIFYPEER, int(bool(verify_ssl)))
+            curl.setopt(pycurl.SSL_VERIFYHOST, 2 if verify_ssl else 0)
+            curl.setopt(pycurl.ACCEPT_ENCODING, '')
+            if timeout is not None:
+                curl.setopt(pycurl.TIMEOUT, timeout)
+            if headers:
+                curl.setopt(
+                    pycurl.HTTPHEADER,
+                    ['{}: {}'.format(name, value) for name, value in headers.items()]
+                )
+
+            method = method.upper()
+            if method == 'HEAD':
+                curl.setopt(pycurl.NOBODY, 1)
+            elif method == 'POST':
+                curl.setopt(pycurl.POST, 1)
+                if data is not None:
+                    if isinstance(data, dict):
+                        data = urllib.parse.urlencode(data, doseq=True)
+                    curl.setopt(pycurl.POSTFIELDS, data)
+            else:
+                curl.setopt(pycurl.HTTPGET, 1)
+
+            curl.perform()
+        except pycurl.error as error:
+            # Keep connection and timeout failures IOError-compatible for callers.
+            raise IOError(str(error)) from error
+
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        return _PycurlResponse(status_code, response_headers, response_body.getvalue())
+    finally:
+        curl.close()
+
 
