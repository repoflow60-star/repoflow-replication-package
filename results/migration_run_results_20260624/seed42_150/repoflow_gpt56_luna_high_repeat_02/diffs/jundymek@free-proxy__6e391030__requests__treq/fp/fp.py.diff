+from twisted.internet.endpoints import TCP4ClientEndpoint
+from twisted.web.client import ProxyAgent
 
 from fp.errors import FreeProxyException
+
+
+_reactor_thread = None
+_reactor_lock = threading.Lock()
+_reactor_ready = threading.Event()
+
+
+def _start_reactor():
+    global _reactor_thread
+    with _reactor_lock:
+        if reactor.running:
+            if _reactor_thread is not None and threading.current_thread() is _reactor_thread:
+                raise RuntimeError('Cannot wait for treq from the reactor thread')
+            return
+        if _reactor_thread is not None:
+            raise RuntimeError('The Twisted reactor cannot be restarted')
+
+        def run_reactor():
+            reactor.callWhenRunning(_reactor_ready.set)
+            reactor.run(installSignalHandlers=False)
+
+        _reactor_thread = threading.Thread(
+            target=run_reactor, name='free-proxy-reactor', daemon=True)
+        _reactor_thread.start()
+    _reactor_ready.wait()
+
+
+def _resolve(deferred):
+    """Resolve a treq Deferred without changing FreeProxy's sync API."""
+    if not isinstance(deferred, Deferred):
+        return deferred
+
+    result = []
+    finished = threading.Event()
+
+    def succeeded(value):
+        result.append((True, value))
+        finished.set()
+        return value
+
+    def failed(failure):
+        result.append((False, failure))
+        finished.set()
+        return failure
+
+    deferred.addCallbacks(succeeded, failed)
+    if not finished.is_set():
+        _start_reactor()
+        finished.wait()
+
+    success, value = result[0]
+    if success:
+        return value
+    value.raiseException()
+
+
+def _resolve_call(operation):
+    if reactor.running:
+        if _reactor_thread is not None and threading.current_thread() is _reactor_thread:
+            raise RuntimeError('Cannot wait for treq from the reactor thread')
+
+        result = Deferred()
+
+        def invoke():
+            try:
+                deferred = operation()
+                if isinstance(deferred, Deferred):
+                    deferred.chainDeferred(result)
+                else:
+                    result.callback(deferred)
+            except Exception:
+                result.errback()
+
+        reactor.callFromThread(invoke)
+        return _resolve(result)
+    return _resolve(operation())
 
 
