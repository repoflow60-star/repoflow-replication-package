+    with _reactor_lock:
+        if not reactor.running:
+            if _reactor_thread is None:
+                _reactor_thread = threading.Thread(target=_run_reactor, daemon=True)
+                _reactor_thread.start()
+            _reactor_ready.wait()
+        elif threading.current_thread() is _reactor_thread:
+            raise RuntimeError('Synchronous HTTP calls cannot run on the Twisted reactor thread')
+
+    result = []
+    completed = threading.Event()
+
+    def succeeded(response):
+        result.append((True, response))
+        completed.set()
+        return response
+
+    def failed(failure):
+        result.append((False, failure))
+        completed.set()
+        return None
+
+    value.addCallbacks(succeeded, failed)
+    completed.wait()
+
+    success, response = result[0]
+    if not success:
+        response.raiseException()
+    return response
 
 
