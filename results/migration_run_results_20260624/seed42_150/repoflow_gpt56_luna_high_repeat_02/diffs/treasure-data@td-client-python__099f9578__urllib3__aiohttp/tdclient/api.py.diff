+class _BufferedResponse:
+    """Synchronous response view backed by an aiohttp response body."""
+
+    def __init__(self, status, headers, body):
+        self.status = status
+        self.headers = dict(headers)
+        self.data = body
+        self._position = 0
+        self._closed = False
+
+    def getheaders(self):
+        return self.headers
+
+    def read(self, amount=-1):
+        if self._closed:
+            return b""
+        if amount is None or amount < 0:
+            amount = len(self.data) - self._position
+        end = min(self._position + amount, len(self.data))
+        body = self.data[self._position : end]
+        self._position = end
+        return body
+
+    def stream(self, amount=65536):
+        while self._position < len(self.data):
+            yield self.read(amount)
+
+    def close(self):
+        self._closed = True
+
+
+class _AiohttpClient:
+    """Run aiohttp requests behind the client's synchronous transport API."""
+
+    def __init__(self, proxy=None, **kwargs):
+        self.proxy = proxy
+        self.proxy_auth = None
+        if proxy is not None:
+            parsed_proxy = urlparse.urlparse(proxy)
+            if parsed_proxy.username is not None:
+                self.proxy_auth = aiohttp.BasicAuth(
+                    urlparse.unquote(parsed_proxy.username),
+                    urlparse.unquote(parsed_proxy.password or ""),
+                )
+                proxy = urlparse.urlunparse(
+                    (
+                        parsed_proxy.scheme,
+                        parsed_proxy.netloc.rsplit("@", 1)[-1],
+                        parsed_proxy.path,
+                        parsed_proxy.params,
+                        parsed_proxy.query,
+                        parsed_proxy.fragment,
+                    )
+                )
+                self.proxy = proxy
+
+        ca_certs = kwargs.get("ca_certs")
+        cert_reqs = kwargs.get("cert_reqs")
+        cert_file = kwargs.get("cert_file")
+        key_file = kwargs.get("key_file")
+        self.ssl_context = None
+        if ca_certs is not None:
+            self.ssl_context = ssl.create_default_context(cafile=ca_certs)
+        elif cert_reqs in (ssl.CERT_NONE, "CERT_NONE"):
+            self.ssl_context = ssl.create_default_context()
+            self.ssl_context.check_hostname = False
+            self.ssl_context.verify_mode = ssl.CERT_NONE
+        elif cert_file is not None:
+            self.ssl_context = ssl.create_default_context()
+
+        if self.ssl_context is not None and cert_file is not None:
+            self.ssl_context.load_cert_chain(cert_file, key_file)
+
+        timeout = kwargs.get("timeout", 60)
+        if isinstance(timeout, tuple):
+            connect_timeout = timeout[0]
+            read_timeout = timeout[1] if len(timeout) > 1 else timeout[0]
+            self.timeout = aiohttp.ClientTimeout(
+                total=None, sock_connect=connect_timeout, sock_read=read_timeout
+            )
+        else:
+            self.timeout = aiohttp.ClientTimeout(total=timeout)
+
+    async def _request(self, method, url, fields=None, body=None, headers=None):
+        request_kwargs = {
+            "headers": headers,
+            "proxy": self.proxy,
+            "proxy_auth": self.proxy_auth,
+        }
+        if fields is not None:
+            if method in ("GET", "DELETE"):
+                request_kwargs["params"] = fields
+            else:
+                request_kwargs["data"] = fields
+        if body is not None:
+            if isinstance(body, (array, bytearray, memoryview)):
+                body = bytes(body)
+            request_kwargs["data"] = body
+
+        connector = aiohttp.TCPConnector(ssl=self.ssl_context)
+        async with aiohttp.ClientSession(
+            timeout=self.timeout, connector=connector, auto_decompress=True
+        ) as session:
+            async with session.request(method, url, **request_kwargs) as response:
+                return _BufferedResponse(
+                    response.status, response.headers, await response.read()
+                )
+
+    def request(self, method, url, fields=None, body=None, headers=None, **kwargs):
+        def run_request():
+            return asyncio.run(
+                self._request(method, url, fields=fields, body=body, headers=headers)
+            )
+
+        try:
+            asyncio.get_running_loop()
+        except RuntimeError:
+            return run_request()
+
+        result = []
+        failure = []
+
+        def run_in_thread():
+            try:
+                result.append(run_request())
+            except BaseException as error:
+                failure.append(error)
+
+        thread = threading.Thread(target=run_in_thread)
+        thread.start()
+        thread.join()
+        if failure:
+            raise failure[0]
+        return result[0]
+
+    def close(self):
+        return None
+
