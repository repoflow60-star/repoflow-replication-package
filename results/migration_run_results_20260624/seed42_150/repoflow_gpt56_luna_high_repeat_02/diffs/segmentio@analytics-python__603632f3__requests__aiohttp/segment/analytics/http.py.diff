--- a/segment/analytics/http.py
+++ b/segment/analytics/http.py
@@ -0,0 +1,96 @@
+import asyncio
+import json
+from threading import Event, Lock, Thread
+from urllib.parse import urlsplit
+
+import aiohttp
+
+
+class _HttpResult:
+    def __init__(self, status_code, headers, reason, text):
+        self.status_code = status_code
+        self.headers = headers
+        self.reason = reason
+        self.text = text
+
+    def json(self):
+        return json.loads(self.text)
+
+
+class _AsyncClient:
+    def __init__(self):
+        self._ready = Event()
+        self._loop = None
+        self._thread = Thread(target=self._run, daemon=True)
+        self._thread.start()
+        self._ready.wait()
+
+    def _run(self):
+        self._loop = asyncio.new_event_loop()
+        asyncio.set_event_loop(self._loop)
+        self._ready.set()
+        self._loop.run_forever()
+
+    async def _post(self, url, data, headers, timeout, proxy):
+        request_timeout = aiohttp.ClientTimeout(total=timeout)
+        async with aiohttp.ClientSession(timeout=request_timeout) as session:
+            async with session.post(
+                url,
+                data=data,
+                headers=headers,
+                proxy=proxy,
+            ) as response:
+                text = await response.text()
+                return _HttpResult(
+                    response.status,
+                    response.headers.copy(),
+                    response.reason,
+                    text,
+                )
+
+    def post(self, url, data=None, headers=None, timeout=None, proxy=None):
+        future = asyncio.run_coroutine_threadsafe(
+            self._post(url, data, headers, timeout, proxy),
+            self._loop,
+        )
+        return future.result()
+
+
+_client = None
+_client_lock = Lock()
+
+
+def _get_client():
+    global _client
+    if _client is None:
+        with _client_lock:
+            if _client is None:
+                _client = _AsyncClient()
+    return _client
+
+
+def _normalize_proxy(url, proxy):
+    if not proxy:
+        return None
+    if isinstance(proxy, dict):
+        scheme = urlsplit(url).scheme
+        proxy = proxy.get(scheme) or proxy.get('http') or proxy.get('https')
+    if not proxy:
+        return None
+    if isinstance(proxy, str) and not urlsplit(proxy).scheme:
+        return 'http://' + proxy
+    return proxy
+
+
+class Session:
+    def post(self, url, data=None, headers=None, timeout=None, proxy=None,
+             proxies=None):
+        if proxy is None:
+            proxy = proxies
+        return _get_client().post(
+            url,
+            data=data,
+            headers=headers,
+            timeout=timeout,
+            proxy=_normalize_proxy(url, proxy),
+        )
