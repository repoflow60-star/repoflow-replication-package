--- a/pyschlage/transport.py
+++ b/pyschlage/transport.py
@@ -0,0 +1,110 @@
+"""Small HTTP response and request adapters backed by PycURL."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from io import BytesIO
+import json
+from typing import Any, Mapping
+from urllib.parse import urlencode
+
+import pycurl
+
+
+class CurlHTTPError(Exception):
+    """Raised when an HTTP response has an error status."""
+
+
+@dataclass
+class CurlRequest:
+    """Request shape understood by pycognito's auth handler."""
+
+    url: str = ""
+    headers: dict[str, str] = field(default_factory=dict)
+    method: str = "GET"
+    body: Any = None
+
+
+@dataclass
+class CurlResponse:
+    """Response interface used by the pyschlage API."""
+
+    content: bytes
+    status_code: int
+    reason: str
+    url: str
+    headers: dict[str, str] = field(default_factory=dict)
+
+    def json(self) -> Any:
+        """Decode the response body as JSON."""
+        return json.loads(self.content.decode("utf-8"))
+
+    def raise_for_status(self) -> None:
+        """Raise for client and server error responses."""
+        if self.status_code >= 400:
+            message = f"{self.status_code} {self.reason} for url: {self.url}"
+            raise CurlHTTPError(message)
+
+
+def request(
+    method: str,
+    url: str,
+    *,
+    timeout: int | float = 60,
+    headers: Mapping[str, Any] | None = None,
+    params: Mapping[str, Any] | list[tuple[str, Any]] | None = None,
+    json_body: Any = None,
+    data: Any = None,
+) -> CurlResponse:
+    """Perform one HTTP request with PycURL."""
+    if params:
+        query = urlencode(params, doseq=True)
+        url = f"{url}{'&' if '?' in url else '?'}{query}"
+
+    request_headers = {str(key): str(value) for key, value in (headers or {}).items()}
+    payload: bytes | None = None
+    if json_body is not None:
+        payload = json.dumps(json_body).encode("utf-8")
+        if not any(key.lower() == "content-type" for key in request_headers):
+            request_headers["Content-Type"] = "application/json"
+    elif data is not None:
+        if isinstance(data, bytes):
+            payload = data
+        elif isinstance(data, str):
+            payload = data.encode("utf-8")
+        else:
+            payload = urlencode(data, doseq=True).encode("utf-8")
+
+    body = BytesIO()
+    response_headers: dict[str, str] = {}
+    reason = ""
+
+    def receive_header(raw_header: bytes) -> None:
+        nonlocal reason
+        header = raw_header.decode("iso-8859-1").strip("\r\n")
+        if header.startswith("HTTP/"):
+            parts = header.split(" ", 2)
+            reason = parts[2] if len(parts) == 3 else ""
+        elif ":" in header:
+            name, value = header.split(":", 1)
+            response_headers[name.strip()] = value.strip()
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.CUSTOMREQUEST, method.upper())
+        curl.setopt(
+            pycurl.HTTPHEADER,
+            [f"{key}: {value}" for key, value in request_headers.items()],
+        )
+        curl.setopt(pycurl.TIMEOUT, timeout)
+        curl.setopt(pycurl.WRITEDATA, body)
+        curl.setopt(pycurl.HEADERFUNCTION, receive_header)
+        if payload is not None:
+            curl.setopt(pycurl.POSTFIELDS, payload)
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+
+    return CurlResponse(body.getvalue(), status_code, reason, url, response_headers)
