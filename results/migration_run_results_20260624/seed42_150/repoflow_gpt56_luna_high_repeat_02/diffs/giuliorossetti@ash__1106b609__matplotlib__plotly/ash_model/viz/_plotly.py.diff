--- a/ash_model/viz/_plotly.py
+++ b/ash_model/viz/_plotly.py
@@ -0,0 +1,49 @@
+import plotly.graph_objects as go
+
+
+def figure_from_kwargs(kwargs):
+    """Return a caller-supplied Plotly figure or create one."""
+    figure = kwargs.get("figure", kwargs.get("fig"))
+    if figure is None:
+        return go.Figure()
+    if not isinstance(figure, go.Figure):
+        raise TypeError("figure must be a plotly.graph_objects.Figure")
+    return figure
+
+
+def trace_kwargs(kwargs, line=False):
+    """Convert common plotting options into Plotly trace options."""
+    options = {
+        key: value
+        for key, value in kwargs.items()
+        if key not in {"ax", "figure", "fig"}
+    }
+
+    if "label" in options and "name" not in options:
+        options["name"] = options.pop("label")
+    if "alpha" in options and "opacity" not in options:
+        options["opacity"] = options.pop("alpha")
+
+    color = options.pop("color", None)
+    if color is not None:
+        if line:
+            line_options = dict(options.get("line", {}))
+            line_options.setdefault("color", color)
+            options["line"] = line_options
+        else:
+            marker_options = dict(options.get("marker", {}))
+            marker_options.setdefault("color", color)
+            options["marker"] = marker_options
+
+    if "linestyle" in options:
+        line_options = dict(options.pop("line", {}))
+        line_options.setdefault("dash", options.pop("linestyle"))
+        options["line"] = line_options
+    if "linewidth" in options:
+        line_options = dict(options.pop("line", {}))
+        line_options.setdefault("width", options.pop("linewidth"))
+        options["line"] = line_options
+
+    if line:
+        options.setdefault("line", {})
+    return options
