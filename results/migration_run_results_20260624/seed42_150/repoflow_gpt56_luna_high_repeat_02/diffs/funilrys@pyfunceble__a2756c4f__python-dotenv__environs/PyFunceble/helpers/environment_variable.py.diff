 from typing import Any, Optional, Union
 
-import dotenv
+from environs import Env
+
+
+_ENV_KEY_PATTERN = re.compile(r"^\s*(?:export\s+)?(?P<name>[^\s=]+)\s*=")
+
+
+def _read_value_from_env_file(path: str, name: str) -> Optional[str]:
+    """Read one value through environs without changing the process environment."""
+
+    if not os.path.isfile(path):
+        return None
+
+    previous_environment = os.environ.copy()
+    try:
+        os.environ.pop(name, None)
+        env = Env()
+        env.read_env(path, recurse=False, override=True)
+        return env.str(name, default=None)
+    except FileNotFoundError:
+        return None
+    finally:
+        os.environ.clear()
+        os.environ.update(previous_environment)
+
+
+def _set_value_in_env_file(path: str, name: str, value: str) -> None:
+    """Update one key while leaving unrelated dotenv content untouched."""
+
+    try:
+        with open(path, encoding="utf-8") as env_file:
+            lines = env_file.readlines()
+    except FileNotFoundError:
+        lines = []
+
+    escaped_value = value.replace("'", "\\'")
+    replacement = f"{name}='{escaped_value}'\n"
+    replaced = False
+    updated_lines = []
+    for line in lines:
+        match = _ENV_KEY_PATTERN.match(line)
+        if match and match.group("name") == name:
+            if not replaced:
+                updated_lines.append(replacement)
+                replaced = True
+            continue
+        updated_lines.append(line)
+
+    if not replaced:
+        updated_lines.append(replacement)
+
+    with open(path, "w", encoding="utf-8") as env_file:
+        env_file.writelines(updated_lines)
+
+
+def _delete_value_from_env_file(path: str, name: str) -> None:
+    """Remove one key while leaving unrelated dotenv content untouched."""
+
+    try:
+        with open(path, encoding="utf-8") as env_file:
+            lines = env_file.readlines()
+    except FileNotFoundError:
+        return
+
+    with open(path, "w", encoding="utf-8") as env_file:
+        for line in lines:
+            match = _ENV_KEY_PATTERN.match(line)
+            if not match or match.group("name") != name:
+                env_file.write(line)
 
 
