+
+requests = treq
+
+_reactor_lock = threading.Lock()
+_reactor_started = threading.Event()
+_reactor_starting = threading.Event()
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_started.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if (not reactor.running and not _reactor_started.is_set() and
+                not _reactor_starting.is_set()):
+            _reactor_starting.set()
+            threading.Thread(target=_run_reactor, daemon=True).start()
+    _reactor_started.wait()
+
+
+@defer.inlineCallbacks
+def _request_json(method, url, data=None, headers=None):
+    if method == 'POST':
+        http_response = yield defer.maybeDeferred(
+            treq.post, url, data=data, headers=headers)
+    else:
+        http_response = yield defer.maybeDeferred(
+            treq.get, url, headers=headers)
+    status_code = getattr(http_response, 'status_code', None)
+    if status_code is None:
+        status_code = http_response.code
+    json_data = None
+    if status_code == 200:
+        if hasattr(http_response, 'json'):
+            json_data = yield defer.maybeDeferred(http_response.json)
+        else:
+            json_data = yield treq.json_content(http_response)
+    return status_code, json_data
+
+
+def _blocking_json_request(method, url, data=None, headers=None):
+    _ensure_reactor()
+    return threads.blockingCallFromThread(
+        reactor, _request_json, method, url, data, headers)
 
 
