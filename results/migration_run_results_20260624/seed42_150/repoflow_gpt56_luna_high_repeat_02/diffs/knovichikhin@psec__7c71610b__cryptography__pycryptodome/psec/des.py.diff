+class _BlockCipher(_typing.Protocol):
+    def encrypt(self, data: bytes) -> bytes:
+        ...
+
+    def decrypt(self, data: bytes) -> bytes:
+        ...
+
+
+def _effective_des_key(key: bytes) -> bytes:
+    """Return a DES key with parity bits removed for comparison."""
+    return bytes(byte & 0xFE for byte in key)
+
+
+def _new_tdes_cipher(
+    key: bytes, mode: int, iv: _typing.Optional[bytes] = None
+) -> _BlockCipher:
+    """Create a DES/TDES cipher with legacy single-DES key handling."""
+    des_key: _typing.Optional[bytes] = None
+    if len(key) == 8:
+        des_key = key
+    elif len(key) == 16:
+        key1, key2 = key[:8], key[8:]
+        if _effective_des_key(key1) == _effective_des_key(key2):
+            des_key = key1
+    elif len(key) == 24:
+        key1, key2, key3 = key[:8], key[8:16], key[16:]
+        if _effective_des_key(key1) == _effective_des_key(key2):
+            des_key = key3
+        elif _effective_des_key(key2) == _effective_des_key(key3):
+            des_key = key1
+
+    if des_key is not None:
+        if iv is None:
+            return _DES.new(des_key, mode)
+        return _DES.new(des_key, mode, iv)
+    if iv is None:
+        return _DES3.new(key, mode)
+    return _DES3.new(key, mode, iv)
+
