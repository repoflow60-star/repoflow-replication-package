@@ -29,6 +28,44 @@
 PROXY_DICT = None
 VERIFY_SSL = True
 OUTPUT_FILE = None
+_SESSION_CONFIG = (None, True)
+
+
+def _get_session():
+    global REQ_SESSION, _SESSION_CONFIG
+
+    proxy_url = None
+    if PROXY_DICT:
+        proxy_url = PROXY_DICT.get('https') or PROXY_DICT.get('http')
+
+    session_config = (proxy_url, VERIFY_SSL)
+    if session_config != _SESSION_CONFIG:
+        cert_reqs = 'CERT_REQUIRED' if VERIFY_SSL else 'CERT_NONE'
+        if proxy_url and proxy_url.startswith('socks'):
+            from urllib3.contrib.socks import SOCKSProxyManager
+
+            REQ_SESSION = SOCKSProxyManager(proxy_url, cert_reqs=cert_reqs)
+        elif proxy_url:
+            REQ_SESSION = urllib3.ProxyManager(proxy_url, cert_reqs=cert_reqs)
+        else:
+            REQ_SESSION = urllib3.PoolManager(cert_reqs=cert_reqs)
+        _SESSION_CONFIG = session_config
+
+    return REQ_SESSION
+
+
+def _request(method: str, url: str, **kwargs):
+    session = _get_session()
+    session_method = getattr(session, method.lower(), None)
+    if session_method is not None:
+        response = session_method(url, **kwargs)
+    else:
+        response = session.request(method, url, **kwargs)
+
+    status = getattr(response, 'status', None)
+    if isinstance(status, int) and status >= 400:
+        raise urllib3.exceptions.HTTPError(f'HTTP status {status}')
+    return response
 
