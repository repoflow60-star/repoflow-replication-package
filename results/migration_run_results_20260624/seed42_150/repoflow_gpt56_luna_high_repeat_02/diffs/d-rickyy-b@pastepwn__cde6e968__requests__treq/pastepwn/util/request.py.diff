+    @classmethod
+    def _wait_for(cls, deferred, timeout):
+        result = []
+        completed = Event()
+
+        def succeeded(value):
+            result.append((True, value))
+            completed.set()
+            return value
+
+        def failed(failure):
+            result.append((False, failure))
+            completed.set()
+            return None
+
+        deferred.addCallbacks(succeeded, failed)
+
+        wait_timeout = None if timeout is None or timeout <= 0 else timeout
+        if not completed.wait(wait_timeout):
+            deferred.cancel()
+            raise TimeoutError()
+
+        success, value = result[0]
+        if not success:
+            value.raiseException()
+        return value
