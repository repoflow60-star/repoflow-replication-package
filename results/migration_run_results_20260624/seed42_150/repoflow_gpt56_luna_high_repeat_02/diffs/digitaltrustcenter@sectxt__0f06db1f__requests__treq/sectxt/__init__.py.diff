+@defer.inlineCallbacks
+def _fetch(url: str, insecure: bool = False):
+    headers = {
+        "User-Agent": "Mozilla/5.0 (Windows NT 6.1; WOW64; rv:12.0) "
+        "Gecko/20100101 Firefox/12.0"
+    }
+    if insecure:
+        requester = HTTPClient(
+            Agent(reactor, contextFactory=ssl.ClientContextFactory())
+        ).request
+    else:
+        requester = treq.request
+
+    current_url = url
+    history = []
+    for _ in range(30):
+        response = yield requester(
+            "GET",
+            current_url,
+            headers=headers,
+            timeout=5,
+            allow_redirects=False,
+        )
+        if response.code not in (301, 302, 303, 307, 308):
+            content = yield response.content()
+            return response, content, history, current_url
+
+        locations = response.headers.getRawHeaders("location")
+        if not locations:
+            content = yield response.content()
+            return response, content, history, current_url
+
+        # Consume redirect bodies before reusing the connection.
+        yield response.content()
+        location = locations[0]
+        if isinstance(location, bytes):
+            location = location.decode("latin-1")
+        history.append(current_url)
+        current_url = urljoin(current_url, location)
+
+    raise RuntimeError("Too many redirects")
