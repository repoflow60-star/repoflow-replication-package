+import ssl
+
+import urllib3
+from urllib3.util.retry import Retry
 
 logger = logging.getLogger(__name__)
+
+DEFAULT_HTTP_HEADERS = {
+    'Accept': '*/*',
+    'Accept-Encoding': 'gzip, deflate',
+    'Connection': 'keep-alive',
+    'User-Agent': 'python-requests/2.31.0',
+}
+
+
+def _http_pool(verify_ssl):
+    retries = Retry(
+        total=3,
+        connect=0,
+        read=0,
+        status=0,
+        redirect=3,
+        allowed_methods=None,
+        raise_on_redirect=False,
+        raise_on_status=False,
+    )
+    kwargs = {
+        'cert_reqs': ssl.CERT_REQUIRED if verify_ssl else ssl.CERT_NONE,
+        'retries': retries,
+    }
+    if not verify_ssl:
+        kwargs['assert_hostname'] = False
+    return urllib3.PoolManager(**kwargs)
+
+
+class _HTTPResponseAdapter:
+    def __init__(self, response):
+        self._response = response
+        self.status_code = response.status
+        self.headers = response.headers
+        self.raw = response
+
+    @property
+    def content(self):
+        return self._response.data
+
+    @property
+    def is_redirect(self):
+        return self.status_code in (301, 302, 303, 307, 308) and self.headers.get('Location') is not None
+
+    def json(self):
+        return json.loads(self._response.data.decode('utf-8'))
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            url = getattr(self._response, 'url', None)
+            if not url and hasattr(self._response, 'geturl'):
+                url = self._response.geturl()
+            raise urllib.error.HTTPError(url, self.status_code, 'HTTP {}'.format(self.status_code), self.headers, None)
+
+    def close(self):
+        self._response.close()
+
+
+def _request(method, url, input_options, headers=None, fields=None, body=None, redirect=True):
+    try:
+        request_headers = dict(DEFAULT_HTTP_HEADERS)
+        if headers:
+            request_headers.update(headers)
+        response = _http_pool(input_options.verify_ssl).request(
+            method,
+            url,
+            headers=request_headers,
+            fields=fields,
+            body=body,
+            timeout=input_options.timeout,
+            redirect=redirect,
+        )
+    except Exception as e:
+        raise urllib.error.URLError(e)
+    return _HTTPResponseAdapter(response)
 
