+class _TreqSessionAdapter:
+    def __init__(self):
+        self.headers = {}
+
+    def _request(self, method, url, params=None, headers=None, data=None):
+        _ensure_reactor_running()
+
+        merged_headers = dict(self.headers)
+        if headers:
+            merged_headers.update(headers)
+
+        result_queue = Queue(maxsize=1)
+
+        def _dispatch():
+            request_deferred = treq.request(
+                method,
+                url,
+                params=params,
+                headers=merged_headers or None,
+                data=data,
+            )
+
+            def _build_response(response):
+                return treq.content(response).addCallback(
+                    lambda content: _TreqResponse(url, response, content)
+                )
+
+            def _store_result(result):
+                result_queue.put(result)
+                return result
+
+            request_deferred.addCallbacks(_build_response, lambda failure: failure)
+            request_deferred.addBoth(_store_result)
+
+        reactor.callFromThread(_dispatch)
+        result = result_queue.get()
+        if isinstance(result, Failure):
+            result.raiseException()
+        return result
+
+    def get(self, url, params=None):
+        return self._request('GET', url, params=params)
