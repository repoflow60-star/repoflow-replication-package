+def _normalize_headers(headers):
+    normalized = {}
+    if not headers:
+        return normalized
+    for name, values in headers.getAllRawHeaders():
+        if isinstance(name, bytes):
+            key = name.decode('ascii', 'ignore').lower()
+        else:
+            key = str(name).lower()
+        normalized[key] = ', '.join(
+            value.decode('utf-8', 'replace') if isinstance(value, bytes) else value
+            for value in values
+        )
+    return normalized
+
+
+def _ensure_reactor_running():
+    if reactor.running:
+        return
+    if getattr(_ensure_reactor_running, '_started', False):
+        return
+
+    with _ensure_reactor_running._lock:
+        if reactor.running or getattr(_ensure_reactor_running, '_started', False):
+            return
+
+        _ensure_reactor_running._started = True
+        ready = threading.Event()
+
+        def _run():
+            reactor.callWhenRunning(ready.set)
+            reactor.run(installSignalHandlers=False)
+
+        threading.Thread(target=_run, name='treq-reactor', daemon=True).start()
+        ready.wait()
+
+
+_ensure_reactor_running._lock = threading.Lock()
+_ensure_reactor_running._started = False
+
+
+class _TreqResponse:
+    def __init__(self, url, response, content):
+        self.url = url
+        self.status_code = response.code
+        self.reason = (
+            response.phrase.decode('utf-8', 'replace')
+            if isinstance(response.phrase, bytes)
+            else response.phrase or ''
+        )
+        self.headers = _normalize_headers(response.headers)
+        self.content = content
+        self.text = content.decode('utf-8', 'replace')
+
+    @property
+    def ok(self):
+        return 200 <= self.status_code < 400
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        raise ClientError(
+            message={
+                'status_code': self.status_code,
+                'url': self.url,
+                'message': self.reason or 'HTTP error response from API',
+                'raw': self.content,
+            },
+        )
+
