 from edgetest.core import TestPackage
 
 VALID_OUTPUTS = ["rst", "github"]
+
+
+def _cell_text(value: Any) -> str:
+    return "" if value is None else str(value)
+
+
+def _column_widths(headers: Sequence[Any], rows: Sequence[Sequence[Any]]) -> List[int]:
+    widths = [len(_cell_text(header)) for header in headers]
+    for row in rows:
+        if len(row) > len(widths):
+            widths.extend([0] * (len(row) - len(widths)))
+        for idx, cell in enumerate(row):
+            widths[idx] = max(widths[idx], len(_cell_text(cell)))
+    return widths
+
+
+def _render_cells(values: Sequence[Any], widths: Sequence[int], separator: str) -> str:
+    cells = []
+    for idx, width in enumerate(widths):
+        text = _cell_text(values[idx] if idx < len(values) else "")
+        cells.append(text.ljust(width) if idx < len(widths) - 1 else text)
+    return separator.join(cells)
+
+
+def _render_rst(rows: Sequence[Sequence[Any]], headers: Sequence[Any]) -> str:
+    widths = _column_widths(headers, rows)
+    separator = "  ".join("=" * width for width in widths)
+    lines = [separator, _render_cells(headers, widths, "  "), separator]
+    lines.extend(_render_cells(row, widths, "  ") for row in rows)
+    if rows:
+        lines.append(separator)
+    return "\n".join(lines)
+
+
+def _render_github(rows: Sequence[Sequence[Any]], headers: Sequence[Any]) -> str:
+    widths = _column_widths(headers, rows)
+    separator = "|" + "|".join("-" * width for width in widths) + "|"
+    lines = [f"| {_render_cells(headers, widths, ' | ')} |", separator]
+    lines.extend(f"| {_render_cells(row, widths, ' | ')} |" for row in rows)
+    return "\n".join(lines)
+
+
+def tabulate(rows: List[List[Any]], headers: List[str], tablefmt: str = "rst") -> str:
+    """Render a table with rich while preserving tabulate's text layout."""
+
+    rendered = _render_github(rows, headers) if tablefmt == "github" else _render_rst(rows, headers)
+    console = Console(file=StringIO(), width=max((len(line) for line in rendered.splitlines()), default=1))
+    console.print(Text(rendered), end="")
+    return rendered
 
 
