+class _ResponseWrapper:
+    def __init__(self, response: HTTPResponse) -> None:
+        self._response = response
+
+    @property
+    def reason(self):
+        reason = getattr(self._response, "reason", "")
+        if isinstance(reason, bytes):
+            return reason.decode("utf-8", "replace")
+        return reason
+
+    @property
+    def status(self):
