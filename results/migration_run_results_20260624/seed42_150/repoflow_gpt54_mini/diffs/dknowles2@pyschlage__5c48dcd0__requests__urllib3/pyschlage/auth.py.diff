+def _merge_query_params(url: str, params) -> str:
+    if not params:
+        return url
+
+    scheme, netloc, path, query, fragment = urlsplit(url)
+    query_items = parse_qsl(query, keep_blank_values=True)
+    if hasattr(params, "items"):
+        query_items.extend(params.items())
+    else:
+        query_items.extend(params)
+    return urlunsplit(
+        (scheme, netloc, path, urlencode(query_items, doseq=True), fragment)
+    )
+
+
+def _response_message(resp) -> str:
+    try:
+        message = resp.json().get("message", resp.reason)
+    except (AttributeError, TypeError, ValueError):
+        message = getattr(resp, "reason", "")
+
+    if isinstance(message, bytes):
+        return message.decode("utf-8", "replace")
+    return message if isinstance(message, str) else str(message)
