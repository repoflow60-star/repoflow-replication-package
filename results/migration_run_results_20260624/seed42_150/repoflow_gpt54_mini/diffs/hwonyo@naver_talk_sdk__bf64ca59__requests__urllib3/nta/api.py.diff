+class _HTTPResponseAdapter(object):
+    """Normalize urllib3 responses to the fields used by this package."""
+
+    def __init__(self, response):
+        self._response = response
+        self.status_code = getattr(response, 'status_code', getattr(response, 'status', None))
+        self.status = self.status_code
+
+        text = getattr(response, 'text', None)
+        if text is None:
+            data = getattr(response, 'data', b'')
+            if isinstance(data, bytes):
+                text = data.decode('utf-8', 'replace')
+            elif data is None:
+                text = ''
+            else:
+                text = data
+        self.text = text
+
+    def json(self):
+        if hasattr(self._response, 'json'):
+            return self._response.json()
+        return json.loads(self.text)
+
+
+class _ConnectionErrorResponse(object):
+    def __init__(self, message):
+        self.text = message
+        self.status_code = None
+        self.status = None
 
 
