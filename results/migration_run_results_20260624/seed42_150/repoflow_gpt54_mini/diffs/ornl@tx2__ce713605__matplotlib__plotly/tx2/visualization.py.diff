+def _add_scatter_traces_for_classes(
+    fig,
+    x,
+    y,
+    classes,
+    class_names,
+    colors_array,
+    size,
+    opacity,
+    legend_prefix="",
+    showlegend=True,
+    line_color=None,
+    line_width=None,
+):
+    classes = np.asarray(classes)
+    x = np.asarray(x)
+    y = np.asarray(y)
+
+    for class_index, class_name in enumerate(class_names):
+        mask = classes == class_index
+        if not np.any(mask):
+            continue
+
+        fig.add_trace(
+            go.Scattergl(
+                x=x[mask],
+                y=y[mask],
+                mode="markers",
+                name=f"{legend_prefix}{class_name}",
+                showlegend=showlegend,
+                marker={
+                    **{
+                        "color": colors_array[class_index],
+                        "size": size,
+                        "opacity": opacity,
+                    },
+                    **(
+                        {"line": dict(color=line_color, width=line_width)}
+                        if line_color is not None and line_width is not None
+                        else {}
+                    ),
+                },
+            )
+        )
+
+
+def _add_single_point_trace(fig, point, color, size, line_color, line_width):
+    fig.add_trace(
+        go.Scattergl(
+            x=[point[0]],
+            y=[point[1]],
+            mode="markers",
+            showlegend=False,
+            marker=dict(
+                color=color,
+                size=size,
+                line=dict(color=line_color, width=line_width),
+            ),
+        )
+    )
+
