 _cached_wordclouds = {}
 
 
+def _ordered_class_names(encodings: Dict[str, int]) -> List[str]:
+    return [key for key, _ in sorted(encodings.items(), key=lambda item: item[1])]
+
+
+def _wordcloud_image(cloud):
+    return cloud.to_array() if hasattr(cloud, "to_array") else np.asarray(cloud)
+
+
+def _base_plotly_figure(title=None, width=None, height=None):
+    fig = go.Figure()
+    fig.update_layout(
+        template="plotly_white",
+        paper_bgcolor="white",
+        plot_bgcolor="white",
+        margin=dict(l=10, r=10, t=40 if title else 10, b=10),
+        width=width,
+        height=height,
+        title=title,
+    )
+    return fig
+
+
+def _image_figure(cloud, title, width=800, height=500):
+    fig = go.Figure(
+        data=[go.Image(z=_wordcloud_image(cloud))],
+    )
+    fig.update_layout(
+        template="plotly_white",
+        paper_bgcolor="white",
+        plot_bgcolor="white",
+        margin=dict(l=0, r=0, t=40, b=0),
+        width=width,
+        height=height,
+        title=title,
+    )
+    fig.update_xaxes(visible=False)
+    fig.update_yaxes(visible=False)
+    return fig
+
