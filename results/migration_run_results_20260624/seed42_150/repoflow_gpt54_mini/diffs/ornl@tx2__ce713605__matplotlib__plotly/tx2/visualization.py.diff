+        fig.update_xaxes(visible=False, row=ax_x + 1, col=ax_y + 1)
+        fig.update_yaxes(visible=False, row=ax_x + 1, col=ax_y + 1)
+
+    fig.update_layout(
+        barmode="stack",
+        template="plotly_white",
+        paper_bgcolor="white",
+        plot_bgcolor="white",
+        width=1000,
+        height=num_rows * 220,
+        margin=dict(l=40, r=20, t=40, b=20),
+    )
     return fig
