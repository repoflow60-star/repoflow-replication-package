+    @staticmethod
+    def _parse_env_file_line(line: str) -> Optional[tuple[str, str]]:
+        """
+        Parses a dotenv-style line.
+        """
+
+        stripped = line.strip()
+
+        if not stripped or stripped.startswith("#"):
+            return None
+
+        if stripped.startswith("export "):
+            stripped = stripped[7:].lstrip()
+
+        if "=" not in stripped:
+            return None
+
+        key, raw_value = stripped.split("=", 1)
+        key = key.strip()
+        raw_value = raw_value.strip()
+
+        if not key:
+            return None
+
+        if not raw_value:
+            return key, ""
+
+        try:
+            value = shlex.split(raw_value, posix=True)[0]
+        except ValueError:
+            value = raw_value.strip().strip("\"'")
+
+        return key, value
+
+    @staticmethod
+    def _serialize_env_value(value: str) -> str:
+        """
+        Serializes a value for a dotenv-style file.
+        """
+
+        return shlex.quote(value)
+
+    def _write_env_file(self, lines: list[str]) -> None:
+        """
+        Writes the given lines to the environment file.
+        """
+
+        if not self.env_file_path:
+            return
+
+        with open(self.env_file_path, "w", encoding="utf-8") as file_stream:
+            file_stream.writelines(lines)
 
