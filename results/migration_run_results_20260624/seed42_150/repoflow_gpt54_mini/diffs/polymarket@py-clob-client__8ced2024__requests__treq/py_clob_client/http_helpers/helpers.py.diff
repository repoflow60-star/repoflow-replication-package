+class _ResponseAdapter:
+    def __init__(self, status_code, body):
+        self.status_code = status_code
+        self._body = body or b""
+
+    @property
+    def text(self):
+        if isinstance(self._body, bytes):
+            return self._body.decode("utf-8", errors="replace")
+        return self._body
+
+    def json(self):
+        return json.loads(self.text)
+
+
+_REACTOR_THREAD = None
+_REACTOR_LOCK = threading.Lock()
+
+
+def _run_reactor(started):
+    reactor.callWhenRunning(started.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor_running():
+    global _REACTOR_THREAD
+
+    if reactor.running:
+        return
+
+    with _REACTOR_LOCK:
+        if reactor.running:
+            return
+
+        if _REACTOR_THREAD is None or not _REACTOR_THREAD.is_alive():
+            started = threading.Event()
+            _REACTOR_THREAD = threading.Thread(
+                target=_run_reactor,
+                args=(started,),
+                name="py_clob_client_treq_reactor",
+                daemon=True,
+            )
+            _REACTOR_THREAD.start()
+            started.wait()
+
+
+def _request(endpoint: str, method: str, headers=None, data=None):
+    _ensure_reactor_running()
+
+    @defer.inlineCallbacks
+    def _do_request():
+        body = json.dumps(data).encode("utf-8") if data else None
+        response = yield treq.request(method, endpoint, headers=headers, data=body)
+        content = yield treq.content(response)
+        defer.returnValue(_ResponseAdapter(response.code, content))
+
+    return blockingCallFromThread(reactor, _do_request)
+
