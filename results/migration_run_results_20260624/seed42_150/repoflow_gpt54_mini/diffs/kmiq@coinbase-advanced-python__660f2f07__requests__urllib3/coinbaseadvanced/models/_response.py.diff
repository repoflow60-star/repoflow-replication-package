--- a/coinbaseadvanced/models/_response.py
+++ b/coinbaseadvanced/models/_response.py
@@ -0,0 +1,45 @@
+"""
+Shared helpers for urllib3 response objects.
+"""
+
+import json
+
+
+def response_ok(response) -> bool:
+    if hasattr(response, "ok"):
+        return bool(response.ok)
+
+    status = getattr(response, "status", getattr(response, "status_code", None))
+    if status is None:
+        return True
+
+    return 200 <= int(status) < 400
+
+
+def response_text(response) -> str:
+    text = getattr(response, "text", None)
+    if text is not None:
+        return text
+
+    data = getattr(response, "data", None)
+    if data is None and hasattr(response, "read"):
+        data = response.read()
+
+    if isinstance(data, bytes):
+        return data.decode("utf-8", errors="replace")
+
+    if data is None:
+        return ""
+
+    return str(data)
+
+
+def response_json(response):
+    json_method = getattr(response, "json", None)
+    if callable(json_method):
+        try:
+            return json_method()
+        except TypeError:
+            pass
+
+    return json.loads(response_text(response))
