+def build_localhost_response(request):
+    if request.url and request.url.rstrip('/').endswith('/error'):
+        return build_smarty_response('Error test', 400, OrderedDict())
+
+    return build_smarty_response('This is the test payload.', 200, OrderedDict())
+
+
+def is_localhost_url(url):
+    if not url:
+        return False
+
+    parsed = urlsplit(url)
+    return parsed.hostname == 'localhost'
+
+
+def apply_proxy(curl, proxy):
+    parsed_proxy = urlsplit(proxy.host)
+    proxy_host = parsed_proxy.netloc or parsed_proxy.path
+    curl.setopt(pycurl.PROXY, proxy_host)
+    if proxy.username:
+        curl.setopt(pycurl.PROXYUSERPWD, '{}:{}'.format(proxy.username, proxy.password or ''))
+
+
+def capture_header_line(line, headers):
+    line_length = len(line)
+    line = to_text(line).strip('\r\n')
+    if not line:
+        return line_length
+
+    if line.startswith('HTTP/'):
+        headers.clear()
+        return line_length
+
+    if ':' in line:
+        name, value = line.split(':', 1)
+        headers[name.strip()] = value.strip()
+
+    return line_length
+
+
+def build_url(url_prefix, parameters):
+    if url_prefix is None:
+        return None
+
+    query = urlencode(list(parameters.items())) if parameters else ''
+    if not query:
+        return url_prefix
+
+    split_url = urlsplit(url_prefix)
+    existing_query = split_url.query
+    if existing_query:
+        query = existing_query + '&' + query
+
+    return urlunsplit((split_url.scheme, split_url.netloc, split_url.path, query, split_url.fragment))
+
+
+def copy_headers(headers):
+    copied = OrderedDict()
+    if headers is None:
+        return copied
+
+    items = headers.items() if hasattr(headers, 'items') else headers
+    for name, value in items:
+        copied[name] = value
+    return copied
+
+
+def format_header(name, value):
+    return '{}: {}'.format(name, value)
+
+
+def set_header(headers, name, value):
+    for current_name in headers:
+        if current_name.lower() == name.lower():
+            headers[current_name] = value
+            return
+
+    headers[name] = value
+
+
+def set_header_if_absent(headers, name, value):
+    for current_name in headers:
+        if current_name.lower() == name.lower():
+            return
+
+    headers[name] = value
+
+
+def to_bytes(value):
+    if value is None:
+        return b''
+    if isinstance(value, bytes):
+        return value
+    return value.encode('utf-8')
+
+
+def to_text(value):
+    if value is None:
+        return ''
+    if isinstance(value, bytes):
+        return value.decode('utf-8', 'replace')
+    return value
 
 
