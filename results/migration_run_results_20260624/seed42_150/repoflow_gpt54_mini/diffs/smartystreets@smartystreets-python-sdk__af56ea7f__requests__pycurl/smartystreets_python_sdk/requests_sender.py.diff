+def perform_request(request, max_timeout, proxy=None):
+    body = BytesIO()
+    headers = OrderedDict()
+    status_code = 0
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, request.url)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.CONNECTTIMEOUT, max_timeout)
+        curl.setopt(pycurl.TIMEOUT, max_timeout)
+        curl.setopt(pycurl.NOSIGNAL, 1)
+        curl.setopt(pycurl.ACCEPT_ENCODING, '')
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, lambda line: capture_header_line(line, headers))
+
+        if request.headers:
+            curl.setopt(pycurl.HTTPHEADER, [format_header(name, value) for name, value in request.headers.items()])
+
+        if request.method == 'POST':
+            payload = to_bytes(request.data)
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, payload)
+            curl.setopt(pycurl.POSTFIELDSIZE, len(payload))
+        else:
+            curl.setopt(pycurl.HTTPGET, 1)
+
+        if proxy is not None:
+            apply_proxy(curl, proxy)
+
+        try:
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            payload = to_text(body.getvalue())
+            return build_smarty_response(payload, status_code, headers)
