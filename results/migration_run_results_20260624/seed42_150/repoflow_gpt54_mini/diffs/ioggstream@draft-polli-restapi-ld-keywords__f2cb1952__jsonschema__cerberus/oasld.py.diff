+def _cerberus_schema(schema: Dict) -> Dict:
+    schema_type = schema.get("type")
+    rules = {}
+
+    if schema_type == "object":
+        rules["type"] = "dict"
+        rules["allow_unknown"] = schema.get("additionalProperties", True)
+
+        required = set(schema.get("required", []))
+        properties = {}
+        for name, child in schema.get("properties", {}).items():
+            properties[name] = _cerberus_schema(child)
+            if name in required:
+                properties[name]["required"] = True
+
+        if properties:
+            rules["schema"] = properties
+        return rules
+
+    if schema_type == "array":
+        rules["type"] = "list"
+        items = schema.get("items")
+        if isinstance(items, dict) and not _schema_has_refs(items):
+            rules["schema"] = _cerberus_schema(items)
+        return rules
+
+    type_map = {
