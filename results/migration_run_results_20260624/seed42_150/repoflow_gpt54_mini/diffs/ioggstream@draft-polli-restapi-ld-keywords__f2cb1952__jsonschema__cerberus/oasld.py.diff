+def _schema_has_refs(schema: Dict) -> bool:
+    if "$ref" in schema:
+        return True
+
+    schema_type = schema.get("type")
+    if schema_type == "object":
+        return any(_schema_has_refs(child) for child in schema.get("properties", {}).values())
+    if schema_type == "array":
+        items = schema.get("items")
+        return isinstance(items, dict) and _schema_has_refs(items)
+    return False
