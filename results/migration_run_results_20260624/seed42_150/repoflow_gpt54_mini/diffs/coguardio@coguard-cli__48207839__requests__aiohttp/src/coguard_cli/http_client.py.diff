--- a/src/coguard_cli/http_client.py
+++ b/src/coguard_cli/http_client.py
@@ -0,0 +1,94 @@
+"""
+Synchronous HTTP helpers backed by aiohttp.
+"""
+
+import asyncio
+import json as json_module
+from dataclasses import dataclass
+from typing import Any, Dict, Iterator, Optional
+
+import aiohttp
+
+
+@dataclass
+class Response:
+    """
+    Minimal requests-like response wrapper for the CLI.
+    """
+
+    status_code: int
+    reason: str
+    _body: bytes
+    headers: Dict[str, str]
+
+    @property
+    def text(self) -> str:
+        return self._body.decode(errors="replace")
+
+    @property
+    def content(self) -> bytes:
+        return self._body
+
+    def json(self) -> Any:
+        return json_module.loads(self.text)
+
+    def iter_content(self, chunk_size: int = 8192) -> Iterator[bytes]:
+        for offset in range(0, len(self._body), chunk_size):
+            yield self._body[offset:offset + chunk_size]
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            raise RuntimeError(f"HTTP {self.status_code}: {self.reason}")
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        return False
+
+
+async def _request(
+        method: str,
+        url: str,
+        headers: Optional[Dict[str, str]] = None,
+        data: Optional[Any] = None,
+        json: Optional[Any] = None,
+        timeout: Optional[int] = None) -> Response:
+    session_kwargs = {}
+    if timeout is not None:
+        session_kwargs["timeout"] = aiohttp.ClientTimeout(total=timeout)
+    async with aiohttp.ClientSession(**session_kwargs) as session:
+        async with session.request(
+                method,
+                url,
+                headers=headers,
+                data=data,
+                json=json) as resp:
+            body = await resp.read()
+            return Response(
+                status_code=resp.status,
+                reason=resp.reason or "",
+                _body=body,
+                headers={key: value for key, value in resp.headers.items()},
+            )
+
+
+def _run_request(*args, **kwargs) -> Response:
+    return asyncio.run(_request(*args, **kwargs))
+
+
+def get(url: str, headers: Optional[Dict[str, str]] = None,
+        timeout: Optional[int] = None, stream: bool = False) -> Response:
+    return _run_request("GET", url, headers=headers, timeout=timeout)
+
+
+def post(url: str, headers: Optional[Dict[str, str]] = None,
+         data: Optional[Any] = None, json: Optional[Any] = None,
+         timeout: Optional[int] = None) -> Response:
+    return _run_request("POST", url, headers=headers, data=data, json=json, timeout=timeout)
+
+
+def put(url: str, headers: Optional[Dict[str, str]] = None,
+        data: Optional[Any] = None, json: Optional[Any] = None,
+        timeout: Optional[int] = None) -> Response:
+    return _run_request("PUT", url, headers=headers, data=data, json=json, timeout=timeout)
