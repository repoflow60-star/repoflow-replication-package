+def _fetch_url_text(url, headers):
+    buffer = BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.USERAGENT, headers.get('User-Agent', ''))
+        curl.setopt(pycurl.HTTPHEADER, ["{}: {}".format(key, value) for key, value in headers.items() if key.lower() != 'accept-encoding'])
+        curl.setopt(pycurl.ACCEPT_ENCODING, "")
+        curl.setopt(pycurl.HTTP_VERSION, pycurl.CURL_HTTP_VERSION_1_1)
+        curl.setopt(pycurl.WRITEFUNCTION, buffer.write)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.perform()
+        content_type = curl.getinfo(pycurl.CONTENT_TYPE) or ""
+        if isinstance(content_type, bytes):
+            content_type = content_type.decode("utf-8", errors="ignore")
+        charset = "utf-8"
+        if "charset=" in content_type.lower():
+            charset = content_type.lower().split("charset=", 1)[1].split(";", 1)[0].strip()
+        try:
+            return buffer.getvalue().decode(charset, errors="replace")
+        except LookupError:
+            return buffer.getvalue().decode("utf-8", errors="replace")
+    finally:
+        curl.close()
 
