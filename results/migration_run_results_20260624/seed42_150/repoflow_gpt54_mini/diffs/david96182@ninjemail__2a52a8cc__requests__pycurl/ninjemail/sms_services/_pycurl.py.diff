--- a/ninjemail/sms_services/_pycurl.py
+++ b/ninjemail/sms_services/_pycurl.py
@@ -0,0 +1,46 @@
+import io
+from urllib.parse import urlencode, urlsplit, urlunsplit
+
+import pycurl
+
+
+def _with_query(url, params):
+    if not params:
+        return url
+
+    parts = urlsplit(url)
+    query = urlencode(params, doseq=True)
+    if parts.query:
+        query = parts.query + "&" + query
+
+    return urlunsplit((parts.scheme, parts.netloc, parts.path, query, parts.fragment))
+
+
+def request(method, url, headers=None, params=None, data=None):
+    body = io.BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, _with_query(url, params))
+        curl.setopt(pycurl.WRITEDATA, body)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+
+        if headers:
+            curl.setopt(pycurl.HTTPHEADER, [f"{key}: {value}" for key, value in headers.items()])
+
+        method = method.upper()
+        if method == "POST":
+            curl.setopt(pycurl.POST, True)
+            if data is not None:
+                encoded = urlencode(data, doseq=True).encode("utf-8")
+                curl.setopt(pycurl.POSTFIELDS, encoded)
+        elif method != "GET":
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            if data is not None:
+                encoded = urlencode(data, doseq=True).encode("utf-8")
+                curl.setopt(pycurl.POSTFIELDS, encoded)
+
+        curl.perform()
+        status = curl.getinfo(pycurl.RESPONSE_CODE)
+        return status, body.getvalue().decode("utf-8", errors="replace")
+    finally:
+        curl.close()
