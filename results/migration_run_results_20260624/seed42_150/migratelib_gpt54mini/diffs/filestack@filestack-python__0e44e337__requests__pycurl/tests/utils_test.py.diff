-from filestack.utils import requests

 

 TEST_URL = 'http://just.some.url/'

+

+

+def _pycurl_post(url, headers=None):

+    buffer = BytesIO()

+    c = pycurl.Curl()

+    c.setopt(pycurl.URL, url)

+    c.setopt(pycurl.POST, 1)

+    c.setopt(pycurl.WRITEDATA, buffer)

+    c.setopt(pycurl.HTTPHEADER, [

+        'Filestack-Trace-Id: 1',

+        'Filestack-Trace-Span: 1',

+        'User-Agent: filestack-python {}'.format(__version__),

+        'Filestack-Source: Python-{}'.format(__version__),

+    ] + (['{}: {}'.format(k, v) for k, v in headers.items()] if headers else []))

+    c.perform()

+    c.close()

+    return buffer.getvalue()

 

 

