+    def _request(self, method, url, params=None, data=None, files=None):

+        if params:

+            url = '{}?{}'.format(url, urlencode(params))

+

+        buffer = BytesIO()

+        c = pycurl.Curl()

+        c.setopt(pycurl.URL, url)

+        c.setopt(pycurl.WRITEDATA, buffer)

+

+        if method == 'POST':

+            c.setopt(pycurl.POST, 1)

+

+            if data is not None:

+                c.setopt(pycurl.POSTFIELDS, urlencode(data))

+

+            if files is not None:

+                form = []

+                for key, value in files.items():

+                    form.append((key, (pycurl.FORM_FILE, value[1].name if hasattr(value[1], 'name') else value[1])))

+                c.setopt(pycurl.HTTPPOST, form)

+

+        elif method == 'DELETE':

+            c.setopt(pycurl.CUSTOMREQUEST, 'DELETE')

+

+        c.perform()

+        c.close()

+        return buffer.getvalue()

+

