+    def _make_post_request(request_url: str, data: dict, **kwargs) -> bytes:

+        timeout = kwargs.pop('timeout', 10)

+        headers = kwargs.pop('headers', {'Content-Type': 'application/json'})

+        response_buffer = BytesIO()

+        curl = pycurl.Curl()

+        curl.setopt(pycurl.URL, request_url)

+        curl.setopt(pycurl.POST, 1)

+        curl.setopt(pycurl.POSTFIELDS, json.dumps(data))

+        curl.setopt(pycurl.WRITEFUNCTION, response_buffer.write)

+        curl.setopt(pycurl.TIMEOUT, timeout)

+        curl.setopt(pycurl.HTTPHEADER, [f'{key}: {value}' for key, value in headers.items()])

+        if 'verify' in kwargs and not kwargs['verify']:

+            curl.setopt(pycurl.SSL_VERIFYPEER, 0)

+            curl.setopt(pycurl.SSL_VERIFYHOST, 0)

+        if 'auth' in kwargs and kwargs['auth'] is not None:

+            curl.setopt(pycurl.USERPWD, f'{kwargs["auth"][0]}:{kwargs["auth"][1]}')

+        if 'proxies' in kwargs and kwargs['proxies'] is not None:

+            proxy = kwargs['proxies'].get('http') or kwargs['proxies'].get('https')

+            if proxy:

+                curl.setopt(pycurl.PROXY, proxy)

+        curl.perform()

+        curl.close()

+        return response_buffer.getvalue()

 

