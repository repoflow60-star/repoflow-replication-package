+def _curl_request(url, method="GET", verify=True, timeout=None, headers=None, data=None):

+    body = io.BytesIO()

+    header_lines = []

+

+    def header_function(header_line):

+        header_line = header_line.decode('iso-8859-1').strip()

+        if header_line:

+            header_lines.append(header_line)

+

+    c = pycurl.Curl()

+    c.setopt(pycurl.URL, url)

+    c.setopt(pycurl.FOLLOWLOCATION, True)

+    c.setopt(pycurl.WRITEFUNCTION, body.write)

+    c.setopt(pycurl.HEADERFUNCTION, header_function)

+

+    if method == "HEAD":

+        c.setopt(pycurl.NOBODY, True)

+    elif method == "POST":

+        c.setopt(pycurl.POST, True)

+        if data is not None:

+            c.setopt(pycurl.POSTFIELDS, urllib.parse.urlencode(data))

+    else:

+        c.setopt(pycurl.HTTPGET, True)

+

+    if headers:

+        header_list = []

+        for key, value in headers.items():

+            header_list.append("{}: {}".format(key, value))

+        c.setopt(pycurl.HTTPHEADER, header_list)

+

+    if timeout is not None:

+        c.setopt(pycurl.TIMEOUT, timeout)

+

+    if not verify:

+        c.setopt(pycurl.SSL_VERIFYPEER, False)

+        c.setopt(pycurl.SSL_VERIFYHOST, False)

+

+    status_code = 0

+    try:

+        c.perform()

+        status_code = c.getinfo(pycurl.RESPONSE_CODE)

+    finally:

+        c.close()

+

+    response_headers = {}

+    for line in header_lines:

+        if ':' in line:

+            key, value = line.split(':', 1)

+            response_headers[key.strip().lower()] = value.strip()

+

+    return {

+        "status_code": status_code,

+        "headers": response_headers,

+        "body": body.getvalue(),

+    }

+

+

+

 

