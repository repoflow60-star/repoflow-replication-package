@@ -0,0 +1,104 @@
+I migrated the code from `requests` to `treq` by replacing the `requests.Session` usage with `treq` request calls, and by updating response handling to work with `treq`’s Twisted-style responses. Since `treq` returns deferred-based responses and its response body/content access differs from `requests`, I adjusted the response helpers to use `treq.json_content` and `treq.content` where needed, while keeping the existing class, function, and variable names unchanged.

+

+```python

+from typing import Optional

+

+import treq

+from twisted.internet import defer

+

+AUTHOMIZE_API_URL = 'https://api.authomize.com'

+

+

+class ClientError(Exception):

+    def __init__(self, message):

+        self.message = message

+

+

+class BaseClient:

+    def __init__(self, auth_token: str, base_url: str = AUTHOMIZE_API_URL):

+        self.auth_token = auth_token

+        self.base_url = base_url

+        self.session = None

+

+    @property

+    def authorization_header(self) -> str:

+        raise NotImplementedError()

+

+    @staticmethod

+    @defer.inlineCallbacks

+    def _handle_response(response):

+        if 200 <= response.code < 300:

+            result = yield BaseClient._handle_ok_response(response)

+            return result

+        try:

+            response_json = yield treq.json_content(response)

+            detail = response_json.get('detail')

+            if 400 <= response.code < 500:

+                response.reason = yield treq.content(response)

+        except Exception:

+            detail = None

+        if detail:

+            raise ClientError(str(detail))

+        response.raise_for_status()

+

+    @staticmethod

+    @defer.inlineCallbacks

+    def _handle_ok_response(response) -> dict:

+        if content_type := response.headers.getRawHeaders(b'content-type'):

+            content_type = content_type[0].decode()

+            if content_type.startswith('application/json'):

+                result = yield treq.json_content(response)

+                return result

+

+        raw = yield treq.content(response)

+        raise ClientError(

+            message={

+                'status_code': response.code,

+                'url': response.request.absoluteURI.decode() if response.request else None,

+                'message': 'Unexpected response from API',

+                'raw': raw,

+            },

+        )

+

+    def http_get(self, url, params=None):

+        url = self.base_url + url

+        response = treq.get(

+            url,

+            params=params,

+            headers={'Authorization': self.authorization_header},

+        )

+        return self._handle_response(response)

+

+    def http_post(self, url: str, body: Optional[str] = None):

+        url = self.base_url + url

+        response = treq.post(

+            url,

+            headers={

+                'Authorization': self.authorization_header,

+                'Content-Type': 'application/json',

+            },

+            data=body,

+        )

+        return self._handle_response(response)

+

+    def http_patch(self, url: str, body: Optional[str] = None):

+        url = self.base_url + url

+        response = treq.patch(

+            url,

+            headers={

+                'Authorization': self.authorization_header,

+                'Content-Type': 'application/json',

+            },

+            data=body,

+        )

+        return self._handle_response(response)

+

+    def http_delete(self, url: str, params=None):

+        url = self.base_url + url

+        response = treq.delete(

+            url,

+            params=params,

+            headers={'Authorization': self.authorization_header},

+        )

+        return self._handle_response(response)

+```
