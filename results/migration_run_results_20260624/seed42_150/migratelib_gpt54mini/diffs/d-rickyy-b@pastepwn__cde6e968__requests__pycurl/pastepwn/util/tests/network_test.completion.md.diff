+I migrated the import from `requests.packages.urllib3.util.connection` to `pycurl` by replacing the `urllib3`-specific `allowed_gai_family()` checks with `pycurl`-based socket family constants and connection behavior equivalents. The test logic for `enforce_ip_version()` remains the same, but it now validates against `pycurl`’s IPv4/IPv6 handling instead of `urllib3`.

+

+```python

+import os

+import socket

+import unittest

+from unittest.mock import Mock

+

+import pycurl

+

+from pastepwn.util import enforce_ip_version

+

+

+@unittest.skipIf("TRAVIS" in os.environ and os.environ["TRAVIS"] == "true", "Skipping this test on Travis CI.")

+class TestNetwork(unittest.TestCase):

+    """Tests for the network utils - these tests might fail on CI"""

+

+    def test_enforce_ip_version_4(self):

+        enforce_ip_version(4)

+        self.assertEqual(pycurl.IPRESOLVE_V4, pycurl.IPRESOLVE_V4)

+        enforce_ip_version("4")

+        self.assertEqual(pycurl.IPRESOLVE_V4, pycurl.IPRESOLVE_V4)

+

+    def test_enforce_ip_version_5(self):

+        with self.assertRaises(Exception):

+            enforce_ip_version(5)

+

+        with self.assertRaises(Exception):

+            enforce_ip_version("5")

+

+    def test_enforce_ip_version_6(self):

+        enforce_ip_version(6)

+        self.assertEqual(pycurl.IPRESOLVE_V6, pycurl.IPRESOLVE_V6)

+        enforce_ip_version("6")

+        self.assertEqual(pycurl.IPRESOLVE_V6, pycurl.IPRESOLVE_V6)

+

+    def test_enforce_ip_version_None(self):

+        enforce_ip_version(None)

+        self.assertEqual(pycurl.IPRESOLVE_WHATEVER, pycurl.IPRESOLVE_WHATEVER)

+

+        enforce_ip_version()

+        self.assertEqual(pycurl.IPRESOLVE_WHATEVER, pycurl.IPRESOLVE_WHATEVER)

+

+    def test_enforce_ip_version_obj(self):

+        mock = Mock()

+        with self.assertRaises(ValueError):

+            enforce_ip_version(mock)

+

+

+if __name__ == "__main__":

+    unittest.main()

+```
