+I replaced `requests` with `urllib3` by creating a reusable `PoolManager` and updating the HTTP calls to use `pool.request("GET", ...)`. Since `urllib3` does not provide `raise_for_status()` or `.json()` directly on the response object, I added equivalent handling: checking the HTTP status code and decoding/parsing the response body with `json.loads()`.

+

+```python

+from typing import Any

+import json

+

+import urllib3

+

+http = urllib3.PoolManager()

+

+

+def build_route(base_url: str, *paths: str | int) -> str:

+    if base_url.endswith("/"):

+        base_url = base_url[:-1]

+

+    paths = tuple(str(p).strip("/") for p in paths)

+    url = f"{base_url}/{'/'.join(paths)}"

+    return url.strip("/")

+

+

+def add_filters(url: str, *args: tuple[str, Any]) -> str:

+    """

+    Adds filters to the given url.

+    """

+    symbol = "?"

+    if "?" in url:

+        symbol = "&"

+    for arg in args:

+        url = f"{url}{symbol}{arg[0]}={arg[1]}"

+        symbol = "&"

+    return url

+

+

+def get(url: str) -> Any:

+    response = http.request("GET", url)

+    if response.status >= 400:

+        raise urllib3.exceptions.HTTPError(f"HTTP {response.status} for url: {url}")

+    return json.loads(response.data.decode("utf-8"))

+

+

+def get_content(url: str) -> bytes:

+    response = http.request("GET", url)

+    if response.status >= 400:

+        raise urllib3.exceptions.HTTPError(f"HTTP {response.status} for url: {url}")

+    return response.data

+```
