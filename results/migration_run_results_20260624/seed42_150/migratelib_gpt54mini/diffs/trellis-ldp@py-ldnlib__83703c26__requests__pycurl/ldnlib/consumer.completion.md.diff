--- /dev/null
+++ b/ldnlib/consumer.completion.md
@@ -0,0 +1,93 @@
+I replaced the `requests.get(...)` calls with `pycurl`-based HTTP GET requests, added a small internal helper to perform the request and collect the response body and headers, and mapped the response handling to `pycurl` equivalents (`HTTP_CODE`, header parsing, and content retrieval). The public class, method names, and variable names were kept unchanged.

+

+```python

+from rdflib import Graph, URIRef

+import pycurl

+

+import json

+from io import BytesIO

+

+from .base import BaseLDN

+

+

+class Consumer(BaseLDN):

+

+    def __init__(self, **kwargs):

+        super(self.__class__, self).__init__(**kwargs)

+

+    def _get(self, url, headers=dict(), **kwargs):

+        body = BytesIO()

+        header_buffer = BytesIO()

+        c = pycurl.Curl()

+        c.setopt(c.URL, url)

+        c.setopt(c.WRITEDATA, body)

+        c.setopt(c.HEADERFUNCTION, header_buffer.write)

+

+        curl_headers = []

+        for k, v in headers.items():

+            curl_headers.append('%s: %s' % (k, v))

+        if curl_headers:

+            c.setopt(c.HTTPHEADER, curl_headers)

+

+        if 'timeout' in kwargs:

+            c.setopt(c.TIMEOUT, kwargs.pop('timeout'))

+        if 'connect_timeout' in kwargs:

+            c.setopt(c.CONNECTTIMEOUT, kwargs.pop('connect_timeout'))

+        if 'verify' in kwargs:

+            if not kwargs.pop('verify'):

+                c.setopt(c.SSL_VERIFYPEER, 0)

+                c.setopt(c.SSL_VERIFYHOST, 0)

+        if 'allow_redirects' in kwargs:

+            if not kwargs.pop('allow_redirects'):

+                c.setopt(c.FOLLOWLOCATION, 0)

+        if 'auth' in kwargs:

+            auth = kwargs.pop('auth')

+            if auth is not None:

+                c.setopt(c.USERPWD, '%s:%s' % (auth[0], auth[1]))

+

+        c.setopt(c.CUSTOMREQUEST, 'GET')

+

+        try:

+            c.perform()

+            status_code = c.getinfo(c.RESPONSE_CODE)

+            response_headers = header_buffer.getvalue().decode('iso-8859-1').splitlines()

+            response_headers_dict = dict()

+            for line in response_headers:

+                if ':' in line:

+                    k, v = line.split(':', 1)

+                    response_headers_dict[k.strip().lower()] = v.strip()

+            if status_code >= 400:

+                raise Exception('HTTP Error %s' % status_code)

+            return body.getvalue().decode('utf-8'), response_headers_dict

+        finally:

+            c.close()

+

+    def notifications(self, inbox, **kwargs):

+        """

+        Retrieve all of the notification IRIs from an ldp:inbox as a list.

+        """

+        headers = kwargs.pop("headers", dict())

+        if 'accept' not in headers:

+            headers['accept'] = kwargs.pop("accept", self.accept_headers)

+

+        text, response_headers = self._get(inbox, headers=headers, **kwargs)

+        g = Graph().parse(data=text, format=self.content_type_to_mime_type(

+            response_headers['content-type']))

+        return [str(o) for (s, o) in g[:URIRef(self.LDP_CONTAINS)]]

+

+    def notification(self, iri, **kwargs):

+        """

+        Retrieve a single LDN notification and decode into a Python object.

+        """

+        headers = kwargs.pop("headers", dict())

+        if 'accept' not in headers:

+            headers['accept'] = kwargs.pop("accept", self.accept_headers)

+

+        text, response_headers = self._get(iri, headers=headers, **kwargs)

+        mime_type = self.content_type_to_mime_type(response_headers['content-type'])

+        if mime_type == self.JSON_LD:

+            return json.loads(text)

+        else:

+            g = Graph().parse(data=text, format=mime_type)

+            return json.loads(g.serialize(format="json-ld"))

+```
