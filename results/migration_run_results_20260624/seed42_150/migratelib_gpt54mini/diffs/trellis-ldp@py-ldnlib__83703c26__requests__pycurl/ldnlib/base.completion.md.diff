+++ b/ldnlib/base.completion.md
@@ -0,0 +1,127 @@
+I replaced the `requests`-based HTTP calls with `pycurl` equivalents for `HEAD` and `GET`, added a small internal helper to execute a curl request and collect the response body, headers, status code, and final URL, and preserved the existing method names and behavior as closely as possible.

+

+```python

+from rdflib import Graph, URIRef

+import pycurl

+from io import BytesIO

+

+

+class BaseLDN(object):

+

+    ACCEPT_HEADERS = ("application/ld+json; q=1.0,"

+                      "text/turtle; q=0.9,"

+                      "application/xml+rdf; q=0.5")

+    JSON_LD = "application/ld+json"

+    LDP_INBOX = "http://www.w3.org/ns/ldp#inbox"

+    LDP_CONTAINS = "http://www.w3.org/ns/ldp#contains"

+

+    def __init__(self, **kwargs):

+        self.accept_headers = kwargs.get('accept_headers', self.ACCEPT_HEADERS)

+

+    def __perform_request(self, target, method='GET', **kwargs):

+        buffer = BytesIO()

+        header_buffer = BytesIO()

+        c = pycurl.Curl()

+        c.setopt(pycurl.URL, target)

+        c.setopt(pycurl.FOLLOWLOCATION, kwargs.pop('allow_redirects', True))

+        c.setopt(pycurl.NOBODY, method == 'HEAD')

+        c.setopt(pycurl.CUSTOMREQUEST, method)

+        c.setopt(pycurl.WRITEFUNCTION, buffer.write)

+        c.setopt(pycurl.HEADERFUNCTION, header_buffer.write)

+

+        headers = kwargs.pop('headers', dict())

+        header_list = []

+        for key, value in headers.items():

+            header_list.append('%s: %s' % (key, value))

+        if header_list:

+            c.setopt(pycurl.HTTPHEADER, header_list)

+

+        if 'data' in kwargs:

+            c.setopt(pycurl.POSTFIELDS, kwargs.pop('data'))

+

+        c.perform()

+        status_code = c.getinfo(pycurl.RESPONSE_CODE)

+        effective_url = c.getinfo(pycurl.EFFECTIVE_URL)

+        content_type = c.getinfo(pycurl.CONTENT_TYPE)

+        c.close()

+

+        response_headers = dict()

+        header_lines = header_buffer.getvalue().decode('iso-8859-1').splitlines()

+        for line in header_lines:

+            if ':' in line:

+                key, value = line.split(':', 1)

+                response_headers[key.strip().lower()] = value.strip()

+

+        body = buffer.getvalue().decode('utf-8')

+

+        class Response(object):

+            pass

+

+        r = Response()

+        r.status_code = status_code

+        r.url = effective_url

+        r.text = body

+        r.headers = response_headers

+        r.content_type = content_type

+        r.links = dict()

+

+        link_header = response_headers.get('link')

+        if link_header:

+            links = link_header.split(',')

+            for link in links:

+                parts = link.split(';')

+                if len(parts) > 0:

+                    url_part = parts[0].strip()

+                    if url_part.startswith('<') and url_part.endswith('>'):

+                        url = url_part[1:-1]

+                        rel = None

+                        for part in parts[1:]:

+                            part = part.strip()

+                            if part.startswith('rel='):

+                                rel = part[4:].strip('"')

+                        if rel is not None:

+                            r.links[rel] = {'url': url}

+

+        if status_code >= 400:

+            raise Exception('HTTP Error %s' % status_code)

+

+        return r

+

+    def __discover_head(self, target, **kwargs):

+        r = self.__perform_request(target, method='HEAD', **kwargs)

+        if self.LDP_INBOX in r.links:

+            return r.links[self.LDP_INBOX].get('url')

+

+    def __discover_get(self, target, **kwargs):

+        r = self.__perform_request(target, method='GET', **kwargs)

+        # TODO -- check for HTML

+        g = Graph().parse(data=r.text, format=self.content_type_to_mime_type(

+            r.headers['content-type']))

+

+        for (subject, inbox) in g[:URIRef(self.LDP_INBOX)]:

+            return str(inbox)

+

+    def content_type_to_mime_type(self, content_type):

+        """

+        A utility method to convert a content-type header into a

+        mime-type string.

+        """

+        return content_type.split(";")[0].strip()

+

+    def discover(self, target, **kwargs):

+        """Discover the inbox for a resource."""

+        headers = kwargs.pop("headers", dict())

+        if 'accept' not in headers:

+            headers['accept'] = kwargs.pop("accept", self.accept_headers)

+        allow_redirects = kwargs.pop('allow_redirects', True)

+

+        inbox = self.__discover_head(target, headers=headers,

+                                     allow_redirects=allow_redirects,

+                                     **kwargs)

+        if inbox is None:

+            return self.__discover_get(target, headers=headers,

+                                       allow_redirects=allow_redirects,

+                                       **kwargs)

+        else:

+            return inbox

+```
