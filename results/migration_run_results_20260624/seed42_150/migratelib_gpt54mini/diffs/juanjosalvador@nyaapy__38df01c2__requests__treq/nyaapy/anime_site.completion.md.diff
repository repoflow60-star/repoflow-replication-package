@@ -0,0 +1,112 @@
+I migrated the HTTP calls from `requests.get(...)` to `treq.get(...)`. Since `treq` is Twisted-based, the returned value is a Deferred-like response flow rather than a synchronous `requests.Response`, so I updated the code to use `treq.content(...)` to read the response body and `treq.json_content(...)`-style parsing was not needed here because the existing parser functions already consume raw text/bytes. I also replaced `raise_for_status()` with explicit status-code checks, since that `requests` helper does not exist in `treq`.

+

+```python

+import treq

+from nyaapy import torrent

+from nyaapy.parser import parse_nyaa, parse_single, parse_nyaa_rss

+

+

+class AnimeTorrentSite:

+    SITE = torrent.TorrentSite.NYAASI

+    URL = "https://nyaa.si"

+

+    @classmethod

+    def last_uploads(self, number_of_results: int):

+        r = treq.get(self.URL)

+

+        # If anything up with nyaa servers let the user know.

+        if r.code >= 400:

+            raise Exception(f"HTTP error {r.code}")

+

+        r = treq.content(r)

+

+        json_data = parse_nyaa(

+            request_text=r, limit=number_of_results, site=self.SITE

+        )

+

+        return torrent.json_to_class(json_data)

+

+    @classmethod

+    def search(self, keyword: str, **kwargs):

+        base_url = self.URL

+

+        user = kwargs.get("user", None)

+        category = kwargs.get("category", 0)

+        subcategory = kwargs.get("subcategory", 0)

+        filters = kwargs.get("filters", 0)

+        page = kwargs.get("page", 0)

+        sorting = kwargs.get(

+            "sort", "id"

+        )  # Sorting by id = sorting by date, this is the default.

+        order = kwargs.get("order", "desc")

+

+        user_uri = f"user/{user}" if user else ""

+

+        if page > 0:

+            search_uri = "{}/{}?f={}&c={}_{}&q={}&p={}&s={}&o={}".format(

+                base_url,

+                user_uri,

+                filters,

+                category,

+                subcategory,

+                keyword,

+                page,

+                sorting,

+                order,

+            )

+        else:

+            search_uri = "{}/{}?f={}&c={}_{}&q={}&s={}&o={}".format(

+                base_url,

+                user_uri,

+                filters,

+                category,

+                subcategory,

+                keyword,

+                sorting,

+                order,

+            )

+

+        if not user:

+            search_uri += "&page=rss"

+

+        http_response = treq.get(search_uri)

+        if http_response.code >= 400:

+            raise Exception(f"HTTP error {http_response.code}")

+

+        http_response = treq.content(http_response)

+

+        if user:

+            json_data = parse_nyaa(

+                request_text=http_response, limit=None, site=self.SITE

+            )

+        else:

+            json_data = parse_nyaa_rss(

+                request_text=http_response, limit=None, site=self.SITE

+            )

+

+        # Convert JSON data to a class object

+        return torrent.json_to_class(json_data)

+

+    @classmethod

+    def get(self, view_id: int):

+        r = treq.get(f"{self.URL}/view/{view_id}")

+        if r.code >= 400:

+            raise Exception(f"HTTP error {r.code}")

+

+        r = treq.content(r)

+

+        json_data = parse_single(request_text=r, site=self.SITE)

+

+        return torrent.json_to_class(json_data)

+

+    @classmethod

+    def get_from_user(self, username):

+        r = treq.get(f"{self.URL}/user/{username}")

+        if r.code >= 400:

+            raise Exception(f"HTTP error {r.code}")

+

+        r = treq.content(r)

+

+        json_data = parse_nyaa(request_text=r, limit=None, site=self.SITE)

+        return torrent.json_to_class(json_data)

+```
