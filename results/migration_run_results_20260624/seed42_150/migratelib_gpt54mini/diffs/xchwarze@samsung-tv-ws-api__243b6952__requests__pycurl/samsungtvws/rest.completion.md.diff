--- /dev/null
+++ b/samsungtvws/rest.completion.md
@@ -0,0 +1,83 @@
+I replaced the `requests` calls with `pycurl`-based HTTP requests, added the necessary `pycurl` and `io` imports, and mapped the original GET/POST/PUT/DELETE behavior to `pycurl` options. I also changed the connection error handling to catch `pycurl.error` and kept the response processing through `helper.process_api_response` unchanged.

+

+```python

+"""

+SamsungTVWS - Samsung Smart TV WS API wrapper

+

+Copyright (C) 2019 DSR! <xchwarze@gmail.com>

+

+SPDX-License-Identifier: LGPL-3.0

+"""

+

+import io

+import logging

+from typing import Any, Dict, Optional

+

+import pycurl

+

+from . import connection, exceptions, helper

+

+_LOGGING = logging.getLogger(__name__)

+

+

+class SamsungTVRest(connection.SamsungTVWSBaseConnection):

+    def __init__(

+        self,

+        host: str,

+        port: int = 8001,

+        timeout: Optional[float] = None,

+    ) -> None:

+        super().__init__(

+            host,

+            endpoint="",

+            port=port,

+            timeout=timeout,

+        )

+

+    def _rest_request(self, target: str, method: str = "GET") -> Dict[str, Any]:

+        url = self._format_rest_url(target)

+        try:

+            buffer = io.BytesIO()

+            curl = pycurl.Curl()

+            curl.setopt(pycurl.URL, url)

+            curl.setopt(pycurl.VERBOSE, False)

+            curl.setopt(pycurl.SSL_VERIFYPEER, False)

+            curl.setopt(pycurl.SSL_VERIFYHOST, False)

+            curl.setopt(pycurl.WRITEFUNCTION, buffer.write)

+            if self.timeout is not None:

+                curl.setopt(pycurl.TIMEOUT, self.timeout)

+            if method == "POST":

+                curl.setopt(pycurl.POST, 1)

+            elif method == "PUT":

+                curl.setopt(pycurl.CUSTOMREQUEST, "PUT")

+            elif method == "DELETE":

+                curl.setopt(pycurl.CUSTOMREQUEST, "DELETE")

+            curl.perform()

+            response = buffer.getvalue().decode("utf-8")

+            curl.close()

+            return helper.process_api_response(response)

+        except pycurl.error as err:

+            raise exceptions.HttpApiError(

+                "TV unreachable or feature not supported on this model."

+            ) from err

+

+    def rest_device_info(self) -> Dict[str, Any]:

+        _LOGGING.debug("Get device info via rest api")

+        return self._rest_request("")

+

+    def rest_app_status(self, app_id: str) -> Dict[str, Any]:

+        _LOGGING.debug("Get app %s status via rest api", app_id)

+        return self._rest_request("applications/" + app_id)

+

+    def rest_app_run(self, app_id: str) -> Dict[str, Any]:

+        _LOGGING.debug("Run app %s via rest api", app_id)

+        return self._rest_request("applications/" + app_id, "POST")

+

+    def rest_app_close(self, app_id: str) -> Dict[str, Any]:

+        _LOGGING.debug("Close app %s via rest api", app_id)

+        return self._rest_request("applications/" + app_id, "DELETE")

+

+    def rest_app_install(self, app_id: str) -> Dict[str, Any]:

+        _LOGGING.debug("Install app %s via rest api", app_id)

+        return self._rest_request("applications/" + app_id, "PUT")

+```
