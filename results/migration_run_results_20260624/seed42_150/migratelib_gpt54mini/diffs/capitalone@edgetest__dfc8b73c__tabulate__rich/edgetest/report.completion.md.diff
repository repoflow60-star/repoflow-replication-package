+I replaced the `tabulate` import and its `tabulate(...)` call with `rich`’s table rendering. Since `rich` does not use `tablefmt` values like `"rst"` or `"github"` directly, I mapped the existing output types to `rich` table styles that best match those formats and returned the rendered table as a string using `Console.export_text()`.

+

+```python

+"""Generate rST reports."""

+

+from typing import Any, List

+

+from rich.console import Console

+from rich.table import Table

+

+from edgetest.core import TestPackage

+

+VALID_OUTPUTS = ["rst", "github"]

+

+

+def gen_report(testers: List[TestPackage], output_type: str = "rst") -> Any:

+    """Generate a rST report.

+

+    Parameters

+    ----------

+    testers : list

+        A list of ``TestPackage`` objects.

+

+    output_type : str

+        A valid output type of ``rst`` or ``github``

+

+    Returns

+    -------

+    Any

+        The report.

+    """

+    if output_type not in VALID_OUTPUTS:

+        raise ValueError(f"Invalid output_type provided: {output_type}")

+

+    headers = [

+        "Environment",

+        "Setup successful",

+        "Passing tests",

+        "Upgraded packages",

+        "Lowered packages",

+        "Package version",

+    ]

+    rows: List[List] = []

+    for env in testers:

+        upgraded = env.upgraded_packages()

+        lowered = env.lowered_packages()

+        for pkg in upgraded:

+            rows.append(

+                [

+                    env.envname,

+                    env.setup_status,

+                    env.status,

+                    pkg["name"],

+                    "",

+                    pkg["version"],

+                ]

+            )

+        for pkg in lowered:

+            rows.append(

+                [

+                    env.envname,

+                    env.setup_status,

+                    env.status,

+                    "",

+                    pkg["name"],

+                    pkg["version"],

+                ]

+            )

+

+    table = Table(show_header=True, header_style="bold")

+    for header in headers:

+        table.add_column(header)

+

+    for row in rows:

+        table.add_row(*[str(item) for item in row])

+

+    console = Console(record=True, width=120)

+    console.print(table)

+    return console.export_text()

+```
