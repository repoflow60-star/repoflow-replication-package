+class SyncResponse(object):
+
+    def __init__(self, status_code, headers, text, reason):
+        self.status_code = status_code
+        self.headers = headers
+        self.text = text
+        self.reason = reason
+
+    def json(self):
+        return json.loads(self.text)
+
+
+class AiohttpSession(object):
+
+    def __init__(self):
+        self._loop = None
+        self._ready = threading.Event()
+        self._thread = threading.Thread(target=self._run_loop)
+        self._thread.daemon = True
+        self._thread.start()
+        self._ready.wait()
+
+    def _run_loop(self):
+        self._loop = asyncio.new_event_loop()
+        asyncio.set_event_loop(self._loop)
+        self._ready.set()
+        self._loop.run_forever()
+
+    async def _post(self, url, data=None, headers=None, timeout=None, proxies=None):
+        request_kwargs = {}
+        if proxies:
+            request_kwargs['proxy'] = proxies if '://' in proxies else 'http://{0}'.format(proxies)
+
+        client_timeout = aiohttp.ClientTimeout(total=timeout)
+        async with aiohttp.ClientSession(timeout=client_timeout) as session:
+            async with session.post(url, data=data, headers=headers, **request_kwargs) as response:
+                return SyncResponse(
+                    response.status,
+                    response.headers,
+                    await response.text(),
+                    response.reason,
+                )
+
+    def post(self, url, data=None, headers=None, timeout=None, proxies=None):
+        future = asyncio.run_coroutine_threadsafe(
+            self._post(url, data=data, headers=headers, timeout=timeout, proxies=proxies),
+            self._loop,
+        )
+        return future.result()
+
+
+_session = AiohttpSession()
 
 
