+class PlacCommand:
+    def __init__(self, func):
+        self.func = func
+        self.name = func.__name__.lstrip('_')
+        self.__name__ = self.name
+        self.__doc__ = func.__doc__
+
+    def __call__(self, *args, **kwargs):
+        return self.func(*args, **kwargs)
+
+    def main(self, args=None, prog_name=None, **_extra):
+        argv = [prog_name or self.name]
+        if isinstance(args, str):
+            argv.extend(shlex.split(args))
+        elif args is not None:
+            argv.extend(args)
+
+        old_argv = sys.argv
+        try:
+            sys.argv = argv
+            return plac.call(self.func)
+        finally:
+            sys.argv = old_argv
+
