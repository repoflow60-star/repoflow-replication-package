-import requests
+import threading
+from urllib.parse import urlencode
+
+import treq
+from twisted.internet import reactor, threads
+
 from nyaapy import torrent
 from nyaapy.parser import parse_nyaa, parse_single, parse_nyaa_rss
+
+
+_reactor_lock = threading.Lock()
+_reactor_ready = threading.Event()
+_reactor_thread = None
+
+
+def _ensure_reactor_running():
+    global _reactor_thread
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if reactor.running:
+            return
+
+        if _reactor_thread is None:
+            def _run_reactor():
+                reactor.callWhenRunning(_reactor_ready.set)
+                reactor.run(installSignalHandlers=False)
+
+            _reactor_thread = threading.Thread(
+                target=_run_reactor,
+                name="nyaapy-treq-reactor",
+                daemon=True,
+            )
+            _reactor_thread.start()
+
+    _reactor_ready.wait()
+
+
+def _raise_for_status(response, url: str):
+    if response.code < 400:
+        return
+
+    phrase = response.phrase.decode() if isinstance(response.phrase, bytes) else response.phrase
+    raise RuntimeError(f"{response.code} {phrase} for {url}")
+
+
+def _get_text(url: str):
+    _ensure_reactor_running()
+    response = threads.blockingCallFromThread(reactor, treq.get, url)
+    _raise_for_status(response, url)
+    return threads.blockingCallFromThread(reactor, treq.text_content, response)
+
+
+def _get_content(url: str):
+    _ensure_reactor_running()
+    response = threads.blockingCallFromThread(reactor, treq.get, url)
+    _raise_for_status(response, url)
+    return threads.blockingCallFromThread(reactor, treq.content, response)
 
 
