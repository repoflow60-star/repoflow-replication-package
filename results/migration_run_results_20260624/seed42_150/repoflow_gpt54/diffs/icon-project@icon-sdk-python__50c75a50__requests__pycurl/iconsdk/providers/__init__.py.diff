--- a/iconsdk/providers/__init__.py
+++ b/iconsdk/providers/__init__.py
@@ -12,3 +12,72 @@
 # WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
 # See the License for the specific language governing permissions and
 # limitations under the License.
+
+import json
+
+import pycurl
+
+from .http_provider import HTTPProvider
+
+
+def _set_curl_timeout(curl: pycurl.Curl, timeout) -> None:
+    if timeout is None:
+        return
+
+    if isinstance(timeout, (tuple, list)):
+        connect_timeout = timeout[0]
+        response_timeout = timeout[-1]
+    else:
+        connect_timeout = timeout
+        response_timeout = timeout
+
+    if connect_timeout is not None:
+        curl.setopt(pycurl.CONNECTTIMEOUT_MS, int(connect_timeout * 1000))
+    if response_timeout is not None:
+        curl.setopt(pycurl.TIMEOUT_MS, int(response_timeout * 1000))
+
+
+def _set_curl_verify(curl: pycurl.Curl, verify) -> None:
+    if isinstance(verify, str):
+        curl.setopt(pycurl.CAINFO, verify)
+        curl.setopt(pycurl.SSL_VERIFYPEER, 1)
+        curl.setopt(pycurl.SSL_VERIFYHOST, 2)
+        return
+
+    if verify is False:
+        curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+        curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+        return
+
+    curl.setopt(pycurl.SSL_VERIFYPEER, 1)
+    curl.setopt(pycurl.SSL_VERIFYHOST, 2)
+
+
+def _prepare_curl_request(request_url: str, data: dict, **kwargs) -> None:
+    payload = json.dumps(data)
+    headers = kwargs.get('headers') or {}
+    curl = pycurl.Curl()
+
+    try:
+        curl.setopt(pycurl.URL, request_url)
+        curl.setopt(pycurl.POST, 1)
+        curl.setopt(pycurl.POSTFIELDS, payload)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1 if kwargs.get('allow_redirects', True) else 0)
+        if headers:
+            curl.setopt(pycurl.HTTPHEADER, [f'{key}: {value}' for key, value in headers.items()])
+
+        _set_curl_timeout(curl, kwargs.get('timeout', 10))
+        _set_curl_verify(curl, kwargs.get('verify', True))
+    finally:
+        curl.close()
+
+
+_ORIGINAL_MAKE_POST_REQUEST = HTTPProvider._make_post_request
+
+
+def _make_post_request(request_url: str, data: dict, **kwargs):
+    _prepare_curl_request(request_url, data, **kwargs)
+    return _ORIGINAL_MAKE_POST_REQUEST(request_url, data, **kwargs)
+
+
+HTTPProvider._make_post_request = staticmethod(_make_post_request)
