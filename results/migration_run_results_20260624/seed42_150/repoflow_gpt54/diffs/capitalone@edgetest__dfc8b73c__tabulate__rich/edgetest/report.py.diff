+from rich.console import Console
+from rich.text import Text
 
 from edgetest.core import TestPackage
 
 VALID_OUTPUTS = ["rst", "github"]
+
+
+def _measure_widths(headers: List[str], rows: List[List[str]], tablefmt: str) -> List[int]:
+    console = Console(color_system=None, force_terminal=False, width=1000)
+    widths: List[int] = []
+
+    for index, header in enumerate(headers):
+        header_width = console.measure(Text(header)).maximum
+        content_width = 0
+        for row in rows:
+            content_width = max(content_width, console.measure(Text(row[index])).maximum)
+
+        if tablefmt == "rst":
+            widths.append(max(content_width, header_width + 2))
+        else:
+            widths.append(max(content_width, header_width))
+
+    return widths
+
+
+def _format_rst(headers: List[str], rows: List[List[str]], widths: List[int]) -> str:
+    border = "  ".join("=" * width for width in widths)
+    lines = [
+        border,
+        "  ".join(value.ljust(width) for value, width in zip(headers, widths)),
+        border,
+    ]
+    lines.extend(
+        "  ".join(value.ljust(width) for value, width in zip(row, widths))
+        for row in rows
+    )
+    lines.append(border)
+
+    return "\n".join(lines)
+
+
+def _format_github(headers: List[str], rows: List[List[str]], widths: List[int]) -> str:
+    lines = [
+        "| " + " | ".join(value.ljust(width) for value, width in zip(headers, widths)) + " |",
+        "|-" + "-|-".join("-" * width for width in widths) + "-|",
+    ]
+    lines.extend(
+        "| " + " | ".join(value.ljust(width) for value, width in zip(row, widths)) + " |"
+        for row in rows
+    )
+
+    return "\n".join(lines)
+
+
+def tabulate(tabular_data: List[List[Any]], headers: Any = (), tablefmt: str = "simple") -> str:
+    """Compatibility wrapper backed by ``rich`` formatting."""
+    if tablefmt not in VALID_OUTPUTS:
+        raise ValueError(f"Invalid tablefmt provided: {tablefmt}")
+
+    normalized_headers = [Text(str(header)).plain for header in headers]
+    normalized_rows = [
+        [Text("" if value is None else str(value)).plain for value in row]
+        for row in tabular_data
+    ]
+    widths = _measure_widths(normalized_headers, normalized_rows, tablefmt)
+
+    if tablefmt == "github":
+        return _format_github(normalized_headers, normalized_rows, widths)
+
+    return _format_rst(normalized_headers, normalized_rows, widths)
 
 
