+
+def _get_proxy_url() -> Optional[str]:
+    if not PROXY_DICT:
+        return None
+    return PROXY_DICT.get('https') or PROXY_DICT.get('http')
+
+
+def _build_request_session() -> httpx.Client:
+    client_kwargs = {
+        'verify': VERIFY_SSL,
+        'timeout': None,
+        'follow_redirects': True,
+    }
+    proxy_url = _get_proxy_url()
+    if proxy_url:
+        client_kwargs['proxy'] = proxy_url
+    return httpx.Client(**client_kwargs)
+
+
+class RequestSession:
+    def __init__(self) -> None:
+        self._client = None
+
+    def _get_client(self) -> httpx.Client:
+        if self._client is None:
+            self._client = _build_request_session()
+        return self._client
+
+    def close(self) -> None:
+        if self._client is not None:
+            self._client.close()
+            self._client = None
+
+    def get(self, *args, **kwargs):
+        return self._get_client().get(*args, **kwargs)
+
+    def post(self, *args, **kwargs):
+        return self._get_client().post(*args, **kwargs)
+
+
+REQ_SESSION = RequestSession()
+
+
+def _refresh_request_session() -> None:
+    REQ_SESSION.close()
 
