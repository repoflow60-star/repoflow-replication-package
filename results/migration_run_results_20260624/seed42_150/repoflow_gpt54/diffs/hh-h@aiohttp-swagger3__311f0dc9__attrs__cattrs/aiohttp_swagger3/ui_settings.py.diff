+def _validate_instance_of(name: str, value: Any, expected: Union[type, tuple]) -> None:
+    if not isinstance(value, expected):
+        raise TypeError(f"{name} must be an instance of {expected}")
+
+
+def _validate_in(name: str, value: str, options: Sequence[str]) -> None:
+    if value not in options:
+        raise ValueError(f"{name} must be one of {tuple(options)}")
+
+
+def _validate_optional_instance_of(name: str, value: Optional[Any], expected: Union[type, tuple]) -> None:
+    if value is not None:
+        _validate_instance_of(name, value, expected)
+
+
+def _validate_deep_iterable(name: str, value: List[str], options: Sequence[str]) -> None:
+    _validate_instance_of(name, value, list)
+    for item in value:
+        _validate_in(name, item, options)
+
