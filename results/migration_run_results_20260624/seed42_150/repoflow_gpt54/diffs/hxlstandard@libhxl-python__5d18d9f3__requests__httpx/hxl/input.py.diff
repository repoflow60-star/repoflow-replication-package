+DEFAULT_HTTP_USER_AGENT = 'python-requests/2.31.0'
+
+
+def _get_http_headers(headers=None):
+    """Add a legacy-compatible default user agent for remote downloads."""
+    headers = dict(headers) if headers else {}
+    if not any(name.lower() == 'user-agent' for name in headers):
+        headers['User-Agent'] = DEFAULT_HTTP_USER_AGENT
+    return headers
+
+
+def _http_request(method, url, **kwargs):
+    """Wrapper around httpx with legacy redirect defaults."""
+    kwargs['headers'] = _get_http_headers(kwargs.get('headers'))
+    kwargs.setdefault('follow_redirects', method.lower() != 'head')
+    try:
+        return httpx.request(method, url, **kwargs)
+    except httpx.HTTPError as e:
+        raise HXLIOException(str(e), url=url) from e
+
+
+def _http_raise_for_status(response):
+    """Raise an IOError-compatible exception for HTTP status failures."""
+    try:
+        response.raise_for_status()
+    except httpx.HTTPStatusError as e:
+        raise HXLIOException(str(e), url=str(response.request.url)) from e
 
 
