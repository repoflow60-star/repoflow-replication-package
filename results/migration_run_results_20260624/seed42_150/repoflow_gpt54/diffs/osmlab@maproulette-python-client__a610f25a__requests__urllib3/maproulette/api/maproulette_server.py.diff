+    @staticmethod
+    def __status_code(response):
+        status_code = getattr(response, 'status_code', None)
+        if status_code is None:
+            status_code = getattr(response, 'status', None)
+        return status_code
+
+    @staticmethod
+    def __has_error_status(response):
+        try:
+            return int(MapRouletteServer.__status_code(response)) >= 400
+        except (TypeError, ValueError):
+            return False
+
+    @staticmethod
+    def __response_text(response):
+        if hasattr(response, 'text'):
+            return response.text
+
+        data = getattr(response, 'data', b'')
+        if isinstance(data, bytes):
+            return data.decode('utf-8', errors='replace')
+        return data
+
+    @staticmethod
+    def __serialize_response(response):
+        try:
+            data = response.json()
+        except ValueError:
+            data = MapRouletteServer.__response_text(response)
+
+        return {
+            "data": data,
+            "status": MapRouletteServer.__status_code(response)
+        }
 
