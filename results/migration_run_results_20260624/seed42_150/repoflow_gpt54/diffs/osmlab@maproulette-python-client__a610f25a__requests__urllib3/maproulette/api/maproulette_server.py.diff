+class _ResponseAdapter:
+    def __init__(self, response):
+        self._response = response
+        self.data = response.data
+        self.status = response.status
+        self.status_code = response.status
+
+    @property
+    def ok(self):
+        return self.status_code < 400
+
+    @property
+    def text(self):
+        return self.data.decode('utf-8', errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+
+class _SessionAdapter:
+    def __init__(self):
+        self.headers = {}
+        self.verify = True
+        self.cert = None
+
+    @staticmethod
+    def _build_url(url, params=None):
+        if not params:
+            return url
+
+        separator = '&' if '?' in url else '?'
+        return f"{url}{separator}{urlencode(params, doseq=True)}"
+
+    def _pool_manager(self):
+        pool_kwargs = {
+            'cert_reqs': ssl.CERT_REQUIRED if self.verify else ssl.CERT_NONE,
+            'retries': False
+        }
+
+        if not self.verify:
+            pool_kwargs['assert_hostname'] = False
+
+        if isinstance(self.cert, tuple):
+            pool_kwargs['cert_file'] = self.cert[0]
+            if len(self.cert) > 1:
+                pool_kwargs['key_file'] = self.cert[1]
+        elif self.cert:
+            pool_kwargs['cert_file'] = self.cert
+
+        return urllib3.PoolManager(**pool_kwargs)
+
+    def _request(self, method, url, params=None, json_body=None, files=None):
+        headers = {key: value for key, value in self.headers.items() if value is not None}
+        request_kwargs = {
+            'headers': headers,
+            'preload_content': True
+        }
+
+        if json_body is not None:
+            request_kwargs['body'] = json.dumps(json_body).encode('utf-8')
+            headers['Content-Type'] = 'application/json'
+
+        if files is not None:
+            request_kwargs['fields'] = files
+
+        response = self._pool_manager().request(method, self._build_url(url, params), **request_kwargs)
+        return _ResponseAdapter(response)
+
+    def get(self, url, params=None):
+        return self._request('GET', url, params=params)
+
+    def post(self, url, params=None, json=None):
+        return self._request('POST', url, params=params, json_body=json)
+
+    def put(self, url, params=None, json=None, files=None):
+        return self._request('PUT', url, params=params, json_body=json, files=files)
+
+    def delete(self, url, params=None):
+        return self._request('DELETE', url, params=params)
+
+
+class _RequestsCompat:
+    Session = _SessionAdapter
+
+
+requests = _RequestsCompat()
 
 
