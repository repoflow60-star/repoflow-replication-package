+def register_filters() -> Dict[str, Any]:
+    return {
+        'KB': kb,
+        'MB': mb,
+        'GB': gb,
+        'uptime': uptime,
+        'uptimesec': uptimesec,
+    }
+
+
+def _translate_filter(expression: str, filter_expr: str) -> str:
+    filter_expr = filter_expr.strip()
+    match = re.fullmatch(r'([A-Za-z_][A-Za-z0-9_]*)\s*\((.*)\)', filter_expr)
+    if match:
+        filter_name, filter_args = match.groups()
+        filter_args = filter_args.strip()
+        if filter_args:
+            return f'__filter_{filter_name}({expression}, {filter_args})'
+        return f'__filter_{filter_name}({expression})'
+    return f'__filter_{filter_expr}({expression})'
+
+
+def _translate_expression(expression: str) -> str:
+    parts = [part.strip() for part in expression.split('|')]
+    translated = parts[0]
+    for filter_expr in parts[1:]:
+        translated = _translate_filter(translated, filter_expr)
+    return translated
+
+
+def _translate_template(template: str) -> str:
+    # Preserve the existing Jinja-style template strings while rendering via Mako.
+    def replace(match: re.Match) -> str:
+        return '${' + _translate_expression(match.group(1).strip()) + '}'
+
+    return re.sub(r'\{\{(.*?)\}\}', replace, template, flags=re.DOTALL)
+
 
