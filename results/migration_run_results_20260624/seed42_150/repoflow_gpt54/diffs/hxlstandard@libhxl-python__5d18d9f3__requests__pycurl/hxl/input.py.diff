+class _HTTPHeaders(dict):
+    """Case-insensitive mapping for response headers."""
+
+    def __getitem__(self, key):
+        return super().__getitem__(key.lower())
+
+    def get(self, key, default=None):
+        return super().get(key.lower(), default)
+
+    def __setitem__(self, key, value):
+        super().__setitem__(key.lower(), value)
+
+
+class _HTTPResponse(object):
+    """Small response wrapper matching the subset of the old client API we use."""
+
+    def __init__(self, url, status_code, headers, content):
+        self.url = url
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+
+    @property
+    def is_redirect(self):
+        return self.status_code in (301, 302, 303, 307, 308)
+
+    def json(self):
+        encoding = 'utf-8'
+        content_type = self.headers.get('content-type')
+        if content_type:
+            result = re.search(r'charset=([^;\s]+)', content_type, re.IGNORECASE)
+            if result:
+                encoding = result.group(1).strip('"').strip("'")
+        return json.loads(self.content.decode(encoding))
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise HXLIOException(
+                "HTTP error {} while retrieving {}".format(self.status_code, self.url),
+                url=self.url
+            )
+
+
+def _append_url_params(url, params):
+    """Append query params to a URL without disturbing existing parameters."""
+    if not params:
+        return url
+    separator = '&' if urllib.parse.urlsplit(url).query else '?'
+    return '{}{}{}'.format(url, separator, urllib.parse.urlencode(params, doseq=True))
+
+
+def _http_request(method, url, verify_ssl=True, timeout=None, headers=None, params=None, data=None, follow_redirects=True):
+    """Perform a small HTTP request using pycurl."""
+    content = io.BytesIO()
+    response_headers = _HTTPHeaders()
+    request_url = _append_url_params(url, params)
+    curl = pycurl.Curl()
+
+    def handle_header(header_line):
+        header_text = header_line.decode('iso-8859-1').strip()
+        if not header_text:
+            return len(header_line)
+        if header_text.startswith('HTTP/'):
+            response_headers.clear()
+            return len(header_line)
+        parts = header_text.split(':', 1)
+        if len(parts) == 2:
+            response_headers[parts[0].strip()] = parts[1].strip()
+        return len(header_line)
+
+    try:
+        curl.setopt(pycurl.URL, request_url)
+        curl.setopt(pycurl.WRITEDATA, content)
+        curl.setopt(pycurl.HEADERFUNCTION, handle_header)
+        curl.setopt(pycurl.ACCEPT_ENCODING, '')
+        curl.setopt(pycurl.FOLLOWLOCATION, 1 if follow_redirects else 0)
+        curl.setopt(pycurl.NOSIGNAL, 1)
+
+        if timeout is not None:
+            timeout = int(timeout)
+            curl.setopt(pycurl.CONNECTTIMEOUT, timeout)
+            curl.setopt(pycurl.TIMEOUT, timeout)
+
+        if not verify_ssl:
+            curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+            curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+
+        if headers:
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                ['{}: {}'.format(name, value) for name, value in headers.items()]
+            )
+
+        method = method.upper()
+        if method == 'HEAD':
+            curl.setopt(pycurl.NOBODY, 1)
+            curl.setopt(pycurl.CUSTOMREQUEST, 'HEAD')
+        elif method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, urllib.parse.urlencode(data or {}, doseq=True))
+        elif method != 'GET':
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        response_url = curl.getinfo(pycurl.EFFECTIVE_URL) or request_url
+        return _HTTPResponse(response_url, status_code, response_headers, content.getvalue())
+    except pycurl.error as e:
+        message = e.args[1] if len(e.args) > 1 else str(e)
+        if e.args and e.args[0] == pycurl.E_OPERATION_TIMEDOUT:
+            raise HXLTimeoutException(url=url)
+        raise HXLIOException("Cannot open URL {} ({})".format(url, message), url=url)
+    finally:
+        curl.close()
 
 
