+def _fields(params):
+    if not params:
+        return None
+
+    fields = []
+    for key, value in params.items():
+        if value is None:
+            continue
+        if isinstance(value, (list, tuple)):
+            fields.extend((key, item) for item in value if item is not None)
+        else:
+            fields.append((key, value))
+
+    return fields or None
+
