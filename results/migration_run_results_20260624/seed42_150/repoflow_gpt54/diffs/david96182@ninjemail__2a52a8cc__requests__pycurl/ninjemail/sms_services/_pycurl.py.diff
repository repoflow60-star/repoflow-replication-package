--- a/ninjemail/sms_services/_pycurl.py
+++ b/ninjemail/sms_services/_pycurl.py
@@ -0,0 +1,85 @@
+import json
+from io import BytesIO
+from urllib.parse import urlencode
+
+import pycurl
+
+
+class HTTPError(Exception):
+    pass
+
+
+class Response:
+    def __init__(self, status_code, body):
+        self.status_code = status_code
+        self._body = body
+
+    @property
+    def text(self):
+        return self._body.decode("utf-8", errors="replace")
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise HTTPError(f"HTTP {self.status_code}: {self.text}")
+
+
+def _encode_payload(payload):
+    if payload is None:
+        return None
+    if isinstance(payload, (bytes, bytearray)):
+        return bytes(payload)
+    if isinstance(payload, str):
+        return payload.encode("utf-8")
+    return urlencode(payload, doseq=True).encode("utf-8")
+
+
+def request(method, url, headers=None, params=None, data=None):
+    headers = dict(headers or {})
+
+    if params:
+        query = urlencode(params, doseq=True)
+        separator = "&" if "?" in url else "?"
+        url = f"{url}{separator}{query}"
+
+    body = BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEDATA, body)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+
+        method = method.upper()
+        if method == "POST":
+            payload = _encode_payload(data)
+            curl.setopt(pycurl.POST, True)
+            if payload is not None:
+                if not isinstance(data, (bytes, bytearray, str)):
+                    headers.setdefault(
+                        "Content-Type", "application/x-www-form-urlencoded"
+                    )
+                curl.setopt(pycurl.POSTFIELDS, payload)
+        elif method != "GET":
+            payload = _encode_payload(data)
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            if payload is not None:
+                if not isinstance(data, (bytes, bytearray, str)):
+                    headers.setdefault(
+                        "Content-Type", "application/x-www-form-urlencoded"
+                    )
+                curl.setopt(pycurl.POSTFIELDS, payload)
+
+        if headers:
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                [f"{key}: {value}" for key, value in headers.items()],
+            )
+
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+
+    return Response(status_code, body.getvalue())
