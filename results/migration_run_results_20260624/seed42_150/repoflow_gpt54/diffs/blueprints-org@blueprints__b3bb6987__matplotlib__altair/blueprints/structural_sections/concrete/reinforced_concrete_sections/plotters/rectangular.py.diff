+    ) -> alt.LayerChart:
+        """Build a companion Altair chart for the same plot content."""
+        x_domain, y_domain = self._get_plot_domains(
+            offset_line_width=offset_line_width,
+            offset_line_height=offset_line_height,
+            include_legend=include_legend,
+            custom_legend_text=custom_text_legend,
