+                font_size_dimension=font_size_dimension,
+            ),
+        ]
+
+        stirrup_layer = self._altair_stirrup_layer(x_encoding=x_encoding, y_encoding=y_encoding)
+        if stirrup_layer is not None:
+            layers.append(stirrup_layer)
+
+        rebar_layer = self._altair_rebar_layer(x_encoding=x_encoding, y_encoding=y_encoding)
