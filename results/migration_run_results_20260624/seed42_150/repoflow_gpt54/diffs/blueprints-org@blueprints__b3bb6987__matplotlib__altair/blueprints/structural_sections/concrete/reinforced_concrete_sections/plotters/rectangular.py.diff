+    def _get_plot_domains(
+        self,
+        offset_line_width: float,
+        offset_line_height: float,
+        include_legend: bool,
+        custom_legend_text: str | None,
+        font_size_legend: float,
+    ) -> tuple[list[float], list[float]]:
+        """Get chart domains with room for dimensions and the legend."""
+        width = self.cross_section.width
+        height = self.cross_section.height
+        max_dimension = max(width, height, 1.0)
+        padding = max_dimension * 0.15
+        offset_center_line = 1.05
+
+        min_x = min(-width / 2, (-width / 2) * offset_line_height) - padding
+        max_x = max(width / 2, (width / 2) * offset_center_line) + padding
+        min_y = min(-height / 2, (-height / 2) * offset_line_width) - padding
+        max_y = max(height / 2, (height / 2) * offset_center_line) + padding
+
+        if include_legend:
+            legend_text = custom_legend_text or self.legend_text()
+            legend_lines = legend_text.splitlines() or [legend_text]
+            longest_line = max((len(line) for line in legend_lines), default=0)
+            line_count = max(len(legend_lines), 1)
+            legend_x = (width / 2) * offset_center_line
+            legend_width = max_dimension * (longest_line / 18) * max(font_size_legend / 10, 0.5)
+            legend_depth = max_dimension * (line_count / 11) * max(font_size_legend / 10, 0.5)
+            max_x = max(max_x, legend_x + legend_width)
+            min_y = min(min_y, (-height / 2) - legend_depth)
+
+        return [min_x, max_x], [min_y, max_y]
+
+    def _altair_extent_layer(self, x_domain: list[float], y_domain: list[float], x_encoding: alt.X, y_encoding: alt.Y) -> alt.Chart:
