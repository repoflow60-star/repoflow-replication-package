+        data = [
+            {"x": x_domain[0], "y": y_domain[0]},
+            {"x": x_domain[1], "y": y_domain[1]},
+        ]
+        return alt.Chart(alt.Data(values=data)).mark_point(opacity=0).encode(x=x_encoding, y=y_encoding)
+
+    def _altair_rectangle_layer(self, x_encoding: alt.X, y_encoding: alt.Y) -> alt.Chart:
