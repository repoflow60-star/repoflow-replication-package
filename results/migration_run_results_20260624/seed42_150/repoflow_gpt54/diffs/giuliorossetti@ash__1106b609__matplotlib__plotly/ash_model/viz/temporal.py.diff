+
+class plt:
+    Axes = go.Figure
+
+
+def _get_figure(**kwargs: object) -> tuple:
+    fig = kwargs.get("ax")
+    if fig is None:
+        fig = go.Figure()
+    return fig, {k: v for k, v in kwargs.items() if k != "ax"}
+
+
+def _line_style(kwargs: dict) -> dict:
+    style = {
+        k: v
+        for k, v in kwargs.items()
+        if k in {"line", "marker", "mode", "name", "opacity", "showlegend"}
+    }
+    line = dict(style.get("line", {}))
+    marker = dict(style.get("marker", {}))
+
+    if "color" in kwargs:
+        line.setdefault("color", kwargs["color"])
+        marker.setdefault("color", kwargs["color"])
+    if "linewidth" in kwargs:
+        line.setdefault("width", kwargs["linewidth"])
+    if "markersize" in kwargs:
+        marker.setdefault("size", kwargs["markersize"])
+    if "alpha" in kwargs:
+        style.setdefault("opacity", kwargs["alpha"])
+    if "label" in kwargs:
+        style.setdefault("name", kwargs["label"])
+
+    if line:
+        style["line"] = line
+    if marker:
+        style["marker"] = marker
+    style.setdefault("mode", "lines")
+    return style
+
+
+def _kde_trace(values: list, name: str, kwargs: dict) -> go.Scatter:
+    x = np.linspace(-0.2, 1.2, 200)
+    if len(set(values)) > 1:
+        y = gaussian_kde(values)(x)
+    else:
+        center = values[0]
+        y = np.exp(-0.5 * ((x - center) / 0.05) ** 2)
+    trace_style = _line_style(kwargs)
+    trace_style.setdefault("name", name)
+    return go.Scatter(x=x, y=y, **trace_style)
 
 
