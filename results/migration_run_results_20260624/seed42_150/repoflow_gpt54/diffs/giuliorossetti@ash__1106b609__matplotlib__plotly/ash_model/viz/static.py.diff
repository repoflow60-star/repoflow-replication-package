 from ash_model.measures import *
+
+
+class plt:
+    Axes = go.Figure
+
+
+def _get_figure(**kwargs: object) -> tuple:
+    fig = kwargs.get("ax")
+    if fig is None:
+        fig = go.Figure()
+    return fig, {k: v for k, v in kwargs.items() if k != "ax"}
+
+
+def _scatter_style(kwargs: dict, markers: bool = True) -> dict:
+    style = {
+        k: v
+        for k, v in kwargs.items()
+        if k in {"line", "marker", "mode", "name", "opacity", "showlegend"}
+    }
+    line = dict(style.get("line", {}))
+    marker = dict(style.get("marker", {}))
+
+    if "color" in kwargs:
+        line.setdefault("color", kwargs["color"])
+        marker.setdefault("color", kwargs["color"])
+    if "linewidth" in kwargs:
+        line.setdefault("width", kwargs["linewidth"])
+    if "markersize" in kwargs:
+        marker.setdefault("size", kwargs["markersize"])
+    if "alpha" in kwargs:
+        style.setdefault("opacity", kwargs["alpha"])
+    if "label" in kwargs:
+        style.setdefault("name", kwargs["label"])
+
+    if line:
+        style["line"] = line
+    if marker:
+        style["marker"] = marker
+    style.setdefault("mode", "markers" if markers else "lines")
+    return style
+
+
+def _bar_style(kwargs: dict) -> dict:
+    style = {
+        k: v
+        for k, v in kwargs.items()
+        if k in {"marker", "name", "opacity", "showlegend", "width"}
+    }
+    marker = dict(style.get("marker", {}))
+
+    if "color" in kwargs:
+        marker.setdefault("color", kwargs["color"])
+    if "alpha" in kwargs:
+        style.setdefault("opacity", kwargs["alpha"])
+    if "label" in kwargs:
+        style.setdefault("name", kwargs["label"])
+    if marker:
+        style["marker"] = marker
+    return style
+
+
+def _apply_loglog(fig: go.Figure, loglog: bool) -> None:
+    if loglog:
+        fig.update_xaxes(type="log")
+        fig.update_yaxes(type="log")
 
 
