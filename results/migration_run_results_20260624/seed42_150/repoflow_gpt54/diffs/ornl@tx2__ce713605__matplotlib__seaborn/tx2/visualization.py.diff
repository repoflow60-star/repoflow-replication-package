+def _new_figure(figsize):
+    grid = sns.FacetGrid(
+        pd.DataFrame({"_facet": [0]}),
+        despine=False,
+        height=figsize[1],
+        aspect=figsize[0] / figsize[1],
+    )
+    fig = grid.figure
+    fig.set_size_inches(*figsize)
+    fig.patch.set_facecolor("white")
+    return fig, grid.ax
+
+
+def _new_facet_grid(facets, num_cols, total_width, panel_height):
+    facet_values = list(facets)
+    num_rows = math.ceil(len(facet_values) / num_cols)
+    grid = sns.FacetGrid(
+        pd.DataFrame({"_facet": facet_values}),
+        col="_facet",
+        col_order=facet_values,
+        col_wrap=num_cols,
+        despine=False,
+        sharex=False,
+        sharey=False,
+        height=panel_height,
+        aspect=total_width / (num_cols * panel_height),
+    )
+    grid.figure.set_size_inches(total_width, num_rows * panel_height)
+    grid.figure.patch.set_facecolor("white")
+    return grid
+
