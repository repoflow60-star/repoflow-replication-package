+class HTTPError(Exception):
+    """Raised when an HTTP response is unsuccessful."""
+
+
+class Response:
+    """Minimal response wrapper used by the pycurl transport."""
+
+    def __init__(
+        self,
+        *,
+        content: bytes,
+        headers: dict[str, str],
+        reason: str,
+        status_code: int,
+        url: str,
+    ) -> None:
+        self._content = content
+        self.headers = headers
+        self.reason = reason
+        self.status_code = status_code
+        self.url = url
+
+    @property
+    def content(self) -> bytes:
+        return self._content
+
+    @property
+    def text(self) -> str:
+        return self._content.decode("utf-8", errors="replace")
+
+    def json(self) -> Any:
+        return json.loads(self.text)
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            kind = "Server Error" if self.status_code >= 500 else "Client Error"
+            raise HTTPError(
+                f"{self.status_code} {kind}: {self.reason} for url: {self.url}"
+            )
+
+
+class _CurlRequest:
+    """Request object compatible with pycognito's auth hook."""
+
+    def __init__(
+        self,
+        method: str = "GET",
+        url: str = "",
+        *,
+        body: bytes | str | None = None,
+        headers: dict[str, str] | None = None,
+    ) -> None:
+        self.body = body
+        self.headers = {} if headers is None else headers
+        self.hooks: dict[str, list[Callable[..., Any]]] = {}
+        self.method = method
+        self.url = url
+
+    def register_hook(self, event: str, hook: Callable[..., Any]) -> None:
+        self.hooks.setdefault(event, []).append(hook)
+
+
+def _normalize_body(body: bytes | str | None) -> bytes | None:
+    if body is None or isinstance(body, bytes):
+        return body
+    return body.encode("utf-8")
+
+
+def _add_query_params(url: str, params: dict[str, Any]) -> str:
+    parts = urlsplit(url)
+    query = parse_qsl(parts.query, keep_blank_values=True)
+    query.extend((key, value) for key, value in params.items() if value is not None)
+    return urlunsplit(parts._replace(query=urlencode(query, doseq=True)))
+
+
+def _encode_body(
+    *, data: Any = None, headers: dict[str, str], json_body: Any = None
+) -> bytes | None:
+    if json_body is not None:
+        headers.setdefault("Content-Type", "application/json")
+        return json.dumps(json_body).encode("utf-8")
+    if data is None:
+        return None
+    if isinstance(data, bytes):
+        return data
+    if isinstance(data, str):
+        return data.encode("utf-8")
+    headers.setdefault("Content-Type", "application/x-www-form-urlencoded")
+    return urlencode(data, doseq=True).encode("utf-8")
+
+
+def _parse_headers(header_bytes: bytes) -> tuple[dict[str, str], str]:
+    headers: dict[str, str] = {}
+    reason = ""
+    for header_block in header_bytes.decode("iso-8859-1").split("\r\n\r\n"):
+        if not header_block.strip():
+            continue
+
+        lines = header_block.split("\r\n")
+        status_line = lines[0].strip()
+        if not status_line.startswith("HTTP/"):
+            continue
+
+        headers = {}
+        parts = status_line.split(" ", 2)
+        if len(parts) == 3:
+            reason = parts[2]
+        elif len(parts) == 2:
+            try:
+                reason = HTTPStatus(int(parts[1])).phrase
+            except ValueError:  # pragma: no cover
+                reason = ""
+        else:  # pragma: no cover
+            reason = ""
+
+        for line in lines[1:]:
+            if not line or ":" not in line:
+                continue
+            name, value = line.split(":", 1)
+            headers[name.strip()] = value.strip()
+
+    return headers, reason
+
+
+def _perform_request(
