+    if not reason:
+        try:
+            reason = HTTPStatus(status_code).phrase
+        except ValueError:  # pragma: no cover
+            reason = ""
+
+    return Response(
+        content=response_body.getvalue(),
+        headers=parsed_headers,
+        reason=reason,
+        status_code=status_code,
+        url=url,
+    )
