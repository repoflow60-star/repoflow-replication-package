+class PyCurlResponse(object):
+    def __init__(self, status_code, headers, content):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+        self.reason = http_responses.get(status_code, '')
+
+    def json(self):
+        return loads(self.content)
+
+
+class PyCurlSession(object):
+    def __init__(self):
+        self.auth = None
+        self.headers = {}
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        body = self._encode_body(data, request_headers)
+        body_buffer = BytesIO()
+        response_headers = {}
+
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.CUSTOMREQUEST, method.upper())
+            curl.setopt(pycurl.FOLLOWLOCATION, False)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            curl.setopt(pycurl.WRITEDATA, body_buffer)
+            curl.setopt(pycurl.HEADERFUNCTION,
+                        lambda header_line: self._handle_header(header_line, response_headers))
+
+            if timeout is not None:
+                curl.setopt(pycurl.TIMEOUT_MS, int(timeout * 1000))
+
+            if self.auth:
+                curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+                curl.setopt(pycurl.USERPWD, '%s:%s' % self.auth)
+
+            if request_headers.get('Accept-Encoding'):
+                curl.setopt(pycurl.ACCEPT_ENCODING, request_headers['Accept-Encoding'])
+
+            if request_headers:
+                curl.setopt(pycurl.HTTPHEADER,
+                            ['%s: %s' % (name, value) for name, value in request_headers.items()])
+
+            if body is not None:
+                if isinstance(body, str):
+                    body = body.encode('utf-8')
+                curl.setopt(pycurl.POSTFIELDS, body)
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        content = self._decode_body(body_buffer.getvalue(), response_headers)
+        return PyCurlResponse(status_code=status_code, headers=response_headers, content=content)
+
+    @staticmethod
+    def _encode_body(data, headers):
+        if data is None or isinstance(data, (bytes, str)):
+            return data
+        if not data:
+            return ''
+
+        content_type = headers.get('Content-Type', '')
+        if 'application/x-www-form-urlencoded' in content_type:
+            return urlencode(data)
+        if 'application/json' in content_type or not content_type:
+            return dumps(data)
+        try:
+            return urlencode(data)
+        except TypeError:
+            return data
+
+    @staticmethod
+    def _decode_body(body, headers):
+        if not body:
+            return ''
+
+        content_type = headers.get('Content-Type', '')
+        charset = 'utf-8'
+        if 'charset=' in content_type:
+            charset = content_type.split('charset=', 1)[1].split(';', 1)[0].strip()
+
+        return body.decode(charset, errors='replace')
+
+    @staticmethod
+    def _handle_header(header_line, response_headers):
+        header_text = header_line.decode('iso-8859-1')
+        if ':' in header_text:
+            name, value = header_text.split(':', 1)
+            response_headers[name.strip()] = value.strip()
+        return len(header_line)
 
 
