+    def tracked_start(self, *args, **kwargs):
+        result = original_start(self, *args, **kwargs)
+        _track_responses_mock(self)
+        return result
+
+    def tracked_stop(self, *args, **kwargs):
+        try:
+            return original_stop(self, *args, **kwargs)
+        finally:
