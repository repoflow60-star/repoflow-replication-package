@@ -1 +1,92 @@
-from .kling import VideoGen, ImageGen, BaseGen, call_for_daily_check, TaskStatus
+from http.cookiejar import Cookie, CookieJar
+from http.cookies import SimpleCookie
+
+import pycurl
+
+from .kling import BaseGen, ImageGen, TaskStatus, VideoGen, call_for_daily_check
+
+
+class CurlCookieJar(CookieJar):
+    def __init__(self) -> None:
+        super().__init__()
+        self._values: dict[str, str] = {}
+
+    def __getitem__(self, key: str) -> str:
+        return self._values[key]
+
+    def __len__(self) -> int:
+        return len(self._values)
+
+    def keys(self):
+        return self._values.keys()
+
+    def set_cookie(self, cookie: Cookie) -> None:
+        super().set_cookie(cookie)
+        self._values[cookie.name] = cookie.value
+
+
+def _build_cookie(name: str, value: str, domain: str, path: str) -> Cookie:
+    return Cookie(
+        version=0,
+        name=name,
+        value=value,
+        port=None,
+        port_specified=False,
+        domain=domain,
+        domain_specified=bool(domain),
+        domain_initial_dot=domain.startswith("."),
+        path=path,
+        path_specified=True,
+        secure=False,
+        expires=None,
+        discard=True,
+        comment=None,
+        comment_url=None,
+        rest={},
+        rfc2109=False,
+    )
+
+
+def _parse_cookie_string(cookie_string: str) -> tuple[CurlCookieJar, bool]:
+    parsed_cookie = SimpleCookie()
+    parsed_cookie.load(cookie_string)
+    cookiejar = CurlCookieJar()
+    is_cn = False
+    stored_cookies = []
+    curl = pycurl.Curl()
+
+    try:
+        curl.setopt(pycurl.COOKIEFILE, "")
+        for key, morsel in parsed_cookie.items():
+            if key.startswith("kuaishou"):
+                is_cn = True
+            curl.setopt(
+                pycurl.COOKIELIST,
+                f"Set-Cookie: {key}={morsel.value}; domain=klingai.local; path=/",
+            )
+        stored_cookies = curl.getinfo(pycurl.INFO_COOKIELIST) or []
+    finally:
+        curl.close()
+
+    for stored_cookie in stored_cookies:
+        if isinstance(stored_cookie, bytes):
+            stored_cookie = stored_cookie.decode("utf-8", errors="replace")
+        parts = stored_cookie.split("\t")
+        if len(parts) < 7:
+            continue
+        cookiejar.set_cookie(
+            _build_cookie(parts[5], parts[6], parts[0], parts[2])
+        )
+
+    if parsed_cookie and not len(cookiejar):
+        for key, morsel in parsed_cookie.items():
+            cookiejar.set_cookie(
+                _build_cookie(key, morsel.value, "klingai.local", "/")
+            )
+
+    return cookiejar, is_cn
+
+
+BaseGen.parse_cookie_string = staticmethod(_parse_cookie_string)
+
+__all__ = ["VideoGen", "ImageGen", "BaseGen", "call_for_daily_check", "TaskStatus"]
