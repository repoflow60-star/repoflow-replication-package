--- a/yarg/_http.py
+++ b/yarg/_http.py
@@ -0,0 +1,55 @@
+from twisted.internet import defer
+from twisted.internet.selectreactor import SelectReactor
+
+import treq
+
+
+class _HTTPResponse(object):
+
+    def __init__(self, status_code, reason, content):
+        self.status_code = status_code
+        self.reason = reason
+        self.content = content
+
+
+def _decode(value):
+    if hasattr(value, 'decode'):
+        return value.decode()
+    return value
+
+
+@defer.inlineCallbacks
+def _get(reactor, url):
+    response = yield treq.get(url, reactor=reactor)
+    content = yield treq.content(response)
+    return _HTTPResponse(response.code, _decode(response.phrase), content)
+
+
+def get(url):
+    reactor = SelectReactor()
+    result = []
+    failure = []
+
+    def stop_reactor():
+        if reactor.running:
+            reactor.stop()
+        else:
+            reactor.callWhenRunning(reactor.stop)
+
+    def on_success(response):
+        result.append(response)
+        stop_reactor()
+        return response
+
+    def on_failure(err):
+        failure.append(err)
+        stop_reactor()
+        return err
+
+    deferred = _get(reactor, url)
+    deferred.addCallbacks(on_success, on_failure)
+    reactor.run()
+
+    if failure:
+        failure[0].raiseException()
+    return result[0]
