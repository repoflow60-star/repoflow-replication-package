+def _wordcloud_to_image(cloud):
+    if hasattr(cloud, "to_array"):
+        return cloud.to_array()
+    return np.asarray(cloud)
+
+
+def _set_clean_figure_layout(fig, width=None, height=None):
+    fig.update_layout(
+        paper_bgcolor="white",
+        plot_bgcolor="white",
+        margin={"l": 20, "r": 20, "t": 60, "b": 20},
+        width=width,
+        height=height,
+    )
+    return fig
+
+
+def _hide_subplot_axes(fig, row=None, col=None):
+    fig.update_xaxes(visible=False, showticklabels=False, row=row, col=col)
+    fig.update_yaxes(visible=False, showticklabels=False, row=row, col=col)
+
+
+def _add_scatter_trace(
+    fig,
+    x,
+    y,
+    colors,
+    size,
+    opacity=1.0,
+    line_color=None,
+    line_width=0,
+    showlegend=False,
+    name=None,
+):
+    marker = {"size": size, "color": colors}
+    if line_color is not None and line_width > 0:
+        marker["line"] = {"color": line_color, "width": line_width}
+
+    fig.add_trace(
+        go.Scattergl(
+            x=x,
+            y=y,
+            mode="markers",
+            marker=marker,
+            opacity=opacity,
+            showlegend=showlegend,
+            name=name,
+        )
+    )
+
+
