 import OpenSSL
 from OpenSSL.crypto import X509
+
+if not hasattr(OpenSSL.crypto, 'PKCS12'):
+    from cryptography.hazmat.primitives.serialization import NoEncryption, pkcs12
+
+    class _PKCS12:
+        def __init__(self):
+            self._private_key = None
+            self._certificate = None
+
+        def set_privatekey(self, private_key):
+            self._private_key = private_key
+
+        def set_certificate(self, certificate):
+            self._certificate = certificate
+
+        def export(self):
+            return pkcs12.serialize_key_and_certificates(
+                name=None,
+                key=None if self._private_key is None else self._private_key.to_cryptography_key(),
+                cert=None if self._certificate is None else self._certificate.to_cryptography(),
+                cas=None,
+                encryption_algorithm=NoEncryption(),
+            )
+
+    OpenSSL.crypto.PKCS12 = _PKCS12
 
