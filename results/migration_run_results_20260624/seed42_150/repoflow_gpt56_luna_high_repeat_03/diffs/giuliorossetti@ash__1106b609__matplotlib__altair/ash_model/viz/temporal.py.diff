+def _mark_kwargs(kwargs, default_opacity=None, names=(), include_color=False):
+    mark_kwargs = {}
+    opacity = kwargs.get("alpha", default_opacity)
+    if opacity is not None:
+        mark_kwargs["opacity"] = opacity
+    for name in names:
+        if name in kwargs:
+            mark_kwargs[name] = kwargs[name]
+    if include_color and "color" in kwargs:
+        mark_kwargs["color"] = kwargs["color"]
+    return mark_kwargs
+
+
+def _chart_properties(kwargs):
+    return {
+        name: kwargs[name]
+        for name in ("width", "height", "title")
+        if name in kwargs
+    }
+
+
+def _color(field, kwargs):
+    if "color" in kwargs:
+        return alt.value(kwargs["color"])
+    return alt.Color(f"{field}:N")
 
 
