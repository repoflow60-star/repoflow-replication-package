     def __init__(self, **kwargs):
         self.accept_headers = kwargs.get('accept_headers', self.ACCEPT_HEADERS)
 
+    @staticmethod
+    def _request(method, url, **kwargs):
+        """Issue a urllib3 request using the options exposed by this library."""
+        allow_redirects = kwargs.pop('allow_redirects', True)
+        params = kwargs.pop('params', None)
+        auth = kwargs.pop('auth', None)
+        verify = kwargs.pop('verify', True)
+
+        if isinstance(kwargs.get('timeout'), tuple):
+            connect, read = kwargs['timeout']
+            kwargs['timeout'] = urllib3.util.Timeout(connect=connect,
+                                                     read=read)
+
+        if params:
+            parts = urlsplit(url)
+            query = urlencode(params, doseq=True)
+            if parts.query:
+                query = parts.query + '&' + query
+            url = urlunsplit((parts.scheme, parts.netloc, parts.path,
+                              query, parts.fragment))
+
+        if auth:
+            username, password = auth
+            headers = dict(kwargs.get('headers') or {})
+            if not any(name.lower() == 'authorization' for name in headers):
+                credentials = '{}:{}'.format(username, password).encode('utf-8')
+                headers['Authorization'] = 'Basic ' + base64.b64encode(
+                    credentials).decode('ascii')
+            kwargs['headers'] = headers
+
+        if 'data' in kwargs:
+            data = kwargs.pop('data')
+            if isinstance(data, (dict, list, tuple)):
+                data = urlencode(data, doseq=True)
+                headers = dict(kwargs.get('headers') or {})
+                if not any(name.lower() == 'content-type' for name in headers):
+                    headers['Content-Type'] = 'application/x-www-form-urlencoded'
+                kwargs['headers'] = headers
+            kwargs['body'] = data
+
+        http = HTTP if verify is not False else HTTP_NO_VERIFY
+        return http.request(method, url, redirect=allow_redirects, **kwargs)
+
+    @staticmethod
+    def _raise_for_status(response):
+        if response.status >= 400:
+            raise urllib3.exceptions.HTTPError(
+                'HTTP error {}'.format(response.status))
+
+    @staticmethod
+    def _response_text(response):
+        if isinstance(response.data, bytes):
+            return response.data.decode('utf-8')
+        return response.data
+
+    @staticmethod
+    def _response_links(response):
+        links = {}
+        for value in response.headers.get('link', '').split(','):
+            parts = [part.strip() for part in value.split(';')]
+            if not parts:
+                continue
+            url = parts[0].strip('<>')
+            for parameter in parts[1:]:
+                name, separator, relation = parameter.partition('=')
+                if separator and name.strip().lower() == 'rel':
+                    relations = relation.strip().strip('"').split()
+                    for rel in relations:
+                        links[rel] = {'url': url}
+        return links
+
