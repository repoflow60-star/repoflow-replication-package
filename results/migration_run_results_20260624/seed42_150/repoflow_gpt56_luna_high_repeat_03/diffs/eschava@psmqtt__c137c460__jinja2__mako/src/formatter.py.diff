+def _split_filters(expression: str) -> Tuple[str, ...]:
+    parts = []
+    start = 0
+    depth = 0
+    quote = ""
+    escaped = False
+
+    for i, char in enumerate(expression):
+        if quote:
+            if escaped:
+                escaped = False
+            elif char == "\\":
+                escaped = True
+            elif char == quote:
+                quote = ""
+        elif char in ("'", '"'):
+            quote = char
+        elif char in "([{":
+            depth += 1
+        elif char in ")]}":
+            depth -= 1
+        elif char == "|" and depth == 0:
+            parts.append(expression[start:i])
+            start = i + 1
+
+    parts.append(expression[start:])
+    return tuple(parts)
+
+
+def _mako_expression(expression: str) -> str:
+    parts = _split_filters(expression)
+    result = parts[0].strip()
+
+    for filter_expression in parts[1:]:
+        match = re.fullmatch(
+            r"([A-Za-z_][A-Za-z0-9_]*)(?:\((.*)\))?",
+            filter_expression.strip(),
+            re.DOTALL,
+        )
+        if match is None:
+            return result
+
+        name, arguments = match.groups()
+        call = "__formatter_filters[%r](%s" % (name, result)
+        if arguments:
+            call += ", " + arguments
+        result = call + ")"
+
+    return result
 
