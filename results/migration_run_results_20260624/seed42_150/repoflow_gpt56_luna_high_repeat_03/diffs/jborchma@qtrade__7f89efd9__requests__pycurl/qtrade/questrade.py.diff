+    def _request(
+        self,
+        method: str,
+        url: str,
+        params: Optional[Dict] = None,
+        data: Optional[Dict] = None,
+        json_data: Optional[Dict] = None,
+        timeout: Optional[int] = None,
+        include_headers: bool = True,
+    ) -> bytes:
+        """Send an HTTP request using the shared pycurl handle."""
+        if params:
+            query = urlencode(params, doseq=True)
+            url += ("&" if "?" in url else "?") + query
+
+        request_headers = []
+        if include_headers and self.headers:
+            request_headers.extend(
+                f"{header}: {value}" for header, value in self.headers.items()
+            )
+
+        body = None
+        if json_data is not None:
+            body = json_module.dumps(json_data).encode("utf-8")
+            request_headers.append("Content-Type: application/json")
+        elif data is not None:
+            if isinstance(data, dict):
+                body = urlencode(data, doseq=True).encode("utf-8")
+                request_headers.append("Content-Type: application/x-www-form-urlencoded")
+            else:
+                body = data.encode("utf-8") if isinstance(data, str) else data
+
+        response_body = io.BytesIO()
+        self.session.reset()
+        self.session.setopt(pycurl.URL, url)
+        self.session.setopt(pycurl.CUSTOMREQUEST, method.upper())
+        self.session.setopt(pycurl.FOLLOWLOCATION, 1)
+        self.session.setopt(pycurl.HTTPHEADER, request_headers)
+        self.session.setopt(pycurl.WRITEFUNCTION, response_body.write)
+        if timeout is not None:
+            self.session.setopt(pycurl.TIMEOUT, timeout)
+        if body is not None:
+            self.session.setopt(pycurl.POSTFIELDS, body)
+        self.session.perform()
+
+        status_code = self.session.getinfo(pycurl.RESPONSE_CODE)
+        if status_code >= 400:
+            raise RuntimeError(f"HTTP {status_code} error for URL: {url}")
+        return response_body.getvalue()
+
+    def _request_json(
+        self,
+        method: str,
+        url: str,
+        params: Optional[Dict] = None,
+        data: Optional[Dict] = None,
+        json_data: Optional[Dict] = None,
+        timeout: Optional[int] = None,
+        include_headers: bool = True,
+    ) -> Dict[str, Any]:
+        response_body = self._request(
+            method,
+            url,
+            params=params,
+            data=data,
+            json_data=json_data,
+            timeout=timeout,
+            include_headers=include_headers,
+        )
+        return json_module.loads(response_body.decode("utf-8"))
 
