 _GRAPHQL_API_URL = "https://apis.justwatch.com/graphql"
+
+
+def post(url: str, *, json: dict):
+    """Send a JSON POST request using urllib3."""
+    return urllib3.request(
+        "POST",
+        url,
+        body=_json.dumps(json).encode("utf-8"),
+        headers={"Content-Type": "application/json"},
+    )
+
+
+def _response_json(response) -> dict:
+    """Raise for an unsuccessful response and return its decoded JSON body."""
+    raise_for_status = getattr(response, "raise_for_status", None)
+    if raise_for_status is not None:
+        raise_for_status()
+    elif response.status >= 400:
+        raise urllib3.exceptions.HTTPError(f"HTTP request failed with status {response.status}")
+
+    response_json = getattr(response, "json", None)
+    if response_json is not None:
+        return response_json()
+    return _json.loads(response.data)
 
 
