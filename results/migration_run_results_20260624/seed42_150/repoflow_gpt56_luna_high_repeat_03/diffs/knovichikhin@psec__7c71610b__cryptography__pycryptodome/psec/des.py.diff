+def _same_des_key(left: bytes, right: bytes) -> bool:
+    return all(
+        (left_byte & 0xFE) == (right_byte & 0xFE)
+        for left_byte, right_byte in zip(left, right)
+    )
+
+
+def _new_cipher(
+    key: bytes, mode: int, iv: _typing.Optional[bytes] = None
+) -> _typing.Any:
+    cipher_module = _DES if len(key) == 8 else _DES3
+    cipher_key = key
+
+    if len(key) == 16 and _same_des_key(key[:8], key[8:]):
+        cipher_module = _DES
+        cipher_key = key[:8]
+    elif len(key) == 24:
+        if _same_des_key(key[:8], key[8:16]):
+            cipher_module = _DES
+            cipher_key = key[16:]
+        elif _same_des_key(key[8:16], key[16:]):
+            cipher_module = _DES
+            cipher_key = key[:8]
+
+    if iv is None:
+        return cipher_module.new(cipher_key, mode)
+    return cipher_module.new(cipher_key, mode, iv)
+
