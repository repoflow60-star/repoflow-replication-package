+def _http_request(url, method='GET', verify_ssl=True, timeout=None,
+                  headers=None, params=None, data=None,
+                  follow_redirects=True):
+    """Perform an HTTP request with pycurl and return its transfer data."""
+    if params:
+        query = urllib.parse.urlencode(params, doseq=True)
+        url = '{}{}{}'.format(url, '&' if '?' in url else '?', query)
+
+    body = io.BytesIO()
+    response_headers = {}
+
+    def capture_header(line):
+        line_length = len(line)
+        if isinstance(line, bytes):
+            line = line.decode('iso-8859-1')
+        line = line.rstrip('\r\n')
+        if line.startswith('HTTP/'):
+            # Redirects and interim responses precede the final headers.
+            response_headers.clear()
+        elif ':' in line:
+            name, value = line.split(':', 1)
+            response_headers[name.lower()] = value.strip()
+        return line_length
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, capture_header)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1 if follow_redirects else 0)
+        curl.setopt(pycurl.SSL_VERIFYPEER, 1 if verify_ssl else 0)
+        curl.setopt(pycurl.SSL_VERIFYHOST, 2 if verify_ssl else 0)
+        curl.setopt(pycurl.ACCEPT_ENCODING, '')
+
+        request_headers = []
+        header_names = set()
+        if headers:
+            for name, value in headers.items():
+                request_headers.append('{}: {}'.format(name, value))
+                header_names.add(name.lower())
+        # Match common HTTP client defaults. In particular, some spreadsheet
+        # endpoints reject calls without a user agent.
+        if 'user-agent' not in header_names:
+            request_headers.append('User-Agent: libhxl/5.2.2')
+        if 'accept' not in header_names:
+            request_headers.append('Accept: */*')
+        curl.setopt(pycurl.HTTPHEADER, request_headers)
+
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT, timeout)
+
+        method = method.upper()
+        if method == 'HEAD':
+            curl.setopt(pycurl.NOBODY, 1)
+            curl.setopt(pycurl.CUSTOMREQUEST, 'HEAD')
+        elif method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            if data is not None:
+                if isinstance(data, dict):
+                    data = urllib.parse.urlencode(data, doseq=True)
+                if isinstance(data, str):
+                    data = data.encode('utf-8')
+                curl.setopt(pycurl.POSTFIELDS, data)
+        elif method != 'GET':
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+        try:
+            curl.perform()
+        except pycurl.error as error:
+            # Keep the IOError-compatible failure contract of the old client.
+            raise IOError(str(error))
+
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        return {
+            'status_code': status_code,
+            'headers': response_headers,
+            'content': body.getvalue(),
+            'is_redirect': 300 <= status_code < 400,
+        }
+    finally:
+        curl.close()
+
+
+def _raise_http_error(response, url):
+    """Raise an IOError for an unsuccessful HTTP response."""
+    if response['status_code'] >= 400:
+        raise IOError('HTTP error {} for {}'.format(response['status_code'], url))
+
+
+def _json_content(response):
+    """Decode a JSON response body."""
+    return json.loads(response['content'].decode('utf-8'))
+
