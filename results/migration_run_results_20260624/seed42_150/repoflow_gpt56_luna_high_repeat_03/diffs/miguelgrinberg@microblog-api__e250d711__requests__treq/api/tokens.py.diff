+_treq_reactor_lock = threading.Lock()
+_treq_reactor_ready = threading.Event()
+_treq_reactor_started = False
+
+
+def _run_treq_reactor():
+    reactor.callWhenRunning(_treq_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _oauth2_request_json(method, url, **kwargs):
+    """Run a treq request while keeping the Flask endpoint synchronous."""
+    global _treq_reactor_started
+    if not reactor.running:
+        with _treq_reactor_lock:
+            if not reactor.running and not _treq_reactor_started:
+                _treq_reactor_started = True
+                threading.Thread(target=_run_treq_reactor, daemon=True).start()
+        _treq_reactor_ready.wait()
+
+    @defer.inlineCallbacks
+    def request():
+        request_method = treq.post if method == 'POST' else treq.get
+        response = yield defer.maybeDeferred(request_method, url, **kwargs)
+        status_code = getattr(response, 'status_code', None)
+        if status_code is None:
+            status_code = response.code
+        if status_code != 200:
+            if getattr(response, 'status_code', None) is None:
+                yield treq.content(response)
+            return status_code, None
+        response_json = getattr(response, 'json', None)
+        if callable(response_json):
+            body = yield defer.maybeDeferred(response_json)
+        else:
+            body = yield treq.json_content(response)
+        return status_code, body
+
+    return threads.blockingCallFromThread(reactor, request)
 
 
