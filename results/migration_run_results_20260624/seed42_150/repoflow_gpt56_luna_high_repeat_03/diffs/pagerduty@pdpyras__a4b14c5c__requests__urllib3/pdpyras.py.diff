+class APIResponse:
+    """Response interface used by the PagerDuty client."""
+
+    def __init__(self, response, method, url, elapsed):
+        self._response = response
+        self.status_code = response.status
+        self.headers = response.headers
+        self.content = response.data or b''
+        self.request = _Request(method, url)
+        self.url = url
+        self.elapsed = timedelta(seconds=elapsed)
+
+    @property
+    def ok(self):
+        return self.status_code < 400
+
+    @property
+    def text(self):
+        if isinstance(self.content, bytes):
+            return self.content.decode('utf-8', errors='replace')
+        return str(self.content)
+
+    def json(self):
+        return json.loads(self.text)
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
+
+class _Urllib3PoolManager(urllib3.PoolManager):
+    """Translate the session's request conveniences before using urllib3."""
+
+    def request(self, method, url, **kwargs):
+        headers = kwargs.pop('headers', HTTPHeaderDict())
+        if not isinstance(headers, HTTPHeaderDict):
+            headers = HTTPHeaderDict(headers)
+
+        params = kwargs.pop('params', None)
+        if params:
+            parts = urlsplit(url)
+            query = urlencode(params, doseq=True)
+            if parts.query:
+                query = parts.query + '&' + query
+            url = urlunsplit((parts.scheme, parts.netloc, parts.path,
+                query, parts.fragment))
+
+        kwargs.pop('stream', None)
+        if 'allow_redirects' in kwargs:
+            kwargs['redirect'] = kwargs.pop('allow_redirects')
+
+        json_present = 'json' in kwargs
+        json_body = kwargs.pop('json', None)
+        data_present = 'data' in kwargs
+        data_body = kwargs.pop('data', None)
+        if data_present and data_body:
+            if isinstance(data_body, dict):
+                data_body = urlencode(data_body, doseq=True)
+                if 'Content-Type' not in headers:
+                    headers['Content-Type'] = \
+                        'application/x-www-form-urlencoded'
+            kwargs['body'] = data_body
+        elif json_present and json_body is not None:
+            kwargs['body'] = json.dumps(json_body)
+            if 'Content-Type' not in headers:
+                headers['Content-Type'] = 'application/json'
+        elif data_present:
+            if isinstance(data_body, dict):
+                data_body = urlencode(data_body, doseq=True)
+            kwargs['body'] = data_body
+
+        return super(_Urllib3PoolManager, self).request(
+            method, url, headers=headers, **kwargs)
+
