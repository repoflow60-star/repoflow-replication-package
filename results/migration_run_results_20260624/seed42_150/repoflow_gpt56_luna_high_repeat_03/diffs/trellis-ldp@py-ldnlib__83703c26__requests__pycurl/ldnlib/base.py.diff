+                          parsed_url.path,
+                          '{}&{}'.format(existing_query, query)
+                          if existing_query else query,
+                          parsed_url.fragment))
+
+    curl_headers = []
+    for name, value in headers.items():
+        if isinstance(value, (tuple, list)):
