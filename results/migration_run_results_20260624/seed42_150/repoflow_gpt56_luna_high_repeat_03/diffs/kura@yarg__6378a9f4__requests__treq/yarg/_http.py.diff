--- a/yarg/_http.py
+++ b/yarg/_http.py
@@ -0,0 +1,21 @@
+# -*- coding: utf-8 -*-
+
+"""Synchronous bridge for treq's Deferred-based HTTP API."""
+
+from twisted.internet import defer
+from twisted.internet import reactor
+from twisted.internet import threads
+
+import treq
+
+
+@defer.inlineCallbacks
+def _request(url):
+    response = yield treq.get(url)
+    content = yield treq.content(response)
+    defer.returnValue((response, content))
+
+
+def get(url):
+    """Fetch *url* with treq while retaining yarg's synchronous API."""
+    return threads.blockingCallFromThread(reactor, _request, url)
