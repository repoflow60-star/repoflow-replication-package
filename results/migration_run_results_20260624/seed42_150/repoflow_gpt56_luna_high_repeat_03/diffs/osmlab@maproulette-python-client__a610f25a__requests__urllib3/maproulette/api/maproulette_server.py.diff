+    def _create_session(self):
+        """Create the urllib3 connection pool used by all API requests."""
+        pool_options = {
+            "cert_reqs": ssl.CERT_REQUIRED if self.verify else ssl.CERT_NONE,
+            "retries": False
+        }
+        if self.certs:
+            if isinstance(self.certs, tuple):
+                pool_options["cert_file"], pool_options["key_file"] = self.certs
+            else:
+                pool_options["cert_file"] = self.certs
+        return urllib3.PoolManager(**pool_options)
+
+    def _request_headers(self):
+        """Return headers in the form accepted by urllib3."""
+        return {key: value for key, value in self.headers.items() if value is not None}
+
+    def _request(self, method, endpoint, params=None, body=None, files=None):
+        """Send a request and translate transport failures to client exceptions."""
+        url = self.url + endpoint
+        if params:
+            if hasattr(params, "items"):
+                params = [(key, value) for key, value in params.items() if value is not None]
+            else:
+                params = [(key, value) for key, value in params if value is not None]
+            separator = '&' if '?' in url else '?'
+            url += separator + urlencode(params, doseq=True)
+
+        headers = self._request_headers()
+        request_body = None
+        if body is not None:
+            request_body = json.dumps(body).encode('utf-8')
+            headers['Content-Type'] = 'application/json'
+        elif files is not None:
+            request_body, content_type = encode_multipart_formdata(files)
+            headers['Content-Type'] = content_type
+
+        try:
+            return self.session.request(
+                method,
+                url,
+                body=request_body,
+                headers=headers
+            )
+        except urllib3.exceptions.HTTPError as error:
+            raise ConnectionUnavailableError(message=str(error)) from None
+
+    @staticmethod
+    def _response_text(response):
+        """Return an urllib3 response body as text."""
+        data = response.data
+        if isinstance(data, bytes):
+            return data.decode('utf-8', errors='replace')
+        return data
+
+    def _response(self, response):
+        """Return the public response shape used by the API methods."""
+        response_text = self._response_text(response)
+        try:
+            data = json.loads(response_text)
+        except (TypeError, ValueError):
+            data = response_text
+        return {
+            "data": data,
+            "status": response.status
+        }
+
+    def _raise_http_error(self, response, status_errors=None):
+        """Map an HTTP status to the client exception used by the public API."""
+        if response.status < 400:
+            return
+        status = response.status
+        message = self.parse_response_message(response)
+        error_type = (status_errors or {}).get(status, HttpError)
+        raise error_type(message=message, status=status) from None
 
