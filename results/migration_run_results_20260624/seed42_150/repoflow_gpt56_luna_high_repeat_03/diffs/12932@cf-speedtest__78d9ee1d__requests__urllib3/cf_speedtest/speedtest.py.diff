+def _request(method: str, url: str, **kwargs):
+    if method == 'GET':
+        try:
+            return REQ_SESSION.get(url, **kwargs)
+        except AttributeError:
+            pass
+    elif method == 'POST':
+        try:
+            return REQ_SESSION.post(url, **kwargs)
+        except AttributeError:
+            pass
+    return REQ_SESSION.request(method, url, **kwargs)
+
+
+def configure_http_session() -> None:
+    global REQ_SESSION
+
+    cert_reqs = 'CERT_REQUIRED' if VERIFY_SSL else 'CERT_NONE'
+    if PROXY_DICT:
+        proxy_url = PROXY_DICT['https']
+        if proxy_url.startswith('socks'):
+            REQ_SESSION = SOCKSProxyManager(proxy_url, cert_reqs=cert_reqs)
+        else:
+            REQ_SESSION = urllib3.ProxyManager(proxy_url, cert_reqs=cert_reqs)
+    else:
+        REQ_SESSION = urllib3.PoolManager(cert_reqs=cert_reqs)
+
+
+def raise_for_status(response) -> None:
+    status = response.status
+    if isinstance(status, int) and 400 <= status < 600:
+        raise urllib3.exceptions.HTTPError(f'{status} Server Error')
+
+
+def response_text(response) -> str:
+    data = response.data
+    if isinstance(data, (bytes, bytearray)):
+        return data.decode('utf-8')
+    return response.text
 
