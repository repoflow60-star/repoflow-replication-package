+class _HeaderMap(dict):
+    def get(self, key, default=None):
+        key = key.lower()
+        for name, value in self.items():
+            if name.lower() == key:
+                return value
+        return default
+
+
+class _TreqResult(object):
+    def __init__(self, response, content):
+        self.status_code = response.code
+        self.reason = response.phrase.decode('utf-8', 'replace') \
+            if isinstance(response.phrase, bytes) else response.phrase
+        self.headers = _HeaderMap({
+            name.decode('utf-8', 'replace') if isinstance(name, bytes) else name:
+            value.decode('utf-8', 'replace') if isinstance(value, bytes) else value[0]
+            for name, value in response.headers.getAllRawHeaders()
+        })
+        self._content = content
+
+    @property
+    def text(self):
+        return self._content.decode('utf-8', 'replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+
+def _run_reactor():
+    _reactor_ready.set()
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _reactor_started
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if not _reactor_started:
+            _reactor_started = True
+            Thread(target=_run_reactor, daemon=True).start()
+    _reactor_ready.wait()
+
+
+def _request(method, url, data, headers, timeout):
+    """Perform a treq request while retaining the package's sync API."""
+    _ensure_reactor()
+    complete = Event()
+    result = []
+
+    def succeeded(response):
+        def read_content(content):
+            try:
+                result.append(_TreqResult(response, content))
+            except Exception as error:
+                result.append(error)
+            complete.set()
+            return content
+
+        def content_failed(failure):
+            result.append(failure.value)
+            complete.set()
+            return failure
+
+        return treq.content(response).addCallbacks(read_content, content_failed)
+
+    def failed(failure):
+        result.append(failure.value)
+        complete.set()
+        return failure
+
+    def start_request():
+        try:
+            deferred = treq.request(
+                method, url, data=data, headers=headers, timeout=timeout)
+            deferred.addCallbacks(succeeded, failed)
+        except Exception as error:
+            result.append(error)
+            complete.set()
+
+    reactor.callFromThread(start_request)
+    complete.wait()
+    if isinstance(result[0], BaseException):
+        raise result[0]
+    return result[0]
 
 
