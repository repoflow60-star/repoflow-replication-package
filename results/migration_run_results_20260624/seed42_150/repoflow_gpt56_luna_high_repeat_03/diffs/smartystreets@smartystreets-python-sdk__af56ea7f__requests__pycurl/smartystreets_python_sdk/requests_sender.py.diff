+def build_url(url, params):
+    if not params:
+        return url
+
+    encoded_params = []
+    for key, value in params.items():
+        if value is None:
+            continue
+        if isinstance(value, (list, tuple)):
+            encoded_params.extend((key, item) for item in value if item is not None)
+        else:
+            encoded_params.append((key, value))
+
+    if not encoded_params:
+        return url
+    separator = '&' if '?' in url else '?'
+    return '{}{}{}'.format(url, separator, urlencode(encoded_params, doseq=True))
+
+
+def collect_header(header_lines):
+    def add_header(line):
+        header_lines.append(line)
+        return len(line)
+    return add_header
+
+
+def parse_response_headers(header_lines):
+    headers = {}
+    for line in header_lines:
+        if isinstance(line, bytes):
+            line = line.decode('iso-8859-1')
+        line = line.strip()
+        if not line or line.startswith('HTTP/') or ':' not in line:
+            continue
+        key, value = line.split(':', 1)
+        headers[key.strip()] = value.strip()
+    return headers
+
