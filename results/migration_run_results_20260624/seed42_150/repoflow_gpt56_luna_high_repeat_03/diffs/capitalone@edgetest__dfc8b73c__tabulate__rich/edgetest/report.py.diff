+def tabulate(rows: List[List[Any]], headers: List[str], tablefmt: str) -> str:
+    """Render a report table with Rich while preserving the legacy formats."""
+    string_rows = [[str(value) for value in row] for row in rows]
+    values = [headers, *string_rows]
+    if tablefmt == "rst":
+        widths = [
+            max(
+                len(headers[index]) + 2,
+                *(len(row[index]) for row in string_rows),
+            )
+            for index in range(len(headers))
+        ]
+    else:
+        widths = [
+            max(len(row[index]) for row in values)
+            for index in range(len(headers))
+        ]
+
+    padded_headers = [
+        header.ljust(width) for header, width in zip(headers, widths)
+    ]
+    padded_rows = [
+        [value.ljust(width) for value, width in zip(row, widths)]
+        for row in string_rows
+    ]
+    table = Table(
+        *padded_headers,
+        box=None,
+        padding=(0, 0),
+        pad_edge=False,
+        show_edge=False,
+        show_header=True,
+    )
+    for row in padded_rows:
+        table.add_row(*row)
+
+    console = Console(
+        file=StringIO(),
+        record=True,
+        color_system=None,
+        width=max(sum(widths), 1),
+    )
+    console.print(table, end="")
+    rendered_rows = console.export_text().splitlines()
+    rendered_rows = [
+        "  ".join(
+            rendered_row[start : start + width].rstrip().ljust(width)
+            for start, width in _column_slices(widths)
+        )
+        for rendered_row in rendered_rows
+    ]
+
+    if tablefmt == "rst":
+        separator = "  ".join("=" * width for width in widths)
+        return "\n".join(
+            [separator, *rendered_rows[:1], separator, *rendered_rows[1:], separator]
+        )
+
+    formatted_rows = ["| " + " | ".join(row) + " |" for row in rendered_rows]
+    separator = "|" + "|".join("-" * (width + 2) for width in widths) + "|"
+    return "\n".join([*formatted_rows[:1], separator, *formatted_rows[1:]])
+
+
+def _column_slices(widths: List[int]):
+    start = 0
+    for width in widths:
+        yield start, width
+        start += width
 
 
