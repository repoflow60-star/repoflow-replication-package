+def _run_treq_request(
+    method: str, url: str, timeout: Optional[float]
+) -> bytes:
+    reactor = SelectReactor()
+    result: List[Union[bytes, Failure]] = []
+
+    def finish(value: Any) -> Any:
+        result.append(value)
+        reactor.stop()
+        return value
+
+    def start() -> None:
+        try:
+            agent = Agent(reactor, contextFactory=ClientContextFactory())
+            treq.request(
+                method,
+                url,
+                timeout=timeout,
+                agent=agent,
+                reactor=reactor,
+            ).addCallback(treq.content).addBoth(finish)
+        except Exception as err:
+            finish(Failure(err))
+
+    reactor.callWhenRunning(start)
+    reactor.run()
+
+    response = result[0]
+    if isinstance(response, Failure):
+        response.raiseException()
+    assert isinstance(response, bytes)
+    return response
 
 
