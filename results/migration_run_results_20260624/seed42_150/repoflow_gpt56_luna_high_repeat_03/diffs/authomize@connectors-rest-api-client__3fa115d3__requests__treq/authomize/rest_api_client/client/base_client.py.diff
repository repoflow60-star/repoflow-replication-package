+_reactor_lock = Lock()
+_reactor_started = Event()
+
+
+def _start_reactor():
+    reactor.callWhenRunning(_reactor_started.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if not _reactor_started.is_set():
+            Thread(target=_start_reactor, daemon=True).start()
+    _reactor_started.wait()
+
+
+class _CompletedResponse:
+    def __init__(self, response, content: bytes, url: str):
+        self.status_code = response.code
+        self.headers = {
+            self._decode(name).lower(): ', '.join(
+                self._decode(value) for value in values
+            )
+            for name, values in response.headers.getAllRawHeaders()
+        }
+        self.url = url
+        self.content = content
+        self.text = self._decode(content)
+        self.reason = self._decode(response.phrase)
+        self.ok = self.status_code < 400
+
+    @staticmethod
+    def _decode(value):
+        if isinstance(value, bytes):
+            return value.decode('latin-1')
+        return value
+
+    def json(self):
+        return json.loads(self.content.decode('utf-8'))
+
+    def raise_for_status(self):
+        raise ClientError(
+            message={
+                'status_code': self.status_code,
+                'url': self.url,
+                'message': self.reason,
+                'raw': self.content,
+            },
+        )
+
