+                    params=params,
+                    data=body,
+                )
+
+                def read_content(response):
+                    content = treq.content(response)
+                    content.addCallback(
+                        lambda value: result.set_result(
+                            _CompletedResponse(response, value, url),
+                        ),
+                    )
+                    content.addErrback(
+                        lambda failure: result.set_exception(failure.value),
+                    )
+                    return response
+
+                deferred.addCallback(read_content)
+                deferred.addErrback(lambda failure: result.set_exception(failure.value))
+            except Exception as error:
+                result.set_exception(error)
+
+        reactor.callFromThread(request)
+        return result.result()
 
