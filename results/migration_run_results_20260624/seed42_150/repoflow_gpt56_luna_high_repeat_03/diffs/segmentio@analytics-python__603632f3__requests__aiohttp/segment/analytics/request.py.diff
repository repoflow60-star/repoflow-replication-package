+class _ResponseSnapshot(object):
+    """Keep the synchronous response interface after aiohttp closes it."""
+
+    def __init__(self, status, headers, reason, content):
+        self.status_code = status
+        self.headers = headers.copy()
+        self.reason = reason
+        self._content = content
+
+    def json(self):
+        return json.loads(self.text)
+
+    @property
+    def text(self):
+        return self._content.decode('utf-8', errors='replace')
+
+
+async def _post_async(url, data, headers, timeout, proxy=None):
+    request_timeout = timeout
+    if not isinstance(timeout, aiohttp.ClientTimeout):
+        request_timeout = aiohttp.ClientTimeout(total=timeout)
+
+    request_options = {
+        'data': data,
+        'headers': headers,
+        'timeout': request_timeout,
+    }
+    if proxy:
+        request_options['proxy'] = proxy
+
+    async with aiohttp.ClientSession() as session:
+        async with session.post(url, **request_options) as response:
+            content = await response.read()
+            return _ResponseSnapshot(
+                response.status,
+                response.headers,
+                response.reason,
+                content,
+            )
+
+
+def _run_async(function, *args, **kwargs):
+    """Run one aiohttp operation without changing the package's sync API."""
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(function(*args, **kwargs))
+
+    result = []
+    error = []
+
+    def run_in_thread():
+        try:
+            result.append(asyncio.run(function(*args, **kwargs)))
+        except BaseException as exc:
+            error.append(exc)
+
+    thread = threading.Thread(target=run_in_thread)
+    thread.start()
+    thread.join()
+    if error:
+        raise error[0]
+    return result[0]
+
+
+class _AiohttpSession(object):
+    def post(self, url, data=None, headers=None, timeout=None, proxy=None,
+             **kwargs):
+        return _run_async(
+            _post_async,
+            url,
+            data,
+            headers,
+            timeout,
+            proxy,
+        )
+
+
+_session = _AiohttpSession()
 
 
