+_REDIRECT_CODES = {301, 302, 303, 307, 308}
+
+
+def _run_treq(request):
+    """Run one treq request while retaining the package's synchronous API."""
+    reactor = SelectReactor()
+    result = []
+
+    def finished(value):
+        result.append(value)
+        if reactor.running:
+            reactor.stop()
+        return value
+
+    request(reactor).addBoth(finished)
+    if result:
+        reactor.callWhenRunning(reactor.stop)
+    reactor.run(installSignalHandlers=False)
+    value = result[0]
+    if isinstance(value, Failure):
+        value.raiseException()
+    return value
+
+
+def _fetch(url: str, verify: bool = True):
+    headers = Headers({
+        b"User-Agent": [
+            b"Mozilla/5.0 (Windows NT 6.1; WOW64; rv:12.0) "
+            b"Gecko/20100101 Firefox/12.0"
+        ]
+    })
+
+    def request(reactor):
+        client = None
+        if not verify:
+            agent = Agent(reactor, contextFactory=ClientContextFactory())
+            client = HTTPClient(agent)
+
+        def fetch(current_url, history):
+            if verify:
+                response = treq.get(
+                    current_url, headers=headers, timeout=5, reactor=reactor
+                )
+            else:
+                response = client.get(current_url, headers=headers).addTimeout(5, reactor)
+            return response.addCallback(
+                lambda response: handle_response(response, current_url, history)
+            )
+
+        def handle_response(response, current_url, history):
+            if response.code in _REDIRECT_CODES:
+                locations = response.headers.getRawHeaders(b"location")
+                if locations:
+                    location = locations[0]
+                    if isinstance(location, bytes):
+                        location = location.decode("latin-1")
+                    next_url = urljoin(current_url, location)
+                    if next_url != current_url:
+                        if len(history) >= 30:
+                            raise RuntimeError("Too many redirects")
+                        return treq.content(response).addTimeout(5, reactor).addCallback(
+                            lambda unused: fetch(next_url, history + [current_url])
+                        )
+
+            return treq.content(response).addTimeout(5, reactor).addCallback(
+                lambda content: (response, content, history, current_url)
+            )
+
+        return fetch(url, [])
+
+    return _run_treq(request)
 
 
