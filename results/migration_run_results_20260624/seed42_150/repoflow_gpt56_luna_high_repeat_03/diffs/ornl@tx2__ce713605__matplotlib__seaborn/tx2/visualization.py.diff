+def _new_figure(figsize, title=None):
+    """Create a seaborn-managed figure and return its grid and plotting axis."""
+    grid = sns.FacetGrid(
+        pd.DataFrame({"_facet": [title if title is not None else 0]}),
+        col="_facet",
+        height=figsize[1],
+        aspect=figsize[0] / figsize[1],
+    )
+    grid.set_titles("" if title is None else "{col_name}")
+    return grid, grid.axes.flat[0]
+
+
+def _new_subplot_grid(num_rows, num_cols, figsize, titles=None):
+    """Create a seaborn-managed grid with a stable two-dimensional axis shape."""
+    facet_titles = list(range(num_rows * num_cols))
+    if titles is not None:
+        facet_titles = [str(title) for title in titles]
+        facet_titles.extend([""] * (num_rows * num_cols - len(facet_titles)))
+    grid = sns.FacetGrid(
+        pd.DataFrame({"_facet": facet_titles}),
+        col="_facet",
+        col_wrap=num_cols,
+        col_order=facet_titles,
+        height=figsize[1] / num_rows,
+        aspect=(figsize[0] / num_cols) / (figsize[1] / num_rows),
+    )
+    grid.set_titles("" if titles is None else "{col_name}")
+    return grid, np.asarray(grid.axes).reshape(num_rows, num_cols)
+
