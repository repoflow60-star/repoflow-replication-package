+class _HTTPResponse:
+    """Synchronous response facade for the existing API methods."""
+
+    def __init__(self, status, headers, body):
+        self.status = status
+        self.headers = dict(headers)
+        self.data = body
+
+    def read(self):
+        return self.data
+
+    def getheaders(self):
+        return self.headers.items()
+
+    def close(self):
+        return None
+
+
+class _AiohttpHTTPClient:
+    """Synchronous adapter around aiohttp's asynchronous client."""
+
+    def __init__(self, timeout=60, ca_certs=None, cert_reqs=None, **kwargs):
+        if isinstance(timeout, (int, float)):
+            timeout = aiohttp.ClientTimeout(total=timeout)
+        elif timeout is None:
+            timeout = aiohttp.ClientTimeout(total=None)
+        self._timeout = timeout
+
+        if ca_certs is not None:
+            self._ssl = ssl.create_default_context(cafile=ca_certs)
+        elif cert_reqs == ssl.CERT_NONE:
+            self._ssl = False
+        elif cert_reqs == ssl.CERT_REQUIRED:
+            self._ssl = ssl.create_default_context()
+        else:
+            self._ssl = None
+
+        self._proxy = kwargs.pop("proxy", None)
+        self._proxy_auth = kwargs.pop("proxy_auth", None)
+
+    async def _request(self, method, url, fields, body, headers):
+        request_kwargs = {
+            "headers": headers,
+            "proxy": self._proxy,
+            "proxy_auth": self._proxy_auth,
+            "ssl": self._ssl,
+        }
+        if method in ("GET", "DELETE"):
+            request_kwargs["params"] = fields
+        elif body is not None:
+            if isinstance(body, array):
+                body = body.tobytes()
+            elif isinstance(body, (bytearray, memoryview)):
+                body = bytes(body)
+            elif hasattr(body, "read"):
+                body = body.read()
+            request_kwargs["data"] = body
+        else:
+            request_kwargs["data"] = fields
+
+        async with aiohttp.ClientSession(timeout=self._timeout) as session:
+            async with session.request(method, url, **request_kwargs) as response:
+                response_body = await response.read()
+                return _HTTPResponse(
+                    response.status, response.headers, response_body
+                )
+
+    def request(self, method, url, fields=None, body=None, headers=None, **kwargs):
+        coroutine = self._request(method, url, fields, body, headers)
+        try:
+            asyncio.get_running_loop()
+        except RuntimeError:
+            return asyncio.run(coroutine)
+
+        result = []
+        error = []
+
+        def run_request():
+            try:
+                result.append(asyncio.run(coroutine))
+            except BaseException as exception:
+                error.append(exception)
+
+        thread = threading.Thread(target=run_request)
+        thread.start()
+        thread.join()
+        if error:
+            raise error[0]
+        return result[0]
+
+    def close(self):
+        # Each request owns and closes its session before returning.
+        return None
+
+
