+def _http_request(method, url, verify_ssl=True, headers=None, timeout=None,
+                  fields=None, redirect=True):
+    """Make an HTTP request with the options used by the input API."""
+    request_headers = dict(headers or {})
+    request_args = {
+        'headers': request_headers,
+        'preload_content': True,
+        'decode_content': True,
+        'redirect': redirect,
+        # Avoid connection retries while retaining redirect handling.
+        'retries': urllib3.Retry(
+            total=None, connect=0, read=0, redirect=30, status=0
+        ),
+    }
+    if timeout is not None:
+        request_args['timeout'] = timeout
+    if fields is not None:
+        if method in ('GET', 'HEAD'):
+            request_args['fields'] = fields
+        else:
+            request_args['body'] = urllib.parse.urlencode(fields)
+            request_headers.setdefault(
+                'Content-Type', 'application/x-www-form-urlencoded'
+            )
+    try:
+        pool = urllib3.PoolManager(
+            cert_reqs=ssl.CERT_REQUIRED if verify_ssl else ssl.CERT_NONE
+        )
+        return pool.request(method, url, **request_args)
+    except urllib3.exceptions.HTTPError as error:
+        raise HXLIOException(str(error), url=url)
+
+
+def _raise_for_status(response, url=None):
+    """Raise the input API's IOError-compatible error for failed responses."""
+    if response.status >= 400:
+        raise HXLIOException(
+            'HTTP Error {}: {}'.format(response.status, response.reason),
+            url=url
+        )
 
