+
+class _TreqHeaders:
+    def __init__(self, headers):
+        self._headers = headers
+
+    def get(self, name, default=None):
+        if hasattr(self._headers, 'getRawHeaders'):
+            values = self._headers.getRawHeaders(name)
+        else:
+            values = self._headers.get(name)
+            if values is None:
+                values = self._headers.get(name.lower())
+
+        if not values:
+            return default
+
+        value = values[0] if isinstance(values, (list, tuple)) else values
+        return value.decode() if isinstance(value, bytes) else value
+
+
+class _TreqResult:
+    def __init__(self, response, body: bytes, url: str):
+        self.status_code = response.code
+        self.url = url
+        self.headers = _TreqHeaders(response.headers)
+        self.content = body
+
+    def json(self):
+        return jsonlib.loads(self.content)
+
+
+def _start_reactor():
+    global _reactor_thread
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is None:
+            _reactor_thread = threading.Thread(
+                target=reactor.run,
+                kwargs={'installSignalHandlers': False},
+                daemon=True,
+            )
+            _reactor_thread.start()
+
+
+def _sync_request(request_factory: Callable[[], Any], url: str):
+    result = []
+    completed = threading.Event()
+
+    def finish(value=None, failure=None):
+        if completed.is_set():
+            return
+        result.append(failure if failure is not None else value)
+        completed.set()
+
+    def on_response(response):
+        content = treq.content(response)
+
+        def on_content(body):
+            finish(_TreqResult(response, body, url))
+            return body
+
+        content.addCallback(on_content)
+        content.addErrback(lambda failure: finish(failure=failure))
+        return content
+
+    def request():
+        try:
+            response = request_factory()
+            if hasattr(response, 'addCallback'):
+                response.addCallback(on_response)
+                response.addErrback(lambda failure: finish(failure=failure))
+            else:
+                finish(response)
+        except Exception as error:
+            finish(failure=error)
+
+    _start_reactor()
+    reactor.callFromThread(request)
+    completed.wait()
+
+    value = result[0]
+    if hasattr(value, 'raiseException'):
+        value.raiseException()
+    if isinstance(value, BaseException):
+        raise value
+    return value
 
 
