+class _Expression:
+    """SQL text with enough metadata to retain compiler precedence rules."""
+
+    def __init__(self, sql, base_sql=None, precedence=100):
+        self.sql = sql
+        self.base_sql = sql if base_sql is None else base_sql
+        self.precedence = precedence
+
+    def __str__(self):
+        return self.sql
+
+    def label(self, name, quote):
+        return _Expression(
+            f'{self.sql} AS {quote(name)}', self.base_sql, self.precedence
+        )
+
+    def distinct(self):
+        return _Expression(f'DISTINCT {self.base_sql}', precedence=90)
+
+    def asc(self):
+        return _Expression(f'{self.base_sql} ASC', self.base_sql, 90)
+
+    def desc(self):
+        return _Expression(f'{self.base_sql} DESC', self.base_sql, 90)
 
 
