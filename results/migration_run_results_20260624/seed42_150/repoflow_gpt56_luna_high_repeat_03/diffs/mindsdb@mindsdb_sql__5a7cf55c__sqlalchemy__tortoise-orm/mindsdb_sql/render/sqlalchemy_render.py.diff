+    def _quote(self, value):
+        value = str(value)
+        if value == '*':
+            return value
+        if value.startswith('`') and value.endswith('`'):
+            value = value[1:-1]
+        if re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', value) and \
+                value.upper() not in self._reserved:
+            return value
+        mark = '`' if self.dialect.name == 'mysql' else '"'
+        return mark + value.replace(mark, mark + mark) + mark
 
