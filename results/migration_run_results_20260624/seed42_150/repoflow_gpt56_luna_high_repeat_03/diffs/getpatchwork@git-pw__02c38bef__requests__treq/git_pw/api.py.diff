+class _RequestException(Exception):
+    def __init__(
+        self,
+        message: str,
+        response: ty.Optional['_Response'] = None,
+    ):
+        super().__init__(message)
+        self.response = response
+
+
+class _ResponseHeaders:
+    def __init__(self, headers: Headers):
+        self._headers = headers
+
+    def get(
+        self,
+        name: str,
+        default: ty.Optional[str] = None,
+    ) -> ty.Optional[str]:
+        values = self._headers.getRawHeaders(name)
+        if not values:
+            return default
+        value = values[0]
+        return value.decode('latin-1') if isinstance(value, bytes) else value
+
+
+class _Response:
+    def __init__(self, response: ty.Any, content: bytes):
+        self.status_code = response.code
+        self.headers = _ResponseHeaders(response.headers)
+        self.content = content
+
+    def json(self) -> ty.Any:
+        return json.loads(self.content.decode('utf-8'))
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            raise _RequestException(
+                'HTTP request failed with status {}'.format(self.status_code),
+                self,
+            )
+
+    def iter_content(self, chunk_size: int) -> ty.Iterator[bytes]:
+        if chunk_size <= 0:
+            raise ValueError('chunk_size must be greater than zero')
+        for offset in range(0, len(self.content), chunk_size):
+            yield self.content[offset : offset + chunk_size]
+
+
+_reactor_ready = threading.Event()
+_reactor_lock = threading.Lock()
+_reactor_thread: ty.Optional[threading.Thread] = None
+
+
+def _reactor_main() -> None:
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor() -> None:
+    global _reactor_thread
+
+    with _reactor_lock:
+        if _reactor_thread is None:
+            _reactor_thread = threading.Thread(
+                target=_reactor_main,
+                name='git-pw-treq-reactor',
+                daemon=True,
+            )
+            _reactor_thread.start()
+
+    _reactor_ready.wait()
+
+
+@defer.inlineCallbacks
+def _request_async(
+    method: str,
+    url: str,
+    headers: Headers,
+    params: ty.Optional[Filters],
+    data: ty.Optional[bytes],
+) -> ty.Generator[ty.Any, ty.Any, _Response]:
+    response = yield treq.request(
+        method,
+        url,
+        headers=headers,
+        params=params,
+        data=data,
+    )
+    content = yield treq.content(response)
+    return _Response(response, content)
+
+
+def _request(
+    method: str,
+    url: str,
+    params: ty.Optional[Filters] = None,
+    data: ty.Optional[ty.List[ty.Tuple[str, ty.Any]]] = None,
+    optional_auth: bool = False,
+) -> _Response:
+    headers = _get_headers()
+    auth = _get_auth(optional=optional_auth)
+    if isinstance(auth, HTTPTokenAuth):
+        auth(headers)
+    elif auth:
+        headers['Authorization'] = auth
+
+    body = None
+    if data is not None:
+        headers['Content-Type'] = 'application/x-www-form-urlencoded'
+        body = urlencode(data, doseq=True).encode('utf-8')
+
+    request_headers = Headers()
+    for name, value in headers.items():
+        request_headers.addRawHeader(name, value)
+
+    _ensure_reactor()
+    try:
+        return threads.blockingCallFromThread(
+            reactor,
+            _request_async,
+            method,
+            url,
+            request_headers,
+            params,
+            body,
+        )
+    except _RequestException:
+        raise
+    except Exception as exc:
+        raise _RequestException(str(exc)) from exc
