+class _MountedRequest:
+    """Request data passed to a mounted transport."""
+
+    def __init__(self, method, url, headers, body):
+        self.method = method
+        self.url = url
+        self.headers = headers
+        self.body = body
+
+    @property
+    def path_url(self):
+        parsed = urlsplit(self.url)
+        path = parsed.path or "/"
+        if parsed.query:
+            path += "?" + parsed.query
+        return path
+
+    @property
+    def qs(self):
+        return parse_qs(urlsplit(self.url).query)
+
+    @property
+    def hostname(self):
+        return urlsplit(self.url).hostname
+
+    @property
+    def port(self):
+        return urlsplit(self.url).port
+
+    @property
+    def scheme(self):
+        return urlsplit(self.url).scheme
+
+
+class _CurlSession:
+    """Small pycurl session with support for mounted transports."""
+
+    def __init__(self, token):
+        self._token = token
+        self._curl = pycurl.Curl()
+        self._mounts = []
+
+    def mount(self, prefix, transport):
+        self._mounts.append((prefix, transport))
+
+    def request(self, method, url, payload=None, body=None):
+        method = method.upper()
+        if method == "GET" and payload:
+            separator = "&" if "?" in url else "?"
+            url = "{}{}{}".format(url, separator, urlencode(payload, doseq=True))
+
+        headers = {
+            "Authorization": "Bearer {token}".format(token=self._token),
+        }
+        if method == "POST":
+            headers["Content-Type"] = "application/json"
+
+        mounted = None
+        for prefix, transport in self._mounts:
+            if url.startswith(prefix) and (
+                mounted is None or len(prefix) > len(mounted[0])
+            ):
+                mounted = (prefix, transport)
+        if mounted is not None:
+            response = mounted[1].send(
+                _MountedRequest(method, url, headers, body)
+            )
+            content = getattr(response, "content", response)
+            if isinstance(content, str):
+                return content.encode("utf-8")
+            return content
+
+        response = BytesIO()
+        curl = self._curl
+        curl.reset()
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(
+            pycurl.HTTPHEADER,
+            ["{}: {}".format(name, value) for name, value in headers.items()],
+        )
+        curl.setopt(pycurl.WRITEFUNCTION, response.write)
+        if method == "GET":
+            curl.setopt(pycurl.HTTPGET, 1)
+        elif method == "POST":
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, body)
+        elif method == "DELETE":
+            curl.setopt(pycurl.CUSTOMREQUEST, "DELETE")
+        else:
+            raise ValueError("Unsupported HTTP method: {}".format(method))
+        curl.perform()
+        return response.getvalue()
+
+
