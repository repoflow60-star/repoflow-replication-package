+def _request(
+        method: str,
+        url: str,
+        headers=None,
+        data=None,
+        json_data=None,
+        timeout=None
+        ) -> Tuple[int, Optional[str], bytes]:
+    """Perform an aiohttp request without changing the module's sync API."""
+    async def request():
+        request_args = {}
+        if headers is not None:
+            request_args["headers"] = headers
+        if data is not None:
+            request_args["data"] = data
+        if json_data is not None:
+            request_args["json"] = json_data
+        if timeout is not None:
+            request_args["timeout"] = timeout
+        async with aiohttp.ClientSession() as session:
+            async with session.request(method, url, **request_args) as response:
+                return response.status, response.reason, await response.read()
+
+    return asyncio.run(request())
+
+
+def _download(url: str, headers, location: str, timeout: int) -> None:
+    """Stream an aiohttp response to disk without changing the sync API."""
+    async def download():
+        async with aiohttp.ClientSession() as session:
+            async with session.get(url, headers=headers, timeout=timeout) as response:
+                response.raise_for_status()
+                with open(location, 'wb') as write_stream:
+                    async for chunk in response.content.iter_chunked(8192):
+                        write_stream.write(chunk)
+
+    asyncio.run(download())
+
 
