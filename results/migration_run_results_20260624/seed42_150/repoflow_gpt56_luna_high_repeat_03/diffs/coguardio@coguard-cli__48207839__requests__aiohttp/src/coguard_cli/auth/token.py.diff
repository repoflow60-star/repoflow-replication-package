+def _request(method: str, url: str, data=None, timeout=None):
+    """Perform an aiohttp request without changing the token API's sync boundary."""
+    async def request():
+        request_args = {}
+        if data is not None:
+            request_args["data"] = data
+        if timeout is not None:
+            request_args["timeout"] = timeout
+        async with aiohttp.ClientSession() as session:
+            async with session.request(method, url, **request_args) as response:
+                return response.status, response.reason, await response.read()
+
+    return asyncio.run(request())
+
 
