+def _figure(kwargs):
+    figure = kwargs.get("ax")
+    if figure is None:
+        return go.Figure()
+    if not isinstance(figure, go.Figure):
+        raise TypeError("ax must be a plotly.graph_objects.Figure")
+    return figure
+
+
+def _trace_options(kwargs, label=None):
+    options = {}
+    label = label if label is not None else kwargs.get("label")
+    if label is not None:
+        options["name"] = label
+    if "color" in kwargs or "c" in kwargs:
+        options["line"] = {"color": kwargs.get("color", kwargs.get("c"))}
+    if isinstance(kwargs.get("line"), dict):
+        options["line"] = dict(kwargs["line"])
+    if "alpha" in kwargs:
+        options["opacity"] = kwargs["alpha"]
+    marker = kwargs.get("marker")
+    if isinstance(marker, dict):
+        options["marker"] = dict(marker)
+        options["mode"] = "lines+markers"
+    elif marker is not None:
+        options["marker"] = {
+            "symbol": {
+                ".": "circle",
+                "o": "circle",
+                "s": "square",
+                "^": "triangle-up",
+            }.get(marker, marker)
+        }
+        options["mode"] = "lines+markers"
+    if "linewidth" in kwargs or "lw" in kwargs:
+        options.setdefault("line", {})["width"] = kwargs.get(
+            "linewidth", kwargs.get("lw")
+        )
+    if "linestyle" in kwargs or "ls" in kwargs:
+        options.setdefault("line", {})["dash"] = {
+            "-": "solid",
+            "--": "dash",
+            "-.": "dashdot",
+            ":": "dot",
+        }.get(kwargs.get("linestyle", kwargs.get("ls")), "solid")
+    return options
 
 
