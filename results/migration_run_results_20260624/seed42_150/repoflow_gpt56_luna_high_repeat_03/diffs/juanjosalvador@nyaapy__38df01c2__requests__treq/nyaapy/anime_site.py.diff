-import requests
+import threading
+
+import treq
+from twisted.internet import reactor
+from twisted.internet.threads import blockingCallFromThread
+
 from nyaapy import torrent
 from nyaapy.parser import parse_nyaa, parse_single, parse_nyaa_rss
+
+
+_reactor_lock = threading.Lock()
+_reactor_started = threading.Event()
+_reactor_thread = None
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_started.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _reactor_thread
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if not reactor.running and _reactor_thread is None:
+            _reactor_thread = threading.Thread(target=_run_reactor, daemon=True)
+            _reactor_thread.start()
+
+    _reactor_started.wait()
+
+
+def _get_response_body(url, as_text=False):
+    def fetch():
+        deferred = treq.get(url)
+
+        def read_body(response):
+            if response.code >= 400:
+                raise RuntimeError(
+                    "HTTP request failed with status {}".format(response.code)
+                )
+            return response.text() if as_text else response.content()
+
+        return deferred.addCallback(read_body)
+
+    _ensure_reactor()
+    return blockingCallFromThread(reactor, fetch)
 
 
