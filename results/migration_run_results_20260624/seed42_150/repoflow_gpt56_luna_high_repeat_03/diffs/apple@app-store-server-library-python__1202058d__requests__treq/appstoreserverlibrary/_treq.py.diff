--- a/appstoreserverlibrary/_treq.py
+++ b/appstoreserverlibrary/_treq.py
@@ -0,0 +1,81 @@
+import threading
+from typing import Any, Dict, List, Optional, Tuple, Union
+
+import treq
+from twisted.internet import reactor
+
+
+_reactor_ready = threading.Event()
+_reactor_lock = threading.Lock()
+
+
+def _start_reactor() -> None:
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor() -> None:
+    if reactor.running:
+        _reactor_ready.set()
+        return
+    with _reactor_lock:
+        if not reactor.running and not _reactor_ready.is_set():
+            threading.Thread(target=_start_reactor, daemon=True).start()
+    if not _reactor_ready.wait(5):
+        raise RuntimeError("Unable to start the treq reactor")
+
+
+def _decode_header(value: Union[bytes, str]) -> str:
+    return value.decode("latin-1") if isinstance(value, bytes) else value
+
+
+def request(
+    method: str,
+    url: str,
+    params: Optional[Dict[str, Union[str, List[str]]]] = None,
+    headers: Optional[Dict[str, str]] = None,
+    json: Any = None,
+    data: Optional[bytes] = None,
+) -> Tuple[int, Dict[str, str], bytes]:
+    _ensure_reactor()
+    result = []
+    failure = []
+    complete = threading.Event()
+
+    def finish(response, body: bytes) -> None:
+        response_headers = {}
+        for name, values in response.headers.getAllRawHeaders():
+            response_headers[_decode_header(name).lower()] = _decode_header(values[0])
+        result.append((response.code, response_headers, body))
+        complete.set()
+
+    def failed(reason) -> None:
+        failure.append(reason.value if hasattr(reason, "value") else reason)
+        complete.set()
+
+    def start_request() -> None:
+        request_args = {
+            "method": method,
+            "url": url,
+            "params": params,
+            "headers": headers,
+        }
+        if data is not None:
+            request_args["data"] = data
+        elif json is not None:
+            request_args["json"] = json
+        try:
+            deferred = treq.request(**request_args)
+            deferred.addCallback(lambda response: treq.content(response).addCallback(
+                lambda body: finish(response, body)
+            ))
+            deferred.addErrback(failed)
+        except BaseException as error:
+            failure.append(error)
+            complete.set()
+
+    reactor.callFromThread(start_request)
+    complete.wait()
+    if failure:
+        raise failure[0]
+    return result[0]
