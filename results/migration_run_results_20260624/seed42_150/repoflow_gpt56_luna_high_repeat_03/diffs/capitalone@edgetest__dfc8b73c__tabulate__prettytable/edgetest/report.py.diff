+def _render_table(rows: List[List], headers: List[str], tablefmt: str) -> str:
+    """Render a table with PrettyTable while preserving the existing formats."""
+    table = PrettyTable()
+    table.field_names = headers
+    table.add_rows(rows)
+    table.set_style(MARKDOWN)
+
+    table_rows = [
+        [cell.strip() for cell in line[1:-1].split("|")]
+        for line in table.get_string().splitlines()
+        if line.startswith("|")
+    ]
+    data_rows = table_rows[2:]
+    widths = [len(header) + 2 for header in headers]
+    for row in data_rows:
+        widths = [max(width, len(cell)) for width, cell in zip(widths, row)]
+
+    if tablefmt == "github":
+        def format_row(row: List[str]) -> str:
+            return "|" + "|".join(
+                " " + cell.ljust(width - 1) for cell, width in zip(row, widths)
+            ) + "|"
+
+        separator = "|" + "|".join(
+            ":" + "-" * (width - 1) for width in widths
+        ) + "|"
+        return "\n".join(
+            [format_row(headers), separator]
+            + [format_row(row) for row in data_rows]
+        )
+
+    separator = "  ".join("=" * width for width in widths)
+    output = [
+        separator,
+        "  ".join(header.ljust(width) for header, width in zip(headers, widths)).rstrip(),
+        separator,
+    ]
+    if data_rows:
+        output.extend(
+            "  ".join(cell.ljust(width) for cell, width in zip(row, widths)).rstrip()
+            for row in data_rows
+        )
+        output.append(separator)
+    return "\n".join(output)
+
+
+tabulate = _render_table
 
 
