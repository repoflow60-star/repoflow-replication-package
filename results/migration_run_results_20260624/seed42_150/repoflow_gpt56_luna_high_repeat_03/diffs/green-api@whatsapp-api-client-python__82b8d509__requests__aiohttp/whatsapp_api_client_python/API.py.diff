+    ) -> _HttpResult:
+        files = arguments.pop("files", None)
+        payload = arguments.pop("data", None)
+        timeout = arguments.pop("timeout", None)
+
+        headers = dict(self.headers)
+        headers.update(arguments.pop("headers", None) or {})
+        arguments["headers"] = headers
+
+        if timeout is not None and not isinstance(timeout, aiohttp.ClientTimeout):
+            arguments["timeout"] = aiohttp.ClientTimeout(total=timeout)
+        elif timeout is not None:
+            arguments["timeout"] = timeout
+
+        for attempt in range(4):
+            attempt_arguments = dict(arguments)
+            if files:
+                if attempt:
+                    self.__rewind_files(files)
+                attempt_arguments["data"] = self.__form_data(payload, files)
+            elif payload is not None:
+                attempt_arguments["data"] = payload
+
+            try:
+                async with aiohttp.ClientSession() as session:
+                    async with session.request(
