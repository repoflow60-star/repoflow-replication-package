+class _CurlSession(object):
+    """Small session-compatible wrapper backed by libcurl."""
+
+    def __init__(self):
+        self.auth = None
+        self.headers = {}
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        body = BytesIO()
+        response_headers = BytesIO()
+        curl = pycurl.Curl()
+
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        options = [
+            (pycurl.URL, url),
+            (pycurl.CUSTOMREQUEST, method),
+            (pycurl.WRITEFUNCTION, body.write),
+            (pycurl.HEADERFUNCTION, response_headers.write),
+        ]
+        if timeout is not None:
+            options.append((pycurl.TIMEOUT, int(timeout)))
+        if request_headers:
+            options.append((pycurl.HTTPHEADER,
+                            ['%s: %s' % (key, value)
+                             for key, value in request_headers.items()]))
+        if self.auth:
+            options.extend([
+                (pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC),
+                (pycurl.USERPWD, '%s:%s' % self.auth),
+            ])
+        if data is not None:
+            content_type = next((value for key, value in request_headers.items()
+                                 if key.lower() == 'content-type'), '')
+            if isinstance(data, dict) and 'application/x-www-form-urlencoded' in content_type:
+                data = urlencode(data)
+            if isinstance(data, str):
+                data = data.encode('utf-8')
+            options.append((pycurl.POSTFIELDS, data))
+
+        try:
+            for option, value in options:
+                curl.setopt(option, value)
+            curl.perform()
+            status_code = int(curl.getinfo(pycurl.RESPONSE_CODE))
+        finally:
+            curl.close()
+
+        reason = ''
+        parsed_headers = {}
+        for line in response_headers.getvalue().splitlines():
+            line = line.decode('iso-8859-1')
+            if line.startswith('HTTP/'):
+                parts = line.split(' ', 2)
+                reason = parts[2] if len(parts) > 2 else ''
+                parsed_headers = {}
+            elif ':' in line:
+                key, value = line.split(':', 1)
+                parsed_headers[key] = value.lstrip()
+
+        return _CurlResult(status_code, reason, parsed_headers, body.getvalue())
 
 
