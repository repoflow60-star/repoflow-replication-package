+def _new_session() -> httpx.Client:
+    proxy = PROXY_DICT.get('https') if PROXY_DICT else None
+    return httpx.Client(
+        verify=VERIFY_SSL,
+        proxy=proxy,
+        timeout=None,
+        follow_redirects=True,
+    )
+
+
+def _get_session():
+    global REQ_SESSION, _OWN_SESSION, _SESSION_CONFIG
+
+    session_config = (VERIFY_SSL, PROXY_DICT.get('https') if PROXY_DICT else None)
+    if REQ_SESSION is None or (
+        REQ_SESSION is _OWN_SESSION and _SESSION_CONFIG != session_config
+    ):
+        if REQ_SESSION is not None and REQ_SESSION is _OWN_SESSION:
+            REQ_SESSION.close()
+        REQ_SESSION = _new_session()
+        _OWN_SESSION = REQ_SESSION
+        _SESSION_CONFIG = session_config
+    return REQ_SESSION
 
