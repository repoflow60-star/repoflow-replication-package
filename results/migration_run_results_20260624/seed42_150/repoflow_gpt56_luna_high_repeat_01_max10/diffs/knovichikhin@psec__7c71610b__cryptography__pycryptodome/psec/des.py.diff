+def _same_des_key(first: bytes, second: bytes) -> bool:
+    return all((left ^ right) & 0xFE == 0 for left, right in zip(first, second))
+
+
+def _new_cipher(
+    key: bytes,
+    mode: int,
+    iv: _typing.Optional[bytes] = None,
+) -> _typing.Any:
+    cipher_module = _DES
+    cipher_key = key
+
+    if len(key) != 8:
+        cipher_module = _DES3
+        # Use the equivalent DES key when the EDE chain collapses to DES.
+        if len(key) == 16 and _same_des_key(key[:8], key[8:]):
+            cipher_module = _DES
+            cipher_key = key[:8]
+        elif len(key) == 24:
+            key1, key2, key3 = key[:8], key[8:16], key[16:]
+            if _same_des_key(key1, key2):
+                cipher_module = _DES
+                cipher_key = key3
+            elif _same_des_key(key2, key3):
+                cipher_module = _DES
+                cipher_key = key1
+
+    if iv is None:
+        return cipher_module.new(cipher_key, mode)
+    return cipher_module.new(cipher_key, mode, iv)
+
