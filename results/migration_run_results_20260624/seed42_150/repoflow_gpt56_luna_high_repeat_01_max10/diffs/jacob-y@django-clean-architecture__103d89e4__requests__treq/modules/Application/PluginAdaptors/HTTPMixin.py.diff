+
+
+def _ensure_reactor() -> None:
+    global _reactor_thread
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if not reactor.running and (_reactor_thread is None or not _reactor_thread.is_alive()):
+            _reactor_thread = Thread(target=_run_reactor, name='treq-reactor', daemon=True)
+            _reactor_thread.start()
+
+    _reactor_ready.wait()
+
+
+def _wait_for(operation):
+    if _reactor_thread is not None and current_thread() is _reactor_thread:
+        raise RuntimeError('Synchronous HTTP cannot run on the treq reactor thread')
+
+    _ensure_reactor()
+    return blockingCallFromThread(reactor, operation)
 
 
