 from bigcommerce.exception import *
 
 log = logging.getLogger("bigcommerce.connection")
+
+
+class _HttpxSession(object):
+    """Keep the existing session surface while using an httpx client."""
+
+    def __init__(self, auth=None, headers=None):
+        self.auth = auth
+        self.headers = {} if headers is None else headers
+        self._client = httpx.Client(auth=auth)
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        request_headers = self.headers.copy()
+        if headers:
+            request_headers.update(headers)
+        return self._client.request(method, url, data=data, timeout=timeout,
+                                    headers=request_headers)
+
+    def close(self):
+        self._client.close()
 
 
