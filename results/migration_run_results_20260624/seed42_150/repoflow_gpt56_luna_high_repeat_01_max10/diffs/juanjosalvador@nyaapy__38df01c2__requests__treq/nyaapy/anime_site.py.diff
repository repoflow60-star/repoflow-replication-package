-import requests
+from threading import Event, Lock, Thread
+
+from twisted.internet import defer, reactor
+from twisted.internet.threads import blockingCallFromThread
+import treq
+
 from nyaapy import torrent
 from nyaapy.parser import parse_nyaa, parse_single, parse_nyaa_rss
+
+
+_reactor_lock = Lock()
+_reactor_ready = Event()
+_reactor_thread = None
+
+
+def _ensure_reactor():
+    global _reactor_thread
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is None:
+            def run_reactor():
+                reactor.callWhenRunning(_reactor_ready.set)
+                reactor.run(installSignalHandlers=False)
+
+            _reactor_thread = Thread(target=run_reactor, daemon=True)
+            _reactor_thread.start()
+
+    _reactor_ready.wait()
+
+
+def _get(url: str, *, text: bool = False):
+    """Perform a treq request while preserving the synchronous API."""
+    _ensure_reactor()
+
+    @defer.inlineCallbacks
+    def fetch():
+        response = yield treq.get(url, persistent=False)
+        if response.code >= 400:
+            raise RuntimeError(f"HTTP {response.code}: {response.phrase}")
+
+        if text:
+            body = yield response.text()
+        else:
+            body = yield response.content()
+        return body
+
+    return blockingCallFromThread(reactor, fetch)
 
 
