--- a/yarg/_http.py
+++ b/yarg/_http.py
@@ -0,0 +1,44 @@
+# -*- coding: utf-8 -*-
+
+import threading
+
+from twisted.internet import defer
+from twisted.internet import reactor
+from twisted.internet.threads import blockingCallFromThread
+import treq
+
+
+_reactor_lock = threading.Lock()
+_reactor_ready = threading.Event()
+
+
+def _run_reactor():
+    _reactor_ready.set()
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if reactor.running:
+            return
+        _reactor_ready.clear()
+        thread = threading.Thread(target=_run_reactor,
+                                  name='yarg-treq-reactor')
+        thread.daemon = True
+        thread.start()
+        _reactor_ready.wait()
+
+
+@defer.inlineCallbacks
+def _request(url):
+    response = yield treq.get(url)
+    content = yield treq.content(response)
+    return response, content
+
+
+def get(url):
+    """Perform a treq request while retaining yarg's synchronous API."""
+    _ensure_reactor()
+    return blockingCallFromThread(reactor, _request, url)
