+from twisted.internet.threads import blockingCallFromThread
+from twisted.web.client import ProxyAgent
 
 from fp.errors import FreeProxyException
+
+
+_reactor_lock = threading.Lock()
+_reactor_ready = threading.Event()
+_reactor_thread = None
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _reactor_thread
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if not reactor.running:
+            if _reactor_thread is None or not _reactor_thread.is_alive():
+                _reactor_ready.clear()
+                _reactor_thread = threading.Thread(
+                    target=_run_reactor, daemon=True)
+                _reactor_thread.start()
+    _reactor_ready.wait()
+
+
+def _request_content(url, **kwargs):
+    _ensure_reactor()
+
+    def request():
+        return treq.get(url, **kwargs).addCallback(
+            lambda response: response.content())
+
+    return blockingCallFromThread(reactor, request)
+
+
+def _proxy_agent(proxy_url):
+    proxy = urlsplit(proxy_url)
+    endpoint = HostnameEndpoint(reactor, proxy.hostname, proxy.port)
+    return ProxyAgent(reactor, endpoint)
 
 
