+def tabulate(rows: List[List], headers: List[str], tablefmt: str) -> str:
+    """Render a report table with PrettyTable."""
+    table = PrettyTable(headers)
+    table.add_rows(rows)
+    table.align = "l"
+
+    if tablefmt == "github":
+        table.set_style(TableStyle.MARKDOWN)
+        return table.get_string()
+
+    table.set_style(TableStyle.DEFAULT)
+    table.align = "l"
+    table.padding_width = 0
+    table.left_padding_width = 0
+    table.right_padding_width = 2
+    table.horizontal_char = "="
+
+    rendered_lines = table.get_string().splitlines()
+    content_lines = [
+        line for line in rendered_lines if not line.startswith("+")
+    ]
+    columns = [line.strip("|").split("|") for line in content_lines]
+    widths = [
+        max(
+            len(headers[index]) + 2,
+            max(len(row[index].strip()) for row in columns),
+        )
+        for index in range(len(headers))
+    ]
+    rule_indexes = [
+        index
+        for index, line in enumerate(rendered_lines)
+        if line.startswith("+") and line.endswith("+")
+    ]
+    if len(rule_indexes) > 2:
+        keep = {rule_indexes[0], rule_indexes[1], rule_indexes[-1]}
+        rendered_lines = [
+            line
+            for index, line in enumerate(rendered_lines)
+            if index not in rule_indexes or index in keep
+        ]
+
+    lines = []
+    for line in rendered_lines:
+        if line.startswith("+") and line.endswith("+"):
+            line = "  ".join("=" * width for width in widths)
+        else:
+            cells = line.strip("|").split("|")
+            line = "  ".join(
+                cell.strip().ljust(width)
+                for cell, width in zip(cells, widths)
+            ).rstrip()
+        lines.append(line)
+    return "\n".join(lines)
 
 
