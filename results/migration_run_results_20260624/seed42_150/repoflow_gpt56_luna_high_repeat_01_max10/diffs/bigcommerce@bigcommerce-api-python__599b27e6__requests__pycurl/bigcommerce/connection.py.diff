+class _PycurlResponse(object):
+    def __init__(self, status_code, headers, content, reason):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+        self.reason = reason
+
+    def json(self):
+        return loads(self.content.decode('utf-8'))
+
+
+class _PycurlSession(object):
+    """Provide the small session interface used by the connection classes."""
+
+    def __init__(self):
+        self.auth = None
+        self.headers = {}
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        body = BytesIO()
+        response_headers = {}
+        reason = ['']
+        curl = pycurl.Curl()
+
+        def capture_headers(value):
+            line = value.decode('iso-8859-1').strip()
+            if line.startswith('HTTP/'):
+                parts = line.split(' ', 2)
+                reason[0] = parts[2] if len(parts) == 3 else ''
+            elif ':' in line:
+                name, header_value = line.split(':', 1)
+                response_headers[name.strip()] = header_value.strip()
+            return len(value)
+
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            curl.setopt(pycurl.WRITEFUNCTION, body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, capture_headers)
+            curl.setopt(pycurl.ACCEPT_ENCODING, '')
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            if timeout is not None:
+                curl.setopt(pycurl.TIMEOUT, timeout)
+            if request_headers:
+                curl.setopt(pycurl.HTTPHEADER,
+                            ['%s: %s' % item for item in request_headers.items()])
+            if self.auth:
+                curl.setopt(pycurl.USERPWD, '%s:%s' % self.auth)
+                curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+
+            if data is not None:
+                if isinstance(data, dict):
+                    data = urlencode(data)
+                if isinstance(data, str):
+                    data = data.encode('utf-8')
+                curl.setopt(pycurl.POSTFIELDS, data)
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        return _PycurlResponse(status_code, response_headers, body.getvalue(), reason[0])
 
 
