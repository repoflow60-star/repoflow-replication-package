+_reactor_lock = threading.Lock()
+_reactor_ready = threading.Event()
+_reactor_thread = None
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _call_in_reactor(function):
+    global _reactor_thread
+
+    with _reactor_lock:
+        if _reactor_thread is None and not reactor.running:
+            _reactor_thread = threading.Thread(target=_run_reactor, daemon=True)
+            _reactor_thread.start()
+            _reactor_ready.wait()
+
+    return blockingCallFromThread(reactor, function)
+
+
+class _ResponseAdapter:
+    def __init__(self, response, content: bytes, url: str):
+        self.status_code = response.code
+        self.url = url
+        self.headers = {}
+        for name, values in response.headers.getAllRawHeaders():
+            if isinstance(name, bytes):
+                name = name.decode('ascii')
+            value = values[0]
+            if isinstance(value, bytes):
+                value = value.decode('utf-8')
+            self.headers[name] = value
+        self._content = content
+
+    def json(self):
+        return json_module.loads(self._content.decode('utf-8'))
+
+
+def _request(method, url, headers=None, json=None, agent=None):
+    request_headers = Headers({
+        name.encode('ascii'): [value.encode('utf-8')]
+        for name, value in (headers or {}).items()
+    })
+    body = None if json is None else json_module.dumps(json).encode('utf-8')
+
+    def request():
+        request_args = {
+            'headers': request_headers,
+            'data': body,
+            'reactor': reactor,
+        }
+        if agent is not None:
+            request_args['agent'] = agent
+
+        response_deferred = treq.request(method, url, **request_args)
+
+        def read_content(response):
+            return treq.content(response).addCallback(
+                lambda content: _ResponseAdapter(response, content, url)
+            )
+
+        return response_deferred.addCallback(read_content)
+
+    return _call_in_reactor(request)
+
+
+def get(url, headers=None, agent=None):
+    return _request('GET', url, headers=headers, agent=agent)
+
+
+def post(url, json=None, headers=None, agent=None):
+    return _request('POST', url, headers=headers, json=json, agent=agent)
 
 
