+class CurlRequest:
+    def __init__(self, url, params=None):
+        query = urlencode(params or {}, doseq=True)
+        if query:
+            separator = '&' if '?' in url else '?'
+            url = '{}{}{}'.format(url, separator, query)
+
+        self.url = url
+        self.headers = {}
+        self.method = 'GET'
+        self.data = None
+        self.body = None
+
+
+class CurlResult:
+    def __init__(self, text, status_code, headers):
+        self.text = text
+        self.status_code = status_code
+        self.headers = headers
+
+
+class CurlSession:
+    def send(self, request, timeout=None, proxies=None):
+        body = BytesIO()
+        response_headers = {}
+        curl = pycurl.Curl()
+
+        def receive_header(header):
+            if isinstance(header, bytes):
+                line = header.decode('iso-8859-1').strip()
+            else:
+                line = header.strip()
+            if line and not line.startswith('HTTP/') and ':' in line:
+                name, value = line.split(':', 1)
+                response_headers[name.strip()] = value.strip()
+            return len(header)
+
+        try:
+            curl.setopt(pycurl.URL, request.url)
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                ['{}: {}'.format(name, value) for name, value in request.headers.items()]
+            )
+            curl.setopt(pycurl.HEADERFUNCTION, receive_header)
+            curl.setopt(pycurl.WRITEDATA, body)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            if timeout is not None:
+                curl.setopt(pycurl.TIMEOUT, timeout)
+
+            if request.method == 'POST':
+                curl.setopt(pycurl.POST, 1)
+                post_data = request.body if request.body is not None else request.data
+                if isinstance(post_data, str):
+                    post_data = post_data.encode('utf-8')
+                curl.setopt(pycurl.POSTFIELDS, post_data or b'')
+            else:
+                curl.setopt(pycurl.HTTPGET, 1)
+
+            scheme = 'https' if request.url.lower().startswith('https://') else 'http'
+            proxy = (proxies or {}).get(scheme)
+            if proxy:
+                curl.setopt(pycurl.PROXY, proxy)
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            text = body.getvalue().decode('utf-8', errors='replace')
+            return CurlResult(text, status_code, response_headers)
+        finally:
+            curl.close()
+
+
+Session = CurlSession
 
 
