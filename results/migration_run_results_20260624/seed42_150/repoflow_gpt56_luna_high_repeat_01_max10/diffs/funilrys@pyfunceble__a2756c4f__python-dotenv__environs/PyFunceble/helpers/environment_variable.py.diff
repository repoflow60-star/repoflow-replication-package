+def _set_value_in_file(path: str, name: str, value: str) -> None:
+    """Set every assignment for ``name`` while preserving other file content."""
+
+    assignment = re.compile(rf"^\s*(?:export\s+)?{re.escape(name)}\s*=")
+    escaped_value = value.replace("'", "\\'")
+    value_line = f"{name}='{escaped_value}'\n"
+    lines = []
+    replaced = False
+
+    try:
+        with open(path, "r", encoding="utf-8") as file_stream:
+            for line in file_stream:
+                if assignment.match(line):
+                    if not replaced and lines and not lines[-1].endswith("\n"):
+                        lines.append("\n")
+                    lines.append(value_line)
+                    replaced = True
+                else:
+                    lines.append(line)
+    except FileNotFoundError:
+        pass
+
+    if not replaced:
+        if lines and not lines[-1].endswith("\n"):
+            lines.append("\n")
+        lines.append(value_line)
+
+    with open(path, "w", encoding="utf-8") as file_stream:
+        file_stream.writelines(lines)
+
+
+def _delete_value_from_file(path: str, name: str) -> None:
+    """Remove every assignment for ``name`` while preserving other file content."""
+
+    assignment = re.compile(rf"^\s*(?:export\s+)?{re.escape(name)}\s*=")
+
+    try:
+        with open(path, "r", encoding="utf-8") as file_stream:
+            lines = [
+                line for line in file_stream if not assignment.match(line)
+            ]
+    except FileNotFoundError:
+        return
+
+    with open(path, "w", encoding="utf-8") as file_stream:
+        file_stream.writelines(lines)
 
 
