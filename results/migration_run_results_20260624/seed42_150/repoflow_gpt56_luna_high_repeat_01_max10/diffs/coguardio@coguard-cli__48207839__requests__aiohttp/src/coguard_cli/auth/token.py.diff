+async def _request_async(method, url, timeout, data=None):
+    """Make an HTTP request and return its status, reason, and body."""
+    client_timeout = aiohttp.ClientTimeout(total=timeout)
+    async with aiohttp.ClientSession(timeout=client_timeout) as session:
+        async with session.request(method, url, data=data) as response:
+            return response.status, response.reason, await response.read()
+
+
+def _request(method, url, timeout, data=None):
+    """Run one aiohttp request while retaining the synchronous API."""
+    return asyncio.run(_request_async(method, url, timeout, data))
+
 
