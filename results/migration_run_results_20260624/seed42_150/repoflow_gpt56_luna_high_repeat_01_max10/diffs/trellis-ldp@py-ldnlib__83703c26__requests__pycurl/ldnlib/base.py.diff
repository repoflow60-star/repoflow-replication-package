+class _HTTPError(RuntimeError):
+    pass
+
+
+class _Response(object):
+
+    def __init__(self, status_code, headers, body):
+        self.status_code = status_code
+        self.headers = headers
+        self._body = body
+
+    @property
+    def content(self):
+        return self._body
+
+    @property
+    def text(self):
+        content_type = self.headers.get('content-type', '')
+        encoding = 'utf-8'
+        for value in content_type.split(';')[1:]:
+            if value.strip().lower().startswith('charset='):
+                encoding = value.split('=', 1)[1].strip(' \"')
+                break
+        return self._body.decode(encoding, errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+    @property
+    def links(self):
+        links = {}
+        for value in self.headers.get('link', '').split(','):
+            parts = [part.strip() for part in value.split(';')]
+            if not parts or not parts[0].startswith('<'):
+                continue
+            url = parts[0].strip('<>')
+            for part in parts[1:]:
+                if part.lower().startswith('rel='):
+                    relation = part.split('=', 1)[1].strip(' \"')
+                    for relation_name in relation.split():
+                        links[relation_name] = {'url': url}
+        return links
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise _HTTPError("HTTP error {}".format(self.status_code))
 
 
