+    def _request(
+        self,
+        method: str,
+        url: str,
+        params: Optional[Dict] = None,
+        data: Optional[Dict] = None,
+        json: Optional[Dict] = None,
+        request_headers: Optional[Dict] = None,
+    ) -> Any:
+        """Send an HTTP request through the pycurl handle."""
+        if params:
+            query = urlencode(params, doseq=True)
+            url += ("&" if "?" in url else "?") + query
+
+        response_body = io.BytesIO()
+        method = method.upper()
+        headers_source = self.headers if request_headers is None else request_headers
+        headers = [f"{key}: {value}" for key, value in (headers_source or {}).items()]
+
+        if json is not None:
+            payload = json_module.dumps(json).encode("utf-8")
+            headers.append("Content-Type: application/json")
+        elif data is not None:
+            if isinstance(data, dict):
+                payload = urlencode(data, doseq=True).encode("utf-8")
+                headers.append("Content-Type: application/x-www-form-urlencoded")
+            elif isinstance(data, str):
+                payload = data.encode("utf-8")
+            else:
+                payload = data
+        else:
+            payload = None
+
+        self.session.reset()
+        self.session.setopt(pycurl.URL, url)
+        self.session.setopt(pycurl.WRITEDATA, response_body)
+        self.session.setopt(pycurl.HTTPHEADER, headers)
+        self.session.setopt(pycurl.TIMEOUT, 30)
+        self.session.setopt(pycurl.FOLLOWLOCATION, 1)
+
+        if method == "GET":
+            self.session.setopt(pycurl.HTTPGET, 1)
+        elif method == "POST":
+            self.session.setopt(pycurl.POST, 1)
+        else:
+            self.session.setopt(pycurl.CUSTOMREQUEST, method)
+
+        if payload is not None:
+            self.session.setopt(pycurl.POSTFIELDS, payload)
+
+        self.session.perform()
+
+        status_code = self.session.getinfo(pycurl.RESPONSE_CODE)
+        if status_code >= 400:
+            raise RuntimeError(f"HTTP {status_code} response from {url}")
+
+        return json_module.loads(response_body.getvalue().decode("utf-8"))
 
