+class _HTTPError(IOError):
+    """HTTP failure retaining the historical IOError compatibility."""
+
+
+def _http_request(method, url, input_options, **kwargs):
+    """Make an HTTP request using the configured input options."""
+    kwargs.setdefault('headers', input_options.http_headers)
+    kwargs.setdefault('timeout', input_options.timeout)
+    kwargs.setdefault('preload_content', True)
+    kwargs.setdefault('decode_content', True)
+    kwargs.setdefault('redirect', True)
+
+    # Requests follows redirects without retrying failed connections or
+    # responses. Configure urllib3's retry policy to retain that distinction.
+    retries = urllib3.Retry(
+        total=30,
+        connect=0,
+        read=0,
+        redirect=30,
+        status=0,
+        backoff_factor=0
+    )
+    http = urllib3.PoolManager(
+        cert_reqs='CERT_REQUIRED' if input_options.verify_ssl else 'CERT_NONE',
+        retries=retries
+    )
+    try:
+        return http.request(method, url, **kwargs)
+    except urllib3.exceptions.HTTPError as error:
+        raise _HTTPError(str(error)) from error
+
+
+def _raise_for_status(response):
+    """Raise an IOError-compatible error for an unsuccessful response."""
+    if response.status >= 400:
+        raise _HTTPError('HTTP Error {}'.format(response.status))
+
+
+def _response_json(response):
+    """Decode a JSON response body."""
+    return json.loads(response.data)
 
