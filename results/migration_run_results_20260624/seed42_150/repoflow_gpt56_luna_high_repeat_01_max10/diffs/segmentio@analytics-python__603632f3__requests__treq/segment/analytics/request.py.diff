+class _Headers(dict):
+    def get(self, name, default=None):
+        for key, value in self.items():
+            if key.lower() == name.lower():
+                return value
+        return default
+
+
+class _CollectedResponse(object):
+    """Synchronous view of the response returned by treq."""
+
+    def __init__(self, response, body):
+        headers = _Headers()
+        for name, values in response.headers.getAllRawHeaders():
+            if values:
+                name = _as_text(name)
+                headers[name] = _as_text(values[-1])
+        self.status_code = response.code
+        self.headers = headers
+        self.reason = _as_text(response.phrase)
+        self._body = body
+
+    @property
+    def text(self):
+        return self._body.decode('utf-8', errors='replace')
+
+    def json(self):
+        return json.loads(self._body)
+
+
+def _as_text(value):
+    if isinstance(value, bytes):
+        return value.decode('latin-1')
+    return value
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _reactor_thread
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if not reactor.running and _reactor_thread is None:
+            _reactor_thread = Thread(target=_run_reactor, daemon=True)
+            _reactor_thread.start()
+    if not _reactor_ready.wait(5):
+        raise RuntimeError('Unable to start the Twisted reactor')
+
+
+def _treq_post(url, data, headers, timeout):
+    """Perform treq's asynchronous request without changing this API's sync boundary."""
+    _ensure_reactor()
+    completed = Event()
+    result = []
+
+    def failed(failure):
+        result.append(failure)
+        completed.set()
+        return failure
+
+    def received(response):
+        deferred = treq.content(response)
+
+        def collected(body):
+            result.append(_CollectedResponse(response, body))
+            completed.set()
+            return body
+
+        deferred.addCallback(collected)
+        deferred.addErrback(failed)
+        return deferred
+
+    def start_request():
+        try:
+            deferred = treq.post(
+                url,
+                data=data,
+                headers=headers,
+                timeout=timeout,
+            )
+            deferred.addCallback(received)
+            deferred.addErrback(failed)
+        except Exception:
+            failed(Failure())
+
+    reactor.callFromThread(start_request)
+    wait_timeout = timeout + 5 if timeout is not None else None
+    if not completed.wait(wait_timeout):
+        raise TimeoutError('Timed out waiting for treq response')
+    response = result[0]
+    if isinstance(response, Failure):
+        response.raiseException()
+    return response
 
 
