+def _render_table(rows: List[List[Any]], headers: List[str], tablefmt: str) -> str:
+    """Render report rows with Rich while retaining the report table formats."""
+    string_headers = [str(header) for header in headers]
+    string_rows = [[str(value) for value in row] for row in rows]
+
+    table = Table(box=None, padding=(0, 0), show_edge=False)
+    for header in string_headers:
+        table.add_column(Text(header))
+    for row in string_rows:
+        table.add_row(*(Text(value) for value in row))
+
+    # Render through Rich so its display-width handling determines the layout.
+    output = StringIO()
+    console = Console(
+        file=output,
+        width=10000,
+        force_terminal=False,
+        color_system=None,
+        markup=False,
+    )
+    console.print(table)
+
+    def cell_width(value: str) -> int:
+        return console.measure(Text(value)).maximum
+
+    # RST tables reserve two characters beyond each header; GitHub tables put
+    # that spacing outside the measured cells.
+    column_padding = 2 if tablefmt == "rst" else 0
+    column_widths = [cell_width(header) + column_padding for header in string_headers]
+    for row in string_rows:
+        for index, value in enumerate(row):
+            column_widths[index] = max(
+                column_widths[index], cell_width(value)
+            )
+
+    def format_row(row: List[str]) -> str:
+        values = []
+        for index, value in enumerate(row):
+            values.append(value + (" " * (column_widths[index] - cell_width(value))))
+        formatted = "  ".join(values) if tablefmt == "rst" else "| " + " | ".join(values) + " |"
+        return formatted.rstrip() if tablefmt == "rst" else formatted
+
+    if tablefmt == "rst":
+        separator = "  ".join("=" * width for width in column_widths)
+        lines = [separator, format_row(string_headers), separator]
+        if string_rows:
+            lines.extend(format_row(row) for row in string_rows)
+            lines.append(separator)
+        return "\n".join(lines)
+
+    separator = "|" + "|".join("-" * (width + 2) for width in column_widths) + "|"
+    return "\n".join(
+        [format_row(string_headers), separator]
+        + [format_row(row) for row in string_rows]
+    )
+
+
+# Keep the report module's callable seam stable for consumers that patch it.
+tabulate = _render_table
