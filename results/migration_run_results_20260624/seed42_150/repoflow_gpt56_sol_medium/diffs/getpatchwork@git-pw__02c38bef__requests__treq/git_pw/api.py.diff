+_REACTOR_READY = threading.Event()
+_REACTOR_LOCK = threading.Lock()
+
+
+class _Headers(dict):
+    def __getitem__(self, key):
+        return super().__getitem__(key.lower())
+
+    def get(self, key, default=None):
+        return super().get(key.lower(), default)
+
+
+class _Response:
+    def __init__(self, status_code: int, headers: _Headers, content: bytes):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+
+    def raise_for_status(self) -> None:
+        if 400 <= self.status_code < 600:
+            raise _HTTPError(self)
+
+    def json(self) -> ty.Any:
+        return json.loads(self.content.decode('utf-8'))
+
+    def iter_content(self, chunk_size: int) -> ty.Iterator[bytes]:
+        for offset in range(0, len(self.content), chunk_size):
+            yield self.content[offset : offset + chunk_size]
+
+
+class _HTTPError(Exception):
+    def __init__(self, response: _Response):
+        super().__init__(
+            'HTTP request failed with status {}'.format(response.status_code)
+        )
+        self.response = response
+
+
+def _run_reactor() -> None:
+    reactor.callWhenRunning(_REACTOR_READY.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor() -> None:
+    if reactor.running:
+        return
+
+    with _REACTOR_LOCK:
+        if not reactor.running and not _REACTOR_READY.is_set():
+            threading.Thread(target=_run_reactor, daemon=True).start()
+
+    _REACTOR_READY.wait()
+
+
+def _decode_header(value: ty.Union[str, bytes]) -> str:
+    if isinstance(value, bytes):
+        return value.decode('latin-1')
+    return value
+
+
+@inlineCallbacks
+def _request_async(request_method, url: str, kwargs: dict):
+    response = yield request_method(url, **kwargs)
+    content = yield treq.content(response)
+    headers = _Headers(
+        (
+            _decode_header(name).lower(),
+            ', '.join(_decode_header(value) for value in values),
+        )
+        for name, values in response.headers.getAllRawHeaders()
+    )
+    return _Response(response.code, headers, content)
+
+
+def _request(request_method, url: str, **kwargs) -> _Response:
+    _ensure_reactor()
+    return threads.blockingCallFromThread(
+        reactor, _request_async, request_method, url, kwargs
+    )
