+def request(method: str, url: str, body=None, headers=None):
+    request_method = getattr(REQ_SESSION, method.lower(), None)
+    if callable(request_method):
+        kwargs = {'verify': VERIFY_SSL, 'proxies': PROXY_DICT}
+        if body is not None:
+            kwargs['data'] = body
+        if headers is not None:
+            kwargs['headers'] = headers
+        return request_method(url, **kwargs)
+
+    return REQ_SESSION.request(method, url, body=body, headers=headers)
+
+
+def raise_for_status(response) -> None:
+    status = getattr(response, 'status', None)
+    if isinstance(status, int):
+        if 400 <= status < 600:
+            raise urllib3.exceptions.HTTPError(f'{status} response from {response.geturl()}')
+        return
+
+    response.raise_for_status()
+
+
+def response_data(response) -> bytes:
+    data = getattr(response, 'data', None)
+    if isinstance(data, bytes):
+        return data
+    return response.content
+
