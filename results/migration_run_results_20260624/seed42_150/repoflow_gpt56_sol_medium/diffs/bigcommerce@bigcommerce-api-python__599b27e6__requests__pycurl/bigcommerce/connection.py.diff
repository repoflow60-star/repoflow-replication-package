+class _CaseInsensitiveHeaders(dict):
+    def __getitem__(self, key):
+        key = key.lower()
+        for header, value in self.items():
+            if header.lower() == key:
+                return value
+        raise KeyError(key)
+
+    def __contains__(self, key):
+        key = key.lower()
+        return any(header.lower() == key for header in self)
+
+    def get(self, key, default=None):
+        try:
+            return self[key]
+        except KeyError:
+            return default
+
+    def add(self, key, value):
+        for header in self:
+            if header.lower() == key.lower():
+                dict.__setitem__(self, header, self[header] + ', ' + value)
+                return
+        dict.__setitem__(self, key, value)
+
+
+class _PycurlResponse(object):
+    def __init__(self, status_code, reason, headers, content):
+        self.status_code = status_code
+        self.reason = reason
+        self.headers = headers
+        self.content = content
+
+    def json(self):
+        return loads(self.content)
+
+
+class _PycurlSession(object):
+    def __init__(self):
+        self.auth = None
+        self.headers = {}
+        self._curl = pycurl.Curl()
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        body = BytesIO()
+        response_headers = _CaseInsensitiveHeaders()
+        reason = ['']
+
+        def receive_header(line):
+            text = line.decode('iso-8859-1').strip()
+            if text.startswith('HTTP/'):
+                response_headers.clear()
+                body.seek(0)
+                body.truncate()
+                parts = text.split(None, 2)
+                reason[0] = parts[2] if len(parts) == 3 else ''
+            elif ':' in text:
+                key, value = text.split(':', 1)
+                response_headers.add(key.strip(), value.strip())
+            return len(line)
+
+        request_headers = dict(self.headers)
+        for key, value in (headers or {}).items():
+            for existing in list(request_headers):
+                if existing.lower() == key.lower():
+                    del request_headers[existing]
+            request_headers[key] = value
+
+        curl = self._curl
+        curl.reset()
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.CUSTOMREQUEST, method.upper())
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, receive_header)
+        curl.setopt(pycurl.NOSIGNAL, True)
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT_MS, int(timeout * 1000))
+        if request_headers:
+            curl.setopt(pycurl.HTTPHEADER,
+                        ['{}: {}'.format(key, value) for key, value in request_headers.items()])
+        accept_encoding = next((value for key, value in request_headers.items()
+                                if key.lower() == 'accept-encoding'), None)
+        if accept_encoding:
+            curl.setopt(pycurl.ENCODING, accept_encoding)
+        if self.auth:
+            curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+            curl.setopt(pycurl.USERPWD, '{}:{}'.format(*self.auth))
+        if data is not None:
+            if isinstance(data, (dict, list, tuple)):
+                data = urlencode(data, doseq=True)
+            if not isinstance(data, bytes):
+                data = data.encode('utf-8')
+            curl.setopt(pycurl.POSTFIELDS, data)
+        curl.perform()
+        return _PycurlResponse(curl.getinfo(pycurl.RESPONSE_CODE), reason[0],
+                               response_headers, body.getvalue())
 
 
