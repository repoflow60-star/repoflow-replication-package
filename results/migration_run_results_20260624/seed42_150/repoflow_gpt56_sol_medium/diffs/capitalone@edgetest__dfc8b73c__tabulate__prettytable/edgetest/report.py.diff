+def tabulate(rows: List[List], headers: List[str], tablefmt: str) -> str:
+    """Render supported report formats using PrettyTable's table model."""
+    table = PrettyTable(headers)
+    table.add_rows(rows)
+
+    values = table.rows
+    numeric_columns = []
+    for index in range(len(table.field_names)):
+        cells = [row[index] for row in values if row[index] not in (None, "")]
+        try:
+            numeric_columns.append(
+                bool(cells)
+                and not any(isinstance(cell, bool) for cell in cells)
+                and all(float(cell) or float(cell) == 0 for cell in cells)
+            )
+        except (TypeError, ValueError):
+            numeric_columns.append(False)
+
+    text_rows = [
+        ["" if cell is None else str(cell) for cell in row] for row in values
+    ]
+    columns = list(zip(*text_rows)) if text_rows else [[] for _ in table.field_names]
+    widths = [
+        max(len(str(header)) + 2, *(len(cell) for cell in column))
+        for header, column in zip(table.field_names, columns)
+    ]
+
+    def render_row(row: List[str], separator: str, edge: str = "") -> str:
+        cells = []
+        for value, width, numeric in zip(row, widths, numeric_columns):
+            aligned = value.rjust(width) if numeric else value.ljust(width)
+            cells.append(f" {aligned} ")
+        return f"{edge}{separator.join(cells)}{edge}"
+
+    header = [str(field) for field in table.field_names]
+    if tablefmt == "github":
+        rule = "|" + "|".join("-" * (width + 2) for width in widths) + "|"
+        return "\n".join(
+            [render_row(header, "|", "|"), rule]
+            + [render_row(row, "|", "|") for row in text_rows]
+        )
+
+    rule = "  ".join("=" * width for width in widths)
+
+    def render_rst_row(row: List[str]) -> str:
+        cells = []
+        for value, width, numeric in zip(row, widths, numeric_columns):
+            aligned = value.rjust(width) if numeric else value.ljust(width)
+            cells.append(aligned)
+        return "  ".join(cells).rstrip()
+
+    return "\n".join(
+        [rule, render_rst_row(header), rule]
+        + [render_rst_row(row) for row in text_rows]
+        + [rule]
+    )
 
 
