 _LOGGING = logging.getLogger(__name__)
+
+_REACTOR = SelectReactor()
+_REACTOR_READY = threading.Event()
+_REACTOR_LOCK = threading.Lock()
+
+
+def _run_reactor() -> None:
+    _REACTOR.callWhenRunning(_REACTOR_READY.set)
+    _REACTOR.run(installSignalHandlers=False)
+
+
+def _ensure_reactor_running() -> None:
+    if _REACTOR_READY.is_set():
+        return
+
+    with _REACTOR_LOCK:
+        if not _REACTOR_READY.is_set():
+            threading.Thread(target=_run_reactor, daemon=True).start()
+    _REACTOR_READY.wait()
 
 
