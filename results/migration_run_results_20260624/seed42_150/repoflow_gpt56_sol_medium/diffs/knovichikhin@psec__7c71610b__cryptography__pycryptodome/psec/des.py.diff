+def _new_tdes_cipher(
+    key: bytes, iv: _typing.Optional[bytes] = None
+) -> _typing.Any:
+    cipher_key = key
+    use_des = len(key) == 8
+
+    if len(key) in {16, 24}:
+        components = [key[i : i + 8] for i in range(0, len(key), 8)]
+        effective = [bytes(byte & 0xFE for byte in part) for part in components]
+
+        # DES3 rejects keys that reduce to DES, while the previous provider
+        # accepted them (including all 8-byte keys).
+        if effective[0] == effective[1]:
+            use_des = True
+            cipher_key = components[-1]
+        elif len(key) == 24 and effective[1] == effective[2]:
+            use_des = True
+            cipher_key = components[0]
+
+    if use_des:
+        if iv is None:
+            return _DES.new(cipher_key, _DES.MODE_ECB)
+        return _DES.new(cipher_key, _DES.MODE_CBC, iv=iv)
+
+    if iv is None:
+        return _DES3.new(cipher_key, _DES3.MODE_ECB)
+
+    return _DES3.new(cipher_key, _DES3.MODE_CBC, iv=iv)
+
