+def _subplots(nrows=1, ncols=1, figsize=(8, 5)):
+    """Create a predictably shaped set of axes through seaborn."""
+    panel_count = nrows * ncols
+    panel_height = figsize[1] / nrows
+    panel_width = figsize[0] / ncols
+    grid = sns.FacetGrid(
+        pd.DataFrame({"_panel": range(panel_count)}),
+        col="_panel",
+        col_wrap=ncols,
+        height=panel_height,
+        aspect=panel_width / panel_height,
+        despine=False,
+    )
+    fig = grid.fig
+    fig.set_size_inches(*figsize)
+    axs = np.asarray(grid.axes).reshape(nrows, ncols)
+    for ax in axs.flat:
+        ax.set_title("")
+
+    if panel_count == 1:
+        return fig, axs[0, 0]
+    return fig, axs
+
+
+def _scatter(ax, x, y, **kwargs):
+    """Draw a scatter layer with seaborn using the existing plot options."""
+    x = np.atleast_1d(x)
+    y = np.atleast_1d(y)
+    if "c" in kwargs:
+        colors = np.asarray(kwargs.pop("c"))
+        if len(x) == 0:
+            pass
+        elif colors.ndim == 0:
+            kwargs["color"] = colors.item()
+        elif len(colors) == len(x):
+            hue = np.arange(len(x))
+            kwargs.update(
+                hue=hue,
+                hue_order=hue,
+                palette=dict(zip(hue, colors.tolist())),
+                legend=False,
+            )
+        else:
+            kwargs["color"] = colors
+    return sns.scatterplot(x=x, y=y, ax=ax, **kwargs)
+
