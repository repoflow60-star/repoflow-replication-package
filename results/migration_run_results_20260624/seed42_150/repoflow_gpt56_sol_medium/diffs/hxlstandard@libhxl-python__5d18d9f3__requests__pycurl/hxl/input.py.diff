+def _http_request(url, method='GET', verify_ssl=True, headers=None,
+                  timeout=None, params=None, data=None,
+                  follow_redirects=True):
+    """Make an HTTP request and return its status, headers, and body."""
+    if params:
+        query = urllib.parse.urlencode(params, doseq=True)
+        separator = '&' if urllib.parse.urlparse(url).query else '?'
+        url = '{}{}{}'.format(url, separator, query)
+
+    body = io.BytesIO()
+    response_headers = {}
+
+    def receive_header(line):
+        text = line.decode('iso-8859-1').strip()
+        if text.startswith('HTTP/'):
+            # Redirect and proxy headers precede the final response headers.
+            response_headers.clear()
+        elif ':' in text:
+            name, value = text.split(':', 1)
+            response_headers[name.strip().lower()] = value.strip()
+        return len(line)
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, receive_header)
+        curl.setopt(pycurl.FOLLOWLOCATION, bool(follow_redirects))
+        curl.setopt(pycurl.MAXREDIRS, 30)
+        curl.setopt(pycurl.SSL_VERIFYPEER, bool(verify_ssl))
+        curl.setopt(pycurl.SSL_VERIFYHOST, 2 if verify_ssl else 0)
+        curl.setopt(pycurl.ACCEPT_ENCODING, '')
+        if headers:
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                ['{}: {}'.format(name, value) for name, value in headers.items()]
+            )
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT_MS, int(float(timeout) * 1000))
+        if method == 'HEAD':
+            curl.setopt(pycurl.NOBODY, True)
+        elif method == 'POST':
+            curl.setopt(pycurl.POST, True)
+            curl.setopt(pycurl.POSTFIELDS, urllib.parse.urlencode(data or {}, doseq=True))
+        curl.perform()
+        status = curl.getinfo(pycurl.RESPONSE_CODE)
+    except pycurl.error as error:
+        raise HXLIOException("Unable to open URL {}: {}".format(url, error), url=url)
+    finally:
+        curl.close()
+
+    return status, response_headers, body.getvalue()
+
+
+def _raise_for_http_status(status, url):
+    if 400 <= status < 600:
+        raise HXLIOException('HTTP error {} for {}'.format(status, url), url=url)
+
+
+def _decode_json(body):
+    return json.loads(body)
 
 
