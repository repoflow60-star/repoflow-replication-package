+    def _request(self, method, url, params=None, headers=None, body=None):
+        if params:
+            parts = urlsplit(url)
+            query = urlencode(
+                [(key, value) for key, value in params.items() if value is not None],
+                doseq=True,
+            )
+            if parts.query and query:
+                query = f'{parts.query}&{query}'
+            elif parts.query:
+                query = parts.query
+            url = urlunsplit((parts.scheme, parts.netloc, parts.path, query, parts.fragment))
+
+        response_body = BytesIO()
+        response_headers = {}
+        reason = ''
+
+        def receive_header(line):
+            nonlocal reason
+            decoded = line.decode('iso-8859-1').strip()
+            if decoded.startswith('HTTP/'):
+                response_headers.clear()
+                status = decoded.split(' ', 2)
+                reason = status[2] if len(status) == 3 else ''
+            elif ':' in decoded:
+                name, value = decoded.split(':', 1)
+                response_headers[name.lower()] = value.strip()
+            return len(line)
+
+        request_headers = {'Authorization': self.authorization_header}
+        if headers:
+            request_headers.update(headers)
+
+        self.session.reset()
+        self.session.setopt(pycurl.URL, url)
+        self.session.setopt(pycurl.CUSTOMREQUEST, method)
+        self.session.setopt(
+            pycurl.HTTPHEADER,
+            [f'{name}: {value}' for name, value in request_headers.items()],
+        )
+        self.session.setopt(pycurl.WRITEFUNCTION, response_body.write)
+        self.session.setopt(pycurl.HEADERFUNCTION, receive_header)
+        self.session.setopt(pycurl.FOLLOWLOCATION, True)
+        self.session.setopt(pycurl.ACCEPT_ENCODING, '')
+        if body is not None or method in {'POST', 'PATCH'}:
+            self.session.setopt(pycurl.POSTFIELDS, body or '')
+        self.session.perform()
+
+        effective_url = self.session.getinfo(pycurl.EFFECTIVE_URL)
+        if isinstance(effective_url, bytes):
+            effective_url = effective_url.decode('utf-8', errors='replace')
+        return _Response(
+            status_code=self.session.getinfo(pycurl.RESPONSE_CODE),
+            url=effective_url or url,
+            headers=response_headers,
