 logger = logging.getLogger(__name__)
+
+_HTTP = urllib3.PoolManager()
+_HTTP_UNVERIFIED = urllib3.PoolManager(cert_reqs=ssl.CERT_NONE)
+_HTTP_RETRIES = urllib3.util.Retry(
+    total=None,
+    connect=0,
+    read=0,
+    redirect=30,
+    status=0,
+    other=0,
+)
+
+
+def _http_request(method, url, verify_ssl=True, **kwargs):
+    """Make an HTTP request, following redirects without retrying failures."""
+    pool = _HTTP if verify_ssl else _HTTP_UNVERIFIED
+    kwargs.setdefault('retries', _HTTP_RETRIES)
+    return pool.request(method, url, **kwargs)
+
+
+def _raise_for_status(response, url):
+    if 400 <= response.status < 600:
+        raise urllib3.exceptions.HTTPError(
+            '{} response while requesting {}'.format(response.status, url)
+        )
+
+
+def _response_json(response):
+    return json.loads(response.data.decode('utf-8-sig'))
 
