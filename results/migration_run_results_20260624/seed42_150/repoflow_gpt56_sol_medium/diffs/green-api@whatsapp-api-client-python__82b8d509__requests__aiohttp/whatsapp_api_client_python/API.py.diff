+    async def __request(self, **arguments: Any) -> tuple:
+        files = arguments.pop("files", None)
+        data = arguments.pop("data", None)
+
+        for attempt in range(4):
+            request_arguments = arguments.copy()
+            request_arguments["data"] = (
+                self.__form_data(data, files) if files else data
+            )
+
+            try:
+                pending_response = self.session.request(**request_arguments)
+                if hasattr(pending_response, "__await__"):
+                    response = await pending_response
+                else:
+                    response = pending_response
+
+                if hasattr(response, "status_code"):
+                    status_code = response.status_code
+                    text = response.text
+                else:
+                    status_code = response.status
+                    try:
+                        text = await response.text()
+                    finally:
+                        response.release()
+                retry_after = response.headers.get("Retry-After")
+            except (aiohttp.ClientError, asyncio.TimeoutError):
+                if attempt == 3:
+                    raise
+                await asyncio.sleep(self.__backoff(attempt))
+                continue
+
+            if status_code != 429:
+                return status_code, text
+            if attempt == 3:
+                raise RuntimeError("Request failed after repeated 429 responses")
+
+            try:
+                delay = float(retry_after) if retry_after is not None else None
+            except (TypeError, ValueError):
+                delay = None
+            await asyncio.sleep(
+                max(0.0, delay) if delay is not None else self.__backoff(attempt)
+            )
+
+        raise RuntimeError("HTTP request retry loop ended unexpectedly")
+
+    @staticmethod
+    def __form_data(data: Any, files: dict) -> aiohttp.FormData:
+        form = aiohttp.FormData(data or {})
+        for field, value in files.items():
+            if isinstance(value, tuple):
+                filename, file_value = value[:2]
+                options = {"filename": filename}
+                if len(value) > 2 and value[2] is not None:
+                    options["content_type"] = value[2]
+                if len(value) > 3 and value[3] is not None:
+                    options["headers"] = value[3]
+                form.add_field(field, file_value, **options)
+            else:
+                form.add_field(field, value)
+        return form
+
+    @staticmethod
+    def __backoff(attempt: int) -> float:
+        return 0.0 if attempt == 0 else float(2 ** attempt)
+
+    def __run_event_loop(self) -> None:
+        asyncio.set_event_loop(self._loop)
+        self._loop.run_forever()
+
+    def __submit(self, coroutine: Any) -> Any:
+        return asyncio.run_coroutine_threadsafe(coroutine, self._loop).result()
+
+    def close(self) -> None:
