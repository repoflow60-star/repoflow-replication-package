+def tabulate(rows: List[List[Any]], headers: List[str], tablefmt: str) -> str:
+    """Render rows in one of the report's supported plain-text formats."""
+    values = [["" if value is None else str(value) for value in row] for row in rows]
+    widths = [
+        max(
+            Text(header).cell_len + 2,
+            *(Text(row[index]).cell_len for row in values),
+        )
+        for index, header in enumerate(headers)
+    ]
+
+    def render_rst_row(row: List[str]) -> str:
+        cells = [
+            value + " " * (width - Text(value).cell_len)
+            for value, width in zip(row, widths)
+        ]
+        return "  ".join(cells).rstrip()
+
+    def render_github_row(row: List[str]) -> str:
+        cells = [
+            f" {value}{' ' * (width - Text(value).cell_len - 1)}"
+            for value, width in zip(row, widths)
+        ]
+        return f"|{'|'.join(cells)}|"
+
+    if tablefmt == "rst":
+        rule = "  ".join("=" * width for width in widths)
+        lines = [rule, render_rst_row(headers), rule]
+        lines.extend(render_rst_row(row) for row in values)
+        lines.append(rule)
+    else:
+        rule = f"|{'|'.join('-' * width for width in widths)}|"
+        lines = [render_github_row(headers), rule]
+        lines.extend(render_github_row(row) for row in values)
+
+    output = StringIO()
+    Console(file=output, color_system=None, force_terminal=False).print(
+        Text("\n".join(lines)), end="", soft_wrap=True
+    )
+    return output.getvalue()
 
 
