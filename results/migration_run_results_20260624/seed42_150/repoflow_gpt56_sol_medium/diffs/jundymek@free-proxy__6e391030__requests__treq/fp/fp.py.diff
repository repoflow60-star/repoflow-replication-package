 import lxml.html as lh
-import requests
+import treq
+from twisted.internet import reactor
+from twisted.internet.endpoints import TCP4ClientEndpoint
+from twisted.internet.threads import blockingCallFromThread
+from twisted.web.client import ProxyAgent
 
 from fp.errors import FreeProxyException
+
+
+_reactor_ready = threading.Event()
+_reactor_started = threading.Event()
+_reactor_lock = threading.Lock()
+
+
+class _RequestError(Exception):
+    pass
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _wait_for_request(request):
+    if not reactor.running:
+        with _reactor_lock:
+            if not reactor.running and not _reactor_started.is_set():
+                _reactor_started.set()
+                threading.Thread(target=_run_reactor, daemon=True).start()
+        _reactor_ready.wait()
+    try:
+        return blockingCallFromThread(reactor, request)
+    except Exception as error:
+        raise _RequestError from error
 
 
