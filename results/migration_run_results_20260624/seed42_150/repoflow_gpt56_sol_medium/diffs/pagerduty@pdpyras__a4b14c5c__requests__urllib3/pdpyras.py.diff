+class Response:
+    """Compatibility response interface backed by an urllib3 response."""
+
+    def __init__(self, raw, method, url, elapsed):
+        self.raw = raw
+        self.status_code = raw.status
+        self.headers = raw.headers
+        self.content = raw.data
+        self.reason = raw.reason
+        self.url = url
+        self.request = _RequestMetadata(method, url)
+        self.elapsed = timedelta(seconds=elapsed)
+
+    @property
+    def ok(self):
+        return self.status_code < 400
+
+    @property
+    def text(self):
+        encoding = 'utf-8'
+        content_type = self.headers.get('content-type', '')
+        for parameter in content_type.split(';')[1:]:
+            name, separator, value = parameter.strip().partition('=')
+            if separator and name.lower() == 'charset':
+                encoding = value.strip('"\' ')
+                break
+        try:
+            return self.content.decode(encoding, errors='replace')
+        except LookupError:
+            return self.content.decode('utf-8', errors='replace')
+
+    def json(self):
+        return jsonlib.loads(self.text)
+
+    def close(self):
+        return self.raw.close()
+
+    def __bool__(self):
+        return self.ok
+
+    def __getattr__(self, name):
+        return getattr(self.raw, name)
+
+
+class _PoolManager(PoolManager):
+    """Translate the session-style request contract to urllib3 arguments."""
+
+    def request(self, method, url, params=None, data=None, json=None,
+            stream=False, allow_redirects=True, **kwargs):
+        if params:
+            items = params.items() if hasattr(params, 'items') else params
+            query = urlencode(
+                [(key, value) for key, value in items if value is not None],
+                doseq=True,
+            )
+            if query:
+                url += ('&' if '?' in url else '?') + query
+
+        headers = kwargs.setdefault('headers', HTTPHeaderDict())
+        if json is not None:
+            kwargs['body'] = jsonlib.dumps(json, allow_nan=False).encode('utf-8')
+            headers.setdefault('Content-Type', 'application/json')
+        elif isinstance(data, dict):
+            kwargs['fields'] = data
+            kwargs['encode_multipart'] = False
+        elif data is not None:
+            kwargs['body'] = data
+
+        kwargs['preload_content'] = not stream
+        kwargs['redirect'] = allow_redirects
+        kwargs.setdefault('retries', Retry(
+            total=None,
+            connect=0,
+            read=0,
+            redirect=30 if allow_redirects else 0,
+            status=0,
+            other=0,
+            raise_on_status=False,
+        ))
+        started = time.monotonic()
+        response = super().request(method, url, **kwargs)
+        return Response(response, method, url, time.monotonic() - started)
 
