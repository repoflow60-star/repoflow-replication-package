+        def mako_expression(match: re.Match[str]) -> str:
+            parts = [part.strip() for part in match.group(1).split('|')]
+            expression = parts[0]
+
+            for filter_expression in parts[1:]:
+                name, separator, arguments = filter_expression.partition('(')
+                name = name.strip()
+                if name in cls.filters:
+                    name = '_filter_' + name
+                if separator and arguments.endswith(')'):
+                    arguments = arguments[:-1].strip()
+                    expression = f"{name}({expression}, {arguments})"
+                else:
+                    expression = f"{name}({expression})"
+
+            return '${' + expression + '}'
+
+        template = re.sub(r'\{\{(.*?)\}\}', mako_expression, f, flags=re.DOTALL)
+        context = value.copy() if isinstance(value, dict) else {"x": value}
+        context.update({f'_filter_{name}': function
+                        for name, function in cls.filters.items()})
+        return Template(template).render(**context)
