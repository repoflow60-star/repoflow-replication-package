+    def _request(self, method, *args, **kwargs):
+        """Execute a requests-futures request while retaining the synchronous API."""
+        try:
+            return getattr(self.session, method)(*args, **kwargs).result()
+        except Exception as error:
+            raise ConnectionUnavailableError(error) from None
+
+    def _raise_for_status(self, response, status_errors):
