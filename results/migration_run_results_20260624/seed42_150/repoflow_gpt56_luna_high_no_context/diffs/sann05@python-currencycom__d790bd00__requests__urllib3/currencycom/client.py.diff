+def _encode_params(params):
+    """Encode parameters using the form encoding used by the old client."""
+    if params is None:
+        return None
+    if isinstance(params, (str, bytes)):
+        return params
+
+    items = []
+    for key, value in params.items():
+        if isinstance(value, (str, bytes)) or not hasattr(value, '__iter__'):
+            values = (value,)
+        else:
+            values = value
+        for item in values:
+            if item is not None:
+                items.append((key, item))
+    return urlencode(items, doseq=True)
+
+
+def _request(method, url, params=None, headers=None):
+    encoded_params = _encode_params(params)
+    if encoded_params:
+        parts = urlsplit(url)
+        query = '&'.join(
+            value for value in (parts.query, encoded_params) if value
+        )
+        url = urlunsplit((parts.scheme, parts.netloc, parts.path, query,
+                          parts.fragment))
+    return _HTTP.request(method, url, headers=headers or {})
+
+
+def _json_response(response):
+    data = response.data
+    if isinstance(data, bytes):
+        data = data.decode('utf-8-sig')
+    return json.loads(data)
 
 
