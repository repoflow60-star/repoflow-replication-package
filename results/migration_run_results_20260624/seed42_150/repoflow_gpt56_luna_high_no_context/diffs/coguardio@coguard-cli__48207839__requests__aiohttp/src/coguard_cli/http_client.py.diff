--- a/src/coguard_cli/http_client.py
+++ b/src/coguard_cli/http_client.py
@@ -0,0 +1,85 @@
+"""Synchronous helpers backed by aiohttp for the CLI's HTTP calls."""
+
+import asyncio
+from threading import Thread
+from typing import Any, Dict, Optional, Tuple
+
+import aiohttp
+
+
+def _run(coroutine):
+    """Run an aiohttp coroutine without changing the caller's sync boundary."""
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coroutine)
+
+    result = []
+    error = []
+
+    def run_in_thread():
+        try:
+            result.append(asyncio.run(coroutine))
+        except BaseException as exception:
+            error.append(exception)
+
+    thread = Thread(target=run_in_thread)
+    thread.start()
+    thread.join()
+    if error:
+        raise error[0]
+    return result[0]
+
+
+async def _request(
+        method: str,
+        url: str,
+        headers: Optional[Dict[str, str]],
+        data: Any,
+        json_payload: Any,
+        timeout: Optional[float]) -> Tuple[int, str, bytes]:
+    client_timeout = aiohttp.ClientTimeout(total=timeout)
+    async with aiohttp.ClientSession(timeout=client_timeout) as session:
+        async with session.request(
+                method,
+                url,
+                headers=headers,
+                data=data,
+                json=json_payload) as response:
+            return response.status, response.reason or "", await response.read()
+
+
+def request(
+        method: str,
+        url: str,
+        headers: Optional[Dict[str, str]] = None,
+        data: Any = None,
+        json_payload: Any = None,
+        timeout: Optional[float] = None) -> Tuple[int, str, bytes]:
+    """Make a request with aiohttp and return status, reason, and body."""
+    return _run(_request(method, url, headers, data, json_payload, timeout))
+
+
+async def _download(
+        method: str,
+        url: str,
+        location: str,
+        headers: Optional[Dict[str, str]],
+        timeout: Optional[float]) -> None:
+    client_timeout = aiohttp.ClientTimeout(total=timeout)
+    async with aiohttp.ClientSession(timeout=client_timeout) as session:
+        async with session.request(method, url, headers=headers) as response:
+            response.raise_for_status()
+            with open(location, 'wb') as output:
+                async for chunk in response.content.iter_chunked(8192):
+                    output.write(chunk)
+
+
+def download(
+        method: str,
+        url: str,
+        location: str,
+        headers: Optional[Dict[str, str]] = None,
+        timeout: Optional[float] = None) -> None:
+    """Stream a response to a file using aiohttp."""
+    _run(_download(method, url, location, headers, timeout))
