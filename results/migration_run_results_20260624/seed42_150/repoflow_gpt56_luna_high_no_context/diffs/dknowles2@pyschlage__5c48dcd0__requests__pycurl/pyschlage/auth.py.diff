+class HttpError(Exception):
+    """Raised when a response has an unsuccessful HTTP status code."""
+
+
+class CurlResponse:
+    """Response data returned by the pycurl transport."""
+
+    def __init__(
+        self,
+        url: str,
+        status_code: int,
+        reason: str,
+        headers: dict[str, str],
+        content: bytes,
+    ) -> None:
+        self.url = url
+        self.status_code = status_code
+        self.reason = reason
+        self.headers = headers
+        self.content = content
+
+    @property
+    def ok(self) -> bool:
+        """Whether the response has a successful status code."""
+        return self.status_code < 400
+
+    @property
+    def text(self) -> str:
+        """Return the response body decoded as UTF-8."""
+        return self.content.decode("utf-8", errors="replace")
+
+    def json(self) -> Any:
+        """Decode the response body as JSON."""
+        return json.loads(self.content.decode("utf-8"))
+
+    def raise_for_status(self) -> None:
+        """Raise an error for a 4xx or 5xx response."""
+        if self.status_code >= 400:
+            message = f"{self.status_code} {self.reason}".strip()
+            raise HttpError(message)
+
+
+class _AuthRequest:
+    """Header container accepted by pycognito's request auth callable."""
+
+    def __init__(self, headers: dict[str, str]) -> None:
+        self.headers = headers
+
+
+def _capture_headers(
+    headers: dict[str, str], status: list[int], reason: list[str], line: bytes
+) -> int:
+    """Capture the final response headers emitted by libcurl."""
+    decoded = line.decode("iso-8859-1").rstrip("\r\n")
+    if decoded.startswith("HTTP/"):
+        parts = decoded.split(" ", 2)
+        try:
+            response_status = int(parts[1])
+        except (IndexError, ValueError):
+            return len(line)
+        status[:] = [response_status]
+        reason[:] = [parts[2] if len(parts) == 3 else ""]
+        headers.clear()
+    elif ":" in decoded:
+        name, value = decoded.split(":", 1)
+        name = name.strip()
+        value = value.strip()
+        if name in headers:
+            headers[name] = f"{headers[name]}, {value}"
+        else:
+            headers[name] = value
+    return len(line)
+
