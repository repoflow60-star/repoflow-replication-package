+class _AiohttpHTTP:
+    """Synchronous transport backed by aiohttp."""
+
+    def __init__(self, proxy=None, proxy_auth=None, **kwargs):
+        self._proxy = proxy
+        self._proxy_auth = proxy_auth
+        self._timeout = self._make_timeout(kwargs.get("timeout", 60))
+        self._ssl = self._make_ssl_context(kwargs)
+
+    @staticmethod
+    def _make_timeout(timeout):
+        if isinstance(timeout, aiohttp.ClientTimeout):
+            return timeout
+
+        total = getattr(timeout, "total", timeout)
+        connect = getattr(timeout, "connect_timeout", None)
+        read = getattr(timeout, "read_timeout", None)
+        values = {"total": total}
+        if connect is not None:
+            values["connect"] = connect
+        if read is not None:
+            values["sock_read"] = read
+        return aiohttp.ClientTimeout(**values)
+
+    @staticmethod
+    def _make_ssl_context(kwargs):
+        ssl_context = kwargs.get("ssl_context")
+        if ssl_context is not None:
+            return ssl_context
+
+        context = ssl.create_default_context(cafile=kwargs.get("ca_certs"))
+        cert_reqs = kwargs.get("cert_reqs")
+        if cert_reqs == ssl.CERT_NONE:
+            context.check_hostname = False
+            context.verify_mode = ssl.CERT_NONE
+        elif cert_reqs == ssl.CERT_OPTIONAL:
+            context.verify_mode = ssl.CERT_OPTIONAL
+
+        if kwargs.get("assert_hostname") is False:
+            context.check_hostname = False
+
+        cert_file = kwargs.get("cert_file")
+        if cert_file is not None:
+            context.load_cert_chain(
+                cert_file,
+                kwargs.get("key_file"),
+                kwargs.get("key_password"),
+            )
+        return context
+
+    def request(self, method, url, fields=None, body=None, headers=None, **kwargs):
+        return _run_async(self._request(method, url, fields, body, headers, kwargs))
+
+    def urlopen(self, method, url, body=None, headers=None, **kwargs):
+        return self.request(method, url, body=body, headers=headers, **kwargs)
+
+    async def _request(self, method, url, fields, body, headers, kwargs):
+        method = method.upper()
+        params = fields if method in ("GET", "DELETE") else None
+        data = body if body is not None else (None if params is not None else fields)
+        if isinstance(data, array):
+            data = data.tobytes()
+        elif isinstance(data, bytearray):
+            data = bytes(data)
+
+        timeout = self._make_timeout(kwargs.get("timeout", self._timeout))
+        connector = aiohttp.TCPConnector(ssl=self._ssl)
+        async with aiohttp.ClientSession(
+            connector=connector,
+            timeout=timeout,
+            trust_env=False,
+        ) as session:
+            async with session.request(
+                method,
+                url,
+                params=params,
+                data=data,
+                headers=headers,
+                allow_redirects=True,
+                proxy=self._proxy,
+                proxy_auth=self._proxy_auth,
+            ) as response:
+                return _SyncResponse(
+                    response.status, response.headers, await response.read()
+                )
+
