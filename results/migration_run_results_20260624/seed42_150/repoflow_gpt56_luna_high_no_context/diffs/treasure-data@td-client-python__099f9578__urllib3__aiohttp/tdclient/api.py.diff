+class _SyncResponse:
+    """Expose a completed aiohttp response through the synchronous API."""
+
+    def __init__(self, status, headers, body):
+        self.status = status
+        self.headers = dict(headers)
+        self._body = body
+        self._stream = io.BytesIO(body)
+
+    @property
+    def data(self):
+        return self._body
+
+    def getheaders(self):
+        return self.headers
+
+    def read(self, amount=-1):
+        if amount is None:
+            amount = -1
+        return self._stream.read(amount)
+
+    def readline(self, amount=-1):
+        if amount is None:
+            amount = -1
+        return self._stream.readline(amount)
+
+    def stream(self, amount=65536, decode_content=None):
+        if amount is None:
+            amount = 65536
+        while True:
+            chunk = self._stream.read(amount)
+            if not chunk:
+                return
+            yield chunk
+
+    def __iter__(self):
+        return self
+
+    def __next__(self):
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
+
+    def close(self):
+        return None
+
