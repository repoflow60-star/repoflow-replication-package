+def _header_value(headers, name: str) -> Optional[str]:
+    values = headers.getRawHeaders(name.encode("ascii"))
+    if not values:
+        return None
+    value = values[0]
+    if isinstance(value, bytes):
+        return value.decode("latin1")
+    return value
+
+
+def _fetch(url: str, verify: bool = True):
+    """Fetch a URL synchronously while using treq for the HTTP request."""
+    reactor = SelectReactor()
+    if verify:
+        agent = Agent(reactor)
+    else:
+        agent = Agent(reactor, contextFactory=ClientContextFactory())
+    client = HTTPClient(agent)
+
+    @inlineCallbacks
+    def fetch():
+        current_url = url
+        history = []
+        for _ in range(31):
+            response = yield client.request(
+                "GET",
+                current_url,
+                headers=Headers({
+                    b"User-Agent": [USER_AGENT.encode("ascii")]
+                }),
+                timeout=5,
+            )
+            if response.code in (301, 302, 303, 307, 308):
+                location = _header_value(response.headers, "location")
+                if location:
+                    yield treq.content(response)
+                    history.append(current_url)
+                    current_url = urljoin(current_url, location)
+                    continue
+            content = yield treq.content(response)
+            returnValue((response.code, response.headers, content, current_url, history))
+        raise RuntimeError("Too many redirects")
+
+    return task.react(lambda _: fetch(), _reactor=reactor)
 
 
