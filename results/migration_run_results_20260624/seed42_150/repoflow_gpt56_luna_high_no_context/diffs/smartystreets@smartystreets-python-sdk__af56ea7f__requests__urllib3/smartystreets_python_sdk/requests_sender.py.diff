+def _append_query_parameters(url, parameters):
+    if not parameters:
+        return url
+
+    if isinstance(parameters, string_types):
+        encoded_parameters = parameters
+    else:
+        encoded_parameters = urlencode(_query_pairs(parameters), doseq=True)
+    if not encoded_parameters:
+        return url
+
+    fragment = ''
+    if '#' in url:
+        url, fragment = url.split('#', 1)
+        fragment = '#' + fragment
+
+    separator = '&' if '?' in url and url.split('?', 1)[1] else '?'
+    return url + separator + encoded_parameters + fragment
+
+
+def _query_pairs(parameters):
+    try:
+        items = parameters.items()
+    except AttributeError:
+        items = parameters
+
+    pairs = []
+    for key, value in items:
+        if isinstance(value, string_types) or not hasattr(value, '__iter__'):
+            values = [value]
+        else:
+            values = value
+        for item in values:
+            if item is not None:
+                pairs.append((key, item))
+    return pairs
 
 
