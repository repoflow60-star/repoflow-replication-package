+) -> ty.Tuple[ty.Any, bytes]:
+    headers = _get_headers()
+    auth_header = _get_auth_header(optional=optional_auth)
+    if auth_header:
+        headers['Authorization'] = auth_header
+    request_headers = {
+        name.encode('ascii'): [value.encode('latin-1')]
+        for name, value in headers.items()
+    }
+
+    try:
+        _ensure_reactor()
+        response, content = threads.blockingCallFromThread(
+            reactor,
+            _request_async,
+            method,
+            url,
+            request_headers,
+            params,
+            data,
+        )
+    except Exception as exc:
+        _handle_error(operation, exc)
+
+    if response.code >= 400:
