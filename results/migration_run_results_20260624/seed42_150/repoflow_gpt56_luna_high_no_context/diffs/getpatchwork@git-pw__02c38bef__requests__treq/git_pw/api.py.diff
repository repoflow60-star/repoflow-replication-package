+_REACTOR_LOCK = threading.Lock()
+_REACTOR_THREAD: ty.Optional[threading.Thread] = None
+_REACTOR_READY: ty.Optional[threading.Event] = None
+
+
+def _ensure_reactor() -> None:
+    """Start a reactor thread for the synchronous public API."""
+    global _REACTOR_THREAD, _REACTOR_READY
+
+    if reactor.running:
+        return
+
+    with _REACTOR_LOCK:
+        if reactor.running:
+            return
+
+        if _REACTOR_THREAD is None:
+            ready = threading.Event()
+
+            def run() -> None:
+                reactor.callWhenRunning(ready.set)
+                reactor.run(installSignalHandlers=False)
+
+            _REACTOR_READY = ready
+            _REACTOR_THREAD = threading.Thread(target=run, daemon=True)
+            _REACTOR_THREAD.start()
+
+    if _REACTOR_READY is not None:
+        _REACTOR_READY.wait()
+
+
+@defer.inlineCallbacks
+def _request_async(
+    method: str,
+    url: str,
+    headers: ty.Dict[bytes, ty.List[bytes]],
+    params: ty.Optional[Filters],
+    data: ty.Optional[ty.List[ty.Tuple[str, ty.Any]]],
+) -> ty.Generator[ty.Any, ty.Any, ty.Tuple[ty.Any, bytes]]:
+    response = yield treq.request(
+        method,
+        url,
+        headers=headers,
+        params=params,
+        data=data,
+        browser_like_redirects=True,
+    )
+    content = yield treq.content(response)
+    defer.returnValue((response, content))
+
+
+def _request(
