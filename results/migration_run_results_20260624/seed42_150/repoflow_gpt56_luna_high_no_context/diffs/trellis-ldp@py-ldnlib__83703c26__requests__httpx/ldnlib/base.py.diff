     def __init__(self, **kwargs):
         self.accept_headers = kwargs.get('accept_headers', self.ACCEPT_HEADERS)
 
+    def _httpx_kwargs(self, kwargs, default_follow_redirects):
+        kwargs = dict(kwargs)
+        if 'allow_redirects' in kwargs:
+            kwargs['follow_redirects'] = kwargs.pop('allow_redirects')
+        else:
+            kwargs.setdefault('follow_redirects', default_follow_redirects)
+        return kwargs
+
+    def _response_links(self, response):
+        links = {}
+        link_header = response.headers.get('link', '')
+        for value in re.split(r',\s*(?=<)', link_header.rstrip(';,')):
+            match = re.match(r'\s*<([^>]*)>\s*(.*)', value)
+            if not match:
+                continue
+
+            link = {'url': match.group(1)}
+            for parameter in match.group(2).split(';'):
+                if '=' not in parameter:
+                    continue
+                key, value = parameter.strip().split('=', 1)
+                link[key] = value.strip().strip("'\"")
+            if 'rel' in link:
+                links[link['rel']] = link
+        return links
+
