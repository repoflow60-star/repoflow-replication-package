+
+    def _request_bytes(
+        self,
+        method: str,
+        url: str,
+        params: Optional[Dict] = None,
+        data: Optional[Dict] = None,
+        json_payload: Optional[Dict] = None,
+        use_session_headers: bool = True,
+    ) -> bytes:
+        """Send a request with pycurl and return its response body."""
+        if params:
+            query = urlencode(params, doseq=True)
+            url += ("&" if "?" in url else "?") + query
+
+        headers = []
+        if use_session_headers and self.headers:
+            headers.extend(f"{key}: {value}" for key, value in self.headers.items())
+
+        body = None
+        if data is not None:
+            if isinstance(data, dict):
+                body = urlencode(data, doseq=True).encode("utf-8")
+                headers.append("Content-Type: application/x-www-form-urlencoded")
+            elif isinstance(data, bytes):
+                body = data
+            else:
+                body = str(data).encode("utf-8")
+        elif json_payload is not None:
+            body = json_lib.dumps(json_payload).encode("utf-8")
+            headers.append("Content-Type: application/json")
+
+        response_buffer = BytesIO()
+        self.session.reset()
+        self.session.setopt(pycurl.URL, url)
+        self.session.setopt(pycurl.CUSTOMREQUEST, method.upper())
+        self.session.setopt(pycurl.FOLLOWLOCATION, 1)
+        self.session.setopt(pycurl.TIMEOUT, 30)
+        if headers:
+            self.session.setopt(pycurl.HTTPHEADER, headers)
+        self.session.setopt(pycurl.WRITEDATA, response_buffer)
+        if body is not None:
+            self.session.setopt(pycurl.POSTFIELDS, body)
+
+        self.session.perform()
+        status_code = self.session.getinfo(pycurl.RESPONSE_CODE)
+        if status_code >= 400:
+            raise RuntimeError(f"HTTP error {status_code}")
+
+        return response_buffer.getvalue()
 
