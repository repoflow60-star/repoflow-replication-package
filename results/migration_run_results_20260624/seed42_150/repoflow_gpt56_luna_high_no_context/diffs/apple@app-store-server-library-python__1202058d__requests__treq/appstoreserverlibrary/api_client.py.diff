+class _SyncHTTPResponse:
+    def __init__(self, status_code: int, headers: MutableMapping[str, str], content: bytes):
+        self.status_code = status_code
+        self.headers = headers
+        self._content = content
+
+    def json(self):
+        return json_module.loads(self._content)
+
+
+def _response_content_type(headers: MutableMapping) -> Optional[str]:
+    for name, value in headers.items():
+        if str(name).lower() == "content-type":
+            if isinstance(value, bytes):
+                return value.decode("latin-1")
+            if isinstance(value, (list, tuple)):
+                value = value[0] if value else ""
+            return str(value)
+    return None
+
+
+def _response_headers(headers: MutableMapping) -> Dict[str, str]:
+    if hasattr(headers, "getAllRawHeaders"):
+        normalized = {}
+        for name, values in headers.getAllRawHeaders():
+            if isinstance(name, bytes):
+                name = name.decode("latin-1")
+            value = values[0] if values else ""
+            if isinstance(value, bytes):
+                value = value.decode("latin-1")
+            normalized[str(name)] = str(value)
+        return normalized
+    return dict(headers)
+
+
+def _response_status_code(response) -> int:
+    if hasattr(response, "status_code"):
+        return response.status_code
+    return response.code
