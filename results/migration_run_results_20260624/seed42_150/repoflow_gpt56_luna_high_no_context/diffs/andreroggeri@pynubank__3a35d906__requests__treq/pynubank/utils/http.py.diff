+@defer.inlineCallbacks
+def _request(method, url, headers, data, agent):
+    response = yield treq.request(method, url, headers=headers, data=data, agent=agent)
+    body = yield treq.content(response)
+    defer.returnValue(_TreqResponse(response, url, body))
+
+
+def _request_sync(method, url, headers, data=None, agent=None):
+    _ensure_reactor()
+    return blockingCallFromThread(
