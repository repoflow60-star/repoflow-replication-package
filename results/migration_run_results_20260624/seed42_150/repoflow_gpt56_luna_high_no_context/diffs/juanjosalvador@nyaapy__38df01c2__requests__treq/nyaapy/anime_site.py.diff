 from nyaapy import torrent
 from nyaapy.parser import parse_nyaa, parse_single, parse_nyaa_rss
+
+
+_reactor_lock = threading.Lock()
+_reactor_ready = threading.Event()
+_reactor_thread = None
+
+
+def _ensure_reactor():
+    global _reactor_thread
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if reactor.running:
+            return
+
+        if _reactor_thread is None:
+            _reactor_ready.clear()
+
+            def run_reactor():
+                reactor.callWhenRunning(_reactor_ready.set)
+                reactor.run(installSignalHandlers=False)
+
+            _reactor_thread = threading.Thread(
+                target=run_reactor, name="nyaapy-treq-reactor", daemon=True
+            )
+            _reactor_thread.start()
+        elif not _reactor_thread.is_alive():
+            raise RuntimeError("The Twisted reactor stopped before a request completed")
+
+    if not _reactor_ready.wait(timeout=5):
+        raise RuntimeError("The Twisted reactor could not be started")
+
+
+def _request(url, text=False):
+    """Synchronously fetch a URL while using treq's Deferred API internally."""
+    _ensure_reactor()
+
+    completed = threading.Event()
+    result = []
+
+    def check_status(response):
+        if response.code >= 400:
+            raise RuntimeError(f"HTTP request failed with status {response.code}: {url}")
+        return response
+
+    def finish(value):
+        if isinstance(value, Failure):
+            result.append((False, value.value))
+        else:
+            result.append((True, value))
+        completed.set()
+        return value
+
+    def perform_request():
+        request = defer.maybeDeferred(treq.get, url)
+        request.addCallback(check_status)
+        request.addCallback(
+            lambda response: treq.text_content(response)
+            if text
+            else treq.content(response)
+        )
+        request.addBoth(finish)
+
+    reactor.callFromThread(perform_request)
+    completed.wait()
+
+    succeeded, value = result[0]
+    if not succeeded:
+        raise value
+    return value
 
 
