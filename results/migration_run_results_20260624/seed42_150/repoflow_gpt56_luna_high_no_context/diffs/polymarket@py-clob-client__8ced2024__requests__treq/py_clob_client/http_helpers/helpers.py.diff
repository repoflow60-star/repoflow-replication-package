+def _request_with_treq(endpoint: str, method: str, headers: dict, data):
+    response_event = Event()
+    response_state = {}
+    request_headers = Headers(
+        {
+            key.encode("ascii"): [str(value).encode("utf-8")]
+            for key, value in headers.items()
+        }
+    )
+    request_data = json.dumps(data).encode("utf-8") if data else None
+
+    def on_error(failure):
+        response_state["error"] = failure.value
+        response_event.set()
+        return failure
+
+    def on_content(content):
+        response_state["content"] = content
+        response_event.set()
+        return content
+
+    def on_response(response):
+        response_state["status_code"] = response.code
+        content_deferred = treq.content(response)
+        content_deferred.addCallbacks(on_content, on_error)
+        return content_deferred
+
+    def make_request():
+        try:
+            request_deferred = treq.request(
+                method=method,
+                url=endpoint,
+                headers=request_headers,
+                data=request_data,
+            )
+            request_deferred.addCallbacks(on_response, on_error)
+        except Exception as error:
+            response_state["error"] = error
+            response_event.set()
+
+    _start_reactor()
+    reactor.callFromThread(make_request)
+    response_event.wait()
+
+    if "error" in response_state:
+        raise response_state["error"]
+
+    return response_state["status_code"], response_state["content"]
