+def _mark_options(kwargs, default_opacity=None):
+    """Translate the supported styling options to Altair mark options."""
+    options = {}
+    if default_opacity is not None:
+        options["opacity"] = default_opacity
+
+    for name in (
+        "color",
+        "fill",
+        "filled",
+        "opacity",
+        "size",
+        "shape",
+        "stroke",
+        "strokeWidth",
+    ):
+        if name in kwargs:
+            options[name] = kwargs[name]
+
+    if "alpha" in kwargs:
+        options["opacity"] = kwargs["alpha"]
+    if "linewidth" in kwargs:
+        options["strokeWidth"] = kwargs["linewidth"]
+    elif "lw" in kwargs:
+        options["strokeWidth"] = kwargs["lw"]
+
+    if "marker" in kwargs:
+        marker_names = {
+            ".": "circle",
+            "o": "circle",
+            "s": "square",
+            "^": "triangle-up",
+            "v": "triangle-down",
+        }
+        options["shape"] = marker_names.get(kwargs["marker"], kwargs["marker"])
+
+    return options
+
+
+def _scale(loglog):
+    return alt.Scale(type="log") if loglog else alt.Scale(type="linear")
 
 
