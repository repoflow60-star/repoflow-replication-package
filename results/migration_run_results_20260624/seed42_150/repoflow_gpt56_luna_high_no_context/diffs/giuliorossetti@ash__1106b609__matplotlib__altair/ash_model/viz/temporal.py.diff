+def _line_options(kwargs):
+    options = {}
+    for name in (
+        "color",
+        "filled",
+        "interpolate",
+        "opacity",
+        "point",
+        "size",
+        "stroke",
+        "strokeDash",
+        "strokeWidth",
+    ):
+        if name in kwargs:
+            options[name] = kwargs[name]
+    if "alpha" in kwargs:
+        options["opacity"] = kwargs["alpha"]
+    if "linewidth" in kwargs:
+        options["strokeWidth"] = kwargs["linewidth"]
+    elif "lw" in kwargs:
+        options["strokeWidth"] = kwargs["lw"]
+
+    line_styles = {
+        "dashed": [5, 5],
+        "dotted": [1, 3],
+        "dashdot": [5, 3, 1, 3],
+        "--": [5, 5],
+        ":": [1, 3],
+        "-.": [5, 3, 1, 3],
+    }
+    style = kwargs.get("linestyle", kwargs.get("ls"))
+    if style in line_styles:
+        options["strokeDash"] = line_styles[style]
+    return options
+
+
+def _line_chart(rows, kwargs, with_series=False):
+    data = pd.DataFrame(rows, columns=["snapshot", "value", "series"])
+    chart = alt.Chart(data).mark_line(**_line_options(kwargs)).encode(
+        x=alt.X("snapshot:Q"),
+        y=alt.Y("value:Q"),
+    )
+    if with_series:
+        chart = chart.encode(color=alt.Color("series:N", title=None))
+    return chart
 
 
