+def _create_axes(num_rows: int, num_cols: int, figsize):
+    """Create a figure and a consistently two-dimensional axes grid."""
+    facet_data = pd.DataFrame(
+        {
+            "_row": np.repeat(np.arange(num_rows), num_cols),
+            "_col": np.tile(np.arange(num_cols), num_rows),
+        }
+    )
+    grid = sns.FacetGrid(
+        facet_data,
+        row="_row",
+        col="_col",
+        row_order=list(range(num_rows)),
+        col_order=list(range(num_cols)),
+        height=figsize[1] / num_rows,
+        aspect=figsize[0] / num_cols / (figsize[1] / num_rows),
+        despine=False,
+    )
+    grid.fig.set_size_inches(figsize)
+    for axis in grid.axes.flat:
+        axis.set_title("")
+    return grid.fig, grid.axes
+
+
+def _scatter_points(
+    ax,
+    x,
+    y,
+    colors,
+    alpha,
+    size,
+    labels=None,
+    palette=None,
+    legend=False,
+    hue_order=None,
+    **kwargs,
+):
+    """Render colored points through seaborn while preserving empty selections."""
+    if len(x) == 0:
+        return False
+
+    if labels is None:
+        labels = list(colors)
+        palette = {color: color for color in dict.fromkeys(labels)}
+    else:
+        labels = list(labels)
+
+    sns.scatterplot(
+        x=x,
+        y=y,
+        hue=labels,
+        palette=palette,
+        hue_order=hue_order,
+        legend=legend,
+        alpha=alpha,
+        s=size,
+        ax=ax,
+        **kwargs,
+    )
+    return True
 
 
