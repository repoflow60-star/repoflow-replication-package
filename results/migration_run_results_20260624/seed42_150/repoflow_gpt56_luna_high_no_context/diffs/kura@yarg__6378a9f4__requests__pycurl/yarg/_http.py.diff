--- a/yarg/_http.py
+++ b/yarg/_http.py
@@ -0,0 +1,35 @@
+# -*- coding: utf-8 -*-
+
+from http.client import responses
+from io import BytesIO
+
+import pycurl
+
+
+def get(url):
+    """Return the status code, reason phrase, and body for a GET request."""
+    body = BytesIO()
+    reason = [None]
+
+    def capture_headers(line):
+        if isinstance(line, bytes):
+            line = line.decode('iso-8859-1', 'replace')
+        if line.startswith('HTTP/'):
+            parts = line.rstrip('\r\n').split(' ', 2)
+            if len(parts) == 3:
+                reason[0] = parts[2]
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, capture_headers)
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+
+    if reason[0] is None:
+        reason[0] = responses.get(status_code, '')
+    return status_code, reason[0], body.getvalue()
