+def _split_filters(expression: str) -> List[str]:
+    parts: List[str] = []
+    start = 0
+    depth = 0
+    quote: Optional[str] = None
+    escaped = False
+
+    for index, character in enumerate(expression):
+        if quote is not None:
+            if escaped:
+                escaped = False
+            elif character == "\\":
+                escaped = True
+            elif character == quote:
+                quote = None
+            continue
+
+        if character in ("'", '"'):
+            quote = character
+        elif character in "([{":
+            depth += 1
+        elif character in ")]}":
+            depth -= 1
+        elif character == "|" and depth == 0:
+            parts.append(expression[start:index].strip())
+            start = index + 1
+
+    parts.append(expression[start:].strip())
+    return parts
+
+
+def _to_mako_expression(expression: str) -> str:
+    parts = _split_filters(expression)
+    result = parts[0]
+
+    for filter_expression in parts[1:]:
+        opening = filter_expression.find("(")
+        if opening == -1:
+            name = filter_expression.strip()
+            arguments = ""
+        else:
+            name = filter_expression[:opening].strip()
+            arguments = filter_expression[opening + 1 : -1].strip()
+
+        call = f"_filters[{name!r}]({result}"
+        if arguments:
+            call += f", {arguments}"
+        result = call + ")"
+
+    return result
+
+
+def _to_mako_template(source: str) -> Tuple[str, List[str]]:
+    template: List[str] = []
+    literals: List[str] = []
+    position = 0
+
+    while True:
+        start = source.find("{{", position)
+        if start == -1:
+            literals.append(source[position:])
+            template.append(f"${{_literals[{len(literals) - 1}]}}")
+            break
+
+        literals.append(source[position:start])
+        template.append(f"${{_literals[{len(literals) - 1}]}}")
+        end = source.find("}}", start + 2)
+        if end == -1:
+            literals.append(source[start:])
+            template.append(f"${{_literals[{len(literals) - 1}]}}")
+            break
+
+        expression = _to_mako_expression(source[start + 2 : end].strip())
+        template.append(f"${{{expression}}}")
+        position = end + 2
+
+    return "".join(template), literals
 
