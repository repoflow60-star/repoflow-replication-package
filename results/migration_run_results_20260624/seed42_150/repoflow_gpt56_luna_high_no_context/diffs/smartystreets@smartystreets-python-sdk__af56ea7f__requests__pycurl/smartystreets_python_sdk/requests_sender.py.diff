+def build_curl_response(payload, status_code, headers=None, error=None):
+    if not isinstance(payload, text_type):
+        payload = payload.decode('utf-8', 'replace')
+    return Response(payload, status_code, headers, error)
+
+
+def payload_for_curl(payload):
+    if isinstance(payload, text_type):
+        return payload.encode('utf-8')
+    if isinstance(payload, bytearray):
+        return bytes(payload)
+    return payload
+
+
+def configure_proxy(curl, proxy_url, proxy):
+    curl.setopt(pycurl.PROXY, proxy_url)
+    if proxy.username:
+        curl.setopt(
+            pycurl.PROXYUSERPWD,
+            '{}:{}'.format(proxy.username, proxy.password or ''),
+        )
+
+
+def format_headers(headers):
+    if hasattr(headers, 'items'):
+        return [
+            '{}: {}'.format(key, value)
+            for key, value in headers.items()
+            if value is not None
+        ]
+    return list(headers)
+
+
+def make_header_callback(headers):
+    def receive_header(line):
+        raw_line = line
+        if not isinstance(line, text_type):
+            line = line.decode('iso-8859-1')
+        line = line.rstrip('\r\n')
+        if line.startswith('HTTP/'):
+            headers.clear()
+        elif ':' in line:
+            key, value = line.split(':', 1)
+            headers[key.strip()] = value.strip()
+        return len(raw_line)
+
+    return receive_header
 
 
