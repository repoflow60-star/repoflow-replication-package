+def add_parameters(url, parameters):
+    if not parameters:
+        return url
+
+    if hasattr(parameters, 'items'):
+        parameters = parameters.items()
+    parameters = [(key, value) for key, value in parameters if value is not None]
+    encoded = urlencode(parameters, doseq=True)
+    if not encoded:
+        return url
+
+    scheme, netloc, path, query, fragment = urlsplit(url)
+    if query:
+        query += '&' + encoded
+    else:
+        query = encoded
+    return urlunsplit((scheme, netloc, path, query, fragment))
+
+
 def build_smarty_response(inner_response, error=None):
     return Response(inner_response.text, inner_response.status_code, inner_response.headers, error)
+
