-import matplotlib.pyplot as plt
+import numpy as np
+import plotly.graph_objects as go
 
-from ash_model.measures import *
+from ash_model import ASH
+
+
+_FIGURE_KEYS = {"ax", "fig", "figure"}
+
+
+def _figure(kwargs: dict) -> go.Figure:
+    """Return the supplied Plotly figure, or create one for the plot."""
+    figure = next((kwargs[key] for key in ("fig", "figure", "ax") if key in kwargs), None)
+    if figure is None:
+        return go.Figure()
+    if not isinstance(figure, go.Figure):
+        raise TypeError("fig, figure, or ax must be a plotly.graph_objects.Figure")
+    return figure
+
+
+def _trace_kwargs(kwargs: dict, marker_mode: bool = False) -> dict:
+    """Translate the legacy plotting options used by this module."""
+    options = {key: value for key, value in kwargs.items() if key not in _FIGURE_KEYS}
+
+    if "label" in options:
+        options.setdefault("name", options.pop("label"))
+    if "alpha" in options:
+        options.setdefault("opacity", options.pop("alpha"))
+
+    marker = options.get("marker")
+    if isinstance(marker, str):
+        symbols = {
+            ".": "circle",
+            "o": "circle",
+            "s": "square",
+            "^": "triangle-up",
+            "v": "triangle-down",
+            "+": "cross",
+            "x": "x",
+        }
+        options["marker"] = {"symbol": symbols.get(marker, marker)}
+    elif isinstance(marker, dict):
+        options["marker"] = dict(marker)
+    elif marker_mode:
+        options["marker"] = {}
+
+    color = options.pop("color", None)
+    if color is not None:
+        nested = dict(options.get("marker", {}))
+        nested["color"] = color
+        options["marker"] = nested
+
+    for source in ("markersize", "ms"):
+        if source in options:
+            marker = dict(options.get("marker", {}))
+            marker["size"] = options.pop(source)
+            options["marker"] = marker
+    if "markerfacecolor" in options:
+        marker = dict(options.get("marker", {}))
+        marker["color"] = options.pop("markerfacecolor")
+        options["marker"] = marker
+    if "markeredgecolor" in options:
+        marker = dict(options.get("marker", {}))
+        marker_line = dict(marker.get("line", {}))
+        marker_line["color"] = options.pop("markeredgecolor")
+        marker["line"] = marker_line
+        options["marker"] = marker
+
+    if "linestyle" in options:
+        line = dict(options.get("line", {}))
+        dash = {"-": "solid", "--": "dash", ":": "dot", "-.": "dashdot"}
+        line["dash"] = dash.get(options.pop("linestyle"), "solid")
+        options["line"] = line
+    for source in ("linewidth", "lw"):
+        if source in options:
+            line = dict(options.get("line", {}))
+            line["width"] = options.pop(source)
+            options["line"] = line
+
+    return options
 
 
