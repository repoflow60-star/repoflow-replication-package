+def _style_metric_dataframe(dataframe: pd.DataFrame):
+    """Apply the metric heatmap without requiring a plotting backend."""
+    styles = pd.DataFrame(
+        "", index=dataframe.index, columns=dataframe.columns, dtype=object
+    )
+    for column in dataframe.select_dtypes(include=[np.number]).columns:
+        for index, value in dataframe[column].items():
+            value = min(max(float(value), 0.0), 1.0)
+            red = int(255 * (1.0 - value))
+            green = int(255 * value)
+            styles.loc[index, column] = (
+                f"background-color: rgb({red}, {green}, 0);"
+            )
+    return dataframe.style.apply(lambda _: styles, axis=None)
 
 
