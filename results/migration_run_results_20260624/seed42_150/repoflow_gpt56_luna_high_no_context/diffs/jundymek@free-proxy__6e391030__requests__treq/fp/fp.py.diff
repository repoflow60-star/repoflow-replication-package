+def _wait_for(result):
+    """Resolve a treq Deferred while preserving the package's sync API."""
+    if not isinstance(result, Deferred):
+        return result
+
+    completed = []
+
+    def complete(value):
+        completed.append(value)
+        return value
+
+    result.addBoth(complete)
+    while not completed:
+        reactor.iterate(0.01)
+
+    value = completed[0]
+    if isinstance(value, Failure):
+        value.raiseException()
+    return value
 
 
