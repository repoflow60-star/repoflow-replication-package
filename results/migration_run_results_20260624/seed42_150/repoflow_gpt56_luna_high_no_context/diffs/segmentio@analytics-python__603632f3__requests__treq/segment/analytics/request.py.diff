+class _Headers(dict):
+    def get(self, key, default=None):
+        key = key.lower()
+        for name, value in self.items():
+            if name.lower() == key:
+                return value
+        return default
+
+
+class _TreqResponse(object):
+    """Expose the response attributes used by the synchronous client."""
+
+    def __init__(self, response, content):
+        self.status_code = response.code
+        self.headers = _Headers()
+        for name, values in response.headers.getAllRawHeaders():
+            if values:
+                self.headers[_decode_header(name)] = _decode_header(values[0])
+        self.reason = _decode_header(response.phrase)
+        self.content = content
+
+    def json(self, **kwargs):
+        return json.loads(self.content.decode('utf-8'), **kwargs)
+
+    @property
+    def text(self):
+        return self.content.decode('utf-8', errors='replace')
+
+
+def _decode_header(value):
+    if isinstance(value, bytes):
+        return value.decode('latin-1')
+    return value
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _reactor_thread
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if not reactor.running and _reactor_thread is None:
+            _reactor_ready.clear()
+            _reactor_thread = Thread(target=_run_reactor, daemon=True)
+            _reactor_thread.start()
+    if not reactor.running:
+        _reactor_ready.wait()
+
+
+def _request_on_reactor(method, url, data, headers, timeout):
+    deferred = treq.request(
+        method, url, data=data, headers=headers, timeout=timeout)
+
+    def read_body(response):
+        return treq.content(response).addCallback(
+            lambda content: (response, content))
+
+    return deferred.addCallback(read_body)
+
+
+def _request(method, url, data, headers, timeout):
+    _ensure_reactor()
+    response, content = blockingCallFromThread(
+        reactor, _request_on_reactor, method, url, data, headers, timeout)
+    return _TreqResponse(response, content)
 
 
