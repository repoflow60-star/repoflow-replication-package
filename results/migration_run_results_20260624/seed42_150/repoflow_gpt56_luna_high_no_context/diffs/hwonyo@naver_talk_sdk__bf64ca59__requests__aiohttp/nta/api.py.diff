+    def _run_post(self, data):
+        """Run the async transport without changing the public sync API."""
+        try:
+            asyncio.get_running_loop()
+        except RuntimeError:
+            loop = asyncio.new_event_loop()
+            try:
+                return loop.run_until_complete(self._post(data))
+            finally:
+                loop.close()
+
+        result = []
+        error = []
+
+        def run_in_thread():
+            loop = asyncio.new_event_loop()
+            try:
+                result.append(loop.run_until_complete(self._post(data)))
+            except BaseException as exc:
+                error.append(exc)
+            finally:
+                loop.close()
+
+        thread = threading.Thread(target=run_in_thread)
+        thread.start()
+        thread.join()
+
+        if error:
+            raise error[0]
+        return result[0]
