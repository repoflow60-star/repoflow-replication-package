+    def _request(self, method, url, params=None, body=None, headers=None):
+        if params:
+            query = urlencode(params, doseq=True)
+            url = f'{url}{"&" if "?" in url else "?"}{query}'
+
+        response_body = BytesIO()
+        response_headers = BytesIO()
+        curl = pycurl.Curl()
+        request_headers = [f'Authorization: {self.authorization_header}']
+        request_headers.extend(
+            f'{name}: {value}' for name, value in (headers or {}).items()
+        )
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.HTTPHEADER, request_headers)
+            curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, response_headers.write)
+
+            if method == 'GET':
+                curl.setopt(pycurl.HTTPGET, 1)
+            elif method == 'POST':
+                curl.setopt(pycurl.POST, 1)
+            else:
+                curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+            if body is not None:
+                curl.setopt(pycurl.POSTFIELDS, body.encode('utf-8'))
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            effective_url = curl.getinfo(pycurl.EFFECTIVE_URL) or url
+        finally:
+            curl.close()
+
+        headers, reason = self._parse_response_headers(response_headers.getvalue())
+        return _ResponseData(
+            status_code=status_code,
+            headers=headers,
+            content=response_body.getvalue(),
+            url=effective_url,
+            reason=reason,
+        )
+
+    @staticmethod
+    def _parse_response_headers(raw_headers):
+        headers = {}
+        reason = ''
+        for raw_line in raw_headers.splitlines():
+            line = raw_line.decode('iso-8859-1')
+            if line.startswith('HTTP/'):
+                headers = {}
+                parts = line.split(' ', 2)
+                reason = parts[2] if len(parts) == 3 else ''
+            elif ':' in line:
+                name, value = line.split(':', 1)
+                headers[name.lower()] = value.strip()
+        return headers, reason
