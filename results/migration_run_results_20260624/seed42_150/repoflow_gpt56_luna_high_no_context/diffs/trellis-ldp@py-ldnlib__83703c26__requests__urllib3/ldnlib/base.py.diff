     def __init__(self, **kwargs):
         self.accept_headers = kwargs.get('accept_headers', self.ACCEPT_HEADERS)
 
+    @staticmethod
+    def _pool(verify, cert):
+        if verify in (True, None) and cert is None:
+            return _HTTP
+
+        pool_options = {}
+        if verify is False:
+            pool_options['cert_reqs'] = 'CERT_NONE'
+        elif isinstance(verify, str):
+            pool_options['ca_certs'] = verify
+
+        if cert is not None:
+            if isinstance(cert, (tuple, list)):
+                pool_options['cert_file'] = cert[0]
+                pool_options['key_file'] = cert[1]
+            else:
+                pool_options['cert_file'] = cert
+
+        return urllib3.PoolManager(**pool_options)
+
+    def _request(self, method, url, **kwargs):
+        headers = dict(kwargs.pop('headers', {}) or {})
+        params = kwargs.pop('params', None)
+        auth = kwargs.pop('auth', None)
+        allow_redirects = kwargs.pop('allow_redirects', True)
+        data = kwargs.pop('data', None)
+        json_data = kwargs.pop('json', None)
+        verify = kwargs.pop('verify', True)
+        cert = kwargs.pop('cert', None)
+        stream = kwargs.pop('stream', False)
+
+        if params:
+            query = params if isinstance(params, str) else urlencode(
+                [(key, value) for key, value in params if value is not None]
+                if isinstance(params, (list, tuple)) else
+                [(key, value) for key, value in params.items()
+                 if value is not None], doseq=True)
+            parts = urlsplit(url)
+            if parts.query:
+                query = '{}&{}'.format(parts.query, query)
+            url = urlunsplit((parts.scheme, parts.netloc, parts.path,
+                              query, parts.fragment))
+
+        if auth is not None and not any(
+                key.lower() == 'authorization' for key in headers):
+            if isinstance(auth, (tuple, list)) and len(auth) == 2:
+                headers.update(make_headers(
+                    basic_auth='{}:{}'.format(auth[0], auth[1])))
+
+        if json_data is not None and data is None:
+            data = json.dumps(json_data)
+            if not any(key.lower() == 'content-type' for key in headers):
+                headers['content-type'] = 'application/json'
+
+        if data is not None:
+            if isinstance(data, (dict, list, tuple)):
+                if isinstance(data, dict):
+                    data = [(key, value) for key, value in data.items()
+                            if value is not None]
+                else:
+                    data = [(key, value) for key, value in data
+                            if value is not None]
+                data = urlencode(data, doseq=True)
+                if not any(key.lower() == 'content-type'
+                           for key in headers):
+                    headers['content-type'] = (
+                        'application/x-www-form-urlencoded')
+            kwargs['body'] = data
+
+        timeout = kwargs.get('timeout')
+        if isinstance(timeout, (tuple, list)):
+            kwargs['timeout'] = Timeout(connect=timeout[0], read=timeout[1])
+
+        kwargs['redirect'] = allow_redirects
+        kwargs['preload_content'] = not stream
+        return self._pool(verify, cert).request(method, url, headers=headers,
+                                                **kwargs)
