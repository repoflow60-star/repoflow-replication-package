+def _http_request(method, url, input_options=None, fields=None, redirect=None,
+                  encode_multipart=True):
+    """Make an HTTP request with the options used by the input API."""
+    verify_ssl = input_options is None or input_options.verify_ssl
+    pool = urllib3.PoolManager(
+        cert_reqs=ssl.CERT_REQUIRED if verify_ssl else ssl.CERT_NONE
+    )
+    if redirect is None:
+        redirect = method.upper() != 'HEAD'
+    request_options = {
+        'headers': input_options.http_headers if input_options else None,
+        'fields': fields,
+        'timeout': input_options.timeout if input_options else None,
+        'preload_content': True,
+        'decode_content': True,
+        'redirect': redirect,
+    }
+    if fields is not None and method.upper() not in ('GET', 'HEAD'):
+        request_options['encode_multipart'] = encode_multipart
+    return pool.request(method, url, **request_options)
+
+
+def _raise_for_status(response):
+    """Raise an HTTP error for an unsuccessful response."""
+    if response.status >= 400:
+        raise urllib3.exceptions.HTTPError(
+            'HTTP {} {}'.format(response.status, response.reason or '')
+        )
+
+
+def _response_json(response):
+    """Decode JSON from an urllib3 response."""
+    return json.loads(response.data)
 
