+_reactor_lock = Lock()
+_reactor_ready = Event()
+_reactor_thread = None
+_reactor_error = None
+
+
+def _run_reactor():
+    global _reactor_error
+
+    try:
+        reactor.callWhenRunning(_reactor_ready.set)
+        reactor.run(installSignalHandlers=False)
+    except Exception as error:
+        _reactor_error = error
+    finally:
+        _reactor_ready.set()
+
+
+def _ensure_reactor_running():
+    global _reactor_error, _reactor_thread
+
+    if reactor.running:
+        return
+
+    with _reactor_lock:
+        if reactor.running:
+            return
+
+        if _reactor_thread is None or not _reactor_thread.is_alive():
+            _reactor_ready.clear()
+            _reactor_error = None
+            _reactor_thread = Thread(target=_run_reactor, daemon=True)
+            _reactor_thread.start()
+
+    _reactor_ready.wait()
+    if _reactor_error is not None:
+        raise _reactor_error
+    if not reactor.running:
+        raise RuntimeError("The Twisted reactor is not running")
+
+
+def _make_headers(headers):
+    values = {}
+    for name, value in headers.items():
+        header_values = value if isinstance(value, (list, tuple)) else [value]
+        encoded_name = name if isinstance(name, bytes) else name.encode("ascii")
+        values[encoded_name] = [
+            item if isinstance(item, bytes) else str(item).encode("utf-8")
+            for item in header_values
+        ]
+    return Headers(values)
+
