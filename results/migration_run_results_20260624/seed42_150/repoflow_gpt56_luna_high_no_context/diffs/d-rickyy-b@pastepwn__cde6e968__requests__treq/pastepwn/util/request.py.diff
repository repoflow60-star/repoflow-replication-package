+def _host_matches_no_proxy(hostname, port, no_proxy):
+    hostname = hostname.lower()
+    for entry in no_proxy.split(","):
+        entry = entry.strip().lower()
+        if not entry:
+            continue
+        if entry == "*":
+            return True
+
+        entry_host = entry
+        entry_port = None
+        if entry.count(":") == 1:
+            entry_host, entry_port = entry.rsplit(":", 1)
+        if entry_port and str(port) != entry_port:
+            continue
+
+        entry_host = entry_host.lstrip(".").strip("[]")
+        if hostname == entry_host or hostname.endswith("." + entry_host):
+            return True
+    return False
 
 
