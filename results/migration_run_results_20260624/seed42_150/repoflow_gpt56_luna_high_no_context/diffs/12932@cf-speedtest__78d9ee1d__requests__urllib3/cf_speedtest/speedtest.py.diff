 PROXY_DICT = None
 VERIFY_SSL = True
 OUTPUT_FILE = None
+
+
+class _HTTPClient:
+    def __init__(self, manager):
+        self._manager = manager
+
+    def request(self, method, url, **kwargs):
+        return self._manager.request(method, url, **kwargs)
+
+    def get(self, url, **kwargs):
+        return self.request('GET', url, **kwargs)
+
+    def post(self, url, data=None, **kwargs):
+        if data is not None:
+            kwargs['body'] = data
+        return self.request('POST', url, **kwargs)
+
+
+def _create_session(proxy_dict=None, verify_ssl=True):
+    cert_reqs = ssl.CERT_REQUIRED if verify_ssl else ssl.CERT_NONE
+
+    if proxy_dict:
+        proxy_url = proxy_dict.get('https') or proxy_dict.get('http')
+        if proxy_url.startswith('socks'):
+            from urllib3.contrib.socks import SOCKSProxyManager
+
+            manager = SOCKSProxyManager(proxy_url, cert_reqs=cert_reqs)
+        else:
+            manager = urllib3.ProxyManager(proxy_url, cert_reqs=cert_reqs)
+    else:
+        manager = urllib3.PoolManager(cert_reqs=cert_reqs)
+
+    return _HTTPClient(manager)
+
+
+REQ_SESSION = _create_session()
+
+
+def _request(method, url, **kwargs):
+    if method == 'POST':
+        response = REQ_SESSION.post(url, **kwargs)
+    else:
+        response = REQ_SESSION.get(url, **kwargs)
+
+    status = getattr(response, 'status', None)
+    if isinstance(status, int) and status >= 400:
+        raise urllib3.exceptions.HTTPError(
+            f'{status} response received from the speed test endpoint',
+        )
+    return response
+
+
+def _response_data(response):
+    data = getattr(response, 'data', None)
+    if isinstance(data, (bytes, bytearray)):
+        return data
+    return getattr(response, 'content', data)
 
