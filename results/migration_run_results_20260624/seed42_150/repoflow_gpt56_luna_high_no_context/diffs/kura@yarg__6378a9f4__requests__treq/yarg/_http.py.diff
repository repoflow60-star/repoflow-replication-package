+import threading
+
+from twisted.internet import reactor
+from twisted.internet.defer import maybeDeferred
+from twisted.python.failure import Failure
+
+
+_reactor_lock = threading.Lock()
+_reactor_ready = threading.Event()
+_reactor_started = False
+_reactor_thread_id = None
+
+
+def _ensure_reactor():
+    global _reactor_started
+    global _reactor_thread_id
+
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_started:
+            raise RuntimeError("The Twisted reactor has stopped")
+        _reactor_started = True
+
+        def start_reactor():
+            global _reactor_thread_id
+            _reactor_thread_id = threading.get_ident()
+            _reactor_ready.set()
+            reactor.run(installSignalHandlers=False)
+
+        thread = threading.Thread(target=start_reactor)
+        thread.daemon = True
+        thread.start()
+        _reactor_ready.wait()
+
+
+def run(function, *args, **kwargs):
+    """Run a treq Deferred and return its result synchronously."""
+    _ensure_reactor()
+    if threading.get_ident() == _reactor_thread_id:
+        raise RuntimeError("Synchronous HTTP calls cannot run in the reactor")
+
+    result = []
+    complete = threading.Event()
+
+    def succeeded(value):
+        result.append(value)
+        complete.set()
+        return value
+
+    def failed(failure):
+        result.append(failure)
+        complete.set()
+        return failure
+
+    def invoke():
+        maybeDeferred(function, *args, **kwargs).addCallbacks(
+            succeeded, failed)
+
+    reactor.callFromThread(invoke)
+    complete.wait()
+    value = result[0]
+    if isinstance(value, Failure):
+        value.raiseException()
+    return value
