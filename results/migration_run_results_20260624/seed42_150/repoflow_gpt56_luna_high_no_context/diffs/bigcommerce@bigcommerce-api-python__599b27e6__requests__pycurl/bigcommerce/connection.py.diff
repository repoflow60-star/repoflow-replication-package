+class _ResponseHeaders(dict):
+    """Dictionary with the case-insensitive lookup behavior of response headers."""
+
+    def _key(self, key):
+        key_lower = key.lower()
+        for existing_key in self:
+            if existing_key.lower() == key_lower:
+                return existing_key
+        raise KeyError(key)
+
+    def __contains__(self, key):
+        try:
+            self._key(key)
+        except KeyError:
+            return False
+        return True
+
+    def __getitem__(self, key):
+        return super(_ResponseHeaders, self).__getitem__(self._key(key))
+
+    def get(self, key, default=None):
+        try:
+            return self[key]
+        except KeyError:
+            return default
+
+
+class _PycurlResponse(object):
+    def __init__(self, status_code, reason, content, headers):
+        self.status_code = status_code
+        self.reason = reason
+        self.content = content
+        self.headers = headers
+
+    def json(self):
+        return loads(self.content.decode('utf-8'))
+
+
+class _PycurlSession(object):
+    """Small session facade retaining the connection module's existing contract."""
+
+    def __init__(self):
+        self.auth = None
+        self.headers = {}
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        curl = pycurl.Curl()
+        body = io.BytesIO()
+        response_headers = _ResponseHeaders()
+        status_line = [""]
+
+        def receive_header(header):
+            line = header.decode('iso-8859-1').rstrip('\r\n')
+            if line.startswith('HTTP/'):
+                # A new status line also starts a new header block (for example,
+                # when a proxy sends an interim 100 response).
+                response_headers.clear()
+                status_line[0] = line
+            elif ':' in line:
+                name, value = line.split(':', 1)
+                response_headers[name] = value.strip()
+            return len(header)
+
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            curl.setopt(pycurl.TIMEOUT, timeout)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.HTTPHEADER,
+                        ['%s: %s' % (name, value) for name, value in request_headers.items()])
+            curl.setopt(pycurl.WRITEFUNCTION, body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, receive_header)
+
+            if self.auth is not None:
+                username, password = self.auth
+                curl.setopt(pycurl.HTTPAUTH, pycurl.AUTH_BASIC)
+                curl.setopt(pycurl.USERPWD, '%s:%s' % (username, password))
+
+            if data is not None:
+                if isinstance(data, dict):
+                    data = urlencode(data)
+                if isinstance(data, str):
+                    data = data.encode('utf-8')
+                curl.setopt(pycurl.POSTFIELDS, data)
+
+            if hasattr(pycurl, 'ACCEPT_ENCODING'):
+                for name, value in request_headers.items():
+                    if name.lower() == 'accept-encoding':
+                        curl.setopt(pycurl.ACCEPT_ENCODING, value)
+                        break
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            status_parts = status_line[0].split(' ', 2)
+            reason = status_parts[2] if len(status_parts) > 2 else ''
+            return _PycurlResponse(status_code, reason, body.getvalue(), response_headers)
+        finally:
+            curl.close()
 
 
