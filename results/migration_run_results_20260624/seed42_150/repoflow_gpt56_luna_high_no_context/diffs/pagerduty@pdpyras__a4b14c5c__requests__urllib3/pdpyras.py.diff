+class _ResponseAdapter:
+    """Expose the response attributes used by the public client API."""
+
+    def __init__(self, response, method, url, elapsed):
+        self.raw = response
+        self.status_code = getattr(response, 'status_code',
+            getattr(response, 'status', 0))
+        self.ok = getattr(response, 'ok', self.status_code < 400)
+        self.headers = getattr(response, 'headers', {})
+        request = getattr(response, 'request', None)
+        self.request = request or SimpleNamespace(method=method, url=url)
+        self.url = getattr(response, 'url', url)
+        self.elapsed = getattr(response, 'elapsed',
+            timedelta(seconds=elapsed))
+
+    @property
+    def text(self) -> str:
+        text = getattr(self.raw, 'text', None)
+        if text is not None:
+            return text
+        content = getattr(self.raw, 'data', b'')
+        if content is None:
+            return ''
+        if isinstance(content, bytes):
+            return content.decode('utf-8', errors='replace')
+        return str(content)
+
+    @property
+    def content(self):
+        content = getattr(self.raw, 'content', None)
+        if content is not None:
+            return content
+        data = getattr(self.raw, 'data', None)
+        if data is not None:
+            return data
+        return self.text.encode('utf-8')
+
+    def json(self):
+        json_method = getattr(self.raw, 'json', None)
+        if callable(json_method):
+            return json_method()
+        return json.loads(self.text)
+
+    def close(self):
+        close = getattr(self.raw, 'close', None)
+        if callable(close):
+            close()
+
+    def __getattr__(self, name):
+        return getattr(self.raw, name)
+
+
+def response_request_info(response):
+    """Return the method and URL associated with an HTTP response."""
+    request = getattr(response, 'request', None)
+    if request is not None:
+        return getattr(request, 'method', ''), getattr(request, 'url', '')
+    return (
+        getattr(response, '_pdpyras_request_method', ''),
+        getattr(response, '_pdpyras_request_url', ''),
+    )
+
+
+def response_status_code(response) -> int:
+    """Return the status code used by a response object."""
+    status_code = getattr(response, 'status_code', None)
+    if status_code is not None:
+        return status_code
+    return getattr(response, 'status', 0)
+
+
+def response_is_ok(response) -> bool:
+    """Return whether a response has a successful HTTP status."""
+    ok = getattr(response, 'ok', None)
+    if ok is not None:
+        return ok
+    return response_status_code(response) < 400
+
+
+def response_text(response) -> str:
+    """Return a response body as text."""
+    text = getattr(response, 'text', None)
+    if text is not None:
+        return text
+    content = getattr(response, 'data', b'')
+    if content is None:
+        return ''
+    if isinstance(content, bytes):
+        return content.decode('utf-8', errors='replace')
+    return str(content)
+
+
