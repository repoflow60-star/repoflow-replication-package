+    def _make_post_request(request_url: str, data: dict, **kwargs) -> Tuple[int, bytes]:
+        headers = kwargs.pop('headers', {}) or {}
+        timeout = kwargs.pop('timeout', 10)
+        allow_redirects = kwargs.pop('allow_redirects', True)
+        verify = kwargs.pop('verify', True)
+
+        response_buffer = BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, request_url)
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, json.dumps(data).encode('utf-8'))
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                [f'{key}: {value}' for key, value in headers.items()]
+            )
+            curl.setopt(pycurl.FOLLOWLOCATION, int(bool(allow_redirects)))
+
+            verify_enabled = verify is None or bool(verify)
+            curl.setopt(pycurl.SSL_VERIFYPEER, int(verify_enabled))
+            curl.setopt(pycurl.SSL_VERIFYHOST, 2 if verify_enabled else 0)
+            if isinstance(verify, str):
+                curl.setopt(pycurl.CAINFO, verify)
+
+            if isinstance(timeout, tuple):
+                if timeout[0] is not None:
+                    curl.setopt(pycurl.CONNECTTIMEOUT, timeout[0])
+                if timeout[1] is not None:
+                    curl.setopt(pycurl.TIMEOUT, timeout[1])
+            elif timeout is not None:
+                curl.setopt(pycurl.TIMEOUT, timeout)
+
+            curl.setopt(pycurl.WRITEFUNCTION, response_buffer.write)
+            curl.perform()
+            return curl.getinfo(pycurl.RESPONSE_CODE), response_buffer.getvalue()
+        finally:
+            curl.close()
 
