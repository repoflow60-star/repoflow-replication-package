+) -> _Cipher:
+    if len(key) not in {8, 16, 24}:
+        cipher = (
+            _DES3.new(key, mode, iv=iv)
+            if iv is not None
+            else _DES3.new(key, mode)
+        )
+        return _typing.cast(_Cipher, cipher)
