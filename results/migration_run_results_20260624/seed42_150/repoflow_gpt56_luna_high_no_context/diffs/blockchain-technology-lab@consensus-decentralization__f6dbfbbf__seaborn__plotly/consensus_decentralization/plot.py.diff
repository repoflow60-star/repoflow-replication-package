+def _get_colors(number):
+    if number == 0:
+        return []
+    positions = [0.5] if number == 1 else np.linspace(0, 1, number)
+    return plotly_colors.sample_colorscale('Viridis', positions)
+
+
+def _set_tick_labels(figure, labels):
+    tick_values = list(range(0, len(labels), 5))
+    figure.update_xaxes(
+        tickmode='array',
+        tickvals=tick_values,
+        ticktext=[labels[index] for index in tick_values],
+        tickangle=45,
+    )
+
+
+def _write_animated_gif(figures, filename):
+    images = [
+        Image.open(BytesIO(figure.to_image(format='png', width=1000, height=600))).convert('RGBA')
+        for figure in figures
+    ]
+    if not images:
+        return
+    images[0].save(
+        filename,
+        save_all=True,
+        append_images=images[1:],
+        duration=100,
+        loop=0,
+    )
+
+
+def _make_line_figure(x_values, data, x_label, y_label, colors, title=''):
+    figure = go.Figure()
+    for index, column in enumerate(data.columns):
+        figure.add_trace(go.Scatter(
+            x=x_values,
+            y=data[column],
+            mode='lines',
+            name=column,
+            line={'color': colors[index]},
+        ))
+    figure.update_layout(
+        title=title,
+        xaxis_title=x_label,
+        yaxis_title=y_label,
+        showlegend=True,
+        template='plotly_white',
+        width=1000,
+        height=600,
+    )
+    return figure
+
+
+def _make_stack_figure(values, x_values, ylabel, legend_labels, colors, legend):
+    figure = go.Figure()
+    for index, label in enumerate(legend_labels):
+        figure.add_trace(go.Scatter(
+            x=x_values,
+            y=values[index],
+            mode='lines',
+            name=label,
+            stackgroup='one',
+            line={'color': colors[index], 'width': 1},
+            showlegend=legend and not label.startswith('_'),
+        ))
+    figure.update_layout(
+        xaxis_title='Time',
+        yaxis_title=ylabel,
+        template='plotly_white',
+        width=600,
+        height=400,
+        margin={'l': 60, 'r': 30, 't': 30, 'b': 100},
+    )
+    return figure
 
 
