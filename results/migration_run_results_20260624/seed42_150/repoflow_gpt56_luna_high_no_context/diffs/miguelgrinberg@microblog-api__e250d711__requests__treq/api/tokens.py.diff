+_reactor_lock = threading.Lock()
+_reactor_ready = threading.Event()
+_reactor_starting = False
+
+
+def _run_reactor():
+    global _reactor_starting
+    try:
+        reactor.run(installSignalHandlers=False)
+    finally:
+        with _reactor_lock:
+            _reactor_starting = False
+
+
+def _ensure_reactor():
+    global _reactor_starting
+    if reactor.running:
+        _reactor_ready.set()
+        return
+    with _reactor_lock:
+        if reactor.running:
+            _reactor_ready.set()
+        elif not _reactor_starting:
+            _reactor_starting = True
+            reactor.callWhenRunning(_reactor_ready.set)
+            threading.Thread(
+                target=_run_reactor,
+                daemon=True).start()
+    _reactor_ready.wait()
+
+
+def _request_json(method, url, data=None, headers=None):
+    """Run a treq request synchronously for a Flask view."""
+    _ensure_reactor()
+    completed = threading.Event()
+    result = {}
+
+    def read_response(response):
+        result['status_code'] = response.code
+        reader = treq.json_content if response.code == 200 else treq.content
+        return reader(response)
+
+    def save_body(body):
+        result['body'] = body
+        completed.set()
+        return body
+
+    def request_failed(failure):
+        result['error'] = failure.value
+        completed.set()
+        return None
+
+    def issue_request():
+        request_function = treq.post if method == 'POST' else treq.get
+        request_headers = Headers({
+            name.encode('ascii'): [value.encode('ascii')]
+            for name, value in (headers or {}).items()
+        })
+        request_args = {'headers': request_headers}
+        if data is not None:
+            request_args['data'] = data
+        request = defer.maybeDeferred(request_function, url, **request_args)
+        request.addCallback(read_response)
+        request.addCallback(save_body)
+        request.addErrback(request_failed)
+
+    reactor.callFromThread(issue_request)
+    completed.wait()
+    if 'error' in result:
+        raise result['error']
+    return result
 
 
