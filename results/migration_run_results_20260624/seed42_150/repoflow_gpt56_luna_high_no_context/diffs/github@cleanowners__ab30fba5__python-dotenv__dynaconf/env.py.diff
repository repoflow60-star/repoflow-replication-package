+from dynaconf import Dynaconf
+
+
+DOTENV_PATH = join(dirname(__file__), ".env")
+
+
+def _settings(load_dotenv: bool = False) -> Dynaconf:
+    """Create settings backed by the process environment and optional .env file."""
+    return Dynaconf(
+        envvar_prefix=False,
+        load_dotenv=load_dotenv,
+        dotenv_path=DOTENV_PATH,
+        auto_cast_for_dynaconf=False,
+    )
+
+
+def _get_bool(settings: Dynaconf, env_var_name: str, default: bool = False) -> bool:
+    value = settings.get(env_var_name, default="")
+    if value is None or value == "":
+        return default
+    if isinstance(value, bool):
+        return value
+    return str(value).strip().lower() == "true"
+
+
+def _get_int(settings: Dynaconf, env_var_name: str) -> int | None:
+    value = settings.get(env_var_name)
+    if value is None or not str(value).strip():
+        return None
+    try:
+        return int(value)
+    except (TypeError, ValueError):
+        return None
 
 
