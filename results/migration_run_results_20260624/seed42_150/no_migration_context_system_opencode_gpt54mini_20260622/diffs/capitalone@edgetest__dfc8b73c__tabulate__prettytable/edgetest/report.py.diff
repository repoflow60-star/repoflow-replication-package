+
+def _build_table(headers: List[str], rows: List[List[Any]]) -> PrettyTable:
+    table = PrettyTable()
+    table.field_names = headers
+    table.align = "l"
+
+    for row in rows:
+        table.add_row(row)
+
+    return table
+
+
+def _column_widths(headers: List[str], rows: List[List[str]]) -> List[int]:
+    widths = [len(str(header)) for header in headers]
+
+    for row in rows:
+        for index, cell in enumerate(row):
+            widths[index] = max(widths[index], len(cell))
+
+    return widths
+
+
+def _render_rst(headers: List[str], rows: List[List[str]]) -> str:
+    widths = _column_widths(headers, rows)
+    separator = "  ".join("=" * width for width in widths)
+    divider = "  ".join("-" * width for width in widths)
+    header = "  ".join(
+        str(name).ljust(width) for name, width in zip(headers, widths)
+    )
+
+    if not rows:
+        return "\n".join([separator, header, separator])
+
+    body = [
+        "  ".join(cell.ljust(width) for cell, width in zip(row, widths))
+        for row in rows
+    ]
+    return "\n".join([separator, header, divider, *body, separator])
+
+
+def _render_github(headers: List[str], rows: List[List[str]]) -> str:
+    widths = _column_widths(headers, rows)
+    header = "| " + " | ".join(
+        str(name).ljust(width) for name, width in zip(headers, widths)
+    ) + " |"
+    separator = "|" + "|".join("-" * (width + 2) for width in widths) + "|"
+
+    if not rows:
+        return "\n".join([header, separator])
+
+    body = [
+        "| " + " | ".join(cell.ljust(width) for cell, width in zip(row, widths)) + " |"
+        for row in rows
+    ]
+    return "\n".join([header, separator, *body])
+
+
+def tabulate(rows: List[List[Any]], headers: List[str], tablefmt: str = "rst") -> str:
+    table = _build_table(headers, rows)
+    rendered_rows = [[str(cell) for cell in row] for row in table._rows]
+
+    if tablefmt == "rst":
+        return _render_rst(headers, rendered_rows)
+
+    if tablefmt == "github":
+        return _render_github(headers, rendered_rows)
+
+    raise ValueError(f"Invalid tablefmt provided: {tablefmt}")
 
 
