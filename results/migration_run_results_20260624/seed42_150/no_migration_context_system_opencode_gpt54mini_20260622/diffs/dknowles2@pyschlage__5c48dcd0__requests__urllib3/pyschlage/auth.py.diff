+@dataclass
+class _Request:
+    method: str = ""
+    url: str = ""
+    headers: dict[str, str] = field(default_factory=dict)
+    body: Any = None
+    data: Any = None
+    params: dict[str, Any] | None = None
+
+    @property
+    def path_url(self) -> str:
+        parts = urlsplit(self.url)
+        path = parts.path or "/"
+        if parts.query:
+            return f"{path}?{parts.query}"
+        return path
+
+    def prepare(self) -> "_Request":
+        return self
+
+
+@dataclass
+class _Response:
+    response: urllib3.response.HTTPResponse
+
+    def _encoding(self) -> str:
+        content_type = self.response.headers.get("content-type", "")
+        for item in content_type.split(";"):
+            item = item.strip()
+            if item.lower().startswith("charset="):
+                return item.split("=", 1)[1].strip()
+        return "utf-8"
+
+    @property
+    def status(self) -> int:
+        return self.response.status
+
+    @property
+    def status_code(self) -> int:
+        return self.response.status
+
+    @property
+    def reason(self) -> str:
+        reason = getattr(self.response, "reason", "")
+        return "" if reason is None else str(reason)
+
+    @property
+    def headers(self):
+        return self.response.headers
+
+    @property
+    def content(self) -> bytes:
+        return self.response.data
+
+    @property
+    def text(self) -> str:
+        return self.response.data.decode(self._encoding(), errors="replace")
+
+    @property
+    def ok(self) -> bool:
+        return self.status < 400
+
+    def json(self) -> Any:
+        payload = self.response.data
+        if not payload:
+            raise ValueError("No JSON content")
+        return json.loads(payload.decode(self._encoding()))
+
+    def raise_for_status(self) -> None:
+        if self.status >= 400:
+            raise Urllib3HTTPError(f"{self.status} {self.reason}")
+
+    def __bool__(self) -> bool:
+        return self.ok
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self.response, name)
+
+
+def _build_url(base_url: str, path: str, params: dict[str, Any] | None = None) -> str:
+    url = f"{base_url.rstrip('/')}/{path.lstrip('/')}"
+    if not params:
+        return url
+    query = urlencode(params, doseq=True)
+    separator = "&" if "?" in url else "?"
+    return f"{url}{separator}{query}"
+
