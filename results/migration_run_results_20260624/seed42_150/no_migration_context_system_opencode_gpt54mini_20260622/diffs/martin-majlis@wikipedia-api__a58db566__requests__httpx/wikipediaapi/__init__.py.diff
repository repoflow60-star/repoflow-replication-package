+def _client_kwargs(kwargs: dict[str, Any]) -> dict[str, Any]:
+    client_kwargs = dict(kwargs)
+    proxies = client_kwargs.pop("proxies", None)
+    if proxies is None:
+        return client_kwargs
+
+    if isinstance(proxies, str):
+        client_kwargs["proxy"] = proxies
+        return client_kwargs
+
+    if isinstance(proxies, dict):
+        proxy_map = {
+            scheme: proxy
+            for scheme, proxy in proxies.items()
+            if scheme in {"http", "https"} and proxy
+        }
+        if len(proxy_map) == 1:
+            proxy_map.setdefault(
+                "https" if "http" in proxy_map else "http",
+                next(iter(proxy_map.values())),
+            )
+        if proxy_map:
+            client_kwargs["mounts"] = {
+                f"{scheme}://": httpx.HTTPTransport(proxy=proxy)
+                for scheme, proxy in proxy_map.items()
+            }
+        return client_kwargs
+
+    client_kwargs["proxy"] = proxies
+    return client_kwargs
+
