+def _prepare_headers(headers=None):
+    if headers is not None:
+        return dict(headers)
+
+    request_headers = dict(config.HEADERS)
+    request_headers['Filestack-Trace-Id'] = '{}-{}'.format(int(time.time()), unique_id())
+    request_headers['Filestack-Trace-Span'] = 'pythonsdk-{}'.format(unique_id())
+    return request_headers
+
+
+def _append_params(url, params=None):
+    if not params:
+        return url
+
+    parts = list(urlsplit(url))
+    query = parts[3]
+    encoded_params = urlencode(params, doseq=True)
+    parts[3] = '&'.join(part for part in (query, encoded_params) if part)
+    return urlunsplit(parts)
+
+
+def _encode_multipart(data=None, files=None):
+    boundary = '----filestack-python-{}'.format(unique_id(16))
+    body = io.BytesIO()
+
+    def write_line(value):
+        if isinstance(value, bytes):
+            body.write(value)
+        else:
+            body.write(str(value).encode('utf-8'))
+
+    def write_field(name, value):
+        if isinstance(value, bool):
+            value = str(value).lower()
+        elif not isinstance(value, (str, bytes)):
+            value = str(value)
+
+        write_line('--{}\r\n'.format(boundary))
+        write_line('Content-Disposition: form-data; name="{}"\r\n\r\n'.format(name))
+        write_line(value)
+        write_line('\r\n')
+
+    def read_file_value(file_value):
+        if hasattr(file_value, 'read'):
+            return file_value.read()
+        return file_value
+
+    if data:
+        for key, value in data.items():
+            write_field(key, value)
+
+    if files:
+        for field_name, file_value in files.items():
+            filename = field_name
+            content_type = 'application/octet-stream'
+            file_data = file_value
+
+            if isinstance(file_value, tuple):
+                if len(file_value) > 0:
+                    filename = file_value[0]
+                if len(file_value) > 1:
+                    file_data = file_value[1]
+                if len(file_value) > 2 and file_value[2]:
+                    content_type = file_value[2]
+
+            file_data = read_file_value(file_data)
+            if isinstance(file_data, str):
+                file_data = file_data.encode('utf-8')
+
+            write_line('--{}\r\n'.format(boundary))
+            write_line(
+                'Content-Disposition: form-data; name="{}"; filename="{}"\r\n'.format(field_name, filename)
+            )
+            write_line('Content-Type: {}\r\n\r\n'.format(content_type))
+            write_line(file_data)
+            write_line('\r\n')
+
+    write_line('--{}--\r\n'.format(boundary))
+    return body.getvalue(), 'multipart/form-data; boundary={}'.format(boundary)
+
