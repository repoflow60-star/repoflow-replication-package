--- a/yarg/_http.py
+++ b/yarg/_http.py
@@ -0,0 +1,41 @@
+# -*- coding: utf-8 -*-
+
+from http.client import responses
+from io import BytesIO
+
+import pycurl
+
+
+def _header_collector(headers):
+    def collect(line):
+        headers.append(line)
+        return len(line)
+
+    return collect
+
+
+def _reason_from_headers(headers, status_code):
+    for line in headers:
+        if line.startswith(b"HTTP/"):
+            parts = line.decode("iso-8859-1", "replace").strip().split(None, 2)
+            if len(parts) >= 3:
+                return parts[2]
+    return responses.get(status_code, "")
+
+
+def request(url):
+    body = BytesIO()
+    headers = []
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.ACCEPT_ENCODING, "")
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, _header_collector(headers))
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        reason = _reason_from_headers(headers, status_code)
+        return body.getvalue(), status_code, reason
+    finally:
+        curl.close()
