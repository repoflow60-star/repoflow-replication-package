+
+_reactor_lock = threading.Lock()
+_reactor_ready = threading.Event()
+_reactor_started = False
+
+
+def _ensure_reactor_running():
+    global _reactor_started
+    if _reactor_started:
+        return
+    if reactor.running:
+        _reactor_started = True
+        _reactor_ready.set()
+        return
+    with _reactor_lock:
+        if _reactor_started:
+            return
+        if reactor.running:
+            _reactor_started = True
+            _reactor_ready.set()
+            return
+
+        def run_reactor():
+            reactor.callWhenRunning(_reactor_ready.set)
+            reactor.run(installSignalHandlers=False)
+
+        threading.Thread(target=run_reactor, daemon=True).start()
+        _reactor_ready.wait()
+        _reactor_started = True
+
+
+def _call_in_reactor(func, *args, **kwargs):
+    _ensure_reactor_running()
+    return threads.blockingCallFromThread(reactor, func, *args, **kwargs)
 
 
