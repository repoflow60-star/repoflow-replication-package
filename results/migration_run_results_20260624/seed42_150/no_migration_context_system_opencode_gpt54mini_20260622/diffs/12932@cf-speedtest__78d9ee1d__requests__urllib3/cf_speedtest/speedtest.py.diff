+def _response_body_bytes(response) -> bytes:
+    body = response.__dict__.get('data')
+    if isinstance(body, (bytes, bytearray, memoryview)):
+        return bytes(body)
+
+    body = response.__dict__.get('content')
+    if isinstance(body, (bytes, bytearray, memoryview)):
+        return bytes(body)
+
+    body = getattr(response, 'data', None)
+    if isinstance(body, (bytes, bytearray, memoryview)):
+        return bytes(body)
+
+    body = getattr(response, 'content', None)
+    if isinstance(body, (bytes, bytearray, memoryview)):
+        return bytes(body)
+
+    return b''
+
+
+def _response_text(response) -> str:
+    text = response.__dict__.get('text')
+    if isinstance(text, str):
+        return text
+
+    body = _response_body_bytes(response)
+    if body:
+        return body.decode('utf-8')
+
+    text = getattr(response, 'text', None)
+    if isinstance(text, str):
+        return text
+
+    return ''
+
+
+def _raise_for_status(response, method: str, url: str) -> None:
+    status = getattr(response, 'status', None)
+    if not isinstance(status, int):
+        status = getattr(response, 'status_code', None)
+
+    if isinstance(status, int) and status >= 400:
+        raise urllib3.exceptions.HTTPError(f'HTTP {status} for {method} {url}')
+
+
+def build_http_pool():
+    global _HTTP_POOL, _HTTP_POOL_KEY
+
+    proxy_items = None
+    if PROXY_DICT:
+        proxy_items = tuple(sorted(PROXY_DICT.items()))
+
+    pool_key = (VERIFY_SSL, proxy_items)
+    if _HTTP_POOL is not None and _HTTP_POOL_KEY == pool_key:
+        return _HTTP_POOL
+
+    cert_reqs = ssl.CERT_REQUIRED if VERIFY_SSL else ssl.CERT_NONE
+    pool_kwargs = {'cert_reqs': cert_reqs}
+
+    if not VERIFY_SSL:
+        pool_kwargs['assert_hostname'] = False
+
+    if not PROXY_DICT:
+        pool = urllib3.PoolManager(**pool_kwargs)
+    else:
+        proxy_url = next(iter(PROXY_DICT.values()))
+        if proxy_url.startswith('socks'):
+            from urllib3.contrib.socks import SOCKSProxyManager
+
+            pool = SOCKSProxyManager(proxy_url, **pool_kwargs)
+        else:
+            pool = urllib3.ProxyManager(proxy_url, **pool_kwargs)
+
+    _HTTP_POOL = pool
+    _HTTP_POOL_KEY = pool_key
+    return pool
+
+
+class Urllib3Session:
+    def request(self, method: str, url: str, **kwargs):
+        kwargs = dict(kwargs)
+        kwargs.pop('verify', None)
+        kwargs.pop('proxies', None)
+
+        if 'data' in kwargs and 'body' not in kwargs:
+            kwargs['body'] = kwargs.pop('data')
+
+        response = build_http_pool().request(method, url, retries=False, **kwargs)
+        _raise_for_status(response, method, url)
+        return response
+
+    def get(self, url: str, **kwargs):
+        return self.request('GET', url, **kwargs)
+
+    def post(self, url: str, **kwargs):
+        return self.request('POST', url, **kwargs)
+
