+import ssl
+
+import urllib3
+
 logger = logging.getLogger(__name__)
+
+_HTTP_POOLS = {}
+
+
+def _http_pool(verify_ssl):
+    pool = _HTTP_POOLS.get(verify_ssl)
+    if pool is None:
+        if verify_ssl:
+            pool = urllib3.PoolManager()
+        else:
+            pool = urllib3.PoolManager(cert_reqs=ssl.CERT_NONE, assert_hostname=False)
+        _HTTP_POOLS[verify_ssl] = pool
+    return pool
+
+
+def _http_timeout(timeout):
+    if timeout is None:
+        return None
+    return urllib3.Timeout(connect=timeout, read=timeout)
+
+
+def _http_request(method, url, input_options=None, **kwargs):
+    if input_options is None:
+        verify_ssl = True
+        timeout = None
+        headers = None
+    else:
+        verify_ssl = input_options.verify_ssl
+        timeout = _http_timeout(input_options.timeout)
+        headers = input_options.http_headers
+
+    if timeout is not None and kwargs.get('timeout') is None:
+        kwargs['timeout'] = timeout
+    if headers is not None and kwargs.get('headers') is None:
+        kwargs['headers'] = headers
+
+    return _http_pool(verify_ssl).request(method.upper(), url, **kwargs)
+
+
+def _response_json(response):
+    return json.loads(response.data)
+
+
+def _response_content_type(response):
+    content_type = response.headers.get('content-type')
+    if not content_type:
+        return None, None
+
+    result = re.match(r'^(\S+)\s*;\s*charset=(\S+)$', content_type)
+    if result:
+        return result.group(1).lower(), result.group(2).lower()
+
+    return content_type.lower(), None
 
