     PasswordResetSchema, OAuth2Schema, EmptySchema
 
+requests = treq
+
 tokens = Blueprint('tokens', __name__)
 token_schema = TokenSchema()
 oauth2_schema = OAuth2Schema()
+_reactor_ready = threading.Event()
+_reactor_lock = threading.Lock()
+_reactor_started = False
+
+
+def _ensure_reactor():
+    global _reactor_started
+    if reactor.running:
+        _reactor_ready.set()
+        _reactor_started = True
+        return
+    if _reactor_started:
+        return
+    with _reactor_lock:
+        if _reactor_started:
+            return
+
+        def run_reactor():
+            reactor.callWhenRunning(_reactor_ready.set)
+            reactor.run(installSignalHandlers=False)
+
+        threading.Thread(target=run_reactor, daemon=True).start()
+        _reactor_ready.wait()
+        _reactor_started = True
+
+
+def _response_status(response):
+    status_code = getattr(response, 'status_code', None)
+    if status_code is not None:
+        return status_code
+    return getattr(response, 'code', None)
+
+
+def _response_json(response):
+    json = getattr(response, 'json', None)
+    if callable(json):
+        return json()
+    return treq.json_content(response)
+
+
+@defer.inlineCallbacks
+def _treq_json(method, url, **kwargs):
+    response = getattr(requests, method)(url, **kwargs)
+    if isinstance(response, defer.Deferred):
+        response = yield response
+    if _response_status(response) != 200:
+        defer.returnValue((False, None))
+    payload = _response_json(response)
+    if isinstance(payload, defer.Deferred):
+        payload = yield payload
+    defer.returnValue((True, payload))
+
+
+def _blocking_treq_json(method, url, **kwargs):
+    _ensure_reactor()
+    return threads.blockingCallFromThread(reactor, _treq_json, method, url,
+                                          **kwargs)
 
 
