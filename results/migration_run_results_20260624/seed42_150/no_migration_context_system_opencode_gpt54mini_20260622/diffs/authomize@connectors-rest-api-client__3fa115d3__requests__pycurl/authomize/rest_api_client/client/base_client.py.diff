+    def _perform_request(self, method: str, url: str, body: Optional[str] = None) -> _Response:
+        curl = pycurl.Curl()
+        response_body = []
+        response_headers = {}
+        status_line = ''
+        request_headers = [f'Authorization: {self.authorization_header}']
+        payload = None
+        if body is not None:
+            payload = body.encode('utf-8') if isinstance(body, str) else body
+            request_headers.append('Content-Type: application/json')
+
+        def write_body(chunk):
+            response_body.append(chunk)
+            return len(chunk)
+
+        def write_header(chunk):
+            nonlocal status_line, response_headers
+            line = chunk.decode('iso-8859-1').strip()
+            if not line:
+                return len(chunk)
+            if line.startswith('HTTP/'):
+                status_line = line
+                response_headers = {}
+                return len(chunk)
+            if ':' in line:
+                key, value = line.split(':', 1)
+                response_headers[key.strip().lower()] = value.strip()
+            return len(chunk)
+
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.FOLLOWLOCATION, True)
+            curl.setopt(pycurl.WRITEFUNCTION, write_body)
+            curl.setopt(pycurl.HEADERFUNCTION, write_header)
+            curl.setopt(pycurl.HTTPHEADER, request_headers)
+            if method == 'GET':
+                curl.setopt(pycurl.HTTPGET, True)
+            else:
+                curl.setopt(pycurl.CUSTOMREQUEST, method)
+                if payload is not None:
+                    curl.setopt(pycurl.POSTFIELDS, payload)
+                    curl.setopt(pycurl.POSTFIELDSIZE, len(payload))
+                elif method in {'POST', 'PATCH'}:
+                    curl.setopt(pycurl.POSTFIELDS, b'')
+                    curl.setopt(pycurl.POSTFIELDSIZE, 0)
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            effective_url = curl.getinfo(pycurl.EFFECTIVE_URL)
+        except pycurl.error as exc:
+            raise ClientError(str(exc)) from exc
+        finally:
+            curl.close()
+
+        reason = ''
+        if status_line:
+            parts = status_line.split(' ', 2)
+            if len(parts) == 3:
+                reason = parts[2]
+
+        return _Response(
+            status_code=status_code,
+            headers=response_headers,
+            content=b''.join(response_body),
+            url=effective_url,
+            reason=reason,
+        )
