+class PDResponse:
+    """Response adapter for urllib3 responses."""
+
+    def __init__(self, response, method, url, elapsed_seconds,
+            request_headers=None, request_body=None):
+        self._response = response
+        self.request = SimpleNamespace(
+            method=method,
+            url=url,
+            headers=request_headers or {},
+            body=request_body,
+        )
+        self.elapsed = timedelta(seconds=elapsed_seconds)
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
+    def __bool__(self):
+        return self.ok
+
+    def __repr__(self):
+        return f"<Response [{self.status_code}]>"
+
+    @property
+    def status_code(self):
+        return self._response.status
+
+    @property
+    def ok(self):
+        return bool(self.status_code) and self.status_code < 400
+
+    @property
+    def headers(self):
+        return self._response.headers
+
+    @property
+    def text(self):
+        body = self.data
+        if not body:
+            return ''
+        return body.decode('utf-8', errors='replace')
+
+    @property
+    def content(self):
+        return self.data
+
+    @property
+    def url(self):
+        geturl = getattr(self._response, 'geturl', None)
+        if callable(geturl):
+            return geturl()
+        return self.request.url
+
+    @property
+    def raw(self):
+        return self._response
+
+    @property
+    def data(self):
+        return self._response.data or b''
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if not self.ok:
+            raise PDHTTPError(http_error_message(self), self)
+
+
+Response = PDResponse
 
