+    def request(self, method, url, auth=None, headers=None, timeout=None, fields=None, params=None, body=None, **kwargs):
+        api_key = auth[0] if auth else None
+        if fields is None:
+            fields = params
+        if isinstance(body, str):
+            body = body.encode('utf-8')
+        if 'json' in kwargs and body is None:
+            body = json.dumps(kwargs['json']).encode('utf-8')
+            headers = dict(headers or {}, **{'Content-Type': 'application/json'})
+        response = self._pool.request(
+            method,
+            url,
+            headers=_headers_with_auth(headers, api_key),
+            timeout=timeout,
+            fields=_clean_fields(fields),
+            body=body,
+        )
+        return _ResponseAdapter(response)
