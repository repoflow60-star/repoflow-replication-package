+@defer.inlineCallbacks
+def _request(
+    url: str,
+    method: str,
+    params: ty.Optional[Filters],
+    data: ty.Optional[ty.List[ty.Tuple[str, ty.Any]]],
+    headers: ty.Dict[str, str],
+) -> defer.Deferred:
+    try:
+        rsp = yield treq.request(
+            method,
+            _append_params(url, params),
+            headers=headers,
+            data=_encode_form_data(data),
+        )
+        content = yield treq.content(rsp)
+    except Exception as exc:
+        raise RequestException() from exc
+
+    response = Response(rsp.code, _response_headers(rsp.headers), content)
+    if response.status_code not in range(200, 400):
+        raise HTTPError(response)
+
+    return response
+
+
+def _call_request(
+    url: str,
+    method: str,
+    params: ty.Optional[Filters],
+    data: ty.Optional[ty.List[ty.Tuple[str, ty.Any]]],
+    optional_auth: bool,
+) -> Response:
+    headers = _request_headers(
+        optional=optional_auth,
+        content_type='application/x-www-form-urlencoded'
+        if data is not None
+        else None,
+    )
+    _ensure_reactor_running()
+    return threads.blockingCallFromThread(
+        reactor,
+        _request,
+        url,
+        method,
+        params,
+        data,
+        headers,
+    )
