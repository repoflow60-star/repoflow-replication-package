+def _parse_env_line(line: str) -> Optional[tuple[str, str]]:
+    stripped = line.strip()
+
+    if not stripped or stripped.startswith("#"):
+        return None
+
+    if stripped.startswith("export "):
+        stripped = stripped[7:].lstrip()
+
+    if "=" not in stripped:
+        return None
+
+    key, value = stripped.split("=", 1)
+    key = key.strip()
+
+    if not key:
+        return None
+
+    value = value.strip()
+
+    if len(value) >= 2 and value[0] == value[-1] and value[0] in ('"', "'"):
+        value = value[1:-1]
+    else:
+        comment_index = value.find(" #")
+
+        if comment_index != -1:
+            value = value[:comment_index].rstrip()
+
+    return key, value
+
+
+def _format_env_value(value: str) -> str:
+    escaped = value.replace("\\", "\\\\").replace('"', '\\"')
+
+    return f'"{escaped}"'
+
+
+def _read_env_file_value(path: Optional[str], name: Optional[str]) -> Optional[str]:
+    if not path or not name or not os.path.isfile(path):
+        return None
+
+    with open(path, "r", encoding="utf-8") as file_stream:
+        for line in file_stream:
+            parsed = _parse_env_line(line)
+
+            if parsed is None:
+                continue
+
+            key, value = parsed
+
+            if key == name:
+                return value
+
+    return None
+
+
+def _rewrite_env_file(
+    path: Optional[str],
+    name: Optional[str],
+    value: Optional[str],
+    *,
+    delete: bool = False,
+) -> None:
+    if not path or not name:
+        return
+
+    directory = os.path.dirname(path)
+
+    if directory and not os.path.isdir(directory):
+        os.makedirs(directory, exist_ok=True)
+
+    new_lines = []
+    replaced = False
+
+    if os.path.isfile(path):
+        with open(path, "r", encoding="utf-8") as file_stream:
+            for line in file_stream:
+                parsed = _parse_env_line(line)
+
+                if parsed is None or parsed[0] != name:
+                    new_lines.append(line)
+                    continue
+
+                if delete:
+                    continue
+
+                if not replaced:
+                    new_lines.append(f"{name}={_format_env_value(value or '')}\n")
+                    replaced = True
+
+        if not delete and not replaced:
+            if new_lines and not new_lines[-1].endswith("\n"):
+                new_lines[-1] += "\n"
+
+            new_lines.append(f"{name}={_format_env_value(value or '')}\n")
+    elif not delete:
+        new_lines.append(f"{name}={_format_env_value(value or '')}\n")
+
+    with open(path, "w", encoding="utf-8") as file_stream:
+        file_stream.writelines(new_lines)
 
 
