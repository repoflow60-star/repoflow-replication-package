+    class SymbolServerApplication:
+        def __call__(self, environ, start_response):
+            method = environ.get("REQUEST_METHOD", "GET").upper()
+            path = environ.get("PATH_INFO", "")
+            headers = [
+                ("Access-Control-Allow-Origin", "*"),
+                ("Access-Control-Allow-Headers", "Content-Type"),
+                ("Access-Control-Allow-Methods", "GET, POST, OPTIONS"),
+                ("Content-Type", "application/json; charset=utf-8"),
+            ]
+
+            if method == "OPTIONS":
+                start_response("204 No Content", headers)
+                return [b""]
+
+            if method == "GET" and path == "/profile":
+                start_response("200 OK", headers)
+                return [getprofile().encode("utf-8")]
+
+            body = environ.get("wsgi.input")
+            if body is not None:
+                content_length = environ.get("CONTENT_LENGTH")
+                if content_length:
+                    body = body.read(int(content_length))
+                else:
+                    body = body.read()
+
+            if method == "POST" and path == "/source/v1":
+                start_response("200 OK", headers)
+                return [source(body).encode("utf-8")]
+
+            if method == "POST" and path == "/asm/v1":
+                start_response("200 OK", headers)
+                return [asm(body).encode("utf-8")]
+
+            start_response("404 Not Found", headers)
+            return [b""]
+
