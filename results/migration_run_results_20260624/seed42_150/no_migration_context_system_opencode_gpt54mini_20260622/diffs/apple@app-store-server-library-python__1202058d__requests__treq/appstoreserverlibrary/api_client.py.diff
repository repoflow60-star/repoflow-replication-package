+class _SimpleResponse:
+    def __init__(self, status_code: int, headers, body: bytes):
+        self.status_code = status_code
+        self.headers = headers
+        self._body = body
+
+    @property
+    def content(self):
+        return self._body
+
+    def json(self):
+        return json.loads(self._body.decode("utf-8"))
