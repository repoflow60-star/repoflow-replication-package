+
+def _append_query_params(url: str, params: Dict[str, Union[str, List[str]]]) -> str:
+    if not params:
+        return url
+    separator = "&" if "?" in url else "?"
+    return url + separator + urlencode(params, doseq=True)
+
+
+def _get_header_value(headers, name: str) -> Optional[str]:
+    if headers is None:
+        return None
+
+    getter = getattr(headers, "get", None)
+    if callable(getter):
+        value = getter(name)
+        if value is not None:
+            return value
+
+    raw_getter = getattr(headers, "getRawHeaders", None)
+    if callable(raw_getter):
+        values = raw_getter(name)
+        if values:
+            return values[0]
+
+    items = getattr(headers, "items", None)
+    if callable(items):
+        header_name = name.lower()
+        for key, value in items():
+            if key.lower() == header_name:
+                return value
+
+    return None
+
