+def load_env_file(dotenv_path: str) -> None:
+    """Load environment values from a local .env file via Dynaconf."""
+    settings = Dynaconf(envvar_prefix=False, load_dotenv=True, dotenv_path=dotenv_path)
+    for env_var_name in (
+        "ORGANIZATION",
+        "REPOSITORY",
+        "GH_APP_ID",
+        "GH_APP_PRIVATE_KEY",
+        "GH_APP_INSTALLATION_ID",
+        "GITHUB_APP_ENTERPRISE_ONLY",
+        "GH_TOKEN",
+        "GH_ENTERPRISE_URL",
+        "EXEMPT_REPOS",
+        "DRY_RUN",
+        "TITLE",
+        "BODY",
+        "COMMIT_MESSAGE",
+        "ISSUE_REPORT",
+    ):
+        env_var_value = settings.get(env_var_name)
+        if env_var_value is not None:
+            os.environ.setdefault(env_var_name, str(env_var_value))
 
 
