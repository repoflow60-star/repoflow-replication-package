+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        self._apply_response_cookies(raw_headers)
+        return PycurlResponse(status_code, self._parse_headers(raw_headers), response_buffer.getvalue())
+
+    def get(self, url: str, params: Optional[dict] = None) -> PycurlResponse:
+        return self._request("GET", url, params=params)
+
+    def post(
+        self,
