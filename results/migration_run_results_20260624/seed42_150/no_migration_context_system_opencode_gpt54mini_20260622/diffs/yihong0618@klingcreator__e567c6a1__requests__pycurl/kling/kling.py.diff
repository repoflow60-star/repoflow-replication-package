+        data: Optional[Union[bytes, str]] = None,
+        params: Optional[dict] = None,
+        headers: Optional[dict[str, str]] = None,
+        json: Optional[dict] = None,
+    ) -> PycurlResponse:
+        return self._request("POST", url, params=params, data=data, headers=headers, json=json)
+
