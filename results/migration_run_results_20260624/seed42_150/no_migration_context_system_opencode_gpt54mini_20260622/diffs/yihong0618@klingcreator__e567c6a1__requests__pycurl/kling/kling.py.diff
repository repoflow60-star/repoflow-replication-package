+class PycurlSession:
+    def __init__(self) -> None:
+        self.headers: dict[str, str] = {}
+        self.cookies: dict[str, str] = {}
+
+    @staticmethod
+    def _build_url(url: str, params: Optional[dict] = None) -> str:
+        if not params:
+            return url
+        parts = urlsplit(url)
+        query = urlencode(params, doseq=True)
+        if parts.query:
+            query = f"{parts.query}&{query}"
+        return urlunsplit((parts.scheme, parts.netloc, parts.path, query, parts.fragment))
+
+    @staticmethod
+    def _parse_headers(raw_headers) -> dict[str, str]:
+        headers: dict[str, str] = {}
+        for line in raw_headers:
+            decoded = line.decode("iso-8859-1", errors="replace").strip()
+            if not decoded or ":" not in decoded:
+                continue
+            name, _, value = decoded.partition(":")
+            headers[name.strip().lower()] = value.strip()
+        return headers
+
+    def _apply_response_cookies(self, raw_headers) -> None:
+        for line in raw_headers:
+            decoded = line.decode("iso-8859-1", errors="replace").strip()
+            if not decoded.lower().startswith("set-cookie:"):
+                continue
+            cookie = SimpleCookie()
+            cookie.load(decoded.split(":", 1)[1].strip())
+            for key, morsel in cookie.items():
+                self.cookies[key] = morsel.value
+
+    def _request(
+        self,
+        method: str,
+        url: str,
+        params: Optional[dict] = None,
+        data: Optional[Union[bytes, str]] = None,
+        headers: Optional[dict[str, str]] = None,
+        json: Optional[dict] = None,
+    ) -> PycurlResponse:
+        full_url = self._build_url(url, params)
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+        if self.cookies and not any(name.lower() == "cookie" for name in request_headers):
+            request_headers["Cookie"] = "; ".join(
+                f"{key}={value}" for key, value in self.cookies.items()
+            )
+
+        if json is not None:
+            payload = jsonlib.dumps(json).encode("utf-8")
+            if not any(name.lower() == "content-type" for name in request_headers):
+                request_headers["Content-Type"] = "application/json"
+        elif data is None:
+            payload = b""
+        elif isinstance(data, bytes):
+            payload = data
+        else:
+            payload = data.encode("utf-8")
+
+        response_buffer = BytesIO()
+        raw_headers: list[bytes] = []
+
+        def header_write(line: bytes) -> int:
+            raw_headers.append(line)
+            return len(line)
+
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, full_url)
+            curl.setopt(pycurl.WRITEFUNCTION, response_buffer.write)
+            curl.setopt(pycurl.HEADERFUNCTION, header_write)
+            curl.setopt(pycurl.FOLLOWLOCATION, True)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            curl.setopt(pycurl.ACCEPT_ENCODING, "")
+            if request_headers:
+                curl.setopt(
+                    pycurl.HTTPHEADER,
+                    [f"{name}: {value}" for name, value in request_headers.items()],
+                )
+            if method == "GET":
+                curl.setopt(pycurl.HTTPGET, True)
+            else:
+                curl.setopt(pycurl.POST, True)
