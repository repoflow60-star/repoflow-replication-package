+    def _make_post_request(request_url: str, data: dict, **kwargs) -> _PycurlResponse:
+        timeout = kwargs.pop('timeout', 10)
+        headers = kwargs.pop('headers', _HEADERS_UNSET)
+        verify = kwargs.pop('verify', True)
+        allow_redirects = kwargs.pop('allow_redirects', True)
+
+        response_buffer = BytesIO()
+        curl = None
+        status_code = 0
+        try:
+            curl = pycurl.Curl()
+            curl.setopt(pycurl.URL, request_url)
+            curl.setopt(pycurl.POST, 1)
+            payload = json.dumps(data).encode('utf-8')
+            curl.setopt(pycurl.POSTFIELDS, payload)
+            curl.setopt(pycurl.POSTFIELDSIZE, len(payload))
+            curl.setopt(pycurl.WRITEFUNCTION, response_buffer.write)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1 if allow_redirects else 0)
+            curl.setopt(pycurl.ACCEPT_ENCODING, '')
+            curl.setopt(pycurl.NOSIGNAL, 1)
+
+            if timeout is not None:
+                timeout_ms = int(float(timeout) * 1000)
+                if timeout_ms > 0:
+                    curl.setopt(pycurl.TIMEOUT_MS, timeout_ms)
+                    curl.setopt(pycurl.CONNECTTIMEOUT_MS, timeout_ms)
+
+            header_list = []
+            if headers is _HEADERS_UNSET:
+                header_list.append('Content-Type: application/json')
+            elif headers is not None:
+                header_items = headers.items() if hasattr(headers, 'items') else headers
+                for key, value in header_items:
+                    header_list.append(f'{key}: {value}')
+            if header_list:
+                curl.setopt(pycurl.HTTPHEADER, header_list)
+
+            if verify is False:
+                curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+                curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+            elif isinstance(verify, str):
+                curl.setopt(pycurl.CAINFO, verify)
+
+            try:
+                curl.perform()
+            except pycurl.error as e:
+                raise URLException(str(e))
+
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            if curl is not None:
+                curl.close()
+
+        return _PycurlResponse(response_buffer.getvalue(), status_code)
 
