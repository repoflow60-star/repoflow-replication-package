+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.WRITEDATA, body_buffer)
+        curl.setopt(pycurl.HEADERFUNCTION, collect_header)
+        curl.setopt(pycurl.HTTPHEADER, ['{}: {}'.format(name, value) for name, value in headers.items()])
+
+        if proxy:
+            if proxy.host == 'http://' or proxy.host == 'https://':
