+def _get_settings(test: bool = False) -> Dynaconf:
+    """Build a Dynaconf settings object for runtime configuration."""
+
+    return Dynaconf(
+        envvar_prefix=False,
+        environments=False,
+        load_dotenv=not test,
+        settings_files=[],
+        dotenv_path=join(dirname(__file__), ".env"),
+    )
+
+
+def _get_setting_value(settings: Dynaconf, env_var_name: str, default: Any = None) -> Any:
+    value = settings.get(env_var_name, default)
+    if value is None:
+        return default
+    return value
+
+
+def _get_bool_setting(settings: Dynaconf, env_var_name: str, default: bool = False) -> bool:
+    value = _get_setting_value(settings, env_var_name)
+    if value is None or value == "":
+        return default
+    return str(value).strip().lower() == "true"
+
+
+def _get_int_setting(settings: Dynaconf, env_var_name: str) -> int | None:
+    value = _get_setting_value(settings, env_var_name)
+    if value is None:
+        return None
+
+    value_str = str(value).strip()
+    if not value_str:
+        return None
+
+    try:
+        return int(value_str)
+    except ValueError:
+        return None
+
+
