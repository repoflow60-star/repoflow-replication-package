+def register_filters() -> Dict[str, Any]:
+    return {
+        'KB': kb,
+        'MB': mb,
+        'GB': gb,
+        'uptime': uptime,
+        'uptimesec': uptimesec,
+        'int': int,
+    }
+
+
+def _split_filters(expr: str) -> List[str]:
+    parts = []
+    start = 0
+    depth = 0
+    quote: Optional[str] = None
+    i = 0
+
+    while i < len(expr):
+        ch = expr[i]
+        if quote is not None:
+            if ch == '\\':
+                i += 2
+                continue
+            if ch == quote:
+                quote = None
+        else:
+            if ch in ('"', "'"):
+                quote = ch
+            elif ch in '([{':
+                depth += 1
+            elif ch in ')]}':
+                if depth > 0:
+                    depth -= 1
+            elif ch == '|' and depth == 0:
+                parts.append(expr[start:i].strip())
+                start = i + 1
+        i += 1
+
+    parts.append(expr[start:].strip())
+    return parts
+
+
+def _apply_filter(expr: str, filter_name: str) -> str:
+    filter_name = filter_name.strip()
+    if not filter_name:
+        return expr
+
+    if filter_name.endswith(')') and '(' in filter_name:
+        name, args = filter_name.split('(', 1)
+        name = name.strip()
+        args = args[:-1].strip()
+        if args:
+            return f'{name}({expr}, {args})'
+        return f'{name}({expr})'
+
+    return f'{filter_name}({expr})'
+
+
+def _to_mako_template(template: str) -> str:
+    # Keep the legacy {{...}} syntax and translate it into Mako expressions.
+    parts: List[str] = []
+    pos = 0
+
+    while True:
+        start = template.find('{{', pos)
+        if start < 0:
+            parts.append(template[pos:].replace('$', '$$'))
+            break
+
+        end = template.find('}}', start + 2)
+        if end < 0:
+            parts.append(template[pos:].replace('$', '$$'))
+            break
+
+        parts.append(template[pos:start].replace('$', '$$'))
+        expr = template[start + 2:end].strip()
+        converted = _split_filters(expr)
+        rendered = converted[0] if converted and converted[0] else "''"
+        for filter_name in converted[1:]:
+            rendered = _apply_filter(rendered, filter_name)
+        parts.append('${' + rendered + '}')
+        pos = end + 2
+
+    return ''.join(parts)
+
 
