 from typing import Any, Dict, Optional
 
-import requests
+import treq
+from twisted.internet import error as twisted_error
+from twisted.internet import reactor, threads
 
 from . import connection, exceptions, helper
 
 _LOGGING = logging.getLogger(__name__)
+_REACTOR_THREAD: Optional[threading.Thread] = None
+_REACTOR_READY = threading.Event()
+_REACTOR_LOCK = threading.Lock()
+
+
+def _run_reactor() -> None:
+    # treq is Deferred-based, so run a dedicated reactor thread for sync callers.
+    reactor.callWhenRunning(_REACTOR_READY.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor_running() -> None:
+    if reactor.running:
+        return
+
+    global _REACTOR_THREAD
+    with _REACTOR_LOCK:
+        if reactor.running:
+            return
+
+        if _REACTOR_THREAD is None or not _REACTOR_THREAD.is_alive():
+            _REACTOR_READY.clear()
+            _REACTOR_THREAD = threading.Thread(target=_run_reactor, daemon=True)
+            _REACTOR_THREAD.start()
+
+    _REACTOR_READY.wait()
 
 
