+class _CaseInsensitiveHeaders(dict):
+    def __setitem__(self, key, value):
+        super().__setitem__(str(key).lower(), value)
+
+    def __getitem__(self, key):
+        return super().__getitem__(str(key).lower())
+
+    def get(self, key, default=None):
+        return super().get(str(key).lower(), default)
+
+    def update(self, *args, **kwargs):
+        for key, value in dict(*args, **kwargs).items():
+            self[key] = value
+
+
+class _HTTPResponse(object):
+    def __init__(self, url, status_code, headers, content):
+        self.url = url
+        self.status_code = status_code
+        self.headers = _CaseInsensitiveHeaders(headers)
+        self.content = content
+
+        self.encoding = None
+        content_type = self.headers.get('content-type')
+        if content_type:
+            result = re.match(r'^(\S+)\s*;\s*charset=(\S+)$', content_type)
+            if result:
+                self.encoding = result.group(2).lower()
+
+    @property
+    def is_redirect(self):
+        return self.status_code in (301, 302, 303, 307, 308)
+
+    def json(self):
+        return json.loads(self.content.decode(self.encoding or 'utf-8'))
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            if self.status_code == 403:
+                raise HXLAuthorizationException("Access not authorized", url=self.url)
+            raise HXLIOException("HTTP error {}".format(self.status_code), url=self.url)
+
+
+def http_request(url, method='GET', verify_ssl=True, timeout=None, headers=None, params=None, data=None, allow_redirects=True):
+    """Perform an HTTP request using pycurl and return a lightweight response object."""
+
+    request_url = url
+    if params:
+        query = urllib.parse.urlencode(params, doseq=True)
+        request_url = request_url + ('&' if '?' in request_url else '?') + query
+
+    body = None
+    if data is not None:
+        if isinstance(data, bytes):
+            body = data
+        elif isinstance(data, str):
+            body = data.encode('utf-8')
+        else:
+            body = urllib.parse.urlencode(data, doseq=True).encode('utf-8')
+
+    response_headers = _CaseInsensitiveHeaders()
+    status_code = 0
+    body_stream = io.BytesIO()
+    curl = None
+
+    def handle_body(data):
+        nonlocal body_stream
+        body_stream.write(data)
+        return len(data)
+
+    def handle_header(line):
+        nonlocal status_code, response_headers, body_stream
+
+        raw_line = line.rstrip(b'\r\n')
+        if raw_line.startswith(b'HTTP/'):
+            response_headers = _CaseInsensitiveHeaders()
+            body_stream = io.BytesIO()
+            match = re.match(br'^HTTP/\S+\s+(\d+)', raw_line)
+            if match:
+                status_code = int(match.group(1))
+        elif raw_line:
+            decoded = raw_line.decode('iso-8859-1')
+            key, sep, value = decoded.partition(':')
+            if sep:
+                response_headers[key.strip()] = value.strip()
+
+        return len(line)
+
+    try:
+        curl = pycurl.Curl()
+        curl.setopt(pycurl.URL, request_url)
+        curl.setopt(pycurl.WRITEFUNCTION, handle_body)
+        curl.setopt(pycurl.HEADERFUNCTION, handle_header)
+        curl.setopt(pycurl.NOSIGNAL, 1)
+        curl.setopt(pycurl.ACCEPT_ENCODING, '')
+        curl.setopt(pycurl.FOLLOWLOCATION, bool(allow_redirects and method != 'HEAD'))
+        curl.setopt(pycurl.MAXREDIRS, 30)
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT_MS, int(float(timeout) * 1000))
+        if verify_ssl:
+            curl.setopt(pycurl.SSL_VERIFYPEER, 1)
+            curl.setopt(pycurl.SSL_VERIFYHOST, 2)
+        else:
+            curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+            curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+        if headers:
+            curl.setopt(pycurl.HTTPHEADER, ['{}: {}'.format(key, value) for key, value in headers.items()])
+
+        if method == 'HEAD':
+            curl.setopt(pycurl.NOBODY, 1)
+            curl.setopt(pycurl.CUSTOMREQUEST, 'HEAD')
+        elif method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            body = body or b''
+            curl.setopt(pycurl.POSTFIELDS, body)
+            curl.setopt(pycurl.POSTFIELDSIZE, len(body))
+        else:
+            curl.setopt(pycurl.HTTPGET, 1)
+
+        curl.perform()
+        status_code = int(curl.getinfo(pycurl.RESPONSE_CODE))
+        effective_url = curl.getinfo(pycurl.EFFECTIVE_URL)
+        return _HTTPResponse(effective_url, status_code, response_headers, body_stream.getvalue())
+    except pycurl.error as e:
+        raise HXLIOException(str(e), url=url)
+    finally:
+        if curl is not None:
+            curl.close()
 
 
