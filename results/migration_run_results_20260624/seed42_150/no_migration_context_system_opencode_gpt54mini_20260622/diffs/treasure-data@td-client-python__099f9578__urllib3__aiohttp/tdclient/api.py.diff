+class _AiohttpResponse:
+    def __init__(self, loop, session, response):
+        self._loop = loop
+        self._session = session
+        self._response = response
+        self.status = response.status
+        self._headers = list(response.headers.items())
+        self._buffer = bytearray()
+        self._offset = 0
+        self._closed = False
+        self._eof = False
