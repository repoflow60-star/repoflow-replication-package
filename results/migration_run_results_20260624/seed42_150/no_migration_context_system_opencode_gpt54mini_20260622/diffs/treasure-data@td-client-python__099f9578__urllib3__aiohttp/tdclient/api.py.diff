+class _AiohttpTransport:
+    def __init__(self, timeout=60, ssl_context=None, proxy=None, proxy_auth=None):
+        self._timeout = timeout
+        self._ssl_context = ssl_context
+        self._proxy = proxy
+        self._proxy_auth = proxy_auth
+        self._loop = asyncio.new_event_loop()
+        self._closed = False
+        self._lock = threading.RLock()
+        self._ready = threading.Event()
+        self._thread = threading.Thread(target=self._run_loop, daemon=True)
+        self._thread.start()
+        self._ready.wait()
+
+    def _run_loop(self):
+        asyncio.set_event_loop(self._loop)
+        self._ready.set()
+        self._loop.run_forever()
+
+    def _run(self, coro):
+        with self._lock:
+            if self._closed:
+                raise RuntimeError("transport is closed")
+            future = asyncio.run_coroutine_threadsafe(coro, self._loop)
+        return future.result()
+
+    async def _request(self, method, url, fields=None, body=None, headers=None, **kwargs):
+        request_kwargs = dict(kwargs)
+        request_kwargs.pop("decode_content", None)
+        request_kwargs.pop("preload_content", None)
+
+        ssl_context = request_kwargs.pop("ssl_context", None)
+        ca_certs = request_kwargs.pop("ca_certs", None)
+        cert_reqs = request_kwargs.pop("cert_reqs", None)
+        if ssl_context is None and (ca_certs is not None or cert_reqs is not None):
+            ssl_context = self._create_ssl_context(
+                {"ca_certs": ca_certs, "cert_reqs": cert_reqs}
+            )
+        if ssl_context is None:
+            ssl_context = self._ssl_context
+
+        if headers is not None:
+            request_kwargs["headers"] = headers
+        if self._proxy is not None:
+            request_kwargs["proxy"] = self._proxy
+        if self._proxy_auth is not None:
+            request_kwargs["proxy_auth"] = self._proxy_auth
+        if ssl_context is not None:
+            request_kwargs.setdefault("ssl", ssl_context)
+
+        timeout = request_kwargs.get("timeout", self._timeout)
+        if timeout is not None:
+            if isinstance(timeout, aiohttp.ClientTimeout):
+                request_kwargs["timeout"] = timeout
+            else:
+                request_kwargs["timeout"] = aiohttp.ClientTimeout(total=timeout)
+
+        if isinstance(body, bytearray):
+            body = bytes(body)
+        elif isinstance(body, memoryview):
+            body = body.tobytes()
+        elif isinstance(body, array):
+            body = body.tobytes()
+        elif isinstance(body, str):
+            body = body.encode("utf-8")
+
+        if fields is not None:
+            if method in ("GET", "DELETE"):
+                request_kwargs["params"] = fields
+            else:
+                request_kwargs["data"] = fields
+        elif body is not None:
+            request_kwargs["data"] = body
+
+        session = aiohttp.ClientSession()
+        try:
+            response = await session.request(method, url, **request_kwargs)
+        except Exception:
+            await session.close()
+            raise
+
+        return _AiohttpResponse(self._loop, session, response)
+
+    def request(self, method, url, fields=None, body=None, headers=None, **kwargs):
+        return self._run(
+            self._request(
+                method,
+                url,
+                fields=fields,
+                body=body,
+                headers=headers,
+                **kwargs,
+            )
+        )
+
+    def urlopen(self, method, url, fields=None, body=None, headers=None, **kwargs):
+        return self.request(
+            method,
+            url,
+            fields=fields,
+            body=body,
+            headers=headers,
+            **kwargs,
+        )
+
+    def clear(self):
+        return None
+
+    def close(self):
+        with self._lock:
+            if self._closed:
+                return None
+            self._closed = True
+            loop = self._loop
+            thread = self._thread
+            loop.call_soon_threadsafe(loop.stop)
+        thread.join()
+        loop.close()
+        return None
+
