+    def close(self):
+        if self._closed:
+            return None
+        if self._loop.is_closed() or not self._loop.is_running():
+            self._closed = True
+            with contextlib.suppress(Exception):
+                self._response.close()
+            self._offset = len(self._buffer)
+            self._eof = True
+            return None
