+    @property
+    def data(self):
+        self._ensure_all()
+        return bytes(self._buffer)
+
+    def _run(self, coro):
+        future = asyncio.run_coroutine_threadsafe(coro, self._loop)
+        return future.result()
+
+    async def _read_more(self, size):
+        if self._eof:
+            return b""
+
+        chunk = await self._response.content.read(size)
+        if not chunk:
+            self._eof = True
+            return b""
+
+        self._buffer.extend(chunk)
+        return chunk
+
+    async def _read_all(self):
+        if not self._eof:
+            chunk = await self._response.read()
+            if chunk:
+                self._buffer.extend(chunk)
+            self._eof = True
+        return bytes(self._buffer)
+
+    def _ensure_all(self):
+        if self._closed or self._eof or self._loop.is_closed() or not self._loop.is_running():
+            return
+        self._run(self._read_all())
+
+    def read(self, size=-1):
+        if size is None or size < 0:
+            self._ensure_all()
+            chunk = bytes(self._buffer[self._offset :])
+            self._offset = len(self._buffer)
+            return chunk
+
+        target = self._offset + size
+        if self._loop.is_closed() or not self._loop.is_running():
+            end = min(target, len(self._buffer))
+            chunk = bytes(self._buffer[self._offset : end])
+            self._offset = end
+            return chunk
+
+        while len(self._buffer) < target and not self._eof:
+            self._run(self._read_more(target - len(self._buffer)))
+
+        end = min(target, len(self._buffer))
+        chunk = bytes(self._buffer[self._offset : end])
+        self._offset = end
+        return chunk
+
+    def stream(self, chunk_size):
+        while True:
+            chunk = self.read(chunk_size)
+            if not chunk:
+                break
+            yield chunk
