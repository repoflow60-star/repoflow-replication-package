--- a/ninjemail/sms_services/http_client.py
+++ b/ninjemail/sms_services/http_client.py
@@ -0,0 +1,38 @@
+import io
+from urllib.parse import urlencode
+
+import pycurl
+
+
+def curl_request(method, url, headers=None, query=None, data=None):
+    buffer = io.BytesIO()
+    curl = pycurl.Curl()
+
+    if query:
+        separator = '&' if '?' in url else '?'
+        url = url + separator + urlencode(query)
+
+    header_list = list(headers or [])
+    if data is not None and not any(h.lower().startswith('content-type:') for h in header_list):
+        header_list.append('Content-Type: application/x-www-form-urlencoded')
+
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEFUNCTION, buffer.write)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.NOSIGNAL, 1)
+
+        if header_list:
+            curl.setopt(pycurl.HTTPHEADER, header_list)
+
+        if method.upper() == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            if data is not None:
+                curl.setopt(pycurl.POSTFIELDS, urlencode(data))
+
+        curl.perform()
+        status = curl.getinfo(pycurl.RESPONSE_CODE)
+        body = buffer.getvalue().decode('utf-8', errors='replace')
+        return status, body
+    finally:
+        curl.close()
