+"""
+Helpers for decoding urllib3 HTTP responses.
+"""
+
+import json
+
+from urllib3.response import HTTPResponse
+
+
+def decode_text(response: HTTPResponse) -> str:
+    return response.data.decode("utf-8")
+
+
+def decode_json(response: HTTPResponse):
+    return json.loads(decode_text(response))
