+class Session:
+    def request(self, **arguments: Any) -> SessionResponse:
+        try:
+            asyncio.get_running_loop()
+        except RuntimeError:
+            return asyncio.run(self.__request(**arguments))
+
+        loop = asyncio.new_event_loop()
+        try:
+            return loop.run_until_complete(self.__request(**arguments))
+        finally:
+            loop.close()
+
+    async def __request(self, **arguments: Any) -> SessionResponse:
+        method = arguments.pop("method")
+        url = arguments.pop("url")
+        timeout = arguments.pop("timeout", None)
+        retries = 3
+
+        request_timeout = (
+            aiohttp.ClientTimeout(total=timeout) if timeout is not None else None
+        )
+        request_arguments = arguments.copy()
+
+        if request_timeout is not None:
+            request_arguments["timeout"] = request_timeout
+
+        for attempt in range(retries + 1):
+            try:
+                async with aiohttp.ClientSession(headers={"Connection": "close"}) as session:
+                    async with session.request(
+                            method=method,
+                            url=url,
+                            **request_arguments
+                    ) as response:
+                        text = await response.text()
+
+                        if response.status == 429 and attempt < retries:
+                            await asyncio.sleep(2 ** attempt)
+                            continue
+
+                        return SessionResponse(response.status, text)
+            except Exception:
+                if attempt >= retries:
+                    raise
+
+                await asyncio.sleep(2 ** attempt)
+
+        raise RuntimeError("Request retry loop exited unexpectedly.")
 
 
