+_HTTP = urllib3.PoolManager()
+
+
+def _parse_link_header(link_header):
+    links = {}
+    if not link_header:
+        return links
+
+    for part in link_header.split(','):
+        part = part.strip()
+        if not part.startswith('<') or '>' not in part:
+            continue
+
+        url, params = part[1:].split('>', 1)
+        attrs = {'url': url}
+        for attr in params.split(';'):
+            attr = attr.strip()
+            if '=' not in attr:
+                continue
+            key, value = attr.split('=', 1)
+            attrs[key.lower()] = value.strip('"')
+
+        rel = attrs.get('rel')
+        if rel:
+            for relation in rel.split():
+                links[relation] = dict(attrs)
+
+    return links
+
+
+def _response_text(response):
+    data = getattr(response, 'data', b'')
+    if data is None:
+        return ''
+    if isinstance(data, str):
+        return data
+
+    content_type = response.headers.get('content-type', '')
+    charset = 'utf-8'
+    for part in content_type.split(';')[1:]:
+        part = part.strip()
+        if part.lower().startswith('charset='):
+            charset = part.split('=', 1)[1].strip('"')
+            break
+
+    return data.decode(charset, errors='replace')
+
+
+class _Response(object):
+
+    def __init__(self, response):
+        self._response = response
+        self.headers = response.headers
+        self.status_code = response.status
+        self.links = _parse_link_header(response.headers.get('link'))
+
+    @property
+    def text(self):
+        return _response_text(self._response)
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise urllib3.exceptions.HTTPError(
+                "HTTP {} {}".format(self.status_code,
+                                    getattr(self._response, 'reason', '')))
+
+
+def _request(method, url, **kwargs):
+    allow_redirects = kwargs.pop('allow_redirects', True)
+    auth = kwargs.pop('auth', None)
+    json_body = kwargs.pop('json', None)
+    params = kwargs.pop('params', None)
+    retries = kwargs.pop('retries', False)
+    headers = dict(kwargs.pop('headers', {}) or {})
+
+    if params:
+        split_url = urlsplit(url)
+        query = split_url.query
+        encoded_params = params if isinstance(params, str) else urlencode(
+            params, doseq=True)
+        if query:
+            query = query + '&' + encoded_params
+        else:
+            query = encoded_params
+        url = urlunsplit((split_url.scheme, split_url.netloc, split_url.path,
+                          query, split_url.fragment))
+
+    if auth is not None:
+        headers['authorization'] = urllib3.make_headers(basic_auth='{}:{}'.format(
+            auth[0], auth[1]))['authorization']
+
+    if json_body is not None and 'body' not in kwargs:
+        kwargs['body'] = json.dumps(json_body).encode('utf-8')
+        if not any(key.lower() == 'content-type' for key in headers):
+            headers['content-type'] = 'application/json'
+
+    if 'data' in kwargs and 'body' not in kwargs:
+        body = kwargs.pop('data')
+        if isinstance(body, str):
+            body = body.encode('utf-8')
+        kwargs['body'] = body
+
+    response = _HTTP.request(method, url, headers=headers,
+                             redirect=allow_redirects, retries=retries,
+                             **kwargs)
+    return _Response(response)
 
 
