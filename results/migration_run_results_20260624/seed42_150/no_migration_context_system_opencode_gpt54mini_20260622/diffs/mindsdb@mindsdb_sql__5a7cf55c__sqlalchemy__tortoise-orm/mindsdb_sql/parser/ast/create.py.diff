+def _render_type_name(col_type):
+    if isinstance(col_type, str):
+        return col_type
+
+    field_type = col_type if isinstance(col_type, type) else type(col_type)
+    for field_class, type_name in _TYPE_ALIASES:
+        if issubclass(field_type, field_class):
+            return type_name
+
+    return getattr(field_type, '__name__', str(col_type))
 
 
