+def _normalize_type_name(type_value):
+    if isinstance(type_value, str):
+        return type_value
+
+    field_type = type_value if isinstance(type_value, type) else type(type_value)
+    for field_class, type_name in _TYPE_ALIASES:
+        if issubclass(field_type, field_class):
+            return type_name
+
+    return getattr(field_type, '__name__', str(type_value))
+
+
+def _render_alias(value):
+    return ast.Identifier(parts=[value]).to_string()
+
+
+def _render_constant_target(target):
+    if target.value is None:
+        rendered = 'NULL'
+    else:
+        rendered = target.to_string(alias=False)
+    alias = str(target.value) if target.value is not None else 'NULL'
+    return f'{rendered} AS {_render_alias(alias)}'
+
+
+def _render_literal(value):
+    if hasattr(value, 'to_string'):
+        return value.to_string()
+    if value is None:
+        return 'NULL'
+    if isinstance(value, (str, dt.date, dt.datetime, dt.timedelta)):
+        return "'{}'".format(str(value).replace("'", "''"))
+    if isinstance(value, bool):
+        return 'TRUE' if value else 'FALSE'
+    return str(value)
+
+
+def _render_select_target(target):
+    if isinstance(target, ast.Constant) and target.alias is None:
+        return _render_constant_target(target)
+    return target.to_string()
+
+
+def _render_select(node):
+    parts = []
+    if node.cte is not None:
+        cte_str = ', '.join([out.to_string() for out in node.cte])
+        parts.append(f'WITH {cte_str}')
+
+    select_str = 'SELECT'
+    if node.distinct:
+        select_str += ' DISTINCT'
+
+    targets_str = ', '.join([_render_select_target(t) for t in node.targets])
+    select_str += f' {targets_str}'
+    parts.append(select_str)
+
+    if node.from_table is not None:
+        from_table_str = node.from_table.to_string() if hasattr(node.from_table, 'to_string') else str(node.from_table)
+        parts.append(f'FROM {from_table_str}')
+
+    if node.where is not None:
+        parts.append(f'WHERE {node.where.to_string()}')
+
+    if node.group_by is not None:
+        group_by_str = ', '.join([out.to_string() for out in node.group_by])
+        parts.append(f'GROUP BY {group_by_str}')
+
+    if node.having is not None:
+        parts.append(f'HAVING {node.having.to_string()}')
+
+    if node.order_by is not None:
+        order_by_str = ', '.join([out.to_string() for out in node.order_by])
+        parts.append(f'ORDER BY {order_by_str}')
+
+    if node.limit is not None:
+        parts.append(f'LIMIT {node.limit.to_string() if hasattr(node.limit, "to_string") else str(node.limit)}')
+
+    if node.offset is not None:
+        parts.append(f'OFFSET {node.offset.to_string() if hasattr(node.offset, "to_string") else str(node.offset)}')
+
+    if node.mode is not None:
+        parts.append(node.mode)
+
+    if node.using is not None:
+        using_ar = []
+        from mindsdb_sql.parser.ast.select.identifier import Identifier
+
+        for key, value in node.using.items():
+            if hasattr(value, 'type') and hasattr(value, 'params'):
+                args = [f'{k}={_render_literal(v)}' for k, v in (value.params or {}).items()]
+                value_str = f'{value.type}({", ".join(args)})'
+            else:
+                value_str = _render_literal(value)
+            using_ar.append(f'{Identifier(key).to_string()}={value_str}')
+
+        parts.append('USING ' + ', '.join(using_ar))
+
+    return ' '.join(parts)
 
 
