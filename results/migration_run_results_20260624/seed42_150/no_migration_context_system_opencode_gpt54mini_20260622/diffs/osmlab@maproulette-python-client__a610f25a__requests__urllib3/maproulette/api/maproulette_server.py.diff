+class _Urllib3Session:
+    """Small adapter that exposes the request methods used by the API wrapper."""
+
+    def __init__(self, headers=None, verify=True, certs=None):
+        self.headers = {k: v for k, v in (headers or {}).items() if v is not None}
+        self.verify = verify
+        self.certs = certs
+
+        client_kwargs = {
+            "headers": self.headers,
+            "retries": False,
+        }
+        if verify is False:
+            client_kwargs["cert_reqs"] = ssl.CERT_NONE
+        else:
+            client_kwargs["cert_reqs"] = ssl.CERT_REQUIRED
+            if isinstance(verify, str):
+                client_kwargs["ca_certs"] = verify
+        if certs:
+            if isinstance(certs, tuple):
+                client_kwargs["cert_file"] = certs[0]
+                client_kwargs["key_file"] = certs[1]
+            else:
+                client_kwargs["cert_file"] = certs
+
+        self._client = urllib3.PoolManager(**client_kwargs)
+
+    @staticmethod
+    def _merge_url(url, params=None):
+        if not params:
+            return url
+        if hasattr(params, "items"):
+            items = params.items()
+        else:
+            items = params
+        query = urlencode([(k, v) for k, v in items if v is not None], doseq=True)
+        if not query:
+            return url
+        return f"{url}&{query}" if "?" in url else f"{url}?{query}"
+
+    def request(self, method, url, params=None, body=None, fields=None, headers=None):
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update({k: v for k, v in headers.items() if v is not None})
+
+        request_kwargs = {"retries": False}
+        if request_headers:
+            request_kwargs["headers"] = request_headers
+        if body is not None:
+            request_kwargs["body"] = body
+        if fields is not None:
+            request_kwargs["fields"] = fields
+
+        return self._client.request(method, self._merge_url(url, params=params), **request_kwargs)
+
+    def get(self, url, params=None):
+        return self.request("GET", url, params=params)
+
+    def post(self, url, params=None, body=None, headers=None):
+        return self.request("POST", url, params=params, body=body, headers=headers)
+
+    def put(self, url, params=None, body=None, fields=None, headers=None):
+        return self.request("PUT", url, params=params, body=body, fields=fields, headers=headers)
+
+    def delete(self, url, params=None):
+        return self.request("DELETE", url, params=params)
 
 
