+
+    def _append_layer(self, chart: alt.Chart) -> None:
+        self._layers.append(chart)
+
+    def _rect_layer(
+        self,
+        data: list[dict[str, float]],
+        *,
+        color: str,
+        stroke: str | None = None,
+        stroke_width: float = 1.0,
+    ) -> alt.Chart:
+        x_enc, y_enc = self._position_encoding()
+        mark_kwargs: dict[str, object] = {"color": color}
+        if stroke is not None:
+            mark_kwargs["stroke"] = stroke
+            mark_kwargs["strokeWidth"] = stroke_width
+        return (
+            alt.Chart(pd.DataFrame(data))
+            .mark_rect(**mark_kwargs)
+            .encode(x=x_enc, x2="x2:Q", y=y_enc, y2="y2:Q")
+        )
+
+    def _rule_layer(
+        self,
+        data: list[dict[str, float]],
+        *,
+        color: str,
+        stroke_width: float = 1.0,
+        stroke_dash: list[float] | None = None,
+    ) -> alt.Chart:
+        x_enc, y_enc = self._position_encoding()
+        records: list[dict[str, float]] = []
+        for row in data:
+            record = dict(row)
+            record.setdefault("x2", record.get("x", 0.0))
+            record.setdefault("y2", record.get("y", 0.0))
+            records.append(record)
+        mark_kwargs: dict[str, object] = {"color": color, "strokeWidth": stroke_width}
+        if stroke_dash is not None:
+            mark_kwargs["strokeDash"] = stroke_dash
+        return (
+            alt.Chart(pd.DataFrame(records))
+            .mark_rule(**mark_kwargs)
+            .encode(x=x_enc, x2="x2:Q", y=y_enc, y2="y2:Q")
+        )
+
+    def _text_layer(
+        self,
+        data: list[dict[str, float | str]],
+        *,
+        color: str = "black",
+        font_size: float = 12.0,
+        align: str = "center",
+        baseline: str = "middle",
+        angle: float = 0.0,
+    ) -> alt.Chart:
+        x_enc, y_enc = self._position_encoding()
+        return (
+            alt.Chart(pd.DataFrame(data))
+            .mark_text(color=color, fontSize=int(font_size), align=align, baseline=baseline, angle=angle)
+            .encode(x=x_enc, y=y_enc, text="text:N")
+        )
+
+    def _point_layer(self, data: list[dict[str, float]], *, color: str, size: float, stroke: str = "white") -> alt.Chart:
+        x_enc, y_enc = self._position_encoding()
+        return alt.Chart(pd.DataFrame(data)).mark_circle(
+            color=color,
+            stroke=stroke,
+            strokeWidth=1,
+            size=size,
+        ).encode(x=x_enc, y=y_enc)
+
+    def _line_style(self, style: dict[str, float | str] | None, default_color: str = "gray") -> dict[str, object]:
+        resolved: dict[str, object] = {"color": default_color, "strokeWidth": 0.8, "strokeDash": [8.0, 2.0, 2.0, 2.0]}
+        if style:
+            if "color" in style:
+                resolved["color"] = style["color"]
+            if "linewidth" in style:
+                resolved["strokeWidth"] = style["linewidth"]
+            if "strokeWidth" in style:
+                resolved["strokeWidth"] = style["strokeWidth"]
+            if "linestyle" in style:
+                resolved["strokeDash"] = self._dash_pattern(str(style["linestyle"]))
+            if "strokeDash" in style:
+                resolved["strokeDash"] = style["strokeDash"]
+        return resolved
+
+    def _dash_pattern(self, linestyle: str) -> list[float] | None:
+        if linestyle in {"dashdot", "-."}:
+            return [8.0, 2.0, 2.0, 2.0]
+        if linestyle in {"dashed", "--"}:
+            return [6.0, 3.0]
+        if linestyle in {"dotted", ":"}:
+            return [1.0, 3.0]
+        return None
 
