+    def _position_encoding(self) -> tuple[alt.X, alt.Y]:
+        return (
+            alt.X("x:Q", scale=alt.Scale(domain=list(self._x_domain)), axis=None),
+            alt.Y("y:Q", scale=alt.Scale(domain=list(self._y_domain)), axis=None),
