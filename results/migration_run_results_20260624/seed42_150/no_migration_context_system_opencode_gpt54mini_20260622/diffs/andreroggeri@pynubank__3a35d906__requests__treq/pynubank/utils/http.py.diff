+@dataclass
+class HttpResponse:
+    url: str
+    status_code: int
+    headers: dict
+    _body: bytes = b''
+
+    def json(self):
+        return json_module.loads(self._body.decode())
+
+
+def _response_headers(headers) -> dict:
+    response_headers = {}
+    raw_headers = getattr(headers, 'getAllRawHeaders', None)
+    if raw_headers is None:
+        return response_headers
+
+    for name, values in raw_headers() or []:
+        key = name.decode() if isinstance(name, bytes) else str(name)
+        value = ', '.join(
+            value.decode() if isinstance(value, bytes) else str(value)
+            for value in values
+        )
+        response_headers[key] = value
+        if key.lower() == 'www-authenticate':
+            response_headers['WWW-Authenticate'] = value
+
+    return response_headers
+
+
+def _agent_for_url(url: str, cert: bytes = None, password: str = ''):
+    _get_loop()
+    hostname = urlparse(url).hostname
+    if cert:
+        pkcs12 = crypto.load_pkcs12(cert, password.encode())
+        client_cert = ssl.PrivateCertificate.loadPEM(
+            crypto.dump_certificate(crypto.FILETYPE_PEM, pkcs12.get_certificate()) +
+            crypto.dump_privatekey(crypto.FILETYPE_PEM, pkcs12.get_privatekey())
+        )
+        context_factory = ssl.optionsForClientTLS(hostname, clientCertificate=client_cert)
+    else:
+        context_factory = ssl.optionsForClientTLS(hostname)
+
+    from twisted.internet import reactor
+
+    return Agent(reactor, contextFactory=context_factory)
+
+
+async def _request(method: str, url: str, headers: dict = None, json: dict = None,
+                   pkcs12_data: bytes = None, pkcs12_password: str = '') -> HttpResponse:
+    headers_obj = Headers({key.encode(): [value.encode()] for key, value in (headers or {}).items()})
+    data = None if json is None else json_module.dumps(json).encode()
+    client = TreqClient(_agent_for_url(url, pkcs12_data, pkcs12_password))
+    response = await client.request(method, url, headers=headers_obj, data=data)
+    body = await treq.content(response)
+
+    return HttpResponse(
+        url=url,
+        status_code=response.code,
+        headers=_response_headers(response.headers),
+        _body=body,
+    )
 
 
