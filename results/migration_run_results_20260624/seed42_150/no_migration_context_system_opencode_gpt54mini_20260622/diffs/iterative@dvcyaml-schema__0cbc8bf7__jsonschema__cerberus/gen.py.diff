+yaml = YAML(typ="safe")
+
+
+def _string_rule(**extra: Any) -> dict[str, Any]:
+    return {"type": "string", **extra}
+
+
+def _boolean_rule(**extra: Any) -> dict[str, Any]:
+    return {"type": "boolean", **extra}
+
+
+def _list_rule(
+    item_rule: dict[str, Any] | None = None,
+    **extra: Any,
+) -> dict[str, Any]:
+    rule: dict[str, Any] = {"type": "list"}
+    if item_rule is not None:
+        rule["schema"] = item_rule
+    rule.update(extra)
+    return rule
+
+
+def _dict_rule(
+    **extra: Any,
+) -> dict[str, Any]:
+    rule: dict[str, Any] = {"type": "dict"}
+    rule.update(extra)
+    return rule
+
+
+def _anyof_rule(*rules: dict[str, Any]) -> dict[str, Any]:
+    return {"anyof": list(rules)}
+
+
+def build_cerberus_schema() -> dict[str, Any]:
+    out_flags_fields = {
+        "cache": {**_boolean_rule(), "default": True},
+        "persist": {**_boolean_rule(), "default": False},
+        "checkpoint": {**_boolean_rule(), "default": False},
+        "desc": _string_rule(),
+        "type": _string_rule(),
+        "labels": _list_rule(_string_rule(), unique=True),
+        "meta": _dict_rule(keysrules=_string_rule()),
+        "remote": _string_rule(),
+        "push": {**_boolean_rule(), "default": True},
+    }
+    out_flags = _dict_rule(schema=out_flags_fields)
+
+    plot_flags_fields = {
+        **out_flags_fields,
+        "x": _string_rule(),
+        "y": _string_rule(),
+        "x_label": _string_rule(),
+        "y_label": _string_rule(),
+        "title": _string_rule(),
+        "header": {**_boolean_rule(), "default": False},
+        "template": _string_rule(),
+    }
+    plot_flags = _dict_rule(schema=plot_flags_fields)
+
+    top_level_x = _anyof_rule(
+        _string_rule(),
+        _dict_rule(keysrules=_string_rule(), valuesrules=_string_rule()),
+    )
+    top_level_y = _anyof_rule(
+        _string_rule(),
+        _list_rule(_string_rule(), unique=True),
+        _dict_rule(
+            keysrules=_string_rule(),
+            valuesrules=_anyof_rule(
+                _string_rule(),
+                _list_rule(_string_rule(), unique=True),
+            ),
+        ),
+    )
+    top_level_plot_flags_fields = {
+        "x": top_level_x,
+        "y": top_level_y,
+        "x_label": _string_rule(),
+        "y_label": _string_rule(),
+        "title": _string_rule(),
+        "template": {**_string_rule(), "default": "linear"},
+    }
+    top_level_plot_flags = _dict_rule(schema=top_level_plot_flags_fields)
+    top_level_plot_value = _anyof_rule(
+        top_level_plot_flags,
+        {"allowed": [None]},
+    )
+    top_level_plots = _dict_rule(
+        keysrules=_string_rule(),
+        valuesrules=top_level_plot_value,
+    )
+    top_level_plots_list = _list_rule(
+        _anyof_rule(
+            _string_rule(),
+            top_level_plots,
+        ),
+    )
+
+    top_level_artifact_flags_fields = {
+        "path": {**_string_rule(), "required": True},
+        "type": _string_rule(),
+        "desc": _string_rule(),
+        "meta": _dict_rule(keysrules=_string_rule()),
+        "labels": _list_rule(_string_rule(), unique=True),
+    }
+    top_level_artifact_flags = _dict_rule(schema=top_level_artifact_flags_fields)
+    top_level_artifacts = _dict_rule(
+        keysrules=_string_rule(),
+        valuesrules=top_level_artifact_flags,
+    )
+
+    dep_schema = _string_rule()
+    dependencies = _list_rule(dep_schema, unique=True)
+
+    param_key = _string_rule()
+    custom_param_file_keys = _dict_rule(
+        keysrules=_string_rule(),
+        valuesrules=_anyof_rule(
+            _list_rule(param_key, unique=True),
+            {"allowed": [None]},
+        ),
+    )
+    param = _anyof_rule(
+        param_key,
+        custom_param_file_keys,
+    )
+    params = _list_rule(param)
+
+    out = _anyof_rule(
+        _string_rule(),
+        _dict_rule(keysrules=_string_rule(), valuesrules=out_flags),
+    )
+    outs = _list_rule(out)
+
+    metric = _anyof_rule(
+        _string_rule(),
+        _dict_rule(keysrules=_string_rule(), valuesrules=out_flags),
+    )
+    metrics = _list_rule(metric)
+
+    plot = _anyof_rule(
+        _string_rule(),
+        _dict_rule(keysrules=_string_rule(), valuesrules=plot_flags),
+    )
+    plots = _list_rule(plot)
+
+    var_decl = _dict_rule(keysrules=_string_rule())
+    var_path = _string_rule()
+    vars_rule = _list_rule(
+        _anyof_rule(
+            var_path,
+            var_decl,
+        ),
+    )
+
+    stage_fields = {
+        "cmd": _anyof_rule(
+            _string_rule(),
+            _list_rule(_string_rule()),
+        ),
+        "wdir": _string_rule(),
+        "deps": dependencies,
+        "params": params,
+        "outs": outs,
+        "metrics": metrics,
+        "plots": plots,
+        "frozen": {**_boolean_rule(), "default": False},
+        "always_changed": {**_boolean_rule(), "default": False},
+        "vars": vars_rule,
+        "desc": _string_rule(),
+        "meta": {},
+    }
+    stage_fields["cmd"]["required"] = True
+    stage = _dict_rule(schema=stage_fields)
+
+    foreach_do_fields = {
+        "foreach": _anyof_rule(
+            {**_string_rule(), "regex": r"^\$\{.*?\}$"},
+            _list_rule(),
+            _dict_rule(keysrules=_string_rule()),
+        ),
+        "do": stage,
+    }
+    foreach_do_fields["foreach"]["required"] = True
+    foreach_do_fields["do"]["required"] = True
+    foreach_do = _dict_rule(schema=foreach_do_fields)
+
+    matrix_fields = {
+        **stage_fields,
+        "matrix": _dict_rule(
+            valuesrules=_anyof_rule(
+                _list_rule(),
+                {**_string_rule(), "regex": r"^\$\{.*?\}$"},
+            ),
+        ),
+    }
+    matrix_fields["matrix"]["required"] = True
+    matrix = _dict_rule(schema=matrix_fields)
+
+    definition = _anyof_rule(foreach_do, matrix, stage)
+
+    root_schema = {
+        "vars": vars_rule,
+        "stages": _dict_rule(keysrules=_string_rule(), valuesrules=definition),
+        "plots": _anyof_rule(top_level_plots, top_level_plots_list),
+        "params": _list_rule(_string_rule(), unique=True),
+        "metrics": _list_rule(_string_rule(), unique=True),
+        "artifacts": top_level_artifacts,
+    }
+
+    return root_schema
+
+
+def validate_examples_with_cerberus() -> None:
+    """Validate the example corpus with Cerberus before emitting the schema."""
+
+    schema = build_cerberus_schema()
+    validator = Validator(schema, allow_unknown=False)
+    root = Path(__file__).resolve().parent
+    examples_dir = root / "examples"
+
+    for example in sorted((examples_dir / "valid").iterdir()):
+        document = yaml.load(example.read_text(encoding="utf-8"))
+        if not validator.validate(document):
+            raise ValueError(f"{example} should be valid: {validator.errors}")
+
+    for example in sorted((examples_dir / "invalid").iterdir()):
+        document = yaml.load(example.read_text(encoding="utf-8"))
+        if validator.validate(document):
+            raise ValueError(f"{example} should be invalid")
+
