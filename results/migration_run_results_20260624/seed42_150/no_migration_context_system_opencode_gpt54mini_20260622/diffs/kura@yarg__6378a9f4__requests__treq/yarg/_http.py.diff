--- a/yarg/_http.py
+++ b/yarg/_http.py
@@ -0,0 +1,36 @@
+import asyncio
+
+from twisted.internet import asyncioreactor
+
+
+_loop = asyncio.new_event_loop()
+
+try:
+    asyncioreactor.install(_loop)
+except Exception:
+    pass
+
+import treq
+
+
+def _run(deferred):
+    return _loop.run_until_complete(deferred.asFuture(_loop))
+
+
+def get(url):
+    return _run(treq.get(url))
+
+
+def content(response):
+    return _run(treq.content(response))
+
+
+def status_code(response):
+    return getattr(response, 'code', getattr(response, 'status_code', None))
+
+
+def reason(response):
+    value = getattr(response, 'phrase', getattr(response, 'reason', ''))
+    if isinstance(value, bytes):
+        return value.decode()
+    return value
