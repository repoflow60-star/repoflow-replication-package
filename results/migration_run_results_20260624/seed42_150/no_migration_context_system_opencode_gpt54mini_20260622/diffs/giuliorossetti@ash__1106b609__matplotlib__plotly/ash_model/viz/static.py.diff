+import numpy as np
+import plotly.graph_objects as go
+
+from ash_model import ASH
+
+
+def _get_figure(kwargs):
+    fig = kwargs.get("fig")
+    if fig is None:
+        fig = kwargs.get("ax")
+    if fig is not None and hasattr(fig, "add_trace") and hasattr(fig, "update_layout"):
+        return fig
+    return go.Figure()
+
+
+def _trace_kwargs(kwargs, default_name=None, default_opacity=None, kind="scatter"):
+    trace_kwargs = {}
+    if default_name is not None:
+        trace_kwargs["name"] = default_name
+    if default_opacity is not None:
+        trace_kwargs["opacity"] = default_opacity
+
+    if "name" in kwargs:
+        trace_kwargs["name"] = kwargs["name"]
+    elif "label" in kwargs:
+        trace_kwargs["name"] = kwargs["label"]
+
+    if "opacity" in kwargs:
+        trace_kwargs["opacity"] = kwargs["opacity"]
+    elif "alpha" in kwargs:
+        trace_kwargs["opacity"] = kwargs["alpha"]
+
+    marker = {}
+    line = {}
+
+    if isinstance(kwargs.get("marker"), dict):
+        marker.update(kwargs["marker"])
+    if isinstance(kwargs.get("line"), dict):
+        line.update(kwargs["line"])
+
+    color = kwargs.get("color")
+    if color is not None:
+        marker["color"] = color
+        if kind != "bar":
+            line["color"] = color
+
+    marker_value = kwargs.get("marker")
+    if kind != "bar" and marker_value is not None and not isinstance(marker_value, dict):
+        marker["symbol"] = marker_value
+
+    if "marker_size" in kwargs:
+        marker["size"] = kwargs["marker_size"]
+
+    if kind != "bar":
+        if "line_width" in kwargs:
+            line["width"] = kwargs["line_width"]
+        elif "linewidth" in kwargs:
+            line["width"] = kwargs["linewidth"]
+
+        if "line_dash" in kwargs:
+            line["dash"] = kwargs["line_dash"]
+        elif "linestyle" in kwargs:
+            line["dash"] = kwargs["linestyle"]
+
+        if line:
+            trace_kwargs["line"] = line
+    else:
+        marker_line = marker.get("line", {})
+        if "line_width" in kwargs:
+            marker_line["width"] = kwargs["line_width"]
+        elif "linewidth" in kwargs:
+            marker_line["width"] = kwargs["linewidth"]
+        if marker_line:
+            marker["line"] = marker_line
+
+    if marker:
+        trace_kwargs["marker"] = marker
+
+    for key in ("hovertemplate", "hoverinfo", "text", "showlegend"):
+        if key in kwargs:
+            trace_kwargs[key] = kwargs[key]
+
+    return trace_kwargs
+
+
+def _positive_pairs(x, y):
+    return [(xi, yi) for xi, yi in zip(x, y) if xi > 0 and yi > 0]
 
 
