+    def _request_json(self, method, url, payload=None):
+        """Perform an API request and return parsed JSON data."""
+        url = self.baseUrl + url
+        if method == "GET" and payload:
+            query = urlencode(payload, doseq=True)
+            url = "{url}{sep}{query}".format(
+                url=url, sep="&" if "?" in url else "?", query=query
+            )
+
+        logger.debug("%s %s", method, url)
+
+        response = io.BytesIO()
+        curl = pycurl.Curl()
+        headers = [self.auth_header]
+        if method == "POST":
+            headers.append("Content-Type: application/json")
+
+        try:
+            curl.setopt(pycurl.URL, url.encode("utf-8"))
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            curl.setopt(pycurl.HTTPHEADER, headers)
+            curl.setopt(pycurl.WRITEFUNCTION, response.write)
+
+            if method == "POST":
+                curl.setopt(pycurl.POST, 1)
+                if payload is not None:
+                    body = json.dumps(payload).encode("utf-8")
+                    curl.setopt(pycurl.POSTFIELDS, body)
+                    curl.setopt(pycurl.POSTFIELDSIZE, len(body))
+            elif method == "DELETE":
+                curl.setopt(pycurl.CUSTOMREQUEST, "DELETE")
+
+            curl.perform()
+        except pycurl.error as exc:
+            raise errors.PluginError("API request failed") from exc
+        finally:
+            curl.close()
+
+        try:
+            result = json.loads(response.getvalue().decode("utf-8"))
+        except json.decoder.JSONDecodeError as exc:
+            raise errors.PluginError("no JSON in API response") from exc
+
+        if result["result"] == "success":
+            return result["data"]
+        if method == "GET" and result["error"]["code"] == "not_authorized":
+            raise errors.PluginError("cannot authenticate")
+        raise errors.PluginError(
+            "error in API request: {} / {}".format(
+                result["error"]["code"], result["error"]["description"]
+            )
+        )
 
