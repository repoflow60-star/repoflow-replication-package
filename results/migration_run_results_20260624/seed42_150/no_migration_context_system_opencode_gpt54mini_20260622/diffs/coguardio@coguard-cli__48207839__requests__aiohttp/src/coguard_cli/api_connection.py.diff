+async def _request_bytes(
+        method: str,
+        url: str,
+        *,
+        headers=None,
+        data=None,
+        json_body=None,
+        timeout: int):
+    async with aiohttp.ClientSession(
+            timeout=aiohttp.ClientTimeout(total=timeout)) as session:
+        async with session.request(
+                method,
+                url,
+                headers=headers,
+                data=data,
+                json=json_body) as response:
+            return response.status, response.reason, await response.read()
+
+
+async def _download_report_bytes(
+        token,
+        coguard_api_url,
+        organization,
+        username,
+        cluster_name,
+        report_name,
+        location_act) -> None:
+    async with aiohttp.ClientSession(
+            timeout=aiohttp.ClientTimeout(total=300)) as session:
+        if organization:
+            request_url = (
+                f"{coguard_api_url}/cluster/report-audit-zip?organizationName={organization}&"
+                f"clusterName={urllib.parse.quote_plus(cluster_name)}&"
+                f"reportName={urllib.parse.quote_plus(report_name)}"
+            )
+        else:
+            request_url = (
+                f"{coguard_api_url}/coguard-cli/report-audit-zip?userName={username}&"
+                f"clusterName={urllib.parse.quote_plus(cluster_name)}&"
+                f"reportName={urllib.parse.quote_plus(report_name)}"
+            )
+        async with session.get(
+                request_url,
+                headers={
+                    "Authorization": f'Bearer {token.get_token()}'
+                }) as request_stream:
+            request_stream.raise_for_status()
+            with open(location_act, 'wb') as write_stream:
+                async for chunk in request_stream.content.iter_chunked(8192):
+                    write_stream.write(chunk)
 
