+        *,
+        status_code: int,
+        body: bytes,
+        headers: dict[str, str] | None = None,
+        reason: str = "",
+        url: str = "",
+    ) -> None:
+        self.status_code = status_code
+        self.content = body
+        self.headers = headers or {}
+        self.reason = reason or self._reason_for(status_code)
+        self.url = url
+
+    @staticmethod
