+class _PycurlResponse(object):
+    def __init__(self, status_code, headers, content, reason=""):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+        self.reason = reason
+
+    def json(self):
+        if isinstance(self.content, bytes):
+            return loads(self.content.decode("utf-8"))
+        return loads(self.content)
+
+
+class _PycurlSession(object):
+    def __init__(self):
+        self.auth = None
+        self.headers = {}
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        content_type = request_headers.get("Content-Type")
+        payload = data
+        if isinstance(payload, dict):
+            if content_type == "application/x-www-form-urlencoded":
+                payload = urlencode(payload)
+            else:
+                payload = dumps(payload)
+
+        if isinstance(payload, str):
+            payload = payload.encode("utf-8")
+
+        response_body = BytesIO()
+        response_headers = {}
+        status_code = 0
+        reason = ""
+
+        def handle_header(line):
+            nonlocal status_code, reason
+            if not line:
+                return 0
+            decoded = line.decode("iso-8859-1")
+            stripped = decoded.strip()
+            if not stripped:
+                return len(line)
+            if stripped.startswith("HTTP/"):
+                parts = stripped.split(None, 2)
+                if len(parts) > 1:
+                    try:
+                        status_code = int(parts[1])
+                    except ValueError:
+                        status_code = 0
+                reason = parts[2] if len(parts) > 2 else ""
+            elif ":" in stripped:
+                key, value = stripped.split(":", 1)
+                response_headers[key.strip()] = value.strip()
+            return len(line)
+
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, handle_header)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            curl.setopt(pycurl.FOLLOWLOCATION, 0)
+            curl.setopt(pycurl.ACCEPT_ENCODING, "")
+
+            if timeout is not None:
+                curl.setopt(pycurl.TIMEOUT_MS, int(timeout * 1000))
+                curl.setopt(pycurl.CONNECTTIMEOUT_MS, int(timeout * 1000))
+
+            if self.auth:
+                curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+                curl.setopt(pycurl.USERPWD, "%s:%s" % self.auth)
+
+            header_list = ["%s: %s" % (key, value) for key, value in request_headers.items()]
+            if header_list:
+                curl.setopt(pycurl.HTTPHEADER, header_list)
+
+            method = method.upper()
+            if method == "GET":
+                curl.setopt(pycurl.HTTPGET, 1)
+            elif method == "POST":
+                curl.setopt(pycurl.POST, 1)
+                if payload is not None:
+                    curl.setopt(pycurl.POSTFIELDS, payload)
+            else:
+                curl.setopt(pycurl.CUSTOMREQUEST, method)
+                if payload is not None:
+                    curl.setopt(pycurl.POSTFIELDS, payload)
+
+            curl.perform()
+            if not status_code:
+                status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        return _PycurlResponse(status_code, response_headers, response_body.getvalue(), reason)
 
 
