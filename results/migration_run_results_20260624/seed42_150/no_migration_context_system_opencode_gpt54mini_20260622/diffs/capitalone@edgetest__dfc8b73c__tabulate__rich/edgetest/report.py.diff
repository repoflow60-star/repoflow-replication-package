+from rich.text import Text
 
 from edgetest.core import TestPackage
 
 VALID_OUTPUTS = ["rst", "github"]
+
+
+def _cell_width(value: Any) -> int:
+    """Return the displayed width for a table cell."""
+    return Text(str(value)).cell_len
+
+
+def _format_table(rows: List[List[Any]], headers: List[str], output_type: str) -> str:
+    """Format the report table for the supported output styles."""
+    widths = [_cell_width(header) for header in headers]
+    for row in rows:
+        for index, cell in enumerate(row):
+            widths[index] = max(widths[index], _cell_width(cell))
+
+    def _pad(values: List[Any]) -> List[str]:
+        padded = []
+        for index, value in enumerate(values):
+            text = str(value)
+            padded.append(text + " " * (widths[index] - _cell_width(value)))
+        return padded
+
+    if output_type == "rst":
+        separator = "  ".join("=" * width for width in widths)
+        lines = [separator, "  ".join(_pad(headers)), separator]
+        lines.extend("  ".join(_pad(row)) for row in rows)
+        if rows:
+            lines.append(separator)
+        return "\n".join(lines)
+
+    if output_type == "github":
+        header_line = "| " + " | ".join(_pad(headers)) + " |"
+        separator = "|" + "|".join("-" * max(3, width) for width in widths) + "|"
+        lines = [header_line, separator]
+        lines.extend("| " + " | ".join(_pad(row)) + " |" for row in rows)
+        return "\n".join(lines)
+
+    raise ValueError(f"Invalid output_type provided: {output_type}")
+
+
+def tabulate(rows: List[List[Any]], headers: List[str], tablefmt: str = "rst") -> str:
+    """Compatibility wrapper for the report formatter."""
+    return _format_table(rows, headers, tablefmt)
 
 
