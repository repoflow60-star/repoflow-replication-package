+def _ensure_reactor_running() -> None:
+    global _REACTOR_THREAD_STARTED
+    if reactor.running:
+        _REACTOR_READY.set()
+        return
+
+    with _REACTOR_LOCK:
+        if _REACTOR_THREAD_STARTED or reactor.running:
+            return
+
+        def _run() -> None:
+            global _REACTOR_STARTUP_ERROR
+            try:
+                reactor.callWhenRunning(_REACTOR_READY.set)
+                reactor.run(installSignalHandlers=False)
+            except BaseException as exc:
+                _REACTOR_STARTUP_ERROR = exc
+                _REACTOR_READY.set()
+            finally:
+                _REACTOR_READY.set()
+
+        threading.Thread(target=_run, daemon=True).start()
+        _REACTOR_THREAD_STARTED = True
