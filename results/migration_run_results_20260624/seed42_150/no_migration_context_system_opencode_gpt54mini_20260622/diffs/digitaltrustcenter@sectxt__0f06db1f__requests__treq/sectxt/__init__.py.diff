+def _response_code(resp) -> Optional[int]:
+    return getattr(resp, "code", getattr(resp, "status_code", None))
+
+
+def _header_value(resp, header_name: bytes) -> Optional[str]:
+    raw_values = resp.headers.getRawHeaders(header_name)
+    if not raw_values:
+        return None
+    value = raw_values[0]
+    if isinstance(value, bytes):
+        return value.decode("latin-1")
+    return value
+
+
+def _exception_text(exc: Exception) -> str:
+    pieces = []
+    seen = set()
+    stack = [getattr(exc, "value", exc)]
+    while stack:
+        current = stack.pop()
+        marker = id(current)
+        if marker in seen:
+            continue
+        seen.add(marker)
+        pieces.append(current.__class__.__name__.lower())
+        pieces.append(str(current).lower())
+        for nested in (getattr(current, "__cause__", None), getattr(current, "__context__", None)):
+            if nested is not None:
+                stack.append(nested)
+        for nested in getattr(current, "reasons", []) or []:
+            stack.append(nested)
+    return " ".join(pieces)
+
+
+def _is_certificate_error(exc: Exception) -> bool:
+    cause = getattr(exc, "value", exc)
+    if isinstance(cause, CertificateError):
+        return True
+    message = _exception_text(exc)
+    return any(
+        token in message
+        for token in (
+            "certificate",
+            "ssl",
+            "tls",
+            "handshake",
+            "verify failed",
+            "peer verification",
+            "verify error",
+        )
+    )
