+class _Axes:
+    """Altair-backed axes wrapper returned by viz functions."""
+
+    def __init__(self):
+        self._charts = []
+        self._scale_type = "linear"
+        self._legend = False
+        self._bars = []
+        self._chart = None
+
+    def plot(self, x, y, fmt=None, label=None, alpha=None, **kwargs):
+        data = pd.DataFrame({"x": list(x), "y": list(y)})
+        enc = alt.Chart(data).mark_point(opacity=alpha if alpha is not None else 1.0)
+        encoding_kwargs = {"x": alt.X("x:Q"), "y": alt.Y("y:Q")}
+        if label is not None:
+            encoding_kwargs["color"] = alt.value(label)
+        enc = enc.encode(**encoding_kwargs)
+        self._charts.append(enc)
+        self._build()
+        return self
+
+    def loglog(self):
+        self._scale_type = "log"
+        self._build()
+        return self
+
+    def legend(self):
+        self._legend = True
+        self._build()
+        return self
+
+    def bar(self, x, y, alpha=None, **kwargs):
+        data = pd.DataFrame({"x": list(x), "y": list(y)})
+        enc = (
+            alt.Chart(data)
+            .mark_bar(opacity=alpha if alpha is not None else 1.0)
+            .encode(x=alt.X("x:Q"), y=alt.Y("y:Q"))
+        )
+        self._charts.append(enc)
+        self._build()
+        return self
+
+    def _build(self):
+        if not self._charts:
+            self._chart = alt.Chart(pd.DataFrame()).mark_point()
+            return
+        scale = alt.Scale(type=self._scale_type)
+        rebuilt = []
+        for ch in self._charts:
+            if hasattr(ch, "encoding") and ch.encoding is not alt.Undefined:
+                ch = ch.encode(
+                    x=alt.X(ch.encoding.x.shorthand if hasattr(ch.encoding.x, "shorthand") else "x:Q", scale=scale),
+                    y=alt.Y(ch.encoding.y.shorthand if hasattr(ch.encoding.y, "shorthand") else "y:Q", scale=scale),
+                )
+            rebuilt.append(ch)
+        if len(rebuilt) == 1:
+            self._chart = rebuilt[0]
+        else:
+            self._chart = alt.layer(*rebuilt)
+
+    @property
+    def chart(self):
+        if self._chart is None:
+            self._build()
+        return self._chart
+
+
+class _PyplotCompat:
+    """Minimal matplotlib.pyplot-compatible namespace backed by altair."""
+
+    Axes = _Axes
+
+    def gca(self):
+        return _Axes()
+
+
+plt = _PyplotCompat()
 
 
