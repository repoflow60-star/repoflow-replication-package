+def _run_sync(deferred):
+    """Run a Twisted Deferred synchronously by spinning the reactor in a daemon thread."""
+    result_holder = [None]
+    failure_holder = [None]
+    event = threading.Event()
+
+    def on_result(result):
+        result_holder[0] = result
+        event.set()
+
+    def on_failure(failure):
+        failure_holder[0] = failure
+        event.set()
+
+    deferred.addCallback(on_result)
+    deferred.addErrback(on_failure)
+
+    if not _twisted_reactor.running:
+        t = threading.Thread(
+            target=_twisted_reactor.run,
+            kwargs={"installSignalHandlers": False},
+        )
+        t.daemon = True
+        t.start()
+
+    event.wait()
+
+    if failure_holder[0] is not None:
+        failure_holder[0].raiseException()
+    return result_holder[0]
+
+
+@defer.inlineCallbacks
+def _fetch(url):
+    response = yield treq.get(url)
+    if response.code >= 400:
+        raise Exception(f"HTTP {response.code} for {url}")
+    body = yield treq.content(response)
+    return (response, body)
 
 
