+class _TreqResponse:
+    """Adapter that wraps a treq/Twisted response to look like requests.Response."""
+
+    def __init__(self, twisted_response, body_bytes):
+        self._response = twisted_response
+        self._body = body_bytes
+        self.status_code = twisted_response.code
+        # Build a case-insensitive headers dict
+        self.headers = _CaseInsensitiveDict()
+        for name, values in twisted_response.headers.getAllRawHeaders():
+            key = name.decode('utf-8') if isinstance(name, bytes) else name
+            val = values[-1]
+            if isinstance(val, bytes):
+                val = val.decode('utf-8')
+            self.headers[key] = val
