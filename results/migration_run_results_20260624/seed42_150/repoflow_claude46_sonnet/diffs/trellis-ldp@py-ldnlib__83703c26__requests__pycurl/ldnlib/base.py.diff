+class _PyCurlResponse:
+    """Minimal response wrapper that mimics the requests.Response interface."""
+
+    def __init__(self, status_code, headers_raw, body_bytes):
+        self.status_code = status_code
+        self._body_bytes = body_bytes
+        self.headers = self._parse_headers(headers_raw)
+        self.text = body_bytes.decode('utf-8', errors='replace')
+        self.links = self._parse_links(self.headers.get('link', ''))
+
+    @staticmethod
+    def _parse_headers(raw):
+        result = {}
+        for line in raw.splitlines():
+            if b':' in line:
+                name, _, value = line.partition(b':')
+                result[name.strip().lower().decode('latin-1')] = value.strip().decode('latin-1')
+        return result
+
+    @staticmethod
+    def _parse_links(link_header):
+        """Parse a Link header into a dict keyed by rel value."""
+        links = {}
+        for part in link_header.split(','):
+            part = part.strip()
+            m = re.match(r'<([^>]*)>\s*;(.*)', part)
+            if not m:
+                continue
+            url = m.group(1)
+            params_str = m.group(2)
+            params = {'url': url}
+            for param in params_str.split(';'):
+                param = param.strip()
+                pm = re.match(r'(\w+)\s*=\s*"?([^"]*)"?', param)
+                if pm:
+                    params[pm.group(1)] = pm.group(2)
+            rel = params.get('rel', '')
+            links[rel] = params
+        return links
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise OSError(
+                "HTTP error {}: {}".format(self.status_code,
+                                           self._body_bytes[:200]))
+
+    def json(self):
+        return _json.loads(self.text)
+
+
+def _pycurl_request(method, url, headers=None, data=None,
+                    allow_redirects=True, **kwargs):
+    """Perform an HTTP request via pycurl and return a _PyCurlResponse."""
+    buf = io.BytesIO()
+    hdr = io.BytesIO()
+
+    c = pycurl.Curl()
+    c.setopt(pycurl.URL, url)
+    c.setopt(pycurl.WRITEDATA, buf)
+    c.setopt(pycurl.HEADERFUNCTION, hdr.write)
+    c.setopt(pycurl.FOLLOWLOCATION, 1 if allow_redirects else 0)
+
+    method = method.upper()
+    if method == 'HEAD':
+        c.setopt(pycurl.NOBODY, 1)
+    elif method == 'GET':
+        c.setopt(pycurl.HTTPGET, 1)
+    elif method == 'POST':
+        if data is None:
+            post_data = b''
+        elif isinstance(data, bytes):
+            post_data = data
+        elif isinstance(data, str):
+            post_data = data.encode('utf-8')
+        else:
+            post_data = str(data).encode('utf-8')
+        c.setopt(pycurl.POSTFIELDS, post_data)
+    elif method == 'OPTIONS':
+        c.setopt(pycurl.CUSTOMREQUEST, 'OPTIONS')
+        c.setopt(pycurl.NOBODY, 0)
+    else:
+        c.setopt(pycurl.CUSTOMREQUEST, method)
+
+    if headers:
+        curl_headers = ['{}: {}'.format(k, v) for k, v in headers.items()]
+        c.setopt(pycurl.HTTPHEADER, curl_headers)
+
+    c.perform()
+    status_code = c.getinfo(pycurl.RESPONSE_CODE)
+    c.close()
+
+    return _PyCurlResponse(status_code, hdr.getvalue(), buf.getvalue())
 
 
