+def _wordcloud_to_figure(cloud, title: str) -> go.Figure:
+    """Convert a WordCloud object to a plotly Figure using go.Image.
+
+    :param cloud: The WordCloud object.
+    :param title: Title to display above the image.
+    :return: A plotly Figure.
+    """
+    img_array = cloud.to_array()
+    fig = go.Figure(go.Image(z=img_array))
+    fig.update_layout(
+        title=title,
+        paper_bgcolor="white",
+        plot_bgcolor="white",
+        margin=dict(l=0, r=0, t=30, b=0),
+        xaxis=dict(showticklabels=False, ticks="", showgrid=False, zeroline=False),
+        yaxis=dict(showticklabels=False, ticks="", showgrid=False, zeroline=False),
+        width=800,
+        height=500,
+    )
+    return fig
+
