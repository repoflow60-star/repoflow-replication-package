+class _TreqResponseAdapter:
+    """Wraps a treq response to expose a requests-compatible interface."""
+
+    def __init__(self, status_code: int, headers: Dict[str, str], body: bytes) -> None:
+        self.status_code = status_code
+        self.headers = headers
+        self._body = body
+
+    def json(self) -> Any:
+        return _json_module.loads(self._body)
+
+
+def _sync_treq_request(
+    method: str,
+    url: str,
+    params: Dict[str, Any],
+    headers: Dict[str, str],
+    json_body: Optional[Dict[str, Any]],
+) -> "_TreqResponseAdapter":
+    """Execute a treq HTTP request synchronously using blockingCallFromThread."""
+    ensure_reactor_running()
+
+    if json_body is not None:
+        body_bytes = _json_module.dumps(json_body).encode("utf-8")
+        headers = dict(headers)
+        headers["Content-Type"] = "application/json"
+    else:
+        body_bytes = b""
+
+    # Build URL with query parameters
+    if params:
+        from urllib.parse import urlparse, urlunparse, urlencode as _enc
+        parts = list(urlparse(url))
+        query_parts = []
+        for k, v in params.items():
+            if isinstance(v, list):
+                for item in v:
+                    query_parts.append((k, str(item)))
+            else:
+                query_parts.append((k, str(v)))
+        parts[4] = _enc(query_parts)
+        url = urlunparse(parts)
+
+    @defer.inlineCallbacks
+    def _do_request():
+        resp = yield treq.request(
+            method,
+            url,
+            headers=headers,
+            data=body_bytes if body_bytes else None,
+            allow_redirects=False,
+        )
+        content = yield treq.content(resp)
+        resp_headers: Dict[str, str] = {}
+        for k, v in resp.headers.getAllRawHeaders():
+            key = k.decode("utf-8").lower() if isinstance(k, bytes) else k.lower()
+            val = v[-1].decode("utf-8") if isinstance(v[-1], bytes) else v[-1]
+            resp_headers[key] = val
+        defer.returnValue(_TreqResponseAdapter(resp.code, resp_headers, content))
+
+    return threads.blockingCallFromThread(reactor, _do_request)
+
 
