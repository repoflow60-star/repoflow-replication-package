+def _sync_ocsp_post(url: str, headers: dict, data: bytes):
+    """Perform a synchronous OCSP POST using treq via blockingCallFromThread.
+
+    Returns a tuple of (status_code: int, content: bytes).
+    """
+    ensure_reactor_running()
+
+    treq_headers = {k: [v] if isinstance(v, str) else v for k, v in headers.items()}
+
+    @defer.inlineCallbacks
+    def _do():
+        resp = yield treq.post(url, headers=treq_headers, data=data, allow_redirects=False)
+        content = yield treq.content(resp)
+        defer.returnValue((resp.code, content))
+
+    return threads.blockingCallFromThread(reactor, _do)
+
 
