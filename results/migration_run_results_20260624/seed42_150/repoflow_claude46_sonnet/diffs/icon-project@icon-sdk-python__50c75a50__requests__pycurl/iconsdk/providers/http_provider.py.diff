+    def _make_post_request(request_url: str, data: dict, **kwargs):
+        timeout = kwargs.pop('timeout', 10)
+        headers = kwargs.pop('headers', {'Content-Type': 'application/json'})
+        # Drop requests-specific kwargs that pycurl doesn't use
+        kwargs.pop('allow_redirects', None)
+        kwargs.pop('verify', None)
+
+        body = json.dumps(data).encode('utf-8')
+        buf = io.BytesIO()
+
+        c = pycurl.Curl()
+        try:
+            c.setopt(pycurl.URL, request_url)
+            c.setopt(pycurl.POST, 1)
+            c.setopt(pycurl.POSTFIELDS, body.decode('utf-8'))
+            c.setopt(pycurl.WRITEDATA, buf)
+            header_list = [f'{k}: {v}' for k, v in headers.items()]
+            c.setopt(pycurl.HTTPHEADER, header_list)
+            c.setopt(pycurl.TIMEOUT, int(timeout))
+            c.perform()
+            status_code = c.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            c.close()
+
+        raw_content = buf.getvalue()
+
+        class _Response:
+            def __init__(self, status, content):
+                self.status_code = status
+                self.content = content
+
+            @property
+            def ok(self):
+                return 200 <= self.status_code < 300
+
+        return _Response(status_code, raw_content)
 
