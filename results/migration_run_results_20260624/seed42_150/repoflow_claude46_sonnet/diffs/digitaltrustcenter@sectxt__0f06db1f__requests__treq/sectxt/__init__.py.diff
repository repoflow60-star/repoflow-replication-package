+    @staticmethod
+    def _run_deferred(d):
+        """Execute a Twisted Deferred synchronously via asyncio event loop."""
+        loop = asyncio.new_event_loop()
+        try:
+            future = d.asFuture(loop)
+            return loop.run_until_complete(future)
+        finally:
+            loop.close()
+
+    @staticmethod
+    def _get_redirect_chain(resp):
+        """Return a list of responses forming the redirect chain (oldest first)."""
+        chain = []
+        current = resp
+        while current is not None:
+            chain.append(current)
+            current = getattr(current, 'previousResponse', None)
+        chain.reverse()
+        return chain
+
+    @staticmethod
+    def _get_final_url(resp, original_url):
+        """Return the final URL of the response after any redirects."""
+        # Twisted IResponse exposes .request which has absoluteURI
+        req = getattr(resp, 'request', None)
+        if req is not None:
+            uri = getattr(req, 'absoluteURI', None)
+            if uri is not None:
+                if isinstance(uri, bytes):
+                    return uri.decode('utf-8', errors='replace')
+                return uri
+        return original_url
+
+    @defer.inlineCallbacks
+    def _fetch_url(self, url, allow_ssl_errors=False):
+        """Fetch a URL using treq and return (resp, body_bytes) or raise."""
+        headers = {
+            b'User-Agent': [
+                b'Mozilla/5.0 (Windows NT 6.1; WOW64; rv:12.0) Gecko/20100101 Firefox/12.0'
+            ]
+        }
+        if allow_ssl_errors:
+            ctx_factory = twisted_ssl.CertificateOptions(verify=False)
+            resp = yield treq.get(
+                url,
+                headers=headers,
+                timeout=5,
+                contextFactory=ctx_factory,
+            )
+        else:
+            resp = yield treq.get(
+                url,
+                headers=headers,
+                timeout=5,
+            )
+        body = yield treq.content(resp)
+        return (resp, body)
+
+    def _is_ssl_error(self, exc):
+        """Return True if the exception is an SSL certificate verification error."""
+        exc_type_name = type(exc).__name__
+        if 'SSL' in exc_type_name or 'Certificate' in exc_type_name or 'Verify' in exc_type_name:
+            return True
+        if _OpenSSLError is not None and isinstance(exc, _OpenSSLError):
+            return True
+        cause = getattr(exc, '__cause__', None) or getattr(exc, '__context__', None)
+        if cause is not None and cause is not exc:
+            return self._is_ssl_error(cause)
+        return False
