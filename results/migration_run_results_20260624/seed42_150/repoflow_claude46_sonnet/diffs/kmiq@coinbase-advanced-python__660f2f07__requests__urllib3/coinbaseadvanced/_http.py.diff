--- a/coinbaseadvanced/_http.py
+++ b/coinbaseadvanced/_http.py
@@ -0,0 +1,58 @@
+"""
+Thin urllib3-based HTTP helpers that expose a requests-compatible interface.
+"""
+
+import json as _json
+
+import urllib3
+
+_pool = urllib3.PoolManager()
+
+
+class _Response:
+    """Wraps urllib3.HTTPResponse to expose .ok, .text, and .json()."""
+
+    def __init__(self, resp: urllib3.HTTPResponse) -> None:
+        self._resp = resp
+        self._data = resp.data
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self._resp.status < 300
+
+    @property
+    def text(self) -> str:
+        return self._data.decode('utf-8', errors='replace')
+
+    def json(self):
+        return _json.loads(self._data)
+
+
+def get(url, headers=None, timeout=None):
+    resp = _pool.request('GET', url, headers=headers, timeout=timeout)
+    return _Response(resp)
+
+
+def post(url, json=None, headers=None, timeout=None):
+    body = _json.dumps(json).encode('utf-8') if json is not None else None
+    hdrs = dict(headers) if headers else {}
+    hdrs['Content-Type'] = 'application/json'
+    resp = _pool.request('POST', url, body=body, headers=hdrs, timeout=timeout)
+    return _Response(resp)
+
+
+def put(url, json=None, headers=None, timeout=None):
+    body = _json.dumps(json).encode('utf-8') if json is not None else None
+    hdrs = dict(headers) if headers else {}
+    hdrs['Content-Type'] = 'application/json'
+    resp = _pool.request('PUT', url, body=body, headers=hdrs, timeout=timeout)
+    return _Response(resp)
+
+
+def delete(url, json=None, headers=None, timeout=None):
+    body = _json.dumps(json).encode('utf-8') if json is not None else None
+    hdrs = dict(headers) if headers else {}
+    if body is not None:
+        hdrs['Content-Type'] = 'application/json'
+    resp = _pool.request('DELETE', url, body=body, headers=hdrs, timeout=timeout)
+    return _Response(resp)
