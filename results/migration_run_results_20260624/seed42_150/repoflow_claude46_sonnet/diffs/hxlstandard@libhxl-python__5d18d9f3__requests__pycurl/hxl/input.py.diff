+########################################################################
+# pycurl HTTP helpers (replaces requests)
+########################################################################
+
+class _PyCurlResponse:
+    """Minimal response object using pycurl, mimicking the requests.Response interface."""
+
+    def __init__(self, status_code, headers_raw, body_bytes, redirect_url=None):
+        self.status_code = status_code
+        self.content = body_bytes
+        self._headers = headers_raw  # dict with lowercase keys
+        self._redirect_url = redirect_url
+
+    @property
+    def headers(self):
+        return self._headers
+
+    @property
+    def is_redirect(self):
+        return self._redirect_url is not None
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise IOError("HTTP error {}: {}".format(self.status_code, self._headers.get('x-status-line', '')))
+
+    def json(self):
+        return json.loads(self.content.decode('utf-8'))
+
+
+def _pycurl_request(method, url, verify_ssl=True, timeout=None, headers=None, params=None, data=None, follow_redirects=True):
+    """Perform an HTTP request using pycurl and return a _PyCurlResponse."""
+
+    if params:
+        encoded = urllib.parse.urlencode(params)
+        url = url + ('&' if '?' in url else '?') + encoded
+
+    body_buf = io.BytesIO()
+    header_buf = io.BytesIO()
+
+    c = pycurl.Curl()
+    try:
+        c.setopt(pycurl.URL, url)
+        c.setopt(pycurl.WRITEDATA, body_buf)
+        c.setopt(pycurl.HEADERFUNCTION, header_buf.write)
+
+        if follow_redirects:
+            c.setopt(pycurl.FOLLOWLOCATION, 1)
+            c.setopt(pycurl.MAXREDIRS, 10)
+        else:
+            c.setopt(pycurl.FOLLOWLOCATION, 0)
+
+        if not verify_ssl:
+            c.setopt(pycurl.SSL_VERIFYPEER, 0)
+            c.setopt(pycurl.SSL_VERIFYHOST, 0)
+
+        if timeout is not None:
+            c.setopt(pycurl.TIMEOUT, int(timeout))
+
+        curl_headers = []
+        if headers:
+            for k, v in headers.items():
+                curl_headers.append('{}: {}'.format(k, v))
+        if curl_headers:
+            c.setopt(pycurl.HTTPHEADER, curl_headers)
+
+        if method.upper() == 'HEAD':
+            c.setopt(pycurl.NOBODY, 1)
+        elif method.upper() == 'POST':
+            c.setopt(pycurl.POST, 1)
+            if data:
+                encoded_data = urllib.parse.urlencode(data).encode('utf-8')
+                c.setopt(pycurl.POSTFIELDS, encoded_data.decode('utf-8'))
+
+        try:
+            c.perform()
+        except pycurl.error as e:
+            raise IOError(str(e)) from e
+
+        status_code = c.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        c.close()
+
+    # Parse headers — when following redirects pycurl gives all intermediate headers;
+    # we only care about the final block (after the last HTTP/ status line).
+    raw_headers = header_buf.getvalue().decode('iso-8859-1', errors='replace')
+    parsed_headers = {}
+    redirect_location = None
+
+    # Split header blocks; the last non-empty block is the final response headers
+    blocks = re.split(r'(?m)^HTTP/', raw_headers)
+    final_block = ''
+    for block in blocks:
+        stripped = block.strip()
+        if stripped:
+            final_block = 'HTTP/' + block
+
+    for line in final_block.splitlines():
+        if line.startswith('HTTP/'):
+            parsed_headers['x-status-line'] = line
+        elif ':' in line:
+            k, _, v = line.partition(':')
+            parsed_headers[k.strip().lower()] = v.strip()
+
+    if status_code in (301, 302, 303, 307, 308) and 'location' in parsed_headers:
+        redirect_location = parsed_headers['location']
+
+    return _PyCurlResponse(
+        status_code=status_code,
+        headers_raw=parsed_headers,
+        body_bytes=body_buf.getvalue(),
+        redirect_url=redirect_location,
+    )
+
+
+def _pycurl_get(url, verify_ssl=True, timeout=None, headers=None, params=None):
+    return _pycurl_request('GET', url, verify_ssl=verify_ssl, timeout=timeout, headers=headers, params=params, follow_redirects=True)
+
+
+def _pycurl_head(url, verify_ssl=True, timeout=None, headers=None):
+    return _pycurl_request('HEAD', url, verify_ssl=verify_ssl, timeout=timeout, headers=headers, follow_redirects=False)
+
+
+def _pycurl_post(url, verify_ssl=True, timeout=None, headers=None, data=None):
+    return _pycurl_request('POST', url, verify_ssl=verify_ssl, timeout=timeout, headers=headers, data=data, follow_redirects=True)
+
 
