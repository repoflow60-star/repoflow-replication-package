+from rich.text import Text
 
 from edgetest.core import TestPackage
 
 VALID_OUTPUTS = ["rst", "github"]
+
+_COL_SEP = "  "
+
+
+def _plain(value: Any) -> str:
+    """Return the plain-text representation of a value using rich Text."""
+    return Text.from_markup(str(value)).plain
+
+
+def _col_widths(rows: List[List], headers: List[str]) -> List[int]:
+    """Compute column display widths.
+
+    Each column width is ``max(len(header) + 2, max_data_cell_len)``, which
+    reproduces the one-space padding that tabulate adds to each side of the
+    header before comparing against data cell widths.
+    """
+    return [
+        max(
+            len(_plain(headers[i])) + 2,
+            max(len(_plain(row[i])) for row in rows) if rows else 0,
+        )
+        for i in range(len(headers))
+    ]
+
+
+def _render_rst(rows: List[List], headers: List[str]) -> str:
+    """Render an RST-style table using rich Text for cell measurement."""
+    widths = _col_widths(rows, headers)
+    sep = _COL_SEP.join("=" * w for w in widths)
+
+    def _fmt_row(row: List) -> str:
+        cells = [_plain(row[i]).ljust(widths[i]) for i in range(len(row))]
+        return _COL_SEP.join(cells).rstrip()
+
+    lines = [sep, _fmt_row(headers), sep]
+    for row in rows:
+        lines.append(_fmt_row(row))
+    lines.append(sep)
+    return "\n".join(lines)
+
+
+def _render_github(rows: List[List], headers: List[str]) -> str:
+    """Render a GitHub-style markdown table using rich Text for cell measurement."""
+    widths = _col_widths(rows, headers)
+
+    def _fmt_row(row: List) -> str:
+        cells = [_plain(row[i]).ljust(widths[i]) for i in range(len(row))]
+        return "| " + " | ".join(cells) + " |"
+
+    sep_row = "| " + " | ".join("-" * w for w in widths) + " |"
+    lines = [_fmt_row(headers), sep_row]
+    for row in rows:
+        lines.append(_fmt_row(row))
+    return "\n".join(lines)
+
+
+def tabulate(rows: List[List], headers: List[str] = (), tablefmt: str = "rst") -> str:
+    """Render a table using rich, mimicking the tabulate API.
+
+    Parameters
+    ----------
+    rows : list
+        A list of row lists.
+    headers : list
+        A list of column header strings.
+    tablefmt : str
+        Output format: ``rst`` or ``github``.
+
+    Returns
+    -------
+    str
+        The rendered table string.
+    """
+    if tablefmt == "github":
+        return _render_github(rows, list(headers))
+    return _render_rst(rows, list(headers))
 
 
