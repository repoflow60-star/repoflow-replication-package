+def _run_deferred(d):
+    """Run a Twisted Deferred synchronously and return its result."""
+    results = []
+    errors = []
+
+    def on_result(value):
+        results.append(value)
+
+    def on_error(failure):
+        errors.append(failure)
+
+    d.addCallbacks(on_result, on_error)
+    while not results and not errors:
+        reactor.iterate(0.01)
+    if errors:
+        errors[0].raiseException()
+    return results[0]
 
 
