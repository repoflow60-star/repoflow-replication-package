+def _rst_table(rows: List[List], headers: List[str]) -> str:
+    """Render rows and headers as an RST simple table.
+
+    Replicates tabulate's ``rst`` tablefmt output exactly: column separator
+    width is ``max(header_len, max_data_len)``, columns are separated by two
+    spaces.
+
+    Parameters
+    ----------
+    rows : list
+        List of row lists.
+    headers : list
+        Column header strings.
+
+    Returns
+    -------
+    str
+        RST-formatted table string.
+    """
+    col_widths = [len(str(h)) for h in headers]
+    for row in rows:
+        for i, cell in enumerate(row):
+            col_widths[i] = max(col_widths[i], len(str(cell)))
+
+    sep = "  ".join("=" * w for w in col_widths)
+    header_line = "  ".join(str(h).ljust(col_widths[i]) for i, h in enumerate(headers))
+    header_line = header_line.rstrip()
+    lines = [sep, header_line, sep]
+    for row in rows:
+        line = "  ".join(str(cell).ljust(col_widths[i]) for i, cell in enumerate(row))
+        lines.append(line.rstrip())
+    lines.append(sep)
+    return "\n".join(lines)
+
+
+def _github_table(rows: List[List], headers: List[str]) -> str:
+    """Render rows and headers as a GitHub-flavored Markdown table.
+
+    Parameters
+    ----------
+    rows : list
+        List of row lists.
+    headers : list
+        Column header strings.
+
+    Returns
+    -------
+    str
+        GitHub Markdown formatted table string.
+    """
+    table = PrettyTable()
+    table.field_names = headers
+    for row in rows:
+        table.add_row(row)
+    table.set_style(MARKDOWN)
+    return table.get_string()
+
+
+def tabulate(rows: List[List], headers: List[str], tablefmt: str = "rst") -> str:
+    """Render a table using prettytable, mimicking the tabulate interface.
+
+    Parameters
+    ----------
+    rows : list
+        List of row lists.
+    headers : list
+        Column header strings.
+    tablefmt : str
+        Output format: ``"rst"`` or ``"github"``.
+
+    Returns
+    -------
+    str
+        Formatted table string.
+    """
+    if tablefmt == "rst":
+        return _rst_table(rows, headers)
+    return _github_table(rows, headers)
 
 
