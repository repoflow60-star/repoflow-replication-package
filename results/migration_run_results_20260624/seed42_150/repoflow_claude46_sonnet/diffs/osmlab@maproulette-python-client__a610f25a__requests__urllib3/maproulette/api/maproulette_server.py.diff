+def _append_params(url, params):
+    """Append query-string parameters to a URL."""
+    if not params:
+        return url
+    parsed = urlparse(url)
+    items = params.items() if isinstance(params, dict) else params
+    query_str = urlencode([(k, v) for k, v in items if v is not None])
+    return urlunparse(parsed._replace(query=query_str))
+
+
+class _HTTPError(Exception):
+    """Minimal stand-in for requests.exceptions.HTTPError."""
+    def __init__(self, response=None):
+        self.response = response
+        super().__init__()
+
+
+class _ConnectionError(Exception):
+    """Minimal stand-in for requests.exceptions.ConnectionError."""
+    pass
+
+
+class _Timeout(Exception):
+    """Minimal stand-in for requests.Timeout."""
+    pass
+
+
+class _Exceptions:
+    HTTPError = _HTTPError
+    ConnectionError = _ConnectionError
+    Timeout = _Timeout
+
+
+class _Urllib3Response:
+    """Thin wrapper over urllib3.HTTPResponse that exposes a requests-compatible interface."""
+
+    def __init__(self, raw):
+        self._raw = raw
+        self.status_code = raw.status
+        self._body = raw.data  # reads and closes the socket
+
+    @property
+    def ok(self):
+        return 200 <= self.status_code < 300
+
+    @property
+    def text(self):
+        return self._body.decode('utf-8', errors='replace')
+
+    def json(self):
+        return _json_module.loads(self._body)
+
+    def raise_for_status(self):
+        if not self.ok:
+            raise _HTTPError(response=self)
+
+
+class _Urllib3Session:
+    """urllib3-backed HTTP session with a requests.Session-compatible interface."""
+
+    def __init__(self):
+        self.headers = {}
+        self.verify = True
+        self.cert = None
+
+    def _build_pool(self):
+        kwargs = {}
+        if not self.verify:
+            kwargs['cert_reqs'] = 'CERT_NONE'
+            urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)
+        else:
+            kwargs['cert_reqs'] = 'CERT_REQUIRED'
+        if self.cert:
+            if isinstance(self.cert, tuple):
+                kwargs['key_file'], kwargs['cert_file'] = self.cert
+            else:
+                kwargs['cert_file'] = self.cert
+        return urllib3.PoolManager(headers=self.headers, **kwargs)
+
+    def get(self, url, params=None):
+        pool = self._build_pool()
+        return _Urllib3Response(pool.request('GET', _append_params(url, params)))
+
+    def post(self, url, json=None, params=None):
+        pool = self._build_pool()
+        full_url = _append_params(url, params)
+        if json is not None:
+            encoded = _json_module.dumps(json).encode('utf-8')
+            merged_headers = dict(self.headers)
+            merged_headers['Content-Type'] = 'application/json'
+            raw = pool.request('POST', full_url, body=encoded, headers=merged_headers)
+        else:
+            raw = pool.request('POST', full_url)
+        return _Urllib3Response(raw)
+
+    def put(self, url, json=None, params=None, files=None):
+        pool = self._build_pool()
+        full_url = _append_params(url, params)
+        if json is not None:
+            encoded = _json_module.dumps(json).encode('utf-8')
+            merged_headers = dict(self.headers)
+            merged_headers['Content-Type'] = 'application/json'
+            raw = pool.request('PUT', full_url, body=encoded, headers=merged_headers)
+        elif files is not None:
+            raw = pool.request('PUT', full_url, fields=files)
+        else:
+            raw = pool.request('PUT', full_url)
+        return _Urllib3Response(raw)
+
+    def delete(self, url, params=None):
+        pool = self._build_pool()
+        return _Urllib3Response(pool.request('DELETE', _append_params(url, params)))
+
+
+class _RequestsModule:
+    """Module-level compatibility namespace so that tests can patch via the 'requests' name."""
+    Session = _Urllib3Session
+    exceptions = _Exceptions
+    ConnectionError = _ConnectionError
+    Timeout = _Timeout
+
+
+requests = _RequestsModule()
 
 
