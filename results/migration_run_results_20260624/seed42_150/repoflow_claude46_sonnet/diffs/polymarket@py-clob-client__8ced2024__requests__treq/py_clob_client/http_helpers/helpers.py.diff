+class _ResponseAdapter:
+    """Adapt a treq response + body bytes to the interface expected by PolyApiException."""
+
+    def __init__(self, code, body_bytes):
+        self.status_code = code
+        self.text = body_bytes.decode("utf-8", errors="replace")
+
+    def json(self):
+        return _json.loads(self.text)
+
+
+def _run_deferred(d):
+    """Run a Deferred synchronously by temporarily driving the reactor."""
+    results = []
+    errors = []
+
+    d.addCallback(results.append)
+    d.addErrback(errors.append)
+
+    while not results and not errors:
+        reactor.iterate(0.01)
+
+    if errors:
+        failure = errors[0]
+        failure.raiseException()
+
+    return results[0]
+
