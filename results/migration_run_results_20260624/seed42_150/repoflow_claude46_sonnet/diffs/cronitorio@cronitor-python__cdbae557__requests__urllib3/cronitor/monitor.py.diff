+class _Urllib3Session(object):
+    """Thin wrapper around urllib3.PoolManager exposing a requests-compatible API."""
+
+    def __init__(self, pool_manager):
+        self._pool = pool_manager
+
+    def _build_headers(self, headers, auth=None):
+        h = {k: v for k, v in (headers or {}).items() if v is not None}
+        if auth:
+            h['Authorization'] = urllib3.make_headers(
+                basic_auth='{}:{}'.format(auth[0], auth[1])
+            )['authorization']
+        return h
+
+    def _wrap(self, resp):
+        resp.status_code = resp.status
+        raw = resp.data or b''
+        resp.text = raw.decode('utf-8')
+        def _json():
+            return json.loads(raw.decode('utf-8'))
+        resp.json = _json
+        return resp
+
+    def get(self, url=None, params=None, headers=None, timeout=None, auth=None):
+        h = self._build_headers(headers, auth)
+        fields = {k: v for k, v in params.items() if v is not None} if params else None
+        resp = self._pool.request('GET', url, fields=fields, headers=h, timeout=timeout)
+        return self._wrap(resp)
+
+    def put(self, url, data=None, headers=None, timeout=None, auth=None):
+        h = self._build_headers(headers, auth)
+        body = data.encode('utf-8') if isinstance(data, str) else data
+        resp = self._pool.request('PUT', url, body=body, headers=h, timeout=timeout)
+        return self._wrap(resp)
+
+    def delete(self, url, headers=None, timeout=None, auth=None):
+        h = self._build_headers(headers, auth)
+        resp = self._pool.request('DELETE', url, headers=h, timeout=timeout)
+        return self._wrap(resp)
+
