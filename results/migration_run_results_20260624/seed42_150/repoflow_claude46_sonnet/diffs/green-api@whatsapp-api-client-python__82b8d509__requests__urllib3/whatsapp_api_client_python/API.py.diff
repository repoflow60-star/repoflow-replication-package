+class _Urllib3Response:
+    """Thin wrapper around urllib3.HTTPResponse to expose .status_code and .text."""
+
+    def __init__(self, urllib3_response: urllib3.HTTPResponse):
+        self._response = urllib3_response
+        self._data = urllib3_response.data
+
+    @property
+    def status_code(self) -> int:
+        return self._response.status
+
+    @property
+    def text(self) -> str:
+        return self._data.decode("utf-8")
+
+
+class Session:
+    """urllib3-backed session with an interface compatible with requests.Session.request()."""
+
+    def __init__(self, pool_manager: urllib3.PoolManager):
+        self._pool_manager = pool_manager
+
+    def request(self, method: str, url: str, **kwargs) -> _Urllib3Response:
+        # Translate requests-style kwargs to urllib3-style
+        body = None
+        headers = {}
+
+        # json payload
+        if "json" in kwargs:
+            payload = kwargs.pop("json")
+            if payload is not None:
+                body = json.dumps(payload).encode("utf-8")
+                headers["Content-Type"] = "application/json"
+            else:
+                kwargs.pop("json", None)
+
+        # multipart files
+        if "files" in kwargs:
+            files = kwargs.pop("files")
+            data = kwargs.pop("data", None)
+            fields = {}
+            if data:
+                for k, v in data.items():
+                    fields[k] = str(v)
+            for field_name, file_tuple in files.items():
+                file_name, file_obj, content_type = file_tuple
+                file_data = file_obj.read() if hasattr(file_obj, "read") else file_obj
+                fields[field_name] = (file_name, file_data, content_type)
+            encoded, content_type_header = urllib3.request.encode_multipart_formdata(fields)
+            body = encoded
+            headers["Content-Type"] = content_type_header
+
+        # data (non-files form data)
+        if "data" in kwargs:
+            data = kwargs.pop("data")
+            if data is not None:
+                body = data if isinstance(data, bytes) else str(data).encode("utf-8")
+
+        # timeout
+        timeout = kwargs.pop("timeout", None)
+        urllib3_timeout = urllib3.Timeout(total=timeout) if timeout is not None else urllib3.Timeout(total=None)
+
+        headers["Connection"] = "close"
+
+        raw = self._pool_manager.request(
+            method,
+            url,
+            body=body,
+            headers=headers,
+            timeout=urllib3_timeout,
+            preload_content=True,
+        )
+        return _Urllib3Response(raw)
 
 
