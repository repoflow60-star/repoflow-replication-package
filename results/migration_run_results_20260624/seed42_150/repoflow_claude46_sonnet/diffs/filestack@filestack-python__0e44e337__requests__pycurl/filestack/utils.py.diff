+class _RetrySession:
+    """
+    Minimal session-like object with retry support for POST requests.
+    Used by intelligent_ingestion.py for the multipart/complete endpoint.
+    """
+    def __init__(self):
+        self._max_retries = 7
+        self._backoff_factor = 0.2
+        self._retry_statuses = {202}
+        self._headers = {}
+
+    def mount(self, prefix, adapter):
+        # Extract retry config from HTTPAdapter if possible
+        if hasattr(adapter, 'max_retries') and hasattr(adapter.max_retries, 'total'):
+            self._max_retries = adapter.max_retries.total
+            self._backoff_factor = getattr(adapter.max_retries, 'backoff_factor', 0.2)
+            self._retry_statuses = set(getattr(adapter.max_retries, 'status_forcelist', [202]))
+
+    def post(self, url, json=None, headers=None, **kwargs):
+        merged_headers = dict(self._headers)
+        if headers:
+            merged_headers.update(headers)
+
+        last_response = None
+        for attempt in range(self._max_retries + 1):
+            if attempt > 0:
+                sleep_time = self._backoff_factor * (2 ** (attempt - 1))
+                time.sleep(sleep_time)
+
+            response = _perform_request(
+                'POST', url,
+                headers=merged_headers if merged_headers else None,
+                json_data=json,
+            )
+            last_response = response
+
+            if response.status_code not in self._retry_statuses:
+                break
+
+        return last_response
+
+
