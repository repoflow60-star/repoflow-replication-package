+class _PycurlResponse:
+    """Minimal response wrapper returned by PycurlSession methods."""
+
+    def __init__(self, status_code: int, body: bytes, headers: dict):
+        self.status_code = status_code
+        self._body = body
+        self._headers = headers
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status_code < 300
+
+    @property
+    def content(self) -> bytes:
+        return self._body
+
+    @property
+    def text(self) -> str:
+        return self._body.decode("utf-8", errors="replace")
+
+    def json(self):
+        return _json.loads(self._body)
+
+    def __str__(self):
+        return f"<Response [{self.status_code}]>"
+
+
+class PycurlSession:
+    """A minimal session-compatible wrapper around pycurl."""
+
+    def __init__(self):
+        self.cookies: CookieJar = CookieJar()
+        self.headers: dict = {}
+
+    def _build_cookie_header(self) -> str:
+        parts = []
+        for cookie in self.cookies:
+            parts.append(f"{cookie.name}={cookie.value}")
+        return "; ".join(parts)
+
+    def _perform(
+        self,
+        url: str,
+        method: str = "GET",
+        data: Optional[bytes] = None,
+        params: Optional[dict] = None,
+        extra_headers: Optional[dict] = None,
+        json_body=None,
+    ) -> _PycurlResponse:
+        if params:
+            query = urlencode(params)
+            separator = "&" if "?" in url else "?"
+            url = url + separator + query
+
+        buffer = io.BytesIO()
+        header_buffer = io.BytesIO()
+
+        c = pycurl.Curl()
+        try:
+            c.setopt(pycurl.URL, url)
+            c.setopt(pycurl.WRITEDATA, buffer)
+            c.setopt(pycurl.HEADERFUNCTION, header_buffer.write)
+            c.setopt(pycurl.FOLLOWLOCATION, 1)
+            c.setopt(pycurl.SSL_VERIFYPEER, 1)
+
+            # Build headers
+            combined_headers = dict(self.headers)
+            if extra_headers:
+                combined_headers.update(extra_headers)
+
+            # Handle JSON body
+            if json_body is not None:
+                encoded = _json.dumps(json_body).encode("utf-8")
+                combined_headers["Content-Type"] = "application/json"
+                c.setopt(pycurl.POSTFIELDS, encoded)
+                c.setopt(pycurl.POST, 1)
+                c.setopt(pycurl.POSTFIELDSIZE, len(encoded))
+            elif method == "POST":
+                if data is not None:
+                    c.setopt(pycurl.POSTFIELDS, data)
+                    c.setopt(pycurl.POST, 1)
+                    c.setopt(pycurl.POSTFIELDSIZE, len(data))
+                else:
+                    c.setopt(pycurl.POST, 1)
+                    c.setopt(pycurl.POSTFIELDSIZE, 0)
+
+            # Set cookie header
+            cookie_str = self._build_cookie_header()
+            if cookie_str:
+                combined_headers["Cookie"] = cookie_str
+
+            if combined_headers:
+                header_list = [
+                    f"{k}: {v}" for k, v in combined_headers.items()
+                ]
+                c.setopt(pycurl.HTTPHEADER, header_list)
+
+            c.perform()
+            status_code = c.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            c.close()
+
+        raw_headers = header_buffer.getvalue().decode("utf-8", errors="replace")
+        parsed_headers = {}
+        for line in raw_headers.splitlines():
+            if ":" in line:
+                k, _, v = line.partition(":")
+                parsed_headers[k.strip().lower()] = v.strip()
+
+        body = buffer.getvalue()
+        return _PycurlResponse(status_code, body, parsed_headers)
+
+    def get(self, url: str, **kwargs) -> _PycurlResponse:
+        params = kwargs.get("params")
+        extra_headers = kwargs.get("headers")
+        return self._perform(url, method="GET", params=params, extra_headers=extra_headers)
+
+    def post(self, url: str, **kwargs) -> _PycurlResponse:
+        data = kwargs.get("data")
+        params = kwargs.get("params")
+        json_body = kwargs.get("json")
