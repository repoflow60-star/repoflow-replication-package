 log = logging.getLogger("bigcommerce.connection")
 
 
+class _HttpxSession(object):
+    """
+    Thin wrapper around httpx.Client that preserves the requests.Session interface
+    expected by Connection and its subclasses (auth as tuple, headers as plain dict,
+    and a request() method with the same signature).
+    """
+
+    def __init__(self):
+        self.auth = None
+        self.headers = {}
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        merged_headers = dict(self.headers)
+        if headers:
+            merged_headers.update(headers)
+        kwargs = {
+            'headers': merged_headers,
+        }
+        if data is not None:
+            kwargs['content'] = data if isinstance(data, (bytes, str)) else data
+        if timeout is not None:
+            kwargs['timeout'] = timeout
+        if self.auth is not None:
+            kwargs['auth'] = self.auth
+        with httpx.Client() as client:
+            return client.request(method, url, **kwargs)
+
+
 class Connection(object):
