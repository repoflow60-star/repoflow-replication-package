+async def _async_post(url, data, headers, timeout):
+    timeout_obj = aiohttp.ClientTimeout(total=timeout)
+    async with aiohttp.ClientSession() as session:
+        async with session.post(url, data=data, headers=headers, timeout=timeout_obj) as resp:
+            body = await resp.read()
+            return _AiohttpResponse(resp.status, dict(resp.headers), body)
+
+
+class _AiohttpResponse:
+    """Minimal response wrapper matching the interface used in oauth_manager."""
+
+    def __init__(self, status_code, headers, body_bytes):
+        self.status_code = status_code
+        self.headers = headers
+        self._body_bytes = body_bytes
+
+    @property
+    def text(self):
+        return self._body_bytes.decode('utf-8', errors='replace')
+
+    @property
+    def reason(self):
+        return self.headers.get('X-Reason', '')
+
+    def json(self):
+        return json.loads(self._body_bytes)
 
