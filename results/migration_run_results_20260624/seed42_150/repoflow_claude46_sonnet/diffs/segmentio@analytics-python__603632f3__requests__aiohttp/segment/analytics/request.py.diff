+class _Response:
+    """Minimal response wrapper to expose the interface expected by callers."""
+
+    def __init__(self, status_code, headers, body_bytes):
+        self.status_code = status_code
+        self.headers = headers
+        self._body_bytes = body_bytes
+
+    @property
+    def text(self):
+        return self._body_bytes.decode('utf-8', errors='replace')
+
+    @property
+    def reason(self):
+        return self.headers.get('X-Reason', '')
+
+    def json(self):
+        return json.loads(self._body_bytes)
+
+
+class ReadTimeout(OSError):
+    """Raised when the HTTP request times out."""
+
+
+async def _async_post(url, data, headers, timeout, proxies):
+    timeout_obj = aiohttp.ClientTimeout(total=timeout)
+    proxy = None
+    if proxies:
+        if isinstance(proxies, str):
+            proxy = proxies if proxies.startswith('http') else 'http://' + proxies
+        elif isinstance(proxies, dict):
+            proxy = proxies.get('https') or proxies.get('http')
+
+    async with aiohttp.ClientSession() as session:
+        async with session.post(
+            url,
+            data=data,
+            headers=headers,
+            timeout=timeout_obj,
+            proxy=proxy,
+        ) as resp:
+            body = await resp.read()
+            return _Response(resp.status, dict(resp.headers), body)
 
 
