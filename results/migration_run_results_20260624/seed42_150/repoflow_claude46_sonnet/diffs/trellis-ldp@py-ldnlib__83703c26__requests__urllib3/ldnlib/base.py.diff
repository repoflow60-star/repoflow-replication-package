 from rdflib import Graph, URIRef
-import requests
+import urllib3
+import re
+
+
+def _raise_for_status(response):
+    """Raise an exception if the HTTP response status is 4xx or 5xx."""
+    if response.status >= 400:
+        raise urllib3.exceptions.HTTPError(
+            "HTTP Error {}: {}".format(response.status, response.reason)
+        )
+
+
+def _parse_link_header(link_header):
+    """
+    Parse a Link header into a dict keyed by relation type.
+    Returns a dict of {rel: {'url': url, ...}}.
+    """
+    links = {}
+    if not link_header:
+        return links
+    for part in link_header.split(','):
+        part = part.strip()
+        match = re.match(r'<([^>]*)>(.*)', part)
+        if not match:
+            continue
+        url = match.group(1)
+        params_str = match.group(2)
+        params = {}
+        for param in params_str.split(';'):
+            param = param.strip()
+            if '=' in param:
+                key, _, val = param.partition('=')
+                params[key.strip()] = val.strip().strip('"')
+        rel = params.get('rel')
+        if rel:
+            links[rel] = {'url': url}
+            links[rel].update(params)
+    return links
 
 
