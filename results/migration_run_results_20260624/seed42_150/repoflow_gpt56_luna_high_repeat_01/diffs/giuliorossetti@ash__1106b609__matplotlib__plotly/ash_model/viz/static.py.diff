+
+def _figure(kwargs):
+    figure = kwargs.get("fig", kwargs.get("ax"))
+    return figure if isinstance(figure, go.Figure) else go.Figure()
+
+
+def _trace_kwargs(kwargs, trace_type="line"):
+    trace_kwargs = {
+        key: value
+        for key, value in kwargs.items()
+        if key not in {"ax", "fig", "label", "alpha"}
+    }
+    if "alpha" in kwargs:
+        trace_kwargs["opacity"] = kwargs["alpha"]
+    if "label" in kwargs:
+        trace_kwargs["name"] = kwargs["label"]
+    if "color" in trace_kwargs:
+        color = trace_kwargs.pop("color")
+        trace_kwargs[
+            "marker_color" if trace_type in {"scatter", "bar"} else "line_color"
+        ] = color
+    if trace_type == "scatter" and isinstance(trace_kwargs.get("marker"), str):
+        marker = trace_kwargs.pop("marker")
+        trace_kwargs["marker_symbol"] = {
+            ".": "circle",
+            "o": "circle",
+            "s": "square",
+            "^": "triangle-up",
+            "v": "triangle-down",
+            "*": "star",
+            "x": "x",
+            "+": "cross",
+        }.get(marker, marker)
+    elif trace_type == "bar" and isinstance(trace_kwargs.get("marker"), str):
+        trace_kwargs.pop("marker")
+    if "linewidth" in trace_kwargs:
+        trace_kwargs["line_width"] = trace_kwargs.pop("linewidth")
+    if "linestyle" in trace_kwargs:
+        linestyle = trace_kwargs.pop("linestyle")
+        trace_kwargs["line_dash"] = {
+            "-": "solid",
+            "--": "dash",
+            "-.": "dashdot",
+            ":": "dot",
+        }.get(linestyle, linestyle)
+    return trace_kwargs
 
 
