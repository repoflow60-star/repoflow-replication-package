+    def _create_session(self):
+        options = {
+            'headers': self._request_headers(),
+            'retries': False
+        }
+        if self.url.lower().startswith('https://'):
+            options['cert_reqs'] = ssl.CERT_REQUIRED if self.verify else ssl.CERT_NONE
+            if isinstance(self.certs, tuple):
+                options['cert_file'] = self.certs[0]
+                options['key_file'] = self.certs[1]
+            elif self.certs:
+                options['cert_file'] = self.certs
+        return urllib3.PoolManager(**options)
+
+    def _request_headers(self):
+        return {key: value for key, value in self.headers.items() if value is not None}
+
+    def _request(self, method, endpoint, params=None, body=None, files=None):
+        request_url = self.url + endpoint
+        if params:
+            query = urlencode(params, doseq=True)
+            if query:
+                request_url += ('&' if '?' in request_url else '?') + query
+
+        request_kwargs = {'headers': self._request_headers()}
+        if files is not None:
+            request_kwargs['fields'] = files
+        elif body is not None:
+            request_kwargs['body'] = json.dumps(body)
+            request_kwargs['headers'].setdefault('Content-Type', 'application/json')
+
+        try:
+            return self.session.request(method, request_url, **request_kwargs)
+        except urllib3.exceptions.HTTPError as error:
+            raise ConnectionUnavailableError(error) from None
 
