+def _adapt_response(response: Response, method: str, url: str,
+        elapsed: float) -> Response:
+    """Expose the response attributes used by the public client API."""
+    if hasattr(response, 'status_code'):
+        return response
+
+    response.status_code = response.status
+    response.ok = response.status < 400
+    response.request = SimpleNamespace(method=method, url=url)
+    response.elapsed = timedelta(seconds=elapsed)
+    response.content = response.data
+    content_type = response.headers.get('content-type', '')
+    encoding = 'utf-8'
+    for parameter in content_type.split(';')[1:]:
+        if parameter.strip().lower().startswith('charset='):
+            encoding = parameter.split('=', 1)[1].strip()
+            break
+    body = response.data
+    if isinstance(body, bytes):
+        response.text = body.decode(encoding, errors='replace')
+    else:
+        response.text = str(body)
+    response.json = lambda: json.loads(response.text)
+    return response
+
+
+class _PoolManager(urllib3.PoolManager):
+    """Translate the session's request arguments for urllib3."""
+
+    def request(self, method, url, **kwargs):
+        params = kwargs.pop('params', None)
+        if params:
+            query = urlencode(params, doseq=True)
+            url += ('&' if '?' in url else '?') + query
+
+        body = kwargs.pop('json', None)
+        data = kwargs.pop('data', None)
+        headers = kwargs.get('headers')
+        if body is not None:
+            if headers is None:
+                headers = {}
+                kwargs['headers'] = headers
+            kwargs['body'] = json.dumps(body)
+            if not any(key.lower() == 'content-type' for key in headers):
+                headers['Content-Type'] = 'application/json'
+        elif data is not None:
+            kwargs['body'] = (
+                urlencode(data, doseq=True)
+                if isinstance(data, (dict, list, tuple)) else data
+            )
+
+        stream = kwargs.pop('stream', False)
+        kwargs['preload_content'] = not stream
+        kwargs['decode_content'] = True
+        kwargs['redirect'] = kwargs.pop('allow_redirects', True)
+        return super(_PoolManager, self).request(method, url, **kwargs)
