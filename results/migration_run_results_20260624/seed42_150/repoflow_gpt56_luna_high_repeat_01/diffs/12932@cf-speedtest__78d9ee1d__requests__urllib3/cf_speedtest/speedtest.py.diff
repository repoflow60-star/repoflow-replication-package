+def _create_http_session():
+    cert_reqs = 'CERT_REQUIRED' if VERIFY_SSL else 'CERT_NONE'
+    if PROXY_DICT:
+        proxy_url = PROXY_DICT.get('https') or PROXY_DICT.get('http')
+        if proxy_url.startswith('socks'):
+            from urllib3.contrib.socks import SOCKSProxyManager
+
+            return SOCKSProxyManager(proxy_url, cert_reqs=cert_reqs)
+        return urllib3.ProxyManager(proxy_url, cert_reqs=cert_reqs)
+    return urllib3.PoolManager(cert_reqs=cert_reqs)
+
+
+REQ_SESSION = _create_http_session()
+
+
+def _raise_for_status(response):
+    status = getattr(response, 'status', None)
+    if isinstance(status, int) and status >= 400:
+        raise urllib3.exceptions.HTTPError(
+            f'HTTP status {status}',
+        )
+
+
+def _request(method, url, **kwargs):
+    request_method = getattr(REQ_SESSION, method.lower(), None)
+    if callable(request_method):
+        return request_method(url, **kwargs)
+    return REQ_SESSION.request(method, url, **kwargs)
+
+
+def _response_text(response):
+    data = getattr(response, 'data', None)
+    if isinstance(data, (bytes, bytearray)):
+        return bytes(data).decode('utf-8')
+    return response.text
 
