+        addresses = socket.getaddrinfo(host, port, family, socket.SOCK_STREAM)
+        address_family, _, _, _, address = addresses[0]
+        endpoint_type = TCP6ClientEndpoint if address_family == socket.AF_INET6 else TCP4ClientEndpoint
+        return endpoint_type(reactor, address[0], port, timeout=timeout)
