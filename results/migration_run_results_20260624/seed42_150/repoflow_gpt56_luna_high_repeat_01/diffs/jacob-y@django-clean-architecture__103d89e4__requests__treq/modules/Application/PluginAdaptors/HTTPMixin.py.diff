+def _wait_for(operation):
+    if _reactor_thread is not None and current_thread() is _reactor_thread:
+        raise RuntimeError('Synchronous HTTP cannot run on the treq reactor thread')
+
+    _ensure_reactor()
+    completed = Event()
+    result = {}
+
+    def succeeded(value):
+        result['value'] = value
+        completed.set()
+        return value
+
+    def failed(failure):
+        result['error'] = failure.value
+        completed.set()
+        return failure
+
+    def start_operation():
+        try:
+            operation().addCallbacks(succeeded, failed)
+        except Exception as exception:
+            result['error'] = exception
+            completed.set()
+
+    reactor.callFromThread(start_operation)
+    completed.wait()
+
+    if 'error' in result:
