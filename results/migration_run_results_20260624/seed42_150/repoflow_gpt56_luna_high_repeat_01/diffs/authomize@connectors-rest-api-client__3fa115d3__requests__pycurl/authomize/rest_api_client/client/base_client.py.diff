+    def _request(self, method, url, params=None, body=None, headers=None):
+        if params:
+            query = []
+            for key, value in params.items():
+                if value is None:
+                    continue
+                values = value if isinstance(value, (list, tuple)) else [value]
+                for item in values:
+                    if item is not None:
+                        if isinstance(item, Enum):
+                            item = item.value
+                        query.append((key, item))
+            if query:
+                separator = '&' if '?' in url else '?'
+                url = f'{url}{separator}{urlencode(query)}'
+
+        response_body = io.BytesIO()
+        response_headers = io.BytesIO()
+        request_headers = {
+            **self.headers,
+            **(headers or {}),
+        }
+
+        self.session.reset()
+        self.session.setopt(pycurl.URL, url)
+        self.session.setopt(
+            pycurl.HTTPHEADER,
+            [f'{key}: {value}' for key, value in request_headers.items()],
+        )
+        self.session.setopt(pycurl.WRITEFUNCTION, response_body.write)
+        self.session.setopt(pycurl.HEADERFUNCTION, response_headers.write)
+        self.session.setopt(pycurl.FOLLOWLOCATION, 1)
+
+        if method == 'GET':
+            self.session.setopt(pycurl.HTTPGET, 1)
+        elif method == 'POST':
+            self.session.setopt(pycurl.POST, 1)
+        else:
+            self.session.setopt(pycurl.CUSTOMREQUEST, method)
+
+        if body is not None:
+            if isinstance(body, str):
+                body = body.encode('utf-8')
+            self.session.setopt(pycurl.POSTFIELDS, body)
+
+        self.session.perform()
+        status_code = self.session.getinfo(pycurl.RESPONSE_CODE)
+        response_url = self.session.getinfo(pycurl.EFFECTIVE_URL) or url
+        if isinstance(response_url, bytes):
+            response_url = response_url.decode('utf-8', errors='replace')
+
+        headers, reason = self._parse_response_headers(response_headers.getvalue())
+        return _CurlResponse(
+            status_code=status_code,
+            headers=headers,
+            content=response_body.getvalue(),
+            url=response_url,
+            reason=reason,
+        )
+
+    @staticmethod
+    def _parse_response_headers(raw_headers):
+        headers = {}
+        reason = ''
+        for raw_line in raw_headers.splitlines():
+            line = raw_line.decode('latin-1').strip()
+            if line.startswith('HTTP/'):
+                headers = {}
+                parts = line.split(' ', 2)
+                reason = parts[2] if len(parts) == 3 else ''
+            elif ':' in line:
+                key, value = line.split(':', 1)
+                headers[key.lower()] = value.strip()
+        return headers, reason
