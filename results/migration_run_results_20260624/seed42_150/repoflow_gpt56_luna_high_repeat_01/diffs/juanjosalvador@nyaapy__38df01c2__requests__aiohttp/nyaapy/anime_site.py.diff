-import requests
+import asyncio
+import threading
+
+import aiohttp
+
 from nyaapy import torrent
 from nyaapy.parser import parse_nyaa, parse_single, parse_nyaa_rss
+
+
+async def _fetch(url: str, *, text: bool = False):
+    async with aiohttp.ClientSession() as session:
+        async with session.get(url) as response:
+            response.raise_for_status()
+            if text:
+                return await response.text()
+            return await response.read()
+
+
+def _fetch_sync(url: str, *, text: bool = False):
+    request = _fetch(url, text=text)
+
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(request)
+
+    result = []
+    error = []
+
+    def run_request():
+        try:
+            result.append(asyncio.run(request))
+        except BaseException as exc:
+            error.append(exc)
+
+    thread = threading.Thread(target=run_request)
+    thread.start()
+    thread.join()
+
+    if error:
+        raise error[0]
+    return result[0]
 
 
