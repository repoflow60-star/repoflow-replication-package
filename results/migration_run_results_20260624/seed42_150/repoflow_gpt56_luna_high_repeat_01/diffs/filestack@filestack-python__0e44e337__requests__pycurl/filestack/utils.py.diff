+def _append_params(url, params):
+    if not params:
+        return url
+    query = urlencode(params, doseq=True)
+    separator = '&' if '?' in url else '?'
+    return '{}{}{}'.format(url, separator, query)
+
+
+def _header_lines(headers):
+    return ['{}: {}'.format(key, value) for key, value in headers.items()]
+
+
+def _parse_headers(raw_headers):
+    response_headers = HeaderMap()
+    for raw_line in raw_headers.splitlines():
+        line = raw_line.decode('latin-1')
+        if line.startswith('HTTP/'):
+            response_headers = HeaderMap()
+        elif ':' in line:
+            key, value = line.split(':', 1)
+            response_headers[key.strip()] = value.strip()
+    return response_headers
