+class _Request:
+    """Small request value passed to an explicitly mounted transport."""
+
+    def __init__(self, method, url, headers, body):
+        self.method = method
+        self.url = url
+        self.headers = headers
+        self.body = body
+        parsed = urlsplit(url)
+        self.path_url = parsed.path or "/"
+        if parsed.query:
+            self.path_url += "?" + parsed.query
+
+
+class _PycurlSession:
+    """Session-like request owner backed by one pycurl handle."""
+
+    def __init__(self, headers=None):
+        self.headers = dict(headers or {})
+        self._curl = pycurl.Curl()
+        self._mounts = {}
+
+    def mount(self, prefix, transport):
+        """Register a transport for URLs beginning with ``prefix``."""
+        self._mounts[prefix] = transport
+
+    def _transport_for(self, url):
+        matches = [prefix for prefix in self._mounts if url.startswith(prefix)]
+        if not matches:
+            return None
+        return self._mounts[max(matches, key=len)]
+
+    def request(self, method, url, params=None, data=None, headers=None):
+        if params:
+            separator = "&" if "?" in url else "?"
+            url = "{}{}{}".format(url, separator, urlencode(params, doseq=True))
+
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        transport = self._transport_for(url)
+        if transport is not None:
+            request = _Request(method, url, request_headers, data)
+            return transport.send(request)
+
+        response = io.BytesIO()
+        header_lines = [
+            "{}: {}".format(name, value)
+            for name, value in request_headers.items()
+        ]
+        self._curl.reset()
+        self._curl.setopt(pycurl.URL, url)
+        self._curl.setopt(pycurl.HTTPHEADER, header_lines)
+        self._curl.setopt(pycurl.WRITEFUNCTION, response.write)
+        if method == "GET":
+            self._curl.setopt(pycurl.HTTPGET, 1)
+        elif method == "POST":
+            self._curl.setopt(pycurl.POST, 1)
+            if data is not None:
+                if isinstance(data, str):
+                    data = data.encode("utf-8")
+                self._curl.setopt(pycurl.POSTFIELDS, data)
+        else:
+            self._curl.setopt(pycurl.CUSTOMREQUEST, method)
+        self._curl.perform()
+        return response.getvalue()
+
+    def get(self, url, params=None):
+        return self.request("GET", url, params=params)
+
+    def post(self, url, data=None, headers=None):
+        return self.request("POST", url, data=data, headers=headers)
+
+    def delete(self, url):
+        return self.request("DELETE", url)
+
