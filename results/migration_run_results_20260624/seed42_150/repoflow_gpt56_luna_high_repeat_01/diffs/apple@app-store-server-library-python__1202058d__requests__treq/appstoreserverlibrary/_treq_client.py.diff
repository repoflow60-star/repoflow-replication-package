--- a/appstoreserverlibrary/_treq_client.py
+++ b/appstoreserverlibrary/_treq_client.py
@@ -0,0 +1,116 @@
+import json as json_module
+import threading
+from concurrent.futures import Future
+from typing import Any, Dict, List, Optional, Union
+
+import treq
+from twisted.internet import reactor
+
+
+class TreqResponse:
+    """Synchronous response view backed by a completed treq response."""
+
+    def __init__(self, status_code: int, headers: Dict[str, str], content: bytes):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+
+    def json(self):
+        return json_module.loads(self.content.decode("utf-8"))
+
+
+_reactor_lock = threading.Lock()
+_reactor_thread = None
+
+
+def _ensure_reactor():
+    global _reactor_thread
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is None or not _reactor_thread.is_alive():
+            _reactor_thread = threading.Thread(
+                target=reactor.run,
+                kwargs={"installSignalHandlers": False},
+                daemon=True,
+            )
+            _reactor_thread.start()
+
+
+def _decode_header(value: Any) -> str:
+    if isinstance(value, bytes):
+        return value.decode("latin-1")
+    return str(value)
+
+
+def _get_headers(headers) -> Dict[str, str]:
+    result = {}
+    for name, values in headers.getAllRawHeaders():
+        if values:
+            result[_decode_header(name).lower()] = _decode_header(values[0])
+    return result
+
+
+def _request_on_reactor(
+    method: str,
+    url: str,
+    params: Dict[str, Union[str, List[str]]],
+    headers: Dict[str, str],
+    data: Optional[bytes],
+):
+    response_deferred = treq.request(
+        method,
+        url,
+        params=params,
+        headers=headers,
+        data=data,
+        reactor=reactor,
+    )
+
+    def read_body(response):
+        body_deferred = treq.content(response)
+
+        def make_response(body):
+            return TreqResponse(response.code, _get_headers(response.headers), body)
+
+        body_deferred.addCallback(make_response)
+        return body_deferred
+
+    response_deferred.addCallback(read_body)
+    return response_deferred
+
+
+def request_sync(
+    method: str,
+    url: str,
+    params: Optional[Dict[str, Union[str, List[str]]]] = None,
+    headers: Optional[Dict[str, str]] = None,
+    json: Optional[Dict[str, Any]] = None,
+    data: Optional[bytes] = None,
+) -> TreqResponse:
+    request_headers = dict(headers or {})
+    request_params = params or {}
+    request_data = data
+    if json is not None:
+        request_data = json_module.dumps(json).encode("utf-8")
+        if not any(name.lower() == "content-type" for name in request_headers):
+            request_headers["Content-Type"] = "application/json"
+
+    _ensure_reactor()
+    result = Future()
+
+    def perform_request():
+        try:
+            deferred = _request_on_reactor(
+                method,
+                url,
+                request_params,
+                request_headers,
+                request_data,
+            )
+            deferred.addCallbacks(result.set_result, result.set_exception)
+        except Exception as error:
+            result.set_exception(error)
+
+    reactor.callFromThread(perform_request)
+    return result.result()
