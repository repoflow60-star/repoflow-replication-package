+class _HttpResult(object):
+    """Materialized response data for the library's synchronous API."""
+
+    def __init__(self, status, headers, reason, content):
+        self.status_code = status
+        self.headers = headers
+        self.reason = reason
+        self._content = content
+        self.text = content.decode('utf-8', errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+
+async def _post_async(url, data, headers, timeout, proxy=None):
+    request_options = {
+        'data': data,
+        'headers': headers,
+    }
+    if timeout is not None:
+        request_options['timeout'] = aiohttp.ClientTimeout(total=timeout)
+    if proxy:
+        request_options['proxy'] = proxy
+
+    async with aiohttp.ClientSession() as session:
+        async with session.post(url, **request_options) as response:
+            content = await response.read()
+            return _HttpResult(
+                response.status,
+                dict(response.headers),
+                response.reason,
+                content,
+            )
+
+
+def _run_async(coroutine):
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coroutine)
+
+    # Keep the public API synchronous when called from an active event loop.
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        return executor.submit(asyncio.run, coroutine).result()
+
+
+def _proxy_url(proxies):
+    if not proxies:
+        return None
+    if isinstance(proxies, str):
+        proxy = proxies
+    else:
+        proxy = proxies.get('https') or proxies.get('http')
+    if proxy and '://' not in proxy:
+        proxy = 'http://' + proxy
+    return proxy
+
+
+class _AiohttpSession(object):
+    """Synchronous adapter around aiohttp's asynchronous request API."""
+
+    def post(self, url, data=None, headers=None, timeout=None, proxies=None):
+        return _run_async(
+            _post_async(
+                url,
+                data,
+                headers,
+                timeout,
+                proxy=_proxy_url(proxies),
+            )
+        )
+
+
+_session = _AiohttpSession()
 
 
