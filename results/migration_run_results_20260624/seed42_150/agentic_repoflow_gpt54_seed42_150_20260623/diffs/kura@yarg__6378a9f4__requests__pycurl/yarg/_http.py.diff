--- a/yarg/_http.py
+++ b/yarg/_http.py
@@ -0,0 +1,35 @@
+from io import BytesIO
+
+import pycurl
+
+
+def _reason_from_headers(headers):
+    for line in reversed(headers):
+        if hasattr(line, 'decode'):
+            line = line.decode('iso-8859-1')
+        line = line.strip()
+        if line.startswith('HTTP/'):
+            parts = line.split(' ', 2)
+            if len(parts) == 3:
+                return parts[2]
+            if len(parts) == 2:
+                return ''
+    return ''
+
+
+def get(url):
+    content = BytesIO()
+    headers = []
+    curl = pycurl.Curl()
+
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.WRITEDATA, content)
+        curl.setopt(pycurl.HEADERFUNCTION, headers.append)
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+
+    return status_code, _reason_from_headers(headers), content.getvalue()
