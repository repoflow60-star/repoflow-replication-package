+class _HTTPResponse(object):
+
+    def __init__(self, response, url):
+        self._response = response
+        self.url = url
+        self.headers = response.headers
+        self.status_code = response.status
+        self.content = response.data
+        self.raw = response
+
+    @property
+    def is_redirect(self):
+        return self.status_code in _HTTP_REDIRECT_STATUSES and self.headers.get('Location') is not None
+
+    def iter_content(self, chunk_size):
+        content = self.content or b''
+        for index in range(0, len(content), chunk_size):
+            yield content[index:index+chunk_size]
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            message = 'HTTP error {}'.format(self.status_code)
+            if self.url:
+                message += ' for {}'.format(self.url)
+            raise HXLIOException(message, url=self.url)
+
+    def json(self):
+        try:
+            return json.loads(self.content)
+        except Exception as e:
+            raise HXLIOException('Cannot parse JSON response: {}'.format(str(e)), url=self.url)
+
+    def close(self):
+        return self._response.close()
+
+
+def _get_http_pool(verify_ssl=True):
+    pool = _HTTP_POOLS.get(verify_ssl)
+    if pool is None:
+        pool_kwargs = {
+            'cert_reqs': ssl.CERT_REQUIRED if verify_ssl else ssl.CERT_NONE,
+        }
+        if not verify_ssl:
+            pool_kwargs['assert_hostname'] = False
+        pool = urllib3.PoolManager(**pool_kwargs)
+        _HTTP_POOLS[verify_ssl] = pool
+    return pool
+
+
+def _append_url_params(url, params):
+    if not params:
+        return url
+    query = urllib.parse.urlencode(params, doseq=True)
+    if not query:
+        return url
+    separator = '&' if urllib.parse.urlparse(url).query else '?'
+    return '{}{}{}'.format(url, separator, query)
+
+
+def _http_request(method, url, verify_ssl=True, timeout=None, headers=None, params=None, data=None, stream=False, allow_redirects=None):
+    method = method.upper()
+    if allow_redirects is None:
+        allow_redirects = (method != 'HEAD')
+
+    request_headers = dict(headers or {})
+    request_url = _append_url_params(url, params)
+    request_timeout = urllib3.Timeout(connect=timeout, read=timeout) if timeout is not None else None
+
+    if data is None:
+        body = None
+    elif isinstance(data, (bytes, bytearray)):
+        body = data
+    elif isinstance(data, str):
+        body = data.encode('utf-8')
+    else:
+        if not any(key.lower() == 'content-type' for key in request_headers):
+            request_headers['Content-Type'] = 'application/x-www-form-urlencoded'
+        body = urllib.parse.urlencode(data, doseq=True).encode('utf-8')
+
+    response_method = method
+    redirect_count = 0
+    while True:
+        try:
+            response = _get_http_pool(verify_ssl).request(
+                response_method,
+                request_url,
+                headers=request_headers or None,
+                body=body,
+                redirect=False,
+                retries=False,
+                timeout=request_timeout,
+                preload_content=True,
+                decode_content=True,
+            )
+        except urllib3.exceptions.HTTPError as e:
+            raise HXLIOException(str(e), url=request_url)
+
+        wrapped_response = _HTTPResponse(response, request_url)
+        if not allow_redirects or not wrapped_response.is_redirect:
+            return wrapped_response
+
+        if redirect_count >= _HTTP_REDIRECT_LIMIT:
+            response.close()
+            raise HXLIOException('Too many redirects', url=request_url)
+
+        request_url = urllib.parse.urljoin(request_url, wrapped_response.headers['Location'])
+        redirect_count += 1
+        response.close()
+
+        if wrapped_response.status_code == 303 or (
+            wrapped_response.status_code in (301, 302) and response_method not in ('GET', 'HEAD')
+        ):
+            response_method = 'GET'
+            body = None
+            request_headers.pop('Content-Type', None)
+
+
