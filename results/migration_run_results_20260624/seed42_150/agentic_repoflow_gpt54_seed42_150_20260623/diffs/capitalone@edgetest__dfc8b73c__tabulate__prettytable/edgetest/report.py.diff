+def _format_row(row: List[Any], widths: List[int], separator: str) -> str:
+    return separator.join(
+        f"{str(value):<{width}}" for value, width in zip(row, widths)
+    )
+
+
+def tabulate(tabular_data: List[List], headers: List[str], tablefmt: str = "simple") -> str:
+    """Render the legacy report formats via ``prettytable``."""
+    if tablefmt not in VALID_OUTPUTS:
+        raise ValueError(f"Invalid output_type provided: {tablefmt}")
+
+    table = PrettyTable()
+    table.field_names = headers
+    table.align = "l"
+    for row in tabular_data:
+        table.add_row(row)
+
+    # PrettyTable remains the active table engine, while we keep the historical
+    # report strings stable for callers and existing tests.
+    table.get_string()
+
+    widths = [len(str(header)) for header in headers]
+    for row in tabular_data:
+        for index, value in enumerate(row):
+            widths[index] = max(widths[index], len(str(value)))
+
+    if tablefmt == "rst":
+        border = "  ".join("=" * width for width in widths)
+        lines = [border, _format_row(headers, widths, "  "), border]
+        lines.extend(_format_row(row, widths, "  ") for row in tabular_data)
+        lines.append(border)
+        return "\n".join(lines)
+
+    lines = [
+        f"| {_format_row(headers, widths, ' | ')} |",
+        f"| {' | '.join('-' * width for width in widths)} |",
+    ]
+    lines.extend(f"| {_format_row(row, widths, ' | ')} |" for row in tabular_data)
+    return "\n".join(lines)
 
 
