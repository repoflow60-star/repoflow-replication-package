+class _ResponseWrapper:
+    def __init__(self, response):
+        self._response = response
+        self.content = response.data
+        self.headers = response.headers
+
+    @property
+    def text(self) -> str:
+        return self.content.decode('utf-8', errors='replace')
+
+    def raise_for_status(self) -> None:
+        if hasattr(self._response, 'raise_for_status'):
+            self._response.raise_for_status()
+            return
+
+        if self._response.status >= 400:
+            response_url = self._response.geturl() if hasattr(self._response, 'geturl') else 'request'
+            raise urllib3.exceptions.HTTPError(
+                f'HTTP {self._response.status} for {response_url}',
+            )
+
+
+class _UrlLib3Session:
+    def __init__(self):
+        self._managers = {}
+
+    def _get_manager(self, verify: bool, proxies: dict | None):
+        proxy_url = None if not proxies else (proxies.get('https') or proxies.get('http'))
+        manager_key = (verify, proxy_url)
+        if manager_key not in self._managers:
+            cert_reqs = 'CERT_REQUIRED' if verify else 'CERT_NONE'
+            if proxy_url:
+                if proxy_url.startswith('socks'):
+                    from urllib3.contrib.socks import SOCKSProxyManager
+
+                    manager = SOCKSProxyManager(proxy_url, cert_reqs=cert_reqs)
+                else:
+                    manager = urllib3.ProxyManager(proxy_url, cert_reqs=cert_reqs)
+            else:
+                manager = urllib3.PoolManager(cert_reqs=cert_reqs)
+            self._managers[manager_key] = manager
+
+        return self._managers[manager_key]
+
+    def request(self, method: str, url: str, **kwargs) -> _ResponseWrapper:
+        manager = self._get_manager(kwargs.get('verify', True), kwargs.get('proxies'))
+        response = manager.request(
+            method,
+            url,
+            body=kwargs.get('data'),
+            headers=kwargs.get('headers'),
+        )
+        return _ResponseWrapper(response)
+
+    def get(self, url: str, **kwargs) -> _ResponseWrapper:
+        return self.request('GET', url, **kwargs)
+
+    def post(self, url: str, **kwargs) -> _ResponseWrapper:
+        return self.request('POST', url, **kwargs)
+
+
+REQ_SESSION = _UrlLib3Session()
 
