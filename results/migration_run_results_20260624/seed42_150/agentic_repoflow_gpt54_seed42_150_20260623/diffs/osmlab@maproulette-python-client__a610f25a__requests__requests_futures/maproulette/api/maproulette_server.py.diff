+
+    @staticmethod
+    def _format_response(response):
+        try:
+            return {
+                "data": response.json(),
+                "status": response.status_code
+            }
+        except ValueError:
+            return {
+                "data": response.text,
+                "status": response.status_code
+            }
+
+    @staticmethod
+    def _raise_for_status(response, error_map=None):
+        if response.ok:
+            return
+
+        status_code = response.status_code
+        error_class = HttpError if error_map is None else error_map.get(status_code, HttpError)
+        raise error_class(
+            message=MapRouletteServer.parse_response_message(response),
+            status=status_code
+        ) from None
+
+    def _resolve_response(self, response_or_future):
+        if not isinstance(response_or_future, Future):
+            return response_or_future
+
+        try:
+            return response_or_future.result()
+        except Exception as error:
+            response = getattr(error, 'response', None)
+            raise ConnectionUnavailableError(
+                message=self.parse_response_message(response) if response is not None else None,
+                status=getattr(response, 'status_code', None)
+            ) from None
