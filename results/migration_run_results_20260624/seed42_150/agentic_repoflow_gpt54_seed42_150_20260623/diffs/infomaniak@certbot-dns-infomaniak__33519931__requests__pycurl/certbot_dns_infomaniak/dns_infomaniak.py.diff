+class _SessionCompat:
+
+    def __init__(self, headers=None):
+        self.headers = headers or {}
+        self._adapters = {}
+
+    def mount(self, prefix, adapter):
+        self._adapters[prefix] = adapter
+
+    def get_adapter(self, url):
+        adapter = None
+        best_prefix_length = -1
+        for prefix, mounted_adapter in self._adapters.items():
+            if url.startswith(prefix) and len(prefix) > best_prefix_length:
+                adapter = mounted_adapter
+                best_prefix_length = len(prefix)
+            scheme_prefix = prefix + "://"
+            if url.startswith(scheme_prefix) and len(scheme_prefix) > best_prefix_length:
+                adapter = mounted_adapter
+                best_prefix_length = len(scheme_prefix)
+        return adapter
+
+
+class _AdapterRequest:
+
+    def __init__(self, method, url, headers, body=None):
+        parsed_url = parse.urlparse(url)
+        self.method = method
+        self.url = url
+        self.headers = headers
+        self.body = body
+        self.scheme = parsed_url.scheme
+        self.netloc = parsed_url.netloc
+        self.hostname = parsed_url.hostname
+        self.port = parsed_url.port
+        self.path = parsed_url.path
+        self.query = parsed_url.query
+        self.path_url = parsed_url.path or "/"
+        if parsed_url.query:
+            self.path_url = self.path_url + "?" + parsed_url.query
+
+
+class _ResponseWrapper:
+
+    def __init__(self, response=None, body=None):
+        self._response = response
+        self._body = body
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        if self._response is not None and hasattr(self._response, "close"):
+            self._response.close()
+        return False
+
+    def json(self):
+        if self._response is not None:
+            return self._response.json()
+        return json.loads(self._body.decode("utf-8"))
 
 
