+def _split_tdes_key(key: bytes) -> _typing.Tuple[bytes, bytes, bytes]:
+    if len(key) == 8:
+        return key, key, key
+
+    if len(key) == 16:
+        return key[:8], key[8:], key[:8]
+
+    if len(key) == 24:
+        return key[:8], key[8:16], key[16:]
+
+    raise ValueError("Key must be a single, double or triple DES key")
+
+
+def _encrypt_des_block(key: bytes, block: bytes) -> bytes:
+    return _DES.new(key, _DES.MODE_ECB).encrypt(block)
+
+
+def _decrypt_des_block(key: bytes, block: bytes) -> bytes:
+    return _DES.new(key, _DES.MODE_ECB).decrypt(block)
+
+
+def _encrypt_tdes_block(key: bytes, block: bytes) -> bytes:
+    key1, key2, key3 = _split_tdes_key(key)
+    return _encrypt_des_block(
+        key3, _decrypt_des_block(key2, _encrypt_des_block(key1, block))
+    )
+
+
+def _decrypt_tdes_block(key: bytes, block: bytes) -> bytes:
+    key1, key2, key3 = _split_tdes_key(key)
+    return _decrypt_des_block(
+        key1, _encrypt_des_block(key2, _decrypt_des_block(key3, block))
+    )
+
+
+def _encrypt_tdes_cbc_blocks(key: bytes, iv: bytes, data: bytes) -> bytes:
+    blocks = []
+    previous = iv
+
+    for offset in range(0, len(data), 8):
+        previous = _encrypt_tdes_block(key, _tools.xor(data[offset : offset + 8], previous))
+        blocks.append(previous)
+
+    return b"".join(blocks)
+
+
+def _decrypt_tdes_cbc_blocks(key: bytes, iv: bytes, data: bytes) -> bytes:
+    blocks = []
+    previous = iv
+
+    for offset in range(0, len(data), 8):
+        block = data[offset : offset + 8]
+        blocks.append(_tools.xor(_decrypt_tdes_block(key, block), previous))
+        previous = block
+
+    return b"".join(blocks)
+
