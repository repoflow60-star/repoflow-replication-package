+from typing import Any, Optional, Tuple, Union
+
+from environs import Env
+
+
+def load_env_file(env_file_path: Optional[str]) -> bool:
+    """
+    Loads the given environment file into the current process environment.
+    """
+
+    if not env_file_path or not os.path.isfile(env_file_path):
+        return False
+
+    Env().read_env(env_file_path, override=False)
+
+    return True
+
+
+def _split_env_line(line: str) -> Tuple[Optional[str], Optional[str]]:
+    """
+    Extracts the environment variable name and value from the given line.
+    """
+
+    stripped = line.strip()
+
+    if not stripped or stripped.startswith("#") or "=" not in stripped:
+        return None, None
+
+    name, value = stripped.split("=", 1)
+    name = name.strip()
+
+    if name.startswith("export "):
+        name = name[len("export ") :].strip()
+
+    value = value.strip()
+
+    if len(value) >= 2 and value[0] == value[-1] and value[0] in ('"', "'"):
+        quote = value[0]
+        value = value[1:-1]
+
+        if quote == '"':
+            value = value.replace('\\"', '"').replace("\\\\", "\\")
+
+    return name, value
+
+
+def _quote_env_value(value: str) -> str:
+    """
+    Serializes the given value using the same quoted style as before.
+    """
+
+    escaped = value.replace("\\", "\\\\").replace('"', '\\"')
+
+    return f'"{escaped}"'
 
 
