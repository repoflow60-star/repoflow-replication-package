+def schema_json() -> str:
+    # Pydantic unions produce `anyOf`, but the generated JSON Schema expects
+    # `oneOf` semantics for the downstream consumers in this repository.
+    generated = DvcYamlModel.schema_json(indent=2).replace('"anyOf"', '"oneOf"')
+    document = json.loads(generated)
+    validator = Validator(GENERATED_SCHEMA_RULES, allow_unknown=True)
+    if not validator.validate(document):
+        raise ValueError(
+            "generated schema.json failed cerberus validation: "
+            f"{validator.errors}"
+        )
+    return generated
+
