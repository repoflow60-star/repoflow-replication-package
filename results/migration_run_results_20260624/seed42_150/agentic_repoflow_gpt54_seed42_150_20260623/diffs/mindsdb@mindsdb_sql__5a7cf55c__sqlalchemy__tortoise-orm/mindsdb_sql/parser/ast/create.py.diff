+def _render_column_type(value):
+    if isinstance(value, str):
+        return value
+
+    candidates = [
+        getattr(value, '__name__', None),
+        getattr(getattr(value, '__class__', None), '__name__', None),
+    ]
+
+    for candidate in candidates:
+        if candidate is None:
+            continue
+
+        candidate_upper = candidate.upper()
+        if 'INT' in candidate_upper:
+            return 'int'
+        if 'FLOAT' in candidate_upper or 'DOUBLE' in candidate_upper or 'REAL' in candidate_upper:
+            return 'float'
+        if 'TEXT' in candidate_upper or 'CHAR' in candidate_upper or 'STRING' in candidate_upper:
+            return 'text'
+        return candidate
+
+    return str(value)
 
 
