+from twisted.web.client import Agent, ResponseNeverReceived
+from twisted.web.iweb import IPolicyForHTTPS
+from zope.interface import implementer
 
 from . import connection, exceptions, helper
 
 _LOGGING = logging.getLogger(__name__)
+_REACTOR_THREAD: Optional[threading.Thread] = None
+_REACTOR_LOCK = threading.Lock()
+
+
+@implementer(IPolicyForHTTPS)
+class _NoVerifyHttpsPolicy:
+    def creatorForNetloc(self, hostname: bytes, port: int) -> ssl.CertificateOptions:
+        return ssl.CertificateOptions(verify=False)
+
+
+def _get_reactor() -> Any:
+    from twisted.internet import reactor
+
+    return reactor
+
+
+def _ensure_reactor_thread() -> None:
+    global _REACTOR_THREAD
+
+    with _REACTOR_LOCK:
+        if _REACTOR_THREAD is not None and _REACTOR_THREAD.is_alive():
+            return
+
+        started = threading.Event()
+        reactor = _get_reactor()
+
+        def _run_reactor() -> None:
+            reactor.callWhenRunning(started.set)
+            reactor.run(installSignalHandlers=False)
+
+        _REACTOR_THREAD = threading.Thread(target=_run_reactor, daemon=True)
+        _REACTOR_THREAD.start()
+        started.wait()
+
+
+@defer.inlineCallbacks
+def _treq_request(method: str, url: str, timeout: Optional[float]) -> Any:
+    reactor = _get_reactor()
+    request_kwargs: Dict[str, Any] = {"persistent": False}
+    if timeout is not None:
+        request_kwargs["timeout"] = timeout
+    if url.startswith("https://"):
+        request_kwargs["agent"] = Agent(
+            reactor, contextFactory=_NoVerifyHttpsPolicy()
+        )
+
+    if method == "POST":
+        response = yield treq.post(url, **request_kwargs)
+    elif method == "PUT":
+        response = yield treq.put(url, **request_kwargs)
+    elif method == "DELETE":
+        response = yield treq.delete(url, **request_kwargs)
+    else:
+        response = yield treq.get(url, **request_kwargs)
+
+    return (yield treq.text_content(response))
+
+
+def _blocking_treq_request(method: str, url: str, timeout: Optional[float]) -> str:
+    reactor = _get_reactor()
+    _ensure_reactor_thread()
+    return str(
+        threads.blockingCallFromThread(reactor, _treq_request, method, url, timeout)
+    )
 
 
