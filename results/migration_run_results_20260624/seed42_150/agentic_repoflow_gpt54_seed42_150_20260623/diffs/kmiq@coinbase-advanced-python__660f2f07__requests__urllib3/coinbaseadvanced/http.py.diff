--- a/coinbaseadvanced/http.py
+++ b/coinbaseadvanced/http.py
@@ -0,0 +1,85 @@
+"""
+HTTP utilities built on top of urllib3.
+"""
+
+import json as jsonlib
+from typing import Optional
+
+import urllib3
+
+
+class HTTPResponse:
+    """
+    Small compatibility wrapper for model parsing code.
+    """
+
+    def __init__(self, response) -> None:
+        self._response = response
+        self.status_code = response.status
+        self.headers = response.headers
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status_code < 400
+
+    @property
+    def text(self) -> str:
+        return self._response.data.decode("utf-8", errors="replace")
+
+    def json(self):
+        return jsonlib.loads(self.text)
+
+
+class _Urllib3RequestsAdapter:
+    def __init__(self) -> None:
+        self._http = urllib3.PoolManager()
+
+    def request(self,
+                method: str,
+                url: str,
+                headers: Optional[dict] = None,
+                timeout: Optional[int] = None,
+                json: Optional[dict] = None) -> HTTPResponse:
+        request_headers = dict(headers or {})
+        body = None
+
+        if json is not None:
+            request_headers.setdefault("Content-Type", "application/json")
+            body = jsonlib.dumps(json).encode("utf-8")
+
+        response = self._http.request(
+            method,
+            url,
+            body=body,
+            headers=request_headers,
+            timeout=timeout,
+            retries=False,
+        )
+        return HTTPResponse(response)
+
+    def get(self, url: str, headers: Optional[dict] = None, timeout: Optional[int] = None) -> HTTPResponse:
+        return self.request("GET", url, headers=headers, timeout=timeout)
+
+    def post(self,
+             url: str,
+             json: Optional[dict] = None,
+             headers: Optional[dict] = None,
+             timeout: Optional[int] = None) -> HTTPResponse:
+        return self.request("POST", url, headers=headers, timeout=timeout, json=json)
+
+    def put(self,
+            url: str,
+            json: Optional[dict] = None,
+            headers: Optional[dict] = None,
+            timeout: Optional[int] = None) -> HTTPResponse:
+        return self.request("PUT", url, headers=headers, timeout=timeout, json=json)
+
+    def delete(self,
+               url: str,
+               json: Optional[dict] = None,
+               headers: Optional[dict] = None,
+               timeout: Optional[int] = None) -> HTTPResponse:
+        return self.request("DELETE", url, headers=headers, timeout=timeout, json=json)
+
+
+requests = _Urllib3RequestsAdapter()
