--- a/ldnlib/_http.py
+++ b/ldnlib/_http.py
@@ -0,0 +1,174 @@
+import io
+import json
+
+import pycurl
+
+
+class HTTPError(Exception):
+
+    def __init__(self, status_code):
+        super(HTTPError, self).__init__("HTTP {}".format(status_code))
+        self.status_code = status_code
+
+
+class Response(object):
+
+    def __init__(self, status_code, headers, content):
+        self.status_code = status_code
+        self.headers = headers
+        self._content = content
+        self.links = _parse_link_header(headers.get('link'))
+
+    @property
+    def text(self):
+        return self._content.decode(_get_encoding(self.headers), errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise HTTPError(self.status_code)
+
+
+def _get_encoding(headers):
+    content_type = headers.get('content-type', '')
+    for value in content_type.split(';')[1:]:
+        key, _, encoding = value.partition('=')
+        if key.strip().lower() == 'charset' and encoding:
+            return encoding.strip().strip('"')
+    return 'utf-8'
+
+
+def _split_header_values(value):
+    parts = []
+    current = []
+    quoted = False
+
+    for char in value:
+        if char == '"':
+            quoted = not quoted
+        if char == ',' and not quoted:
+            parts.append(''.join(current).strip())
+            current = []
+        else:
+            current.append(char)
+
+    if current:
+        parts.append(''.join(current).strip())
+
+    return [part for part in parts if part]
+
+
+def _parse_link_header(value):
+    links = {}
+    if not value:
+        return links
+
+    for item in _split_header_values(value):
+        segments = [segment.strip() for segment in item.split(';') if segment.strip()]
+        if not segments or not segments[0].startswith('<') or not segments[0].endswith('>'):
+            continue
+
+        link = {'url': segments[0][1:-1]}
+        rels = None
+        for segment in segments[1:]:
+            key, _, raw_value = segment.partition('=')
+            if not _:
+                continue
+            parsed_value = raw_value.strip().strip('"')
+            key = key.strip().lower()
+            link[key] = parsed_value
+            if key == 'rel':
+                rels = parsed_value.split()
+
+        if rels:
+            for rel in rels:
+                links[rel] = link
+        else:
+            links[link['url']] = link
+
+    return links
+
+
+def _coerce_body(data):
+    if data is None:
+        return b''
+    if isinstance(data, bytes):
+        return data
+    return str(data).encode('utf-8')
+
+
+def _request(method, url, headers=None, data=None, allow_redirects=True,
+             timeout=None, **kwargs):
+    response_headers = {}
+    response_body = io.BytesIO()
+    payload = _coerce_body(data)
+    curl = pycurl.Curl()
+
+    def handle_header(line):
+        header = line.decode('iso-8859-1')
+        if header.startswith('HTTP/'):
+            response_headers.clear()
+            return len(line)
+
+        name, _, value = header.partition(':')
+        if _:
+            key = name.strip().lower()
+            parsed_value = value.strip()
+            if key in response_headers:
+                response_headers[key] = '{}, {}'.format(response_headers[key], parsed_value)
+            else:
+                response_headers[key] = parsed_value
+        return len(line)
+
+    curl.setopt(pycurl.URL, url)
+    curl.setopt(pycurl.FOLLOWLOCATION, 1 if allow_redirects else 0)
+    curl.setopt(pycurl.NOSIGNAL, 1)
+    curl.setopt(pycurl.HEADERFUNCTION, handle_header)
+    curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+
+    if headers:
+        curl.setopt(
+            pycurl.HTTPHEADER,
+            ['{}: {}'.format(key, value) for key, value in headers.items()]
+        )
+
+    if timeout is not None:
+        curl.setopt(pycurl.TIMEOUT_MS, int(float(timeout) * 1000))
+
+    if method == 'GET':
+        curl.setopt(pycurl.HTTPGET, 1)
+    elif method == 'HEAD':
+        curl.setopt(pycurl.NOBODY, 1)
+        curl.setopt(pycurl.CUSTOMREQUEST, 'HEAD')
+    elif method == 'POST':
+        curl.setopt(pycurl.POST, 1)
+        curl.setopt(pycurl.POSTFIELDSIZE, len(payload))
+        curl.setopt(pycurl.COPYPOSTFIELDS, payload)
+    else:
+        curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+    try:
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+
+    return Response(status_code, response_headers, response_body.getvalue())
+
+
+def get(url, **kwargs):
+    return _request('GET', url, **kwargs)
+
+
+def head(url, **kwargs):
+    return _request('HEAD', url, **kwargs)
+
+
+def options(url, **kwargs):
+    return _request('OPTIONS', url, **kwargs)
+
+
+def post(url, **kwargs):
+    return _request('POST', url, **kwargs)
