+def get(url: str, headers: Optional[dict] = None, pkcs12_data: bytes = None,
+        pkcs12_password: str = '') -> HttpResponse:
+    _ensure_reactor()
+    return blockingCallFromThread(reactor, _request, 'GET', url, headers=headers, pkcs12_data=pkcs12_data,
+                                  pkcs12_password=pkcs12_password)
+
