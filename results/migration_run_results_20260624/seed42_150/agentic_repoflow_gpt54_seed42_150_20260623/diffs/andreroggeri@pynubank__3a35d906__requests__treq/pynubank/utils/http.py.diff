+_reactor_lock = threading.Lock()
+_reactor_ready = threading.Event()
+_reactor_thread = None
+
+
+def _start_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _reactor_thread
+
+    if reactor.running:
+        _reactor_ready.set()
+        return
+
+    with _reactor_lock:
+        if reactor.running:
+            _reactor_ready.set()
+            return
+
+        if _reactor_thread is None:
+            _reactor_thread = threading.Thread(target=_start_reactor, daemon=True)
+            _reactor_thread.start()
+
+    _reactor_ready.wait()
+
+
+def _build_headers(headers: Optional[dict] = None) -> Headers:
+    normalized = {}
+
+    for name, value in (headers or {}).items():
+        header_name = name.encode() if isinstance(name, str) else name
+
+        if isinstance(value, (list, tuple)):
+            header_values = [item.encode() if isinstance(item, str) else item for item in value]
+        else:
+            header_values = [value.encode() if isinstance(value, str) else value]
+
+        normalized[header_name] = header_values
+
+    return Headers(normalized)
+
