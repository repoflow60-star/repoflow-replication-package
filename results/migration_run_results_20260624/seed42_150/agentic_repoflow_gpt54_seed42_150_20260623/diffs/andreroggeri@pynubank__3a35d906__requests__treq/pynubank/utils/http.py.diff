+@defer.inlineCallbacks
+def _request(method: str, url: str, headers: Optional[dict] = None, payload: Optional[dict] = None,
+             pkcs12_data: bytes = None, pkcs12_password: str = ''):
+    kwargs = {'headers': _build_headers(headers)}
+
+    if payload is not None:
+        kwargs['data'] = json_module.dumps(payload).encode()
