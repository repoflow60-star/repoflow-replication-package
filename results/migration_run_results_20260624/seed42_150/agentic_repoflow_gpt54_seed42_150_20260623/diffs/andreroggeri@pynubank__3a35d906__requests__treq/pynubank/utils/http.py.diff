+class ResponseHeaders(dict):
+    def __init__(self, headers=None):
+        normalized = {}
+
+        if hasattr(headers, 'items'):
+            headers = headers.items()
+
+        for name, values in headers or []:
+            if not values:
+                continue
+
+            key = name.decode() if isinstance(name, bytes) else name
+            value = values[0] if isinstance(values, (list, tuple)) else values
+
+            if isinstance(value, bytes):
+                value = value.decode()
+
+            normalized[key.lower()] = value
+
+        super().__init__(normalized)
+
+    def get(self, name, default=None):
+        return super().get(name.lower(), default)
+
+
+class HttpResponse:
+    def __init__(self, url: str, status_code: int, headers: Optional[ResponseHeaders] = None, content: bytes = b''):
+        self.url = url
+        self.status_code = status_code
+        self.headers = headers or ResponseHeaders()
+        self._content = content
+
+    @property
+    def content(self) -> bytes:
+        return self._content
+
+    def json(self):
+        return json_module.loads(self._content.decode())
+
+
+def _load_private_certificate(pkcs12_data: bytes, pkcs12_password: str):
+    passwords = [pkcs12_password.encode()] if pkcs12_password else [b'', None]
+    last_error = None
+
+    for password in passwords:
+        try:
+            private_key, certificate, extra_certificates = pkcs12.load_key_and_certificates(pkcs12_data, password)
+            break
+        except ValueError as exc:
+            last_error = exc
+    else:
+        raise last_error
+
+    if private_key is None or certificate is None:
+        raise ValueError('Invalid PKCS12 certificate data')
+
+    pem_parts = [
+        private_key.private_bytes(Encoding.PEM, PrivateFormat.TraditionalOpenSSL, NoEncryption()),
+        certificate.public_bytes(Encoding.PEM),
+    ]
+
+    for extra_certificate in extra_certificates or []:
+        pem_parts.append(extra_certificate.public_bytes(Encoding.PEM))
+
+    return ssl.PrivateCertificate.loadPEM(b''.join(pem_parts))
+
+
+class _ClientCertificatePolicy:
+    def __init__(self, pkcs12_data: bytes, password: str):
+        self._private_certificate = _load_private_certificate(pkcs12_data, password)
+
+    def creatorForNetloc(self, hostname, port):
+        server_name = hostname.decode() if isinstance(hostname, bytes) else hostname
+        return ssl.optionsForClientTLS(server_name, clientCertificate=self._private_certificate)
+
