+class _ClientSession(object):
+    def __init__(self, auth=None, headers=None):
+        self._client = httpx.Client()
+        self.auth = auth
+        self.headers = dict(headers or {})
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+        return self._client.request(method, url, data=data, timeout=timeout, headers=request_headers, auth=self.auth)
+
+
+def _response_reason(res):
+    return getattr(res, 'reason', getattr(res, 'reason_phrase', ''))
 
 
