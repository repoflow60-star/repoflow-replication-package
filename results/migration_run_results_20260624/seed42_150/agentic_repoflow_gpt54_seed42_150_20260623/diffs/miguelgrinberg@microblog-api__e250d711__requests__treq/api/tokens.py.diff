+requests = treq
+_reactor_started = threading.Event()
+_reactor_lock = threading.Lock()
+
+
+class _TreqResponseAdapter:
+    def __init__(self, response):
+        self._response = response
+        self._json = None
+        self.status_code = response.code
+
+    def json(self):
+        if self._json is None:
+            self._json = _wait_for_deferred(treq.json_content(self._response))
+        return self._json
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_started.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    if reactor.running:
+        _reactor_started.set()
+        return
+    with _reactor_lock:
+        if not reactor.running:
+            threading.Thread(target=_run_reactor, daemon=True).start()
+    _reactor_started.wait()
+
+
+def _wait_for_deferred(deferred):
+    _ensure_reactor()
+    result = {}
+    done = threading.Event()
+
+    def set_result(value):
+        result['value'] = value
+        done.set()
+        return value
+
+    def set_failure(failure):
+        result['failure'] = failure
+        done.set()
+        return failure
+
+    deferred.addCallbacks(set_result, set_failure)
+    done.wait()
+    if 'failure' in result:
+        result['failure'].raiseException()
+    return result['value']
+
+
+def _oauth_request(method, url, **kwargs):
+    response = getattr(requests, method)(url, **kwargs)
+    if hasattr(response, 'status_code'):
+        return response
+    return _TreqResponseAdapter(_wait_for_deferred(response))
 
 
