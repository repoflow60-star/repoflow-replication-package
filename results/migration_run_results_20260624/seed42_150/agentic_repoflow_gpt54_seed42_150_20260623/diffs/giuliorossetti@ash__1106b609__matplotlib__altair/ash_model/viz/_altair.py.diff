--- a/ash_model/viz/_altair.py
+++ b/ash_model/viz/_altair.py
@@ -0,0 +1,93 @@
+import altair as alt
+from types import SimpleNamespace
+
+
+class Axes:
+    def __init__(self, chart=None):
+        self.chart = chart
+
+    def __getattr__(self, name):
+        if self.chart is None:
+            raise AttributeError(name)
+        return getattr(self.chart, name)
+
+    def __repr__(self):
+        return repr(self.chart)
+
+    def _repr_mimebundle_(self, *args, **kwargs):
+        if self.chart is None:
+            return alt.Chart([])._repr_mimebundle_(*args, **kwargs)
+        return self.chart._repr_mimebundle_(*args, **kwargs)
+
+
+def gca():
+    return Axes()
+
+
+plt = SimpleNamespace(Axes=Axes, gca=gca)
+
+
+def native_value(value):
+    if hasattr(value, "item"):
+        try:
+            value = value.item()
+        except ValueError:
+            pass
+
+    try:
+        if value != value:
+            return None
+    except TypeError:
+        pass
+
+    return value
+
+
+def positive_log_records(records, x_key, y_key):
+    return [
+        record
+        for record in records
+        if record.get(x_key) not in (None, 0)
+        and record.get(y_key) not in (None, 0)
+        and record[x_key] > 0
+        and record[y_key] > 0
+    ]
+
+
+def xy_scale(loglog):
+    if loglog:
+        return alt.Scale(type="log")
+    return alt.Undefined
+
+
+def mark_kwargs(kwargs, allow_color=True, allow_size=False, defaults=None):
+    params = dict(defaults or {})
+    key_map = {
+        "alpha": "opacity",
+        "linewidth": "strokeWidth",
+        "s": "size",
+    }
+    allowed = {"opacity", "filled", "strokeWidth", "strokeDash", "shape"}
+    if allow_color:
+        allowed.add("color")
+    if allow_size:
+        allowed.add("size")
+
+    for key, value in kwargs.items():
+        if key == "ax":
+            continue
+        mapped_key = key_map.get(key, key)
+        if mapped_key in allowed:
+            params[mapped_key] = value
+    return params
+
+
+def merge_chart(kwargs, chart):
+    ax = kwargs.get("ax")
+    if ax is None:
+        return Axes(chart)
+
+    base_chart = ax.chart if isinstance(ax, Axes) else ax
+    if base_chart is None:
+        return Axes(chart)
+    return Axes(base_chart + chart)
