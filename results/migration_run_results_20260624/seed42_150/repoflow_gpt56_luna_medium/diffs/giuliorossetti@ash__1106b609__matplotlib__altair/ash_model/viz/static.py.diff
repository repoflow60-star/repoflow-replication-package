+def plot_hyperedge_size_distribution(
+    h: ASH, max_size: int = None, min_size: int = None, **kwargs: object
+) -> object:
+    """Plot the hyperedge-size distribution as an Altair chart."""
+    size_dist = dict(h.hyperedge_size_distribution())
+    if max_size:
+        size_dist = {k: v for k, v in size_dist.items() if k <= max_size}
+    if min_size:
+        size_dist = {k: v for k, v in size_dist.items() if k >= min_size}
+    data = pd.DataFrame(
+        {"size": list(size_dist), "count": list(size_dist.values())}
+    )
+    chart = alt.Chart(data).mark_bar(
+        opacity=kwargs.get("alpha", 0.4)
+    ).encode(x=alt.X("size:Q"), y=alt.Y("count:Q"))
+    return _properties(chart, kwargs)
+
+
+def plot_degree_distribution(h: ASH, loglog: bool = True, **kwargs: object) -> object:
+    """Plot the degree distribution as an Altair chart."""
+    nodes = h.get_node_set()
+    degs = {n: h.get_degree(n) for n in nodes}
+    deg = dict(sorted(degs.items(), key=lambda item: item[1], reverse=True))
+    y = np.bincount(list(deg.values()))
+    chart = alt.Chart(
+        pd.DataFrame({"x": range(len(y)), "y": y})
+    ).mark_point(opacity=kwargs.get("alpha", 0.4)).encode(
+        x=alt.X("x:Q", scale=_scale(loglog)),
+        y=alt.Y("y:Q", scale=_scale(loglog)),
+    )
+    return _properties(chart, kwargs)
+
+
+def plot_s_ranks(h: ASH, smax: int, loglog: bool = True, **kwargs: object) -> object:
+    """Plot ranked s-degree distributions as an Altair chart."""
+    nodes = h.get_node_set()
+    ss = np.arange(1, smax + 1, 1)
