+_reactor_lock = threading.Lock()
+
+# Keep the existing module-level client patch point while using treq.
+requests = treq
+
+
+def _ensure_reactor():
+    """Start the Twisted reactor on demand for synchronous Flask handlers."""
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if reactor.running:
+            return
+        ready = threading.Event()
+
+        def run_reactor():
+            reactor.callWhenRunning(ready.set)
+            reactor.run(installSignalHandlers=False)
+
+        threading.Thread(target=run_reactor, daemon=True).start()
+        ready.wait()
+
+
+def _request_json(method, url, **kwargs):
+    _ensure_reactor()
+
+    def make_request():
+        request = treq.post if method == 'POST' else treq.get
+        result = defer.maybeDeferred(request, url, **kwargs)
+
+        def handle_response(response):
+            status = getattr(response, 'status_code', None)
+            if status is None:
+                status = response.code
+            if status != 200:
+                if getattr(response, 'status_code', None) is None:
+                    return treq.content(response).addCallback(
+                        lambda ignored: (status, None))
+                return status, None
+            if getattr(response, 'status_code', None) is not None:
+                return defer.maybeDeferred(response.json).addCallback(
+                    lambda content: (status, content))
+            return treq.json_content(response).addCallback(
+                lambda content: (status, content))
+
+        return result.addCallback(handle_response)
+
+    return blockingCallFromThread(reactor, make_request)
 
 
