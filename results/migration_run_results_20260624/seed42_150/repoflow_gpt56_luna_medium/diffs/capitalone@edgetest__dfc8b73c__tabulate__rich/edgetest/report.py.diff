 from typing import Any, List
 
-from tabulate import tabulate
+from rich.table import Table
 
 from edgetest.core import TestPackage
 
 VALID_OUTPUTS = ["rst", "github"]
+
+
+def _render_table(rows: List[List[Any]], headers: List[str], tablefmt: str) -> str:
+    """Render a Rich table using the report's established text formats."""
+    table = Table(show_header=True, box=None, pad_edge=False, padding=(0, 0))
+    for header in headers:
+        table.add_column(header)
+    for row in rows:
+        table.add_row(*(str(value) for value in row))
+
+    table_values = [column._cells for column in table.columns]
+    values = [[str(column.header) for column in table.columns]]
+    values.extend(
+        [str(table_values[index][row]) for index in range(len(table.columns))]
+        for row in range(len(rows))
+    )
+    widths = [max(len(row[index]) for row in values) + 2 for index in range(len(headers))]
+
+    def format_row(row: List[str]) -> str:
+        return "  ".join(
+            value.ljust(width) if index < len(widths) - 1 else value
+            for index, (value, width) in enumerate(zip(row, widths))
+        )
+
+    separator = "  ".join("=" * width for width in widths)
+    if tablefmt == "rst":
+        return "\n".join([separator, format_row(values[0]), separator, *map(format_row, values[1:]), separator])
+
+    markdown_separator = "|" + "|".join("-" * width for width in widths) + "|"
+    body = ["| " + " | ".join(value.ljust(width) for value, width in zip(row, widths)) + " |" for row in values]
+    return "\n".join([body[0], markdown_separator, *body[1:]])
 
 
