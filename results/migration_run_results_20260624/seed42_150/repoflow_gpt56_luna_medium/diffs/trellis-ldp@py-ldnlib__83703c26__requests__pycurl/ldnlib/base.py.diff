+    def _request(self, method, url, **kwargs):
+        headers = kwargs.pop('headers', {})
+        params = kwargs.pop('params', None)
+        timeout = kwargs.pop('timeout', None)
+        allow_redirects = kwargs.pop('allow_redirects', True)
+        data = kwargs.pop('data', None)
+        auth = kwargs.pop('auth', None)
+        verify = kwargs.pop('verify', True)
+        cert = kwargs.pop('cert', None)
+
+        if params:
+            url += ('&' if '?' in url else '?') + urlencode(params, doseq=True)
+
+        body = io.BytesIO()
+        response_headers = {}
+
+        def receive_headers(line):
+            if isinstance(line, bytes):
+                line = line.decode('iso-8859-1')
+            line = line.rstrip('\r\n')
+            if line.startswith('HTTP/'):
+                response_headers.clear()
+            elif ':' in line:
+                name, value = line.split(':', 1)
+                response_headers[name.lower()] = value.strip()
+
+        curl = pycurl.Curl()
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.FOLLOWLOCATION, bool(allow_redirects))
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, receive_headers)
+        if headers:
+            curl_headers = []
+            for name, value in headers.items():
+                if isinstance(value, (tuple, list)):
+                    value = ', '.join(str(item) for item in value)
+                curl_headers.append('{}: {}'.format(name, value))
+            curl.setopt(pycurl.HTTPHEADER, curl_headers)
+
+        if method == 'GET':
+            curl.setopt(pycurl.HTTPGET, 1)
+        elif method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            if data is not None:
+                if isinstance(data, dict):
+                    data = urlencode(data, doseq=True)
+                if isinstance(data, str):
+                    data = data.encode('utf-8')
+                curl.setopt(pycurl.POSTFIELDS, data)
+        elif method == 'HEAD':
+            curl.setopt(pycurl.NOBODY, 1)
+        else:
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+        if timeout is not None:
+            if isinstance(timeout, tuple):
+                curl.setopt(pycurl.CONNECTTIMEOUT, int(timeout[0]))
+                curl.setopt(pycurl.TIMEOUT, int(timeout[1]))
+            else:
+                curl.setopt(pycurl.TIMEOUT, int(timeout))
+
+        if auth is not None:
+            curl.setopt(pycurl.USERPWD, '{}:{}'.format(auth[0], auth[1]))
+            curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_ANY)
+        if not verify:
+            curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+            curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+        if cert:
+            if isinstance(cert, tuple):
+                curl.setopt(pycurl.SSLCERT, cert[0])
+                curl.setopt(pycurl.SSLKEY, cert[1])
+            else:
+                curl.setopt(pycurl.SSLCERT, cert)
+
+        try:
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+        return _CurlResponse(status_code, response_headers, body.getvalue())
