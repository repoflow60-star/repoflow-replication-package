+async def _post(url, data, headers, timeout, proxy=None):
+    client_timeout = aiohttp.ClientTimeout(total=timeout)
+    async with aiohttp.ClientSession(timeout=client_timeout) as session:
+        async with session.post(url, data=data, headers=headers, proxy=proxy) as response:
+            return _Response(response, await response.read())
+
+
+class _AiohttpSession:
+    def post(self, url, data=None, headers=None, timeout=None, proxies=None):
+        proxy = None
+        if proxies:
+            if isinstance(proxies, dict):
+                proxy = proxies.get('https') or proxies.get('http')
+            else:
+                proxy = proxies
+            if proxy and '://' not in proxy:
+                proxy = 'http://' + proxy
+        return asyncio.run(_post(url, data, headers, timeout, proxy))
+
+
