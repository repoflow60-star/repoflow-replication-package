+class _HTTPHeaders(dict):
+    """Case-insensitive response headers."""
+
+    def __getitem__(self, name):
+        return super().__getitem__(name.lower())
+
+    def get(self, name, default=None):
+        return super().get(name.lower(), default)
+
+
+class _PycurlResponse:
+    """Response interface used by the input and URL-munging code."""
+
+    def __init__(self, status_code, headers, content):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+
+    @property
+    def is_redirect(self):
+        return 300 <= self.status_code < 400
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise IOError("HTTP status {}".format(self.status_code))
+
+    def json(self):
+        return json.loads(self.content.decode('utf-8'))
+
+    def iter_content(self, chunk_size=0x1000):
+        for offset in range(0, len(self.content), chunk_size):
+            yield self.content[offset:offset + chunk_size]
+
+    def close(self):
+        pass
+
+
+def _http_request(url, method='GET', verify=True, timeout=None, headers=None,
+                  params=None, data=None, follow_redirects=True):
+    """Perform an HTTP request through libcurl."""
+    if params:
+        separator = '&' if '?' in url else '?'
+        url = url + separator + urllib.parse.urlencode(params)
+
+    body = io.BytesIO()
+    response_headers = _HTTPHeaders()
+
+    def collect_header(line):
+        raw_line = line
+        if isinstance(line, bytes):
+            line = line.decode('iso-8859-1')
+        stripped = line.strip()
+        if stripped.startswith('HTTP/'):
+            response_headers.clear()
+        elif ':' in stripped:
+            name, value = stripped.split(':', 1)
+            response_headers[name.lower()] = value.strip()
+        return len(raw_line)
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, collect_header)
+        curl.setopt(pycurl.CUSTOMREQUEST, method)
+        if method.upper() == 'HEAD':
+            curl.setopt(pycurl.NOBODY, 1)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1 if follow_redirects else 0)
+        curl.setopt(pycurl.ACCEPT_ENCODING, '')
+        if headers:
+            curl.setopt(pycurl.HTTPHEADER, [
+                '{}: {}'.format(name, value) for name, value in headers.items()
+            ])
+        if data is not None:
+            curl.setopt(pycurl.POSTFIELDS, urllib.parse.urlencode(data))
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT, timeout)
+        curl.setopt(pycurl.SSL_VERIFYPEER, 1 if verify else 0)
+        curl.setopt(pycurl.SSL_VERIFYHOST, 2 if verify else 0)
+        curl.perform()
+        return _PycurlResponse(
+            curl.getinfo(pycurl.RESPONSE_CODE), response_headers, body.getvalue()
+        )
+    except pycurl.error as error:
+        raise IOError(str(error))
+    finally:
+        curl.close()
 
