+class _PycurlResponse(object):
+    def __init__(self, status_code, headers, content):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+        self.reason = responses.get(status_code, '')
+
+    def json(self):
+        return loads(self.content)
+
+
+class _PycurlSession(object):
+    """Small session-shaped wrapper that performs requests with libcurl."""
+
+    def __init__(self):
+        self.auth = None
+        self.headers = {}
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        body = BytesIO()
+        response_headers = {}
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            curl.setopt(pycurl.WRITEFUNCTION, body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, self._header_callback(response_headers))
+            curl.setopt(pycurl.TIMEOUT, timeout)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+
+            request_headers = dict(self.headers)
+            if headers:
+                request_headers.update(headers)
+            curl.setopt(pycurl.HTTPHEADER,
+                        ['%s: %s' % (name, value)
+                         for name, value in request_headers.items()])
+
+            if self.auth:
+                curl.setopt(pycurl.USERPWD, '%s:%s' % self.auth)
+            if data is not None:
+                if (request_headers.get('Content-Type') ==
+                        'application/x-www-form-urlencoded' and isinstance(data, dict)):
+                    data = urlencode(data)
+                if isinstance(data, str):
+                    data = data.encode('utf-8')
+                curl.setopt(pycurl.POSTFIELDS, data)
+            elif method in ('POST', 'PUT', 'PATCH'):
+                curl.setopt(pycurl.POSTFIELDS, b'')
+
+            curl.perform()
+            return _PycurlResponse(curl.getinfo(pycurl.RESPONSE_CODE),
+                                   response_headers, body.getvalue())
+        finally:
+            curl.close()
+
+    @staticmethod
+    def _header_callback(response_headers):
+        def receive(line):
+            line_length = len(line)
+            line = line.decode('iso-8859-1').strip()
+            if ':' in line:
+                name, value = line.split(':', 1)
+                response_headers[name.strip()] = value.strip()
+            return line_length
+        return receive
 
 
