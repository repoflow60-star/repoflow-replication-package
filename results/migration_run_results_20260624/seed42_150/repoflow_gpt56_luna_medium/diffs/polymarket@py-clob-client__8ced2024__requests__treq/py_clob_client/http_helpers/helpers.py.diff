+def _request(endpoint, method, headers, data):
+    _start_reactor()
+    result = {}
+    complete = threading.Event()
+
+    def finished(response, body):
+        result["response"] = response
+        result["body"] = body
+        complete.set()
+
+    def failed(failure):
+        result["failure"] = failure
+        complete.set()
+
+    def received(response):
+        deferred = treq.content(response)
+        deferred.addCallback(lambda body: finished(response, body))
+        deferred.addErrback(failed)
+        return deferred
+
+    def start_request():
+        deferred = treq.request(
+            method,
+            endpoint,
+            headers=headers,
+            data=json.dumps(data) if data else None,
+        )
+        deferred.addCallback(received)
+        deferred.addErrback(failed)
+
+    reactor.callFromThread(start_request)
+    complete.wait()
+
+    if "failure" in result:
+        result["failure"].raiseException()
+    return result["response"], result["body"]
+
 
