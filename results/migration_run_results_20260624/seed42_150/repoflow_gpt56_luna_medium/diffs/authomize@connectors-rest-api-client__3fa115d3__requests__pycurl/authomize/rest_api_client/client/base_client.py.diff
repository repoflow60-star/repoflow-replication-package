+class _PycurlResponse:
+    def __init__(self, status_code, headers, content, url):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+        self.url = url
+        try:
+            self.reason = HTTPStatus(status_code).phrase
+        except ValueError:
+            self.reason = ''
+
+    @property
+    def ok(self):
+        return self.status_code < 400
+
+    @property
+    def text(self):
+        return self.content.decode('utf-8', errors='replace')
+
+    def json(self):
+        import json
+
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if not self.ok:
+            raise pycurl.error(self.status_code, self.reason)
+
+
+class _PycurlSession:
+    def __init__(self):
+        self.headers = {}
+
+    def request(self, method, url, params=None, headers=None, data=None):
+        if params:
+            parts = urlsplit(url)
+            query = urlencode(params, doseq=True)
+            existing_query = f'{parts.query}&' if parts.query else ''
+            url = urlunsplit(parts._replace(query=existing_query + query))
+
+        response_body = BytesIO()
+        response_headers = {}
+
+        def receive_header(line):
+            decoded_line = line.decode('iso-8859-1').strip()
+            if ':' in decoded_line:
+                name, value = decoded_line.split(':', 1)
+                response_headers[name.lower()] = value
+
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            curl.setopt(pycurl.HTTPHEADER, [
+                f'{name}: {value}' for name, value in {**self.headers, **(headers or {})}.items()
+            ])
+            curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, receive_header)
+            curl.setopt(pycurl.ACCEPT_ENCODING, '')
+            if method == 'POST' and data is None:
+                curl.setopt(pycurl.POST, 1)
+            elif data is not None:
+                curl.setopt(pycurl.POSTFIELDS, data.encode('utf-8') if isinstance(data, str) else data)
+            curl.perform()
+            return _PycurlResponse(
+                status_code=curl.getinfo(pycurl.RESPONSE_CODE),
+                headers=response_headers,
+                content=response_body.getvalue(),
+                url=url,
+            )
+        finally:
+            curl.close()
+
+    def get(self, url, params=None):
+        return self.request('GET', url, params=params)
+
+    def post(self, url, headers=None, data=None):
+        return self.request('POST', url, headers=headers, data=data)
+
+    def patch(self, url, headers=None, data=None):
+        return self.request('PATCH', url, headers=headers, data=data)
+
+    def delete(self, url, params=None):
+        return self.request('DELETE', url, params=params)
+
+
