+class _HTTPResponse:
+    """Synchronous response view matching the fields used by the API client."""
+
+    def __init__(self, response, data):
+        self.status = response.status
+        self._headers = dict(response.headers)
+        self.data = data
+
+    def getheaders(self):
+        return self._headers
+
+    def close(self):
+        pass
+
+
+class _AiohttpHTTP:
+    def __init__(self, proxy=None, timeout=60, ca_certs=None, cert_reqs=None, **kwargs):
+        self.proxy = proxy
+        self.proxy_auth = None
+        self.timeout = aiohttp.ClientTimeout(total=timeout)
+        self.ssl = None
+        if ca_certs is not None:
+            self.ssl = ssl.create_default_context(cafile=ca_certs)
+            if cert_reqs == ssl.CERT_NONE:
+                self.ssl.check_hostname = False
+                self.ssl.verify_mode = ssl.CERT_NONE
+
+    async def _request(self, method, url, fields, body, headers):
+        request_kwargs = {"headers": headers}
+        if fields is not None:
+            request_kwargs["params"] = fields
+        if body is not None:
+            request_kwargs["data"] = body
+        if self.proxy is not None:
+            request_kwargs["proxy"] = self.proxy
+        if self.proxy_auth is not None:
+            request_kwargs["proxy_auth"] = self.proxy_auth
+        if self.ssl is not None:
+            request_kwargs["ssl"] = self.ssl
+
+        async with aiohttp.ClientSession(timeout=self.timeout) as session:
+            async with session.request(method, url, **request_kwargs) as response:
+                return _HTTPResponse(response, await response.read())
+
+    def request(self, method, url, fields=None, body=None, headers=None, **kwargs):
+        return asyncio.run(self._request(method, url, fields, body, headers))
+
+    def urlopen(self, method, url, body=None, headers=None, **kwargs):
+        return self.request(method, url, body=body, headers=headers, **kwargs)
+
+    def clear(self):
+        pass
+
