 _GRAPHQL_API_URL = "https://apis.justwatch.com/graphql"
+_HTTP = urllib3.PoolManager()
+
+
+def post(url: str, *, json: dict):
+    """Send a JSON POST request using urllib3."""
+    return _HTTP.request(
+        "POST",
+        url,
+        body=_json.dumps(json).encode("utf-8"),
+        headers={"Content-Type": "application/json"},
+    )
+
+
+def _raise_for_status(response) -> None:
+    if hasattr(response, "raise_for_status"):
+        response.raise_for_status()
+    elif response.status >= 400:
+        raise urllib3.exceptions.HTTPError(f"HTTP {response.status} returned for {_GRAPHQL_API_URL}")
+
+
+def _response_json(response) -> dict:
+    if hasattr(response, "json"):
+        return response.json()
+    return _json.loads(response.data)
 
 
