-session = requests.Session()
+_reactor_lock = Lock()
+_reactor_started = Event()
+
+
+def _start_reactor():
+    reactor.callWhenRunning(_reactor_started.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if not reactor.running:
+            Thread(target=_start_reactor, daemon=True).start()
+    _reactor_started.wait()
+
+
+def _sync_result(value):
+    """Resolve a treq Deferred while retaining yarg's synchronous API."""
+    if not hasattr(value, 'addCallbacks'):
+        return value
+
+    _ensure_reactor()
+    result = []
+    failure = []
+    complete = Event()
+
+    def succeeded(item):
+        result.append(item)
+        complete.set()
+        return item
+
+    def failed(error):
+        failure.append(error)
+        complete.set()
+        return error
+
+    value.addCallbacks(succeeded, failed)
+    complete.wait()
+    if failure:
+        failure[0].raiseException()
+    return result[0]
+
+
+# Keep the existing session.get seam while using treq for the transport.
+session = treq
 
 
