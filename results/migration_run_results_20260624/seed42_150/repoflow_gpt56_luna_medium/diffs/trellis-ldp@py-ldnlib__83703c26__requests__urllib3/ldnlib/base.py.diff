+    def _request(self, method, target, **kwargs):
+        allow_redirects = kwargs.pop('allow_redirects', True)
+        if 'data' in kwargs:
+            kwargs['body'] = kwargs.pop('data')
+
+        params = kwargs.pop('params', None)
+        if params:
+            parts = urlsplit(target)
+            query = urlencode(params, doseq=True)
+            target = urlunsplit((parts.scheme, parts.netloc, parts.path,
+                                 '&'.join(filter(None, (parts.query, query))),
+                                 parts.fragment))
+
+        response = self._http.request(method, target,
+                                      redirect=allow_redirects, **kwargs)
+        if response.status >= 400:
+            raise urllib3.exceptions.HTTPError(
+                'HTTP error {} for {}'.format(response.status, target))
+        return response
+
+    @staticmethod
+    def _text(response):
+        return response.data.decode('utf-8')
+
+    @staticmethod
+    def _json(response):
+        return json.loads(BaseLDN._text(response))
+
+    @staticmethod
