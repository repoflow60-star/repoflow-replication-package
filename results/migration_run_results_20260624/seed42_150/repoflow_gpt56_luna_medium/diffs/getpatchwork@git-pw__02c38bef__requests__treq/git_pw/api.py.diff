+class _Response:
+    def __init__(self, status: int, headers: ty.Dict[str, str], body: bytes):
+        self.status_code = status
+        self.headers = headers
+        self.content = body
+
+    def json(self) -> ty.Any:
+        import json
+
+        return json.loads(self.content)
+
+    def iter_content(self, chunk_size: int):
+        for offset in range(0, len(self.content), chunk_size):
+            yield self.content[offset:offset + chunk_size]
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            raise _RequestError(self)
+
+
+class _RequestError(Exception):
+    def __init__(self, response: ty.Optional[_Response]):
+        super().__init__(
+            'HTTP status {}'.format(response.status_code)
+            if response is not None else 'HTTP request failed'
+        )
+        self.response = response
+
+
+def _request(
+    method: str,
+    url: str,
+    params: ty.Optional[Filters] = None,
+    data: ty.Optional[ty.List[ty.Tuple[str, ty.Any]]] = None,
+    auth: ty.Optional[str] = None,
+) -> _Response:
+    if params:
+        url = '{}{}{}'.format(url, '&' if '?' in url else '?', urlencode(params))
+
+    headers = _get_headers()
+    if auth:
+        headers['Authorization'] = auth
+
+    result: ty.List[_Response] = []
+
+    @defer.inlineCallbacks
+    def perform(reactor):
+        response = yield treq.request(
+            method,
+            url,
+            headers=headers,
+            data=data,
+            reactor=reactor,
+        )
+        body = yield treq.content(response)
+        response_headers = {
+            (key.decode() if isinstance(key, bytes) else key).lower(): (
+                values[0].decode()
+                if isinstance(values[0], bytes) else values[0]
+            )
+            for key, values in response.headers.getAllRawHeaders()
+        }
+        result.append(_Response(response.code, response_headers, body))
+
+    try:
+        task.react(perform)
+    except Exception as exc:
+        raise _RequestError(None) from exc
+    return result[0]
+
