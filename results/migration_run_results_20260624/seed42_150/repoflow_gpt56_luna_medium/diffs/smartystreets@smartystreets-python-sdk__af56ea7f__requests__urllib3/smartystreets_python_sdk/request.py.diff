+class HttpRequest:
+    """Transport-neutral request assembled by sender decorators."""
+
+    def __init__(self, url, params=None):
+        self.url = url
+        self.params = params or OrderedDict()
+        self.headers = {}
+        self.body = None
+        self.method = 'GET'
+
+    @property
+    def data(self):
+        return self.body
+
+    @data.setter
+    def data(self, value):
+        self.body = value
