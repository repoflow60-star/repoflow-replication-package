+
+
+def _request(method: str, url: str, **kwargs):
+    if PROXY_DICT:
+        proxy_url = PROXY_DICT['https']
+        manager_type = urllib3.ProxyManager
+        if proxy_url.startswith('socks'):
+            from urllib3.contrib.socks import SOCKSProxyManager
+
+            manager_type = SOCKSProxyManager
+        session = manager_type(
+            proxy_url,
+            cert_reqs='CERT_REQUIRED' if VERIFY_SSL else 'CERT_NONE',
+        )
+    elif VERIFY_SSL:
+        session = REQ_SESSION
+    else:
+        session = urllib3.PoolManager(cert_reqs='CERT_NONE')
+
+    request = getattr(session, method.lower(), None)
+    if request is None:
+        return session.request(method, url, **kwargs)
+    return request(url, **kwargs)
+
+
+def _raise_for_status(response) -> None:
+    status = getattr(response, 'status', None)
+    if isinstance(status, int) and status >= 400:
+        raise urllib3.exceptions.HTTPError(f'HTTP {status}')
+
+
+def _response_data(response):
+    data = getattr(response, 'data', None)
+    if isinstance(data, (bytes, bytearray)):
+        return data
+    return getattr(response, 'content', data)
 
