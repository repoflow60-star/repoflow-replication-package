+    @classmethod
+    def _ensure_reactor(cls):
+        if reactor.running:
+            return
+        with cls._reactor_lock:
+            if not reactor.running:
+                ready = Event()
+                reactor.callWhenRunning(ready.set)
+                Thread(target=cls._run_reactor, daemon=True).start()
+                ready.wait()
