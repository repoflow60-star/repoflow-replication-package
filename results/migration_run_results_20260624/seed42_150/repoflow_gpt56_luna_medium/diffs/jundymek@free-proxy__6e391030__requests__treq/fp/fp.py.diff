+from twisted.web.client import ProxyAgent
 
 from fp.errors import FreeProxyException
+
+
+_reactor_started = threading.Event()
+_reactor_lock = threading.Lock()
+
+
+def _start_reactor():
+    if _reactor_started.is_set():
+        return
+    with _reactor_lock:
+        if not _reactor_started.is_set():
+            thread = threading.Thread(
+                target=reactor.run,
+                kwargs={'installSignalHandlers': False},
+                daemon=True)
+            thread.start()
+            _reactor_started.set()
+
+
+def _run_on_reactor(operation):
+    _start_reactor()
+    completed = threading.Event()
+    result = []
+
+    def execute():
+        deferred = defer.maybeDeferred(operation)
+        deferred.addCallbacks(
+            lambda value: (result.append((True, value)), completed.set()),
+            lambda failure: (result.append((False, failure.value)), completed.set()))
+
+    reactor.callFromThread(execute)
+    completed.wait()
+    success, value = result[0]
+    if not success:
+        raise value
+    return value
 
 
