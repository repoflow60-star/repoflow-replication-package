-import requests
+import threading
+
+import treq
+from twisted.internet import defer, reactor
+from twisted.internet.threads import blockingCallFromThread
+from twisted.web.error import Error
+
 from nyaapy import torrent
 from nyaapy.parser import parse_nyaa, parse_single, parse_nyaa_rss
+
+
+_reactor_started = threading.Event()
+_reactor_start_lock = threading.Lock()
+_reactor_thread = None
+
+
+def _start_reactor():
+    global _reactor_thread
+
+    if _reactor_started.is_set():
+        return
+
+    with _reactor_start_lock:
+        if _reactor_started.is_set():
+            return
+
+        def run_reactor():
+            reactor.callWhenRunning(_reactor_started.set)
+            reactor.run(installSignalHandlers=False)
+
+        _reactor_thread = threading.Thread(target=run_reactor, daemon=True)
+        _reactor_thread.start()
+        _reactor_started.wait()
+
+
+@defer.inlineCallbacks
+def _request(url, as_text=False):
+    response = yield treq.get(url)
+    if response.code >= 400:
+        raise Error(response.code, response.phrase)
+
+    if as_text:
+        body = yield treq.text_content(response)
+    else:
+        body = yield treq.content(response)
+    return body
+
+
+def _get_body(url, as_text=False):
+    _start_reactor()
+    return blockingCallFromThread(reactor, _request, url, as_text)
 
 
