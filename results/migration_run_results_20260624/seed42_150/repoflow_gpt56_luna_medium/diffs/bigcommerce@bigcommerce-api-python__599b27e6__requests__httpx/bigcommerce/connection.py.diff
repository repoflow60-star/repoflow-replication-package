+class _HttpxClient(httpx.Client):
+    """Keep the session attributes exposed by the original requests client."""
+
+    def __init__(self, *args, **kwargs):
+        self._compat_auth = None
+        self._compat_headers = {}
+        super().__init__(*args, **kwargs)
+
+    @property
+    def auth(self):
+        return self._compat_auth
+
+    @auth.setter
+    def auth(self, value):
+        self._compat_auth = value
+        if isinstance(value, tuple):
+            self._auth = httpx.BasicAuth(*value)
+        else:
+            self._auth = value
+
+    @property
+    def headers(self):
+        return self._compat_headers
+
+    @headers.setter
+    def headers(self, value):
+        self._compat_headers = dict(value)
+        self._headers = httpx.Headers(value)
 
 
