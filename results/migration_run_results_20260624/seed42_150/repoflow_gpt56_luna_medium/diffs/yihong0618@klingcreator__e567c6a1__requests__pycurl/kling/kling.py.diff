+                        rest={},
+                        rfc2109=False,
+                    )
+                )
+
+    def get(self, url: str, **kwargs):
+        return self._request(url, "GET", **kwargs)
+
+    def post(self, url: str, **kwargs):
+        return self._request(url, "POST", **kwargs)
