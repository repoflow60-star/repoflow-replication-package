+class _CookieJar(CookieJar):
+    """CookieJar with the small mapping interface used by the client."""
+
+    def keys(self):
+        return [cookie.name for cookie in self]
+
+    def __getitem__(self, name):
+        for cookie in self:
+            if cookie.name == name:
+                return cookie.value
+        raise KeyError(name)
+
+    def items(self):
+        return [(cookie.name, cookie.value) for cookie in self]
+
+
+class _PycurlResponse:
+    def __init__(self, status_code: int, content: bytes) -> None:
+        self.status_code = status_code
+        self.content = content
+        self.text = content.decode("utf-8", errors="replace")
+        self.ok = status_code < 400
+
+    def json(self):
+        return json.loads(self.text)
+
+
+class _PycurlSession:
+    def __init__(self) -> None:
+        self.cookies = _CookieJar()
+        self.headers = {}
+
+    def _request(self, url: str, method: str, **kwargs):
+        params = kwargs.get("params")
+        if params:
+            query = urlencode(params, doseq=True)
+            url = f"{url}{'&' if '?' in url else '?'}{query}"
+
+        headers = dict(self.headers)
+        headers.update(kwargs.get("headers") or {})
+        curl_headers = [f"{key}: {value}" for key, value in headers.items()]
+
+        user_agent = next(
+            (value for key, value in headers.items() if key.lower() == "user-agent"),
+            None,
+        )
+        if user_agent is not None:
+            curl_headers = [
+                header
+                for header in curl_headers
+                if not header.lower().startswith("user-agent:")
+            ]
+
+        body_data = kwargs.get("data")
+        if "json" in kwargs:
+            body_data = json.dumps(kwargs["json"]).encode("utf-8")
+            if not any(key.lower() == "content-type" for key in headers):
+                curl_headers.append("Content-Type: application/json")
+        elif isinstance(body_data, str):
+            body_data = body_data.encode("utf-8")
+
+        cookie_header = "; ".join(
+            f"{cookie.name}={cookie.value}" for cookie in self.cookies
+        )
+        body = io.BytesIO()
+        response_headers = io.BytesIO()
+        curl = pycurl.Curl()
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.WRITEDATA, body)
+        curl.setopt(pycurl.HEADERFUNCTION, response_headers.write)
+        if user_agent is not None:
+            curl.setopt(pycurl.USERAGENT, user_agent)
+        if cookie_header:
+            curl.setopt(pycurl.COOKIE, cookie_header)
+        if curl_headers:
+            curl.setopt(pycurl.HTTPHEADER, curl_headers)
+        if method == "POST":
+            curl.setopt(pycurl.POST, 1)
+            if body_data is not None:
+                curl.setopt(pycurl.POSTFIELDS, body_data)
+
+        try:
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        self._store_response_cookies(response_headers.getvalue())
+        return _PycurlResponse(status_code, body.getvalue())
+
+    def _store_response_cookies(self, raw_headers: bytes) -> None:
