+    def _request_json(
+        self,
+        method: str,
+        url: str,
+        params: Optional[Dict] = None,
+        data: Optional[Dict] = None,
+        json: Optional[Dict] = None,
+    ) -> Dict[str, Any]:
+        """Perform an HTTP request with pycurl and decode its JSON response."""
+        if params:
+            url += ("&" if "?" in url else "?") + urlencode(params, doseq=True)
+
+        response_body = io.BytesIO()
+        method = method.upper()
+        self.session.reset()
+        self.session.setopt(pycurl.URL, url)
+        self.session.setopt(pycurl.CUSTOMREQUEST, method)
+        self.session.setopt(pycurl.WRITEFUNCTION, response_body.write)
+        self.session.setopt(pycurl.TIMEOUT, 30)
+
+        headers = [key + ": " + str(value) for key, value in (self.headers or {}).items()]
+        if json is not None:
+            self.session.setopt(pycurl.POSTFIELDS, json_module.dumps(json))
+            headers.append("Content-Type: application/json")
+        elif data is not None:
+            self.session.setopt(pycurl.POSTFIELDS, urlencode(data, doseq=True))
+        elif method == "GET":
+            self.session.setopt(pycurl.HTTPGET, True)
+
+        self.session.setopt(pycurl.HTTPHEADER, headers)
+        self.session.perform()
+        status = self.session.getinfo(pycurl.RESPONSE_CODE)
+        if status >= 400:
+            raise RuntimeError("HTTP request failed with status code {}".format(status))
+        return json_module.loads(response_body.getvalue().decode("utf-8"))
 
