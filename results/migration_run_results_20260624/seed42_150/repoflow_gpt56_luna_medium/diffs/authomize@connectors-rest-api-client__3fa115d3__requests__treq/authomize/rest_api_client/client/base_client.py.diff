+    def _request(self, method, url, params=None, headers=None, data=None):
+        reactor = SelectReactor()
+        result = []
+        failure = []
+
+        request_headers = {
+            key: [value.encode('utf-8')]
+            for key, value in {**self.headers, **(headers or {})}.items()
+        }
+
+        def finish(response):
+            return treq.content(response).addCallback(
+                lambda content: result.append(_TreqResponse(response, content, url))
+            )
+
+        def fail(error):
+            failure.append(error)
+            return error
+
+        deferred = self.session.request(
+            method.encode('ascii'),
+            url,
+            params=params,
+            headers=Headers(request_headers),
+            data=data.encode('utf-8') if isinstance(data, str) else data,
+            reactor=reactor,
+        )
+        deferred.addCallback(finish)
+        deferred.addErrback(fail)
+        deferred.addBoth(lambda _: reactor.stop())
+        reactor.run()
+        if failure:
+            failure[0].raiseException()
+        return result[0]
+
