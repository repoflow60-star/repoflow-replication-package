+class _TreqResponse:
+    def __init__(self, response, content: bytes, url: str):
+        self.status_code = response.code
+        self.reason = response.phrase.decode('latin-1')
+        self.headers = {
+            key.decode('latin-1').lower(): value[0].decode('latin-1')
+            for key, value in response.headers.getAllRawHeaders()
+        }
+        self.url = url
+        self.content = content
+
+    @property
+    def ok(self):
+        return 200 <= self.status_code < 400
+
+    @property
+    def text(self):
+        return self.content.decode('utf-8')
+
+    def json(self):
+        return json.loads(self.content)
+
+    def raise_for_status(self):
+        raise ClientError(f'{self.status_code}: {self.reason}')
+
