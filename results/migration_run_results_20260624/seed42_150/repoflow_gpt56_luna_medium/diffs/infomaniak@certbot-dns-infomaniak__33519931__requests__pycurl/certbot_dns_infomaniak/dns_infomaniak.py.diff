+class _PycurlResponse:
+    """Response body with the small interface used by the API client."""
+
+    def __init__(self, body):
+        self._body = body
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        return False
+
+    def json(self):
+        return json.loads(self._body.decode("utf-8"))
+
+
+class _PycurlRequest:
+    """Request data passed to an optionally mounted transport."""
+
+    def __init__(self, method, url, headers, body):
+        self.method = method
+        self.url = url
+        self.headers = headers
+        self.body = body
+
+
+class _PycurlSession:
+    """Small session facade for making API requests with pycurl."""
+
+    def __init__(self):
+        self.headers = {}
+        self._mounts = {}
+
+    def mount(self, prefix, transport):
+        self._mounts[prefix] = transport
+
+    def get(self, url, params=None):
+        if params:
+            separator = "&" if "?" in url else "?"
+            url = "{}{}{}".format(url, separator, urlencode(params, doseq=True))
+        return self._request(url, "GET")
+
+    def post(self, url, data=None, headers=None):
+        return self._request(url, "POST", data, headers)
+
+    def delete(self, url):
+        return self._request(url, "DELETE")
+
+    def _request(self, url, method, data=None, headers=None):
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        mounted = [prefix for prefix in self._mounts if url.startswith(prefix)]
+        if mounted:
+            prefix = max(mounted, key=len)
+            return self._mounts[prefix].send(
+                _PycurlRequest(method, url, request_headers, data)
+            )
+
+        response = io.BytesIO()
+        curl = pycurl.Curl()
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(
+            pycurl.HTTPHEADER,
+            ["{}: {}".format(name, value) for name, value in request_headers.items()],
+        )
+        curl.setopt(pycurl.WRITEFUNCTION, response.write)
+        if method == "POST":
+            curl.setopt(pycurl.POST, True)
+            curl.setopt(pycurl.POSTFIELDS, data.encode("utf-8"))
+        elif method == "DELETE":
+            curl.setopt(pycurl.CUSTOMREQUEST, "DELETE")
+        else:
+            curl.setopt(pycurl.HTTPGET, True)
+        try:
+            curl.perform()
+        finally:
+            curl.close()
+        return _PycurlResponse(response.getvalue())
+
+
