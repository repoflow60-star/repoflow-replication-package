+def _http_request(method, url, verify_ssl=True, headers=None, timeout=None,
+                  fields=None, body=None, redirect=True):
+    """Make an HTTP request with the options used by this module."""
+    manager = urllib3.PoolManager(
+        cert_reqs='CERT_REQUIRED' if verify_ssl else 'CERT_NONE',
+        retries=False
+    )
+    request_headers = dict(headers or {})
+    if body is not None and 'Content-Type' not in request_headers:
+        request_headers['Content-Type'] = 'application/x-www-form-urlencoded'
+    return manager.request(
+        method, url, headers=request_headers, fields=fields, body=body,
+        timeout=timeout, redirect=redirect, decode_content=True
+    )
 
