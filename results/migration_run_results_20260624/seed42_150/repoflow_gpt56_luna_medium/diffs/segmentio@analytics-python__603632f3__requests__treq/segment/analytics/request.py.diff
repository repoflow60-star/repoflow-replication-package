+_reactor_lock = threading.Lock()
+
+
+def _start_reactor():
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if not reactor.running:
+            threading.Thread(
+                target=reactor.run,
+                kwargs={'installSignalHandlers': False},
+                daemon=True,
+            ).start()
+
+
+def _request(method, url, data, headers, timeout):
+    """Run treq's Deferred request without changing the sync API."""
+    _start_reactor()
+    result = {}
+    completed = threading.Event()
+
+    def finish(response, body=None):
+        result['response'] = response
+        result['body'] = body
+        completed.set()
+
+    def failed(error):
+        result['error'] = error.value
+        completed.set()
+
+    deferred = treq.request(method, url, data=data, headers=headers)
+    deferred.addCallback(lambda response: treq.content(response).addCallback(
+        lambda body: finish(response, body)))
+    deferred.addErrback(failed)
+    if not completed.wait(timeout):
+        raise TimeoutError('request timed out')
+    if 'error' in result:
+        raise result['error']
+    return result['response'], result['body']
+
+
+def _response_json(body):
+    return json.loads(body.decode('utf-8'))
+
+
+def _response_text(body):
+    return body.decode('utf-8', errors='replace')
 
 
