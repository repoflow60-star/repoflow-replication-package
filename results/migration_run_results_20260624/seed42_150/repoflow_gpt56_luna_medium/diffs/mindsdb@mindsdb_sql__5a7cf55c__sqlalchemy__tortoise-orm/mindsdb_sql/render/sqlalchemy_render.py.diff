+    def prepare_case(self, value):
+        parts = ['CASE']
+        if value.arg is not None:
+            parts.append(self.to_expression(value.arg).sql)
+        for condition, result in value.rules:
+            parts.extend(('WHEN', self.to_expression(condition).sql, 'THEN', self.to_expression(result).sql))
+        if value.default is not None:
+            parts.extend(('ELSE', self.to_expression(value.default).sql))
+        return _Expr(' '.join(parts) + ' END')
+
