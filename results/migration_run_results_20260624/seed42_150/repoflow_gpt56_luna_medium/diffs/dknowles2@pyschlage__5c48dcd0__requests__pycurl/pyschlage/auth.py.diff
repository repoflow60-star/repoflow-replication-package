+class _AuthRequest:
+    """Small request object compatible with pycognito's auth hook."""
+
+    def __init__(
+        self,
+        method: str | None = None,
+        url: str | None = None,
+        headers: dict[str, str] | None = None,
+    ) -> None:
+        self.method = method
+        self.url = url
+        self.headers = {} if headers is None else headers
+
+
+class _HTTPError(Exception):
+    def __init__(self, response: "_CurlResponse") -> None:
+        self.response = response
+
+
+class _CurlResponse:
+    """Response view backed by the bytes returned from a pycurl transfer."""
+
+    def __init__(self, body: bytes, status_code: int, reason: str) -> None:
+        self.content = body
+        self.status_code = status_code
+        self.reason = reason
+
+    def json(self):
+        return json.loads(self.content)
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            raise _HTTPError(self)
+
