--- a/appstoreserverlibrary/_treq.py
+++ b/appstoreserverlibrary/_treq.py
@@ -0,0 +1,40 @@
+from typing import Dict, Optional, Tuple
+
+import treq
+from twisted.internet import reactor, threads
+from twisted.web.client import readBody
+
+
+def request_sync(
+    method: str,
+    url: str,
+    params: Optional[Dict] = None,
+    headers: Optional[Dict[str, str]] = None,
+    json_body=None,
+    body: Optional[bytes] = None,
+) -> Tuple[int, Dict[str, str], bytes]:
+    """Execute a treq request from the synchronous library API."""
+    request_kwargs = {"params": params, "headers": headers}
+    if json_body is not None:
+        request_kwargs["json"] = json_body
+    elif body is not None:
+        request_kwargs["data"] = body
+
+    def perform_request():
+        deferred = treq.request(method, url, **request_kwargs)
+
+        def read_response(response):
+            return readBody(response).addCallback(
+                lambda content: (
+                    response.code,
+                    {
+                        name.decode("latin-1").lower(): values[-1].decode("latin-1")
+                        for name, values in response.headers.getAllRawHeaders()
+                    },
+                    content,
+                )
+            )
+
+        return deferred.addCallback(read_response)
+
+    return threads.blockingCallFromThread(reactor, perform_request)
