 CORRECT_PATH = ".well-known/security.txt"
 
 
+_reactor_ready = threading.Event()
+
+
+def _run_reactor() -> None:
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _treq_get(url: str, headers: dict, timeout: int, verify: bool = True):
+    """Run treq's asynchronous request API behind the existing sync boundary."""
+    if not reactor.running:
+        threading.Thread(target=_run_reactor, daemon=True).start()
+        _reactor_ready.wait()
+
+    def request():
+        options = {
+            "headers": Headers(
+                {
+                    key.encode("ascii"): [value.encode("ascii")]
+                    for key, value in headers.items()
+                }
+            ),
+            "timeout": timeout,
+            "browser_like_redirects": True,
+        }
+        if not verify:
+            options["agent"] = Agent(
+                reactor, contextFactory=ssl.ClientContextFactory()
+            )
+        deferred = treq.get(url, **options)
+        deferred.addCallback(
+            lambda response: treq.content(response).addCallback(
+                lambda content: (response, content)
+            )
+        )
+        return deferred
+
+    return threads.blockingCallFromThread(reactor, request)
+
+
+def _is_certificate_error(error: Exception) -> bool:
+    return "certificate" in str(error).lower()
+
+
+def _response_url(response) -> str:
+    value = response.request.absoluteURI
+    if isinstance(value, bytes):
+        return value.decode("ascii")
+    return value
+
+
+def _response_history(response) -> list:
+    history = []
+    previous = getattr(response, "previousResponse", None)
+    while previous is not None:
+        history.append(previous)
+        previous = getattr(previous, "previousResponse", None)
+    return history
+
