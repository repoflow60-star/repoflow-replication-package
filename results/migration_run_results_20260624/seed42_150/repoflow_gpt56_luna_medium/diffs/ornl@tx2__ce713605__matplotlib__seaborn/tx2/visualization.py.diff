 _cached_wordclouds = {}
 
 
+def _new_figure(rows=1, cols=1, figsize=(8, 5)):
+    """Create a seaborn-managed figure and return its figure and axes grid."""
+    data = pd.DataFrame(
+        {"row": np.repeat(np.arange(rows), cols), "col": np.tile(np.arange(cols), rows)}
+    )
+    grid = sns.FacetGrid(
+        data,
+        row="row" if rows > 1 else None,
+        col="col" if cols > 1 else None,
+        height=figsize[1] / rows,
+        aspect=figsize[0] * rows / (figsize[1] * cols),
+        despine=False,
+    )
+    return grid.fig, np.asarray(grid.axes).reshape(rows, cols)
+
