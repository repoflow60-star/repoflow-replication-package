--- a/ldnlib/http.py
+++ b/ldnlib/http.py
@@ -0,0 +1,141 @@
+import io
+import json
+
+import pycurl
+
+
+class HTTPError(Exception):
+
+    pass
+
+
+class Response(object):
+
+    def __init__(self, status_code, headers, body, url=None):
+        self.status_code = status_code
+        self.headers = headers
+        self._body = body
+        self.url = url
+        self.links = self._parse_links(headers.get('link'))
+
+    @property
+    def text(self):
+        return self._body.decode('utf-8', 'replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise HTTPError("HTTP {}".format(self.status_code))
+
+    def _parse_links(self, link_header):
+        links = {}
+        if not link_header:
+            return links
+
+        for part in link_header.split(','):
+            part = part.strip()
+            if not part.startswith('<'):
+                continue
+            href, _, params = part.partition('>')
+            href = href[1:]
+            rel = None
+            for param in params.split(';'):
+                param = param.strip()
+                if param.startswith('rel='):
+                    rel = param[4:].strip('"')
+                    break
+            if rel:
+                links[rel] = {'url': href}
+        return links
+
+
+def _make_headers(headers):
+    if not headers:
+        return []
+    return ["{}: {}".format(key, value) for key, value in headers.items()]
+
+
+def _perform(url, method='GET', data=None, headers=None, allow_redirects=True, **kwargs):
+    body = io.BytesIO()
+    current_headers = {}
+    link_values = []
+
+    def on_header(line):
+        decoded = line.decode('iso-8859-1').strip()
+        if not decoded:
+            return
+        if decoded.startswith('HTTP/'):
+            return
+        if ':' not in decoded:
+            return
+        name, value = decoded.split(':', 1)
+        name = name.strip().lower()
+        value = value.strip()
+        if name == 'link':
+            link_values.append(value)
+        else:
+            current_headers[name] = value
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1 if allow_redirects else 0)
+        if allow_redirects:
+            curl.setopt(pycurl.MAXREDIRS, kwargs.pop('max_redirects', 10))
+        if 'timeout' in kwargs:
+            curl.setopt(pycurl.TIMEOUT, kwargs.pop('timeout'))
+        if 'connect_timeout' in kwargs:
+            curl.setopt(pycurl.CONNECTTIMEOUT, kwargs.pop('connect_timeout'))
+        if 'useragent' in kwargs:
+            curl.setopt(pycurl.USERAGENT, kwargs.pop('useragent'))
+        if 'user_agent' in kwargs:
+            curl.setopt(pycurl.USERAGENT, kwargs.pop('user_agent'))
+        if 'proxy' in kwargs:
+            curl.setopt(pycurl.PROXY, kwargs.pop('proxy'))
+
+        if headers:
+            curl.setopt(pycurl.HTTPHEADER, _make_headers(headers))
+
+        if method == 'HEAD':
+            curl.setopt(pycurl.NOBODY, 1)
+            curl.setopt(pycurl.CUSTOMREQUEST, 'HEAD')
+        elif method == 'OPTIONS':
+            curl.setopt(pycurl.CUSTOMREQUEST, 'OPTIONS')
+        elif method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            if data is not None:
+                if isinstance(data, str):
+                    data = data.encode('utf-8')
+                curl.setopt(pycurl.POSTFIELDS, data)
+                curl.setopt(pycurl.POSTFIELDSIZE, len(data))
+        else:
+            curl.setopt(pycurl.HTTPGET, 1)
+
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, on_header)
+        curl.perform()
+        current_headers['link'] = ', '.join(link_values) if link_values else current_headers.get('link')
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        effective_url = curl.getinfo(pycurl.EFFECTIVE_URL)
+    finally:
+        curl.close()
+
+    return Response(status_code, current_headers, body.getvalue(), effective_url)
+
+
+def head(url, **kwargs):
+    return _perform(url, method='HEAD', **kwargs)
+
+
+def get(url, **kwargs):
+    return _perform(url, method='GET', **kwargs)
+
+
+def post(url, data=None, **kwargs):
+    return _perform(url, method='POST', data=data, **kwargs)
+
+
+def options(url, **kwargs):
+    return _perform(url, method='OPTIONS', **kwargs)
