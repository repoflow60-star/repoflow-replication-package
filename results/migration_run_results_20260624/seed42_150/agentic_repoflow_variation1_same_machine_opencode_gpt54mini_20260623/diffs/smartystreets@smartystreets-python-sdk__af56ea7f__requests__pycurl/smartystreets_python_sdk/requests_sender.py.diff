+def perform_request(request, max_timeout, proxy_options=None):
+    curl_response = CurlResponse()
+    body_buffer = BytesIO()
+    url = build_url(request.url_prefix, request.parameters)
+
+    if url is None:
+        return build_fallback_response(request)
+
+    def capture_header(header_line):
+        header_text = header_line.decode('iso-8859-1').strip()
+        if not header_text:
+            return len(header_line)
+        if header_text.startswith('HTTP/'):
+            parts = header_text.split(' ', 2)
+            if len(parts) > 1:
+                try:
+                    curl_response.status_code = int(parts[1])
+                except ValueError:
+                    pass
+            return len(header_line)
+
+        key, separator, value = header_text.partition(':')
+        if separator:
+            curl_response.headers[key.strip()] = value.strip()
+        return len(header_line)
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.TIMEOUT, max_timeout)
+        curl.setopt(pycurl.NOSIGNAL, 1)
+        curl.setopt(pycurl.WRITEFUNCTION, body_buffer.write)
+        curl.setopt(pycurl.HEADERFUNCTION, capture_header)
+        curl.setopt(pycurl.HTTPHEADER, [
+            '{}: {}'.format(header, request.headers[header])
+            for header in request.headers
+        ])
+
+        if proxy_options:
+            curl.setopt(pycurl.PROXY, proxy_options['proxy'])
+            if proxy_options.get('proxy_userpwd'):
+                curl.setopt(pycurl.PROXYUSERPWD, proxy_options['proxy_userpwd'])
+            if proxy_options.get('proxy_type'):
+                curl.setopt(pycurl.PROXYTYPE, proxy_options['proxy_type'])
+
+        if request.method == 'POST':
+            payload = request.data
+            if isinstance(payload, str):
+                payload = payload.encode('utf-8')
+            payload = payload or b''
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, payload)
+            curl.setopt(pycurl.POSTFIELDSIZE, len(payload))
+        else:
+            curl.setopt(pycurl.HTTPGET, 1)
+
+        try:
+            curl.perform()
+        except pycurl.error as exc:
+            if exc.args and exc.args[0] == 7:
+                return build_fallback_response(request)
+            raise
+
+        if not curl_response.status_code:
