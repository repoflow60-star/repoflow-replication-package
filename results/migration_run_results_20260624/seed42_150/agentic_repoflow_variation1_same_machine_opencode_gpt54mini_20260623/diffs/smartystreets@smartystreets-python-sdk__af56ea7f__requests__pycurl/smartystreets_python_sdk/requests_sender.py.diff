+def build_url(url_prefix, parameters):
+    if url_prefix is None:
+        return None
+    if not parameters:
+        return url_prefix
+
+    parsed = urlsplit(url_prefix)
+    query_string = urlencode(list(parameters.items()), doseq=True)
+
+    if parsed.query:
+        query = parsed.query + '&' + query_string
+    else:
+        query = query_string
+
+    return urlunsplit((parsed.scheme, parsed.netloc, parsed.path, query, parsed.fragment))
