+class _AiohttpResponse(object):
+
+    def __init__(self, status_code, reason, text, headers, payload):
+        self.status_code = status_code
+        self.status = status_code
+        self.reason = reason or ''
+        self.text = text
+        self.headers = headers
+        self._payload = payload
+
+    def json(self):
+        if self._payload is not None:
+            return self._payload
+        return json.loads(self.text)
+
+
+def _normalize_proxy(proxy):
+    if not proxy:
+        return None
+    if '://' not in proxy:
+        return 'http://' + proxy
+    return proxy
+
+
+def _resolve_proxy(proxies, url):
+    if not proxies:
+        return None
+    if isinstance(proxies, dict):
+        scheme = urlsplit(url).scheme
+        proxy = proxies.get(scheme) or proxies.get('all') or proxies.get('http') or proxies.get('https')
+    else:
+        proxy = proxies
+    return _normalize_proxy(proxy)
+
+
+def _run_sync(coro):
+    try:
+        return asyncio.run(coro)
+    except RuntimeError as exc:
+        if 'asyncio.run() cannot be called from a running event loop' not in str(exc):
+            raise
+
+    result = {}
+    error = {}
+
+    def runner():
+        try:
+            result['value'] = asyncio.run(coro)
+        except Exception as exc:
+            error['value'] = exc
+
+    thread = Thread(target=runner)
+    thread.start()
+    thread.join()
+
+    if error:
+        raise error['value']
+    return result['value']
+
