+def _build_github_table(headers: List[str], rows: List[List]) -> PrettyTable:
+    table = PrettyTable()
+    table.field_names = headers
+    table.align = "l"
+    for row in rows:
+        table.add_row(row)
+    table.set_style(TableStyle.MARKDOWN)
+    return table
+
+
+def _format_rst(headers: List[str], rows: List[List]) -> str:
+    widths = [len(str(header)) + 2 for header in headers]
+    for row in rows:
+        for index, value in enumerate(row):
+            widths[index] = max(widths[index], len(str(value)) + 2)
+
+    separator = "  ".join("=" * width for width in widths)
+
+    def render(values: List[Any]) -> str:
+        return "  ".join(
+            str(value).ljust(widths[index]) for index, value in enumerate(values)
+        ).rstrip()
+
+    lines = [separator, render(headers), separator]
+    for row in rows:
+        lines.append(render(row))
+    lines.append(separator)
+    return "\n".join(lines)
+
+
+def tabulate(rows: List[List], headers: List[str], tablefmt: str = "rst") -> str:
+    if tablefmt == "github":
+        return _build_github_table(headers, rows).get_string()
+
+    if tablefmt == "rst":
+        return _format_rst(headers, rows)
+
+    raise ValueError(f"Unsupported tablefmt provided: {tablefmt}")
 
 
