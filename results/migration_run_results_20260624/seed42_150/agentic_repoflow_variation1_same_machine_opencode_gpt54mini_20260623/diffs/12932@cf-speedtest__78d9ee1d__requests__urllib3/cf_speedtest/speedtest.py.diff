+        return self._response.data
+
+    @property
+    def text(self):
+        return self._response.data.decode('utf-8', errors='replace')
+
+    def raise_for_status(self):
+        if isinstance(self.status, int) and self.status >= 400:
+            raise urllib3.exceptions.HTTPError(f'{self.status} {self.reason}')
