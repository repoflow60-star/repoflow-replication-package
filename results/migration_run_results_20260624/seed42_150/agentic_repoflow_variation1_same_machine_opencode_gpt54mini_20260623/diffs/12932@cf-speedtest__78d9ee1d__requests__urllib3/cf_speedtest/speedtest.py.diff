+def _get_http_manager():
+    global _HTTP_MANAGER, _HTTP_MANAGER_CONFIG
+
+    config = (
+        VERIFY_SSL,
+        tuple(sorted(PROXY_DICT.items())) if PROXY_DICT else None,
+    )
+    if _HTTP_MANAGER is not None and _HTTP_MANAGER_CONFIG == config:
+        return _HTTP_MANAGER
+
+    client_kwargs = {'cert_reqs': ssl.CERT_REQUIRED}
+    if not VERIFY_SSL:
+        client_kwargs['cert_reqs'] = ssl.CERT_NONE
+        client_kwargs['assert_hostname'] = False
+
+    if PROXY_DICT:
+        proxy_url = PROXY_DICT.get('https') or PROXY_DICT.get('http')
+        if proxy_url.startswith('socks'):
+            _HTTP_MANAGER = SOCKSProxyManager(proxy_url, **client_kwargs)
+        else:
+            _HTTP_MANAGER = urllib3.ProxyManager(proxy_url, **client_kwargs)
+    else:
+        _HTTP_MANAGER = urllib3.PoolManager(**client_kwargs)
+
+    _HTTP_MANAGER_CONFIG = config
+    return _HTTP_MANAGER
+
