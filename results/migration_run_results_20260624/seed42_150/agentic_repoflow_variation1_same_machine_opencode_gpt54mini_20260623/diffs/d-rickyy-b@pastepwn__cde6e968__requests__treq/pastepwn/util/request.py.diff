+    @classmethod
+    def _ensure_reactor(cls):
+        if reactor.running or cls._reactor_started:
+            return
+
+        with cls._lock:
+            if reactor.running or cls._reactor_started:
+                return
+
+            thread = Thread(target=cls._run_reactor, name="treq-reactor", daemon=True)
+            thread.start()
+            cls._reactor_started = True
+
+        cls._reactor_ready.wait()
+
+    @staticmethod
+    def _run_reactor():
+        reactor.callWhenRunning(Request._reactor_ready.set)
+        reactor.run(installSignalHandlers=False)
+
+    @staticmethod
+    def _encode_data(data):
+        if isinstance(data, dict):
+            return urlencode(data, doseq=True).encode("utf-8")
+
+        return data
+
+    def _request_async(self, method, url, headers, data, timeout, **kwargs):
+        request_kwargs = dict(kwargs)
+        request_kwargs["headers"] = headers
+
+        if data is not None:
+            request_kwargs["data"] = self._encode_data(data)
+
+        deferred = treq_request(method, url, **request_kwargs)
+        if timeout is not None:
+            deferred = deferred.addTimeout(timeout, reactor)
+
+        deferred.addCallback(treq_content)
+        deferred.addCallback(lambda body: body.decode("utf-8"))
+        return deferred
 
