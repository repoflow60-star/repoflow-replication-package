+def merge_query_params(url, params):
+    """Merge query parameters into a URL."""
+    if not params:
+        return url
+    split = urlsplit(url)
+    query = parse_qsl(split.query, keep_blank_values=True)
+    if hasattr(params, 'items'):
+        query.extend(params.items())
+    else:
+        query.extend(params)
+    return urlunsplit((
+        split.scheme,
+        split.netloc,
+        split.path,
+        urlencode(query, doseq=True),
+        split.fragment,
+    ))
