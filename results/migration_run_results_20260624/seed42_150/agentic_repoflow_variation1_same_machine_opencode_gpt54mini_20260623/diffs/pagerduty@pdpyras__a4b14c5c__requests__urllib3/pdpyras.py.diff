+class Response:
+    """Compatibility wrapper for urllib3 responses."""
+
+    def __init__(self, method, url, status_code, headers, body, elapsed,
+            reason=None, raw=None, request_body=None):
+        self.request = SimpleNamespace(
+            method=method,
+            url=url,
+            headers={},
+            body=body if request_body is None else request_body,
+        )
+        self.status_code = 0 if status_code is None else status_code
+        self.status = self.status_code
+        self.headers = headers or {}
+        self.elapsed = elapsed if isinstance(elapsed, timedelta) else \
+            timedelta(seconds=elapsed or 0)
+        self.reason = reason
+        self.url = url
+        self.raw = raw
+        self._body = body
+
+    @property
+    def ok(self):
+        return bool(self.status_code) and 200 <= self.status_code < 400
+
+    def __bool__(self):
+        return self.ok
+
+    @property
+    def text(self):
+        if isinstance(self._body, (bytes, bytearray, memoryview)):
+            return bytes(self._body).decode('utf-8', errors='replace')
+        if isinstance(self._body, str):
+            return self._body
+        if self.raw is not None:
+            raw_text = getattr(self.raw, 'text', None)
+            if isinstance(raw_text, str):
+                return raw_text
+        return ''
+
+    @property
