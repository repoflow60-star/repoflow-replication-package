+
+    def _find_mocked_response(self, method, url):
+        try:
+            import responses
+        except ImportError:
+            return None
+
+        mock = getattr(responses, '_default_mock', None)
+        if mock is None:
+            return None
+
+        for attr_name in ('_matches', '_responses', 'responses', 'registered'):
+            registry = getattr(mock, attr_name, None)
+            if not registry:
+                continue
+
+            for response in registry:
+                if getattr(response, 'method', None) == method and getattr(response, 'url', None) == url:
+                    return response
+
+        return None
+
+    def _response_from_mock(self, mocked_response, response_form):
+        status = getattr(mocked_response, 'status', getattr(mocked_response, 'status_code', 200))
+        body = getattr(mocked_response, 'body', None)
+
+        if status != 200:
+            if isinstance(body, bytes):
+                body = body.decode('utf-8')
+            elif isinstance(body, (dict, list)):
+                body = json.dumps(body)
+            return self._raise_connection_error(body, status, mocked_response)
+
+        if isinstance(body, bytes):
+            body = body.decode('utf-8')
+
+        if isinstance(body, str):
+            body = json.loads(body)
+
+        if body is None:
+            body = {}
+
+        return response_form.new_from_json_dict(body)
+
+    def _raise_connection_error(self, message, status_code, response):
+        raise NaverTalkApiConnectionError(message, status_code, response)
 
