+    def _plot_margins(
+        self,
+        include_legend: bool,
+        font_size_legend: float,
+        font_size_dimension: float,
+        offset_line_width: float,
+        offset_line_height: float,
+        custom_text_legend: str | None,
+    ) -> tuple[float, float]:
+        """Calculate margins so annotations stay inside the visible domain."""
+        x_margin = max(self.cross_section.width * 0.65, 260.0)
+        y_margin = max(self.cross_section.height * 0.5, 180.0)
+        if include_legend:
+            legend_text = custom_text_legend or self.legend_text()
+            longest_line = max(legend_text.splitlines(), key=len, default="")
+            x_margin = max(x_margin, len(longest_line) * font_size_legend * 0.75)
+        x_margin = max(x_margin, self.cross_section.width * offset_line_height * 0.5)
+        y_margin = max(y_margin, self.cross_section.height * offset_line_width * 0.5)
+        y_margin = max(y_margin, font_size_dimension * 8.0)
+        return x_margin, y_margin
+
