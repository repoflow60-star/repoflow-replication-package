+def _proxy_url(http_proxy):
+    p = urlparse.urlparse(http_proxy)
+    host = p.hostname or ""
+    if ":" in host and not host.startswith("["):
+        host = "[%s]" % (host,)
+    if p.port is not None:
+        host = "%s:%s" % (host, p.port)
+    return "%s://%s" % (p.scheme, host)
+
+
+def _proxy_basic_auth_headers(auth):
+    token = base64.b64encode(auth.encode("utf-8")).decode("ascii")
+    return {"proxy-authorization": "Basic %s" % (token,)}
+
+
+def _proxy_headers(http_proxy):
+    p = urlparse.urlparse(http_proxy)
+    if p.username is None:
+        return {}
+    auth = "%s:%s" % (
+        urlparse.unquote(p.username),
+        urlparse.unquote(p.password or ""),
+    )
+    return _proxy_basic_auth_headers(auth)
+
+
+def _make_headers(proxy_basic_auth=None):
+    if proxy_basic_auth is None:
+        return {}
+    return _proxy_basic_auth_headers(proxy_basic_auth)
+
+
+def _body_for_aiohttp(body):
+    if hasattr(body, "read"):
+        body = body.read()
+    if isinstance(body, array):
+        return body.tobytes()
+    if isinstance(body, (bytearray, memoryview)):
+        return bytes(body)
+    return body
+
+
+def _request_timeout(timeout):
+    if isinstance(timeout, aiohttp.ClientTimeout):
+        return timeout
+    return aiohttp.ClientTimeout(total=timeout)
