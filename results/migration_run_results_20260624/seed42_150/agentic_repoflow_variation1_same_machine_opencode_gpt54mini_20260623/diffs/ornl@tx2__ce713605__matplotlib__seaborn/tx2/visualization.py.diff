+def _cloud_to_image(cloud):
+    return cloud.to_image()
+
+
+def _wordcloud_grid_image(clusters: Dict[str, List[int]]):
+    num_cols = 4
+    cloud_images = [(_cloud_to_image(_cached_wordclouds[cluster]), cluster) for cluster in clusters]
+
+    if not cloud_images:
+        return Image.new("RGB", (1, 1), "white")
+
+    cell_width = max(image.width for image, _ in cloud_images)
+    cell_height = max(image.height for image, _ in cloud_images) + 28
+    num_rows = max(math.ceil(len(cloud_images) / num_cols), 2)
+    canvas = Image.new("RGB", (cell_width * num_cols, cell_height * num_rows), "white")
+    draw = ImageDraw.Draw(canvas)
+    font = ImageFont.load_default()
+
+    for index, (image, cluster) in enumerate(cloud_images):
+        row = index // num_cols
+        col = index % num_cols
+        x = col * cell_width
+        y = row * cell_height
+        draw.text((x + 4, y + 4), str(cluster), fill="black", font=font)
+        canvas.paste(image, (x, y + 20))
+
+    return canvas
+
