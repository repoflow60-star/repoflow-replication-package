 import os
 from os.path import dirname, join
 
-from dotenv import load_dotenv
+from dynaconf import Dynaconf
+
+
+def _load_env_file(dotenv_path: str) -> None:
+    """Load repo-local env vars through Dynaconf."""
+    settings = Dynaconf(
+        envvar_prefix=False,
+        load_dotenv=True,
+        dotenv_path=dotenv_path,
+    )
+    for env_var_name in (
+        "ORGANIZATION",
+        "REPOSITORY",
+        "GH_APP_ID",
+        "GH_APP_INSTALLATION_ID",
+        "GH_APP_PRIVATE_KEY",
+        "GITHUB_APP_ENTERPRISE_ONLY",
+        "GH_TOKEN",
+        "GH_ENTERPRISE_URL",
+        "EXEMPT_REPOS",
+        "DRY_RUN",
+        "TITLE",
+        "BODY",
+        "COMMIT_MESSAGE",
+        "ISSUE_REPORT",
+    ):
+        env_var_value = settings.get(env_var_name)
+        if env_var_value is None or env_var_name in os.environ:
+            continue
+        if isinstance(env_var_value, (list, tuple)):
+            os.environ[env_var_name] = ",".join(str(item) for item in env_var_value)
+        else:
+            os.environ[env_var_name] = str(env_var_value)
 
 
 def get_bool_env_var(env_var_name: str, default: bool = False) -> bool:
