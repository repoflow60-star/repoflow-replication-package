+_treq_reactor_lock = threading.Lock()
+_treq_reactor_started = threading.Event()
+
+
+class _TreqResponse:
+    def __init__(self, status_code, body):
+        self.status_code = status_code
+        self._body = body
+
+    def json(self):
+        return self._body
+
+
+class _TreqRequests:
+    def _request(self, request_func, url, **kwargs):
+        _ensure_treq_reactor()
+
+        def request_in_reactor():
+            def build_response(response):
+                if response.code != 200:
+                    return _TreqResponse(response.code, None)
+                return treq.json_content(response).addCallback(
+                    lambda body: _TreqResponse(response.code, body))
+
+            return request_func(url, **kwargs).addCallback(build_response)
+
+        return blockingCallFromThread(reactor, request_in_reactor)
+
+    def post(self, url, **kwargs):
+        return self._request(treq.post, url, **kwargs)
+
+    def get(self, url, **kwargs):
+        return self._request(treq.get, url, **kwargs)
+
+
+requests = _TreqRequests()
+
+
+def _run_treq_reactor():
+    reactor.callWhenRunning(_treq_reactor_started.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_treq_reactor():
+    if reactor.running or _treq_reactor_started.is_set():
+        return
+    with _treq_reactor_lock:
+        if reactor.running or _treq_reactor_started.is_set():
+            return
+        threading.Thread(target=_run_treq_reactor, daemon=True).start()
+    _treq_reactor_started.wait()
+
+
+def _json_request(method, url, **kwargs):
+    response = getattr(requests, method)(url, **kwargs)
+    if response.status_code != 200:
+        return response.status_code, None
+    return response.status_code, response.json()
 
 
