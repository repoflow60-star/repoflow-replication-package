+def _cerberus_rule(schema: Dict, resolver: RefResolver, seen=None) -> Dict:
+    schema = _resolve_schema(schema, resolver)
+    seen = set() if seen is None else seen
+    schema_id = id(schema)
+
+    rule = {}
+    schema_type = schema.get("type")
+    if schema_type == "object":
+        rule["type"] = "dict"
+        rule["allow_unknown"] = True
+
+        if schema_id not in seen:
+            nested_schema = {}
+            required = set(schema.get("required", []))
+            for key, property_schema in schema.get("properties", {}).items():
+                nested_rule = _cerberus_rule(property_schema, resolver, seen | {schema_id})
+                if key in required:
+                    nested_rule["required"] = True
+                nested_schema[key] = nested_rule
+            if nested_schema:
+                rule["schema"] = nested_schema
+    elif schema_type == "array":
+        rule["type"] = "list"
+        if schema_id not in seen and schema.get("items"):
+            rule["schema"] = _cerberus_rule(schema["items"], resolver, seen | {schema_id})
+    elif schema_type:
+        rule["type"] = schema_type
+
+    if "maxLength" in schema:
+        rule["maxlength"] = schema["maxLength"]
+
+    return rule
 
 
