+        self.params: dict[str, object] | None = None
+        self.json: object | None = None
+
+    @property
+    def path_url(self) -> str:
+        if not self.url:
+            return ""
+        split_url = urlsplit(self.url)
+        if split_url.query:
+            return f"{split_url.path}?{split_url.query}"
+        return split_url.path
+
+    def prepare(self):
+        return self
+
+    def __eq__(self, other: object) -> bool:
+        return (
+            getattr(other, "method", None) == self.method
