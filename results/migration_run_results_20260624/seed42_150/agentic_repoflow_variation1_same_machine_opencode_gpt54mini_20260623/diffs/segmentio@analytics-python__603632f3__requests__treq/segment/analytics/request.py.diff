+        result = _session.post(url, data=data, headers=headers)
+        if timeout is not None and isinstance(result, Deferred):
+            result.addTimeout(timeout, reactor)
+        if isinstance(result, Deferred):
+            def _with_body(response):
+                body = treq.content(response)
+                if isinstance(body, Deferred):
+                    body.addCallback(lambda content: _Response(response, content))
+                    return body
+                return _Response(response, body)
+
+            result.addCallback(_with_body)
+            return result
+        return result
+
+    try:
+        return blockingCallFromThread(reactor, _call)
+    except (CancelledError, DeferredTimeoutError, ResponseNeverReceived) as e:
