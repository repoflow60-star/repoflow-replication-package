--- a/ash_model/viz/_plotly_axes.py
+++ b/ash_model/viz/_plotly_axes.py
@@ -0,0 +1,55 @@
+from types import SimpleNamespace
+
+import plotly.graph_objects as go
+
+
+class Axes(go.Figure):
+    def plot(self, x, y=None, fmt=None, label=None, alpha=None, **kwargs):
+        if y is None:
+            y = x
+            x = list(range(len(y)))
+
+        mode = kwargs.pop("mode", None)
+        if mode is None:
+            mode = "markers" if fmt and "." in fmt else "lines"
+
+        trace_kwargs = {}
+        if label is not None:
+            trace_kwargs["name"] = label
+        if alpha is not None:
+            trace_kwargs["opacity"] = alpha
+
+        color = kwargs.pop("color", None)
+        if color is not None:
+            trace_kwargs["marker" if mode == "markers" else "line"] = {"color": color}
+
+        self.add_trace(go.Scatter(x=list(x), y=list(y), mode=mode, **trace_kwargs))
+        return self
+
+    def bar(self, x, y, alpha=None, **kwargs):
+        trace_kwargs = {}
+        if alpha is not None:
+            trace_kwargs["opacity"] = alpha
+
+        color = kwargs.pop("color", None)
+        if color is not None:
+            trace_kwargs["marker"] = {"color": color}
+
+        self.add_trace(go.Bar(x=list(x), y=list(y), **trace_kwargs))
+        return self
+
+    def loglog(self):
+        self.update_xaxes(type="log")
+        self.update_yaxes(type="log")
+        return self
+
+    def legend(self):
+        self.update_layout(showlegend=True)
+        return self
+
+    def set_xlim(self, limits):
+        self.update_xaxes(range=list(limits))
+        return self
+
+
+plt = SimpleNamespace(Axes=Axes, gca=lambda: Axes(), figure=lambda: Axes())
