+def _status_value(response):
+    status = getattr(response, "status_code", None)
+    if not isinstance(status, (int, str)):
+        status = getattr(response, "status", None)
+    return status if isinstance(status, (int, str)) else None
+
+
+def _status_code(response):
+    status = _status_value(response)
+    if isinstance(status, str):
+        try:
+            return int(status)
+        except ValueError:
+            return None
+    return status
+
+
+def _response_text(response):
+    data = getattr(response, "data", None)
+    if isinstance(data, bytes):
+        return data.decode("utf-8", errors="replace")
+    if data is not None:
+        return data
+    text = getattr(response, "text", "")
+    return text or ""
+
+
+class _CompatHTTPError(Exception):
+    def __init__(self, message=None, response=None):
+        super().__init__(message)
+        self.response = response
+
+
+class _CompatConnectionError(Exception):
+    pass
+
+
+class _CompatTimeout(Exception):
+    pass
+
+
+class _CompatResponse:
+    def __init__(self, response):
+        self._response = response
+
+    @property
+    def data(self):
+        return getattr(self._response, "data", None)
+
+    @property
+    def text(self):
+        return _response_text(self._response)
+
+    @property
+    def status_code(self):
+        return _status_value(self._response)
+
+    @property
+    def ok(self):
+        status = _status_code(self._response)
+        return status is not None and status < 400
+
+    def json(self):
+        return json_module.loads(self.text)
+
+    def raise_for_status(self):
+        status = _status_code(self._response)
+        if status is not None and status >= 400:
+            raise _CompatHTTPError(response=self)
+
+
+class _CompatSession:
+    def __init__(self, headers=None, verify=True, cert=None):
+        self.headers = headers or {}
+        self.verify = verify
+        self.cert = cert
+
+    def _pool_manager(self):
+        pool_kwargs = {
+            "cert_reqs": ssl.CERT_REQUIRED if self.verify else ssl.CERT_NONE,
+        }
+        if self.cert:
+            if isinstance(self.cert, tuple):
+                pool_kwargs["cert_file"] = self.cert[0]
+                pool_kwargs["key_file"] = self.cert[1]
+            else:
+                pool_kwargs["cert_file"] = self.cert
+        return urllib3.PoolManager(**pool_kwargs)
+
+    @staticmethod
+    def _build_url(url, params):
+        if not params:
+            return url
+        query_string = urlencode(params, doseq=True)
+        if not query_string:
+            return url
+        separator = "&" if "?" in url else "?"
+        return f"{url}{separator}{query_string}"
+
+    def request(self, method, url, params=None, json=None, fields=None, headers=None):
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+        request_kwargs = {"headers": request_headers}
+        request_url = self._build_url(url, params)
+        if fields is not None:
+            request_kwargs["fields"] = fields
+        if json is not None:
+            request_kwargs["headers"] = dict(request_headers)
+            request_kwargs["headers"]["Content-Type"] = "application/json"
+            request_kwargs["body"] = json_module.dumps(json).encode("utf-8")
+        try:
+            response = self._pool_manager().request(method, request_url, **request_kwargs)
+        except urllib3.exceptions.TimeoutError as exc:
+            raise _CompatTimeout(str(exc)) from None
+        except urllib3.exceptions.HTTPError as exc:
+            raise _CompatConnectionError(str(exc)) from None
+        return _CompatResponse(response)
+
+    def get(self, url, params=None):
+        return self.request("GET", url, params=params)
+
+    def post(self, url, params=None, json=None):
+        return self.request("POST", url, params=params, json=json)
+
+    def put(self, url, params=None, json=None, files=None):
+        if files is not None:
+            return self.request("PUT", url, params=params, fields=files)
+        return self.request("PUT", url, params=params, json=json)
+
+    def delete(self, url, params=None):
+        return self.request("DELETE", url, params=params)
+
+
+def _compat_get(url, headers=None, verify=True, cert=None, params=None):
+    return _CompatSession(headers=headers, verify=verify, cert=cert).get(url, params=params)
+
+
+def _compat_post(url, headers=None, verify=True, cert=None, params=None, json=None):
+    return _CompatSession(headers=headers, verify=verify, cert=cert).post(url, params=params, json=json)
+
+
+def _compat_put(url, headers=None, verify=True, cert=None, params=None, json=None, files=None):
+    return _CompatSession(headers=headers, verify=verify, cert=cert).put(url, params=params, json=json, files=files)
+
+
+def _compat_delete(url, headers=None, verify=True, cert=None, params=None):
+    return _CompatSession(headers=headers, verify=verify, cert=cert).delete(url, params=params)
+
+
+_requests_compat = SimpleNamespace(
+    Session=_CompatSession,
+    get=_compat_get,
+    post=_compat_post,
+    put=_compat_put,
+    delete=_compat_delete,
+    HTTPError=_CompatHTTPError,
+    ConnectionError=_CompatConnectionError,
+    Timeout=_CompatTimeout,
+    exceptions=SimpleNamespace(
+        HTTPError=_CompatHTTPError,
+        ConnectionError=_CompatConnectionError,
+        Timeout=_CompatTimeout,
+        ),
+)
+
+requests = _requests_compat
 
 
