+class CookieJarDict(dict):
+    def get_dict(self):
+        return dict(self)
+
+
+class PycurlResponse:
+    def __init__(self, status_code: int, body: bytes, headers: Dict[str, str]) -> None:
+        self.status_code = status_code
+        self.content = body
+        self.headers = headers
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status_code < 400
+
+    @property
+    def text(self) -> str:
+        return self.content.decode("utf-8", errors="replace")
+
+    def json(self):
+        try:
+            return json.loads(self.text)
+        except json.JSONDecodeError:
+            return {}
+
+    def __str__(self) -> str:
+        return f"<Response [{self.status_code}]>"
+
+
+class PycurlSession:
+    def __init__(self) -> None:
+        self.headers = {}
+        self.cookies = CookieJarDict()
+        self._cookie_lock = threading.Lock()
+
+    @staticmethod
+    def _parse_headers(raw_headers: bytes) -> Dict[str, str]:
+        headers: Dict[str, str] = {}
+        for line in raw_headers.decode("iso-8859-1", errors="replace").splitlines():
+            if not line or line.startswith("HTTP/"):
+                continue
+            if ":" not in line:
+                continue
+            key, value = line.split(":", 1)
+            headers[key.strip().lower()] = value.strip()
+        return headers
+
+    def _store_cookies(self, raw_headers: bytes) -> None:
+        cookie = SimpleCookie()
+        for line in raw_headers.decode("iso-8859-1", errors="replace").splitlines():
+            if line.lower().startswith("set-cookie:"):
+                cookie.load(line.split(":", 1)[1].strip())
+        if cookie:
+            with self._cookie_lock:
+                for key, morsel in cookie.items():
+                    self.cookies[key] = morsel.value
+
+    def get(self, url: str, params=None, headers=None):
+        return self._request("GET", url, params=params, headers=headers)
+
+    def post(self, url: str, data=None, params=None, headers=None, json=None):
+        return self._request(
+            "POST", url, data=data, params=params, headers=headers, json_data=json
+        )
+
+    def _request(self, method, url, data=None, params=None, headers=None, json_data=None):
+        if params:
+            query = urlencode(params, doseq=True)
+            parts = list(urlsplit(url))
+            parts[3] = f"{parts[3]}&{query}" if parts[3] else query
+            url = urlunsplit(parts)
+
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+        with self._cookie_lock:
+            if self.cookies:
+                request_headers.setdefault(
+                    "Cookie",
+                    "; ".join(f"{key}={value}" for key, value in self.cookies.items()),
+                )
+
+        if json_data is not None:
+            data = json.dumps(json_data).encode("utf-8")
+            request_headers.setdefault("Content-Type", "application/json")
+
+        if data is not None and isinstance(data, str):
+            data = data.encode("utf-8")
+
+        body_buffer = io.BytesIO()
+        header_buffer = io.BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url.encode("utf-8"))
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.MAXREDIRS, 5)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            curl.setopt(pycurl.ACCEPT_ENCODING, "")
+            curl.setopt(pycurl.WRITEFUNCTION, body_buffer.write)
+            curl.setopt(pycurl.HEADERFUNCTION, header_buffer.write)
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                [f"{key}: {value}" for key, value in request_headers.items()],
+            )
+            if method == "POST":
+                curl.setopt(pycurl.POST, 1)
+                if data is not None:
+                    curl.setopt(pycurl.POSTFIELDS, data)
+                    curl.setopt(pycurl.POSTFIELDSIZE, len(data))
+            else:
+                curl.setopt(pycurl.HTTPGET, 1)
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            raw_headers = header_buffer.getvalue()
+            self._store_cookies(raw_headers)
+            return PycurlResponse(
+                status_code,
+                body_buffer.getvalue(),
+                self._parse_headers(raw_headers),
+            )
+        finally:
+            curl.close()
+
+
