+def _normalize_headers(headers) -> dict:
+    normalized = {}
+    if hasattr(headers, "getAllRawHeaders"):
+        for name, values in headers.getAllRawHeaders():
+            key = name.decode("latin1").lower() if isinstance(name, bytes) else str(name).lower()
+            normalized[key] = ", ".join(
+                value.decode("latin1") if isinstance(value, bytes) else str(value)
+                for value in values
