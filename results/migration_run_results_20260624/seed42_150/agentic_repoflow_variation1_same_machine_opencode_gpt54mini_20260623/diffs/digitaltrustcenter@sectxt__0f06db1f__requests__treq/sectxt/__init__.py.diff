+def _ensure_treq_reactor() -> None:
+    global _TREQ_REACTOR_STARTED
+    if reactor.running or _TREQ_REACTOR_STARTED:
+        return
+    with _TREQ_REACTOR_LOCK:
+        if reactor.running or _TREQ_REACTOR_STARTED:
+            return
+
+        def _run() -> None:
+            reactor.callWhenRunning(_TREQ_REACTOR_READY.set)
+            reactor.run(installSignalHandlers=False)
