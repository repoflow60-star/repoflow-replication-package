+def _refresh_session() -> None:
+    global REQ_SESSION, SESSION_PROXY_URL, SESSION_VERIFY_SSL
+
+    if not isinstance(REQ_SESSION, httpx.Client):
+        return
+
+    proxy_url = PROXY_DICT['https'] if PROXY_DICT else None
+    if proxy_url == SESSION_PROXY_URL and VERIFY_SSL == SESSION_VERIFY_SSL:
+        return
+
+    REQ_SESSION.close()
+    # Keep SOCKS proxies from forcing the optional httpx socks extra at runtime.
+    if proxy_url and not proxy_url.startswith('socks'):
+        REQ_SESSION = httpx.Client(verify=VERIFY_SSL, proxy=proxy_url)
+    else:
+        REQ_SESSION = httpx.Client(verify=VERIFY_SSL)
+    SESSION_PROXY_URL = proxy_url
+    SESSION_VERIFY_SSL = VERIFY_SSL
