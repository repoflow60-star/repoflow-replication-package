--- a/yarg/http.py
+++ b/yarg/http.py
@@ -0,0 +1,35 @@
+# -*- coding: utf-8 -*-
+
+from twisted.internet import reactor
+
+import treq
+
+
+def _wait(deferred):
+    if not hasattr(deferred, 'addCallbacks'):
+        return deferred
+
+    result = []
+    failure = []
+
+    def _store(value):
+        result.append(value)
+
+    def _store_failure(err):
+        failure.append(err)
+
+    deferred.addCallbacks(_store, _store_failure)
+    # Keep the public API synchronous while waiting for treq's Deferred.
+    while not result and not failure:
+        reactor.iterate(0.01)
+    if failure:
+        failure[0].raiseException()
+    return result[0]
+
+
+def request(url):
+    response = _wait(treq.get(url))
+    content = getattr(response, 'content', None)
+    if content is None or callable(content):
+        content = _wait(treq.content(response))
+    return response, content
