+class _Urllib3Session(object):
+    def __init__(self):
+        self._pool = PoolManager()
+
+    def mount(self, retry):
+        self._pool = PoolManager(retries=retry)
+
+    def _request(self, method, url, params=None, data=None, timeout=None, headers=None, auth=None):
+        request_headers = {key: value for key, value in (headers or {}).items() if value is not None}
+        if auth:
+            request_headers.update(make_headers(basic_auth='{}:{}'.format(*auth)))
+
+        request_kwargs = {'headers': request_headers, 'timeout': timeout}
+        if params is not None:
+            request_kwargs['fields'] = {key: value for key, value in params.items() if value is not None}
+        if data is not None:
+            if isinstance(data, str):
+                data = data.encode('utf-8')
+            request_kwargs['body'] = data
+
+        response = self._pool.request(method, url, **request_kwargs)
+        return _Response(response)
+
+    def get(self, url, params=None, timeout=None, headers=None, auth=None):
+        return self._request('GET', url, params=params, timeout=timeout, headers=headers, auth=auth)
+
