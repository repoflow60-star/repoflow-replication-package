+def _parse_env_file_line(line: str) -> Optional[tuple]:
+    """
+    Parses a single environment file line.
+    """
+
+    stripped_line = line.strip()
+
+    if not stripped_line or stripped_line.startswith("#"):
+        return None
+
+    if stripped_line.startswith("export "):
+        stripped_line = stripped_line[len("export ") :].lstrip()
+
+    if "=" not in stripped_line:
+        return None
+
+    key, raw_value = stripped_line.split("=", 1)
+    key = key.strip()
+
+    if not key:
+        return None
+
+    value = raw_value.strip()
+
+    if value.startswith('"') and value.endswith('"') and len(value) >= 2:
+        value = value[1:-1].replace(r'\\', "\\").replace(r'\"', '"')
+    elif value.startswith("'") and value.endswith("'") and len(value) >= 2:
+        value = value[1:-1]
+    elif "#" in value:
+        value = value.split("#", 1)[0].rstrip()
+
+    return key, value
+
+
+def _format_env_file_value(value: str) -> str:
+    """
+    Formats a value for environment file storage.
+    """
+
+    if not value or any(char.isspace() for char in value) or "#" in value or "=" in value:
+        escaped = value.replace("\\", r"\\").replace('"', r'\"')
+        return f'"{escaped}"'
+
+    return value
+
+
+def _get_env_file_value(env_file_path: str, name: str) -> Optional[str]:
+    """
+    Returns the value of the given variable from the given environment file.
+    """
+
+    if not os.path.isfile(env_file_path):
+        return None
+
+    with open(env_file_path, "r", encoding="utf-8") as file_stream:
+        for line in file_stream:
+            parsed_line = _parse_env_file_line(line)
+
+            if parsed_line and parsed_line[0] == name:
+                return parsed_line[1]
+
+    return None
+
+
+def _write_env_file_value(env_file_path: str, name: str, value: str) -> None:
+    """
+    Writes the given variable into the given environment file.
+    """
+
+    file_lines = []
+
+    if os.path.isfile(env_file_path):
+        with open(env_file_path, "r", encoding="utf-8") as file_stream:
+            file_lines = file_stream.readlines()
+
+        if file_lines and not file_lines[-1].endswith("\n"):
+            file_lines[-1] = f"{file_lines[-1]}\n"
+
+    replacement_line = f"{name}={_format_env_file_value(value)}\n"
+    updated_lines = []
+    entry_updated = False
+
+    for line in file_lines:
+        parsed_line = _parse_env_file_line(line)
+
+        if parsed_line and parsed_line[0] == name:
+            if not entry_updated:
+                updated_lines.append(replacement_line)
+                entry_updated = True
+
+            continue
+
+        updated_lines.append(line)
+
+    if not entry_updated:
+        updated_lines.append(replacement_line)
+
+    with open(env_file_path, "w", encoding="utf-8") as file_stream:
+        file_stream.writelines(updated_lines)
+
+
+def _unset_env_file_value(env_file_path: str, name: str) -> None:
+    """
+    Deletes the given variable from the given environment file.
+    """
+
+    if not os.path.isfile(env_file_path):
+        return
+
+    with open(env_file_path, "r", encoding="utf-8") as file_stream:
+        file_lines = file_stream.readlines()
+
+    updated_lines = []
+
+    for line in file_lines:
+        parsed_line = _parse_env_file_line(line)
+
+        if parsed_line and parsed_line[0] == name:
+            continue
+
+        updated_lines.append(line)
+
+    with open(env_file_path, "w", encoding="utf-8") as file_stream:
+        file_stream.writelines(updated_lines)
 
 
