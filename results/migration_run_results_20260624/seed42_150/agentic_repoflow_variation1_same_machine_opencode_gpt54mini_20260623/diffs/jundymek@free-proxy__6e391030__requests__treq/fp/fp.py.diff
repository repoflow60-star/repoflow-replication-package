+    @inlineCallbacks
+    def __get(self, url, timeout=None, proxy_url=None):
+        if proxy_url is None:
+            proxy_url = self.__proxy_url_for(url)
+        if proxy_url:
+            agent = ProxyAgent(reactor, URI.fromBytes(proxy_url.encode('ascii')))
+            client = HTTPClient(agent=agent)
+            response = yield client.get(url, timeout=timeout)
+        else:
+            response = yield treq.get(url, timeout=timeout)
+        page = yield treq.content(response)
+        returnValue(page)
+
+    def __proxy_url_for(self, url):
+        scheme = 'https' if url.startswith('https://') else 'http'
+        proxies = getproxies()
+        return proxies.get(scheme) or proxies.get('https') or proxies.get('http') or proxies.get('all')
+
+    def __run(self, func, *args, **kwargs):
+        return blockingCallFromThread(reactor, func, *args, **kwargs)
