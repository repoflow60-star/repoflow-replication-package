-import requests
+import threading
+
+from twisted.internet import reactor
+
+import treq
+
 from nyaapy import torrent
 from nyaapy.parser import parse_nyaa, parse_single, parse_nyaa_rss
+
+
+_REACTOR_READY = threading.Event()
+
+
+def _reactor_worker():
+    reactor.callWhenRunning(_REACTOR_READY.set)
+    reactor.run(installSignalHandlers=False)
+
+
+if not reactor.running:
+    _REACTOR_THREAD = threading.Thread(target=_reactor_worker, daemon=True)
+    _REACTOR_THREAD.start()
+    _REACTOR_READY.wait()
+
+
+def _run_request(url):
+    finished = threading.Event()
+    outcome = {}
+
+    def _issue_request():
+        def _store_result(value):
+            outcome["value"] = value
+            finished.set()
+            return value
+
+        def _store_error(failure):
+            outcome["error"] = failure.value
+            finished.set()
+
+        try:
+            deferred = treq.get(url)
+
+            def _handle_response(response):
+                if response.code >= 400:
+                    raise RuntimeError(
+                        f"HTTP {response.code} while requesting {url}"
+                    )
+                return treq.content(response)
+
+            deferred.addCallback(_handle_response)
+            deferred.addCallbacks(_store_result, _store_error)
+        except Exception as exc:
+            outcome["error"] = exc
+            finished.set()
+
+    reactor.callFromThread(_issue_request)
+    finished.wait()
+
+    if "error" in outcome:
+        raise outcome["error"]
+
+    return outcome["value"]
+
+
+def _get_content(url):
+    return _run_request(url)
 
 
