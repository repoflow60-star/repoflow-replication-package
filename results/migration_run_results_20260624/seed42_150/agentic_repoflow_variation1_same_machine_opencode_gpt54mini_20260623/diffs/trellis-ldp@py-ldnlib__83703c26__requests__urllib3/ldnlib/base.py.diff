     def __init__(self, **kwargs):
         self.accept_headers = kwargs.get('accept_headers', self.ACCEPT_HEADERS)
+        self.http = kwargs.get('http') or urllib3.PoolManager()
+
+    def _request(self, method, target, raise_for_status=True, **kwargs):
+        allow_redirects = kwargs.pop('allow_redirects', None)
+        if allow_redirects is None:
+            redirect = method.upper() == 'GET'
+        else:
+            redirect = allow_redirects
+        kwargs.setdefault('redirect', redirect)
+
+        auth = kwargs.pop('auth', None)
+        if auth is not None:
+            headers = kwargs.setdefault('headers', {})
+            headers.update(make_headers(basic_auth='{}:{}'.format(*auth)))
+
+        data = kwargs.pop('data', None)
+        if data is not None and 'body' not in kwargs:
+            kwargs['body'] = data
+
+        response = self.http.request(method, target, **kwargs)
+        if raise_for_status:
+            self._raise_for_status(response)
+        return response
+
+    def _raise_for_status(self, response):
+        status = getattr(response, 'status', getattr(response, 'status_code', None))
+        if status is not None and status >= 400:
+            raise HTTPError('{} {}'.format(status, getattr(response, 'reason', '')))
+
+    def _response_text(self, response):
+        text = getattr(response, 'text', None)
+        if isinstance(text, str):
+            return text
+
+        data = getattr(response, 'data', b'')
+        if isinstance(data, bytes):
+            return data.decode('utf-8', errors='replace')
+        return str(data)
+
+    def _response_json(self, response):
+        response_json = getattr(response, 'json', None)
+        if callable(response_json):
+            return response_json()
+        return json.loads(self._response_text(response))
+
+    def _link_url_for(self, response, relation):
+        links = getattr(response, 'links', None)
+        if isinstance(links, dict) and relation in links:
+            return links[relation].get('url')
+
+        headers = getattr(response, 'headers', {}) or {}
+        link_header = headers.get('link') or headers.get('Link')
+        if not link_header:
+            return None
+
+        for link_value in link_header.split(','):
+            parts = [part.strip() for part in link_value.split(';')]
+            if not parts:
+                continue
+
+            url = parts[0]
+            if url.startswith('<') and url.endswith('>'):
+                url = url[1:-1]
+
+            for part in parts[1:]:
+                if not part.startswith('rel='):
+                    continue
+                rels = part.split('=', 1)[1].strip('"').split()
+                if relation in rels:
+                    return url
 
