+import urllib3
+from urllib3.util import Retry
 
 logger = logging.getLogger(__name__)
+
+_HTTP_RETRIES = Retry(total=None, connect=0, read=0, redirect=3, status=0, other=0)
+
+
+def _http_request(method, url, input_options=None, **kwargs):
+    cert_reqs = ssl.CERT_REQUIRED
+    timeout = None
+    if input_options is not None:
+        cert_reqs = ssl.CERT_REQUIRED if input_options.verify_ssl else ssl.CERT_NONE
+        timeout = input_options.timeout
+
+    manager = urllib3.PoolManager(cert_reqs=cert_reqs)
+    if timeout is not None and 'timeout' not in kwargs:
+        kwargs['timeout'] = timeout
+    kwargs.setdefault('retries', _HTTP_RETRIES)
+    try:
+        return manager.request(method, url, **kwargs)
+    except Exception as e:
+        raise HXLIOException(str(e), url=url) from e
+
+
+def _response_json(response):
+    return json.loads(response.data.decode('utf-8'))
+
+
+def _response_raise_for_status(response, url=None):
+    if response.status >= 400:
+        raise HXLIOException("HTTP error {}".format(response.status), url=url)
+
+
+def _response_is_redirect(response):
+    return 300 <= response.status < 400 and bool(response.headers.get('location'))
+
+
+def _form_headers(headers):
+    result = dict(headers or {})
+    if not any(key.lower() == 'content-type' for key in result):
+        result['Content-Type'] = 'application/x-www-form-urlencoded'
+    return result
 
