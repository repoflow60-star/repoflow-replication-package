+class _PycurlResponse(object):
+    """Minimal response object for pycurl-backed HTTP calls."""
+
+    def __init__(self, url, status_code, headers, content):
+        self.url = url
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+
+    @property
+    def is_redirect(self):
+        return self.status_code in (301, 302, 303, 307, 308) and ('location' in self.headers)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise HXLIOException("HTTP error {} for {}".format(self.status_code, self.url), url=self.url)
+
+    def json(self):
+        content_type = self.headers.get('content-type', '')
+        result = re.match(r'^\S+\s*;\s*charset=(\S+)$', content_type)
+        encoding = result.group(1) if result else 'utf-8'
+        return json.loads(self.content.decode(encoding, errors='replace'))
+
+
+def _curl_request(url, method='GET', verify_ssl=True, headers=None, timeout=None, params=None, data=None, follow_redirects=True):
+    """Perform a single HTTP request using pycurl."""
+
+    if params:
+        query = urllib.parse.urlencode(params, doseq=True)
+        parts = urllib.parse.urlsplit(url)
+        if parts.query:
+            query = parts.query + '&' + query
+        url = urllib.parse.urlunsplit((parts.scheme, parts.netloc, parts.path, query, parts.fragment))
+
+    content = io.BytesIO()
+    response_headers = {}
+
+    def _header_callback(line):
+        text = line.decode('iso-8859-1').strip()
+        if not text:
+            return len(line)
+        if text.startswith('HTTP/'):
+            response_headers.clear()
+            return len(line)
+        key, sep, value = text.partition(':')
+        if sep:
+            response_headers[key.strip().lower()] = value.strip()
+        return len(line)
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEFUNCTION, content.write)
+        curl.setopt(pycurl.HEADERFUNCTION, _header_callback)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1 if follow_redirects else 0)
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT, timeout)
+        if not verify_ssl:
+            curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+            curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+        if headers:
+            curl.setopt(pycurl.HTTPHEADER, ['{}: {}'.format(name, value) for (name, value) in headers.items()])
+        if method == 'HEAD':
+            curl.setopt(pycurl.NOBODY, 1)
+        elif method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            if data is not None:
+                curl.setopt(pycurl.POSTFIELDS, urllib.parse.urlencode(data))
+        else:
+            curl.setopt(pycurl.HTTPGET, 1)
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        effective_url = curl.getinfo(pycurl.EFFECTIVE_URL)
+    except pycurl.error as e:
+        raise HXLIOException("Cannot open URL {} ({})".format(url, str(e)), url=url)
+    finally:
+        curl.close()
+
+    return _PycurlResponse(effective_url or url, status_code, response_headers, content.getvalue())
 
 
