+    def _make_post_request(request_url: str, data: dict, **kwargs):
+        headers = kwargs.pop('headers', None) or {}
+        timeout = kwargs.pop('timeout', 10)
+        allow_redirects = kwargs.pop('allow_redirects', True)
+        verify = kwargs.pop('verify', True)
+
+        response_body = io.BytesIO()
+        payload = json.dumps(data).encode('utf-8')
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, request_url)
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, payload)
+            curl.setopt(pycurl.POSTFIELDSIZE, len(payload))
+            curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+
+            if timeout is not None:
+                curl.setopt(pycurl.TIMEOUT_MS, int(timeout * 1000))
+            curl.setopt(pycurl.FOLLOWLOCATION, 1 if allow_redirects else 0)
+
+            parsed_url = urlparse(request_url)
+            if parsed_url.scheme == 'https':
+                if isinstance(verify, str):
+                    curl.setopt(pycurl.CAINFO, verify)
+                else:
+                    curl.setopt(pycurl.SSL_VERIFYPEER, 1 if verify else 0)
+                    curl.setopt(pycurl.SSL_VERIFYHOST, 2 if verify else 0)
+
+            header_list = [f'{key}: {value}' for key, value in headers.items()]
+            if header_list:
+                curl.setopt(pycurl.HTTPHEADER, header_list)
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        return _PycurlResponse(response_body.getvalue(), status_code)
 
