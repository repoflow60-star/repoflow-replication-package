--- a/ninjemail/sms_services/_pycurl.py
+++ b/ninjemail/sms_services/_pycurl.py
@@ -0,0 +1,102 @@
+import io
+import json
+from urllib.parse import urlencode, urlsplit, urlunsplit, parse_qsl
+
+import pycurl
+
+
+class HTTPError(Exception):
+    def __init__(self, status_code, message="", url=None):
+        self.status_code = status_code
+        self.message = message or ""
+        self.url = url
+        prefix = f"HTTP {status_code}"
+        if self.message:
+            super().__init__(f"{prefix}: {self.message}")
+        else:
+            super().__init__(prefix)
+
+
+class Response:
+    def __init__(self, text, status_code, url):
+        self.text = text
+        self.status_code = status_code
+        self.url = url
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise HTTPError(self.status_code, self.text, self.url)
+
+
+def _merge_params(url, params):
+    if not params:
+        return url
+
+    parts = urlsplit(url)
+    query = parse_qsl(parts.query, keep_blank_values=True)
+    query.extend(params.items())
+    return urlunsplit((parts.scheme, parts.netloc, parts.path, urlencode(query), parts.fragment))
+
+
+def _encode_payload(data):
+    if data is None:
+        return None
+    if isinstance(data, (bytes, bytearray)):
+        return bytes(data)
+    if isinstance(data, str):
+        return data.encode("utf-8")
+    return urlencode(data, doseq=True).encode("utf-8")
+
+
+def request(method, url, headers=None, data=None, params=None, timeout=30):
+    body = io.BytesIO()
+    curl = pycurl.Curl()
+    final_url = _merge_params(url, params)
+    header_items = dict(headers or {})
+
+    try:
+        curl.setopt(pycurl.URL, final_url)
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.NOSIGNAL, 1)
+        curl.setopt(pycurl.TIMEOUT, timeout)
+        curl.setopt(pycurl.CONNECTTIMEOUT, timeout)
+        curl.setopt(pycurl.ACCEPT_ENCODING, "")
+        curl.setopt(pycurl.USERAGENT, "python-requests/2.31.0")
+
+        method = method.upper()
+        if method == "GET":
+            curl.setopt(pycurl.HTTPGET, 1)
+        else:
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            payload = _encode_payload(data)
+            if payload is not None:
+                if method == "POST" and "Content-Type" not in header_items:
+                    header_items["Content-Type"] = "application/x-www-form-urlencoded"
+                curl.setopt(pycurl.POSTFIELDS, payload)
+
+        if header_items:
+            curl.setopt(pycurl.HTTPHEADER, [f"{key}: {value}" for key, value in header_items.items()])
+
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        text = body.getvalue().decode("utf-8", errors="replace")
+        return Response(text=text, status_code=status_code, url=final_url)
+    except pycurl.error as exc:
+        raise HTTPError(0, str(exc), final_url) from exc
+    finally:
+        curl.close()
+
+
+def request_text(method, url, headers=None, data=None, params=None, timeout=30):
+    return request(
+        method,
+        url,
+        headers=headers,
+        data=data,
+        params=params,
+        timeout=timeout,
+    ).text
