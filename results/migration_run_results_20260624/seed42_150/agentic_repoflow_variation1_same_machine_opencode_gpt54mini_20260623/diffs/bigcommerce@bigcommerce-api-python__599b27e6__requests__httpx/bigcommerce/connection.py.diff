 from bigcommerce.exception import *
 
 log = logging.getLogger("bigcommerce.connection")
+
+
+class _HTTPXSession(object):
+    def __init__(self, auth=None, headers=None):
+        self._client = httpx.Client()
+        self.auth = auth
+        self.headers = dict(headers or {})
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        self._client.headers.clear()
+        self._client.headers.update(self.headers)
+        self._client.auth = self.auth
+        return self._client.request(method, url, data=data, timeout=timeout, headers=headers)
+
+
+def _create_session(auth=None, headers=None):
+    return _HTTPXSession(auth, headers)
+
+
+def _response_reason(res):
+    return getattr(res, 'reason_phrase', None) or getattr(res, 'reason', '')
 
 
