+class _AdapterRequest:
+    def __init__(self, method, url, headers=None, body=None):
+        self.method = method
+        self.url = url
+        self.headers = headers or {}
+        self.body = body
+        parsed = urlsplit(url)
+        self.scheme = parsed.scheme
+        self.hostname = parsed.hostname
+        self.netloc = parsed.netloc
+        self.path_url = parsed.path or "/"
+        if parsed.query:
+            self.path_url = "{path}?{query}".format(path=self.path_url, query=parsed.query)
+
+
+class _SessionCompatibility:
+    def __init__(self):
+        self.headers = {}
+        self._adapters = {}
+
+    def mount(self, prefix, adapter):
+        self._adapters[prefix] = adapter
+
+    def adapter_for(self, url):
+        scheme = urlsplit(url).scheme
+        return self._adapters.get(scheme)
