+def _new_des_cipher(
+    key: bytes, mode: int, iv: _typing.Optional[bytes] = None
+) -> _typing.Any:
+    if iv is None:
+        return _DES.new(key, mode)
+    return _DES.new(key, mode, iv=iv)
+
+
+def _new_tdes_cipher(
+    key: bytes, mode: int, iv: _typing.Optional[bytes] = None
+) -> _typing.Any:
+    if len(key) == 8:
+        return _new_des_cipher(key, mode, iv)
+
+    try:
+        if iv is None:
+            return _DES3.new(key, mode)
+        return _DES3.new(key, mode, iv=iv)
+    except ValueError as exc:
+        if "degenerates to single DES" not in str(exc):
+            raise
+
+        return _new_des_cipher(key[:8], mode, iv)
+
