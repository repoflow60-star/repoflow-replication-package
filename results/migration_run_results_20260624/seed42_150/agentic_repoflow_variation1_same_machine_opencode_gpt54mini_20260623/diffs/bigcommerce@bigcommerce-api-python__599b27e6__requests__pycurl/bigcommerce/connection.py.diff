+class _PycurlResponse(object):
+    def __init__(self, status_code, reason, headers, content):
+        self.status_code = status_code
+        self.reason = reason
+        self.headers = headers
+        self.content = content
+
+    def json(self):
+        payload = self.content.decode("utf-8") if isinstance(self.content, (bytes, bytearray)) else self.content
+        return loads(payload)
+
+
+class _PycurlSession(object):
+    def __init__(self):
+        self.auth = None
+        self.headers = {}
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        curl = pycurl.Curl()
+        response_body = io.BytesIO()
+        response_headers = {}
+        status_code = 0
+
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        def _write_headers(line):
+            nonlocal status_code, response_headers
+            text = line.decode("iso-8859-1").strip()
+            if text.startswith("HTTP/"):
+                parts = text.split(" ", 2)
+                if len(parts) > 1:
+                    try:
+                        status_code = int(parts[1])
+                    except ValueError:
+                        status_code = 0
+                response_headers = {}
+            elif ":" in text:
+                key, value = text.split(":", 1)
+                response_headers[key.strip()] = value.strip()
+            return len(line)
+
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, _write_headers)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.NOSIGNAL, 1)
+        curl.setopt(pycurl.ACCEPT_ENCODING, "")
+
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT, timeout)
+            curl.setopt(pycurl.CONNECTTIMEOUT, timeout)
+
+        if self.auth:
+            curl.setopt(pycurl.USERPWD, "%s:%s" % self.auth)
+            curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+
+        if request_headers:
+            curl.setopt(pycurl.HTTPHEADER, ["%s: %s" % (key, value) for key, value in request_headers.items()])
+
+        method = method.upper()
+        if method == "GET":
+            curl.setopt(pycurl.HTTPGET, 1)
+        elif method == "POST":
+            curl.setopt(pycurl.POST, 1)
+        else:
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+        if data is not None:
+            if isinstance(data, dict):
+                data = urlencode(data)
+            if isinstance(data, str):
+                data = data.encode("utf-8")
+            curl.setopt(pycurl.POSTFIELDS, data)
+
+        try:
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE) or status_code
+        finally:
+            curl.close()
+
+        reason = http_responses.get(status_code, "")
+        return _PycurlResponse(status_code, reason, response_headers, response_body.getvalue())
 
 
