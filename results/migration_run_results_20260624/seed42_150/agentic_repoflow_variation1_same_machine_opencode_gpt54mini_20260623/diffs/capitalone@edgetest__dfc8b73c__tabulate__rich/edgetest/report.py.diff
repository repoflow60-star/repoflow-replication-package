+def tabulate(rows: List[List[Any]], headers: List[str], tablefmt: str = "rst") -> str:
+    """Render the report table for the supported output formats."""
+    widths = []
+    for index, header in enumerate(headers):
+        data_width = max((_cell_width(row[index]) for row in rows), default=0)
+        header_width = _cell_width(header)
+        if tablefmt == "rst":
+            widths.append(max(data_width, header_width + 2))
+        else:
+            widths.append(max(data_width, header_width))
+
+    def render_row(row: List[Any], trim: bool = False) -> str:
+        cells = [str(cell).ljust(widths[index]) for index, cell in enumerate(row)]
+        rendered = "  ".join(cells)
+        return rendered.rstrip() if trim else rendered
+
+    if tablefmt == "github":
+        header = f"| {render_row(headers)} |"
+        separator = "|" + "|".join("-" * max(3, width) for width in widths) + "|"
+        body = [f"| {render_row(row)} |" for row in rows]
+        return "\n".join([header, separator, *body])
+
