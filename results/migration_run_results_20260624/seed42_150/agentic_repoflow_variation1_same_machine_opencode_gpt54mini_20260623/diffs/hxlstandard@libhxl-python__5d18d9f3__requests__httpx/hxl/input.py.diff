+def _httpx_headers(headers):
+    """Return request headers with a requests-like default user agent."""
+    if headers is None:
+        return {"User-Agent": "python-requests"}
+    if any(key.lower() == "user-agent" for key in headers):
+        return headers
+    result = dict(headers)
+    result["User-Agent"] = "python-requests"
+    return result
 
