+    def _request(self, method, url, params=None, body=None):
+        url = self.base_url + url
+        if params:
+            query_string = '&'.join([f'{key}={value}' for key, value in params.items()])
+            url = url + '?' + query_string
+        buffer = io.BytesIO()
+        header_buffer = io.BytesIO()
+        curl = pycurl.Curl()
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.CUSTOMREQUEST, method)
+        curl.setopt(pycurl.WRITEFUNCTION, buffer.write)
+        curl.setopt(pycurl.HEADERFUNCTION, header_buffer.write)
+        curl.setopt(pycurl.HTTPHEADER, [
+            'Authorization: ' + self.authorization_header,
+        ])
+        if body is not None:
+            curl.setopt(pycurl.HTTPHEADER, [
+                'Authorization: ' + self.authorization_header,
+                'Content-Type: application/json',
+            ])
+            curl.setopt(pycurl.POSTFIELDS, body)
+        try:
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            effective_url = curl.getinfo(pycurl.EFFECTIVE_URL)
+        finally:
+            curl.close()
+        headers = {}
+        for line in header_buffer.getvalue().decode('iso-8859-1').splitlines():
+            if ':' in line:
+                key, value = line.split(':', 1)
+                headers[key.strip().lower()] = value.strip()
+        content = buffer.getvalue()
+        return _Response(status_code, headers, content, effective_url)
+
