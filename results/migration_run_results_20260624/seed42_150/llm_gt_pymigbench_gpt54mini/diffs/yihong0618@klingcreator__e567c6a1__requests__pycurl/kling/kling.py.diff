+class PycurlSession:
+    def __init__(self) -> None:
+        self.headers = {}
+        self.cookies = {}
+
+    def _request(self, method: str, url: str, data=None, params=None, json_data=None, headers=None):
+        if params:
+            if "?" in url:
+                url = url + "&" + "&".join([f"{k}={v}" for k, v in params.items()])
+            else:
+                url = url + "?" + "&".join([f"{k}={v}" for k, v in params.items()])
+
+        curl = pycurl.Curl()
+        body_buffer = io.BytesIO()
+        header_buffer = io.BytesIO()
+
+        curl.setopt(pycurl.URL, url.encode("utf-8"))
+        curl.setopt(pycurl.WRITEDATA, body_buffer)
+        curl.setopt(pycurl.HEADERFUNCTION, header_buffer.write)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+
+        request_headers = {}
+        request_headers.update(self.headers)
+        if headers:
+            request_headers.update(headers)
+        if self.cookies:
+            request_headers["Cookie"] = "; ".join([f"{k}={v}" for k, v in self.cookies.items()])
+
+        header_list = [f"{k}: {v}" for k, v in request_headers.items()]
+        if header_list:
