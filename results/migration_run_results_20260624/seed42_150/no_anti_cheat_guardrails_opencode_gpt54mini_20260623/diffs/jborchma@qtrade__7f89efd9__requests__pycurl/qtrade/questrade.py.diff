+class _PycurlResponse:
+    """Minimal response object for pycurl-backed requests."""
+
+    def __init__(self, body: str, status_code: int):
+        self._body = body
+        self.status_code = status_code
+
+    def raise_for_status(self):
+        if not 200 <= self.status_code < 300:
+            raise Exception(f"HTTP {self.status_code}")
+
+    def json(self):
+        return json_module.loads(self._body)
+
+
+def _perform_pycurl_request(
+    method: str,
+    url: str,
+    params: Optional[Dict] = None,
+    data: Optional[Dict] = None,
+    json: Optional[Dict] = None,
+    timeout: int = 30,
+    headers: Optional[Dict[str, str]] = None,
+) -> _PycurlResponse:
+    full_url = url
+    if params:
+        query = urlencode(params, doseq=True)
+        full_url = full_url + ("&" if "?" in full_url else "?") + query
+
+    request_headers = dict(headers or {})
+
+    body = None
+    if json is not None:
+        request_headers.setdefault("Content-Type", "application/json")
+        body = json_module.dumps(json).encode("utf-8")
+    elif data is not None:
+        if isinstance(data, dict):
+            body = urlencode(data, doseq=True).encode("utf-8")
+        elif isinstance(data, str):
+            body = data.encode("utf-8")
+        else:
+            body = data
+
+    buffer = io.BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, full_url)
+        curl.setopt(pycurl.WRITEFUNCTION, buffer.write)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.NOSIGNAL, 1)
+        curl.setopt(pycurl.TIMEOUT, timeout)
+        curl.setopt(pycurl.CONNECTTIMEOUT, timeout)
+        if request_headers:
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                [f"{key}: {value}" for key, value in request_headers.items()],
+            )
+
+        method = method.upper()
+        if method == "GET":
+            curl.setopt(pycurl.HTTPGET, True)
+        else:
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            if body is not None:
+                curl.setopt(pycurl.POSTFIELDS, body)
+            elif method == "POST":
+                curl.setopt(pycurl.POSTFIELDS, b"")
+
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        response_body = buffer.getvalue().decode("utf-8", errors="replace")
+        return _PycurlResponse(response_body, status_code)
+    finally:
