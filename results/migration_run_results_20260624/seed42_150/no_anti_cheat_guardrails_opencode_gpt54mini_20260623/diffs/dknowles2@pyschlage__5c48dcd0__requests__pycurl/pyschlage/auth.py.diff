+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.CUSTOMREQUEST, method.upper())
+        curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, response_headers.write)
+        curl.setopt(pycurl.TIMEOUT, timeout)
+        curl.setopt(pycurl.NOSIGNAL, 1)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.ACCEPT_ENCODING, "")
+        if headers:
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                [f"{key}: {value}" for key, value in headers.items()],
+            )
+        if body is not None:
+            curl.setopt(pycurl.POSTFIELDS, body)
+            curl.setopt(pycurl.POSTFIELDSIZE, len(body))
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        reason, response_header_map = _extract_response_metadata(
+            response_headers.getvalue()
+        )
+        return _CurlResponse(
+            curl.getinfo(pycurl.EFFECTIVE_URL) or url,
+            status_code,
+            reason,
+            response_header_map,
+            response_body.getvalue(),
+        )
+    except pycurl.error as ex:
+        raise UnknownError(str(ex)) from ex
+    finally:
+        curl.close()
+
