+def _apply_query_params(url: str, params) -> str:
+    if not params:
+        return url
+    parsed = urlsplit(url)
+    query = urlencode(params, doseq=True)
+    if parsed.query:
+        query = f"{parsed.query}&{query}"
+    return urlunsplit((parsed.scheme, parsed.netloc, parsed.path, query, parsed.fragment))
+
+
+def _prepare_body(kwargs: dict) -> tuple[bytes | None, dict[str, str]]:
+    headers = dict(kwargs.get("headers", {}))
+    if "json" in kwargs:
+        if "Content-Type" not in headers and "content-type" not in {
+            key.lower() for key in headers
+        }:
+            headers["Content-Type"] = "application/json"
+        return json.dumps(kwargs["json"]).encode("utf-8"), headers
+    if "data" not in kwargs:
+        return None, headers
+    data = kwargs["data"]
+    if data is None:
+        return None, headers
+    if isinstance(data, bytes):
+        return data, headers
+    if isinstance(data, str):
+        return data.encode("utf-8"), headers
+    if isinstance(data, dict):
+        if "Content-Type" not in headers and "content-type" not in {
+            key.lower() for key in headers
+        }:
+            headers["Content-Type"] = "application/x-www-form-urlencoded"
+        return urlencode(data, doseq=True).encode("utf-8"), headers
+    return str(data).encode("utf-8"), headers
+
+
+def _extract_response_metadata(raw_headers: bytes) -> tuple[str, dict[str, str]]:
+    reason = ""
+    headers: dict[str, str] = {}
+    for line in raw_headers.decode("iso-8859-1").splitlines():
+        if line.startswith("HTTP/"):
+            headers = {}
+            parts = line.split(" ", 2)
+            reason = parts[2] if len(parts) == 3 else ""
+            continue
+        if not line or ":" not in line:
+            continue
+        name, value = line.split(":", 1)
+        headers[name.strip()] = value.strip()
+    return reason, headers
+
+
+def _perform_request(
+    method: str,
+    url: str,
+    *,
+    timeout: int,
+    headers: dict[str, str],
+    body: bytes | None,
+) -> _CurlResponse:
