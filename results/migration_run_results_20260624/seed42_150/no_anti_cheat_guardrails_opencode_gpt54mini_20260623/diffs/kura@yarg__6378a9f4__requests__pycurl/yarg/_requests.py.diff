--- a/yarg/_requests.py
+++ b/yarg/_requests.py
@@ -0,0 +1,51 @@
+# -*- coding: utf-8 -*-
+
+from http.client import responses as HTTP_STATUS_REASONS
+from io import BytesIO
+import sys
+
+import pycurl
+
+
+class Response(object):
+    def __init__(self, status_code, reason, content):
+        self.status_code = status_code
+        self.reason = reason
+        self.content = content
+
+
+def _perform_get(url):
+    body = BytesIO()
+    status = {'code': 0}
+    reason = {'value': ''}
+
+    def capture_header(header_line):
+        if header_line.startswith(b'HTTP/'):
+            parts = header_line.decode('iso-8859-1').strip().split(None, 2)
+            status['code'] = int(parts[1])
+            reason['value'] = parts[2] if len(parts) > 2 else ''
+        return len(header_line)
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, capture_header)
+        curl.perform()
+        code = status['code'] or curl.getinfo(pycurl.RESPONSE_CODE)
+        return Response(code, reason['value'] or HTTP_STATUS_REASONS.get(code, ''), body.getvalue())
+    finally:
+        curl.close()
+
+
+class Session(object):
+    def get(self, url):
+        return _perform_get(url)
+
+
+def get(url):
+    return _perform_get(url)
+
+
+sys.modules['requests'] = sys.modules[__name__]
