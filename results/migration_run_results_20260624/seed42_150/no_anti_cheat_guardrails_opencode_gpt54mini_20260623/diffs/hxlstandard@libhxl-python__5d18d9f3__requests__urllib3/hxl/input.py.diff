+
+_HTTP_POOL_MANAGERS = {
+    True: urllib3.PoolManager(retries=False),
+    False: urllib3.PoolManager(retries=False, cert_reqs=ssl.CERT_NONE, assert_hostname=False),
+}
+
+
+class _HTTPResponseWrapper(object):
+    def __init__(self, response):
+        self._response = response
+        self.status = response.status
+        self.status_code = response.status
+        self.headers = response.headers
+        self.url = response.geturl() if hasattr(response, 'geturl') else None
+        self.encoding = None
+        content_type = self.headers.get('content-type')
+        if content_type:
+            match = re.search(r'charset=([^;\s]+)', content_type, re.I)
+            if match:
+                self.encoding = match.group(1).lower()
+
+    @property
+    def content(self):
+        return self._response.data
+
+    @property
+    def data(self):
+        return self._response.data
+
+    @property
+    def is_redirect(self):
+        return self.status_code in (301, 302, 303, 307, 308) or bool(self.headers.get('Location'))
+
+    def json(self):
+        return json.loads(self.data.decode('utf-8'))
+
+    def raise_for_status(self):
+        _raise_for_status(self)
+
+    def close(self):
+        return self._response.close()
+
+    def stream(self, amt=65536):
+        return self._response.stream(amt)
+
+    @property
+    def raw(self):
+        return self._response
+
+
+def _http_request(method, url, verify_ssl=True, headers=None, timeout=None, fields=None, body=None, redirect=None):
+    if redirect is None:
+        redirect = method.upper() == 'GET'
+    request_headers = dict(headers or {})
+    request_headers.setdefault('User-Agent', 'python-requests')
+    request_headers.setdefault('Accept', '*/*')
+    request_headers.setdefault('Accept-Encoding', 'gzip, deflate')
+    current_method = method
+    current_url = url
+    current_fields = fields
+    current_body = body
+    for _ in range(5):
+        try:
+            response = _HTTP_POOL_MANAGERS[bool(verify_ssl)].request(
+                current_method,
+                current_url,
+                headers=request_headers,
+                timeout=timeout,
+                fields=current_fields,
+                body=current_body,
+                preload_content=True,
+                redirect=False,
+            )
+        except urllib3.exceptions.HTTPError as e:
+            raise HXLIOException(str(e), url=url)
+
+        if redirect and response.status in (301, 302, 303, 307, 308):
+            new_url = response.headers.get('Location')
+            if not new_url:
+                return _HTTPResponseWrapper(response)
+            response.close()
+            current_url = urllib.parse.urljoin(current_url, new_url)
+            current_fields = None
+            current_body = None
+            if response.status == 303:
+                current_method = 'GET'
+            continue
+
+        return _HTTPResponseWrapper(response)
+
+    raise HXLIOException("Too many redirects for {}".format(url), url=url)
+
+
+def _response_json(response):
+    return response.json()
+
+
+def _raise_for_status(response, url=None):
+    status = getattr(response, 'status_code', getattr(response, 'status', None))
+    if status is not None and status >= 400:
+        raise HXLIOException(
+            "HTTP {0}{1}".format(
+                status,
+                " for {0}".format(url) if url else "",
+            ),
+            url=url,
+        )
 
