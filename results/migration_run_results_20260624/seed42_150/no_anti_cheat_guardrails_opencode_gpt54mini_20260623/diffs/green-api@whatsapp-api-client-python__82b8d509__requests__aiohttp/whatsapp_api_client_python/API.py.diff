+def _run_async(coro: Any) -> Any:
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coro)
+
+    result = []
+    error = []
+
+    def runner() -> None:
+        try:
+            result.append(asyncio.run(coro))
+        except Exception as exc:
+            error.append(exc)
+
+    thread = threading.Thread(target=runner)
+    thread.start()
+    thread.join()
+
+    if error:
+        raise error[0]
+
+    return result[0]
+
