 from os.path import dirname, join
 
-from dotenv import load_dotenv
+from dynaconf import Dynaconf
+
+
+_ENV_FILE_KEYS = (
+    "BODY",
+    "COMMIT_MESSAGE",
+    "DRY_RUN",
+    "EXEMPT_REPOS",
+    "GH_APP_ID",
+    "GH_APP_INSTALLATION_ID",
+    "GH_APP_PRIVATE_KEY",
+    "GH_ENTERPRISE_URL",
+    "GH_TOKEN",
+    "GITHUB_APP_ENTERPRISE_ONLY",
+    "ISSUE_REPORT",
+    "ORGANIZATION",
+    "REPOSITORY",
+    "TITLE",
+)
+
+
+def _load_env_file(test: bool) -> None:
+    if test:
+        return
+
+    dotenv_path = join(dirname(__file__), ".env")
+    settings = Dynaconf(
+        envvar_prefix=False,
+        load_dotenv=True,
+        dotenv_path=dotenv_path,
+    )
+    for env_var_name in _ENV_FILE_KEYS:
+        if env_var_name in os.environ:
+            continue
+
+        env_var_value = settings.get(env_var_name)
+        if env_var_value is not None:
+            os.environ[env_var_name] = str(env_var_value)
 
 
