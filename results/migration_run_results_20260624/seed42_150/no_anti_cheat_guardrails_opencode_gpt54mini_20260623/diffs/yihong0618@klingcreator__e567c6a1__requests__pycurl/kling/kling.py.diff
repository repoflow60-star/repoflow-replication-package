+class CurlResponse:
+    def __init__(self, status_code: int, body: bytes, headers=None, url: str = "") -> None:
+        self.status_code = status_code
+        self.content = body
+        self.text = body.decode("utf-8", errors="replace")
+        self.headers = headers or {}
+        self.url = url
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status_code < 400
+
+    def json(self):
+        return json.loads(self.text)
+
+    def __str__(self) -> str:
+        return f"<CurlResponse [{self.status_code}]>"
+
+
+class CurlSession:
+    def __init__(self) -> None:
+        self.headers = {}
+        self.cookies = {}
+        self._lock = threading.Lock()
+
+    def _build_url(self, url: str, params=None) -> str:
+        if not params:
+            return url
+        parts = urlsplit(url)
+        query = urlencode(params, doseq=True)
+        if parts.query:
+            query = f"{parts.query}&{query}"
+        return urlunsplit(parts._replace(query=query))
+
+    def _cookie_header(self) -> str:
+        return "; ".join(f"{key}={value}" for key, value in self.cookies.items())
+
+    def _update_cookies(self, header_value: str) -> None:
+        cookie = SimpleCookie()
+        cookie.load(header_value)
+        with self._lock:
+            for key, morsel in cookie.items():
+                self.cookies[key] = morsel.value
+
+    def _request_once(
+        self,
+        method: str,
+        url: str,
+        data=None,
+        json_body=None,
+        headers=None,
+    ) -> CurlResponse:
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        payload = None
+        if json_body is not None:
+            payload = json.dumps(json_body).encode("utf-8")
+            request_headers.setdefault("Content-Type", "application/json")
+        elif data is not None:
+            payload = data if isinstance(data, (bytes, bytearray)) else str(data).encode("utf-8")
+
+        header_lines = []
+        body = BytesIO()
+        curl = pycurl.Curl()
+        try:
+            def capture_header(line):
+                header_lines.append(line.decode("iso-8859-1"))
+                return len(line)
+
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            curl.setopt(pycurl.ACCEPT_ENCODING, "")
+            curl.setopt(pycurl.WRITEDATA, body)
+            curl.setopt(pycurl.HEADERFUNCTION, capture_header)
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                [f"{key}: {value}" for key, value in request_headers.items()],
+            )
+            with self._lock:
+                cookie_header = self._cookie_header()
+            if cookie_header:
+                curl.setopt(pycurl.COOKIE, cookie_header)
+
+            if method == "GET":
+                curl.setopt(pycurl.HTTPGET, True)
+            elif method == "POST":
+                curl.setopt(pycurl.POST, True)
+                if payload is None:
+                    payload = b""
+                curl.setopt(pycurl.POSTFIELDS, payload)
+                curl.setopt(pycurl.POSTFIELDSIZE, len(payload))
+            else:
+                curl.setopt(pycurl.CUSTOMREQUEST, method)
+                if payload is not None:
+                    curl.setopt(pycurl.POSTFIELDS, payload)
+                    curl.setopt(pycurl.POSTFIELDSIZE, len(payload))
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        response_headers = {}
+        for raw_line in header_lines:
+            line = raw_line.strip("\r\n")
+            if not line or line.startswith("HTTP/"):
+                continue
+            if ":" not in line:
+                continue
+            key, value = line.split(":", 1)
+            key = key.strip().lower()
+            value = value.strip()
+            response_headers[key] = value
+            if key == "set-cookie":
+                self._update_cookies(value)
+
+        return CurlResponse(status_code, body.getvalue(), response_headers, url)
+
+    def _request(self, method: str, url: str, data=None, json_body=None, params=None, headers=None):
+        request_url = self._build_url(url, params)
+        current_method = method.upper()
+        current_data = data
+        current_json = json_body
+
+        for _ in range(10):
+            response = self._request_once(
+                current_method,
+                request_url,
+                data=current_data,
+                json_body=current_json,
+                headers=headers,
+            )
+            if response.status_code not in (301, 302, 303, 307, 308):
+                return response
+
+            location = response.headers.get("location")
+            if not location:
+                return response
+
+            request_url = urljoin(request_url, location)
+            if response.status_code in (301, 302, 303):
+                current_method = "GET"
+                current_data = None
+                current_json = None
+
+        raise Exception("Too many redirects")
+
+    def request(self, method: str, url: str, data=None, json=None, params=None, headers=None):
+        return self._request(method, url, data=data, json_body=json, params=params, headers=headers)
+
+    def get(self, url: str, params=None, headers=None):
+        return self._request("GET", url, params=params, headers=headers)
+
+    def post(self, url: str, data=None, json=None, params=None, headers=None):
+        return self._request("POST", url, data=data, json_body=json, params=params, headers=headers)
+
+
