+def append_query_params(url: str, params) -> str:
+    """Append query parameters to a URL without dropping existing ones."""
+    parts = urlsplit(url)
+    query = parse_qsl(parts.query, keep_blank_values=True)
+    if hasattr(params, 'items'):
+        query.extend(params.items())
+    else:
+        query.extend(params)
+    return urlunsplit(parts._replace(query=urlencode(query, doseq=True)))
+
+
+class _Request:
+    def __init__(self, method, url):
+        self.method = method
+        self.url = url
+
+
+class _ResponseProxy:
+    def __init__(self, response, method, url, status_code, headers, content,
+            elapsed, reason=None):
+        self._response = response
+        self.request = _Request(method, url)
+        self.url = url
+        self.status_code = status_code
+        self.status = status_code
+        self.ok = 200 <= status_code < 400
+        self.reason = reason
+        self.headers = headers
+        self.content = content
+        self.data = content
+        self.text = self._decode_content(content, headers)
+        self.elapsed = elapsed
+
+    def _decode_content(self, content, headers):
+        if isinstance(content, bytes):
+            content_bytes = content
+        elif isinstance(content, str):
+            content_bytes = content.encode('utf-8')
+        else:
+            try:
+                content_bytes = bytes(content)
+            except Exception:
+                content_bytes = str(content).encode('utf-8')
+        encoding = None
+        if headers is not None:
+            content_type = headers.get('content-type', '')
+            if 'charset=' in content_type:
+                encoding = content_type.split('charset=', 1)[1].split(';', 1)[0].strip().strip('"')
+        if encoding is None:
+            encoding = 'utf-8'
+        return content_bytes.decode(encoding, errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
+
+class _RequestAdapter:
+    """Translate requests-style kwargs into urllib3 request calls."""
+
+    def __init__(self):
+        self.pool = urllib3.PoolManager()
+
+    def clear(self):
+        if hasattr(self.pool, 'clear'):
+            self.pool.clear()
+
+    def request(self, method, url, **kwargs):
+        req_kw = deepcopy(kwargs)
+        headers = req_kw.get('headers')
+        if headers is None:
+            headers = HTTPHeaderDict()
+        req_kw['headers'] = headers
+
+        params = req_kw.pop('params', None)
+        if params:
+            url = append_query_params(url, params)
+
+        body = None
+        if 'json' in req_kw:
+            body = json.dumps(req_kw.pop('json')).encode('utf-8')
+            if not any(k.lower() == 'content-type' for k in headers):
+                headers['Content-Type'] = 'application/json'
+        elif 'data' in req_kw:
+            body = req_kw.pop('data')
+            if hasattr(body, 'items') or isinstance(body, (list, tuple)):
+                body = urlencode(body, doseq=True).encode('utf-8')
+                if not any(k.lower() == 'content-type' for k in headers):
+                    headers['Content-Type'] = 'application/x-www-form-urlencoded'
+            elif isinstance(body, str):
+                body = body.encode('utf-8')
+        req_kw.pop('stream', None)
+        if body is not None:
+            req_kw['body'] = body
+
+        req_kw.setdefault('retries', False)
+        req_kw.setdefault('preload_content', True)
+        return self.pool.request(method, url, **req_kw)
+
+
+def _adapt_response(response, method, url, status, headers, body,
+        elapsed, response_url):
+    if body is None:
+        body = b''
+    if headers is None:
+        headers = HTTPHeaderDict()
+    if isinstance(body, bytes):
+        content = body
+    elif isinstance(body, str):
+        content = body.encode('utf-8')
+    else:
+        try:
+            content = bytes(body)
+        except Exception:
+            content = str(body).encode('utf-8')
+
+    try:
+        request = getattr(response, 'request', None)
+        if request is None:
+            response.request = _Request(method, response_url)
+        else:
+            if hasattr(request, 'method'):
+                request.method = method
+            if hasattr(request, 'url'):
+                request.url = response_url
+        response.url = response_url
+        response.status_code = status
+        response.status = status
+        response.ok = 200 <= status < 400
+        response.headers = headers
+        response.content = content
+        response.data = content
+        if not hasattr(response, 'text'):
+            response.text = _ResponseProxy(response, method, response_url,
+                status, headers, content, elapsed, reason=getattr(response, 'reason', None)).text
+        elif isinstance(response.text, bytes):
+            response.text = response.text.decode('utf-8', errors='replace')
+        response.elapsed = elapsed
+        if not hasattr(response, 'json'):
+            response.json = lambda: json.loads(response.text)
+        return response
+    except Exception:
+        return _ResponseProxy(response, method, response_url, status, headers,
+            content, elapsed, reason=getattr(response, 'reason', None))
+
