+    def _proxy_url(self, url):
+        if not self.proxies:
+            return None
+
+        scheme = urlsplit(url).scheme.lower()
+        return self.proxies.get(scheme) or self.proxies.get("all")
+
+    def _build_agent(self, url):
+        reactor = _ensure_reactor()
+        proxy_url = self._proxy_url(url)
+        if proxy_url is None:
+            return Agent(reactor)
+
+        proxy_uri = proxy_url.encode("ascii") if isinstance(proxy_url, str) else proxy_url
+        for factory in (
+            lambda: ProxyAgent(proxy_uri, reactor=reactor),
+            lambda: ProxyAgent(proxy_uri),
+        ):
+            try:
+                return factory()
+            except TypeError:
+                continue
+
+        return Agent(reactor)
+
+    def _encode_data(self, data, headers):
+        if data is None:
+            return None
+
+        if isinstance(data, bytes):
+            return data
+
+        if isinstance(data, str):
+            return data.encode("utf-8")
+
+        if isinstance(data, Mapping) or isinstance(data, (list, tuple)):
+            headers.setdefault("Content-Type", "application/x-www-form-urlencoded")
+            return urlencode(data, doseq=True).encode("utf-8")
+
+        return data
+
+    async def _request_async(self, method, url, data, headers):
+        client = HTTPClient(self._build_agent(url))
+        body = self._encode_data(data, headers)
+        response = await client.request(method, url, headers=headers, data=body)
+        content = await treq.content(response)
