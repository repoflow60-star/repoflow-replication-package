+class Response:
+    def __init__(self, url, status_code, headers=None, content=None, request=None):
+        self.url = url
+        self.status_code = status_code
+        self.headers = CaseInsensitiveHeaders(headers or {})
+        self._content = content or b''
+        self.request = request
+
+    @property
+    def content(self):
+        return self._content
+
+    @property
+    def text(self):
+        content_type = self.headers.get('Content-Type', '')
+        charset = 'utf-8'
+        if 'charset=' in content_type:
+            charset = content_type.split('charset=', 1)[1].split(';', 1)[0].strip() or 'utf-8'
+
+        return self._content.decode(charset, errors='replace')
+
+    @property
+    def ok(self):
+        return 200 <= self.status_code < 400
+
+    def json(self):
+        return json.loads(self.text)
+
+    def iter_content(self, chunk_size):
+        if chunk_size is None or chunk_size <= 0:
+            chunk_size = len(self._content) or 1
+
+        for offset in range(0, len(self._content), chunk_size):
+            yield self._content[offset:offset + chunk_size]
+
+    def raise_for_status(self):
+        if self.ok:
+            return
+
+        raise HTTPError('HTTP {}'.format(self.status_code))
