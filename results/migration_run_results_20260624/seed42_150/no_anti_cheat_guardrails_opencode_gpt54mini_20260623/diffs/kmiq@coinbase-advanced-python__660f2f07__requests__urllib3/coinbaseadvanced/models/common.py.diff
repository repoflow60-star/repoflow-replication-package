+def _response_text(response: urllib3.response.HTTPResponse) -> str:
+    text = getattr(response, "text", None)
+    if isinstance(text, bytes):
+        return text.decode("utf-8")
+
+    if isinstance(text, str):
+        return text
+
+    body = getattr(response, "data", None)
+    if body is None and hasattr(response, "read"):
+        body = response.read()
+
+    if isinstance(body, bytes):
+        return body.decode("utf-8")
+
+    if isinstance(body, str):
+        return body
+
+    return "" if body is None else ""
+
+
+def response_ok(response: urllib3.response.HTTPResponse) -> bool:
+    ok = getattr(response, "ok", None)
+    if isinstance(ok, bool):
+        return bool(ok)
+
+    status = getattr(response, "status", 0) or 0
+    return 200 <= status < 300
+
+
+def response_json(response: urllib3.response.HTTPResponse):
+    json_method = getattr(response, "json", None)
+    if callable(json_method):
+        try:
+            result = json_method()
+            if isinstance(result, (dict, list)):
+                return result
+        except Exception:
+            pass
+
+    return json.loads(_response_text(response))
+
