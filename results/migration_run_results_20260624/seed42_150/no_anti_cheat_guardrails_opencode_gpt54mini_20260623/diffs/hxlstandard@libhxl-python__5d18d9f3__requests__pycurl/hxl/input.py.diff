+class _CurlResponse(object):
+    def __init__(self, url, status_code, headers, content):
+        self.url = url
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+
+    @property
+    def is_redirect(self):
+        return 300 <= self.status_code < 400 and 'location' in self.headers
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise HXLIOException("HTTP error {} for {}".format(self.status_code, self.url), url=self.url)
+
+    def json(self):
+        content_type = self.headers.get('content-type')
+        encoding = None
+        if content_type:
+            result = re.match(r'^\S+\s*;\s*charset=(\S+)$', content_type)
+            if result:
+                encoding = result.group(1).lower()
+        return json.loads(self.content.decode(encoding or 'utf-8'))
+
+
+def _append_query_params(url, params):
+    if not params:
+        return url
+    parsed = urllib.parse.urlsplit(url)
+    query = urllib.parse.parse_qsl(parsed.query, keep_blank_values=True)
+    for key, value in params.items():
+        if isinstance(value, (list, tuple)):
+            for item in value:
+                query.append((key, item))
+        else:
+            query.append((key, value))
+    return urllib.parse.urlunsplit((
+        parsed.scheme,
+        parsed.netloc,
+        parsed.path,
+        urllib.parse.urlencode(query, doseq=True),
+        parsed.fragment,
+    ))
+
+
+def _curl_request(url, method='GET', headers=None, params=None, data=None, verify_ssl=True, timeout=None, follow_redirects=True):
+    body = io.BytesIO()
+    response_headers = {}
+    status_code = 0
+
+    def header_function(line):
+        nonlocal response_headers, status_code
+        text = line.decode('iso-8859-1').strip()
+        if not text:
+            return len(line)
+        if text.startswith('HTTP/'):
+            parts = text.split(None, 2)
+            if len(parts) > 1:
+                try:
+                    status_code = int(parts[1])
+                except ValueError:
+                    status_code = 0
+            response_headers = {}
+        else:
+            result = text.split(':', 1)
+            if len(result) == 2:
+                response_headers[result[0].strip().lower()] = result[1].strip()
+        return len(line)
+
+    curl = pycurl.Curl()
+    try:
+        if params:
+            url = _append_query_params(url, params)
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.NOSIGNAL, 1)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1 if follow_redirects else 0)
+        curl.setopt(pycurl.MAXREDIRS, 10)
+        curl.setopt(pycurl.AUTOREFERER, 1)
+        curl.setopt(pycurl.HTTP_VERSION, pycurl.CURL_HTTP_VERSION_1_1)
+        curl.setopt(pycurl.COOKIEFILE, '')
+        curl.setopt(pycurl.USERAGENT, 'python-requests')
+        curl.setopt(pycurl.ACCEPT_ENCODING, '')
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, header_function)
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT, int(timeout))
+        curl.setopt(pycurl.SSL_VERIFYPEER, 1 if verify_ssl else 0)
+        curl.setopt(pycurl.SSL_VERIFYHOST, 2 if verify_ssl else 0)
+        request_headers = ['Accept: */*']
+        if headers:
+            request_headers.extend(['{}: {}'.format(key, value) for key, value in headers.items()])
+        curl.setopt(pycurl.HTTPHEADER, request_headers)
+
+        if method == 'HEAD':
+            curl.setopt(pycurl.NOBODY, 1)
+            curl.setopt(pycurl.CUSTOMREQUEST, 'HEAD')
+        elif method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, urllib.parse.urlencode(data or {}, doseq=True))
+        else:
+            curl.setopt(pycurl.HTTPGET, 1)
+
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        return _CurlResponse(url, status_code, response_headers, body.getvalue())
+    except pycurl.error as e:
+        raise HXLIOException(str(e), url=url)
+    finally:
