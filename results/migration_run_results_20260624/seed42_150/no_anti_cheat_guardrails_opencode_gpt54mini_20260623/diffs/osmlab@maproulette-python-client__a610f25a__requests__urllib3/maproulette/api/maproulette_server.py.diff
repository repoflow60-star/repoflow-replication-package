+class _Urllib3Response:
+    def __init__(self, response):
+        self._response = response
+        self.status_code = response.status
+        self.ok = response.status < 400
+        self.text = (response.data or b"").decode("utf-8", errors="replace")
+
+    def json(self):
+        return json_module.loads(self.text)
+
+    def raise_for_status(self):
+        if not self.ok:
+            error = urllib3.exceptions.HTTPError(f"HTTP {self.status_code}")
+            error.response = self
+            raise error
+
+
+class _Urllib3Session:
+    def __init__(self, headers=None, verify=True, cert=None):
+        self.headers = headers or {}
+        self.verify = verify
+        self.cert = cert
+        pool_kwargs = {
+            "headers": self.headers,
+            "cert_reqs": ssl.CERT_REQUIRED if verify else ssl.CERT_NONE,
+        }
+        if isinstance(cert, tuple):
+            if len(cert) > 0:
+                pool_kwargs["cert_file"] = cert[0]
+            if len(cert) > 1:
+                pool_kwargs["key_file"] = cert[1]
+        elif cert:
+            pool_kwargs["cert_file"] = cert
+        self._pool = urllib3.PoolManager(**pool_kwargs)
+
+    def _request(self, method, url, params=None, json=None, files=None, headers=None):
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+        if params:
+            separator = "&" if "?" in url else "?"
+            url = f"{url}{separator}{urlencode(params, doseq=True)}"
+
+        request_kwargs = {"headers": request_headers}
+        if json is not None:
+            request_kwargs["body"] = json_module.dumps(json).encode("utf-8")
+            request_headers.setdefault("Content-Type", "application/json")
+        if files is not None:
+            request_kwargs["fields"] = files
+            request_kwargs["encode_multipart"] = True
+
+        response = self._pool.request(method, url, **request_kwargs)
+        return _Urllib3Response(response)
+
+    def get(self, url, params=None, headers=None, verify=None, cert=None):
+        return self._request("GET", url, params=params, headers=headers)
+
+    def post(self, url, params=None, json=None, headers=None, verify=None, cert=None):
+        return self._request("POST", url, params=params, json=json, headers=headers)
+
+    def put(self, url, params=None, json=None, files=None, headers=None, verify=None, cert=None):
+        return self._request("PUT", url, params=params, json=json, files=files, headers=headers)
+
+    def delete(self, url, params=None, headers=None, verify=None, cert=None):
+        return self._request("DELETE", url, params=params, headers=headers)
+
+
+class _RequestsConnectionError(Exception):
+    pass
+
+
+class _RequestsTimeout(Exception):
+    pass
+
+
+class _RequestsHTTPError(Exception):
+    def __init__(self, *args, response=None):
+        super().__init__(*args)
+        self.response = response
+
+
+def _namespace_session(headers=None, verify=True, cert=None):
+    return _Urllib3Session(headers=headers, verify=verify, cert=cert)
+
+
+def _namespace_get(url, headers=None, verify=True, cert=None, params=None):
+    return _namespace_session(headers=headers, verify=verify, cert=cert).get(url, params=params)
+
+
+def _namespace_post(url, headers=None, verify=True, cert=None, params=None, json=None):
+    return _namespace_session(headers=headers, verify=verify, cert=cert).post(url, params=params, json=json)
+
+
+def _namespace_put(url, headers=None, verify=True, cert=None, params=None, json=None, files=None):
+    return _namespace_session(headers=headers, verify=verify, cert=cert).put(url, params=params, json=json, files=files)
+
+
+def _namespace_delete(url, headers=None, verify=True, cert=None, params=None):
+    return _namespace_session(headers=headers, verify=verify, cert=cert).delete(url, params=params)
+
+
+requests = types.SimpleNamespace(
+    Session=_Urllib3Session,
+    exceptions=types.SimpleNamespace(
+        HTTPError=_RequestsHTTPError,
+        ConnectionError=_RequestsConnectionError,
+        Timeout=_RequestsTimeout,
+    ),
+    get=_namespace_get,
+    post=_namespace_post,
+    put=_namespace_put,
+    delete=_namespace_delete,
+)
 
 
