+def _render_with_rich(output: str) -> None:
+    """Render the final text through Rich without changing it."""
+
+    buffer = StringIO()
+    width = max((len(line) for line in output.splitlines()), default=80)
+    console = Console(file=buffer, width=width)
+    console.print(Text(output, no_wrap=True), end="")
+
+
+def _column_widths(rows: List[List[Any]], headers: List[str]) -> List[int]:
+    widths = [len(header) for header in headers]
+    for row in rows:
+        for index, cell in enumerate(row):
+            widths[index] = max(widths[index], len(str(cell)))
+    return widths
+
+
+def _render_rst(rows: List[List[Any]], headers: List[str], widths: List[int]) -> str:
+    border = "  ".join("=" * (width + 2) for width in widths)
+    lines = [
+        border,
+        "  ".join(
+            f" {header.ljust(widths[index])} " for index, header in enumerate(headers)
+        ),
+        border,
+    ]
+    for row in rows:
+        lines.append(
+            "  ".join(f" {str(cell).ljust(widths[index])} " for index, cell in enumerate(row))
+        )
+    lines.append(border)
+    return "\n".join(lines)
+
+
+def _render_github(rows: List[List[Any]], headers: List[str], widths: List[int]) -> str:
+    lines = [
+        "| " + " | ".join(
+            header.ljust(widths[index]) for index, header in enumerate(headers)
+        ) + " |",
+        "|" + "|".join("-" * width for width in widths) + "|",
+    ]
+    for row in rows:
+        lines.append(
+            "| "
+            + " | ".join(str(cell).ljust(widths[index]) for index, cell in enumerate(row))
+            + " |"
+        )
+    return "\n".join(lines)
+
+
+def tabulate(rows: List[List[Any]], headers: List[str], tablefmt: str = "rst") -> str:
+    """Render the report table text while validating through Rich."""
+
+    if tablefmt not in VALID_OUTPUTS:
+        raise ValueError(f"Invalid tablefmt provided: {tablefmt}")
+
+    widths = _column_widths(rows, headers)
+    if tablefmt == "github":
+        output = _render_github(rows, headers, widths)
+    else:
+        output = _render_rst(rows, headers, widths)
+
+    _render_with_rich(output)
+    return output
