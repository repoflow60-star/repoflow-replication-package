+def _ensure_reactor():
+    global _reactor_thread
+    if reactor.running:
+        return
+
+    with _reactor_mutex:
+        if reactor.running:
+            return
+        if _reactor_thread and _reactor_thread.is_alive():
+            return
+
+        def run_reactor():
+            reactor.run(installSignalHandlers=False)
+
+        _reactor_thread = threading.Thread(target=run_reactor, daemon=True)
+        _reactor_thread.start()
+        deadline = time.monotonic() + 5
+        while not reactor.running and _reactor_thread.is_alive():
+            if time.monotonic() >= deadline:
+                break
+            time.sleep(0.01)
+
+        if not reactor.running:
+            raise RuntimeError('Twisted reactor failed to start')
+
+
+@defer.inlineCallbacks
+def _treq_post(url, data, headers, timeout):
+    response = yield treq.post(url, data=data, headers=headers, timeout=timeout)
+    body = yield treq.content(response)
+    return _Response(response, body)
+
+
+def _header_value(value):
+    if isinstance(value, bytes):
+        return value.decode('latin1')
+    return value
+
+
+def _headers_to_dict(headers):
+    parsed = {}
+    if hasattr(headers, 'getAllRawHeaders'):
+        for key, values in headers.getAllRawHeaders():
+            if not values:
+                continue
+            parsed[_header_value(key).lower()] = _header_value(values[0])
+    return parsed
+
+
+class _ResponseHeaders(object):
+    def __init__(self, headers):
+        self._headers = headers
+
+    def get(self, key, default=None):
+        return self._headers.get(key.lower(), default)
+
+
+class _Response(object):
+    def __init__(self, response, body):
+        self.status_code = response.code
+        reason = getattr(response, 'phrase', None)
+        self.reason = _header_value(reason) if reason else HTTP_STATUS_REASONS.get(
+            self.status_code, '')
+        self.headers = _ResponseHeaders(_headers_to_dict(response.headers))
+        self._body = body or b''
+        self.content = self._body
+        self.text = self._body.decode('utf-8', 'replace')
+
+    def json(self):
+        return json.loads(self.text)
+
