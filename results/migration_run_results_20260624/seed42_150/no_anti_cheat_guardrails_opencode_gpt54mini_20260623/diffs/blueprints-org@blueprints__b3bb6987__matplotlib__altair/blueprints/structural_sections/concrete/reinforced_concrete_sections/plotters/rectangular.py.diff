+
+    def _build_altair_chart(
+        self,
+        title: str | None = None,
+        font_size_title: float = 18.0,
+        font_size_legend: float = 10.0,
+        include_legend: bool = True,
+        custom_text_legend: str | None = None,
+    ) -> alt.TopLevelMixin:
+        """Build an Altair chart representation of the cross-section."""
+        width = float(self.cross_section.width)
+        height = float(self.cross_section.height)
+        x_domain = (-width, width * 2.5)
+        y_domain = (-height * 0.9, height * 0.9)
+
+        layers: list[alt.Chart] = [
+            alt.Chart(
+                [
+                    {
+                        "x": -width / 2,
+                        "x2": width / 2,
+                        "y": -height / 2,
+                        "y2": height / 2,
+                    },
+                ],
+            )
+            .mark_rect(stroke="black", strokeWidth=1, color=RCS_CROSS_SECTION_COLOR)
+            .encode(
+                x=alt.X("x:Q", scale=alt.Scale(domain=x_domain), axis=None),
+                x2="x2:Q",
+                y=alt.Y("y:Q", scale=alt.Scale(domain=y_domain), axis=None),
+                y2="y2:Q",
+            ),
+        ]
+
+        if self.cross_section.longitudinal_rebars:
+            layers.append(
+                alt.Chart(
+                    [
+                        {"x": rebar.x, "y": rebar.y, "size": max((rebar.radius * 2) ** 2, 40.0)}
+                        for rebar in self.cross_section.longitudinal_rebars
+                    ],
+                )
+                .mark_circle(color=REBAR_COLOR, stroke="black", strokeWidth=1)
+                .encode(
+                    x=alt.X("x:Q", scale=alt.Scale(domain=x_domain), axis=None),
+                    y=alt.Y("y:Q", scale=alt.Scale(domain=y_domain), axis=None),
+                    size=alt.Size("size:Q", legend=None),
+                ),
+            )
+
+        if include_legend:
+            legend_text = custom_text_legend or self.legend_text()
+            if legend_text:
+                layers.append(
+                    alt.Chart(
+                        [
+                            {
+                                "x": (width / 2) * 1.05,
+                                "y": -height / 2,
+                                "label": legend_text,
+                            },
+                        ],
+                    )
+                    .mark_text(color="black", fontSize=font_size_legend, align="left", baseline="bottom")
+                    .encode(
+                        x=alt.X("x:Q", scale=alt.Scale(domain=x_domain), axis=None),
+                        y=alt.Y("y:Q", scale=alt.Scale(domain=y_domain), axis=None),
+                        text="label:N",
+                    ),
+                )
+
+        chart: alt.TopLevelMixin = alt.layer(*layers).resolve_scale(x="shared", y="shared").properties(
+            width=int(width),
+            height=int(height),
+        )
+        if title is not None:
+            chart = chart.properties(title=title)
+        return chart.configure_title(fontSize=font_size_title).configure_view(stroke=None).configure_axis(
+            domain=False,
+            grid=False,
+            labels=False,
+            ticks=False,
+        )
 
