--- a/appstoreserverlibrary/_treq_support.py
+++ b/appstoreserverlibrary/_treq_support.py
@@ -0,0 +1,135 @@
+# Copyright (c) 2023 Apple Inc. Licensed under MIT License.
+
+from dataclasses import dataclass
+import json as json_module
+import threading
+from typing import Any, Dict, Optional
+
+import treq
+from twisted.python.failure import Failure
+
+
+@dataclass(frozen=True)
+class TreqResponse:
+    status_code: int
+    headers: Dict[str, str]
+    content: bytes
+
+    def json(self) -> Any:
+        return json_module.loads(self.content.decode("utf-8"))
+
+
+_reactor_lock = threading.Lock()
+_reactor_started = False
+_reactor = None
+
+
+def _get_reactor():
+    global _reactor
+    if _reactor is None:
+        from twisted.internet import reactor as twisted_reactor
+
+        _reactor = twisted_reactor
+    return _reactor
+
+
+def _normalize_headers(headers) -> Dict[str, str]:
+    normalized: Dict[str, str] = {}
+    if hasattr(headers, "getAllRawHeaders"):
+        for name, values in headers.getAllRawHeaders():
+            key = name.decode("latin-1") if isinstance(name, bytes) else str(name)
+            if values:
+                value = values[0]
+                normalized[key.lower()] = value.decode("latin-1") if isinstance(value, bytes) else str(value)
+    else:
+        for name, value in headers.items():
+            key = name.decode("latin-1") if isinstance(name, bytes) else str(name)
+            normalized[key.lower()] = value.decode("latin-1") if isinstance(value, bytes) else str(value)
+    return normalized
+
+
+def _ensure_reactor_running() -> None:
+    global _reactor_started
+    reactor = _get_reactor()
+    if reactor.running:
+        _reactor_started = True
+        return
+
+    with _reactor_lock:
+        if _reactor_started:
+            return
+
+        started = threading.Event()
+        startup_error = {}
+
+        def _run() -> None:
+            try:
+                reactor.callWhenRunning(started.set)
+                reactor.run(installSignalHandlers=False)
+            except BaseException as exc:
+                startup_error["error"] = exc
+                started.set()
+
+        thread = threading.Thread(target=_run, name="treq-reactor", daemon=True)
+        thread.start()
+        started.wait()
+        if "error" in startup_error:
+            raise startup_error["error"]
+        _reactor_started = True
+
+
+def blocking_request(
+    method: str,
+    url: str,
+    params: Optional[Dict[str, Any]],
+    headers: Dict[str, str],
+    body: Optional[bytes],
+) -> TreqResponse:
+    _ensure_reactor_running()
+    reactor = _get_reactor()
+
+    done = threading.Event()
+    outcome = {}
+
+    def _request() -> None:
+        try:
+            deferred = treq.request(method, url, params=params, headers=headers, data=body)
+        except BaseException as exc:
+            outcome["error"] = exc
+            done.set()
+            return
+
+        def _on_response(response) -> None:
+            try:
+                content_deferred = treq.content(response)
+            except BaseException as exc:
+                outcome["error"] = exc
+                done.set()
+                return
+
+            def _on_content(content: bytes) -> None:
+                outcome["response"] = TreqResponse(response.code, _normalize_headers(response.headers), content)
+                done.set()
+
+            def _on_content_error(failure: Failure) -> None:
+                outcome["error"] = failure
+                done.set()
+
+            content_deferred.addCallbacks(_on_content, _on_content_error)
+
+        def _on_error(failure: Failure) -> None:
+            outcome["error"] = failure
+            done.set()
+
+        deferred.addCallbacks(_on_response, _on_error)
+
+    reactor.callFromThread(_request)
+    done.wait()
+
+    if "error" in outcome:
+        error = outcome["error"]
+        if isinstance(error, Failure):
+            error.raiseException()
+        raise error
+
+    return outcome["response"]
