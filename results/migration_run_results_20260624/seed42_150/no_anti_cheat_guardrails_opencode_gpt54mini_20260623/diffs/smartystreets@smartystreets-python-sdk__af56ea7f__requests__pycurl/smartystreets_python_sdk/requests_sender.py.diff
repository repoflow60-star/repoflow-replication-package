+class _PycurlSession:
+    def send(self, request, timeout=None, proxy=None):
+        import pycurl
+
+        response_body = BytesIO()
+        response_headers = OrderedDict()
+        curl = pycurl.Curl()
+
+        try:
+            curl.setopt(pycurl.URL, request.url)
+            if timeout is not None:
+                curl.setopt(pycurl.TIMEOUT, timeout)
+                curl.setopt(pycurl.CONNECTTIMEOUT, timeout)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, lambda header_line: capture_header(header_line, response_headers))
+
+            if request.headers:
+                curl.setopt(pycurl.HTTPHEADER, ['{}: {}'.format(header, value) for header, value in request.headers.items()])
+
+            if proxy is not None:
+                configure_proxy(curl, proxy, pycurl)
+
+            if request.method == 'POST':
+                curl.setopt(pycurl.POST, 1)
+                body = request.body if request.body is not None else request.data
+                if body is not None:
+                    if not isinstance(body, bytes):
+                        body = body.encode('utf-8')
+                    curl.setopt(pycurl.POSTFIELDS, body)
+                    curl.setopt(pycurl.POSTFIELDSIZE, len(body))
+            else:
+                curl.setopt(pycurl.HTTPGET, 1)
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            payload = decode_response_body(response_body.getvalue())
+            return Response(payload, status_code, response_headers)
+        finally:
+            curl.close()
 
 
