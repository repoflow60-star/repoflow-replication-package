+def capture_header(header_line, response_headers):
+    original_length = len(header_line)
+    if not header_line:
+        return original_length
+
+    if isinstance(header_line, bytes):
+        header_line = header_line.decode('iso-8859-1')
+
+    header_line = header_line.strip()
+    if not header_line or header_line.startswith('HTTP/'):
+        return original_length
+
+    if ':' in header_line:
+        header, value = header_line.split(':', 1)
+        response_headers[header.strip()] = value.strip()
+
+    return original_length
+
+
+def decode_response_body(body):
+    if isinstance(body, bytes):
+        return body.decode('utf-8')
+    return body
+
+
+def configure_proxy(curl, proxy, pycurl_module):
+    proxy_host = proxy.host
+    if proxy.host == 'http://' or proxy.host == 'https://':
+        raise smarty.exceptions.SmartyException('Proxy must have a valid host (including port)')
+
+    if '://' in proxy_host:
+        scheme, proxy_host = proxy_host.split('://', 1)
+        if scheme == 'https':
+            curl.setopt(pycurl_module.PROXYTYPE, pycurl_module.PROXYTYPE_HTTPS)
+
+    curl.setopt(pycurl_module.PROXY, proxy_host)
+
+    if proxy.username:
+        curl.setopt(pycurl_module.PROXYUSERPWD, '{}:{}'.format(proxy.username, proxy.password))
