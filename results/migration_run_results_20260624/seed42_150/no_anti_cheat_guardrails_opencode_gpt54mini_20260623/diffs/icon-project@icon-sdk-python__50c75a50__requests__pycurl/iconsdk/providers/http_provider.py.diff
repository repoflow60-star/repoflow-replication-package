+    def _make_post_request(request_url: str, data: dict, **kwargs) -> _PycurlResponse:
+        timeout = kwargs.pop('timeout', 10)
+        allow_redirects = kwargs.pop('allow_redirects', True)
+        verify = kwargs.pop('verify', True)
+        headers = kwargs.pop('headers', {})
+        auth = kwargs.pop('auth', None)
+        cert = kwargs.pop('cert', None)
+        proxies = kwargs.pop('proxies', None)
+
+        payload = json.dumps(data).encode('utf-8')
+        response_body = BytesIO()
+        parsed_url = urlparse(request_url)
+
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, request_url)
+            curl.setopt(pycurl.POST, 1)
+            curl.setopt(pycurl.POSTFIELDS, payload)
+            curl.setopt(pycurl.POSTFIELDSIZE, len(payload))
+            curl.setopt(pycurl.WRITEDATA, response_body)
+            curl.setopt(pycurl.TIMEOUT_MS, int(timeout * 1000))
+            curl.setopt(pycurl.CONNECTTIMEOUT_MS, int(timeout * 1000))
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1 if allow_redirects else 0)
+
+            if parsed_url.scheme == 'https':
+                if verify is False:
+                    curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+                    curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+                else:
+                    curl.setopt(pycurl.SSL_VERIFYPEER, 1)
+                    curl.setopt(pycurl.SSL_VERIFYHOST, 2)
+                    if isinstance(verify, str):
+                        curl.setopt(pycurl.CAINFO, verify)
+
+            if headers:
+                curl.setopt(pycurl.HTTPHEADER, [f'{key}: {value}' for key, value in headers.items()])
+
+            if auth is not None:
+                curl.setopt(pycurl.USERPWD, f'{auth[0]}:{auth[1]}')
+                curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+
+            if cert is not None:
+                if isinstance(cert, tuple):
+                    curl.setopt(pycurl.SSLCERT, cert[0])
+                    curl.setopt(pycurl.SSLKEY, cert[1])
+                else:
+                    curl.setopt(pycurl.SSLCERT, cert)
+
+            if proxies:
+                proxy = proxies if isinstance(proxies, str) else proxies.get(parsed_url.scheme) or proxies.get('all')
+                if proxy:
+                    curl.setopt(pycurl.PROXY, proxy)
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            return _PycurlResponse(response_body.getvalue(), status_code)
+        except pycurl.error as e:
+            raise URLException(str(e))
+        finally:
+            curl.close()
 
