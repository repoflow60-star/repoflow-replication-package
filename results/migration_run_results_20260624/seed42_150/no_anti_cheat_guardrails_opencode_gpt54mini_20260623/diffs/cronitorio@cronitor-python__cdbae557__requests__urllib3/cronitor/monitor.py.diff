+class _RetryingHTTPClient(object):
+    def __init__(self, pool):
+        self._pool = pool
+
+    def get(self, url, **kwargs):
+        return self._request('GET', url, **kwargs)
+
+    def put(self, url, **kwargs):
+        return self._request('PUT', url, **kwargs)
+
+    def delete(self, url, **kwargs):
+        return self._request('DELETE', url, **kwargs)
+
+    def _request(self, method, url, auth=None, headers=None, params=None, data=None, timeout=None):
+        request_headers = {k: v for k, v in (headers or {}).items() if v is not None}
+        if auth:
+            request_headers['Authorization'] = _basic_auth_header(*auth)
+
+        if params is not None:
+            query = _encode_params(params)
+            if query:
+                url = '{}?{}'.format(url, query)
+
+        if isinstance(data, str):
+            data = data.encode('utf-8')
+
+        response = self._pool.request(
+            method,
+            url,
+            body=data,
+            headers=request_headers,
+            timeout=timeout,
+        )
+        return _HTTPResponseAdapter(response)
+
+
+class _HTTPResponseAdapter(object):
+    def __init__(self, response):
+        self._response = response
+
+    @property
+    def status_code(self):
+        status = getattr(self._response, 'status_code', None)
+        if status is not None:
+            return status
+        return getattr(self._response, 'status', None)
+
+    @property
+    def status(self):
+        return self.status_code
+
+    @property
+    def headers(self):
+        return getattr(self._response, 'headers', {})
+
+    @property
+    def data(self):
+        if hasattr(self._response, 'data'):
+            return self._response.data
+        return getattr(self._response, 'content', None)
+
+    @property
+    def content(self):
+        return self.data
+
+    @property
+    def ok(self):
+        return self.status_code < 400
+
+    def __bool__(self):
+        return self.ok
+
+    @property
+    def text(self):
+        data = self.data or b''
+        if isinstance(data, bytes):
+            return data.decode('utf-8')
+        return data
+
+    def json(self):
+        response_json = getattr(self._response, 'json', None)
+        if callable(response_json):
+            return response_json()
+        return json.loads(self.text)
+
+
+def _encode_params(params):
+    from urllib.parse import urlencode
+
+    clean_params = {k: v for k, v in params.items() if v is not None}
+    return urlencode(clean_params, doseq=True)
+
+
+def _basic_auth_header(username, password):
