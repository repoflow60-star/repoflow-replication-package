--- a/ldnlib/http.py
+++ b/ldnlib/http.py
@@ -0,0 +1,142 @@
+import io
+import json
+
+import pycurl
+
+
+class HTTPError(Exception):
+
+    def __init__(self, status_code, url):
+        super().__init__("{} Error for url: {}".format(status_code, url))
+        self.status_code = status_code
+        self.url = url
+
+
+class Response(object):
+
+    def __init__(self, url, status_code, headers, body):
+        self.url = url
+        self.status_code = status_code
+        self.headers = headers
+        self._body = body
+        self.links = _parse_links(headers.get('link', ''))
+
+    @property
+    def text(self):
+        charset = 'utf-8'
+        content_type = self.headers.get('content-type', '')
+        for part in content_type.split(';')[1:]:
+            part = part.strip()
+            if part.lower().startswith('charset='):
+                charset = part.split('=', 1)[1].strip()
+                break
+        return self._body.decode(charset, errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise HTTPError(self.status_code, self.url)
+
+
+def _parse_links(link_header):
+    links = {}
+    if not link_header:
+        return links
+
+    for chunk in link_header.split(','):
+        chunk = chunk.strip()
+        if not chunk.startswith('<'):
+            continue
+
+        url, _, params = chunk.partition('>')
+        url = url[1:]
+        link_info = {'url': url}
+        for param in params.split(';'):
+            param = param.strip()
+            if '=' not in param:
+                continue
+            key, value = param.split('=', 1)
+            link_info[key.strip()] = value.strip().strip('"')
+
+        rel = link_info.get('rel')
+        if rel:
+            for rel_name in rel.split():
+                links[rel_name] = link_info
+
+    return links
+
+
+def _parse_headers(raw_headers):
+    headers = {}
+    for line in raw_headers.splitlines():
+        if not line or line.startswith('HTTP/'):
+            continue
+        if ':' not in line:
+            continue
+        key, value = line.split(':', 1)
+        key = key.strip().lower()
+        value = value.strip()
+        if key in headers:
+            headers[key] = headers[key] + ', ' + value
+        else:
+            headers[key] = value
+    return headers
+
+
+def request(method, url, **kwargs):
+    headers = dict(kwargs.pop('headers', {}) or {})
+    data = kwargs.pop('data', None)
+    auth = kwargs.pop('auth', None)
+    allow_redirects = kwargs.pop('allow_redirects', True)
+    timeout = kwargs.pop('timeout', None)
+    verify = kwargs.pop('verify', True)
+
+    body_buffer = io.BytesIO()
+    header_buffer = io.BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEFUNCTION, body_buffer.write)
+        curl.setopt(pycurl.HEADERFUNCTION, header_buffer.write)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1 if allow_redirects else 0)
+
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT, timeout)
+
+        if not verify:
+            curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+            curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+
+        if auth is not None:
+            curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+            curl.setopt(pycurl.USERPWD, "{}:{}".format(auth[0], auth[1]))
+
+        header_list = ["{}: {}".format(key, value) for key, value in headers.items()]
+        if header_list:
+            curl.setopt(pycurl.HTTPHEADER, header_list)
+
+        method = method.upper()
+        if method == 'HEAD':
+            curl.setopt(pycurl.NOBODY, 1)
+            curl.setopt(pycurl.CUSTOMREQUEST, 'HEAD')
+        elif method == 'GET':
+            curl.setopt(pycurl.HTTPGET, 1)
+        elif method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+        else:
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+        if data is not None:
+            payload = data.encode('utf-8') if isinstance(data, str) else data
+            curl.setopt(pycurl.POSTFIELDS, payload)
+            curl.setopt(pycurl.POSTFIELDSIZE, len(payload))
+
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        effective_url = curl.getinfo(pycurl.EFFECTIVE_URL)
+        response_headers = _parse_headers(header_buffer.getvalue().decode('iso-8859-1'))
+        return Response(effective_url, status_code, response_headers, body_buffer.getvalue())
+    finally:
+        curl.close()
