+class _Urllib3Response:
+    def __init__(self, response):
+        self._response = response
+        self.headers = response.headers
+        self.content = response.data
+        self.text = response.data.decode('utf-8', errors='replace')
+
+    def raise_for_status(self):
+        if getattr(self._response, 'status', 0) >= 400:
+            reason = getattr(self._response, 'reason', '')
+            message = f'{self._response.status} {reason}'.strip()
+            raise urllib3.exceptions.HTTPError(message)
+
+
+def _create_manager(verify: bool, proxies: dict | None):
+    cert_reqs = ssl.CERT_REQUIRED if verify else ssl.CERT_NONE
+
+    if proxies:
+        proxy_url = proxies.get('https') or proxies.get('http')
+        if proxy_url:
+            if proxy_url.startswith('socks'):
+                from urllib3.contrib.socks import SOCKSProxyManager
+
+                return SOCKSProxyManager(proxy_url, cert_reqs=cert_reqs)
+            return urllib3.ProxyManager(proxy_url, cert_reqs=cert_reqs)
+
+    return urllib3.PoolManager(cert_reqs=cert_reqs)
+
+
+class _Urllib3Session:
+    def __init__(self):
+        self._managers = {}
+
+    def _manager_key(self, verify: bool, proxies: dict | None):
+        if proxies:
+            return verify, proxies.get('https') or proxies.get('http')
+        return verify, None
+
+    def _get_manager(self, verify: bool, proxies: dict | None):
+        key = self._manager_key(verify, proxies)
+        if key not in self._managers:
+            self._managers[key] = _create_manager(verify, proxies)
+        return self._managers[key]
+
+    def request(self, method, url, **kwargs):
+        manager = self._get_manager(
+            kwargs.pop('verify', True),
+            kwargs.pop('proxies', None),
+        )
+        response = manager.request(
+            method,
+            url,
+            body=kwargs.pop('data', None),
+            headers=kwargs.pop('headers', None),
+        )
+        return _Urllib3Response(response)
+
+    def get(self, url, **kwargs):
+        return self.request('GET', url, **kwargs)
+
+    def post(self, url, **kwargs):
+        return self.request('POST', url, **kwargs)
+
+
+REQ_SESSION = _Urllib3Session()
 
