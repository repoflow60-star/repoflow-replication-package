--- a/requests.py
+++ b/requests.py
@@ -0,0 +1,39 @@
+import json
+from urllib.parse import urlencode
+
+import urllib3
+
+
+_HTTP = urllib3.PoolManager()
+
+
+class _Response(object):
+    def __init__(self, response):
+        self._response = response
+        self.data = response.data
+        self.content = response.data
+        self.text = response.data.decode('utf-8')
+        self.status_code = response.status
+        self.headers = response.headers
+
+    def json(self):
+        return json.loads(self.data.decode('utf-8'))
+
+
+def _request(method, url, params=None, headers=None):
+    query = urlencode([(key, value) for key, value in (params or {}).items()
+                       if value is not None], doseq=True)
+    request_url = '{}?{}'.format(url, query) if query else url
+    return _Response(_HTTP.request(method, request_url, headers=headers))
+
+
+def get(url, params=None, headers=None):
+    return _request('GET', url, params=params, headers=headers)
+
+
+def post(url, params=None, headers=None):
+    return _request('POST', url, params=params, headers=headers)
+
+
+def delete(url, params=None, headers=None):
+    return _request('DELETE', url, params=params, headers=headers)
