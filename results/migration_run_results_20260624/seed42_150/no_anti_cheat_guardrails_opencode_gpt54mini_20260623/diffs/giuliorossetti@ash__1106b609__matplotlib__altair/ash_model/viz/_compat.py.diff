--- a/ash_model/viz/_compat.py
+++ b/ash_model/viz/_compat.py
@@ -0,0 +1,37 @@
+from types import SimpleNamespace
+from typing import Any
+
+
+class Axes:
+    def __init__(self, chart: Any):
+        self.chart = chart
+
+    def to_dict(self, *args, **kwargs):
+        return self.chart.to_dict(*args, **kwargs)
+
+    def save(self, *args, **kwargs):
+        return self.chart.save(*args, **kwargs)
+
+    def display(self, *args, **kwargs):
+        return self.chart.display(*args, **kwargs)
+
+    def __add__(self, other):
+        other_chart = other.chart if isinstance(other, Axes) else other
+        return Axes(self.chart + other_chart)
+
+    def __radd__(self, other):
+        other_chart = other.chart if isinstance(other, Axes) else other
+        return Axes(other_chart + self.chart)
+
+    def __getattr__(self, name):
+        return getattr(self.chart, name)
+
+    def __repr__(self):
+        return repr(self.chart)
+
+
+def wrap_chart(chart: Any) -> Axes:
+    return Axes(chart)
+
+
+plt = SimpleNamespace(Axes=Axes)
