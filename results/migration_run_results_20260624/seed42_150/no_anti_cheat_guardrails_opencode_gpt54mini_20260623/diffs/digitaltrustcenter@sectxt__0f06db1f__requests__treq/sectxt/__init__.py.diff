+        "timeout": 5,
+    }
+    agent = _HTTPS_AGENT if verify else _INSECURE_HTTPS_AGENT
+
+    try:
+        response = await treq.request("GET", url, agent=agent, **request_kwargs)
+    except TypeError:
+        response = await treq.request("GET", url, **request_kwargs)
+    content = await treq.content(response)
+    return response, content
 
 
