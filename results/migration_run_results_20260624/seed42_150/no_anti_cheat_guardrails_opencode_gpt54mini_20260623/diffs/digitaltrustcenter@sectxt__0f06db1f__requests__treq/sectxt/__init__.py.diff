+def _response_status(response) -> Optional[int]:
+    return getattr(response, "status_code", getattr(response, "code", None))
+
+
+def _response_history(response):
+    return getattr(response, "history", None) or []
+
+
+def _response_url(response, fallback: str) -> str:
+    return getattr(response, "url", fallback)
+
+
+def _response_header(headers, name: str):
+    if headers is None:
+        return None
+    if hasattr(headers, "getRawHeaders"):
+        values = headers.getRawHeaders(name)
+        if not values:
+            values = headers.getRawHeaders(name.encode("ascii"))
+        if values:
+            value = values[0]
+            if isinstance(value, bytes):
+                return value.decode("latin1")
+            return value
+    if hasattr(headers, "get"):
+        value = headers.get(name)
+        if value is not None:
+            if isinstance(value, bytes):
+                return value.decode("latin1")
+            return value
+    try:
+        value = headers[name]
+    except Exception:
+        return None
+    if isinstance(value, bytes):
+        return value.decode("latin1")
+    return value
+
+
+def _is_ssl_error(exc: Exception) -> bool:
+    pending = [exc]
+    seen = set()
+    while pending:
+        current = pending.pop()
+        if id(current) in seen:
+            continue
+        seen.add(id(current))
+        if isinstance(current, (OpenSSLError, TwistedSSLError, CertificateError)):
+            return True
+        value = getattr(current, "value", None)
+        if isinstance(value, BaseException):
+            pending.append(value)
+        reasons = getattr(current, "reasons", None)
+        if reasons:
+            pending.extend(reason for reason in reasons if reason is not None)
+        args = getattr(current, "args", ())
+        for part in args:
+            if isinstance(part, BaseException):
+                pending.append(part)
+        name = current.__class__.__name__.lower()
+        if "ssl" in name or "certificate" in name:
+            return True
+        cause = getattr(current, "__cause__", None)
+        context = getattr(current, "__context__", None)
+        if cause is not None:
+            pending.append(cause)
+        if context is not None:
+            pending.append(context)
+    return False
+
