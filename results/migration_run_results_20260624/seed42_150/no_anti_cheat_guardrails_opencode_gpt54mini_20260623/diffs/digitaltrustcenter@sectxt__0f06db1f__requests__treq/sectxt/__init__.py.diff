+
+def _ensure_reactor_running():
+    global _REACTOR_THREAD_STARTED
+    if _REACTOR_THREAD_STARTED:
+        if reactor.running:
+            _REACTOR_READY.set()
+        return
+    with _REACTOR_THREAD_LOCK:
+        if _REACTOR_THREAD_STARTED:
+            if reactor.running:
+                _REACTOR_READY.set()
+            return
+        if not reactor.running:
+            def _run_reactor():
+                reactor.callWhenRunning(_REACTOR_READY.set)
+                reactor.run(installSignalHandlers=False)
+
+            thread = threading.Thread(target=_run_reactor, daemon=True)
+            thread.start()
+            _REACTOR_READY.wait()
+        _REACTOR_THREAD_STARTED = True
+
+
+_HTTPS_AGENT = Agent(reactor, contextFactory=BrowserLikePolicyForHTTPS())
+_INSECURE_HTTPS_AGENT = Agent(reactor, contextFactory=ClientContextFactory())
+
+
+def _run_async(coro):
+    _ensure_reactor_running()
+    return threads.blockingCallFromThread(reactor, lambda: defer.ensureDeferred(coro))
