+_reactor_lock = Lock()
+_reactor_ready = Event()
+
+
+def _ensure_reactor_running():
+    if reactor.running:
+        _reactor_ready.set()
+        return
+    with _reactor_lock:
+        if _reactor_ready.is_set():
+            return
+
+        def run_reactor():
+            reactor.callWhenRunning(_reactor_ready.set)
+            reactor.run(installSignalHandlers=False)
+
+        Thread(target=run_reactor, daemon=True).start()
+    _reactor_ready.wait()
+
+
+def _call_in_reactor(func, *args, **kwargs):
+    _ensure_reactor_running()
+    return threads.blockingCallFromThread(reactor, func, *args, **kwargs)
+
+
+def _response_code(response):
+    # Prefer explicitly set attributes so test mocks don't fake a `code` attr.
+    attrs = getattr(response, '__dict__', {})
+    if 'status_code' in attrs:
+        return attrs['status_code']
+    if 'code' in attrs:
+        return attrs['code']
+    return getattr(response, 'status_code', getattr(response, 'code', None))
+
+
+def _response_json(response):
+    json_method = getattr(response, 'json', None)
+    if callable(json_method):
+        return json_method()
+    return json.loads(_call_in_reactor(requests.content, response).decode())
 
 
