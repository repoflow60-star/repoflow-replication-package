+    def __raise_response_error(self, error, not_found=False, invalid_json=False, unauthorized=False):
+        response = getattr(error, 'response', None)
+        status = getattr(response, 'status_code', None)
+        if response is None:
+            raise ConnectionUnavailableError(error) from None
+        if status == 400 and invalid_json:
+            raise InvalidJsonError(
+                message=self.parse_response_message(response),
+                status=status
+            ) from None
+        if status == 401 and unauthorized:
+            raise UnauthorizedError(
+                message=self.parse_response_message(response),
+                status=status
+            ) from None
+        if status == 404 and not_found:
+            raise NotFoundError(
+                message=self.parse_response_message(response),
+                status=status
+            ) from None
+        if status is not None and status >= 400:
+            raise HttpError(
+                message=self.parse_response_message(response),
+                status=status
+            ) from None
+        raise ConnectionUnavailableError(error) from None
