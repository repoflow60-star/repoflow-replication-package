+from twisted.internet import reactor
+from twisted.internet.defer import inlineCallbacks
+from twisted.internet.threads import blockingCallFromThread
+
+import treq
+
+
+def _reason_text(response):
+    reason = getattr(response, 'phrase', None)
+    if reason is None:
+        reason = getattr(response, 'reason', '')
+    if hasattr(reason, 'decode'):
+        return reason.decode('utf-8', 'replace')
+    return reason
+
+
+def request(url):
+    @inlineCallbacks
+    def fetch():
+        response = yield treq.get(url)
+        content = yield treq.content(response)
+        return response.code, _reason_text(response), content
+
+    return blockingCallFromThread(reactor, fetch)
