+def _proxy_url(proxies):
+    if not proxies:
+        return None
+    if isinstance(proxies, dict):
+        proxies = proxies.get('https') or proxies.get('http')
+    if not proxies:
+        return None
+    if '://' not in proxies:
+        return 'http://' + proxies
+    return proxies
+
+
+class _Response(object):
+
+    def __init__(self, status_code, headers, reason, text):
+        self.status_code = status_code
+        self.headers = headers
+        self.reason = reason
+        self.text = text
+
+    def json(self):
+        return json.loads(self.text)
+
+
+class _Session(object):
+
+    async def _post(self, url, data, headers, timeout, proxy=None):
+        timeout_config = None
+        if timeout is not None:
+            timeout_config = aiohttp.ClientTimeout(total=timeout)
+
+        session_kwargs = {}
+        if timeout_config is not None:
+            session_kwargs['timeout'] = timeout_config
+
+        async with aiohttp.ClientSession(**session_kwargs) as session:
+            request_kwargs = {
+                'data': data,
+                'headers': headers,
+            }
+            if proxy:
+                request_kwargs['proxy'] = proxy
+
+            async with session.post(url, **request_kwargs) as res:
+                text = await res.text()
+                return _Response(res.status, res.headers, res.reason, text)
+
+    def post(self, url, data=None, headers=None, timeout=None, proxies=None, **kwargs):
+        return asyncio.run(self._post(
+            url,
+            data,
+            headers,
+            timeout,
+            proxy=_proxy_url(proxies),
+        ))
+
+
+_session = _Session()
 
 
