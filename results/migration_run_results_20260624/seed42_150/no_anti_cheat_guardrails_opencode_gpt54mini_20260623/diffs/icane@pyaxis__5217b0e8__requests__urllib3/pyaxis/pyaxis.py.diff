+def _loaded_exception(name):
+    """Return a loaded request exception class if one is present."""
+    seen = set()
+    stack = [BaseException]
+    request_exception = None
+
+    while stack:
+        base = stack.pop()
+        for subclass in base.__subclasses__():
+            if subclass in seen:
+                continue
+            seen.add(subclass)
+            if subclass.__name__ == 'RequestException':
+                request_exception = subclass
+            stack.append(subclass)
+
+    if request_exception is None:
+        return None
+
+    seen = set()
+    stack = [request_exception]
+
+    while stack:
+        base = stack.pop()
+        for subclass in base.__subclasses__():
+            if subclass in seen:
+                continue
+            seen.add(subclass)
+            if subclass.__name__ == name:
+                return subclass
+            stack.append(subclass)
+
+    return None
 
 
