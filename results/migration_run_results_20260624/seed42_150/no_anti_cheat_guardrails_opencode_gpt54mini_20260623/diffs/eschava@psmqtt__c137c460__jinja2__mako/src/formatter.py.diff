+def _split_top_level(text: str, delimiter: str) -> list[str]:
+    parts = []
+    current = []
+    depth = 0
+    quote = None
+
+    for idx, ch in enumerate(text):
+        if quote is not None:
+            current.append(ch)
+            if ch == quote and (idx == 0 or text[idx - 1] != "\\"):
+                quote = None
+            continue
+
+        if ch in ('"', "'"):
+            quote = ch
+            current.append(ch)
+        elif ch in "([{":
+            depth += 1
+            current.append(ch)
+        elif ch in ")]}":
+            if depth > 0:
+                depth -= 1
+            current.append(ch)
+        elif ch == delimiter and depth == 0:
+            parts.append("".join(current))
+            current = []
+        else:
+            current.append(ch)
+
+    parts.append("".join(current))
+    return parts
+
+
+def _rewrite_expression(expr: str) -> str:
+    parts = _split_top_level(expr.strip(), "|")
+    if len(parts) == 1:
+        return parts[0].strip()
+
+    rewritten = parts[0].strip()
+    if not rewritten:
+        return expr.strip()
+
+    for filter_expr in parts[1:]:
+        filter_expr = filter_expr.strip()
+        match = re.fullmatch(r"([A-Za-z_]\w*)(?:\((.*)\))?", filter_expr, re.S)
+        if match is None:
+            return expr.strip()
+        name = match.group(1)
+        args = match.group(2)
+        if args is None or args.strip() == "":
+            rewritten = f"__formatter_filters.{name}({rewritten})"
+        else:
+            rewritten = f"__formatter_filters.{name}({rewritten}, {args.strip()})"
+
+    return rewritten
+
+
+def _to_mako_template(source: str) -> str:
+    return _TEMPLATE_EXPR_RE.sub(
+        lambda match: "${" + _rewrite_expression(match.group(1)) + "}",
+        source,
+    )
+
 
