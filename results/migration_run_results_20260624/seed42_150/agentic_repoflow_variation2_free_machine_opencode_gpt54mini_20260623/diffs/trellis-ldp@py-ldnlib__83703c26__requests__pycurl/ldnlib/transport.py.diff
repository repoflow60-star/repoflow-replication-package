--- a/ldnlib/transport.py
+++ b/ldnlib/transport.py
@@ -0,0 +1,135 @@
+import json
+from io import BytesIO
+
+import pycurl
+
+
+class HTTPError(Exception):
+    pass
+
+
+class Response(object):
+
+    def __init__(self, url, status_code, headers, body):
+        self.url = url
+        self.status_code = status_code
+        self.headers = headers
+        self._body = body
+        self.links = self._parse_links(headers.get('link', ''))
+
+    @property
+    def text(self):
+        content_type = self.headers.get('content-type', '')
+        charset = 'utf-8'
+        if 'charset=' in content_type:
+            charset = content_type.split('charset=', 1)[1].split(';', 1)[0].strip()
+        return self._body.decode(charset, errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise HTTPError('HTTP {} for {}'.format(self.status_code, self.url))
+
+    def _parse_links(self, header_value):
+        links = {}
+        if not header_value:
+            return links
+
+        for raw_link in header_value.split(','):
+            raw_link = raw_link.strip()
+            if not raw_link.startswith('<'):
+                continue
+            target, _, params = raw_link.partition('>')
+            target = target[1:]
+            rel = None
+            link_info = {'url': target}
+            for param in params.split(';'):
+                param = param.strip()
+                if not param or '=' not in param:
+                    continue
+                key, value = param.split('=', 1)
+                value = value.strip().strip('"')
+                if key == 'rel':
+                    rel = value
+                else:
+                    link_info[key] = value
+            if rel:
+                links[rel] = link_info
+        return links
+
+
+def request(method, url, **kwargs):
+    headers = kwargs.pop('headers', {}) or {}
+    data = kwargs.pop('data', None)
+    allow_redirects = kwargs.pop('allow_redirects', True)
+
+    buffer = BytesIO()
+    header_buffer = BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEDATA, buffer)
+        curl.setopt(pycurl.HEADERFUNCTION, header_buffer.write)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1 if allow_redirects else 0)
+        curl.setopt(pycurl.ACCEPT_ENCODING, "")
+
+        header_list = ['{}: {}'.format(key, value) for key, value in headers.items()]
+        if header_list:
+            curl.setopt(pycurl.HTTPHEADER, header_list)
+
+        method = method.upper()
+        if method == 'HEAD':
+            curl.setopt(pycurl.NOBODY, 1)
+            curl.setopt(pycurl.CUSTOMREQUEST, 'HEAD')
+        elif method == 'OPTIONS':
+            curl.setopt(pycurl.CUSTOMREQUEST, 'OPTIONS')
+        elif method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            if data is not None:
+                if isinstance(data, str):
+                    data = data.encode('utf-8')
+                curl.setopt(pycurl.POSTFIELDS, data)
+        elif method != 'GET':
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            if data is not None:
+                if isinstance(data, str):
+                    data = data.encode('utf-8')
+                curl.setopt(pycurl.POSTFIELDS, data)
+
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        response_headers = _parse_headers(header_buffer.getvalue().decode('iso-8859-1'))
+        return Response(url, status_code, response_headers, buffer.getvalue())
+    finally:
+        curl.close()
+
+
+def get(url, **kwargs):
+    return request('GET', url, **kwargs)
+
+
+def head(url, **kwargs):
+    return request('HEAD', url, **kwargs)
+
+
+def post(url, **kwargs):
+    return request('POST', url, **kwargs)
+
+
+def options(url, **kwargs):
+    return request('OPTIONS', url, **kwargs)
+
+
+def _parse_headers(raw_headers):
+    headers = {}
+    blocks = raw_headers.split('\r\n\r\n')
+    if len(blocks) == 1:
+        blocks = raw_headers.split('\n\n')
+    for line in blocks[-1].splitlines():
+        if ':' not in line:
+            continue
+        key, value = line.split(':', 1)
+        headers[key.strip().lower()] = value.strip()
+    return headers
