--- a/yarg/_curl.py
+++ b/yarg/_curl.py
@@ -0,0 +1,48 @@
+# -*- coding: utf-8 -*-
+
+import io
+import re
+
+import pycurl
+
+
+_STATUS_LINE = re.compile(r"^HTTP/\S+\s+\d+\s*(.*)$")
+
+
+class Response(object):
+    def __init__(self, status_code=0, reason="", content=b""):
+        self.status_code = status_code
+        self.reason = reason
+        self.content = content
+
+
+def _header_function(state):
+    def capture(line):
+        if isinstance(line, bytes):
+            text = line.decode("iso-8859-1", "replace").strip()
+        else:
+            text = line.strip()
+        if text.startswith("HTTP/"):
+            match = _STATUS_LINE.match(text)
+            state["reason"] = match.group(1) if match else ""
+        return len(line)
+
+    return capture
+
+
+def get(url):
+    body = io.BytesIO()
+    state = {'reason': ''}
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url.encode('utf-8') if isinstance(url, str) else url)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        curl.setopt(pycurl.WRITEFUNCTION, body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, _header_function(state))
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+    return Response(status_code=status_code,
+                    reason=state['reason'],
+                    content=body.getvalue())
