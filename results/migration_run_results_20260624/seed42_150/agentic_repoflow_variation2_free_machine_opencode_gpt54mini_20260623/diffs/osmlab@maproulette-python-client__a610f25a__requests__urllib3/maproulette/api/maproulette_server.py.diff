+class _Urllib3Session:
+    """Small session-like wrapper around urllib3's pool manager."""
+
+    def __init__(self, headers=None, verify=True, certs=None):
+        self.headers = headers if headers is not None else {}
+        self.verify = verify
+        self.cert = certs
+        self._pool = urllib3.PoolManager(**self._pool_kwargs(verify=verify, certs=certs))
+
+    @staticmethod
+    def _pool_kwargs(verify=True, certs=None):
+        pool_kwargs = {}
+        if verify is False:
+            pool_kwargs["cert_reqs"] = ssl.CERT_NONE
+        elif isinstance(verify, str):
+            pool_kwargs["cert_reqs"] = ssl.CERT_REQUIRED
+            pool_kwargs["ca_certs"] = verify
+        else:
+            pool_kwargs["cert_reqs"] = ssl.CERT_REQUIRED
+
+        if certs:
+            if isinstance(certs, tuple):
+                pool_kwargs["cert_file"] = certs[0]
+                if len(certs) > 1 and certs[1]:
+                    pool_kwargs["key_file"] = certs[1]
+            else:
+                pool_kwargs["cert_file"] = certs
+
+        return pool_kwargs
+
+    @staticmethod
+    def _with_params(url, params):
+        if not params:
+            return url
+        query = urlencode(params, doseq=True)
+        separator = "&" if "?" in url else "?"
+        return f"{url}{separator}{query}"
+
+    def request(self, method, url, params=None, json_body=None, files=None):
+        request_headers = dict(self.headers)
+        request_url = self._with_params(url, params)
+        request_kwargs = {"headers": request_headers}
+        if json_body is not None:
+            request_headers.setdefault("Content-Type", "application/json")
+            request_kwargs["body"] = json.dumps(json_body).encode("utf-8")
+        elif files is not None:
+            request_kwargs["fields"] = files
+            request_kwargs["encode_multipart"] = True
+        return self._pool.request(method, request_url, **request_kwargs)
+
+    def get(self, url, params=None):
+        return self.request("GET", url, params=params)
+
+    def post(self, url, params=None, json=None):
+        return self.request("POST", url, params=params, json_body=json)
+
+    def put(self, url, params=None, json=None, files=None):
+        return self.request("PUT", url, params=params, json_body=json, files=files)
+
+    def delete(self, url, params=None):
+        return self.request("DELETE", url, params=params)
+
+
+requests = SimpleNamespace(Session=_Urllib3Session)
 
 
