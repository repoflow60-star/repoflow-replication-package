 #!/usr/bin/env python3
 
 import random
+import threading
 
 import lxml.html as lh
-import requests
+import treq
+from twisted.internet import reactor, threads
+from twisted.web.client import ProxyAgent
 
 from fp.errors import FreeProxyException
+
+
+_reactor_thread = None
+_reactor_ready = threading.Event()
+
+
+def _ensure_reactor_running():
+    global _reactor_thread
+    if reactor.running:
+        return
+    if _reactor_thread is not None and _reactor_thread.is_alive():
+        _reactor_ready.wait()
+        return
+
+    _reactor_ready.clear()
+
+    def _run_reactor():
+        reactor.callWhenRunning(_reactor_ready.set)
+        reactor.run(installSignalHandlers=False)
+
+    _reactor_thread = threading.Thread(target=_run_reactor, daemon=True)
+    _reactor_thread.start()
+    _reactor_ready.wait()
+
+
+def _blocking_treq_get_content(url, timeout, agent=None):
+    _ensure_reactor_running()
+
+    def _request():
+        response_deferred = treq.get(url, agent=agent)
+        response_deferred.addTimeout(timeout, reactor)
+
+        def _read_content(response):
+            content_deferred = treq.content(response)
+            content_deferred.addTimeout(timeout, reactor)
+            return content_deferred
+
+        return response_deferred.addCallback(_read_content)
+
+    return threads.blockingCallFromThread(reactor, _request)
 
 
