+def _ensure_absolute_url(coguard_api_url: str) -> str:
+    if coguard_api_url.startswith(("http://", "https://")):
+        return coguard_api_url.rstrip("/")
+    return f"https://{coguard_api_url.strip('/')}"
+
+
+async def _resolve_token(auth_token: Token) -> str:
+    get_async = getattr(auth_token, "_get_token_async", None)
+    if callable(get_async):
+        token_candidate = get_async()
+        if inspect.isawaitable(token_candidate):
+            return await token_candidate
+    return auth_token.get_token()
 
