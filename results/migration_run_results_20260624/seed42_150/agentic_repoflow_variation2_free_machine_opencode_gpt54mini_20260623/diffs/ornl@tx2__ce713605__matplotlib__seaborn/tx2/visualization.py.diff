 _cached_wordclouds = {}
 
 
+def _facet_grid(labels, num_cols, height, aspect):
+    frame = pd.DataFrame({"facet": list(labels)})
+    grid = sns.FacetGrid(
+        frame,
+        col="facet",
+        col_wrap=num_cols,
+        sharex=False,
+        sharey=False,
+        height=height,
+        aspect=aspect,
+    )
+    axes = np.atleast_1d(grid.axes).ravel()
+    return grid, axes
+
