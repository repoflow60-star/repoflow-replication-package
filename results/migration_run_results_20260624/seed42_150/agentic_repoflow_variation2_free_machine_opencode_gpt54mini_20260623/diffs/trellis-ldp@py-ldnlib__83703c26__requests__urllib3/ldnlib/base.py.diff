 from rdflib import Graph, URIRef
-import requests
+from urllib3 import PoolManager
+from urllib3.exceptions import HTTPError
+from urllib3.util import make_headers
+
+
+class _HTTPResponseAdapter(object):
+
+    def __init__(self, response):
+        self._response = response
+        self.status_code = response.status
+        self.headers = response.headers
+        self.links = self._parse_links(response.headers.get('link', ''))
+
+    @staticmethod
+    def _parse_links(link_header):
+        links = {}
+        if not link_header:
+            return links
+
+        for value in link_header.split(','):
+            part = value.strip()
+            if not part.startswith('<') or '>' not in part:
+                continue
+
+            target, params = part.split('>', 1)
+            url = target[1:]
+            rels = []
+
+            for param in params.split(';'):
+                if '=' not in param:
+                    continue
+                key, raw_value = param.split('=', 1)
+                if key.strip().lower() != 'rel':
+                    continue
+                rels = raw_value.strip().strip('"').split()
+                break
+
+            for rel in rels:
+                links[rel] = {'url': url}
+
+        return links
+
+    @property
+    def text(self):
+        data = self._response.data or b''
+        return data.decode('utf-8')
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if 200 <= self.status_code < 300:
+            return
+
+        message = 'HTTP {}'.format(self.status_code)
+        reason = getattr(self._response, 'reason', None)
+        if reason:
+            message = '{} {}'.format(message, reason)
+        raise HTTPError(message)
 
 
