+class _Urllib3SessionAdapter:
+    def __init__(self):
+        self._manager = PoolManager()
+
+    def request(self, method, url, **kwargs):
+        headers = kwargs.pop('headers', None)
+        params = kwargs.pop('params', None)
+        json_body = kwargs.pop('json', None)
+        data = kwargs.pop('data', None)
+        stream = kwargs.pop('stream', False)
+        timeout = kwargs.pop('timeout', None)
+        allow_redirects = kwargs.pop('allow_redirects', None)
+        if params:
+            url = _append_query_params(url, params)
+
+        if json_body is not None:
+            body = json.dumps(json_body).encode('utf-8')
+        elif data is not None:
+            if isinstance(data, str):
+                body = data.encode('utf-8')
+            elif isinstance(data, (bytes, bytearray)):
+                body = data
+            elif hasattr(data, 'items'):
+                body = urlencode(list(data.items()), doseq=True).encode('utf-8')
+            else:
+                body = data
+        else:
+            body = kwargs.pop('body', None)
+
+        req_kw = dict(kwargs)
+        if headers is not None:
+            req_kw['headers'] = headers
+        if timeout is not None:
+            req_kw['timeout'] = timeout
+        if allow_redirects is not None:
+            req_kw['redirect'] = allow_redirects
+        req_kw['preload_content'] = not stream
+        req_kw['retries'] = req_kw.get('retries', False)
+        if body is not None:
+            req_kw['body'] = body
+
+        start = time.perf_counter()
+        raw_response = self._manager.request(method, url, **req_kw)
+        response_url = getattr(raw_response, 'geturl', lambda: url)()
+        return Response(raw_response, method, response_url,
+            time.perf_counter() - start)
+
+    def close(self):
+        close = getattr(self._manager, 'clear', None)
+        if callable(close):
+            close()
 
