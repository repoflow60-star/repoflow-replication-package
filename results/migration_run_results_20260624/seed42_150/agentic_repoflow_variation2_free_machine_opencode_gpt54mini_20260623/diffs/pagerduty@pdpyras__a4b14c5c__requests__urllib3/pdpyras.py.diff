+def _append_query_params(url: str, params) -> str:
+    scheme, netloc, path, query, fragment = urlsplit(url)
+    query_items = parse_qsl(query, keep_blank_values=True)
+    if hasattr(params, 'items'):
+        query_items.extend(list(params.items()))
+    else:
+        query_items.extend(list(params))
+    return urlunsplit((scheme, netloc, path, urlencode(query_items, doseq=True), fragment))
+
