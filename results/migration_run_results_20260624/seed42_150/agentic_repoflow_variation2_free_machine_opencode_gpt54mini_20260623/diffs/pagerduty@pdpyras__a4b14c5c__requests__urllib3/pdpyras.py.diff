+class Response:
+    """Compatibility wrapper around urllib3 responses."""
+
+    def __init__(self, raw, method: str = 'GET', url: str = None,
+            elapsed_seconds: float = None):
+        if hasattr(raw, 'status') or hasattr(raw, 'status_code') or \
+                hasattr(raw, 'data') or hasattr(raw, 'content'):
+            self.raw = raw
+            self.request = SimpleNamespace(method=method, url=url)
+            self.elapsed = timedelta(seconds=elapsed_seconds or 0)
+            self.headers = getattr(raw, 'headers', {})
+            status = getattr(raw, 'status', None)
+            if status is None:
+                status = getattr(raw, 'status_code', 0)
+            self.status_code = status
+            self.url = url
+            self.status = self.status_code
+            body = getattr(raw, 'data', None)
+            if body is None:
+                body = getattr(raw, 'content', None)
+            if body is None:
+                body = getattr(raw, 'text', b'')
+            self._body = body
+        else:
+            self.raw = None
+            self.request = SimpleNamespace(method='GET', url=url or '')
+            self.elapsed = timedelta(seconds=0)
+            self.headers = {}
+            self.status_code = int(raw)
+            self.url = url or ''
+            self.status = self.status_code
+            self._body = method
+
+    @property
+    def ok(self):
+        return 200 <= int(self.status_code) < 400
+
+    @property
+    def content(self):
+        return self._body
+
+    @property
+    def text(self):
+        if isinstance(self._body, str):
+            return self._body
+        content_type = self.headers.get('content-type', '')
+        if not content_type:
+            content_type = self.headers.get('Content-Type', '')
+        charset = None
+        for part in content_type.split(';')[1:]:
+            if 'charset=' in part.lower():
+                charset = part.split('=', 1)[1].strip()
+                break
+        return (self._body or b'').decode(charset or 'utf-8', errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+    def __bool__(self):
+        return self.ok
+
+    def __getattr__(self, name):
+        return getattr(self.raw, name)
