 from nyaapy import torrent
 from nyaapy.parser import parse_nyaa, parse_single, parse_nyaa_rss
+
+
+# Keep the public API synchronous while letting treq run on a private asyncio loop.
+_ASYNCIO_LOOP = asyncio.new_event_loop()
+asyncio.set_event_loop(_ASYNCIO_LOOP)
+
+try:
+    asyncioreactor.install(_ASYNCIO_LOOP)
+except ReactorAlreadyInstalledError:
+    pass
+
+
+def _run(deferred):
+    future = _ASYNCIO_LOOP.create_future()
+
+    def _set_result(result):
+        if not future.done():
+            future.set_result(result)
+        return result
+
+    def _set_exception(failure):
+        if not future.done():
+            future.set_exception(failure.value)
+        return failure
+
+    deferred.addCallbacks(_set_result, _set_exception)
+    return _ASYNCIO_LOOP.run_until_complete(future)
+
+
+def _get_response(url):
+    response = _run(treq.get(url))
+
+    if response.code >= 400:
+        raise RuntimeError(f"HTTP request failed with status {response.code} for {url}")
+
+    return response
+
+
+def _get_text(url):
+    return _run(treq.text_content(_get_response(url)))
+
+
+def _get_content(url):
+    return _run(treq.content(_get_response(url)))
 
 
