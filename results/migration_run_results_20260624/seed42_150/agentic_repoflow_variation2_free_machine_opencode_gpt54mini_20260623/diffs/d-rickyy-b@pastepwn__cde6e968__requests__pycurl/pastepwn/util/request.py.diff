+def _encode_data(data):
+    if data is None:
+        return None, None
+
+    if isinstance(data, bytes):
+        return data, None
+
+    if isinstance(data, str):
+        return data.encode("utf-8"), None
+
+    if isinstance(data, (dict, list, tuple)):
+        return urlencode(data, doseq=True).encode("utf-8"), "application/x-www-form-urlencoded"
+
+    return str(data).encode("utf-8"), None
+
+
+def _system_proxies():
+    return getproxies()
+
+
+def _proxy_for_scheme(proxies, scheme):
+    normalized = {key.lower(): value for key, value in proxies.items()}
+    candidates = (scheme, f"{scheme}://", "all", "all://")
+    for key in candidates:
+        proxy = normalized.get(key)
+        if proxy:
+            return proxy
+
+    return None
 
 
