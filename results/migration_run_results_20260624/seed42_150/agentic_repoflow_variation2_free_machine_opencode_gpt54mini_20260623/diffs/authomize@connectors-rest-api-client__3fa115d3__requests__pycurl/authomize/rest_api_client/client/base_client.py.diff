+    @staticmethod
+    def _normalize_params(params):
+        if not params:
+            return ''
+        normalized = []
+        for key, value in params.items():
+            if value is None:
+                continue
+            if isinstance(value, (list, tuple)):
+                normalized.append((key, [str(item) for item in value if item is not None]))
+            else:
+                normalized.append((key, str(value)))
+        return urlencode(normalized, doseq=True)
+
+    def _build_url(self, url: str, params=None) -> str:
+        request_url = self.base_url + url
+        query = self._normalize_params(params)
+        if query:
+            request_url = f'{request_url}&{query}' if '?' in request_url else f'{request_url}?{query}'
+        return request_url
+
+    @staticmethod
+    def _encode_body(body: Optional[str]):
+        if body is None:
+            return None
+        if isinstance(body, bytes):
+            return body
+        return body.encode('utf-8')
+
+    def _perform(
+        self,
+        method: str,
+        url: str,
+        params=None,
+        body: Optional[str] = None,
+        headers=None,
+    ):
+        request_url = self._build_url(url, params=params)
+        response_body = BytesIO()
+        header_lines = []
+
+        def collect_header(chunk):
+            header_lines.append(chunk)
+            return len(chunk)
+
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, request_url)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, collect_header)
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                [
+                    f'{key}: {value}'
+                    for key, value in {
+                        **self.default_headers,
+                        **(headers or {}),
+                    }.items()
+                ],
+            )
+
+            if method == 'POST':
+                curl.setopt(pycurl.POST, 1)
+            elif method != 'GET':
+                curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+            if body is not None:
+                curl.setopt(pycurl.POSTFIELDS, self._encode_body(body))
+            elif method in {'POST', 'PATCH', 'DELETE'}:
+                curl.setopt(pycurl.POSTFIELDS, '')
+
+            curl.perform()
