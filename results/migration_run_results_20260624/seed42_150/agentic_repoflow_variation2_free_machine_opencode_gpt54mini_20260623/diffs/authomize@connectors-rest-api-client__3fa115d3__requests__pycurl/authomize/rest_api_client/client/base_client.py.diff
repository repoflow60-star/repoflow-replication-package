+                if len(parts) >= 2:
+                    reason = parts[2] if len(parts) == 3 else ''
+                headers = {}
+                continue
+            if ':' in line:
+                key, value = line.split(':', 1)
+                headers[key.strip().lower()] = value.strip()
+
