+class _RequestsFacade:
+    def __init__(self) -> None:
+        self._http = urllib3.PoolManager()
+
+    def _request(self, method: str, url: str, headers=None, timeout=None, json=None, body=None):
+        request_headers = dict(headers) if headers is not None else None
+        if json is not None:
+            body = json_module.dumps(json).encode("utf-8")
+            if request_headers is None:
+                request_headers = {}
+            request_headers.setdefault("Content-Type", "application/json")
+        elif isinstance(body, str):
+            body = body.encode("utf-8")
+
+        return self._http.request(
+            method, url, body=body, headers=request_headers, timeout=timeout, retries=False)
+
+    def get(self, url: str, headers=None, timeout=None):
+        return self._request("GET", url, headers=headers, timeout=timeout)
+
+    def post(self, url: str, headers=None, timeout=None, json=None):
+        return self._request("POST", url, headers=headers, timeout=timeout, json=json)
+
+    def put(self, url: str, headers=None, timeout=None, json=None):
+        return self._request("PUT", url, headers=headers, timeout=timeout, json=json)
+
+    def delete(self, url: str, headers=None, timeout=None, json=None):
+        return self._request("DELETE", url, headers=headers, timeout=timeout, json=json)
+
+
+requests = _RequestsFacade()
+_transport = requests
 
 
