+    def _get_value_from_env_file(self) -> Optional[str]:
+        """
+        Returns the raw value of the given environment variable from the file.
+        """
+
+        if not self.env_file_path or not os.path.isfile(self.env_file_path):
+            return None
+
+        with open(self.env_file_path, encoding="utf-8") as file_stream:
+            for line in file_stream:
+                candidate = line.strip()
+
+                if not candidate or candidate.startswith("#"):
+                    continue
+
+                if candidate.startswith("export "):
+                    candidate = candidate[len("export ") :].lstrip()
+
+                if "=" not in candidate:
+                    continue
+
+                key, value = candidate.split("=", 1)
+
+                if key.strip() != self.name:
+                    continue
+
+                value = value.strip()
+
+                if len(value) >= 2 and value[0] == value[-1] and value[0] in {
+                    '"',
+                    "'",
+                }:
+                    if value[0] == '"':
+                        try:
+                            return json.loads(value)
+                        except ValueError:
+                            return value[1:-1]
+
+                    return value[1:-1]
+
+                hash_index = value.find(" #")
+                if hash_index != -1:
+                    value = value[:hash_index].rstrip()
+
+                return value
+
+        return None
+
+    @staticmethod
+    def _serialize_env_value(value: str) -> str:
+        """
+        Serializes a value for storage in an environment file.
+        """
+
+        return json.dumps(value)
+
+    def _rewrite_env_file(self, *, keep_name: bool) -> None:
+        """
+        Rewrites the environment file while updating the current key.
+        """
+
+        if not self.env_file_path:
+            return
+
+        if not keep_name and not os.path.isfile(self.env_file_path):
+            return
+
+        lines = []
+
+        if os.path.isfile(self.env_file_path):
+            with open(self.env_file_path, encoding="utf-8") as file_stream:
+                lines = file_stream.readlines()
+
+        rewritten = []
+        found = False
+        updated = False
+
+        for line in lines:
+            candidate = line.strip()
+
+            if candidate.startswith("export "):
+                candidate = candidate[len("export ") :].lstrip()
+
+            if "=" in candidate:
+                key = candidate.split("=", 1)[0].strip()
+
+                if key == self.name:
+                    found = True
+                    if keep_name and not updated:
+                        rewritten.append(
+                            f"{self.name}={self._serialize_env_value(self.get_value())}"
+                        )
+                        updated = True
+
+                    continue
+
+            rewritten.append(line.rstrip("\r\n"))
+
+        if keep_name and not found:
+            rewritten.append(
+                f"{self.name}={self._serialize_env_value(self.get_value())}"
+            )
+
+        directory = os.path.dirname(self.env_file_path)
+
+        if directory:
+            os.makedirs(directory, exist_ok=True)
+
+        with open(self.env_file_path, "w", encoding="utf-8") as file_stream:
+            file_stream.write("\n".join(rewritten))
+
+            if rewritten:
+                file_stream.write("\n")
+
