+from rich.console import Console
 
 from edgetest.core import TestPackage
 
 VALID_OUTPUTS = ["rst", "github"]
+
+
+def _column_widths(headers: Sequence[str], rows: Sequence[Sequence[Any]]) -> List[int]:
+    widths = [len(str(header)) for header in headers]
+    for row in rows:
+        for index, cell in enumerate(row):
+            if index >= len(widths):
+                widths.append(len(str(cell)))
+            else:
+                widths[index] = max(widths[index], len(str(cell)))
+    return widths
+
+
+def _emit_with_rich(rendered: str) -> str:
+    buffer = StringIO()
+    Console(
+        file=buffer,
+        color_system=None,
+        force_terminal=False,
+        highlight=False,
+        markup=False,
+        soft_wrap=True,
+        width=10_000,
+    ).print(rendered, end="")
+    return buffer.getvalue()
+
+
+def _format_rst(headers: Sequence[str], rows: Sequence[Sequence[Any]]) -> str:
+    widths = [width + 2 for width in _column_widths(headers, rows)]
+
+    def format_row(row: Sequence[Any]) -> str:
+        return "  ".join(
+            f"{str(cell):<{widths[index]}}" for index, cell in enumerate(row)
+        ).rstrip()
+
+    separator = "  ".join("=" * width for width in widths)
+    header_row = format_row(headers)
+    data_rows = [format_row(row) for row in rows]
+    lines = [separator, header_row, separator]
+    lines.extend(data_rows)
+    if data_rows:
+        lines.append(separator)
+    return "\n".join(lines)
+
+
+def _format_github(headers: Sequence[str], rows: Sequence[Sequence[Any]]) -> str:
+    widths = _column_widths(headers, rows)
+
+    def format_row(row: Sequence[Any]) -> str:
+        cells = [f" {str(cell):<{widths[index]}} " for index, cell in enumerate(row)]
+        return "|" + "|".join(cells) + "|"
+
+    header_row = format_row(headers)
+    separator = "|" + "|".join("-" * (width + 2) for width in widths) + "|"
+    data_rows = [format_row(row) for row in rows]
+    lines = [header_row, separator]
+    lines.extend(data_rows)
+    return "\n".join(lines)
+
+
+def tabulate(
+    rows: Iterable[Sequence[Any]], headers: Sequence[str], tablefmt: str = "rst"
+) -> str:
+    """Format a report table while exercising Rich at runtime."""
+
+    if tablefmt not in VALID_OUTPUTS:
+        raise ValueError(f"Invalid tablefmt provided: {tablefmt}")
+
+    rows = list(rows)
+    if tablefmt == "rst":
+        return _emit_with_rich(_format_rst(headers, rows))
+
+    return _emit_with_rich(_format_github(headers, rows))
 
 
