+def _figure_from_kwargs(kwargs: object) -> go.Figure:
+    fig = kwargs.get("ax")
+    if fig is None:
+        fig = kwargs.get("fig")
+    if fig is None or not hasattr(fig, "add_trace"):
+        fig = go.Figure()
+    return fig
+
+
+def _kde_trace(values, name, **kwargs):
+    y = pd.Series(values).dropna().astype(float).to_numpy()
+    if len(y) == 0:
+        return None
+    if len(y) == 1 or (y == y[0]).all():
+        x = [y[0] - 0.1, y[0], y[0] + 0.1]
+        density = [0.0, 1.0, 0.0]
+    else:
+        kde = gaussian_kde(y)
+        x = np.linspace(-0.2, 1.2, 200)
+        density = kde(x)
+    return go.Scatter(
+        x=list(x),
+        y=list(density),
+        mode="lines",
+        name=name,
+        **_scatter_trace_kwargs(**kwargs),
+    )
+
+
+def _scatter_trace_kwargs(**kwargs):
+    trace_kwargs = {}
+    color = kwargs.get("color")
+    if color is not None:
+        trace_kwargs["marker"] = {"color": color}
+        trace_kwargs["line"] = {"color": color}
+    alpha = kwargs.get("alpha")
+    if alpha is not None:
+        trace_kwargs["opacity"] = alpha
+    return trace_kwargs
 
 
