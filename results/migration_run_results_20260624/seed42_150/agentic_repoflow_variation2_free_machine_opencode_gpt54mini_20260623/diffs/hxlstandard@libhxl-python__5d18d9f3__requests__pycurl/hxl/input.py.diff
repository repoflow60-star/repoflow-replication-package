     def close(self):
         """Close the streaming response."""
         return self.response.close()
+
+
+class _CaseInsensitiveHeaders(dict):
+    def __setitem__(self, key, value):
+        super().__setitem__(key.lower(), value)
+
+    def get(self, key, default=None):
+        return super().get(key.lower(), default)
+
+    def __getitem__(self, key):
+        return super().__getitem__(key.lower())
+
+
+class _PycurlResponse:
+    def __init__(self, status_code, headers, content, url):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+        self.url = url
+
+    @property
+    def is_redirect(self):
+        return (self.status_code in (301, 302, 303, 307, 308)) and (self.headers.get('location') is not None)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise HXLIOException("HTTP error {} for {}".format(self.status_code, self.url), url=self.url)
+
+    def json(self):
+        return json.loads(self.content.decode('utf-8'))
+
+
+def _pycurl_request(method, url, verify_ssl=True, timeout=None, headers=None, params=None, data=None, follow_redirects=True):
+    if params:
+        query = urllib.parse.urlencode(params, doseq=True)
+        parts = list(urllib.parse.urlsplit(url))
+        parts[3] = parts[3] + ('&' if parts[3] else '') + query
+        url = urllib.parse.urlunsplit(parts)
+
+    response_headers = _CaseInsensitiveHeaders()
+    response_body = io.BytesIO()
+
+    def header_callback(chunk):
+        line = chunk.decode('iso-8859-1').strip()
+        if not line:
+            return len(chunk)
+        if line.startswith('HTTP/'):
+            response_headers.clear()
+        elif ':' in line:
+            key, value = line.split(':', 1)
+            response_headers[key.strip()] = value.strip()
+        return len(chunk)
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, header_callback)
+        curl.setopt(pycurl.ACCEPT_ENCODING, '')
+        curl.setopt(pycurl.NOSIGNAL, 1)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1 if follow_redirects else 0)
+        if timeout is not None:
+            curl.setopt(pycurl.TIMEOUT_MS, int(timeout * 1000))
+        if not verify_ssl and urllib.parse.urlsplit(url).scheme == 'https':
+            curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+            curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+        if headers:
+            curl.setopt(pycurl.HTTPHEADER, ["{}: {}".format(key, value) for key, value in headers.items()])
+
+        method = method.upper()
+        if method == 'HEAD':
+            curl.setopt(pycurl.NOBODY, 1)
+        elif method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            if data is not None:
+                if isinstance(data, dict):
+                    data = urllib.parse.urlencode(data, doseq=True)
+                if not isinstance(data, bytes):
+                    data = str(data).encode('utf-8')
+                curl.setopt(pycurl.POSTFIELDS, data)
+                curl.setopt(pycurl.POSTFIELDSIZE, len(data))
+
+        curl.perform()
+        status_code = int(curl.getinfo(pycurl.RESPONSE_CODE))
+        response_url = curl.getinfo(pycurl.EFFECTIVE_URL) or url
+        return _PycurlResponse(status_code, response_headers, response_body.getvalue(), response_url)
+    except pycurl.error as e:
+        raise HXLIOException(str(e), url=url)
+    finally:
+        curl.close()
 
 
