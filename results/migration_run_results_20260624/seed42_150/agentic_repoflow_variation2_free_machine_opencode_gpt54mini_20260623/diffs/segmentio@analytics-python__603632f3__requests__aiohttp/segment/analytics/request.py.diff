+class HTTPResponse(object):
+    def __init__(self, status_code, headers, reason, text, payload=_NO_JSON):
+        self.status_code = status_code
+        self.headers = headers
+        self.reason = reason
+        self.text = text
+        self._payload = payload
+
+    def json(self):
+        if self._payload is _NO_JSON:
+            raise ValueError('No JSON object could be decoded')
+
+        return self._payload
+
+
+async def _read_response(response):
+    try:
+        payload = await response.json(content_type=None)
+    except Exception:
+        payload = _NO_JSON
+
+    text = await response.text()
+    return HTTPResponse(response.status, dict(response.headers), response.reason, text, payload)
+
+
+class _AiohttpSession(object):
+    async def _post(self, url, data=None, headers=None, timeout=None, proxy=None):
+        timeout_cfg = aiohttp.ClientTimeout(total=timeout)
+        async with aiohttp.ClientSession(timeout=timeout_cfg) as session:
+            async with session.post(
+                url=url,
+                data=data,
+                headers=headers,
+                timeout=timeout_cfg,
+                proxy=proxy,
+            ) as response:
+                return await _read_response(response)
+
+    def post(self, url, data=None, headers=None, timeout=None, proxy=None):
+        return asyncio.run(self._post(url, data=data, headers=headers, timeout=timeout, proxy=proxy))
+
+
+_session = _AiohttpSession()
+
+
+def _normalize_proxy(proxy):
+    if not proxy:
+        return None
+
+    if isinstance(proxy, dict):
+        proxy = proxy.get('https') or proxy.get('http') or proxy.get('all')
+
+    if proxy and '://' not in proxy:
+        return 'http://{}'.format(proxy)
+
+    return proxy
 
 
