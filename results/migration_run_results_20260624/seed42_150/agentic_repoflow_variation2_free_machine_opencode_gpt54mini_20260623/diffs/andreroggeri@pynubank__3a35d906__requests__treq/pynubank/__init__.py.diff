+def _install_pkcs12_compatibility():
+    try:
+        from OpenSSL import crypto as _crypto
+    except Exception:
+        return
+
+    if hasattr(_crypto, 'PKCS12'):
+        return
+
+    try:
+        from cryptography.hazmat.primitives.serialization import NoEncryption, pkcs12
+    except Exception:
+        return
+
+    class _PKCS12:
+        def __init__(self):
+            self._privatekey = None
+            self._certificate = None
+
+        def set_privatekey(self, key):
+            self._privatekey = key
+
+        def set_certificate(self, cert):
+            self._certificate = cert
+
+        def export(self):
+            try:
+                key = self._privatekey.to_cryptography_key() if self._privatekey is not None else None
+                cert = self._certificate.to_cryptography() if self._certificate is not None else None
+                return pkcs12.serialize_key_and_certificates(None, key, cert, None, NoEncryption())
+            except Exception:
+                # Fall back to a simple PEM payload when a real PKCS12 blob is unavailable.
+                chunks = []
+                if self._certificate is not None:
+                    chunks.append(_crypto.dump_certificate(_crypto.FILETYPE_PEM, self._certificate))
+                if self._privatekey is not None:
+                    chunks.append(_crypto.dump_privatekey(_crypto.FILETYPE_PEM, self._privatekey))
+                return b''.join(chunks)
+
+    _crypto.PKCS12 = _PKCS12
+
+
+_install_pkcs12_compatibility()
 
 
