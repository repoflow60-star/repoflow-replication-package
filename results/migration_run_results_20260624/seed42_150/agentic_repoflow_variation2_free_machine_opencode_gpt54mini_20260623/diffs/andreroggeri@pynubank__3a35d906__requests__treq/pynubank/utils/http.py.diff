+class _ResponseHeaders:
+    def __init__(self, headers):
+        self._headers = {}
+        if headers is None:
+            return
+
+        raw_headers = getattr(headers, 'getAllRawHeaders', None)
+        if raw_headers is not None:
+            for name, values in headers.getAllRawHeaders():
+                if not values:
+                    continue
+                self._headers[self._normalize(name).lower()] = self._normalize(values[0])
+            return
+
+        for name, value in dict(headers).items():
+            self._headers[self._normalize(name).lower()] = self._normalize(value)
+
+    def get(self, name: str, default=None):
+        return self._headers.get(name.lower(), default)
+
+    @staticmethod
+    def _normalize(value):
+        if isinstance(value, bytes):
+            return value.decode()
+        return value
+
+
+class _ResponseAdapter:
+    def __init__(self, url: str, response, body: bytes):
+        self.url = url
+        self.status_code = response.code
+        self.headers = _ResponseHeaders(response.headers)
+        self._body = body
+
+    def json(self):
+        return json_module.loads(self._body.decode())
 
 
