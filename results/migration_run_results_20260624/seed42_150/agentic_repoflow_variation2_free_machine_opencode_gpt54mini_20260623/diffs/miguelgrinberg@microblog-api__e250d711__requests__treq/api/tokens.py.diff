 from api.schemas import TokenSchema, PasswordResetRequestSchema, \
     PasswordResetSchema, OAuth2Schema, EmptySchema
 
+requests = _treq
+
 tokens = Blueprint('tokens', __name__)
 token_schema = TokenSchema()
 oauth2_schema = OAuth2Schema()
+_reactor_ready = Event()
+_reactor_thread = None
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _reactor_thread
+    if reactor.running:
+        return
+    if _reactor_thread is None:
+        _reactor_thread = Thread(target=_run_reactor, daemon=True)
+        _reactor_thread.start()
+    _reactor_ready.wait()
+
+
+def _response_status(response):
+    status_code = getattr(response, 'status_code', None)
+    if isinstance(status_code, int):
+        return status_code
+    code = getattr(response, 'code', None)
+    if isinstance(code, int):
+        return code
+    return status_code if status_code is not None else code
+
+
+def _response_json(response):
+    json = getattr(response, 'json', None)
+    if callable(json):
+        return defer.maybeDeferred(json)
+    return defer.maybeDeferred(_treq.json_content, response)
+
+
+@defer.inlineCallbacks
+def _oauth2_email(provider_data, provider, args, redirect_uri):
+    response = yield defer.maybeDeferred(_treq.post, provider_data[
+        'access_token_url'], data={
+            'client_id': provider_data['client_id'],
+            'client_secret': provider_data['client_secret'],
+            'code': args['code'],
+            'grant_type': 'authorization_code',
+            'redirect_uri': redirect_uri,
+        }, headers={'Accept': 'application/json'})
+    if _response_status(response) != 200:
+        return None
+    oauth2_token = (yield _response_json(response)).get('access_token')
+    if not oauth2_token:
+        return None
+    response = yield defer.maybeDeferred(_treq.get, provider_data[
+        'get_user']['url'], headers={
+            'Authorization': 'Bearer ' + oauth2_token,
+            'Accept': 'application/json',
+        })
+    if _response_status(response) != 200:
+        return None
+    user_data = yield _response_json(response)
+    return provider_data['get_user']['email'](user_data)
 
 
