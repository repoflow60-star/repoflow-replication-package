+
+class _Response:
+    def __init__(self, response, content: bytes):
+        self.content = content
+        self.headers = _response_headers(response.headers)
+        self.status_code = response.code
+
+    def json(self):
+        return json.loads(self.content.decode('utf-8'))
+
+    def iter_content(self, chunk_size: int = 1):
+        for offset in range(0, len(self.content), chunk_size):
+            yield self.content[offset : offset + chunk_size]
+
+
+def _normalize_header_name(name: ty.Any) -> str:
+    if isinstance(name, bytes):
+        return name.decode('latin-1').lower()
+    return str(name).lower()
+
+
+def _normalize_header_value(value: ty.Any) -> str:
+    if isinstance(value, bytes):
+        return value.decode('latin-1')
+    return str(value)
+
+
+def _response_headers(headers) -> ty.Dict[str, str]:
+    normalized = {}
+
+    for name, values in headers.getAllRawHeaders() or []:
+        if values:
+            normalized[_normalize_header_name(name)] = _normalize_header_value(
+                values[0]
+            )
+
+    return normalized
+
+
+def _ensure_reactor() -> None:
+    global _REACTOR_THREAD
+
+    if reactor.running:
+        return
+
+    with _REACTOR_LOCK:
+        if reactor.running:
+            return
+
+        if _REACTOR_THREAD is None:
+
+            def _run() -> None:
+                reactor.callWhenRunning(_REACTOR_READY.set)
+                reactor.run(installSignalHandlers=False)
+
+            _REACTOR_THREAD = threading.Thread(target=_run, daemon=True)
+            _REACTOR_THREAD.start()
+
+    _REACTOR_READY.wait()
+
+
+def _call_on_reactor(func, *args, **kwargs):
+    _ensure_reactor()
+    return blockingCallFromThread(reactor, func, *args, **kwargs)
+
+
