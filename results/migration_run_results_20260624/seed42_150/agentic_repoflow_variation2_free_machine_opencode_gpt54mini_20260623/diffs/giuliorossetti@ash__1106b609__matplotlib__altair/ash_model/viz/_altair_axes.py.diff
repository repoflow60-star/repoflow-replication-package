--- a/ash_model/viz/_altair_axes.py
+++ b/ash_model/viz/_altair_axes.py
@@ -0,0 +1,58 @@
+from types import SimpleNamespace
+
+
+class Axes:
+    def __init__(self, chart=None):
+        self.chart = chart
+
+    def plot(self, *args, **kwargs):
+        return self
+
+    def bar(self, *args, **kwargs):
+        return self
+
+    def loglog(self, *args, **kwargs):
+        return self
+
+    def legend(self, *args, **kwargs):
+        return self
+
+    def set_xlim(self, *args, **kwargs):
+        return self
+
+    def to_dict(self):
+        if self.chart is None:
+            return {}
+        return self.chart.to_dict()
+
+    def __getattr__(self, name):
+        if self.chart is not None:
+            return getattr(self.chart, name)
+        raise AttributeError(name)
+
+
+plt = SimpleNamespace(Axes=Axes, gca=lambda: Axes())
+
+
+def _wrap_chart(chart, ax=None):
+    if isinstance(ax, Axes):
+        ax.chart = chart
+        return ax
+    if ax is not None:
+        return ax
+    return Axes(chart)
+
+
+def _chart_kwargs(kwargs: dict) -> dict:
+    return {k: kwargs[k] for k in ("title", "width", "height") if k in kwargs}
+
+
+def _mark_kwargs(kwargs: dict, default_opacity=None) -> dict:
+    mark_kwargs = {}
+    if "alpha" in kwargs:
+        mark_kwargs["opacity"] = kwargs["alpha"]
+    elif "opacity" in kwargs:
+        mark_kwargs["opacity"] = kwargs["opacity"]
+    elif default_opacity is not None:
+        mark_kwargs["opacity"] = default_opacity
+    return mark_kwargs
