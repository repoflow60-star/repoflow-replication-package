+def _column_widths(headers: List[str], rows: List[List[Any]]) -> List[int]:
+    widths = [len(str(header)) + 2 for header in headers]
+    for row in rows:
+        for index, cell in enumerate(row):
+            widths[index] = max(widths[index], len(str(cell)) + 2)
+    return widths
+
+
+def _render_rst(headers: List[str], rows: List[List[Any]]) -> str:
+    widths = _column_widths(headers, rows)
+
+    def render_row(values: List[Any]) -> str:
+        cells = [str(value).ljust(widths[index]) for index, value in enumerate(values)]
+        return "  ".join(cells)
+
+    border = "  ".join("=" * width for width in widths)
+    rendered = [border, render_row(headers), border]
+    rendered.extend(render_row(row) for row in rows)
+    rendered.append(border)
+    return "\n".join(rendered)
+
+
+def _render_github(headers: List[str], rows: List[List[Any]]) -> str:
+    widths = _column_widths(headers, rows)
+
+    def render_row(values: List[Any]) -> str:
+        cells = [str(value).ljust(widths[index]) for index, value in enumerate(values)]
+        return "| " + " | ".join(cells) + " |"
+
+    separator = "|" + "|".join("-" * width for width in widths) + "|"
+    rendered = [render_row(headers), separator]
+    rendered.extend(render_row(row) for row in rows)
+    return "\n".join(rendered)
+
+
+def tabulate(rows: List[List[Any]], headers: List[str], tablefmt: str = "rst") -> str:
+    table = PrettyTable()
+    table.field_names = headers
+    for row in rows:
+        table.add_row(row)
+
+    normalized_headers = list(table.field_names)
+    normalized_rows = [list(row) for row in table._rows]
+
+    if tablefmt == "github":
+        return _render_github(normalized_headers, normalized_rows)
+
+    return _render_rst(normalized_headers, normalized_rows)
 
 
