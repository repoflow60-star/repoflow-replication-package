+def _basic_auth_headers(api_key):
+    token = base64.b64encode(('%s:' % api_key).encode('utf-8')).decode('ascii')
+    return {'Authorization': 'Basic %s' % token}
+
+
+def _clean_headers(headers):
+    return {k: v for k, v in headers.items() if v is not None}
+
+
+def _response_status(resp):
+    status_code = getattr(resp, 'status_code', None)
+    if isinstance(status_code, int):
+        return status_code
+
+    status = getattr(resp, 'status', None)
+    if isinstance(status, int):
+        return status
+
+    return None
+
+
+def _response_text(resp):
+    text = getattr(resp, 'text', None)
+    if isinstance(text, str):
+        return text
+
+    data = getattr(resp, 'data', None)
+    if isinstance(data, (bytes, bytearray)):
+        return data.decode('utf-8')
+    if isinstance(data, str):
+        return data
+
+    content = getattr(resp, 'content', None)
+    if isinstance(content, (bytes, bytearray)):
+        return content.decode('utf-8')
+
+    return ''
+
+
+def _response_json(resp):
+    json_method = getattr(resp, 'json', None)
+    if callable(json_method):
+        try:
+            data = json_method()
+        except Exception:
+            data = None
+        else:
+            if isinstance(data, dict):
+                return data
+
+    return json.loads(_response_text(resp) or '{}')
+
+
+class _ResponseAdapter(object):
+    def __init__(self, response):
+        self._response = response
+        self.status = _response_status(response)
+        self.status_code = self.status
+        self.data = getattr(response, 'data', None)
+        self.text = _response_text(response)
+
+    def json(self):
+        return _response_json(self._response)
+
