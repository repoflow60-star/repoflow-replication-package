+class _RetryingPoolManager(object):
+    def __init__(self, retries, backoff_factor=0.3):
+        self._pool = urllib3.PoolManager()
+        self._retries = Retry(
+            total=retries,
+            read=retries,
+            connect=retries,
+            backoff_factor=backoff_factor,
+        )
+
+    def request(self, method, url, timeout=None, headers=None, fields=None, body=None, auth=None):
