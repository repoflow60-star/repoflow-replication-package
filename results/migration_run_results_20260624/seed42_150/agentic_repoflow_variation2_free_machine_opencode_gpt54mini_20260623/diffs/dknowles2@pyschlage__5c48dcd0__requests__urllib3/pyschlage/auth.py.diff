+class Response:
+    """Minimal response wrapper backed by urllib3."""
+
+    def __init__(self, response: Any) -> None:
+        self._response = response
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self._response, name)
+
+    @property
+    def status_code(self) -> int:
+        status_code = getattr(self._response, "status_code", None)
+        if isinstance(status_code, int):
+            return status_code
+
+        status = getattr(self._response, "status", None)
+        if isinstance(status, int):
+            return status
+
+        return 0
+
+    @property
+    def reason(self) -> str:
+        reason = getattr(self._response, "reason", "")
+        if isinstance(reason, str) and reason:
+            return reason
+
+        if self.status_code:
+            try:
+                return HTTPStatus(self.status_code).phrase
+            except ValueError:
+                return ""
+
+        return ""
+
+    @property
+    def headers(self):
+        return getattr(self._response, "headers", {})
+
+    @property
+    def content(self) -> bytes:
+        content = getattr(self._response, "content", None)
+        if isinstance(content, (bytes, bytearray, memoryview)):
+            return bytes(content)
+
+        data = getattr(self._response, "data", None)
+        if isinstance(data, (bytes, bytearray, memoryview)):
+            return bytes(data)
+
+        return b""
+
+    @property
+    def text(self) -> str:
+        text = getattr(self._response, "text", None)
+        if isinstance(text, str):
+            return text
+
+        content = self.content
+        if content:
+            return content.decode("utf-8")
+
+        return ""
+
+    def json(self):
+        json = getattr(self._response, "json", None)
+        if callable(json):
+            return json()
+
+        text = self.text
+        if text:
+            return loads(text)
+
+        return loads(self.content.decode("utf-8"))
+
+    def raise_for_status(self) -> None:
+        raise_for_status = getattr(self._response, "raise_for_status", None)
+        if callable(raise_for_status):
+            raise_for_status()
+            return
+
+        if self.status_code >= 400:
+            raise HTTPError(f"{self.status_code} Server Error: {self.reason}")
+
