+class _PreparedRequest:
+    def __init__(
+        self,
+        method: str = "",
+        url: str = "",
+        headers: dict[str, str] | None = None,
+        body: bytes | None = None,
+        params: Any = None,
+    ) -> None:
+        self.method = method
+        self.url = url
+        self.headers = {} if headers is None else headers
+        self.body = body
+        self.data = body
+        self.json = None
+        self.params = params
+        self.hooks: dict[str, list[Any]] = {"response": []}
+
+    def copy(self):
+        clone = _PreparedRequest(
+            method=self.method,
+            url=self.url,
+            headers=dict(self.headers),
+            body=self.body,
+            params=self.params,
+        )
+        clone.json = self.json
+        clone.hooks = {name: hooks[:] for name, hooks in self.hooks.items()}
+        return clone
+
+    def __eq__(self, other: object) -> bool:
+        return self is other
+
+    def prepare(self):
+        if self.method:
+            self.method = self.method.upper()
+        if self.url and self.params is not None:
+            self.url = _merge_url_params(self.url, self.params)
+        return self
+
+    def register_hook(self, event: str, hook) -> None:
+        self.hooks.setdefault(event, []).append(hook)
+
+    def deregister_hook(self, event: str, hook) -> None:
+        hooks = self.hooks.get(event)
+        if hooks and hook in hooks:
+            hooks.remove(hook)
+
+    def prepare_method(self, method: str) -> None:
+        self.method = method.upper()
+
+    def prepare_url(self, url: str, params: Any = None) -> None:
+        self.url = _merge_url_params(url, params)
+
+    def prepare_headers(self, headers: Mapping[str, str] | None) -> None:
+        self.headers = dict(headers or {})
+
+    def prepare_body(self, data: Any = None, files: Any = None, json: Any = None) -> None:
+        _ = files
