+class _Urllib3Response:
+    def __init__(self, response, url: str):
+        self._response = response
+        self._url = url
+
+    @property
+    def headers(self):
+        return self._response.headers
+
+    @property
+    def content(self):
+        return self._response.data or b''
+
+    @property
+    def text(self):
+        return self.content.decode('utf-8')
+
+    @property
+    def status(self):
+        return self._response.status
+
+    def raise_for_status(self):
+        if self.status >= 400:
+            reason = getattr(self._response, 'reason', '') or ''
+            raise urllib3.exceptions.HTTPError(
+                f'{self.status} {reason} for url: {self._url}',
+            )
+
+
+class _Urllib3Session:
+    def __init__(self):
+        self._clients = {}
+
+    def _manager(self, verify: bool, proxies):
+        proxy_url = None
+        if proxies:
+            proxy_url = proxies.get('https') or proxies.get('http')
+
+        key = (proxy_url, verify)
+        if key not in self._clients:
+            manager_kwargs = {
+                'cert_reqs': ssl.CERT_REQUIRED if verify else ssl.CERT_NONE,
+            }
+            if proxy_url:
+                if proxy_url.startswith('socks'):
+                    from urllib3.contrib.socks import SOCKSProxyManager
+
+                    manager = SOCKSProxyManager(proxy_url, **manager_kwargs)
+                else:
+                    manager = urllib3.ProxyManager(proxy_url, **manager_kwargs)
+            else:
+                manager = urllib3.PoolManager(**manager_kwargs)
+            self._clients[key] = manager
+
+        return self._clients[key]
+
+    def request(self, method: str, url: str, *, body=None, headers=None, verify=None, proxies=None):
+        manager = self._manager(
+            VERIFY_SSL if verify is None else verify,
+            PROXY_DICT if proxies is None else proxies,
+        )
+        response = manager.request(
+            method, url, body=body, headers=headers, retries=False,
+        )
+        return _Urllib3Response(response, url)
+
+    def get(self, url: str, *, verify=None, proxies=None):
+        return self.request('GET', url, verify=verify, proxies=proxies)
+
+    def post(self, url: str, *, data=None, headers=None, verify=None, proxies=None):
+        return self.request('POST', url, body=data, headers=headers, verify=verify, proxies=proxies)
+
