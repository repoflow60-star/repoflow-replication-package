--- a/ninjemail/sms_services/_pycurl.py
+++ b/ninjemail/sms_services/_pycurl.py
@@ -0,0 +1,26 @@
+import io
+from urllib.parse import urlencode
+
+import pycurl
+
+
+def request(url, method="GET", headers=None, data=None, query=None):
+    buffer = io.BytesIO()
+    curl = pycurl.Curl()
+
+    try:
+        if query:
+            url = f"{url}{'&' if '?' in url else '?'}{urlencode(query)}"
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.WRITEFUNCTION, buffer.write)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        if headers:
+            curl.setopt(pycurl.HTTPHEADER, [f"{key}: {value}" for key, value in headers.items()])
+        if method == "POST":
+            curl.setopt(pycurl.POST, 1)
+            if data is not None:
+                curl.setopt(pycurl.POSTFIELDS, urlencode(data))
+        curl.perform()
+        return curl.getinfo(pycurl.RESPONSE_CODE), buffer.getvalue().decode("utf-8", errors="replace")
+    finally:
+        curl.close()
