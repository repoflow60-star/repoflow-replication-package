+def _tdes_cipher(
+    key: bytes, mode: int, iv: _typing.Optional[bytes] = None
+) -> _typing.Any:
+    def _des_cipher(des_key: bytes) -> _typing.Any:
+        if iv is None:
+            return _DES.new(des_key, mode)
+        return _DES.new(des_key, mode, iv=iv)
+
+    if len(key) == 8:
+        return _des_cipher(key)
+
+    if len(key) in {16, 24}:
+        try:
+            if iv is None:
+                return _DES3.new(key, mode)
+            return _DES3.new(key, mode, iv=iv)
+        except ValueError as exc:
+            if "degenerates to single DES" not in str(exc):
+                raise
+            # Preserve the legacy backend behavior for degenerate 3DES keys.
+            return _des_cipher(key[:8])
+
+    raise ValueError("Key must be a single, double or triple DES key")
+
