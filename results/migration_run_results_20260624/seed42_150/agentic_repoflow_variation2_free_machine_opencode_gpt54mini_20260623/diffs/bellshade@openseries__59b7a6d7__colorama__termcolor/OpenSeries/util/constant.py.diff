-from colorama import Fore, Style
+from termcolor import colored
+
+
+def _ansi_prefix(color: str) -> str:
+    marker = "__termcolor_marker__"
+    return (
+        colored(marker, color, force_color=True)
+        .removesuffix(marker)
+        .removesuffix("\x1b[0m")
+    )
 
 # bilangan pi adalah nilai konstant dalam matematika yang merupakan perbandingan keliling
 # lingkaran dengan diameternya
