+    def _normalize_sql(self, sql):
+        if not isinstance(sql, str):
+            sql = str(sql)
+        return sql.replace(':?', '?')
+
+    def _render_literal(self, value):
+        if value is None:
+            return 'NULL'
+        if isinstance(value, bool):
+            return 'TRUE' if value else 'FALSE'
+        if isinstance(value, (dt.date, dt.datetime, dt.timedelta)):
+            return "'{}'".format(str(value).replace("'", "''"))
+        if isinstance(value, str):
+            return "'{}'".format(value.replace("'", "''"))
+        return str(value)
+
+    def _render_alias(self, value):
+        if value is None:
+            return 'NULL'
+        return ast.Identifier(str(value)).to_string(alias=False)
+
+    def _render_expression(self, node):
+        if isinstance(node, (str, int, float)) or node is None:
+            return self._render_literal(node)
+        if isinstance(node, ast.Parameter):
+            return '?'
+        if isinstance(node, ast.Exists):
+            return f'EXISTS ({self.prepare_select(node.query)})'
+        if isinstance(node, ast.NotExists):
+            return f'NOT EXISTS ({self.prepare_select(node.query)})'
+        if isinstance(node, ast.Tuple):
+            return '(' + ', '.join([self._render_expression(i) for i in node.items]) + ')'
+        if isinstance(node, ast.Case):
+            return self.prepare_case(node)
+        if isinstance(node, ast.TypeCast):
+            type_name = node.type_name
+            if isinstance(type_name, str):
+                upper = type_name.upper()
+                if re.match(r'^INT\d*$', upper):
+                    type_name = 'INTEGER'
+                elif re.match(r'^FLOAT\d*$', upper):
+                    type_name = 'FLOAT'
+                else:
+                    type_name = upper
+            else:
+                type_name = self._render_type(type_name)
+            if node.precision is not None:
+                type_name += f'({", ".join(map(str, node.precision))})'
+            return f'CAST({self._render_expression(node.arg)} AS {type_name})'
+        if isinstance(node, ast.WindowFunction):
+            return self._render_window_function(node)
+        if isinstance(node, ast.Function):
+            return self._render_function(node)
+
+        return self._normalize_sql(node.to_string())
+
+    def _render_target(self, target):
+        if isinstance(target, (str, int, float)) or target is None:
+            target = ast.Constant(target)
+
+        if isinstance(target, ast.Star):
+            return '*'
+
+        if isinstance(target, ast.Last):
+            return 'last'
+
+        if isinstance(target, ast.Constant):
+            literal = self._render_literal(target.value)
+            if target.alias:
+                alias = target.alias.to_string(alias=False)
+            else:
+                alias = self._render_alias(target.value)
+            return f'{literal} AS {alias}'
+
+        if isinstance(target, ast.Function):
+            fnc = self._render_function(target)
+            alias = target.alias.to_string(alias=False) if target.alias else ast.Identifier(target.op).to_string(alias=False)
+            return f'{fnc} AS {alias}'
+
+        if isinstance(target, ast.Exists):
+            return f'EXISTS ({self.prepare_select(target.query)})'
+
+        if isinstance(target, ast.NotExists):
+            return f'NOT EXISTS ({self.prepare_select(target.query)})'
+
+        rendered = self._render_expression(target)
+        if isinstance(target, (ast.TypeCast, ast.Case)) and target.alias:
+            rendered += f' AS {target.alias.to_string(alias=False)}'
+        return rendered
+
+    def _render_function(self, node):
+        namespace = f'{node.namespace}.' if node.namespace else ''
+        distinct_str = 'DISTINCT ' if getattr(node, 'distinct', False) else ''
+        args_str = ', '.join([self._render_expression(i) for i in node.args])
+        from_str = ''
+        if getattr(node, 'from_arg', None) is not None:
+            from_str = f' FROM {self._render_expression(node.from_arg)}'
+        return f'{namespace}{node.op}({distinct_str}{args_str}{from_str})'
+
+    def _render_window_function(self, node):
+        fnc_str = self._render_expression(node.function)
+
+        partition_str = ''
+        if node.partition is not None:
+            partition_str = 'PARTITION BY ' + ', '.join([self._render_expression(arg) for arg in node.partition])
+
+        order_str = ''
+        if node.order_by is not None:
+            order_items = []
+            for arg in node.order_by:
+                col = self._render_expression(arg.field)
+                if arg.direction == 'ASC':
+                    col += ' ASC'
+                if arg.direction == 'DESC':
+                    col += ' DESC'
+                if arg.nulls == 'NULLS FIRST':
+                    col += ' NULLS FIRST'
+                if arg.nulls == 'NULLS LAST':
+                    col += ' NULLS LAST'
+                order_items.append(col)
+            order_str = 'ORDER BY ' + ', '.join(order_items)
+
+        modifier_str = f' {node.modifier}' if node.modifier else ''
+        inner = ' '.join(part for part in [partition_str, order_str] if part)
+        alias_str = f' AS {node.alias.to_string(alias=False)}' if node.alias is not None else ''
+        return f'{fnc_str} over({inner}{modifier_str}){alias_str}'
+
+    def _render_type(self, type_):
+        if isinstance(type_, str):
+            return type_
+
+        if isinstance(type_, type):
+            for sql_name, field_cls in self.types_map.items():
+                if field_cls is type_:
+                    return 'BOOLEAN' if sql_name == 'BOOL' else sql_name
+
+        sql_type = getattr(type_, 'SQL_TYPE', None)
+        if sql_type is not None:
+            return sql_type
+
+        return str(type_)
 
