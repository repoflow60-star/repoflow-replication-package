+class _HttpxSession(object):
+    def __init__(self, follow_redirects=True):
+        self._client = httpx.Client(follow_redirects=follow_redirects)
+        self.auth = None
+        self.headers = {}
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        request_kwargs = {'timeout': timeout, 'headers': request_headers}
+        if self.auth is not None:
+            request_kwargs['auth'] = self.auth
+        if data is not None:
+            if isinstance(data, (bytes, str)):
+                request_kwargs['content'] = data
+            else:
+                request_kwargs['data'] = data
+
+        return self._client.request(method, url, **request_kwargs)
 
 
