+class _PycurlResponse(object):
+    def __init__(self, status_code, headers, content):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+        try:
+            self.reason = HTTPStatus(status_code).phrase
+        except ValueError:
+            self.reason = ""
+
+    def json(self):
+        return loads(self.content.decode("utf-8") if isinstance(self.content, (bytes, bytearray)) else self.content)
+
+
+class _PycurlSession(object):
+    def __init__(self):
+        self.auth = None
+        self.headers = {}
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        curl = pycurl.Curl()
+        body = BytesIO()
+        response_headers = {}
+
+        merged_headers = dict(self.headers)
+        if headers:
+            merged_headers.update(headers)
+
+        accept_encoding = merged_headers.pop('Accept-Encoding', None)
+        header_list = ["%s: %s" % (key, value) for key, value in merged_headers.items()]
+
+        def handle_header(line):
+            decoded = line.decode('iso-8859-1').strip()
+            if not decoded:
+                return len(line)
+            if decoded.startswith('HTTP/'):
+                return len(line)
+            if ':' in decoded:
+                key, value = decoded.split(':', 1)
+                response_headers[key.strip()] = value.strip()
+            return len(line)
+
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            curl.setopt(pycurl.WRITEFUNCTION, body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, handle_header)
+            curl.setopt(pycurl.FOLLOWLOCATION, False)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+
+            if timeout is not None:
+                curl.setopt(pycurl.TIMEOUT_MS, int(timeout * 1000))
+
+            if self.auth:
+                curl.setopt(pycurl.USERPWD, "%s:%s" % self.auth)
+
+            if accept_encoding is not None:
+                curl.setopt(pycurl.ACCEPT_ENCODING, accept_encoding)
+
+            if header_list:
+                curl.setopt(pycurl.HTTPHEADER, header_list)
+
+            if data is not None:
+                if isinstance(data, dict):
+                    content_type = merged_headers.get('Content-Type')
+                    if content_type == 'application/json':
+                        data = dumps(data)
+                    else:
+                        data = urlencode(data)
+                if isinstance(data, str):
+                    data = data.encode('utf-8')
+                curl.setopt(pycurl.POSTFIELDS, data)
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            content = body.getvalue()
+            return _PycurlResponse(status_code, response_headers, content)
+        finally:
+            curl.close()
 
 
