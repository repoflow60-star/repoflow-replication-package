+def build_url(request):
+    if request.parameters:
+        if request.url_prefix and request.url_prefix.endswith(('?', '&')):
+            separator = ''
+        elif request.url_prefix and '?' in request.url_prefix:
+            separator = '&'
+        else:
+            separator = '?'
+        return '{}{}{}'.format(request.url_prefix, separator, urlencode(list(request.parameters.items())))
+    return request.url_prefix
+
+
+def build_headers(request):
+    if not request.headers:
+        return []
+    return ['{}: {}'.format(header, request.headers[header]) for header in request.headers]
+
+
+def parse_response_headers(raw_headers):
+    headers = OrderedDict()
+    for line in raw_headers.splitlines():
+        if not line:
+            continue
+        if isinstance(line, str):
+            line = line.encode('utf-8')
+        if b':' not in line:
+            continue
+        header, value = line.split(b':', 1)
+        headers[header.decode('utf-8').strip()] = value.decode('utf-8').strip()
+    return headers
+
+
+def is_local_request(request):
+    url = build_url(request) or ''
+    hostname = urlsplit(url).hostname
+    return hostname in ('localhost', '127.0.0.1', '::1')
+
+
+def build_local_response(request):
+    url = build_url(request) or ''
+    if urlsplit(url).path.endswith('/error'):
