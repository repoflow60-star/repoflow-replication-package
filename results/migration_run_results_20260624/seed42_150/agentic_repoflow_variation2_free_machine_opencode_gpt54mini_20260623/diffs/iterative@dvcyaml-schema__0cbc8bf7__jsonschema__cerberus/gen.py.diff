+_SCHEMA_VALIDATION_SCHEMA = {
+    "title": {"type": "string", "required": True},
+    "type": {"type": "string", "required": True},
+    "properties": {
+        "type": "dict",
+        "required": True,
+        "valuesrules": {"type": "dict"},
+    },
+    "additionalProperties": {"type": "boolean", "required": True},
+    "definitions": {
+        "type": "dict",
+        "required": True,
+        "valuesrules": {"type": "dict"},
+    },
+}
+
+
+def validate_schema(schema: dict[str, Any]) -> None:
+    validator = Validator(_SCHEMA_VALIDATION_SCHEMA, allow_unknown=True)
+    if validator.validate(schema):
+        return
+    raise ValueError(f"Generated schema failed validation: {validator.errors}")
+
