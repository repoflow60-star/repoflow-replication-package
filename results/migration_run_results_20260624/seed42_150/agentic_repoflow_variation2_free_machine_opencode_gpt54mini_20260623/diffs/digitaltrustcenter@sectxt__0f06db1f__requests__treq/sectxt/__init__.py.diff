+
+    @staticmethod
+    def _is_tls_error(exc: BaseException) -> bool:
+        text = f"{exc.__class__.__name__}: {exc}".lower()
+        return "ssl" in text or "tls" in text or "certificate" in text or "verify" in text
+
+    def _fetch_url(self, url: str, insecure: bool = False):
+        loop = asyncio.new_event_loop()
+        try:
+            asyncio.set_event_loop(loop)
+            reactor = asyncioreactor.AsyncioSelectorReactor(loop)
+
+            async def _request():
+                if insecure:
+                    agent = Agent(reactor, contextFactory=WebClientContextFactory())
+                else:
+                    agent = Agent(reactor, contextFactory=BrowserLikePolicyForHTTPS())
+                headers = Headers()
+                headers.addRawHeader("User-Agent", _USER_AGENT)
+                request_d = agent.request(b"GET", url.encode("ascii"), headers, None)
+                request_d.addTimeout(5, reactor)
+                response = await request_d
+                content_d = treq.content(response)
+                content_d.addTimeout(5, reactor)
+                content = await content_d
+                return response, content
+
+            return loop.run_until_complete(_request())
+        finally:
+            asyncio.set_event_loop(None)
+            loop.close()
