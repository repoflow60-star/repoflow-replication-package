--- a/appstoreserverlibrary/_treq_compat.py
+++ b/appstoreserverlibrary/_treq_compat.py
@@ -0,0 +1,83 @@
+# Copyright (c) 2023 Apple Inc. Licensed under MIT License.
+
+import json
+from threading import Event, Lock, Thread
+from typing import Any, Dict, Optional
+from urllib.parse import urlencode
+
+import treq
+from twisted.internet import reactor, threads
+
+
+_reactor_started = Event()
+_reactor_lock = Lock()
+_reactor_thread: Optional[Thread] = None
+
+
+class TreqResponse:
+    def __init__(self, status_code: int, headers: Dict[str, str], content: bytes):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+
+    def json(self):
+        return json.loads(self.content.decode("utf-8"))
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_started.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor_running():
+    if reactor.running:
+        _reactor_started.set()
+        return
+    with _reactor_lock:
+        global _reactor_thread
+        if _reactor_thread is None or not _reactor_thread.is_alive():
+            _reactor_thread = Thread(target=_run_reactor, daemon=True)
+            _reactor_thread.start()
+    _reactor_started.wait()
+
+
+def _normalize_headers(raw_headers) -> Dict[str, str]:
+    headers: Dict[str, str] = {}
+    for name, values in raw_headers.getAllRawHeaders():
+        if not values:
+            continue
+        header_name = name.decode("utf-8") if isinstance(name, bytes) else str(name)
+        value = values[-1]
+        headers[header_name.lower()] = value.decode("utf-8") if isinstance(value, bytes) else str(value)
+    return headers
+
+
+def request(
+    method: str,
+    url: str,
+    params: Optional[Dict[str, Any]] = None,
+    headers: Optional[Dict[str, str]] = None,
+    json_body: Optional[Dict[str, Any]] = None,
+    data: Optional[bytes] = None,
+) -> TreqResponse:
+    _ensure_reactor_running()
+    request_url = url
+    if params:
+        request_url = request_url + "?" + urlencode(params, doseq=True)
+    request_headers = dict(headers or {})
+    request_data = data
+    if json_body is not None:
+        request_data = json.dumps(json_body).encode("utf-8")
+        request_headers.setdefault("Content-Type", "application/json")
+
+    def _make_request():
+        response_deferred = treq.request(method, request_url, headers=request_headers, data=request_data)
+
+        def _build_response(response):
+            return treq.content(response).addCallback(
+                lambda content: TreqResponse(response.code, _normalize_headers(response.headers), content)
+            )
+
+        return response_deferred.addCallback(_build_response)
+
+    return threads.blockingCallFromThread(reactor, _make_request)
