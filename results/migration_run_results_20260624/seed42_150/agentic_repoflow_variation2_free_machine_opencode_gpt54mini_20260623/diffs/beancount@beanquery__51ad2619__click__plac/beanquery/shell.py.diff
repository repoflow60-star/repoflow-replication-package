+def _translate_argv(argv):
+    aliases = {
+        '-m': '--numberify',
+        '-f': '--format',
+        '-o': '--output',
+        '-q': '--no-errors',
+    }
+    translated = []
+    passthrough = False
+    for arg in argv:
+        if passthrough:
+            translated.append(arg)
+        elif arg == '--':
+            translated.append(arg)
+            passthrough = True
+        elif arg.startswith('-') and not arg.startswith('--') and len(arg) > 2:
+            short = arg[1]
+            if short in {'f', 'o'}:
+                translated.append(f"--{aliases['-' + short][2:]}={arg[2:].lstrip('=')}")
+            elif short in {'m', 'q'} and set(arg[1:]) <= {'m', 'q'}:
+                translated.extend(aliases[f'-{flag}'] for flag in arg[1:])
+            else:
+                translated.append(arg)
+        else:
+            translated.append(aliases.get(arg, arg))
+    return translated
+
+
+def _output_context(output):
+    if hasattr(output, 'write'):
+        return nullcontext(output)
+    if output == '-':
+        return nullcontext(sys.stdout)
+    return open(os.fspath(output), 'w')
+
+
