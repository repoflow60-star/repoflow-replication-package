+def _load_env_file() -> None:
+    """Load local environment variables from the repository .env file."""
+    dotenv_path = join(dirname(__file__), ".env")
+    settings = Dynaconf(
+        envvar_prefix=False,
+        load_dotenv=True,
+        root_path=dirname(__file__),
+        dotenv_path=dotenv_path,
+    )
+
+    for env_var_name in (
+        "ORGANIZATION",
+        "REPOSITORY",
+        "GH_APP_ID",
+        "GH_APP_INSTALLATION_ID",
+        "GH_APP_PRIVATE_KEY",
+        "GITHUB_APP_ENTERPRISE_ONLY",
+        "GH_TOKEN",
+        "GH_ENTERPRISE_URL",
+        "EXEMPT_REPOS",
+        "DRY_RUN",
+        "TITLE",
+        "BODY",
+        "COMMIT_MESSAGE",
+        "ISSUE_REPORT",
+    ):
+        if env_var_name not in os.environ:
+            value = settings.get(env_var_name)
+            if value is not None:
+                os.environ[env_var_name] = str(value)
 
 
