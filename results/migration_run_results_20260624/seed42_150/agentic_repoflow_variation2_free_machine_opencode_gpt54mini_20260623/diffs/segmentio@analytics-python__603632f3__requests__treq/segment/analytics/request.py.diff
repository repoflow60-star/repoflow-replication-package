+def _wait_for_deferred(deferred):
+    result = []
+    failure = []
+
+    deferred.addCallbacks(result.append, failure.append)
+
+    while not result and not failure:
+        if hasattr(reactor, 'iterate'):
+            reactor.iterate(0.01)
+        else:
+            time.sleep(0.01)
+
+    if failure:
+        failure[0].raiseException()
+
+    return result[0]
+
+
+def _coerce_text(value):
+    if isinstance(value, bytes):
+        return value.decode('latin1')
+    return str(value)
+
+
+class _Headers(object):
+    def __init__(self, headers):
+        self._headers = headers
+
+    def get(self, key, default=None):
+        values = self._headers.getRawHeaders(key)
+        if not values and isinstance(key, str):
+            values = self._headers.getRawHeaders(key.encode('ascii'))
+        if not values:
+            return default
+
+        value = values[0]
+        if isinstance(value, bytes):
+            return value.decode('latin1')
+        return value
+
+
+class _Response(object):
+    def __init__(self, response, body):
+        self.status_code = response.code
+        self.reason = _coerce_text(getattr(response, 'phrase', ''))
+        self.headers = _Headers(response.headers)
+        self.text = _coerce_text(body)
+
+    def json(self):
+        return json.loads(self.text)
+
+
+def _treq_post(url, data=None, headers=None, timeout=None):
+    payload = data.encode('utf-8') if isinstance(data, str) else data
+    response = _wait_for_deferred(
+        treq_post(url, data=payload, headers=headers, timeout=timeout)
+    )
+    body = _wait_for_deferred(treq_content(response))
+    return _Response(response, body)
 
 
