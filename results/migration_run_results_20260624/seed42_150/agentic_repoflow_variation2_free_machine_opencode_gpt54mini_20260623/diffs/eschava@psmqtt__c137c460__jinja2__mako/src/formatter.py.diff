+def register_filters() -> Dict[str, Any]:
+    return {
+        _FILTER_PREFIX + 'KB': kb,
+        _FILTER_PREFIX + 'MB': mb,
+        _FILTER_PREFIX + 'GB': gb,
+        _FILTER_PREFIX + 'uptime': uptime,
+        _FILTER_PREFIX + 'uptimesec': uptimesec,
+    }
+
+
+def _translate_expr(expr: str) -> str:
+    parts = [part.strip() for part in expr.split('|')]
+    rendered = parts[0]
+    for filter_name in parts[1:]:
+        rendered = f"{_FILTER_PREFIX}{filter_name}({rendered})"
+    return rendered
+
+
+def _to_mako_template(text: str) -> str:
+    return _FORMAT_RE.sub(lambda match: "${" + _translate_expr(match.group(1)) + "}", text)
 
