+class _AiohttpSession:
+    """Synchronous adapter around aiohttp.ClientSession providing urllib3-like request/urlopen/clear interface."""
+
+    def __init__(self, ssl_context=None, timeout=60, proxy_url=None, proxy_headers=None):
+        self._ssl_context = ssl_context
+        self._timeout = aiohttp.ClientTimeout(total=timeout)
+        self._proxy_url = proxy_url
+        self._proxy_headers = proxy_headers if proxy_headers is not None else {}
+        if proxy_url is not None:
+            parsed = urlparse.urlparse(proxy_url)
+            # strip any userinfo from the proxy URL for the public .proxy attribute
+            clean = urlparse.urlunparse(
+                urlparse.ParseResult(
+                    parsed.scheme,
+                    parsed.hostname + (":%d" % parsed.port if parsed.port else ""),
+                    parsed.path,
+                    parsed.params,
+                    parsed.query,
+                    parsed.fragment,
+                )
+            )
+            self.proxy = _ProxyInfo(clean)
+        else:
+            self.proxy = None
+        self.proxy_headers = self._proxy_headers
+
+    def _run(self, coro):
+        try:
+            loop = asyncio.get_event_loop()
+            if loop.is_closed():
+                raise RuntimeError("closed")
+        except RuntimeError:
+            loop = asyncio.new_event_loop()
+            asyncio.set_event_loop(loop)
+        return loop.run_until_complete(coro)
+
+    async def _do_request(self, method, url, headers=None, data=None, params=None):
+        connector = aiohttp.TCPConnector(ssl=self._ssl_context)
+        async with aiohttp.ClientSession(connector=connector, timeout=self._timeout) as session:
+            kwargs = {}
+            if self._proxy_url:
+                kwargs["proxy"] = self._proxy_url
+                if self._proxy_headers:
+                    kwargs["proxy_headers"] = self._proxy_headers
+            resp = await session.request(
+                method,
+                url,
+                headers=headers,
+                data=data,
+                params=params,
+                **kwargs,
+            )
+            body = await resp.read()
+            return _AiohttpResponse(resp.status, body, resp.headers)
+
+    def request(self, method, url, fields=None, headers=None, decode_content=None, preload_content=None, **kwargs):
+        """urllib3-compatible request method (fields -> query params for GET/DELETE, form data for POST)."""
+        params = None
+        data = None
+        if fields is not None:
+            if method.upper() in ("GET", "DELETE", "HEAD"):
+                params = fields
+            else:
+                data = aiohttp.FormData()
+                for key, value in fields.items():
+                    data.add_field(key, str(value))
+        return self._run(self._do_request(method, url, headers=headers, data=data, params=params))
+
+    def urlopen(self, method, url, body=None, headers=None, decode_content=None, preload_content=None, **kwargs):
+        """urllib3-compatible urlopen method (raw body bytes/stream)."""
+        data = None
+        if body is not None:
+            if hasattr(body, "read"):
+                data = body.read()
+            elif hasattr(body, "tobytes"):
+                data = body.tobytes()
+            else:
+                data = bytes(body)
+        return self._run(self._do_request(method, url, headers=headers, data=data))
+
+    def clear(self):
+        """No persistent pool to clear; aiohttp sessions are per-request."""
+        pass
+
+
+class _AiohttpResponse:
+    """Synchronous wrapper around an aiohttp response, providing the urllib3-like interface."""
+
+    def __init__(self, status, body, headers):
+        self.status = status
+        self._body = body
+        self._headers = headers
+        self._pos = 0
+
+    @property
+    def data(self):
+        return self._body
+
+    def read(self, size=None):
+        if self._pos >= len(self._body):
+            return b""
+        if size is None:
+            chunk = self._body[self._pos:]
+            self._pos = len(self._body)
+        else:
+            chunk = self._body[self._pos:self._pos + size]
+            self._pos += size
+        return chunk
+
+    def getheaders(self):
+        return list(self._headers.items())
+
+    def close(self):
+        pass
+
