+class _PyCurlResponse:
+    """Minimal response wrapper around a pycurl result."""
+
+    def __init__(self, status_code: int, headers: dict, body: bytes, url: str):
+        self.status_code = status_code
+        self._headers = headers
+        self.content = body
+        self.url = url
+        self.reason = ''
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status_code < 300
+
+    @property
+    def text(self) -> str:
+        encoding = 'utf-8'
+        ct = self._headers.get('content-type', '')
+        if 'charset=' in ct:
+            try:
+                encoding = ct.split('charset=')[-1].split(';')[0].strip()
+            except Exception:
+                pass
+        return self.content.decode(encoding, errors='replace')
+
+    @property
+    def headers(self):
+        return self._headers
+
+    def json(self):
+        return _json.loads(self.content)
+
+    def raise_for_status(self):
+        if not self.ok:
+            raise ClientError(
+                message={
+                    'status_code': self.status_code,
+                    'url': self.url,
+                    'message': self.reason or 'HTTP error',
+                }
+            )
+
+
+class _PyCurlSession:
+    """Session-like wrapper around pycurl that holds persistent headers."""
+
+    def __init__(self):
+        self._headers: dict = {}
+
+    def headers(self):
+        return self._headers
+
+    def headers_update(self, new_headers: dict):
+        self._headers.update(new_headers)
+
+    def _build_header_list(self, extra_headers: Optional[dict] = None) -> list:
+        merged = dict(self._headers)
+        if extra_headers:
+            merged.update(extra_headers)
+        return ['{}: {}'.format(k, v) for k, v in merged.items()]
+
+    def _perform(
+        self,
+        method: str,
+        url: str,
+        params: Optional[dict] = None,
+        data: Optional[bytes] = None,
+        extra_headers: Optional[dict] = None,
+    ) -> _PyCurlResponse:
+        if params:
+            url = '{}?{}'.format(url, urlencode(params))
+
+        response_body = io.BytesIO()
+        response_headers_raw: list = []
+
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEDATA, response_body)
+            curl.setopt(pycurl.HEADERFUNCTION, response_headers_raw.append)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+
+            header_list = self._build_header_list(extra_headers)
+            if header_list:
+                curl.setopt(pycurl.HTTPHEADER, header_list)
+
+            method = method.upper()
+            if method == 'GET':
+                curl.setopt(pycurl.HTTPGET, 1)
+            elif method == 'POST':
+                curl.setopt(pycurl.POST, 1)
+                post_data = data if data is not None else b''
+                curl.setopt(pycurl.POSTFIELDS, post_data)
+                curl.setopt(pycurl.POSTFIELDSIZE, len(post_data))
+            elif method == 'PATCH':
+                curl.setopt(pycurl.CUSTOMREQUEST, 'PATCH')
+                patch_data = data if data is not None else b''
+                curl.setopt(pycurl.POSTFIELDS, patch_data)
+                curl.setopt(pycurl.POSTFIELDSIZE, len(patch_data))
+            elif method == 'DELETE':
+                curl.setopt(pycurl.CUSTOMREQUEST, 'DELETE')
+                if data is not None:
+                    curl.setopt(pycurl.POSTFIELDS, data)
+                    curl.setopt(pycurl.POSTFIELDSIZE, len(data))
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            final_url = curl.getinfo(pycurl.EFFECTIVE_URL)
+        finally:
+            curl.close()
+
+        parsed_headers = _parse_headers(response_headers_raw)
+        return _PyCurlResponse(
+            status_code=status_code,
+            headers=parsed_headers,
+            body=response_body.getvalue(),
+            url=final_url,
+        )
+
+    def get(self, url: str, params=None) -> _PyCurlResponse:
+        return self._perform('GET', url, params=params)
+
+    def post(self, url: str, headers=None, data=None) -> _PyCurlResponse:
+        body = data.encode('utf-8') if isinstance(data, str) else (data or b'')
+        return self._perform('POST', url, data=body, extra_headers=headers)
+
+    def patch(self, url: str, headers=None, data=None) -> _PyCurlResponse:
+        body = data.encode('utf-8') if isinstance(data, str) else (data or b'')
+        return self._perform('PATCH', url, data=body, extra_headers=headers)
+
+    def delete(self, url: str, params=None) -> _PyCurlResponse:
+        return self._perform('DELETE', url, params=params)
+
+
+def _parse_headers(raw_headers) -> dict:
+    """Parse raw pycurl header lines into a dict (last value wins)."""
+    result: dict = {}
+    for item in raw_headers:
+        if callable(getattr(item, 'decode', None)):
+            line = item.decode('iso-8859-1')
+        else:
+            line = str(item)
+        line = line.rstrip('\r\n')
+        if ':' in line:
+            name, _, value = line.partition(':')
+            result[name.strip().lower()] = value.strip()
+    return result
 
 
