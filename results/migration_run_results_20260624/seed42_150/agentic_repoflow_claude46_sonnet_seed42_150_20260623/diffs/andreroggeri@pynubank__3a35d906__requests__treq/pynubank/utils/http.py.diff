+def _run_sync(d):
+    """Run a Deferred synchronously by iterating the reactor."""
+    if not isinstance(d, defer.Deferred):
+        return d
+    results = []
+    failures = []
+    d.addCallbacks(results.append, failures.append)
+    while not results and not failures:
+        reactor.iterate(0.001)
+    if failures:
+        failures[0].raiseException()
+    return results[0]
+
+
+class _TreqResponse:
+    """Thin wrapper around a treq/Twisted IResponse that normalises the interface."""
+
+    def __init__(self, response, body_bytes):
+        self._response = response
+        self._body_bytes = body_bytes
+        self.status_code = response.code
+        self.headers = response.headers
+
+    @property
+    def url(self):
+        try:
+            return self._response.request.absoluteURI.decode()
+        except Exception:
+            return ''
+
+    def json(self):
+        return _json.loads(self._body_bytes)
+
+
+def _normalise_response(raw):
+    """Wrap a treq IResponse into _TreqResponse; pass through if already normalised."""
+    if hasattr(raw, 'json'):
+        return raw
+    return _TreqResponse(raw, _run_sync(treq.content(raw)))
 
 
