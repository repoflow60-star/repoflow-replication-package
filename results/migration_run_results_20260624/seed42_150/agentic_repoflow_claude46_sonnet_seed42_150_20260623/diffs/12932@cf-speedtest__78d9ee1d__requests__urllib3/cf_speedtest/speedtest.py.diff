+class _Urllib3Response:
+    """Thin wrapper around urllib3.HTTPResponse to expose a requests-like interface."""
+
+    def __init__(self, response: urllib3.HTTPResponse) -> None:
+        self._response = response
+        self.headers = response.headers
+        self.status_code = response.status
+
+    @property
+    def text(self) -> str:
+        return self._response.data.decode('utf-8')
+
+    @property
+    def content(self) -> bytes:
+        return self._response.data
+
+    def raise_for_status(self) -> None:
+        if self._response.status >= 400:
+            raise urllib3.exceptions.HTTPError(
+                f'HTTP error {self._response.status}',
+            )
+
+
+class _Urllib3Session:
+    """Thin wrapper around urllib3 that exposes a requests.Session-compatible interface."""
+
+    def get(self, url: str, verify: bool = True, proxies: dict | None = None, **kwargs) -> _Urllib3Response:
+        http = _build_http(verify=verify, proxies=proxies)
+        response = http.request('GET', url, **kwargs)
+        return _Urllib3Response(response)
+
+    def post(self, url: str, data=None, headers=None, verify: bool = True, proxies: dict | None = None, **kwargs) -> _Urllib3Response:
+        http = _build_http(verify=verify, proxies=proxies)
+        response = http.request('POST', url, body=data, headers=headers, **kwargs)
+        return _Urllib3Response(response)
+
+
+REQ_SESSION = _Urllib3Session()
 
