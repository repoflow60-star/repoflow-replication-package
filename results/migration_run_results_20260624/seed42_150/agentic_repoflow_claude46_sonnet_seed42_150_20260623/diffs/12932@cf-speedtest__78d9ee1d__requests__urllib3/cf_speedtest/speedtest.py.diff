+def _build_http(verify: bool = True, proxies: dict | None = None) -> urllib3.PoolManager | urllib3.ProxyManager:
+    """Build a urllib3 connection pool reflecting the given verify and proxies settings."""
+    cert_reqs = 'CERT_REQUIRED' if verify else 'CERT_NONE'
+    if proxies:
+        proxy_url = proxies.get('https') or proxies.get('http')
+        return urllib3.ProxyManager(proxy_url, cert_reqs=cert_reqs)
+    return urllib3.PoolManager(cert_reqs=cert_reqs)
+
 
