+def _get_tdes_subkeys(key: bytes) -> _typing.Tuple[bytes, bytes, bytes]:
+    """Return (k1, k2, k3) sub-keys for 3DES-EDE from an 8, 16, or 24-byte key."""
+    if len(key) == 8:
+        return key, key, key
+    elif len(key) == 16:
+        return key[:8], key[8:16], key[:8]
+    else:  # 24 bytes
+        return key[:8], key[8:16], key[16:24]
+
+
+def _tdes_ecb_encrypt(key: bytes, data: bytes) -> bytes:
+    """Encrypt data using 3DES-EDE ECB, supporting 8/16/24-byte keys."""
+    k1, k2, k3 = _get_tdes_subkeys(key)
+    block_size = 8
+    result = bytearray()
+    for i in range(0, len(data), block_size):
+        block = data[i : i + block_size]
+        block = _DES.new(k1, _DES.MODE_ECB).encrypt(block)
+        block = _DES.new(k2, _DES.MODE_ECB).decrypt(block)
+        block = _DES.new(k3, _DES.MODE_ECB).encrypt(block)
+        result += block
+    return bytes(result)
+
+
+def _tdes_ecb_decrypt(key: bytes, data: bytes) -> bytes:
+    """Decrypt data using 3DES-EDE ECB, supporting 8/16/24-byte keys."""
+    k1, k2, k3 = _get_tdes_subkeys(key)
+    block_size = 8
+    result = bytearray()
+    for i in range(0, len(data), block_size):
+        block = data[i : i + block_size]
+        block = _DES.new(k3, _DES.MODE_ECB).decrypt(block)
+        block = _DES.new(k2, _DES.MODE_ECB).encrypt(block)
+        block = _DES.new(k1, _DES.MODE_ECB).decrypt(block)
+        result += block
+    return bytes(result)
+
+
+def _tdes_cbc_encrypt(key: bytes, iv: bytes, data: bytes) -> bytes:
+    """Encrypt data using 3DES-EDE CBC, supporting 8/16/24-byte keys."""
+    block_size = 8
+    result = bytearray()
