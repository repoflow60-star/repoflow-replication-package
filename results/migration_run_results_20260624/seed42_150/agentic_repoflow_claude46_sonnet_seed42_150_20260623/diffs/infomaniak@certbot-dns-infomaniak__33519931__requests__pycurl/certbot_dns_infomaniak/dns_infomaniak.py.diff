+        buf = io.BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEDATA, buf)
+            # Convert headers dict to "Name: value" strings for pycurl
+            all_headers = ["{}: {}".format(k, v) for k, v in self.headers.items()]
+            if extra_headers:
+                all_headers.extend(extra_headers)
+            if all_headers:
+                curl.setopt(pycurl.HTTPHEADER, all_headers)
+            if method == "POST":
+                curl.setopt(pycurl.POST, 1)
+                curl.setopt(pycurl.POSTFIELDS, body)
+                if body is not None:
