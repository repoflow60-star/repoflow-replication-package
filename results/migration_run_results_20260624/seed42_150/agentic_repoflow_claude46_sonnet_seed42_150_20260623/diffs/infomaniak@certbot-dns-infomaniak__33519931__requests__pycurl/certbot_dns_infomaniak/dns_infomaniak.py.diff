+class _PyCurlSession:
+    """A pycurl-backed HTTP session that supports adapter mounting for testability."""
+
+    def __init__(self):
+        self.headers = {}
+        self._adapters = {}
+
+    def mount(self, prefix, adapter):
+        """Register an adapter for a URL prefix (e.g. 'mock' -> requests_mock.Adapter)."""
+        self._adapters[prefix] = adapter
+
+    def _adapter_for(self, url):
+        """Return the longest-prefix matching adapter, or None."""
+        for prefix in sorted(self._adapters, key=len, reverse=True):
+            if url.startswith(prefix):
+                return self._adapters[prefix]
+        return None
+
+    def _pycurl_request(self, url, method, body=None, extra_headers=None):
