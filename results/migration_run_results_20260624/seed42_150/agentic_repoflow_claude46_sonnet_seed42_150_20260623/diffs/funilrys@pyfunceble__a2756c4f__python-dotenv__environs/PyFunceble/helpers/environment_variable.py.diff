+def _env_file_get_key(env_file_path: str, key: str) -> Optional[str]:
+    """
+    Reads the value of *key* from *env_file_path*.
+
+    Returns :py:obj:`None` when the file does not exist or the key is absent.
+    """
+    try:
+        with open(env_file_path, "r", encoding="utf-8") as fh:
+            for line in fh:
+                line = line.rstrip("\n")
+                m = re.match(
+                    r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)\s*$",
+                    line,
+                )
+                if m and m.group(1) == key:
+                    val = m.group(2)
+                    # Strip surrounding quotes if present
+                    if len(val) >= 2 and val[0] in ('"', "'") and val[-1] == val[0]:
+                        val = val[1:-1]
+                    return val
+    except OSError:
+        pass
+    return None
+
+
+def _env_file_set_key(env_file_path: str, key: str, value: str) -> None:
+    """
+    Sets *key* to *value* in *env_file_path*, creating the file if needed.
+    """
+    quoted = f'"{value}"'
+    new_line = f"{key}={quoted}\n"
+    try:
+        with open(env_file_path, "r", encoding="utf-8") as fh:
+            lines = fh.readlines()
+    except OSError:
+        lines = []
+
+    pattern = re.compile(
+        r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*="
+    )
+    replaced = False
+    new_lines = []
+    for line in lines:
+        m = pattern.match(line)
+        if m and m.group(1) == key:
+            new_lines.append(new_line)
+            replaced = True
+        else:
+            new_lines.append(line)
+
+    if not replaced:
+        new_lines.append(new_line)
+
+    with open(env_file_path, "w", encoding="utf-8") as fh:
+        fh.writelines(new_lines)
+
+
+def _env_file_unset_key(env_file_path: str, key: str) -> None:
+    """
+    Removes *key* from *env_file_path* if it exists.
+    """
+    try:
+        with open(env_file_path, "r", encoding="utf-8") as fh:
+            lines = fh.readlines()
+    except OSError:
+        return
+
+    pattern = re.compile(
+        r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*="
+    )
+    new_lines = [
+        line
+        for line in lines
+        if not (pattern.match(line) and pattern.match(line).group(1) == key)
+    ]
+
+    with open(env_file_path, "w", encoding="utf-8") as fh:
+        fh.writelines(new_lines)
 
 
