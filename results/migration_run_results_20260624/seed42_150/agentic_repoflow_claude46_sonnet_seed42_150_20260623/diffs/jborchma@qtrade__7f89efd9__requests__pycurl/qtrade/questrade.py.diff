+class _PyCurlResponse:
+    """Minimal response wrapper returned by PyCurlSession.request."""
+
+    def __init__(self, body: bytes, status_code: int):
+        self._body = body
+        self.status_code = status_code
+
+    def json(self):
+        """Decode JSON body."""
+        return _json_module.loads(self._body.decode("utf-8"))
+
+    def raise_for_status(self):
+        """Raise an exception for 4xx/5xx status codes."""
+        if 400 <= self.status_code < 500:
+            raise Exception("%s Client Error" % self.status_code)
+        if 500 <= self.status_code < 600:
+            raise Exception("%s Server Error" % self.status_code)
+
+
+class _HeaderStore:
+    """Mutable header store used by PyCurlSession."""
+
+    def __init__(self):
+        self._headers: Dict[str, str] = {}
+
+    def update(self, mapping: Dict[str, str]):
+        self._headers.update(mapping)
+
+    def items(self):
+        return self._headers.items()
+
+
+class PyCurlSession:
+    """Lightweight HTTP session backed by pycurl."""
+
+    def __init__(self):
+        self.headers = _HeaderStore()
+        self._curl = pycurl.Curl()
+
+    def request(
+        self,
+        method: str,
+        url: str,
+        params: Optional[Dict] = None,
+        data: Optional[Dict] = None,
+        json: Optional[Dict] = None,
+        timeout: int = 30,
+    ) -> "_PyCurlResponse":
+        """Perform an HTTP request using pycurl."""
+        if params:
+            url = url + "?" + urllib.parse.urlencode(params)
+
+        buffer = io.BytesIO()
+        c = self._curl
+        c.reset()
+        c.setopt(pycurl.URL, url)
+        c.setopt(pycurl.WRITEDATA, buffer)
+        c.setopt(pycurl.TIMEOUT, timeout)
+
+        # Build header list
+        header_list = [
+            "{}: {}".format(k, v) for k, v in self.headers.items()
+        ]
+        if header_list:
+            c.setopt(pycurl.HTTPHEADER, header_list)
+
+        method_upper = method.upper()
+        if method_upper == "GET":
+            c.setopt(pycurl.HTTPGET, 1)
+        elif method_upper == "POST":
+            if json is not None:
+                body = _json_module.dumps(json).encode("utf-8")
+            elif data is not None:
+                body = urllib.parse.urlencode(data).encode("utf-8")
+            else:
+                body = b""
+            c.setopt(pycurl.POST, 1)
+            c.setopt(pycurl.POSTFIELDS, body.decode("utf-8"))
+            if json is not None:
+                header_list.append("Content-Type: application/json")
+                c.setopt(pycurl.HTTPHEADER, header_list)
+        else:
+            c.setopt(pycurl.CUSTOMREQUEST, method_upper)
+
+        c.perform()
+        status_code = c.getinfo(pycurl.RESPONSE_CODE)
+        return _PyCurlResponse(buffer.getvalue(), status_code)
+
+    def close(self):
+        """Close and clean up the underlying pycurl handle."""
+        self._curl.close()
+
+
+def _pycurl_get(url: str) -> "_PyCurlResponse":
+    """Perform a simple GET request via pycurl."""
+    buffer = io.BytesIO()
+    c = pycurl.Curl()
+    try:
+        c.setopt(pycurl.URL, url)
+        c.setopt(pycurl.WRITEDATA, buffer)
+        c.setopt(pycurl.HTTPGET, 1)
+        c.perform()
+        status_code = c.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        c.close()
+    return _PyCurlResponse(buffer.getvalue(), status_code)
 
 
