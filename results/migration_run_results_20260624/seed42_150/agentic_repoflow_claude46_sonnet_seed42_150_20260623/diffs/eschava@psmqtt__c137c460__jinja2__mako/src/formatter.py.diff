+# Registry of named filter functions available in templates
+_FILTERS: Dict[str, Any] = {
+    'KB': kb,
+    'MB': mb,
+    'GB': gb,
+    'uptime': uptime,
+    'uptimesec': uptimesec,
+}
+
+
+def _jinja2_expr_to_mako(expr: str) -> str:
+    """Convert a Jinja2 expression (possibly with pipe filters) to a Mako expression."""
+    expr = expr.strip()
+    parts = [p.strip() for p in expr.split('|')]
+    result = parts[0]
+    for flt in parts[1:]:
+        result = flt + '(' + result + ')'
+    return result
+
+
+def _jinja2_to_mako(template_str: str) -> str:
+    """Convert a Jinja2-syntax template string to a Mako-syntax template string."""
+    def replace_expr(match: re.Match) -> str:
+        inner = match.group(1)
+        return '${' + _jinja2_expr_to_mako(inner) + '}'
+
+    return re.sub(r'\{\{(.*?)\}\}', replace_expr, template_str)
+
 
