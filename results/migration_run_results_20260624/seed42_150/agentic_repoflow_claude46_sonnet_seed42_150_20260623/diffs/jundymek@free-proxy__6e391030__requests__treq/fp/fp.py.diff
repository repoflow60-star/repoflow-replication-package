+def _run_in_reactor(deferred_factory):
+    """Run a deferred-producing callable synchronously using a reactor thread."""
+    result_holder = [None]
+    error_holder = [None]
+    done_event = threading.Event()
+
+    def in_reactor():
+        d = defer.maybeDeferred(deferred_factory)
+
+        def on_success(result):
+            result_holder[0] = result
+            done_event.set()
+
+        def on_error(failure):
+            error_holder[0] = failure
+            done_event.set()
+
+        d.addCallbacks(on_success, on_error)
+
+    if not reactor.running:
+        reactor_thread = threading.Thread(
+            target=reactor.run,
+            kwargs={'installSignalHandlers': False},
+            daemon=True,
+        )
+        reactor_thread.start()
+        time.sleep(0.05)
+
+    reactor.callFromThread(in_reactor)
+    done_event.wait()
+
+    if error_holder[0] is not None:
+        error_holder[0].raiseException()
+    return result_holder[0]
 
 
