+# ---------------------------------------------------------------------------
+# Shared Twisted reactor thread management
+# ---------------------------------------------------------------------------
+
+_reactor_lock = threading.Lock()
+_reactor_thread: Optional[threading.Thread] = None
+
+
+def ensure_reactor_running() -> None:
+    """Start the Twisted reactor in a background daemon thread if not already running."""
+    global _reactor_thread
+    with _reactor_lock:
+        if _reactor_thread is None or not _reactor_thread.is_alive():
+            from twisted.internet import reactor as _reactor
+            _reactor_thread = threading.Thread(
+                target=_reactor.run,
+                kwargs={"installSignalHandlers": False},
+                daemon=True,
+            )
+            _reactor_thread.start()
+            import time
+            time.sleep(0.05)
