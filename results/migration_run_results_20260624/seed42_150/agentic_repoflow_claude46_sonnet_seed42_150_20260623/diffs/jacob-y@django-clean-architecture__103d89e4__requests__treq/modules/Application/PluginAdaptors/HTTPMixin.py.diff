+def _run_sync(deferred):
+    """Extract result from a synchronously-resolving Deferred."""
+    result_container = []
+    error_container = []
+
+    def on_result(value):
+        result_container.append(value)
+
+    def on_error(failure):
+        error_container.append(failure)
+
+    deferred.addCallbacks(on_result, on_error)
+
+    if error_container:
+        error_container[0].raiseException()
+    return result_container[0]
 
 
