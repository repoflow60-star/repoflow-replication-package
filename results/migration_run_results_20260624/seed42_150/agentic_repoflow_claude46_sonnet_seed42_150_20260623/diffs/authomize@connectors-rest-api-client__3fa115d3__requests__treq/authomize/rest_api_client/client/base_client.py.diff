+class _TreqResponse:
+    """Adapter that provides a requests-like Response interface over a treq response."""
+
+    def __init__(self, twisted_response, body: bytes):
+        self._response = twisted_response
+        self._body = body
+
+    @property
+    def status_code(self) -> int:
+        return self._response.code
+
+    @property
+    def ok(self) -> bool:
+        return self._response.code < 400
+
+    @property
+    def headers(self):
+        return _HeadersAdapter(self._response.headers)
+
+    @property
+    def content(self) -> bytes:
+        return self._body
+
+    @property
+    def text(self) -> str:
+        return self._body.decode('utf-8', errors='replace')
+
+    @property
+    def url(self) -> str:
+        return self._response.request.absoluteURI.decode('utf-8', errors='replace') if hasattr(self._response, 'request') else ''
+
+    def json(self):
+        import json
+        return json.loads(self._body)
+
+    def raise_for_status(self):
+        code = self._response.code
+        if code >= 400:
+            raise ClientError(message=f'HTTP {code}')
+
+
+class _HeadersAdapter:
+    def __init__(self, twisted_headers: Headers):
+        self._headers = twisted_headers
+
+    def get(self, name: str, default=None):
+        values = self._headers.getRawHeaders(name.encode('utf-8') if isinstance(name, str) else name)
+        if values:
+            v = values[0]
+            return v.decode('utf-8') if isinstance(v, bytes) else v
+        return default
 
 
