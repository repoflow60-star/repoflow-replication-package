+)
+_reactor_lock = threading.Lock()
+_reactor_ready = threading.Event()
+_reactor_thread = None
+
+
+def _run_reactor() -> None:
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor() -> None:
+    global _reactor_thread
+
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if _reactor_thread is None:
+            _reactor_thread = threading.Thread(
+                target=_run_reactor,
+                name="sectxt-treq-reactor",
+                daemon=True,
+            )
+            _reactor_thread.start()
+    _reactor_ready.wait()
+
+
+def _response_url(response, fallback: str) -> str:
+    request = getattr(response, "request", None)
+    response_url = getattr(request, "absoluteURI", None)
+    if response_url is None:
+        return fallback
+    if isinstance(response_url, bytes):
+        return response_url.decode("ascii", errors="replace")
+    return str(response_url)
+
+
+def _response_history(response) -> List[str]:
+    history = []
+    previous = getattr(response, "previousResponse", None)
+    while previous is not None:
+        history.insert(0, _response_url(previous, ""))
+        previous = getattr(previous, "previousResponse", None)
+    return [url for url in history if url]
+
+
+@defer.inlineCallbacks
+def _fetch(url: str, insecure: bool = False):
+    headers = Headers({b"User-Agent": [_USER_AGENT.encode("ascii")]})
+    kwargs = {"headers": headers, "timeout": 5}
+    if insecure:
+        kwargs["agent"] = Agent(reactor, contextFactory=ClientContextFactory())
+    response = yield treq.get(url, **kwargs)
+    content = yield treq.content(response)
+    defer.returnValue(
+        (
+            response.code,
+            response.headers,
+            content,
+            _response_url(response, url),
+            _response_history(response),
+        )
+    )
+
+
+def _fetch_sync(url: str, insecure: bool = False):
+    _ensure_reactor()
+    return blockingCallFromThread(reactor, _fetch, url, insecure)
+
+
+def _is_tls_error(error: Exception) -> bool:
+    error_type = type(error)
+    if error_type.__name__ in {"CertificateError", "SSLError", "TLSNegotiationError"}:
+        return True
+    if error_type.__module__.startswith(("OpenSSL.", "twisted.internet._sslverify")):
+        return True
+    for reason in getattr(error, "reasons", ()):
+        reason = getattr(reason, "value", reason)
+        if _is_tls_error(reason):
+            return True
+    return False
+
+
+def _content_type(headers: Headers) -> Optional[str]:
+    values = headers.getRawHeaders(b"content-type")
+    if not values:
+        return None
+    value = values[0]
+    if isinstance(value, bytes):
+        return value.decode("latin-1")
+    return value
 
 
