 _GRAPHQL_API_URL = "https://apis.justwatch.com/graphql"
+_HTTP = urllib3.PoolManager()
+
+
+def post(url: str, *, json: dict) -> HTTPResponse:
+    """Send a JSON POST request using urllib3."""
+    return _HTTP.request(
+        "POST",
+        url,
+        body=jsonlib.dumps(json).encode("utf-8"),
+        headers={"Content-Type": "application/json"},
+        timeout=5.0,
+    )
+
+
+def _raise_for_status(response: HTTPResponse) -> None:
+    """Raise an HTTP error for unsuccessful responses."""
+    raise_for_status = getattr(response, "raise_for_status", None)
+    if raise_for_status is not None:
+        raise_for_status()
+    elif response.status >= 400:
+        raise urllib3.exceptions.HTTPError(f"HTTP Error {response.status}")
+
+
+def _response_json(response: HTTPResponse) -> dict:
+    """Decode a JSON response from urllib3."""
+    response_json = getattr(response, "json", None)
+    if response_json is not None:
+        return response_json()
+    return jsonlib.loads(response.data)
 
 
