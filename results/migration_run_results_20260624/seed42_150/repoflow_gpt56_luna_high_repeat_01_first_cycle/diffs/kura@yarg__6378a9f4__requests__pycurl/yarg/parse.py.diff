+def _get_response(url):
+    content = BytesIO()
+    response_headers = []
+
+    def collect_header(header):
+        response_headers.append(header)
+        return len(header)
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.WRITEFUNCTION, content.write)
+        curl.setopt(pycurl.HEADERFUNCTION, collect_header)
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+
+    reason = ''
+    for header in reversed(response_headers):
+        if header.startswith(b'HTTP/'):
+            status_line = header.decode('iso-8859-1').strip().split(' ', 2)
+            if len(status_line) == 3:
+                reason = status_line[2]
+            break
+    return status_code, reason, content.getvalue()
 
 
