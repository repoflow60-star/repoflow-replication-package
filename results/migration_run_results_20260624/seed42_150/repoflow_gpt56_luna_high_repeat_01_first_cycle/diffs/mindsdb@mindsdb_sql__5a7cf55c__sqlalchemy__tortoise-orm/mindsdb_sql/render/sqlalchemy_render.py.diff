+class _Expression:
+    """A SQL fragment represented by Tortoise's raw expression primitive."""
+
+    def __init__(self, sql):
+        self.raw = RawSQL(sql)
+        self.sql = self.raw.query
+
+    def __str__(self):
+        return self.sql
+
+    def label(self, name):
+        return _Expression(f'{self} AS {name}')
+
+    def asc(self):
+        return _Expression(f'{self} ASC')
+
+    def desc(self):
+        return _Expression(f'{self} DESC')
+
+
+class _TypeSpec:
+    def __init__(self, sql_type, field_type=None):
+        self.sql_type = sql_type
+        self.field_type = field_type
+
+    def __call__(self, *precision):
+        if not precision:
+            return self
+        return _TypeSpec(f'{self.sql_type}({", ".join(str(i) for i in precision)})', self.field_type)
+
+    def __str__(self):
+        return self.sql_type
