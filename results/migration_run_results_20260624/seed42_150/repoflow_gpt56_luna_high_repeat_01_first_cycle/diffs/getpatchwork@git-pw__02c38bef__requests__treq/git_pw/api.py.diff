+class _Response:
+    """Synchronous view of the response returned by treq."""
+
+    def __init__(self, response: ty.Any, content: bytes):
+        self.status_code = response.code
+        self.content = content
+        self.headers = {
+            _as_text(name).lower(): _as_text(values[0])
+            for name, values in response.headers.getAllRawHeaders()
+            if values
+        }
+
+    def json(self) -> ty.Any:
+        return json.loads(self.content.decode('utf-8'))
+
+    def iter_content(self, chunk_size: int):
+        for offset in range(0, len(self.content), chunk_size):
+            yield self.content[offset : offset + chunk_size]
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            raise _RequestException(self)
+
+
+def _as_text(value: ty.Any) -> str:
+    if isinstance(value, bytes):
+        return value.decode('latin-1')
+    return str(value)
+
+
+def _start_reactor() -> None:
+    _REACTOR_READY.set()
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor() -> None:
+    global _REACTOR_THREAD
+
+    if reactor.running:
+        return
+
+    with _REACTOR_LOCK:
+        if reactor.running:
+            return
+
+        if _REACTOR_THREAD is None or not _REACTOR_THREAD.is_alive():
+            _REACTOR_READY.clear()
+            _REACTOR_THREAD = threading.Thread(
