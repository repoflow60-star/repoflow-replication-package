+def _chart_properties(kwargs):
+    return {
+        name: kwargs[name]
+        for name in ("width", "height", "title", "background", "padding")
+        if name in kwargs
+    }
+
+
+def _mark_options(kwargs, default_opacity):
+    options = {}
+    if "color" in kwargs:
+        options["color"] = kwargs["color"]
+    if "opacity" in kwargs:
+        options["opacity"] = kwargs["opacity"]
+    elif "alpha" in kwargs:
+        options["opacity"] = kwargs["alpha"]
+    else:
+        options["opacity"] = default_opacity
+    if "size" in kwargs:
+        options["size"] = kwargs["size"]
+    if "linewidth" in kwargs:
+        options["strokeWidth"] = kwargs["linewidth"]
+    return options
+
+
+def _scale(loglog):
+    return alt.Scale(type="log") if loglog else None
 
 
