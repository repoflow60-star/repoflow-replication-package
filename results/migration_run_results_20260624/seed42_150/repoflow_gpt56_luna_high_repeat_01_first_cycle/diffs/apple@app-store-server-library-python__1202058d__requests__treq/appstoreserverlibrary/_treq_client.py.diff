--- a/appstoreserverlibrary/_treq_client.py
+++ b/appstoreserverlibrary/_treq_client.py
@@ -0,0 +1,94 @@
+import json as json_module
+import threading
+from typing import Any, Dict, List, Tuple, Union
+
+import treq
+from twisted.internet import reactor
+from twisted.python.failure import Failure
+
+
+_reactor_lock = threading.Lock()
+_reactor_started = threading.Event()
+_reactor_thread = None
+
+
+def _start_reactor() -> None:
+    global _reactor_thread
+
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is not None:
+            _reactor_started.wait()
+            return
+
+        def run_reactor() -> None:
+            reactor.callWhenRunning(_reactor_started.set)
+            reactor.run(installSignalHandlers=False)
+
+        _reactor_thread = threading.Thread(target=run_reactor, daemon=True)
+        _reactor_thread.start()
+    _reactor_started.wait()
+
+
+def _request_on_reactor(
+    method: str,
+    url: str,
+    params: Dict[str, Union[str, List[str]]],
+    headers: Dict[str, str],
+    json: Dict[str, Any],
+    data: bytes,
+):
+    body = data
+    request_headers = dict(headers)
+    if json is not None:
+        body = json_module.dumps(json).encode("utf-8")
+        request_headers.setdefault("Content-Type", "application/json")
+
+    response = treq.request(method, url, params=params, headers=request_headers, data=body)
+    return treq.content(response).addCallback(
+        lambda content: (
+            response.code,
+            {
+                name.decode("latin-1").lower(): b", ".join(values).decode("latin-1")
+                for name, values in response.headers.getAllRawHeaders()
+            },
+            content,
+        )
+    )
+
+
+def request_sync(
+    method: str,
+    url: str,
+    params: Dict[str, Union[str, List[str]]],
+    headers: Dict[str, str],
+    json: Dict[str, Any],
+    data: bytes = None,
+) -> Tuple[int, Dict[str, str], bytes]:
+    _start_reactor()
+    completed = threading.Event()
+    result = []
+
+    def invoke() -> None:
+        try:
+            deferred = _request_on_reactor(method, url, params, headers, json, data)
+            deferred.addBoth(finish)
+        except BaseException as error:
+            finish(error)
+
+    def finish(value):
+        result.append(value)
+        completed.set()
+        return value
+
+    reactor.callFromThread(invoke)
+    completed.wait()
+    value = result[0]
+    if isinstance(value, Failure):
+        value.raiseException()
+    if isinstance(value, BaseException):
+        raise value
+    return value
