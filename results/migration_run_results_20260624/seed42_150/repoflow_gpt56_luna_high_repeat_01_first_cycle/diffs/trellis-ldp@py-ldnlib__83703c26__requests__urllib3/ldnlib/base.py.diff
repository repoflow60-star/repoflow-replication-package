     def __init__(self, **kwargs):
         self.accept_headers = kwargs.get('accept_headers', self.ACCEPT_HEADERS)
 
+    def _request_kwargs(self, kwargs, default_redirect=True):
+        request_kwargs = dict(kwargs)
+        request_kwargs['redirect'] = request_kwargs.pop(
+            'allow_redirects', default_redirect)
+        if 'params' in request_kwargs and 'fields' not in request_kwargs:
+            request_kwargs['fields'] = request_kwargs.pop('params')
+        if request_kwargs.pop('stream', False):
+            request_kwargs['preload_content'] = False
+        return request_kwargs
+
+    def _raise_for_status(self, response):
+        if response.status >= 400:
+            raise urllib3.exceptions.HTTPError(
+                "HTTP {}: {}".format(response.status, response.reason))
+
+    def _response_text(self, response):
+        if isinstance(response.data, str):
+            return response.data
+
+        content_type = response.headers.get('content-type', '')
+        charset = 'utf-8'
+        for parameter in content_type.split(';')[1:]:
+            name, separator, value = parameter.strip().partition('=')
+            if separator and name.lower() == 'charset':
+                charset = value.strip().strip('"')
+                break
+        return response.data.decode(charset, errors='replace')
+
+    def _response_json(self, response):
+        import json
+
+        return json.loads(self._response_text(response))
+
+    def _response_links(self, response):
+        links = {}
+        for link_value in response.headers.get('link', '').split(','):
+            parts = [part.strip() for part in link_value.split(';')]
+            if not parts or not parts[0].startswith('<'):
+                continue
+            url = parts[0].strip('<>')
+            for parameter in parts[1:]:
+                name, separator, value = parameter.partition('=')
+                if separator and name.strip().lower() == 'rel':
+                    for relation in value.strip().strip('"').split():
+                        links[relation] = {'url': url}
+        return links
+
