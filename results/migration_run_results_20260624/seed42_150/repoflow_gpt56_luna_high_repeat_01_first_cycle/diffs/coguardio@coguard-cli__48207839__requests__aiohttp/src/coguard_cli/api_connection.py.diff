+async def _request_async(method, url, timeout, headers=None, data=None, json_body=None):
+    """Make one HTTP request and return its status, reason, and body."""
+    request_kwargs = {}
+    if headers is not None:
+        request_kwargs["headers"] = headers
+    if data is not None:
+        request_kwargs["data"] = data
+    if json_body is not None:
+        request_kwargs["json"] = json_body
+    client_timeout = aiohttp.ClientTimeout(total=timeout)
+    async with aiohttp.ClientSession(timeout=client_timeout) as session:
+        async with session.request(method, url, **request_kwargs) as response:
+            return response.status, response.reason, await response.read()
+
+
+def _request(method, url, timeout, headers=None, data=None, json_body=None):
+    return asyncio.run(
+        _request_async(method, url, timeout, headers, data, json_body)
+    )
+
+
+async def _download_async(url, timeout, headers, location):
+    client_timeout = aiohttp.ClientTimeout(total=timeout)
+    async with aiohttp.ClientSession(timeout=client_timeout) as session:
+        async with session.get(url, headers=headers) as response:
+            response.raise_for_status()
+            with open(location, 'wb') as write_stream:
+                async for chunk in response.content.iter_chunked(8192):
+                    write_stream.write(chunk)
+
+
+def _download(url, timeout, headers, location):
+    asyncio.run(_download_async(url, timeout, headers, location))
 
