+    def _request(self, method, target, **kwargs):
+        headers = kwargs.pop('headers', {})
+        allow_redirects = kwargs.pop('allow_redirects', True)
+        params = kwargs.pop('params', None)
+        timeout = kwargs.pop('timeout', None)
+        verify = kwargs.pop('verify', True)
+        auth = kwargs.pop('auth', None)
+        proxies = kwargs.pop('proxies', None)
+        data = kwargs.pop('data', None)
+
+        if params:
+            separator = '&' if '?' in target else '?'
+            target += separator + urlencode(params, doseq=True)
+
+        body = BytesIO()
+        response_headers = {}
+
+        def receive_header(line):
+            text = line.decode('iso-8859-1').strip()
+            if text.startswith('HTTP/'):
+                response_headers.clear()
+            elif ':' in text:
+                name, value = text.split(':', 1)
+                key = name.strip().lower()
+                value = value.strip()
+                if key in response_headers:
+                    response_headers[key] += ', ' + value
+                else:
+                    response_headers[key] = value
+
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, target)
+            curl.setopt(pycurl.WRITEFUNCTION, body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, receive_header)
+            curl.setopt(pycurl.FOLLOWLOCATION, bool(allow_redirects))
+
+            if method == 'HEAD':
+                curl.setopt(pycurl.NOBODY, True)
+            elif method == 'POST':
+                curl.setopt(pycurl.POST, True)
+                if data is not None:
+                    if isinstance(data, str):
+                        data = data.encode('utf-8')
+                    curl.setopt(pycurl.POSTFIELDS, data)
+            elif method == 'GET':
+                curl.setopt(pycurl.HTTPGET, True)
+            else:
+                curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+            if headers:
+                curl.setopt(pycurl.HTTPHEADER, [
+                    '{}: {}'.format(name, value)
+                    for name, value in headers.items()
+                ])
+            if timeout is not None:
+                if isinstance(timeout, (tuple, list)):
+                    curl.setopt(pycurl.CONNECTTIMEOUT, timeout[0])
+                    curl.setopt(pycurl.TIMEOUT, timeout[-1])
+                else:
+                    curl.setopt(pycurl.TIMEOUT, timeout)
+            if not verify:
+                curl.setopt(pycurl.SSL_VERIFYPEER, 0)
+                curl.setopt(pycurl.SSL_VERIFYHOST, 0)
+            if auth:
+                curl.setopt(pycurl.USERPWD, '{}:{}'.format(*auth))
+            if proxies:
+                proxy = proxies.get('https') or proxies.get('http')
+                if proxy:
+                    curl.setopt(pycurl.PROXY, proxy)
+
+            curl.perform()
+            return _Response(curl.getinfo(pycurl.RESPONSE_CODE),
+                             response_headers, body.getvalue())
+        finally:
+            curl.close()
