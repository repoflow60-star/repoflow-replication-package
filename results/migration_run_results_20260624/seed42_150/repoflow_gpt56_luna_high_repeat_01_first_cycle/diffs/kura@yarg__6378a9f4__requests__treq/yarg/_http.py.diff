--- a/yarg/_http.py
+++ b/yarg/_http.py
@@ -0,0 +1,42 @@
+from threading import Event, Lock, Thread
+
+import treq
+from twisted.internet import defer, reactor, threads
+
+
+_reactor_lock = Lock()
+_reactor_ready = Event()
+_reactor_thread = None
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _reactor_thread
+
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if not reactor.running:
+            if _reactor_thread is None or not _reactor_thread.is_alive():
+                _reactor_ready.clear()
+                _reactor_thread = Thread(target=_run_reactor)
+                _reactor_thread.daemon = True
+                _reactor_thread.start()
+    _reactor_ready.wait()
+
+
+@defer.inlineCallbacks
+def _request(url):
+    response = yield treq.get(url)
+    content = yield treq.content(response)
+    defer.returnValue((response, content))
+
+
+def get(url):
+    """Perform a GET through treq while keeping yarg's sync API."""
+    _ensure_reactor()
+    return threads.blockingCallFromThread(reactor, _request, url)
