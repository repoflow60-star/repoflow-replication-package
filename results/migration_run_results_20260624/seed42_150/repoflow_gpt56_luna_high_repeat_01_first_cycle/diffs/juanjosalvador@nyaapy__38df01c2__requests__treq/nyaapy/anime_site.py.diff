-import requests
+from twisted.internet import defer
+from twisted.internet.selectreactor import SelectReactor
+from twisted.web.client import Agent
+import treq
+
 from nyaapy import torrent
 from nyaapy.parser import parse_nyaa, parse_single, parse_nyaa_rss
+
+
+def _get(url: str, *, text: bool = False):
+    """Perform a treq request while preserving the module's sync API."""
+    reactor = SelectReactor()
+    agent = Agent(reactor)
+    result = []
+    errors = []
+
+    def stop_reactor():
+        if reactor.running:
+            reactor.stop()
+        else:
+            reactor.callWhenRunning(reactor.stop)
+
+    @defer.inlineCallbacks
+    def fetch():
+        response = yield treq.get(url, agent=agent)
+        if response.code >= 400:
+            raise RuntimeError(f"HTTP {response.code}: {response.phrase}")
+
+        if text:
+            body = yield response.text()
+        else:
+            body = yield response.content()
+        result.append(body)
+        stop_reactor()
+
+    def handle_error(failure):
+        errors.append(failure.value)
+        stop_reactor()
+
+    fetch().addErrback(handle_error)
+    reactor.run()
+
+    if errors:
+        raise errors[0]
+    return result[0]
 
 
