+class HTTPError(Exception):
+    """Raised when an HTTP response has an unsuccessful status code."""
+
+
+class JSONDecodeError(ValueError):
+    """Raised when an HTTP response does not contain valid JSON."""
+
+
+class HTTPResponse:
+    """Response data returned by the pycurl transport."""
+
+    def __init__(self, status_code: int, reason: str, content: bytes) -> None:
+        self.status_code = status_code
+        self.reason = reason
+        self.content = content
+
+    def json(self) -> Any:
+        """Decode the response body as JSON."""
+        try:
+            return json.loads(self.content.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError) as ex:
+            raise JSONDecodeError(str(ex)) from ex
+
+    def raise_for_status(self) -> None:
+        """Raise an error when the response status indicates failure."""
+        if self.status_code >= 400:
+            raise HTTPError(f"{self.status_code} {self.reason}")
+
+
+class _AuthRequest:
+    """Header container accepted by pycognito's authentication callback."""
+
+    def __init__(self, headers: dict[str, str]) -> None:
