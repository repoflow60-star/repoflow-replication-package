+class CurlResponse:
+    def __init__(self, status_code: int, content: bytes) -> None:
+        self.status_code = status_code
+        self.content = content
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status_code < 400
+
+    @property
+    def text(self) -> str:
+        return self.content.decode("utf-8", errors="replace")
+
+    def json(self):
+        return json.loads(self.content)
+
+
+class CurlSession:
+    def __init__(self) -> None:
+        self.cookies = {}
+        self.headers = {}
+
+    @staticmethod
+    def _with_params(url: str, params: Optional[dict]) -> str:
+        if not params:
+            return url
+        parsed = urlsplit(url)
+        query = urlencode(params, doseq=True)
+        if parsed.query:
+            query = f"{parsed.query}&{query}"
+        return urlunsplit(
+            (parsed.scheme, parsed.netloc, parsed.path, query, parsed.fragment)
+        )
+
+    def _request(
+        self,
+        url: str,
+        method: str,
+        data=None,
+        params: Optional[dict] = None,
+        headers: Optional[dict] = None,
+        json_body=None,
+    ) -> CurlResponse:
+        body = io.BytesIO()
+        curl = pycurl.Curl()
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+        if self.cookies:
+            request_headers["Cookie"] = "; ".join(
+                f"{name}={value}" for name, value in self.cookies.items()
+            )
+        if json_body is not None:
+            data = json.dumps(json_body).encode("utf-8")
+            if not any(key.lower() == "content-type" for key in request_headers):
+                request_headers["Content-Type"] = "application/json"
+
+        curl.setopt(pycurl.URL, self._with_params(url, params))
+        curl.setopt(pycurl.WRITEDATA, body)
+        curl.setopt(pycurl.FOLLOWLOCATION, True)
+        if request_headers:
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                [f"{key}: {value}" for key, value in request_headers.items()],
+            )
+        if method == "POST":
+            curl.setopt(pycurl.POST, True)
+            if data is not None:
+                curl.setopt(pycurl.POSTFIELDS, data)
+        try:
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+        return CurlResponse(status_code, body.getvalue())
+
+    def get(self, url: str, params: Optional[dict] = None) -> CurlResponse:
+        return self._request(url, "GET", params=params)
+
+    def post(
+        self,
+        url: str,
+        data=None,
+        params: Optional[dict] = None,
+        headers: Optional[dict] = None,
+        json=None,
+    ) -> CurlResponse:
+        return self._request(
+            url,
+            "POST",
+            data=data,
+            params=params,
+            headers=headers,
+            json_body=json,
+        )
+
+
