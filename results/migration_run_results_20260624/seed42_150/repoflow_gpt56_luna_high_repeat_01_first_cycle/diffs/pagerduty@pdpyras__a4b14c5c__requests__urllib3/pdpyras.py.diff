+def _adapt_response(response: Response, method: str, url: str,
+        elapsed: float) -> Response:
+    """Add the response attributes used by the public client API."""
+    response.status_code = response.status
+    response.ok = response.status < 400
+    response.request = SimpleNamespace(method=method, url=url)
+    response.elapsed = timedelta(seconds=elapsed)
+    response.content = response.data
+    content_type = response.headers.get('content-type', '')
+    encoding = 'utf-8'
+    if 'charset=' in content_type:
+        encoding = content_type.split('charset=', 1)[1].split(';', 1)[0].strip()
+    response.text = response.data.decode(encoding, errors='replace')
+    response.json = lambda: json.loads(response.text)
+    return response
+
