+def _scatter(ax, x, y, colors, palette, **kwargs):
+    """Render colored points through seaborn while preserving point styling."""
+    if len(x) == 0:
+        return
+    color_to_label = {color: label for label, color in palette.items()}
+    labels = [color_to_label[color] for color in colors]
+    sns.scatterplot(
+        x=x,
+        y=y,
+        hue=labels,
+        palette=palette,
+        ax=ax,
+        **kwargs,
+    )
+
