+class _AiohttpResponse(io.BytesIO):
+    def __init__(self, status, headers, body):
+        super().__init__(body)
+        self.status = status
+        self.headers = headers
+        self.data = body
+
+    def getheaders(self):
+        return self.headers
+
+    def stream(self, amt=65536):
+        while True:
+            chunk = self.read(amt)
+            if not chunk:
+                break
+            yield chunk
+
+
+class _AiohttpTransport:
+    def __init__(self, proxy=None, proxy_auth=None, **kwargs):
+        timeout = kwargs.pop("timeout", 60)
+        if isinstance(timeout, (int, float)) or timeout is None:
+            timeout = aiohttp.ClientTimeout(total=timeout)
+
+        ca_certs = kwargs.pop("ca_certs", None)
+        cert_reqs = kwargs.pop("cert_reqs", ssl.CERT_REQUIRED)
+        ssl_context = None
+        if ca_certs is not None:
+            ssl_context = ssl.create_default_context(cafile=ca_certs)
+        elif cert_reqs == ssl.CERT_NONE:
+            ssl_context = ssl.create_default_context()
+            ssl_context.check_hostname = False
+            ssl_context.verify_mode = ssl.CERT_NONE
+
+        self._timeout = timeout
+        self._proxy = proxy
+        self._proxy_auth = proxy_auth
+        self._ssl_context = ssl_context
+        self._limit = kwargs.pop("maxsize", 100)
+        self._closed = False
+
+    async def _request(self, method, url, fields, body, headers):
+        request_kwargs = {
+            "headers": headers,
+            "timeout": self._timeout,
+            "ssl": self._ssl_context,
+        }
+        if self._proxy is not None:
+            request_kwargs["proxy"] = self._proxy
+            request_kwargs["proxy_auth"] = self._proxy_auth
+
+        method = method.upper()
+        if fields is not None:
+            if method in ("GET", "DELETE", "HEAD", "OPTIONS"):
+                request_kwargs["params"] = fields
+            else:
+                request_kwargs["data"] = fields
+        if body is not None:
+            if isinstance(body, array):
+                body = body.tobytes()
+            request_kwargs["data"] = body
+
+        connector = aiohttp.TCPConnector(limit=self._limit, ssl=self._ssl_context)
+        async with aiohttp.ClientSession(connector=connector) as session:
+            async with session.request(method, url, **request_kwargs) as response:
+                return _AiohttpResponse(
+                    response.status, dict(response.headers), await response.read()
+                )
+
+    def request(self, method, url, fields=None, body=None, headers=None, **kwargs):
+        if self._closed:
+            raise RuntimeError("HTTP transport is closed")
+        return asyncio.run(self._request(method, url, fields, body, headers))
+
+    def close(self):
+        self._closed = True
+
