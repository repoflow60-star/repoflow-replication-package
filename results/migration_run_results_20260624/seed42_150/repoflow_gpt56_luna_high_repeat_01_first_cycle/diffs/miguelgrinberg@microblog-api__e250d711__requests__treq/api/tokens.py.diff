+
+_reactor_lock = Lock()
+_reactor_ready = Event()
+_reactor_thread = None
+
+
+def _ensure_reactor():
+    global _reactor_thread
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if _reactor_thread is None:
+            _reactor_thread = Thread(
+                target=reactor.run,
+                kwargs={'installSignalHandlers': False},
+                daemon=True)
+            reactor.callWhenRunning(_reactor_ready.set)
+            _reactor_thread.start()
+    _reactor_ready.wait()
+
+
+def _wait_for(deferred):
+    result = []
+    finished = Event()
+
+    def complete(value):
+        result.append(value)
+        finished.set()
+        return value
+
+    deferred.addBoth(complete)
+    finished.wait()
+    if isinstance(result[0], Failure):
+        result[0].raiseException()
+    return result[0]
+
+
+def _run_in_reactor(function):
+    deferred = defer.Deferred()
+
+    def invoke():
+        defer.maybeDeferred(function).chainDeferred(deferred)
+
+    reactor.callFromThread(invoke)
+    return _wait_for(deferred)
+
+
+def _oauth_request(method, url, **kwargs):
+    _ensure_reactor()
+    request_method = treq.post if method == 'POST' else treq.get
+    result = _run_in_reactor(lambda: request_method(url, **kwargs))
+    return result.code, result
 
 
