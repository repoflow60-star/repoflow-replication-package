+class _EndpointFactory:
+    def __init__(self, timeout):
+        self.timeout = timeout
+
+    def endpointForURI(self, uri):
+        host = uri.host.decode("ascii") if isinstance(uri.host, bytes) else uri.host
+        scheme = uri.scheme.decode("ascii") if isinstance(uri.scheme, bytes) else uri.scheme
+        port = uri.port or (443 if scheme == "https" else 80)
+        addresses = socket.getaddrinfo(host, port, get_ip_family(), socket.SOCK_STREAM)
+        family, _, _, _, address = addresses[0]
+        endpoint_type = TCP6ClientEndpoint if family == socket.AF_INET6 else TCP4ClientEndpoint
+        return endpoint_type(reactor, address[0], port, timeout=self.timeout)
+
+
+def _start_reactor():
+    """Run Twisted once in a background thread for the synchronous API."""
+    global _reactor_thread_started
+
+    if reactor.running:
+        return
+
+    with _reactor_start_lock:
+        if reactor.running or _reactor_thread_started:
+            return
+
+        _reactor_thread_started = True
+
+        def run_reactor():
+            _reactor_ready.set()
+            reactor.run(installSignalHandlers=False)
+
+        Thread(target=run_reactor, name="PastePwnTreqReactor", daemon=True).start()
+        _reactor_ready.wait()
+
+
+def _agent_for(url, proxies, timeout):
+    proxy = None
+    if proxies is not None:
+        parsed_url = urlsplit(url)
+        proxy = proxies.get(parsed_url.scheme) or proxies.get("all")
+
+    if proxy:
+        parsed_proxy = urlsplit(proxy)
+        proxy_host = parsed_proxy.hostname
+        proxy_port = parsed_proxy.port or 80
+        proxy_addresses = socket.getaddrinfo(proxy_host, proxy_port, get_ip_family(), socket.SOCK_STREAM)
+        family, _, _, _, address = proxy_addresses[0]
+        endpoint_type = TCP6ClientEndpoint if family == socket.AF_INET6 else TCP4ClientEndpoint
+        proxy_endpoint = endpoint_type(reactor, address[0], proxy_port, timeout=timeout)
+        return ProxyAgent(reactor, proxy_endpoint)
+
+    return Agent.usingEndpointFactory(reactor, _EndpointFactory(timeout))
+
+
+def _request_content(method, url, headers, data, timeout, proxies):
+    agent = _agent_for(url, proxies, timeout)
+    request = treq.request(method, url, headers=headers, data=data, timeout=timeout, agent=agent)
+    return request.addCallback(treq.content)
+
+
+def _headers_for_treq(headers):
