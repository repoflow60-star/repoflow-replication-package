+_reactor_lock = threading.Lock()
+_reactor_ready = threading.Event()
+_reactor_thread = None
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _call_in_reactor(function):
+    global _reactor_thread
+
+    with _reactor_lock:
+        if _reactor_thread is None and not reactor.running:
+            _reactor_thread = threading.Thread(target=_run_reactor, daemon=True)
+            _reactor_thread.start()
+            _reactor_ready.wait()
+
+    return blockingCallFromThread(reactor, function)
+
+
+class _ResponseAdapter:
+    def __init__(self, response, content: bytes, url: str):
+        self.status_code = response.code
+        self.url = url
+        self.headers = {}
+        for name, values in response.headers.getAllRawHeaders():
+            if isinstance(name, bytes):
+                name = name.decode('ascii')
+            value = values[0]
+            if isinstance(value, bytes):
+                value = value.decode('utf-8')
+            self.headers[name] = value
+        self._content = content
+
+    def json(self):
+        return json_module.loads(self._content.decode('utf-8'))
 
 
