+def _normalize_param_value(value):
+    if value is None:
+        return None
+    if isinstance(value, (list, tuple)):
+        return [str(item) for item in value if item is not None]
+    return str(value)
+
+
+def _build_url(url: str, params=None) -> str:
+    if not params:
+        return url
+
+    query_items = []
+    for key, value in params.items():
+        normalized_value = _normalize_param_value(value)
+        if normalized_value is None:
+            continue
+        if isinstance(normalized_value, list):
+            query_items.extend((key, item) for item in normalized_value)
+        else:
+            query_items.append((key, normalized_value))
+
+    split_url = urlsplit(url)
+    query = urlencode(query_items, doseq=True)
+    merged_query = '&'.join(filter(None, [split_url.query, query]))
+    return urlunsplit(split_url._replace(query=merged_query))
+
+
+def _extract_encoding(content_type: str) -> Optional[str]:
+    if not content_type:
+        return None
+    for part in content_type.split(';')[1:]:
+        key, _, value = part.strip().partition('=')
+        if key.lower() == 'charset' and value:
+            return value.strip('"')
+    return None
+
