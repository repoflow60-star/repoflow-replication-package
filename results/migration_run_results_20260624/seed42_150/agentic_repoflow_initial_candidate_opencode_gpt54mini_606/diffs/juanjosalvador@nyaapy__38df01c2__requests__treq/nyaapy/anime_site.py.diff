-import requests
+from threading import Event, Thread
+from time import sleep
+from urllib.error import HTTPError
+
+import treq
+from twisted.internet import reactor
+from twisted.internet.threads import blockingCallFromThread
 from nyaapy import torrent
 from nyaapy.parser import parse_nyaa, parse_single, parse_nyaa_rss
+
+
+_reactor_started = Event()
+_reactor_thread = None
+
+
+def _ensure_reactor_running():
+    global _reactor_thread
+
+    if reactor.running:
+        return
+
+    if _reactor_thread is None:
+        def _run_reactor():
+            _reactor_started.set()
+            reactor.run(installSignalHandlers=False)
+
+        _reactor_thread = Thread(target=_run_reactor, daemon=True)
+        _reactor_thread.start()
+
+    _reactor_started.wait()
+
+    while not reactor.running:
+        sleep(0.01)
+
+
+def _get_content(url):
+    _ensure_reactor_running()
+
+    def _request():
+        def _check_status(response):
+            if response.code >= 400:
+                phrase = getattr(response, "phrase", b"")
+                if isinstance(phrase, bytes):
+                    phrase = phrase.decode("utf-8", "ignore")
+                raise HTTPError(url, response.code, phrase, None, None)
+
+            return treq.content(response)
+
+        return treq.get(url).addCallback(_check_status)
+
+    return blockingCallFromThread(reactor, _request)
 
 
