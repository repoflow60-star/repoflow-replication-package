+    def _compose_chart(
+        self,
+        figsize: tuple[float, float],
+        title: str | None = None,
+        font_size_title: float = 18.0,
+    ) -> alt.LayerChart:
+        width = max(1, int(figsize[0] * 80.0))
+        height = max(1, int(figsize[1] * 80.0))
+        chart = alt.layer(*self.axes).resolve_scale(x="shared", y="shared").properties(width=width, height=height)
+        chart = chart.configure_view(stroke=None)
+        if title is not None:
+            chart = chart.properties(title={"text": title or "", "fontSize": font_size_title})
+        return chart
+
+    @staticmethod
+    def _color_to_hex(color: tuple[float, float, float]) -> str:
+        return "#" + "".join(f"{int(round(channel * 255)):02x}" for channel in color)
+
+    @staticmethod
+    def _rule_style(style: dict[str, float | str]) -> dict[str, object]:
+        result: dict[str, object] = {}
+        if "color" in style:
+            result["color"] = style["color"]
+        if "linewidth" in style:
+            result["strokeWidth"] = style["linewidth"]
+        linestyle = style.get("linestyle")
+        if isinstance(linestyle, str):
+            result["strokeDash"] = {
+                "solid": [],
+                "-": [],
+                "dash": [6, 4],
+                "dashed": [6, 4],
+                "dot": [1, 4],
+                "dotted": [1, 4],
+                "dashdot": [6, 4, 1, 4],
+            }.get(linestyle, [])
+        return result
