+class HTTPError(Exception):
+    """Raised when an HTTP response is not successful."""
+
+
+class Response:
+    """Minimal response object used by the public API."""
+
+    def __init__(
+        self,
+        *,
+        url: str,
+        status_code: int,
+        reason: str,
+        headers: dict[str, str],
+        body: bytes,
+    ) -> None:
+        self.url = url
+        self.status_code = status_code
+        self.reason = reason
+        self.headers = headers
+        self.content = body
+        self.text = body.decode("utf-8", errors="replace")
+
+    def json(self):
+        return json_module.loads(self.text)
+
+    def raise_for_status(self):
+        if self.status_code < 400:
+            return
+        status_class = "HTTP Error"
+        if 400 <= self.status_code < 500:
+            status_class = "Client Error"
+        elif 500 <= self.status_code < 600:
+            status_class = "Server Error"
+        raise HTTPError(
+            f"{self.status_code} {status_class}: {self.reason} for url: {self.url}"
+        )
+
+
+class _Request:
+    def __init__(
+        self, method: str, url: str, body=None, headers: dict[str, str] | None = None
+    ) -> None:
+        self.method = method
+        self.url = url
+        self.headers = dict(headers or {})
+        self.body = body
+        self.data = body
+        self.params = None
+        self.auth = None
+
+
+def _request_body_from_kwargs(kwargs: dict, headers: dict[str, str]) -> bytes | None:
+    if "json" in kwargs:
+        body = json_module.dumps(kwargs.pop("json")).encode("utf-8")
+        headers["Content-Type"] = "application/json"
+        return body
+
+    if "data" not in kwargs:
+        return None
+
+    data = kwargs.pop("data")
+    if data is None:
+        return None
+    if isinstance(data, bytes):
+        return data
+    if isinstance(data, str):
+        return data.encode("utf-8")
+    try:
+        headers.setdefault("Content-Type", "application/x-www-form-urlencoded")
+        return urlencode(data, doseq=True).encode("utf-8")
+    except (TypeError, ValueError):
+        return str(data).encode("utf-8")
+
+
+def _apply_auth(
+    auth, method: str, url: str, body: bytes | None, headers: dict[str, str]
+) -> dict[str, str]:
+    request = _Request(method, url, body, headers)
+    authed_request = auth(request)
+    if authed_request is not None:
+        merged_headers = dict(request.headers)
+        merged_headers.update(getattr(authed_request, "headers", {}))
+        return merged_headers
+    return request.headers
+
+
+def _curl_response(
+    url: str,
+    method: str,
+    headers: list[str],
+    body: bytes | None,
+    timeout: int | float,
+) -> Response:
+    response_body = BytesIO()
+    response_headers = BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.ACCEPT_ENCODING, "")
+        curl.setopt(pycurl.NOSIGNAL, 1)
+        curl.setopt(pycurl.TIMEOUT_MS, int(timeout * 1000))
+        curl.setopt(pycurl.CONNECTTIMEOUT_MS, int(timeout * 1000))
+        curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+        curl.setopt(pycurl.HEADERFUNCTION, response_headers.write)
+        curl.setopt(pycurl.HTTPHEADER, headers)
+        if method == "GET":
+            curl.setopt(pycurl.HTTPGET, 1)
+        elif method == "POST":
+            curl.setopt(pycurl.POST, 1)
+        else:
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+        if body is not None:
+            curl.setopt(pycurl.POSTFIELDS, body)
+        curl.perform()
+        status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+    finally:
+        curl.close()
+
+    parsed_headers: dict[str, str] = {}
+    reason = ""
+    for raw_line in response_headers.getvalue().splitlines():
+        line = raw_line.decode("iso-8859-1")
+        if line.startswith("HTTP/"):
+            parts = line.split(None, 2)
+            if len(parts) >= 3:
+                reason = parts[2].strip()
+            continue
+        if ":" in line:
+            key, value = line.split(":", 1)
+            parsed_headers[key.strip()] = value.strip()
+
+    if not reason:
+        reason = (
+            HTTPStatus(status_code).phrase
+            if status_code in HTTPStatus._value2member_map_
+            else ""
+        )
+    return Response(
+        url=url,
+        status_code=status_code,
+        reason=reason,
+        headers=parsed_headers,
+        body=response_body.getvalue(),
+    )
