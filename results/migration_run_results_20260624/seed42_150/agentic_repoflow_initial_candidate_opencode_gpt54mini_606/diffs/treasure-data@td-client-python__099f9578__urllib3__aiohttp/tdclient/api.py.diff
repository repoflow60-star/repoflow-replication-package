+class _AiohttpResponse:
+    def __init__(self, status, headers, body):
+        self.status = status
+        self._headers = headers
+        self._body = body
+        self.data = body
+
+    def read(self):
+        return self._body
+
+    def getheaders(self):
+        return list(self._headers)
+
+    def close(self):
+        pass
+
+
+class _AiohttpTransport:
+    def __init__(self, timeout=None, ssl_context=None, proxy=None, proxy_auth=None):
+        self._timeout = timeout
+        self._ssl_context = ssl_context
+        self._proxy = proxy
+        self._proxy_auth = proxy_auth
+
+    def request(self, method, url, fields=None, body=None, headers=None, **kwargs):
+        return asyncio.run(
+            self._request(method, url, fields=fields, body=body, headers=headers)
+        )
+
+    urlopen = request
+
+    def clear(self):
+        pass
+
+    async def _request(self, method, url, fields=None, body=None, headers=None):
+        session_kwargs = {}
+        if self._timeout is not None:
+            session_kwargs["timeout"] = aiohttp.ClientTimeout(total=self._timeout)
+
+        request_kwargs = {"headers": headers or {}}
+        if fields is not None:
+            if method.upper() in {"GET", "DELETE"}:
+                request_kwargs["params"] = fields
+            else:
+                request_kwargs["data"] = fields
+        if body is not None:
+            if isinstance(body, array):
+                body = body.tobytes()
+            elif isinstance(body, bytearray):
+                body = bytes(body)
+            request_kwargs["data"] = body
+        if self._proxy is not None:
+            request_kwargs["proxy"] = self._proxy
+            if self._proxy_auth is not None:
+                request_kwargs["proxy_auth"] = self._proxy_auth
+        if self._ssl_context is not None and urlparse.urlparse(url).scheme == "https":
+            request_kwargs["ssl"] = self._ssl_context
+
+        async with aiohttp.ClientSession(**session_kwargs) as session:
+            async with session.request(method, url, **request_kwargs) as response:
+                body = await response.read()
+                return _AiohttpResponse(response.status, list(response.headers.items()), body)
+
