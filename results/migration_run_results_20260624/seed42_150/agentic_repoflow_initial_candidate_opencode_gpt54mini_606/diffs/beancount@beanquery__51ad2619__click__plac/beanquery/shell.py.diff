+class _PlacCommand:
+    def __init__(self, func):
+        self.func = func
+        self.name = func.__name__.replace('_', '-')
+        self.__doc__ = func.__doc__
+
+    def __call__(self):
+        return self.main()
+
+    def main(self, args=None, prog_name=None, **kwargs):
+        argv = _translate_short_options(list(sys.argv[1:] if args is None else args))
+        if '--version' in argv:
+            print(f'beanquery {beanquery.__version__}, beancount {beancount.__version__}')
+            return 0
+        old_argv = sys.argv
+        try:
+            sys.argv = [prog_name or old_argv[0], *argv]
+            return plac.call(self.func)
+        finally:
+            sys.argv = old_argv
+
+
+main = _PlacCommand(_main)
+
+
+if __name__ == '__main__':
+    main()
