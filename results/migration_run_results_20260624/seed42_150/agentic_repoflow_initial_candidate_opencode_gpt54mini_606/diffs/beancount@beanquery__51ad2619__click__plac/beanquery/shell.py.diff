+def _translate_short_options(args):
+    translated = []
+    index = 0
+    while index < len(args):
+        arg = args[index]
+        if arg == '-m':
+            translated.append('--numberify')
+        elif arg in {'-q', '--no-errors', '--no_errors'}:
+            pass
+        elif arg == '-f':
+            translated.append('--format')
+            index += 1
+            if index < len(args):
+                translated.append(args[index])
+        elif arg.startswith('-f='):
+            translated.extend(['--format', arg[3:]])
+        elif arg.startswith('-f') and len(arg) > 2:
+            translated.extend(['--format', arg[2:]])
+        elif arg == '-o':
+            translated.append('--output')
+            index += 1
+            if index < len(args):
+                translated.append(args[index])
+        elif arg.startswith('-o='):
+            translated.extend(['--output', arg[3:]])
+        elif arg.startswith('-o') and len(arg) > 2:
+            translated.extend(['--output', arg[2:]])
+        else:
+            translated.append(arg)
+        index += 1
+    return translated
+
