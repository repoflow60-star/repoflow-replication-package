+def _figure(kwargs):
+    fig = kwargs.get("ax")
+    if fig is None or not hasattr(fig, "add_trace"):
+        fig = go.Figure()
+    return fig
+
+
+def _marker_style(kwargs):
+    marker = {}
+    if "color" in kwargs:
+        marker["color"] = kwargs["color"]
+    if "size" in kwargs:
+        marker["size"] = kwargs["size"]
+    return marker
+
+
+def _line_style(kwargs):
+    line = {}
+    if "color" in kwargs:
+        line["color"] = kwargs["color"]
+    if "linewidth" in kwargs:
+        line["width"] = kwargs["linewidth"]
+    if "lw" in kwargs:
+        line["width"] = kwargs["lw"]
+    if "linestyle" in kwargs:
+        line["dash"] = {
+            "-": "solid",
+            "--": "dash",
+            "-.": "dashdot",
+            ":": "dot",
+        }.get(kwargs["linestyle"], kwargs["linestyle"])
+    return line
+
+
+def _density_curve(values):
+    values = np.asarray(values, dtype=float)
+    if values.size == 0:
+        return values, values
+    if values.size < 2 or np.all(values == values[0]):
+        return values, np.ones_like(values)
+
+    density = gaussian_kde(values)
+    x = np.linspace(float(values.min()), float(values.max()), 200)
+    return x, density(x)
 
 
