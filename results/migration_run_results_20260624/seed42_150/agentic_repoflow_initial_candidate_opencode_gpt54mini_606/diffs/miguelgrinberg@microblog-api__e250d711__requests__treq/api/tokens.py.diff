+_reactor_ready = Event()
+_reactor_started = False
+
+
+def _run_reactor():
+    _reactor_ready.set()
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor_running():
+    global _reactor_started
+    if reactor.running:
+        return
+    if not _reactor_started:
+        _reactor_started = True
+        Thread(target=_run_reactor, daemon=True).start()
+        _reactor_ready.wait()
+
+
+def _treq_call(func, *args, **kwargs):
+    _ensure_reactor_running()
+    return threads.blockingCallFromThread(reactor, func, *args, **kwargs)
+
+
+def _response_code(response):
+    code = getattr(response, 'status_code', None)
+    if code is None:
+        code = response.code
+    return code
+
+
+def _response_json(response):
+    json_method = getattr(response, 'json', None)
+    if callable(json_method):
+        return json_method()
+    return _treq_call(treq.json_content, response)
 
 
