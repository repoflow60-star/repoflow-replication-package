--- a/yarg/_treq.py
+++ b/yarg/_treq.py
@@ -0,0 +1,52 @@
+from threading import Event, Lock, Thread
+
+import treq
+from twisted.internet import reactor
+from twisted.internet.threads import blockingCallFromThread
+
+
+_reactor_lock = Lock()
+_reactor_thread = None
+
+
+def _run_reactor(ready):
+    reactor.callWhenRunning(ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _reactor_thread
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is None or not _reactor_thread.is_alive():
+            ready = Event()
+            _reactor_thread = Thread(target=_run_reactor,
+                                     args=(ready,),
+                                     name='yarg-treq-reactor',
+                                     daemon=True)
+            _reactor_thread.start()
+            ready.wait()
+
+
+def get(url, **kwargs):
+    _ensure_reactor()
+    return blockingCallFromThread(reactor, treq.get, url, **kwargs)
+
+
+def content(response):
+    _ensure_reactor()
+    return blockingCallFromThread(reactor, treq.content, response)
+
+
+def status_code(response):
+    return getattr(response, 'code', getattr(response, 'status_code', None))
+
+
+def reason(response):
+    value = getattr(response, 'phrase', getattr(response, 'reason', None))
+    if isinstance(value, bytes):
+        return value.decode('utf-8', 'replace')
+    return value
