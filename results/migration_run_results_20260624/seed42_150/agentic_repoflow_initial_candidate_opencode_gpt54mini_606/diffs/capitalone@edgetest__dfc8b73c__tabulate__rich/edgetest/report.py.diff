+
+def _column_widths(headers: List[str], rows: List[List]) -> List[int]:
+    widths = [len(str(header)) for header in headers]
+    for row in rows:
+        for idx, cell in enumerate(row):
+            widths[idx] = max(widths[idx], len("" if cell is None else str(cell)))
+    return widths
+
+
+def _render_row(values: List, widths: List[int]) -> str:
+    return "  ".join(
+        ("" if value is None else str(value)).ljust(widths[idx])
+        for idx, value in enumerate(values)
+    )
+
+
+def _render_table(rows: List[List], headers: List[str], tablefmt: str) -> str:
+    widths = _column_widths(headers, rows)
+    header_row = _render_row(headers, widths)
+
+    if tablefmt == "github":
+        separator = "  ".join("-" * max(3, width) for width in widths)
+        lines = [f"| {header_row} |", f"| {separator} |"]
+        lines.extend(f"| {_render_row(row, widths)} |" for row in rows)
+        return "\n".join(lines)
+
+    separator = "  ".join("=" * width for width in widths)
+    lines = [separator, header_row, separator]
+    lines.extend(_render_row(row, widths) for row in rows)
+    lines.append(separator)
+    return "\n".join(lines)
+
+
+def tabulate(rows: List[List], headers: List[str], tablefmt: str = "rst") -> str:
+    """Render a table using rich."""
+    rendered = _render_table(rows, headers, tablefmt)
+    console = Console(record=True, width=max((len(line) for line in rendered.splitlines()), default=1))
+    console.print(Text(rendered))
+    return console.export_text(clear=True).rstrip("\n")
 
 
