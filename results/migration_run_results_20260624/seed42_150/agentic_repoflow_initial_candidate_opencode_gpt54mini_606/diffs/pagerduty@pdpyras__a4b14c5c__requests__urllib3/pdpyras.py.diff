+class Response:
+    def __init__(self, response: HTTPResponse, method: str, url: str,
+            elapsed=None):
+        self._response = response
+        self.raw = response
+        self.url = url
+        self.request = _RequestInfo(method=method, url=url)
+        self.elapsed = elapsed if elapsed is not None else timedelta(0)
+
+    @property
+    def status_code(self):
+        return self._response.status or 0
+
+    @property
+    def ok(self):
+        return 200 <= self.status_code < 400
+
+    @property
+    def headers(self):
+        return self._response.headers
+
+    @property
+    def content(self):
+        return self._response.data or b''
+
+    @property
+    def text(self):
+        content = self.content
+        if not content:
+            return ''
+        content_type = self.headers.get('content-type', '')
+        charset = 'utf-8'
+        for item in content_type.split(';'):
+            item = item.strip()
+            if item.lower().startswith('charset='):
+                charset = item.split('=', 1)[1].strip().strip('"').strip("'")
+                break
+        return content.decode(charset, errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+    @property
+    def reason(self):
+        return self._response.reason
+
+    def __bool__(self):
+        return self.ok
+
+    def raise_for_status(self):
