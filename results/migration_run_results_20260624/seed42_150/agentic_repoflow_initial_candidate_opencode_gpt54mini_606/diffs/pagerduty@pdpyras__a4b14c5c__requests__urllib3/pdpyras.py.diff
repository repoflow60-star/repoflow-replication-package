+class Session:
+    def __init__(self):
+        self.headers = {}
+        self._pool = PoolManager()
+
+    def _merge_params(self, url, params):
+        if not params:
+            return url
+        parts = urlsplit(url)
+        existing = parse_qsl(parts.query, keep_blank_values=True)
+        if isinstance(params, dict):
+            new_params = list(params.items())
+        else:
+            new_params = list(params)
+        query = urlencode(existing + new_params, doseq=True)
+        return urlunsplit((parts.scheme, parts.netloc, parts.path, query,
+            parts.fragment))
+
+    def request(self, method, url, **kwargs) -> Response:
+        method = method.strip().upper()
+        request_kw = dict(kwargs)
+        headers = deepcopy(self.headers)
+        user_headers = request_kw.pop('headers', None)
+        if user_headers:
+            headers.update(user_headers)
+        timeout = request_kw.pop('timeout', None)
+        url = self._merge_params(url, request_kw.pop('params', None))
+        body = request_kw.pop('body', None)
+        json_body = request_kw.pop('json', None)
+        data = request_kw.pop('data', None)
+        request_kw.pop('stream', None)
+        if body is None:
+            if json_body is not None:
+                body = json.dumps(json_body).encode('utf-8')
+                headers.setdefault('Content-Type', 'application/json')
+            elif data is not None:
+                if isinstance(data, str):
+                    body = data.encode('utf-8')
+                elif isinstance(data, (dict, list, tuple)):
+                    body = urlencode(data, doseq=True).encode('utf-8')
+                    headers.setdefault('Content-Type',
+                        'application/x-www-form-urlencoded')
+                else:
+                    body = data
+        if body is not None:
+            request_kw['body'] = body
+        start = time.monotonic()
+        raw = self._pool.request(method, url, headers=headers,
+            timeout=timeout, preload_content=True, retries=False, **request_kw)
+        elapsed = timedelta(seconds=time.monotonic() - start)
+        return Response(raw, method=method, url=url, elapsed=elapsed)
+
+    def get(self, url, **kwargs):
