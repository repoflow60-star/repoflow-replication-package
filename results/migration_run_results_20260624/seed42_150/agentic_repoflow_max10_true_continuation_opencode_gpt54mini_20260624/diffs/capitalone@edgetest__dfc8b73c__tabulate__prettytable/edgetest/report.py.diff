 from edgetest.core import TestPackage
 
 VALID_OUTPUTS = ["rst", "github"]
+
+
+def _column_widths(headers: List[str], rows: List[List[str]]) -> List[int]:
+    widths = []
+    for index, header in enumerate(headers):
+        width = len(str(header))
+        for row in rows:
+            if index < len(row):
+                width = max(width, len(str(row[index])))
+        widths.append(width)
+
+    return widths
+
+
+def _render_rst_table(headers: List[str], rows: List[List[str]]) -> str:
+    widths = _column_widths(headers, rows)
+
+    def render_row(row: List[str]) -> str:
+        cells = []
+        for index, width in enumerate(widths):
+            cell = row[index] if index < len(row) else ""
+            cell = str(cell)
+            if index < len(widths) - 1:
+                cells.append(cell.ljust(width))
+            else:
+                cells.append(cell)
+
+        return "  ".join(cells).rstrip()
+
+    rule = "  ".join("=" * width for width in widths)
+    output = [rule, render_row([str(header) for header in headers]), rule]
+    output.extend(render_row(row) for row in rows)
+    output.append(rule)
+    return "\n".join(output)
+
+
+def _render_github_table(headers: List[str], rows: List[List[str]]) -> str:
+    widths = _column_widths(headers, rows)
+
+    def render_row(row: List[str]) -> str:
+        cells = []
+        for index, width in enumerate(widths):
+            cell = row[index] if index < len(row) else ""
+            cells.append(str(cell).ljust(width))
+
+        return "| " + " | ".join(cells) + " |"
+
+    rule = "| " + " | ".join("-" * width for width in widths) + " |"
+    output = [render_row([str(header) for header in headers]), rule]
+    output.extend(render_row(row) for row in rows)
+    return "\n".join(output)
+
+
+def tabulate(rows: List[List[Any]], headers: List[str], tablefmt: str = "rst") -> str:
+    """Compatibility wrapper backed by PrettyTable."""
+    if tablefmt not in VALID_OUTPUTS:
+        raise ValueError(f"Invalid tablefmt provided: {tablefmt}")
+
+    table = PrettyTable()
+    table.field_names = [str(header) for header in headers]
+
+    normalized_rows = []
+    for row in rows:
+        normalized_row = [str(cell) for cell in row[: len(table.field_names)]]
+        if len(normalized_row) < len(table.field_names):
+            normalized_row.extend([""] * (len(table.field_names) - len(normalized_row)))
+        table.add_row(normalized_row)
+        normalized_rows.append(normalized_row)
+
+    if tablefmt == "github":
+        return _render_github_table(table.field_names, normalized_rows)
+
+    return _render_rst_table(table.field_names, normalized_rows)
 
 
