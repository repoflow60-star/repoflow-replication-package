+            else:
+                text = data
+        elif isinstance(text, bytes):
+            text = text.decode('utf-8', 'replace')
+
+        self.text = text
+
+    def json(self):
+        if hasattr(self._response, 'json'):
+            return self._response.json()
+        return json.loads(self.text)
