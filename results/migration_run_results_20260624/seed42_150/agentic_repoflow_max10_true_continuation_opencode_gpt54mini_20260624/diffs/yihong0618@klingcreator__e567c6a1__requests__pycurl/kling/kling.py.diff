+            if not header_text or ":" not in header_text:
+                continue
+            name, value = header_text.split(":", 1)
+            headers[name.strip()] = value.strip()
+        return headers
+
+    def _cookie_header(self) -> str:
+        with self._lock:
+            return "; ".join(f"{key}={value}" for key, value in self.cookies.items())
