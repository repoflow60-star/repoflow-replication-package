+from rich.console import Console
+from rich.text import Text
 
 from edgetest.core import TestPackage
 
 VALID_OUTPUTS = ["rst", "github"]
+
+
+def _cell_text(value: Any) -> str:
+    return "" if value is None else str(value)
+
+
+def _column_widths(headers: Sequence[Any], rows: Sequence[Sequence[Any]], tablefmt: str) -> List[int]:
+    widths: List[int] = []
+    for idx, header in enumerate(headers):
+        header_width = len(_cell_text(header))
+        cell_width = max(
+            (len(_cell_text(row[idx])) for row in rows if idx < len(row)),
+            default=0,
+        )
+        if tablefmt == "rst":
+            widths.append(max(cell_width, header_width + 2))
+        else:
+            widths.append(max(cell_width, header_width))
+    for row in rows:
+        for idx in range(len(headers), len(row)):
+            cell_width = len(_cell_text(row[idx]))
+            if idx >= len(widths):
+                widths.append(cell_width)
+            else:
+                widths[idx] = max(widths[idx], cell_width)
+    return widths
+
+
+def _render_row(values: Sequence[Any], widths: Sequence[int], separator: str) -> str:
+    cells = []
+    for idx, width in enumerate(widths):
+        text = _cell_text(values[idx] if idx < len(values) else "")
+        cells.append(text.ljust(width))
+    return separator.join(cells).rstrip()
+
+
+def _render_rst(rows: Sequence[Sequence[Any]], headers: Sequence[Any]) -> str:
+    widths = _column_widths(headers, rows, "rst")
+    separator = "  "
+    rule = separator.join("=" * width for width in widths)
+    lines = [rule, _render_row(headers, widths, separator), rule]
+    lines.extend(_render_row(row, widths, separator) for row in rows)
+    lines.append(rule)
+    return "\n".join(lines)
+
+
+def _render_github(rows: Sequence[Sequence[Any]], headers: Sequence[Any]) -> str:
+    widths = _column_widths(headers, rows, "github")
+    lines = [
+        f"| {_render_row(headers, widths, ' | ')} |",
+        "|" + "|".join("-" * width for width in widths) + "|",
+    ]
+    lines.extend(f"| {_render_row(row, widths, ' | ')} |" for row in rows)
+    return "\n".join(lines)
+
+
+def tabulate(rows: List[List[Any]], headers: List[Any], tablefmt: str = "rst") -> str:
+    rendered = _render_github(rows, headers) if tablefmt == "github" else _render_rst(rows, headers)
+    console = Console(file=StringIO(), width=max((len(line) for line in rendered.splitlines()), default=1))
+    console.print(Text(rendered), end="")
+    return rendered
 
 
