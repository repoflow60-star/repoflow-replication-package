+def _curl_response(
+    url: str,
+    method: str,
+    headers: list[str],
+    body: bytes | None,
+    timeout: int | float,
+) -> Response:
+    response_body = BytesIO()
+    response_headers = BytesIO()
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.ACCEPT_ENCODING, "")
+        curl.setopt(pycurl.NOSIGNAL, 1)
+
+        timeout_ms = int(float(timeout) * 1000)
+        curl.setopt(pycurl.TIMEOUT_MS, timeout_ms)
+        curl.setopt(pycurl.CONNECTTIMEOUT_MS, timeout_ms)
+        curl.setopt(pycurl.WRITEDATA, response_body)
+        curl.setopt(pycurl.HEADERDATA, response_headers)
+        curl.setopt(pycurl.HTTPHEADER, headers)
+
+        if method == "GET":
+            curl.setopt(pycurl.HTTPGET, 1)
+        elif method == "POST":
+            curl.setopt(pycurl.POST, 1)
+        else:
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+        if body is not None and method != "GET":
+            curl.setopt(pycurl.POSTFIELDS, body)
+            curl.setopt(pycurl.POSTFIELDSIZE, len(body))
+
+        try:
+            curl.perform()
+        except pycurl.error as ex:
+            raise UnknownError(str(ex)) from ex
+
+        status_code = int(curl.getinfo(pycurl.RESPONSE_CODE))
+    finally:
+        curl.close()
+
+    parsed_headers: dict[str, str] = {}
+    reason = ""
+    for raw_line in response_headers.getvalue().splitlines():
+        line = raw_line.decode("iso-8859-1")
+        if line.startswith("HTTP/"):
+            parsed_headers = {}
+            parts = line.split(None, 2)
+            if len(parts) >= 3:
+                reason = parts[2].strip()
+            continue
+        if ":" in line:
+            key, value = line.split(":", 1)
+            parsed_headers[key.strip()] = value.strip()
+
+    if not reason:
+        try:
+            reason = HTTPStatus(status_code).phrase
+        except ValueError:
+            reason = ""
+
+    return Response(
+        url=url,
+        status_code=status_code,
+        reason=reason,
+        headers=parsed_headers,
+        body=response_body.getvalue(),
+    )
 
 
