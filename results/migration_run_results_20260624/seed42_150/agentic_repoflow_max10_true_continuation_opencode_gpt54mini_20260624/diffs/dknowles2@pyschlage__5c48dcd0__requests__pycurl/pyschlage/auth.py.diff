+        extra: dict[str, object] | None = None,
+    ) -> None:
+        self.method = method
+        self.url = url
+        self.headers = dict(headers or {})
+        self.body = body if body is not None else data
+        self.data = body if data is None else data
+        self.files = None
+        self.json = None
+        self.params = params
+        self.auth = auth
+        self.cookies = None
+        self.hooks = {}
+        self.extra_kwargs = dict(extra or {})
+        for key, value in self.extra_kwargs.items():
