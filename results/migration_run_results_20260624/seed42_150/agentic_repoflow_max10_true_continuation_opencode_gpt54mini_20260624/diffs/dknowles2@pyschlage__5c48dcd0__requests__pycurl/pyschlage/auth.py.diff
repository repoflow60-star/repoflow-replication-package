+def _request_body_from_kwargs(kwargs: dict, headers: dict[str, str]) -> bytes | None:
+    if "json" in kwargs:
+        body = json_module.dumps(kwargs.pop("json")).encode("utf-8")
+        headers["Content-Type"] = "application/json"
+        return body
+
+    if "data" not in kwargs:
+        return None
+
+    data = kwargs.pop("data")
+    if data is None:
+        return None
+    if isinstance(data, bytes):
+        return data
+    if isinstance(data, str):
+        return data.encode("utf-8")
+
+    try:
+        headers.setdefault("Content-Type", "application/x-www-form-urlencoded")
+        return urlencode(data, doseq=True).encode("utf-8")
+    except (TypeError, ValueError):
+        return str(data).encode("utf-8")
+
+
+def _apply_auth(
+    auth,
+    method: str,
+    url: str,
+    body: bytes | None,
+    headers: dict[str, str],
+    params=None,
+    extra: dict[str, object] | None = None,
+) -> tuple[str, bytes | None, dict[str, str]]:
+    request = Request(
+        method=method,
+        url=url,
+        headers=headers,
+        body=body,
+        params=params,
+        auth=auth,
+        extra=extra,
+    )
+
+    if auth is None:
+        return url, body, dict(request.headers)
+
+    authed_request = auth(request)
+    effective_request = authed_request if authed_request is not None else request
+
+    merged_headers = dict(request.headers)
+    effective_headers = getattr(effective_request, "headers", None)
+    if effective_headers is not None:
+        try:
+            merged_headers.update(dict(effective_headers))
+        except TypeError:
+            pass
+
+    effective_url = getattr(effective_request, "url", url)
+    effective_body = getattr(effective_request, "body", body)
+    if effective_body is None:
+        effective_body = getattr(effective_request, "data", body)
+
+    if isinstance(effective_body, str):
+        effective_body = effective_body.encode("utf-8")
+    elif isinstance(effective_body, bytearray):
+        effective_body = bytes(effective_body)
+    elif not isinstance(effective_body, (bytes, bytearray, type(None))):
+        effective_body = body
+
+    return effective_url, effective_body, merged_headers
+
