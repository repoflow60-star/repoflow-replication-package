--- a/yarg/_curl.py
+++ b/yarg/_curl.py
@@ -0,0 +1,25 @@
+import io
+
+import pycurl
+
+
+def fetch(url):
+    body = io.BytesIO()
+    reason = {'value': ''}
+
+    def capture_header(line):
+        if line.startswith(b'HTTP/'):
+            parts = line.decode('iso-8859-1').strip().split(' ', 2)
+            reason['value'] = parts[2] if len(parts) > 2 else ''
+        return len(line)
+
+    curl = pycurl.Curl()
+    try:
+        curl.setopt(pycurl.URL, url.encode('utf-8'))
+        curl.setopt(pycurl.WRITEDATA, body)
+        curl.setopt(pycurl.HEADERFUNCTION, capture_header)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.perform()
+        return curl.getinfo(pycurl.RESPONSE_CODE), reason['value'], body.getvalue()
+    finally:
+        curl.close()
