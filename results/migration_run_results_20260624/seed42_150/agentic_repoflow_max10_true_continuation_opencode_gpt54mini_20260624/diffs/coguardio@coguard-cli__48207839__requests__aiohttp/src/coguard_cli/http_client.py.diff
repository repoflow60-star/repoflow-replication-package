--- a/src/coguard_cli/http_client.py
+++ b/src/coguard_cli/http_client.py
@@ -0,0 +1,114 @@
+"""
+Small synchronous wrapper around aiohttp for the CLI's HTTP calls.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json as json_module
+from dataclasses import dataclass
+from typing import Any, Dict, Iterable, Optional
+from urllib.parse import urlsplit
+
+import aiohttp
+
+
+def _normalize_url(url: str) -> str:
+    """Ensure aiohttp receives an absolute URL."""
+    parsed = urlsplit(url)
+    if parsed.scheme:
+        return url
+    if url.startswith("//"):
+        return f"https:{url}"
+    return f"https://{url.lstrip('/')}"
+
+
+def _run(coro):
+    return asyncio.run(coro)
+
+
+@dataclass
+class _ResponseAdapter:
+    status_code: int
+    reason: str
+    _body: bytes
+    _headers: Dict[str, str]
+
+    @property
+    def text(self) -> str:
+        charset = None
+        content_type = self._headers.get("content-type", "")
+        if "charset=" in content_type:
+            charset = content_type.split("charset=", 1)[1].split(";", 1)[0].strip()
+        return self._body.decode(charset or "utf-8", errors="replace")
+
+    @property
+    def content(self) -> bytes:
+        return self._body
+
+    def json(self):
+        return json_module.loads(self.text)
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            raise RuntimeError(f"{self.status_code} {self.reason}".strip())
+
+
+class _StreamResponseAdapter(_ResponseAdapter):
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        return False
+
+    def iter_content(self, chunk_size: int = 8192) -> Iterable[bytes]:
+        for index in range(0, len(self._body), chunk_size):
+            yield self._body[index:index + chunk_size]
+
+
+async def _request(
+    method: str,
+    url: str,
+    *,
+    headers: Optional[Dict[str, str]] = None,
+    data: Any = None,
+    json: Any = None,
+    timeout: Optional[int] = None,
+    stream: bool = False,
+):
+    request_timeout = aiohttp.ClientTimeout(total=timeout) if timeout is not None else aiohttp.ClientTimeout()
+    async with aiohttp.ClientSession(timeout=request_timeout) as session:
+        async with session.request(
+            method,
+            _normalize_url(url),
+            headers=headers,
+            data=data,
+            json=json,
+        ) as response:
+            body = await response.read()
+            adapter_cls = _StreamResponseAdapter if stream else _ResponseAdapter
+            return adapter_cls(
+                status_code=response.status,
+                reason=response.reason or "",
+                _body=body,
+                _headers={k.lower(): v for k, v in response.headers.items()},
+            )
+
+
+def get(url: str, headers: Optional[Dict[str, str]] = None, timeout: Optional[int] = None, stream: bool = False):
+    return _run(_request("GET", url, headers=headers, timeout=timeout, stream=stream))
+
+
+def post(
+    url: str,
+    headers: Optional[Dict[str, str]] = None,
+    data: Any = None,
+    json: Any = None,
+    timeout: Optional[int] = None,
+    stream: bool = False,
+):
+    return _run(_request("POST", url, headers=headers, data=data, json=json, timeout=timeout, stream=stream))
+
+
+def put(url: str, headers: Optional[Dict[str, str]] = None, data: Any = None, json: Any = None, timeout: Optional[int] = None):
+    return _run(_request("PUT", url, headers=headers, data=data, json=json, timeout=timeout))
