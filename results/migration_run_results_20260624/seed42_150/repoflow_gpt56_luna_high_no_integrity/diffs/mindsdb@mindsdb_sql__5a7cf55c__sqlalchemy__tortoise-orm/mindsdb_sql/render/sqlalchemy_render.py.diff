+    def _quote(self, value):
+        value = str(value)
+        if value == '*':
+            return value
+        if re.fullmatch(r'[a-zA-Z_][a-zA-Z_0-9]*', value) and value.upper() not in self._reserved:
+            return value
+        if self.dialect.name == 'mysql':
+            return '`{}`'.format(value.replace('`', '``'))
+        if self.dialect.name == 'mssql':
+            return '[{}]'.format(value.replace(']', ']]'))
+        return '"{}"'.format(value.replace('"', '""'))
+
+    def _identifier(self, parts):
+        return '.'.join(
+            '*' if isinstance(part, ast.Star) else self._quote(part)
+            for part in parts
+        )
+
+    def _alias_sql(self, alias):
+        if alias is None:
+            return None
+        if isinstance(alias, str):
+            return self._quote(alias)
+        return self._quote(self.get_alias(alias))
+
+    @staticmethod
+    def _label(expr, alias):
+        if alias is None:
+            return expr
+        return _Expr(expr.sql, kind=expr.kind, alias=alias, precedence=expr.precedence)
+
+    def _target_sql(self, expr):
+        sql = str(expr)
+        if expr.alias is not None:
+            sql += ' AS ' + self._alias_sql(expr.alias)
+        return sql
+
+    def _literal(self, value):
+        if value is None:
+            return 'NULL'
+        if isinstance(value, bool):
+            return 'TRUE' if value else 'FALSE'
+        if isinstance(value, (str, dt.date, dt.datetime, dt.timedelta)):
+            return "'{}'".format(str(value).replace("'", "''"))
+        return str(value)
+
+    @staticmethod
+    def _child_sql(expr, precedence):
+        if expr.precedence < precedence:
+            return '({})'.format(expr)
+        return str(expr)
+
+    def _binary(self, left, op, right, precedence):
+        left_sql = self._child_sql(left, precedence)
+        right_sql = self._child_sql(right, precedence)
+        return _Expr('{} {} {}'.format(left_sql, op, right_sql), precedence=precedence)
 
