+class _PreparedRequest:
+    """Minimal request object for mounted transport adapters."""
+
+    def __init__(self, method, url, headers, body):
+        self.method = method
+        self.url = url
+        self.headers = headers
+        self.body = body
+        self._cookies = {}
+        parsed_url = urlsplit(url)
+        self.path_url = parsed_url.path or "/"
+        if parsed_url.query:
+            self.path_url += "?" + parsed_url.query
+
+
+class _PycurlSession:
+    """Small session abstraction backed by pycurl."""
+
+    def __init__(self):
+        self.headers = {}
+        self._curl = pycurl.Curl()
+        self._mounts = {}
+
+    def mount(self, prefix, adapter):
+        """Register a transport adapter for URLs beginning with prefix."""
+        self._mounts[prefix] = adapter
+
+    def request(self, method, url, params=None, data=None, headers=None):
+        if params:
+            query = urlencode(params, doseq=True)
+            url += "&" if "?" in url else "?"
+            url += query
+
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        adapter = self._adapter_for(url)
+        if adapter is not None:
+            request = _PreparedRequest(method, url, request_headers, data)
+            return adapter.send(request)
+
+        response = io.BytesIO()
+        self._curl.reset()
+        self._curl.setopt(pycurl.URL, url)
+        self._curl.setopt(
+            pycurl.HTTPHEADER,
+            ["{key}: {value}".format(key=key, value=value)
+             for key, value in request_headers.items()],
+        )
+        self._curl.setopt(pycurl.WRITEFUNCTION, response.write)
+        if method == "GET":
+            self._curl.setopt(pycurl.HTTPGET, 1)
+        elif method == "POST":
+            self._curl.setopt(pycurl.POST, 1)
+            self._curl.setopt(pycurl.POSTFIELDS, data)
+        else:
+            self._curl.setopt(pycurl.CUSTOMREQUEST, method)
+        self._curl.perform()
+        return response.getvalue()
+
+    def _adapter_for(self, url):
+        for prefix in sorted(self._mounts, key=len, reverse=True):
+            if url.startswith(prefix):
+                return self._mounts[prefix]
+        return None
+
