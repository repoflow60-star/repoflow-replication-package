+def build_proxy_settings(proxy_url):
+    if '://' not in proxy_url:
+        proxy_url = 'http://' + proxy_url
+
+    proxy_headers = None
+    scheme, authority = proxy_url.split('://', 1)
+    if '@' in authority:
+        credentials, authority = authority.rsplit('@', 1)
+        proxy_headers = urllib3.make_headers(proxy_basic_auth=credentials)
+    return '{}://{}'.format(scheme, authority), proxy_headers
+
+
+def build_url(request):
+    if not request.params:
+        return request.url
+
+    separator = '&' if '?' in request.url else '?'
+    return '{}{}{}'.format(request.url, separator, urlencode(request.params, doseq=True))
 
 
