 import lxml.html as lh
-import requests
+import treq
+from treq.client import HTTPClient
+from twisted.internet import reactor
+from twisted.internet.threads import blockingCallFromThread
+from twisted.web.client import ProxyAgent
 
 from fp.errors import FreeProxyException
+
+
+_reactor_lock = threading.Lock()
+_reactor_started = threading.Event()
+_reactor_thread = None
+
+
+def _run_deferred(operation):
+    global _reactor_thread
+
+    if not reactor.running:
+        with _reactor_lock:
+            if not reactor.running and (_reactor_thread is None or
+                                        not _reactor_thread.is_alive()):
+                _reactor_started.clear()
+                reactor.callWhenRunning(_reactor_started.set)
+                _reactor_thread = threading.Thread(
+                    target=reactor.run,
+                    kwargs={'installSignalHandlers': False},
+                    daemon=True)
+                _reactor_thread.start()
+        _reactor_started.wait()
+    return blockingCallFromThread(reactor, operation)
+
+
+def _request_content(url, proxies=None, timeout=None):
+    def request():
+        kwargs = {}
+        if timeout is not None:
+            kwargs['timeout'] = timeout
+        if proxies:
+            proxy_url = proxies.get('http') or proxies.get('https')
+            client = HTTPClient(ProxyAgent(reactor, proxy_url.encode()))
+            response = client.get(url, **kwargs)
+        else:
+            response = treq.get(url, **kwargs)
+        return response.addCallback(treq.content)
+
+    return _run_deferred(request)
 
 
