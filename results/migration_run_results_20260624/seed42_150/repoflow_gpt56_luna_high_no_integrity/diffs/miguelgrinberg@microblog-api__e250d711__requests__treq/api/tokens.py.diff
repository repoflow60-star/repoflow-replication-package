+
+# Keep the existing patch point while using treq for the HTTP implementation.
+requests = treq
+
+_reactor_started = threading.Event()
+_reactor_start_lock = threading.Lock()
+
+
+def _start_reactor():
+    if _reactor_started.is_set():
+        return
+    with _reactor_start_lock:
+        if not _reactor_started.is_set():
+            reactor_thread = threading.Thread(
+                target=reactor.run, kwargs={'installSignalHandlers': False},
+                daemon=True)
+            reactor_thread.start()
+            _reactor_started.set()
+
+
+def _treq_request(request_function, url, **kwargs):
+    """Run a treq request from this module's synchronous Flask handlers."""
+    _start_reactor()
+    completed = threading.Event()
+    result = {}
+
+    def read_response(http_response):
+        if http_response.code != 200:
+            return http_response.code, None
+        return treq.json_content(http_response).addCallback(
+            lambda content: (http_response.code, content))
+
+    def finish(value):
+        result['value'] = value
+        completed.set()
+        return value
+
+    def fail(failure):
+        result['error'] = failure.value
+        completed.set()
+        return failure
+
+    def make_request():
+        try:
+            response = request_function(url, **kwargs)
+            if isinstance(response, Deferred):
+                response.addCallback(read_response).addCallbacks(finish, fail)
+            elif response.status_code != 200:
+                finish((response.status_code, None))
+            else:
+                finish((response.status_code, response.json()))
+        except Exception as error:  # pragma: no cover - network failures
+            result['error'] = error
+            completed.set()
+
+    reactor.callFromThread(make_request)
+    completed.wait()
+    if 'error' in result:
+        raise result['error']
+    return result['value']
 
 
