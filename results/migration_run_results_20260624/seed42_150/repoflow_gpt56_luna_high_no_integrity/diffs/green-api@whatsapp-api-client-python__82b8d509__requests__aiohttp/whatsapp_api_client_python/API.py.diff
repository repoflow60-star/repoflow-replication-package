+class Session:
+    """Synchronous facade over an aiohttp client session."""
+
+    def __init__(self):
+        self._loop = asyncio.new_event_loop()
+        self._client = self._loop.run_until_complete(
+            self._create_client()
+        )
+        self.headers = self._client.headers
+        self._retry_total = 0
+        self._retry_backoff_factor = 0.0
+        self._retry_statuses = set()
+
+    async def _create_client(self) -> aiohttp.ClientSession:
+        return aiohttp.ClientSession(headers={"Connection": "close"})
+
+    def configure_retries(
+            self,
+            total: int,
+            backoff_factor: float,
+            status_forcelist: set
+    ) -> None:
+        self._retry_total = total
+        self._retry_backoff_factor = backoff_factor
+        self._retry_statuses = status_forcelist
+
+    def request(self, method: str, url: str, **arguments: Any) -> _AioHttpResponse:
+        return self._loop.run_until_complete(
+            self._request(method, url, arguments)
+        )
+
+    async def _request(
+            self, method: str, url: str, arguments: dict
+    ) -> _AioHttpResponse:
+        files = arguments.get("files")
+
+        for retry_number in range(self._retry_total + 1):
+            request_arguments = dict(arguments)
+            if files is not None:
+                payload = request_arguments.pop("data", None)
+                request_arguments["data"] = self._create_form(payload, files)
+
+            try:
+                async with self._client.request(
+                        method, url, **request_arguments
+                ) as response:
+                    response_text = await response.text()
+                    status_code = response.status
+            except (aiohttp.ClientError, asyncio.TimeoutError, OSError):
+                if retry_number >= self._retry_total:
+                    raise
+            else:
+                if (
+                        status_code not in self._retry_statuses
+                        or retry_number >= self._retry_total
+                ):
+                    return _AioHttpResponse(status_code, response_text)
+
+            delay = 0
+            if retry_number:
+                delay = self._retry_backoff_factor * 2 ** retry_number
+            await asyncio.sleep(delay)
+
+        raise RuntimeError("Request retry loop exited unexpectedly")
+
+    @staticmethod
+    def _create_form(payload: Optional[dict], files: dict) -> aiohttp.FormData:
+        form = aiohttp.FormData()
+
+        for name, value in (payload or {}).items():
+            form.add_field(name, str(value))
+
+        for name, file_data in files.items():
+            file_name, file_object, content_type = file_data
+            form.add_field(
+                name,
+                file_object,
+                filename=file_name,
+                content_type=content_type
+            )
+
+        return form
+
+    def close(self) -> None:
+        if not self._client.closed:
+            self._loop.run_until_complete(self._client.close())
+        if not self._loop.is_closed():
+            self._loop.close()
+
+    def __del__(self):
+        try:
+            self.close()
+        except Exception:
+            pass
 
 
