 from ash_model.measures import *
 
 
+class _PlotlyDisplay:
+    """Keep the old wildcard-import cleanup call harmless for Plotly figures."""
+
+    @staticmethod
+    def close(*args, **kwargs):
+        return None
+
+
+# ``plt`` was previously leaked by this module's wildcard imports. Plotly
+# figures do not need an equivalent close operation, but retaining the name
+# avoids breaking callers that only use it for cleanup.
+plt = _PlotlyDisplay()
+
+
+def _trace_kwargs(kwargs: dict, style: str) -> dict:
+    """Translate common plotting options into Plotly trace options."""
+    trace_kwargs = {k: v for k, v in kwargs.items() if k != "ax"}
+
+    if "alpha" in trace_kwargs:
+        trace_kwargs["opacity"] = trace_kwargs.pop("alpha")
+    if "color" in trace_kwargs:
+        color = trace_kwargs.pop("color")
+        existing_style = trace_kwargs.get(style, {})
+        style_kwargs = dict(existing_style) if isinstance(existing_style, dict) else {}
+        style_kwargs.setdefault("color", color)
+        trace_kwargs[style] = style_kwargs
+    if "label" in trace_kwargs:
+        trace_kwargs.setdefault("name", trace_kwargs.pop("label"))
+    if "linewidth" in trace_kwargs:
+        existing_line = trace_kwargs.get("line", {})
+        line_kwargs = dict(existing_line) if isinstance(existing_line, dict) else {}
+        line_kwargs.setdefault("width", trace_kwargs.pop("linewidth"))
+        trace_kwargs["line"] = line_kwargs
+    if "markersize" in trace_kwargs:
+        existing_marker = trace_kwargs.get("marker", {})
+        marker_kwargs = (
+            dict(existing_marker) if isinstance(existing_marker, dict) else {}
+        )
+        marker_kwargs.setdefault("size", trace_kwargs.pop("markersize"))
+        trace_kwargs["marker"] = marker_kwargs
+    if isinstance(trace_kwargs.get("marker"), str):
+        marker_symbols = {
+            ".": "circle",
+            "o": "circle",
+            "^": "triangle-up",
+            "s": "square",
+        }
+        marker = trace_kwargs["marker"]
+        trace_kwargs["marker"] = {"symbol": marker_symbols.get(marker, marker)}
+
+    return trace_kwargs
+
+
