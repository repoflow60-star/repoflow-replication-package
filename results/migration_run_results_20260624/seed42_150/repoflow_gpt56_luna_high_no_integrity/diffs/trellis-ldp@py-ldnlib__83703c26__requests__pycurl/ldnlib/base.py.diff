+        text = line.strip('\r\n')
+        if text.startswith('HTTP/'):
+            response_headers.clear()
+            response_started = True
+            body.seek(0)
+            body.truncate(0)
+        elif response_started and ':' in text:
+            name, value = text.split(':', 1)
+            name = name.lower()
+            value = value.strip()
+            if name in response_headers:
+                response_headers[name] = '{}, {}'.format(
+                    response_headers[name], value)
+            else:
+                response_headers[name] = value
+
+    curl = pycurl.Curl()
