+class _Request:
+    """Request metadata exposed by the response compatibility layer."""
+
+    def __init__(self, method, url):
+        self.method = method
+        self.url = url
+
+
+class Response:
+    """Response facade backed by an urllib3 HTTP response."""
+
+    def __init__(self, response, method, url, elapsed):
+        self._response = response
+        self.status_code = response.status
+        self.ok = self.status_code < 400
+        self.headers = response.headers
+        self.url = url
+        self.request = _Request(method, url)
+        self.elapsed = elapsed
+
+    @property
+    def content(self):
+        return self._response.data
+
+    @property
+    def text(self):
+        return self.content.decode('utf-8', errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+    def close(self):
+        self._response.close()
+
+
+class _HTTPSession:
+    """Small session interface implemented with urllib3's connection pool."""
+
+    def __init__(self):
+        self.headers = HTTPHeaderDict()
+        self._pool = urllib3.PoolManager()
+
+    def request(self, method, url, **kwargs):
+        headers = kwargs.get('headers')
+        params = kwargs.get('params')
+        body = kwargs.get('data')
+        if 'json' in kwargs and kwargs['json'] is not None:
+            body = json.dumps(kwargs['json']).encode('utf-8')
+        elif isinstance(body, (dict, list, tuple)):
+            body = urlencode(body, doseq=True).encode('utf-8')
+        if params:
+            query = urlencode(params, doseq=True)
+            separator = '&' if '?' in url else '?'
+            url = url + separator + query
+
+        started = time.monotonic()
+        response = self._pool.request(
+            method,
+            url,
+            body=body,
+            headers=headers,
+            preload_content=not kwargs.get('stream', False),
+            redirect=kwargs.get('allow_redirects', True),
+            retries=False,
+            timeout=kwargs.get('timeout'),
+        )
+        elapsed = timedelta(seconds=time.monotonic() - started)
+        return Response(response, method, url, elapsed)
+
+    def get(self, url, **kwargs):
+        kwargs.setdefault('allow_redirects', True)
+        return self.request('GET', url, **kwargs)
+
+    def post(self, url, data=None, json=None, **kwargs):
+        kwargs['data'] = data
+        if json is not None:
+            kwargs['json'] = json
+        return self.request('POST', url, **kwargs)
+
+    def put(self, url, data=None, json=None, **kwargs):
+        kwargs['data'] = data
+        if json is not None:
+            kwargs['json'] = json
+        return self.request('PUT', url, **kwargs)
+
+    def delete(self, url, **kwargs):
+        return self.request('DELETE', url, **kwargs)
+
+    def close(self):
+        self._pool.clear()
+
+
+Session = _HTTPSession
 
