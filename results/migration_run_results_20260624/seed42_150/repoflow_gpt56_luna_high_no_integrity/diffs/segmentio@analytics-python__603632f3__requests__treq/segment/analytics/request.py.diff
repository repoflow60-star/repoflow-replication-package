+
+def _ensure_reactor():
+    global _reactor_thread
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if reactor.running:
+            return
+        if _reactor_thread is None:
+            _reactor_thread = Thread(
+                target=_run_reactor,
+                daemon=True,
+            )
+            _reactor_thread.start()
+    _reactor_ready.wait()
+
+
+def _post(url, data=None, headers=None, timeout=None):
+    """Make a treq request while retaining this module's blocking API."""
+    _ensure_reactor()
+    if (_reactor_thread is not None and current_thread() is _reactor_thread) or \
+            isInIOThread():
+        raise RuntimeError('synchronous requests cannot run on the reactor thread')
+
+    completed = Event()
+    result = []
+
+    def finish(success, value):
+        result.append((success, value))
+        completed.set()
+
+    def failed(failure):
+        finish(False, failure)
+        return None
+
+    def read_response(response):
+        try:
+            body = treq.content(response)
+            body.addCallbacks(
+                lambda content: finish(True, (response, content)),
+                failed,
+            )
+        except Exception as error:
+            finish(False, error)
+        return response
+
+    def start_request():
+        try:
+            request = treq.post(
+                url,
+                data=data,
+                headers=headers,
+                timeout=timeout,
+            )
+            request.addCallbacks(read_response, failed)
+        except Exception as error:
+            finish(False, error)
+
+    reactor.callFromThread(start_request)
+    completed.wait()
+    success, value = result[0]
+    if not success:
+        if hasattr(value, 'raiseException'):
+            value.raiseException()
+        raise value
+
+    response, content = value
+    return _TreqResponse(response, content)
