+        return self.content.decode('utf-8', errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if not self.ok:
+            raise ClientError(
+                message={
+                    'status_code': self.status_code,
+                    'url': self.url,
+                    'message': self.reason or 'HTTP error',
+                    'raw': self.content,
+                },
+            )
+
+
+class _CurlSession:
+    def __init__(self):
+        self.headers = {}
+
+    def _request(self, method, url, params=None, headers=None, body=None):
+        if params:
+            query_items = [
+                (key, value)
+                for key, value in params.items()
+                if value is not None
+            ]
+            query = urlencode(query_items, doseq=True)
+            if query:
+                url = f'{url}&{query}' if '?' in url else f'{url}?{query}'
+
+        response_buffer = BytesIO()
+        header_buffer = BytesIO()
+        curl = pycurl.Curl()
+        curl.setopt(pycurl.URL, url)
+        curl.setopt(pycurl.FOLLOWLOCATION, 1)
+        curl.setopt(pycurl.WRITEFUNCTION, response_buffer.write)
+        curl.setopt(pycurl.HEADERFUNCTION, header_buffer.write)
+
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+        curl.setopt(
+            pycurl.HTTPHEADER,
+            [f'{key}: {value}' for key, value in request_headers.items()],
+        )
+
+        if method == 'GET':
+            curl.setopt(pycurl.HTTPGET, 1)
+        elif method == 'POST':
+            curl.setopt(pycurl.POST, 1)
+            if body is not None:
+                curl.setopt(
+                    pycurl.POSTFIELDS,
+                    body.encode('utf-8') if isinstance(body, str) else body,
+                )
+        else:
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            if body is not None:
+                curl.setopt(
+                    pycurl.POSTFIELDS,
+                    body.encode('utf-8') if isinstance(body, str) else body,
+                )
+
+        try:
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            effective_url = curl.getinfo(pycurl.EFFECTIVE_URL) or url
+        finally:
+            curl.close()
+
+        response_headers = {}
+        for line in header_buffer.getvalue().splitlines():
+            if line.startswith((b'HTTP/', b'ICY ')):
+                response_headers = {}
+                continue
+            key, separator, value = line.partition(b':')
+            if separator:
+                response_headers[key.decode('latin1').lower()] = value.decode(
+                    'latin1'
+                ).strip()
+
+        return _CurlResponse(
+            content=response_buffer.getvalue(),
+            headers=response_headers,
+            status_code=status_code,
+            url=effective_url,
+        )
+
+    def get(self, url, params=None):
