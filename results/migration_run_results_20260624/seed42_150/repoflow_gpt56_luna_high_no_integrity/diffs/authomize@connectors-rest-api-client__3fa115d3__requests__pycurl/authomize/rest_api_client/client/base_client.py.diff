+class _CurlResponse:
+    def __init__(self, content, headers, status_code, url):
+        self.content = content
+        self.headers = headers
+        self.status_code = status_code
+        self.url = url
+        self.reason = ''
+
+    @property
+    def ok(self):
+        return self.status_code < 400
+
+    @property
