+def _read_env_value(
+    env_file_path: Optional[str], name: Optional[str], default: Optional[Any]
+) -> Union[Any, str]:
+    """Read one value from a dotenv file without changing the process environment."""
+
+    if env_file_path is None or name is None:
+        return default
+
+    original_environment = os.environ.copy()
+    try:
+        os.environ.pop(name, None)
+        Env().read_env(path=env_file_path, override=False)
+        return os.environ.get(name, default)
+    finally:
+        for key in tuple(os.environ):
+            if key not in original_environment:
+                del os.environ[key]
+        os.environ.update(original_environment)
+
+
+def _update_env_file(
+    env_file_path: Optional[str], name: Optional[str], value: Optional[str] = None
+) -> None:
+    """Set or remove one dotenv entry while retaining unrelated file content."""
+
+    if env_file_path is None or name is None:
+        return
+
+    try:
+        with open(env_file_path, "r", encoding="utf-8") as env_file:
+            lines = env_file.readlines()
+    except FileNotFoundError:
+        if value is None:
+            return
+        return
+
+    entry_pattern = re.compile(rf"^\s*(?:export\s+)?{re.escape(name)}\s*=")
+
+    if value is None:
+        lines = [line for line in lines if not entry_pattern.match(line)]
+    else:
+        escaped_value = value.replace("'", "\\'")
+        replacement = f"{name}='{escaped_value}'\n"
+        replaced = False
+        updated_lines = []
+        for line in lines:
+            if not replaced and entry_pattern.match(line):
+                updated_lines.append(replacement)
+                replaced = True
+            else:
+                updated_lines.append(line)
+
+        if not replaced:
+            if updated_lines and not updated_lines[-1].endswith("\n"):
+                updated_lines[-1] += "\n"
+            updated_lines.append(replacement)
+        lines = updated_lines
+
+    with open(env_file_path, "w", encoding="utf-8") as env_file:
+        env_file.writelines(lines)
 
 
