--- a/src/coguard_cli/http_client.py
+++ b/src/coguard_cli/http_client.py
@@ -0,0 +1,52 @@
+"""Synchronous HTTP access backed by aiohttp."""
+
+import asyncio
+from concurrent.futures import ThreadPoolExecutor
+from typing import Any, Dict, Optional, Tuple
+
+import aiohttp
+
+
+async def _request_async(
+        method: str,
+        url: str,
+        headers: Optional[Dict[str, str]] = None,
+        data: Any = None,
+        json_data: Any = None,
+        timeout: Optional[float] = None
+) -> Tuple[int, Optional[str], str, bytes]:
+    request_kwargs = {
+        "headers": headers,
+        "timeout": timeout,
+    }
+    if data is not None:
+        request_kwargs["data"] = data
+    if json_data is not None:
+        request_kwargs["json"] = json_data
+
+    async with aiohttp.ClientSession() as session:
+        async with session.request(method, url, **request_kwargs) as response:
+            content = await response.read()
+            text = content.decode(response.charset or "utf-8", errors="replace")
+            return response.status, response.reason, text, content
+
+
+def request(
+        method: str,
+        url: str,
+        headers: Optional[Dict[str, str]] = None,
+        data: Any = None,
+        json_data: Any = None,
+        timeout: Optional[float] = None
+) -> Tuple[int, Optional[str], str, bytes]:
+    """Make an aiohttp request while retaining the package's sync API."""
+    coroutine = _request_async(method, url, headers, data, json_data, timeout)
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(coroutine)
+
+    # Synchronous callers can also be invoked from code that already owns a
+    # running event loop; run the blocking request on a separate event loop.
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        return executor.submit(asyncio.run, coroutine).result()
