+_reactor_lock = Lock()
+_reactor_started = False
+
+
+class _RequestFailure(Exception):
+    pass
+
+
+def _run_in_reactor(operation):
+    global _reactor_started
+
+    with _reactor_lock:
+        if not reactor.running and not _reactor_started:
+            ready = Event()
+
+            def run_reactor():
+                reactor.callWhenRunning(ready.set)
+                reactor.run(installSignalHandlers=False)
+
+            Thread(target=run_reactor, daemon=True).start()
+            _reactor_started = True
+            ready.wait()
+
+    completed = Event()
+    result = []
+
+    def finish(success, value):
+        result.append((success, value))
+        completed.set()
+
+    def start_operation():
+        try:
+            operation().addCallbacks(
+                lambda value: finish(True, value),
+                lambda failure: finish(False, failure.value),
+            )
+        except BaseException as exception:
+            finish(False, exception)
+
+    reactor.callFromThread(start_operation)
+    completed.wait()
+
+    success, value = result[0]
+    if not success:
+        raise value
+    return value
 
 
