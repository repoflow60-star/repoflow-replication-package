+class _HttpxSession(httpx.Client):
+    """Keep the session attributes exposed by the requests-based client."""
+
+    def __init__(self, auth=None, headers=None):
+        self._compat_auth = auth
+        super(_HttpxSession, self).__init__(auth=auth, headers=headers, follow_redirects=True)
+        self._compat_headers = dict(headers or {})
+
+    @property
+    def auth(self):
+        return self._compat_auth
+
+    @auth.setter
+    def auth(self, value):
+        self._compat_auth = value
+        self._auth = self._build_auth(value)
+
+    @property
+    def headers(self):
+        return self._compat_headers
+
+    @headers.setter
+    def headers(self, value):
+        self._compat_headers = dict(value)
+        self._headers = httpx.Headers(self._compat_headers)
+
+    def request(self, method, url, **kwargs):
+        headers = dict(self._compat_headers)
+        headers.update(kwargs.pop('headers', None) or {})
+        return super(_HttpxSession, self).request(method, url, headers=headers, **kwargs)
 
 
