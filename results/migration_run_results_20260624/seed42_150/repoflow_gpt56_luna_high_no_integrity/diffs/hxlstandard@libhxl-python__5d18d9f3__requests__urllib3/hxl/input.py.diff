+def _http_manager(verify_ssl=True, proxy_url=None):
+    """Create an urllib3 manager with normal redirect behavior."""
+    # urllib3 treats redirects as retries. Keep connection and response retries
+    # disabled while retaining a bounded redirect limit.
+    retries = urllib3.util.Retry(
+        total=None,
+        connect=0,
+        read=0,
+        status=0,
+        other=0,
+        redirect=30,
+        raise_on_redirect=True,
+    )
+    manager_args = {
+        'cert_reqs': 'CERT_REQUIRED' if verify_ssl else 'CERT_NONE',
+        'retries': retries,
+    }
+    if proxy_url:
+        return urllib3.ProxyManager(proxy_url, **manager_args)
+    return urllib3.PoolManager(**manager_args)
+
+
+def _http_proxy(url):
+    """Return the environment proxy for a URL, if one should be used."""
+    parsed_url = urllib.parse.urlparse(url)
+    if parsed_url.hostname and urllib.request.proxy_bypass(parsed_url.hostname):
+        return None
+    proxies = urllib.request.getproxies()
+    return proxies.get(parsed_url.scheme) or proxies.get('all')
+
+
+def _http_request(method, url, verify_ssl=True, **kwargs):
+    """Make an HTTP request through urllib3 with compatible options."""
+    try:
+        return _http_manager(verify_ssl, _http_proxy(url)).request(method, url, **kwargs)
+    except urllib3.exceptions.HTTPError as e:
+        raise IOError(str(e))
+
+
+def _raise_for_status(response):
+    """Raise an IOError for an unsuccessful HTTP response."""
+    if response.status >= 400:
+        raise IOError('HTTP Error {}'.format(response.status))
+
+
+def _response_json(response):
+    return json.loads(response.data)
 
