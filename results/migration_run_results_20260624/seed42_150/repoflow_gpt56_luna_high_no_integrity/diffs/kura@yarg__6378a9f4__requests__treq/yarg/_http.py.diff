--- a/yarg/_http.py
+++ b/yarg/_http.py
@@ -0,0 +1,41 @@
+import threading
+
+from twisted.internet import defer
+from twisted.internet import reactor
+from twisted.internet import threads
+
+
+_reactor_lock = threading.Lock()
+_reactor_ready = threading.Event()
+_reactor_thread = None
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _reactor_thread
+
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if not reactor.running and _reactor_thread is None:
+            _reactor_thread = threading.Thread(target=_run_reactor)
+            _reactor_thread.daemon = True
+            _reactor_thread.start()
+    _reactor_ready.wait()
+
+
+@defer.inlineCallbacks
+def _request(method, content, url):
+    response = yield defer.maybeDeferred(method, url)
+    body = yield defer.maybeDeferred(content, response)
+    defer.returnValue((response, body))
+
+
+def request(method, content, url):
+    _ensure_reactor()
+    return threads.blockingCallFromThread(
+        reactor, _request, method, content, url)
