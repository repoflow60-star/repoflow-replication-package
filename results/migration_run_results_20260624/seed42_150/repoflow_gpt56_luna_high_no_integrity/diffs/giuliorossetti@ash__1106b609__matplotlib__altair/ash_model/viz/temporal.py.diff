+
+def _mark_options(kwargs: dict, default_opacity: float = None) -> dict:
+    options = {}
+    for name in ("color", "size", "shape", "filled", "strokeWidth", "strokeDash"):
+        if name in kwargs:
+            options[name] = kwargs[name]
+    if "opacity" in kwargs:
+        options["opacity"] = kwargs["opacity"]
+    elif "alpha" in kwargs:
+        options["opacity"] = kwargs["alpha"]
+    elif default_opacity is not None:
+        options["opacity"] = default_opacity
+    return options
+
+
+def _add_to_chart(chart: object, kwargs: dict) -> object:
+    base = kwargs.get("ax")
+    if base is not None and hasattr(base, "to_dict") and hasattr(base, "__add__"):
+        return base + chart
+    return chart
 
 
