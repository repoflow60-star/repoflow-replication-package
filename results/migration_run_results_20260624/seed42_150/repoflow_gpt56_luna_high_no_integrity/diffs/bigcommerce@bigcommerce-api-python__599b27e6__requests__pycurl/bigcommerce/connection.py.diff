+class _PycurlSession(object):
+    """Provide session state while using pycurl for the actual HTTP call."""
+
+    def __init__(self):
+        self.auth = None
+        self.headers = {}
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        body = BytesIO()
+        response_headers = BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.CUSTOMREQUEST, method)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.WRITEFUNCTION, body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, response_headers.write)
+            if timeout is not None:
+                curl.setopt(pycurl.TIMEOUT, int(timeout))
+
+            curl_headers = ["%s: %s" % (name, value) for name, value in request_headers.items()]
+            if curl_headers:
+                curl.setopt(pycurl.HTTPHEADER, curl_headers)
+
+            content_encoding = request_headers.get('Accept-Encoding')
+            if content_encoding:
+                curl.setopt(pycurl.ACCEPT_ENCODING, content_encoding)
+
+            if self.auth:
+                username, password = self.auth
+                curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+                curl.setopt(pycurl.USERPWD, "%s:%s" % (username, password))
+
+            if data is not None:
+                if isinstance(data, dict):
+                    data = urlencode(data, doseq=True)
+                if isinstance(data, str):
+                    data = data.encode('utf-8')
+                curl.setopt(pycurl.POSTFIELDS, data)
+
+            curl.perform()
+            status_code = int(curl.getinfo(pycurl.RESPONSE_CODE))
+        finally:
+            curl.close()
+
+        parsed_headers = {}
+        reason = ''
+        for line in response_headers.getvalue().splitlines():
+            if line.startswith(b'HTTP/'):
+                parsed_headers = {}
+                parts = line.decode('iso-8859-1').split(' ', 2)
+                reason = parts[2] if len(parts) == 3 else ''
+                continue
+            if b':' in line:
+                name, value = line.split(b':', 1)
+                parsed_headers[name.decode('iso-8859-1')] = value.lstrip().decode('iso-8859-1')
+
+        return _CurlResult(status_code, reason, parsed_headers, body.getvalue())
 
 
