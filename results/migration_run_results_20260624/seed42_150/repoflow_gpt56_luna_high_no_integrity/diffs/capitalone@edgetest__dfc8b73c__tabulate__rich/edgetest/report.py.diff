 from edgetest.core import TestPackage
 
 VALID_OUTPUTS = ["rst", "github"]
+
+
+def _render_table(rows: List[List[Any]], headers: List[str], tablefmt: str) -> str:
+    """Render a report with Rich while retaining the legacy table formats."""
+    table = Table(
+        *headers,
+        box=box.MARKDOWN if tablefmt == "github" else None,
+        pad_edge=False,
+        padding=(0, 1),
+    )
+    for row in rows:
+        table.add_row(*(str(value) for value in row))
+
+    output = StringIO()
+    console = Console(
+        file=output,
+        force_terminal=False,
+        color_system=None,
+        width=4096,
+    )
+    console.print(table)
+
+    widths = [
+        max(
+            console.measure(str(header)).maximum,
+            *(console.measure(str(row[index])).maximum for row in rows),
+        )
+        + 2
+        for index, header in enumerate(headers)
+    ]
+    values = [headers, *rows]
+
+    if tablefmt == "rst":
+        separator = "  ".join("=" * width for width in widths)
+        content = [
+            "  ".join(str(value).ljust(width) for value, width in zip(row, widths)).rstrip()
+            for row in values
+        ]
+        return "\n".join([separator, *content, separator])
+
+    separator = "|" + "|".join("-" * width for width in widths) + "|"
+    lines = [
+        "| " + " | ".join(str(value).ljust(width - 2) for value, width in zip(row, widths)) + " |"
+        for row in values
+    ]
+    return "\n".join([lines[0], separator, *lines[1:]])
 
 
