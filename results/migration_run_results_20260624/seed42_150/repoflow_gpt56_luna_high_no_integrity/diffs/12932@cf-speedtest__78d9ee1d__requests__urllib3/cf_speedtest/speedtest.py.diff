+class _Urllib3Client:
+    def __init__(self):
+        self._manager = None
+        self._manager_settings = None
+
+    def _get_manager(self, verify, proxies):
+        proxy_url = None
+        if proxies:
+            proxy_url = proxies.get('https') or proxies.get('http')
+        settings = (verify, proxy_url)
+        if settings == self._manager_settings:
+            return self._manager
+
+        cert_reqs = ssl.CERT_REQUIRED if verify else ssl.CERT_NONE
+        if proxy_url and proxy_url.startswith('socks'):
+            from urllib3.contrib.socks import SOCKSProxyManager
+
+            manager = SOCKSProxyManager(
+                proxy_url, cert_reqs=cert_reqs, retries=False,
+            )
+        elif proxy_url:
+            manager = urllib3.ProxyManager(
+                proxy_url, cert_reqs=cert_reqs, retries=False,
+            )
+        else:
+            manager = urllib3.PoolManager(
+                cert_reqs=cert_reqs, retries=False,
+            )
+
+        if self._manager is not None:
+            self._manager.clear()
+        self._manager = manager
+        self._manager_settings = settings
+        return manager
+
+    def _request(self, method, url, **kwargs):
+        verify = kwargs.pop('verify', True)
+        proxies = kwargs.pop('proxies', None)
+        body = kwargs.pop('data', None)
+        if body is not None:
+            kwargs['body'] = body
+        return self._get_manager(verify, proxies).request(method, url, **kwargs)
+
+    def get(self, url, **kwargs):
+        return self._request('GET', url, **kwargs)
+
+    def post(self, url, **kwargs):
+        return self._request('POST', url, **kwargs)
+
+
+REQ_SESSION = _Urllib3Client()
 
