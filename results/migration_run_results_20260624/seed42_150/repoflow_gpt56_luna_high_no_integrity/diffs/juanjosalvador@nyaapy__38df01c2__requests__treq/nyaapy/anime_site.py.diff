-import requests
+from threading import Event, Lock, Thread
+
+import treq
+from twisted.internet import reactor
+from twisted.internet.threads import blockingCallFromThread
+
 from nyaapy import torrent
 from nyaapy.parser import parse_nyaa, parse_single, parse_nyaa_rss
+
+
+_reactor_ready = Event()
+_reactor_lock = Lock()
+
+
+def _run_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _wait_for(deferred):
+    if not reactor.running:
+        with _reactor_lock:
+            if not reactor.running and not _reactor_ready.is_set():
+                Thread(target=_run_reactor, daemon=True).start()
+        _reactor_ready.wait()
+
+    return blockingCallFromThread(reactor, lambda: deferred)
+
+
+def _request_body(url: str, text: bool = False):
+    def read_body(response):
+        if response.code >= 400:
+            raise RuntimeError(f"HTTP request failed with status {response.code}")
+        return response.text() if text else response.content()
+
+    return _wait_for(treq.get(url).addCallback(read_body))
 
 
