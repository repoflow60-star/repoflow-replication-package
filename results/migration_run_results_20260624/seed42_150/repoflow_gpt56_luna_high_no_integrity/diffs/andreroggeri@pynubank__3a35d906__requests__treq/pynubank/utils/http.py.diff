+    treq_headers = Headers({
+        name.encode('ascii'): [value.encode('utf-8')]
+        for name, value in headers.items()
+    })
+    agent = Agent(
+        reactor,
+        contextFactory=_CertificateContextFactory(cert_data, cert_password),
+    ) if cert_data else Agent(reactor)
+    producer = FileBodyProducer(BytesIO(body)) if body is not None else None
+
+    response = yield agent.request(
+        method,
+        url.encode('utf-8'),
+        headers=treq_headers,
+        bodyProducer=producer,
+    )
+    content = yield treq.content(response)
+    return _TreqResponse(response, url, content)
+
+
+def _request(
+    method: bytes,
+    url: str,
+    headers: dict,
+    body: bytes = None,
+    cert_data: bytes = None,
+    cert_password: str = '',
+):
+    _ensure_reactor()
+    return blockingCallFromThread(
+        reactor,
+        _perform_request,
+        method,
+        url,
+        headers,
+        body,
+        cert_data,
+        cert_password,
+    )
+
+
+def get(url: str, headers=None, pkcs12_data=None, pkcs12_password='', **kwargs):
+    return _request(
+        b'GET',
+        url,
+        headers or {},
+        cert_data=pkcs12_data,
+        cert_password=pkcs12_password,
+    )
+
+
+def post(url: str, json=None, headers=None, pkcs12_data=None, pkcs12_password='', **kwargs):
