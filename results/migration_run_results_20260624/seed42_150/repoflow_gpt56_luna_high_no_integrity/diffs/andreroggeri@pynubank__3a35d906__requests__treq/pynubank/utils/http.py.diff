+class _HeaderMap(dict):
+    def get(self, name, default=None):
+        return super().get(name.lower(), default)
+
+
+class _TreqResponse:
+    def __init__(self, response, url: str, content: bytes):
+        self.status_code = response.code
+        self.url = url
+        self.headers = _HeaderMap()
+        for name, values in response.headers.getAllRawHeaders():
+            if isinstance(name, bytes):
+                name = name.decode('latin1')
+            value = values[0]
+            if isinstance(value, bytes):
+                value = value.decode('latin1')
+            self.headers[name.lower()] = value
+        self._content = content
+
+    def json(self):
+        return json_module.loads(self._content.decode('utf-8'))
+
+
+class _CertificateContextFactory:
+    def __init__(self, cert_data: bytes, password=''):
+        password_bytes = password.encode() if isinstance(password, str) else password
+        try:
+            private_key, certificate, _ = pkcs12.load_key_and_certificates(cert_data, password_bytes)
+        except ValueError:
+            if password_bytes not in (None, b''):
+                raise
+            private_key, certificate, _ = pkcs12.load_key_and_certificates(cert_data, None)
+
+        if private_key is None or certificate is None:
+            raise ValueError('The PKCS#12 data does not contain a certificate and private key')
+
+        self._options = CertificateOptions(
+            privateKey=private_key.private_bytes(
+                serialization.Encoding.PEM,
+                serialization.PrivateFormat.TraditionalOpenSSL,
+                serialization.NoEncryption(),
+            ),
+            certificate=certificate.public_bytes(serialization.Encoding.PEM),
+            trustRoot=platformTrust(),
+        )
+
+    def getContext(self, hostname, port):
+        return self._options.getContext()
+
+
+def _start_reactor():
+    reactor.callWhenRunning(_reactor_ready.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor():
+    global _reactor_thread
+
+    with _reactor_lock:
+        if _reactor_thread is None:
+            _reactor_thread = threading.Thread(target=_start_reactor, daemon=True)
+            _reactor_thread.start()
+
+    if not _reactor_ready.wait(timeout=10):
+        raise RuntimeError('Unable to start the treq reactor')
+
