 from . import connection, exceptions, helper
 
 _LOGGING = logging.getLogger(__name__)
+_REACTOR_LOCK = threading.Lock()
+_REACTOR_READY = threading.Event()
+_REACTOR_THREAD: Optional[threading.Thread] = None
+_AGENT: Optional[Agent] = None
+
+
+class _TreqRequestError(Exception):
+    pass
+
+
+class _UnverifiedClientContextFactory(ssl.ClientContextFactory):
+    def getContext(self) -> Any:
+        context = super().getContext()
+        context.set_verify(ssl.VERIFY_NONE, lambda *_args: True)
+        return context
+
+
+def _run_reactor() -> None:
+    reactor.callWhenRunning(_REACTOR_READY.set)
+    reactor.run(installSignalHandlers=False)
+
+
+def _ensure_reactor() -> None:
+    global _REACTOR_THREAD
+
+    if reactor.running:
+        return
+
+    with _REACTOR_LOCK:
+        if not reactor.running and _REACTOR_THREAD is None:
+            _REACTOR_THREAD = threading.Thread(
+                target=_run_reactor,
+                name="samsungtvws-treq-reactor",
+                daemon=True,
+            )
+            _REACTOR_THREAD.start()
+
+    _REACTOR_READY.wait()
+
+
+def _get_agent() -> Agent:
+    global _AGENT
+
+    if _AGENT is None:
+        _AGENT = Agent(reactor, contextFactory=_UnverifiedClientContextFactory())
+    return _AGENT
+
+
+def _treq_request(url: str, method: str, timeout: Optional[float]) -> str:
+    _ensure_reactor()
+    result: "Queue[Any]" = Queue(maxsize=1)
+
+    def request() -> None:
+        try:
+            deferred = treq.request(
+                method,
+                url,
+                agent=_get_agent(),
+                timeout=timeout,
+            )
+            deferred.addCallback(treq.text_content)
+            deferred.addBoth(result.put)
+        except Exception as err:
+            result.put(Failure(err))
+
+    reactor.callFromThread(request)
+    response = result.get()
+    if isinstance(response, Failure):
+        try:
+            response.raiseException()
+        except Exception as err:
+            raise _TreqRequestError() from err
+    return cast(str, response)
 
 
