--- a/yarg/_http.py
+++ b/yarg/_http.py
@@ -0,0 +1,44 @@
+# -*- coding: utf-8 -*-
+
+from http.client import responses as http_reasons
+from io import BytesIO
+
+import pycurl
+
+
+class _Response(object):
+    def __init__(self, content, status_code, reason):
+        self.content = content
+        self.status_code = status_code
+        self.reason = reason
+
+
+class Session(object):
+    def get(self, url):
+        content = BytesIO()
+        status = [None, '']
+
+        def receive_headers(line):
+            if line.startswith(b'HTTP/'):
+                parts = line.rstrip().split(None, 2)
+                if len(parts) >= 2:
+                    status[0] = int(parts[1])
+                    if len(parts) == 3:
+                        status[1] = parts[2].decode('latin1')
+            return len(line)
+
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.HTTPGET, 1)
+            curl.setopt(pycurl.FOLLOWLOCATION, 1)
+            curl.setopt(pycurl.WRITEFUNCTION, content.write)
+            curl.setopt(pycurl.HEADERFUNCTION, receive_headers)
+            curl.perform()
+            status_code = status[0]
+            if status_code is None:
+                status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            reason = status[1] or http_reasons.get(status_code, '')
+            return _Response(content.getvalue(), status_code, reason)
+        finally:
+            curl.close()
