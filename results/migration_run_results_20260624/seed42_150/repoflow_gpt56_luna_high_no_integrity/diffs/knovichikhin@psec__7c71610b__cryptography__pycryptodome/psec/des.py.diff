+def _new_tdes_cipher(
+    key: bytes, mode: int, iv: _typing.Optional[bytes] = None
+) -> _typing.Any:
+    key_parts = [key[index : index + 8] for index in range(0, len(key), 8)]
+
+    def same_des_key(left: bytes, right: bytes) -> bool:
+        return all(
+            (left_byte & 0xFE) == (right_byte & 0xFE)
+            for left_byte, right_byte in zip(left, right)
+        )
+
+    if len(key) == 8:
+        cipher_module = _DES
+        cipher_key = key_parts[0]
+    elif len(key) == 16:
+        if same_des_key(key_parts[0], key_parts[1]):
+            cipher_module = _DES
+            cipher_key = key_parts[0]
+        else:
+            cipher_module = _DES3
+            cipher_key = key
+    elif len(key) == 24 and same_des_key(key_parts[0], key_parts[1]):
+        cipher_module = _DES
+        cipher_key = key_parts[2]
+    elif len(key) == 24 and same_des_key(key_parts[1], key_parts[2]):
+        cipher_module = _DES
+        cipher_key = key_parts[0]
+    elif len(key) == 24 and same_des_key(key_parts[0], key_parts[2]):
+        cipher_module = _DES3
+        cipher_key = key_parts[0] + key_parts[1]
+    else:
+        cipher_module = _DES3
+        cipher_key = key
+
+    if iv is None:
+        return cipher_module.new(cipher_key, mode)
+    return cipher_module.new(cipher_key, mode, iv)
+
