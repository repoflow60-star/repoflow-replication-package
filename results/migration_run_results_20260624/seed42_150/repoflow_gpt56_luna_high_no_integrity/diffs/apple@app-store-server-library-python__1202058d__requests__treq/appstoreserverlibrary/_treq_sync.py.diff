--- a/appstoreserverlibrary/_treq_sync.py
+++ b/appstoreserverlibrary/_treq_sync.py
@@ -0,0 +1,68 @@
+import threading
+from typing import Any, Dict, List, Optional, Union
+
+import treq
+from twisted.internet import reactor
+from twisted.internet.threads import blockingCallFromThread
+
+
+_reactor_thread = None
+_reactor_ready = threading.Event()
+_reactor_lock = threading.Lock()
+
+
+def _ensure_reactor() -> None:
+    global _reactor_thread
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if _reactor_thread is None:
+            def run_reactor() -> None:
+                reactor.callWhenRunning(_reactor_ready.set)
+                reactor.run(installSignalHandlers=False)
+
+            _reactor_thread = threading.Thread(target=run_reactor, daemon=True)
+            _reactor_thread.start()
+    _reactor_ready.wait()
+
+
+def _run_in_reactor(operation):
+    _ensure_reactor()
+    return blockingCallFromThread(reactor, operation)
+
+
+def request(
+    method: str,
+    url: str,
+    params: Optional[Dict[str, Union[str, List[str]]]] = None,
+    headers: Optional[Dict[str, str]] = None,
+    json: Optional[Dict[str, Any]] = None,
+    data: Optional[bytes] = None,
+):
+    kwargs = {"params": params, "headers": headers}
+    if json is not None:
+        kwargs["json"] = json
+    if data is not None:
+        kwargs["data"] = data
+    return _run_in_reactor(lambda: treq.request(method, url, **kwargs))
+
+
+def content(response):
+    response_content = getattr(response, "content", None)
+    if isinstance(response_content, (bytes, bytearray)):
+        return bytes(response_content)
+    return _run_in_reactor(lambda: treq.content(response))
+
+
+def json_content(response):
+    response_json = getattr(response, "json", None)
+    if callable(response_json):
+        return response_json()
+    return _run_in_reactor(lambda: treq.json_content(response))
+
+
+def status_code(response: Any) -> int:
+    code = getattr(response, "code", None)
+    if code is not None:
+        return code
+    return response.status_code
