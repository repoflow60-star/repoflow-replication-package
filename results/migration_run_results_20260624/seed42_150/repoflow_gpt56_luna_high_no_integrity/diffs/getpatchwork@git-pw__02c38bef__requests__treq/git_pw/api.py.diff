+_REACTOR_LOCK = threading.Lock()
+_REACTOR_THREAD: ty.Optional[threading.Thread] = None
+
+
+def _sync_treq(operation: ty.Callable[[], ty.Any]) -> ty.Any:
+    """Run one treq Deferred while retaining the module's sync API."""
+    result = Future()
+
+    def invoke() -> None:
+        try:
+            deferred = operation()
+            deferred.addCallbacks(
+                result.set_result,
+                lambda failure: result.set_exception(failure.value),
+            )
+        except BaseException as exc:
+            result.set_exception(exc)
+
+    global _REACTOR_THREAD
+    with _REACTOR_LOCK:
+        if not reactor.running and _REACTOR_THREAD is None:
+            _REACTOR_THREAD = threading.Thread(
+                target=reactor.run,
+                kwargs={'installSignalHandlers': False},
+                daemon=True,
+            )
+            _REACTOR_THREAD.start()
+        reactor.callFromThread(invoke)
+
+    return result.result()
+
+
+def _decode_header(value: ty.Any) -> str:
+    if isinstance(value, bytes):
+        return value.decode('latin-1')
+    return str(value)
+
+
+class _TreqResponse(object):
+    def __init__(self, response: ty.Any):
+        self.status_code = response.code
+        self.headers: ty.Dict[str, str] = {}
+
+        for name, values in response.headers.getAllRawHeaders():
+            if values:
+                self.headers[_decode_header(name).lower()] = _decode_header(
+                    values[0]
+                )
+
+        try:
+            self.content = _sync_treq(lambda: treq.content(response))
+        except Exception as exc:
+            raise _RequestException(str(exc), self) from exc
+
+    def json(self) -> ty.Any:
+        return json.loads(self.content.decode('utf-8'))
+
+    def raise_for_status(self) -> None:
+        if self.status_code >= 400:
+            raise _RequestException(
+                'HTTP error {}'.format(self.status_code), self
+            )
+
+    def iter_content(self, chunk_size: int) -> ty.Iterator[bytes]:
+        for offset in range(0, len(self.content), chunk_size):
+            yield self.content[offset:offset + chunk_size]
+
+
+def _request(
+    method: str,
+    url: str,
+    auth: ty.Optional[ty.Callable[[ty.Any], ty.Any]],
+    headers: ty.Dict[str, str],
+    data: ty.Any = None,
+    params: ty.Optional[Filters] = None,
+) -> _TreqResponse:
+    if auth:
+        auth(headers)
+
+    try:
+        response = _sync_treq(
+            lambda: treq.request(
+                method,
+                url,
+                headers=Headers(
+                    {name: [value] for name, value in headers.items()}
+                ),
+                data=data,
+                params=params,
+            )
+        )
+        return _TreqResponse(response)
+    except _RequestException:
+        raise
+    except Exception as exc:
+        raise _RequestException(str(exc)) from exc
+
