+def tabulate(rows: List[List], headers: List[str], tablefmt: str) -> str:
+    """Render a report table with PrettyTable-compatible column sizing."""
+    table = PrettyTable()
+    table.field_names = headers
+    table.add_rows(rows)
+
+    rendered = table.get_string().splitlines()
+    border = next(line for line in rendered if line.startswith("+"))
+    widths = [len(column) for column in border.split("+")[1:-1]]
+    values = [
+        [cell.strip() for cell in line.split("|")[1:-1]]
+        for line in rendered
+        if line.startswith("|")
+    ]
+
+    if tablefmt == "rst":
+        widths = [
+            max(len(values[0][index]) + 2, width - 2)
+            for index, width in enumerate(widths)
+        ]
+        separator = "  ".join("=" * width for width in widths)
+        lines = [separator]
+        lines.append(
+            "  ".join(
+                value.ljust(width) for value, width in zip(values[0], widths)
+            ).rstrip()
+        )
+        lines.append(separator)
+        lines.extend(
+            "  ".join(
+                value.ljust(width) for value, width in zip(row, widths)
+            ).rstrip()
+            for row in values[1:]
+        )
+        if values[1:]:
+            lines.append(separator)
+        return "\n".join(lines)
+
+    lines = [
+        "|" + "|".join(
+            f" {value.ljust(width - 2)} "
+            for value, width in zip(values[0], widths)
+        ) + "|",
+        "|" + "|".join("-" * width for width in widths) + "|",
+    ]
+    lines.extend(
+        "|" + "|".join(
+            f" {value.ljust(width - 2)} "
+            for value, width in zip(row, widths)
+        ) + "|"
+        for row in values[1:]
+    )
+    return "\n".join(lines)
 
 
