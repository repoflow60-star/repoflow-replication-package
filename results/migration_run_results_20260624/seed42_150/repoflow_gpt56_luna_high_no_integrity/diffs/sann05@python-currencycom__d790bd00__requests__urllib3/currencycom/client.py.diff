+def _encode_params(params):
+    values = []
+    for key, value in params.items():
+        if value is None:
+            continue
+        if isinstance(value, (list, tuple)):
+            values.extend((key, item) for item in value if item is not None)
+        else:
+            values.append((key, value))
+    return urlencode(values, doseq=True)
+
+
+def _request(method, url, params=None, headers=None):
+    if params:
+        encoded_params = _encode_params(params)
+        if encoded_params:
+            separator = '&' if '?' in url else '?'
+            url = '{}{}{}'.format(url, separator, encoded_params)
+    return _HTTP.request(method, url, headers=headers)
+
+
+def _json(response):
+    return json.loads(response.data)
 
 
