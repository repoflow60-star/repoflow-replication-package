+def _prompt_for_uri(uri=None):
+    if uri:
+        return typer.prompt(
+            "Please enter a new URI...\n"
+            "Or press ENTER to reuse the expired URI:"
+            f" [{Fore.LIGHTBLUE_EX}{uri}{Fore.RESET}]",
