+
+
+def _resolve_uri(value, ctx, required=False):
+    if value is None:
+        if required:
+            raise typer.BadParameter("Missing argument 'URI'")
+        return None
+
+    if value == "-":
+        uri_check = ctx.obj.resolver.user_prefs().uri_check()
+        if uri_check.uri is None:
+            value = _prompt_for_uri()
+            ctx.obj.resolver.user_prefs().uri = value
+            typer.echo("Saved hab user prefs", err=True)
+            return value
+        if uri_check.timedout:
+            logger.info(
+                f"{Fore.RED}Invalid 'URI' preference: {Fore.RESET}"
+                f"The saved URI {Fore.LIGHTBLUE_EX}{uri_check.uri}{Fore.RESET} "
+                f"has expired."
+            )
+            value = _prompt_for_uri(uri_check.uri)
+            if value:
+                ctx.obj.resolver.user_prefs().uri = value
+                typer.echo("Saving hab user prefs", err=True)
+                return value
+            if required:
+                raise typer.BadParameter("A URI is required for Hab use.")
+        else:
+            typer.echo(
+                f"Using {Fore.LIGHTBLUE_EX}{uri_check.uri}{Fore.RESET} "
+                "from hab user prefs",
+                err=True,
+            )
+            return uri_check.uri
+
+    if re.match(r"^v\d+:", value):
