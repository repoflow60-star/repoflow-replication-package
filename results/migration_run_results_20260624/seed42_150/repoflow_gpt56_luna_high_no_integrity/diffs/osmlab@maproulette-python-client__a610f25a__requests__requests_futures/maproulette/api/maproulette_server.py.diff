+
+    @staticmethod
+    def __resolve(response):
+        return response.result() if isinstance(response, Future) else response
+
+    @staticmethod
+    def __is_http_error(error):
+        return any(parent.__name__ == "HTTPError" for parent in error.__class__.__mro__)
+
+    @staticmethod
+    def __is_connection_error(error):
+        return any(
+            parent.__name__ in ("ConnectionError", "Timeout")
+            for parent in error.__class__.__mro__
+        )
