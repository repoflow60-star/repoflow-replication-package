+def _convert_expression(expression: str) -> str:
+    parts = [part.strip() for part in expression.split('|')]
+    result = parts.pop(0)
+
+    for part in parts:
+        match = re.fullmatch(r'([A-Za-z_]\w*)(?:\((.*)\))?', part, re.DOTALL)
+        if match is None:
+            result = '{}({})'.format(part, result)
+            continue
+        name, arguments = match.groups()
+        if arguments:
+            result = '{}({}, {})'.format(name, result, arguments)
+        else:
+            result = '{}({})'.format(name, result)
+
+    return result
+
+
+def _convert_template(template: str) -> str:
+    return re.sub(
+        r'\{\{(.*?)\}\}',
+        lambda match: '${{{}}}'.format(_convert_expression(match.group(1))),
+        template,
+        flags=re.DOTALL,
+    )
 
