+    def _request(self, method, url, params=None, body=None, fields=None):
+        """Send a request through the urllib3 connection pool."""
+        if params:
+            if hasattr(params, 'items'):
+                params = [(key, value) for key, value in params.items() if value is not None]
+            else:
+                params = [(key, value) for key, value in params if value is not None]
+            query = urlencode(params, doseq=True)
+            if query:
+                separator = '&' if '?' in url else '?'
+                url += separator + query
+
+        headers = {key: value for key, value in self.headers.items() if value is not None}
+        request_options = {'headers': headers}
+        if body is not None:
+            if not any(key.lower() == 'content-type' for key in headers):
+                headers['Content-Type'] = 'application/json'
+            request_options['body'] = json.dumps(body).encode('utf-8')
+        elif fields is not None:
+            request_options['fields'] = fields
+            request_options['encode_multipart'] = True
+
+        try:
+            return self.session.request(method, url, **request_options)
+        except urllib3.exceptions.HTTPError as error:
+            raise ConnectionUnavailableError(message=str(error)) from None
+
+    @staticmethod
+    def _response_text(response):
+        data = getattr(response, 'data', None)
+        if not isinstance(data, (bytes, str)):
+            data = getattr(response, 'text', None)
+        if isinstance(data, bytes):
+            return data.decode('utf-8', errors='replace')
+        return data
+
+    @staticmethod
+    def _response_data(response):
+        text = MapRouletteServer._response_text(response)
+        try:
+            return json.loads(text)
+        except (TypeError, ValueError):
+            return text
+
+    @staticmethod
+    def _response_status(response):
+        status = getattr(response, 'status', None)
+        if status is None:
+            status = getattr(response, 'status_code', None)
+        return status
+
+    def _raise_for_status(self, response, error_types):
+        status = self._response_status(response)
+        if status is None or status < 400:
+            return
+        error_type = error_types.get(status, HttpError)
+        raise error_type(
+            message=self.parse_response_message(response),
+            status=status
+        ) from None
+
