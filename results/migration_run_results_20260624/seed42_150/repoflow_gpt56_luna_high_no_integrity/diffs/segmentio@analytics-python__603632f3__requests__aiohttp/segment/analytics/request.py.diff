+class _HeadersSnapshot(dict):
+    def get(self, key, default=None):
+        value = super().get(key, default)
+        if value is not default:
+            return value
+        key = key.lower()
+        for header, value in self.items():
+            if header.lower() == key:
+                return value
+        return default
+
+
+class _ResponseSnapshot:
+    """Keep the response data available after the aiohttp session closes."""
+
+    def __init__(self, response, content):
+        try:
+            encoding = response.get_encoding() or 'utf-8'
+        except (LookupError, RuntimeError):
+            encoding = 'utf-8'
+        self.status_code = response.status
+        self.headers = _HeadersSnapshot(response.headers)
+        self.reason = response.reason
+        self.content = content
+        self.encoding = encoding
+        self.text = content.decode(encoding, errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+
+async def _post_async(url, data, headers, timeout, proxy=None):
+    async with aiohttp.ClientSession() as session:
+        request_kwargs = {
+            'data': data,
+            'headers': headers,
+            'timeout': timeout,
+        }
+        if proxy:
+            request_kwargs['proxy'] = proxy
+        async with session.post(url, **request_kwargs) as response:
+            return _ResponseSnapshot(response, await response.read())
+
