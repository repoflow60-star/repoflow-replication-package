+def _store_response_header(headers, line):
+    line_length = len(line)
+    if isinstance(line, bytes):
+        line = line.decode('iso-8859-1')
+    line = line.strip()
+    if line.startswith('HTTP/'):
+        headers.clear()
+    elif ':' in line:
+        name, value = line.split(':', 1)
+        headers[name.strip()] = value.strip()
+    return line_length
