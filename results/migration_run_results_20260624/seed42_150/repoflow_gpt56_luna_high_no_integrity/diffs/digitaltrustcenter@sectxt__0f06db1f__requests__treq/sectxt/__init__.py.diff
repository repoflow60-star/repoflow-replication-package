+def _response_url(response, default: str) -> str:
+    response_url = getattr(response, "url", None)
+    if response_url is None:
+        request = getattr(response, "request", None)
+        response_url = getattr(request, "absoluteURI", None)
+        if response_url is None:
+            response_url = getattr(request, "uri", None)
+    if isinstance(response_url, bytes):
+        response_url = response_url.decode("ascii")
+    return response_url or default
+
+
+def _response_history(response, request_url: str, response_url: str):
+    history = []
+    previous = getattr(response, "history", None)
+    if previous:
+        for previous_response in previous:
+            previous_url = _response_url(previous_response, "")
+            if previous_url:
+                history.append(previous_url)
+    else:
+        previous = getattr(response, "previousResponse", None)
+        previous_responses = []
+        while previous is not None:
+            previous_url = _response_url(previous, "")
+            if previous_url:
+                previous_responses.append(previous_url)
+            previous = getattr(previous, "previousResponse", None)
+        history.extend(reversed(previous_responses))
+    if not history and response_url != request_url:
+        history.append(request_url)
+    return history
+
