+def _treq_headers(headers):
+    raw_headers = {}
+    for name, value in headers.items():
+        if isinstance(name, str):
+            name = name.encode("ascii")
+        if isinstance(value, str):
+            value = value.encode("latin-1")
+        raw_headers[name] = [value]
+    return Headers(raw_headers)
+
+
+@inlineCallbacks
+def _treq_get(url: str, headers: dict, timeout: int, verify: bool):
+    request_kwargs = {
+        "headers": _treq_headers(headers),
+        "timeout": timeout,
+        "browser_like_redirects": True,
+        "reactor": reactor,
+    }
+    if not verify:
+        request_kwargs["agent"] = Agent(reactor, ClientContextFactory())
+    response = yield treq.get(url, **request_kwargs)
+    content = yield treq.content(response)
+    response_url = _response_url(response, url)
+    returnValue({
+        "status_code": response.code,
+        "content": content,
+        "content_type": _header_value(getattr(response, "headers", None), "content-type"),
+        "url": response_url,
+        "history": _response_history(response, url, response_url),
+    })
+
+
+def _get(url: str, headers: dict, timeout: int, verify: bool = True):
+    _ensure_reactor()
+    return blockingCallFromThread(reactor, _treq_get, url, headers, timeout, verify)
+
