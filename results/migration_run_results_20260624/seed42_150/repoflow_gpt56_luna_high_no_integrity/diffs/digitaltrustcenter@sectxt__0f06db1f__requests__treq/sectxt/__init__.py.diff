+def _is_tls_error(error: BaseException) -> bool:
+    error_type = type(error)
+    if error_type.__name__ in {
+        "CertificateError",
+        "SSLError",
+        "VerificationError",
+    }:
+        return True
+    if "ssl" in error_type.__module__.lower() or "tls" in error_type.__module__.lower():
+        return True
+    value = getattr(error, "value", None)
+    if value is not None and value is not error and _is_tls_error(value):
+        return True
+    for reason in getattr(error, "reasons", ()):
+        reason = getattr(reason, "value", reason)
+        if reason is not error and _is_tls_error(reason):
+            return True
+    return False
 
 
