+def _ensure_reactor() -> None:
+    global _reactor_thread
+    if reactor.running:
+        return
+    with _reactor_lock:
+        if not reactor.running and _reactor_thread is None:
+            _reactor_thread = Thread(
+                target=reactor.run,
+                kwargs={"installSignalHandlers": False},
+                daemon=True,
