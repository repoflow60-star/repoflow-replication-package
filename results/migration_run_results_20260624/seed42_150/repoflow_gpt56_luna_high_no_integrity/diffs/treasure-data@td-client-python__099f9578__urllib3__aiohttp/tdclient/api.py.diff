+class _ResponseAdapter:
+    """Expose the response interface used by the synchronous API."""
+
+    def __init__(self, response, body):
+        self.status = response.status
+        self.headers = dict(response.headers)
+        self.data = body
+        self._position = 0
+
+    def read(self, amount=-1):
+        if amount is None or amount < 0:
+            amount = len(self.data) - self._position
+        end = self._position + amount
+        body = self.data[self._position:end]
+        self._position = min(end, len(self.data))
+        return body
+
+    def stream(self, amount=64 * 1024):
+        while self._position < len(self.data):
+            chunk = self.read(amount)
+            if not chunk:
+                break
+            yield chunk
+
+    def getheaders(self):
+        return self.headers
+
+    def close(self):
+        self._position = len(self.data)
+
+
+class _AiohttpHTTPClient:
+    """Synchronous facade around aiohttp's asynchronous client."""
+
+    def __init__(
+        self,
+        proxy=None,
+        proxy_auth=None,
+        ca_certs=None,
+        cert_reqs=None,
+        timeout=60,
+        **kwargs,
+    ):
+        self._proxy = proxy
+        self._proxy_auth = proxy_auth
+        self._timeout = aiohttp.ClientTimeout(total=timeout)
+        if cert_reqs == ssl.CERT_NONE:
+            self._ssl = False
+        elif ca_certs is not None:
+            self._ssl = ssl.create_default_context(cafile=ca_certs)
+        else:
+            self._ssl = None
+
+    async def _request_async(
+        self, method, url, fields=None, body=None, headers=None
+    ):
+        request_kwargs = {
+            "headers": headers,
+            "timeout": self._timeout,
+            "ssl": self._ssl,
+        }
+        if self._proxy is not None:
+            request_kwargs["proxy"] = self._proxy
+            request_kwargs["proxy_auth"] = self._proxy_auth
+        if body is not None:
+            request_kwargs["data"] = body
+        elif fields is not None:
+            if method in ("GET", "DELETE", "HEAD", "OPTIONS"):
+                request_kwargs["params"] = fields
+            else:
+                request_kwargs["data"] = fields
+
+        async with aiohttp.ClientSession() as session:
+            async with session.request(method, url, **request_kwargs) as response:
+                return _ResponseAdapter(response, await response.read())
+
+    def _run_request(self, method, url, fields=None, body=None, headers=None):
+        def run():
+            return asyncio.run(
+                self._request_async(
+                    method, url, fields=fields, body=body, headers=headers
+                )
+            )
+
+        try:
+            asyncio.get_running_loop()
+        except RuntimeError:
+            return run()
+
+        # Run in a separate thread so the legacy synchronous API also works
+        # when called by code that already owns an event loop.
+        result = []
+        error = []
+
+        def run_in_thread():
+            try:
+                result.append(run())
+            except BaseException as exc:
+                error.append(exc)
+
+        thread = threading.Thread(target=run_in_thread)
+        thread.start()
+        thread.join()
+        if error:
+            raise error[0]
+        return result[0]
+
+    def request(self, method, url, fields=None, body=None, headers=None, **kwargs):
+        return self._run_request(
+            method, url, fields=fields, body=body, headers=headers
+        )
+
+    def urlopen(self, method, url, body=None, headers=None, **kwargs):
+        return self._run_request(method, url, body=body, headers=headers)
+
+    def clear(self):
+        # Each request owns and closes its ClientSession.
+        return None
+
