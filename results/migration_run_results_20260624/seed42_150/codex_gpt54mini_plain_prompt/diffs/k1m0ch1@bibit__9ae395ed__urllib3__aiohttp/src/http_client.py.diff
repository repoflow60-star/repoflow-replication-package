@@ -0,0 +1,116 @@
+import asyncio
+from dataclasses import dataclass
+from typing import Any, Optional
+
+import aiohttp
+
+
+@dataclass
+class HttpResponse:
+    status_code: int
+    text: str
+    _json: Any = None
+
+    def json(self) -> Any:
+        if self._json is None:
+            raise ValueError("Response body is not JSON")
+        return self._json
+
+
+async def _request(
+    method: str,
+    url: str,
+    *,
+    headers: Optional[dict] = None,
+    params: Optional[dict] = None,
+    json: Any = None,
+    auth: Any = None,
+    ssl: Any = None,
+    timeout: int = 60,
+) -> HttpResponse:
+    client_timeout = aiohttp.ClientTimeout(total=timeout)
+    async with aiohttp.ClientSession(timeout=client_timeout) as session:
+        async with session.request(
+            method,
+            url,
+            headers=headers,
+            params=params,
+            json=json,
+            auth=auth,
+            ssl=ssl,
+        ) as response:
+            text = await response.text()
+            json_body = None
+            if response.content_type == "application/json" or "json" in response.headers.get("Content-Type", "").lower():
+                try:
+                    json_body = await response.json(content_type=None)
+                except Exception:
+                    json_body = None
+            return HttpResponse(response.status, text, json_body)
+
+
+def request(
+    method: str,
+    url: str,
+    *,
+    headers: Optional[dict] = None,
+    params: Optional[dict] = None,
+    json: Any = None,
+    auth: Any = None,
+    ssl: Any = None,
+    timeout: int = 60,
+) -> HttpResponse:
+    return asyncio.run(
+        _request(
+            method,
+            url,
+            headers=headers,
+            params=params,
+            json=json,
+            auth=auth,
+            ssl=ssl,
+            timeout=timeout,
+        )
+    )
+
+
+def get(
+    url: str,
+    *,
+    headers: Optional[dict] = None,
+    params: Optional[dict] = None,
+    auth: Any = None,
+    ssl: Any = None,
+    timeout: int = 60,
+) -> HttpResponse:
+    return request(
+        "GET",
+        url,
+        headers=headers,
+        params=params,
+        auth=auth,
+        ssl=ssl,
+        timeout=timeout,
+    )
+
+
+def post(
+    url: str,
+    *,
+    headers: Optional[dict] = None,
+    params: Optional[dict] = None,
+    json: Any = None,
+    auth: Any = None,
+    ssl: Any = None,
+    timeout: int = 60,
+) -> HttpResponse:
+    return request(
+        "POST",
+        url,
+        headers=headers,
+        params=params,
+        json=json,
+        auth=auth,
+        ssl=ssl,
+        timeout=timeout,
+    )
