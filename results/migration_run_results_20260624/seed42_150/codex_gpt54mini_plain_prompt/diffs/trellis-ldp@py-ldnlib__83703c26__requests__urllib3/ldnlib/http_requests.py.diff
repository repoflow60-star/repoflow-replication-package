@@ -0,0 +1,141 @@
+import json
+import re
+from types import SimpleNamespace
+from urllib.parse import urljoin
+
+import urllib3
+from urllib3 import make_headers
+
+
+_HTTP = urllib3.PoolManager()
+
+
+class HTTPError(Exception):
+    def __init__(self, message, response=None):
+        super().__init__(message)
+        self.response = response
+
+
+class Response:
+    def __init__(self, response):
+        self._response = response
+        self.status_code = response.status
+        self.headers = response.headers
+        self.url = getattr(response, "url", None)
+
+    @property
+    def content(self):
+        return self._response.data
+
+    @property
+    def text(self):
+        data = self._response.data
+        if not data:
+            return ""
+
+        content_type = self.headers.get("content-type", "")
+        charset = "utf-8"
+        match = re.search(r"charset=([^;]+)", content_type, re.I)
+        if match:
+            charset = match.group(1).strip().strip('"')
+
+        return data.decode(charset, errors="replace")
+
+    @property
+    def links(self):
+        link_header = self.headers.get("link")
+        if not link_header:
+            return {}
+
+        links = {}
+        for item in re.split(r",\s*(?=<)", link_header):
+            match = re.match(r"\s*<([^>]+)>\s*(.*)", item)
+            if not match:
+                continue
+
+            url, params = match.groups()
+            link = {"url": urljoin(self.url, url) if self.url else url}
+            for param in re.split(r";\s*", params.strip()):
+                if not param or "=" not in param:
+                    continue
+                key, value = param.split("=", 1)
+                link[key.strip()] = value.strip().strip('"')
+
+            rel = link.get("rel")
+            if rel:
+                links[rel] = link
+
+        return links
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            reason = getattr(self._response, "reason", "")
+            raise HTTPError(
+                "HTTP {}{}".format(
+                    self.status_code,
+                    " {}".format(reason) if reason else "",
+                ),
+                response=self,
+            )
+
+
+def _apply_auth(headers, auth):
+    if auth is None:
+        return headers
+
+    username, password = auth
+    auth_headers = make_headers(basic_auth="{}:{}".format(username, password))
+    headers.update(auth_headers)
+    return headers
+
+
+def _prepare_headers(kwargs):
+    headers = dict(kwargs.pop("headers", {}))
+    return _apply_auth(headers, kwargs.pop("auth", None))
+
+
+def _request(method, url, **kwargs):
+    headers = _prepare_headers(kwargs)
+    data = kwargs.pop("data", None)
+    json_body = kwargs.pop("json", None)
+    allow_redirects = kwargs.pop("allow_redirects", True)
+
+    body = data
+    if json_body is not None:
+        body = json.dumps(json_body)
+        headers.setdefault("content-type", "application/json")
+
+    if isinstance(body, str):
+        body = body.encode("utf-8")
+
+    response = _HTTP.request(
+        method,
+        url,
+        body=body,
+        headers=headers,
+        redirect=allow_redirects,
+        **kwargs,
+    )
+    return Response(response)
+
+
+def head(url, **kwargs):
+    return _request("HEAD", url, **kwargs)
+
+
+def get(url, **kwargs):
+    return _request("GET", url, **kwargs)
+
+
+def options(url, **kwargs):
+    return _request("OPTIONS", url, **kwargs)
+
+
+def post(url, **kwargs):
+    return _request("POST", url, **kwargs)
+
+
+codes = SimpleNamespace(ok=200)
