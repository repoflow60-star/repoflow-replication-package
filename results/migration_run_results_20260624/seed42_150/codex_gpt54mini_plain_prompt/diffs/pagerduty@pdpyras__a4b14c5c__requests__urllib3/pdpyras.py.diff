+class Request:
+    """Lightweight request metadata container for response objects."""
+
+    def __init__(self, method, url, headers=None, body=None):
+        self.method = method
+        self.url = url
+        self.headers = headers or {}
+        self.body = body
+
+
+class Response:
+    """Small urllib3-backed response adapter with requests-like attributes."""
+
+    def __init__(self, status_code, body=b'', method='GET', url='',
+            headers=None, request_headers=None, request_body=None,
+            elapsed=0.0, reason=None):
+        self.status_code = status_code
+        self.ok = bool(status_code) and status_code < 400
+        self.headers = headers or {}
+        self.request = Request(
+            method,
+            url,
+            headers=request_headers,
+            body=request_body,
+        )
+        self.reason = reason
+        if isinstance(body, bytes):
+            self._body = body
+        elif body is None:
+            self._body = b''
+        else:
+            self._body = str(body).encode('utf-8')
+        self.elapsed = timedelta(seconds=float(elapsed))
+
+    @property
+    def text(self) -> str:
+        return self._body.decode('utf-8', errors='replace')
+
+    def json(self):
+        return json.loads(self.text)
+
+    @classmethod
+    def from_urllib3(cls, response, method, url, request_headers=None,
+            request_body=None, elapsed=0.0):
+        body = response.data
+        if body is None:
+            body = b''
+        return cls(
+            response.status,
+            body=body,
+            method=method,
+            url=url,
+            headers=dict(response.headers.items()),
+            request_headers=request_headers,
+            request_body=request_body,
+            elapsed=elapsed,
+            reason=getattr(response, 'reason', None),
+        )
+
+
+class _Urllib3SessionAdapter:
+    """Request adapter that presents a requests-like interface."""
+
+    def __init__(self):
+        self._pool = PoolManager()
+
+    @staticmethod
+    def _merge_url(url: str, params=None) -> str:
+        if not params:
+            return url
+        split_url = urlsplit(url)
+        query = parse_qsl(split_url.query, keep_blank_values=True)
+        if isinstance(params, dict):
+            params = list(params.items())
+        query.extend(params)
+        return urlunsplit((
+            split_url.scheme,
+            split_url.netloc,
+            split_url.path,
+            urlencode(query, doseq=True),
+            split_url.fragment,
+        ))
+
+    def request(self, method, url, **kwargs):
+        params = kwargs.pop('params', None)
+        json_body = kwargs.pop('json', None)
+        data = kwargs.pop('data', None)
+        headers = kwargs.pop('headers', {}) or {}
+        timeout = kwargs.pop('timeout', None)
+        allow_redirects = kwargs.pop('allow_redirects', True)
+        kwargs.pop('stream', None)
+
+        final_url = self._merge_url(url, params=params)
+        if json_body is not None:
+            body = json.dumps(json_body).encode('utf-8')
+        elif data is None:
+            body = None
+        elif isinstance(data, bytes):
+            body = data
+        elif isinstance(data, str):
+            body = data.encode('utf-8')
+        else:
+            body = urlencode(data, doseq=True).encode('utf-8')
+
+        start = time.perf_counter()
+        response = self._pool.request(
+            method,
+            final_url,
+            body=body,
+            headers=headers,
+            timeout=timeout,
+            retries=False,
+            redirect=allow_redirects,
+            preload_content=True,
+        )
+        elapsed = time.perf_counter() - start
+        return Response.from_urllib3(
+            response,
+            method=method,
+            url=final_url,
+            request_headers=headers,
+            request_body=body,
+            elapsed=elapsed,
+        )
+
+    def close(self):
+        self._pool.clear()
+
+    def get(self, url, **kwargs):
+        return self.request('GET', url, allow_redirects=True, **kwargs)
+
+    def delete(self, url, **kwargs):
+        return self.request('DELETE', url, allow_redirects=True, **kwargs)
+
+    def post(self, url, **kwargs):
+        return self.request('POST', url, **kwargs)
+
+    def put(self, url, **kwargs):
+        return self.request('PUT', url, **kwargs)
+
