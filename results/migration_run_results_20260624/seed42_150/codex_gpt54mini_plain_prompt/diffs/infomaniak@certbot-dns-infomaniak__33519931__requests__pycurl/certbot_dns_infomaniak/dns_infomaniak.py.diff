 logger = logging.getLogger(__name__)
 
 
+class _Response:
+    """Small response wrapper used for pycurl responses."""
+
+    def __init__(self, status_code, body, url):
+        self.status_code = status_code
+        self._body = body or b""
+        self.url = url
+
+    def json(self):
+        return json.loads(self.text)
+
+    @property
+    def text(self):
+        if isinstance(self._body, bytes):
+            return self._body.decode("utf-8")
+        return self._body
+
+
+class _Session:
+    """Very small session object with requests-like methods."""
+
+    def __init__(self):
+        self.headers = {}
+        self._mounts = {}
+
+    def mount(self, prefix, adapter):
+        self._mounts[prefix] = adapter
+
+    def get(self, url, params=None, headers=None):
+        return self._request("GET", url, params=params, headers=headers)
+
+    def post(self, url, data=None, headers=None):
+        return self._request("POST", url, data=data, headers=headers)
+
+    def delete(self, url, headers=None):
+        return self._request("DELETE", url, headers=headers)
+
+    def _request(self, method, url, params=None, data=None, headers=None):
+        request_url = self._build_url(url, params)
+        request_headers = self._merge_headers(headers)
+        adapter = self._get_adapter(request_url)
+        if adapter is not None:
+            request = SimpleNamespace(
+                method=method,
+                url=request_url,
+                headers=request_headers,
+                body=data,
+            )
+            return adapter.send(request)
+        return self._pycurl_request(method, request_url, request_headers, data)
+
+    def _get_adapter(self, url):
+        for prefix, adapter in sorted(
+            self._mounts.items(), key=lambda item: len(item[0]), reverse=True
+        ):
+            if url.startswith(prefix):
+                return adapter
+        return None
+
+    def _merge_headers(self, headers):
+        merged = dict(self.headers)
+        if headers:
+            merged.update(headers)
+        return merged
+
+    def _build_url(self, url, params):
+        if not params:
+            return url
+        parsed = urlsplit(url)
+        query = parse_qsl(parsed.query, keep_blank_values=True)
+        query.extend(params.items())
+        return urlunsplit(
+            (
+                parsed.scheme,
+                parsed.netloc,
+                parsed.path,
+                urlencode(query, doseq=True),
+                parsed.fragment,
+            )
+        )
+
+    def _pycurl_request(self, method, url, headers, data):
+        if pycurl is None:
+            raise errors.PluginError("pycurl is required to contact the Infomaniak API")
+
+        body = io.BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            curl.setopt(pycurl.WRITEFUNCTION, body.write)
+
+            header_lines = ["{}: {}".format(name, value) for name, value in headers.items()]
+            if header_lines:
+                curl.setopt(pycurl.HTTPHEADER, header_lines)
+
+            if method == "POST":
+                curl.setopt(pycurl.POST, 1)
+                if data is not None:
+                    if isinstance(data, str):
+                        data = data.encode("utf-8")
+                    curl.setopt(pycurl.POSTFIELDS, data)
+            elif method == "DELETE":
+                curl.setopt(pycurl.CUSTOMREQUEST, "DELETE")
+
+            curl.perform()
+            status_code = curl.getinfo(pycurl.RESPONSE_CODE)
+            return _Response(status_code, body.getvalue(), url)
+        finally:
+            curl.close()
+
+
