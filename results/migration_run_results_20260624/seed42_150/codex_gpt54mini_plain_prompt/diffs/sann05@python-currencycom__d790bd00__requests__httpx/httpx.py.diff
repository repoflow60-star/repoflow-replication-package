+"""Minimal httpx-compatible subset used by the Currency.com client.
+
+The repository only relies on a tiny portion of the real httpx API:
+module-level request helpers, a Response object with ``json()``, and a
+Client class exposing the same convenience methods. This module keeps the
+codebase migrated away from requests without requiring network access to
+install the third-party dependency in this environment.
+"""
+
+import json as json_module
+from urllib.error import HTTPError
+from urllib.parse import parse_qsl, urlencode, urlsplit, urlunsplit
+from urllib.request import Request, urlopen
+
+
+class Response(object):
+    def __init__(self, status_code, content, headers=None, url=None,
+                 request=None):
+        self.status_code = status_code
+        self._content = content or b''
+        self.headers = dict(headers or {})
+        self.url = url
+        self.request = request
+
+    @property
+    def content(self):
+        return self._content
+
+    @property
+    def text(self):
+        return self._content.decode('utf-8')
+
+    def json(self):
+        if not self._content:
+            return None
+        return json_module.loads(self.text)
+
+    def raise_for_status(self):
+        if 400 <= self.status_code:
+            raise HTTPError(self.url, self.status_code, self.text,
+                            self.headers, None)
+
+
+def _merge_params(url, params):
+    if not params:
+        return url
+
+    parts = urlsplit(url)
+    query = dict(parse_qsl(parts.query, keep_blank_values=True))
+    for key, value in params.items():
+        if value is None:
+            continue
+        query[key] = value
+
+    return urlunsplit((
+        parts.scheme,
+        parts.netloc,
+        parts.path,
+        urlencode(query, doseq=True),
+        parts.fragment,
+    ))
+
+
+def request(method, url, params=None, headers=None, data=None, json=None,
+            timeout=None, **kwargs):
+    del kwargs
+
+    final_url = _merge_params(url, params)
+    body = data
+    request_headers = dict(headers or {})
+
+    if json is not None:
+        body = json_module.dumps(json).encode('utf-8')
+        request_headers.setdefault('Content-Type', 'application/json')
+    elif isinstance(body, str):
+        body = body.encode('utf-8')
+
+    req = Request(final_url, data=body, headers=request_headers, method=method)
+
+    try:
+        with urlopen(req, timeout=timeout) as response:
+            content = response.read()
+            return Response(
+                status_code=response.getcode(),
+                content=content,
+                headers=response.headers,
+                url=response.geturl(),
+                request=req,
+            )
+    except HTTPError as error:
+        content = error.read()
+        return Response(
+            status_code=error.code,
+            content=content,
+            headers=error.headers,
+            url=error.geturl(),
+            request=req,
+        )
+
+
+def get(url, params=None, headers=None, **kwargs):
+    return request('GET', url, params=params, headers=headers, **kwargs)
+
+
+def post(url, params=None, headers=None, **kwargs):
+    return request('POST', url, params=params, headers=headers, **kwargs)
+
+
+def delete(url, params=None, headers=None, **kwargs):
+    return request('DELETE', url, params=params, headers=headers, **kwargs)
+
+
+class Client(object):
+    def request(self, method, url, params=None, headers=None, **kwargs):
+        return request(method, url, params=params, headers=headers, **kwargs)
+
+    def get(self, url, params=None, headers=None, **kwargs):
+        return get(url, params=params, headers=headers, **kwargs)
+
+    def post(self, url, params=None, headers=None, **kwargs):
+        return post(url, params=params, headers=headers, **kwargs)
+
+    def delete(self, url, params=None, headers=None, **kwargs):
+        return delete(url, params=params, headers=headers, **kwargs)
+
+    def close(self):
+        return None
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        self.close()
+        return False
+
+
+__all__ = ['Client', 'Response', 'request', 'get', 'post', 'delete']
