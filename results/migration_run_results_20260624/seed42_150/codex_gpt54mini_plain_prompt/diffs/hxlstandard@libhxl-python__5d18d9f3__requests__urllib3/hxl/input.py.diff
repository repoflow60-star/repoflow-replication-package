+def _make_http_pool(input_options):
+    """Create an urllib3 client configured from the current input options."""
+    timeout = None
+    if input_options and input_options.timeout is not None:
+        timeout = urllib3.Timeout(connect=input_options.timeout, read=input_options.timeout)
+
+    if input_options and not input_options.verify_ssl:
+        ssl_context = ssl._create_unverified_context()
+    else:
+        ssl_context = ssl.create_default_context()
+
+    retries = urllib3.Retry(total=None, connect=0, read=0, redirect=3, status=0, other=0)
+    return urllib3.PoolManager(timeout=timeout, retries=retries, ssl_context=ssl_context)
+
+
+def _http_request(method, url, input_options, **kwargs):
+    """Send a request through urllib3 with consistent configuration."""
+    http = _make_http_pool(input_options)
+    headers = kwargs.pop("headers", None)
+    if headers is None:
+        headers = input_options.http_headers if input_options else None
+    return http.request(method, url, headers=headers, **kwargs)
+
+
+def _response_charset(response):
+    content_type = response.headers.get('content-type')
+    if content_type:
+        result = re.match(r'^(\S+)\s*;\s*charset=(\S+)$', content_type)
+        if result:
+            return result.group(2).lower()
+    return None
+
+
+def _response_json(response):
+    encoding = _response_charset(response) or 'utf-8'
+    return json.loads(response.data.decode(encoding))
+
+
+def _raise_for_status(response, url):
+    if response.status >= 400:
+        raise HXLIOException("HTTP error {} for {}".format(response.status, url), url=url)
+
+
