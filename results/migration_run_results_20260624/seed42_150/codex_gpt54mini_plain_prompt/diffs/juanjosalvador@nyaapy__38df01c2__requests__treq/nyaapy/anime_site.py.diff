+import asyncio
+from urllib.error import HTTPError, URLError
+from urllib.parse import quote, urlencode
+from urllib.request import Request, urlopen
+
+try:
+    from twisted.internet import asyncioreactor
+except ImportError:
+    asyncioreactor = None
+
+try:
+    import treq
+except ImportError:
+    treq = None
+
 from nyaapy import torrent
 from nyaapy.parser import parse_nyaa, parse_single, parse_nyaa_rss
 
 
+async def _fetch_bytes(url: str) -> bytes:
+    if treq is None or asyncioreactor is None:
+        raise RuntimeError("treq is not available")
+
+    response = await treq.get(url)
+
+    if response.code >= 400:
+        body = await response.content()
+        message = body.decode("utf-8", errors="replace")
+        raise RuntimeError(f"HTTP {response.code} for {url}: {message}")
+
+    return await response.content()
+
+
+def _fetch_bytes_urllib(url: str) -> bytes:
+    request = Request(url, headers={"User-Agent": "nyaapy"})
+
+    try:
+        with urlopen(request) as response:
+            return response.read()
+    except HTTPError as exc:
+        body = exc.read().decode("utf-8", errors="replace")
+        raise RuntimeError(f"HTTP {exc.code} for {url}: {body}") from exc
+    except URLError as exc:
+        raise RuntimeError(f"Unable to fetch {url}: {exc.reason}") from exc
+
+
+def _get_bytes(url: str) -> bytes:
+    if treq is None or asyncioreactor is None:
+        return _fetch_bytes_urllib(url)
+
+    try:
+        asyncioreactor.install()
+    except Exception:
+        # The reactor may already be installed when the module is imported.
+        pass
+
+    return asyncio.run(_fetch_bytes(url))
+
