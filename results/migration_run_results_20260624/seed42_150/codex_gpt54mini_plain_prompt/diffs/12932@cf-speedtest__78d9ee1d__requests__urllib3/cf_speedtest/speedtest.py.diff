+class _Urllib3Response:
+    def __init__(self, response: urllib3.response.HTTPResponse):
+        self._response = response
+        self.headers = response.headers
+
+    @property
+    def content(self) -> bytes:
+        return self._response.data or b''
+
+    @property
+    def text(self) -> str:
+        return self.content.decode('utf-8', errors='replace')
+
+    def raise_for_status(self) -> None:
+        if self._response.status >= 400:
+            raise urllib3.exceptions.HTTPError(
+                f'HTTP {self._response.status}: {self._response.reason}',
+            )
+
+
+class _Urllib3Session:
+    def __init__(self):
+        self._manager_cache = {}
+
+    def _manager(self, verify: bool, proxies: dict | None) -> urllib3.PoolManager:
+        cert_reqs = ssl.CERT_REQUIRED if verify else ssl.CERT_NONE
+        proxy_url = None
+        if proxies:
+            proxy_url = proxies.get('https') or proxies.get('http')
+
+        cache_key = (verify, proxy_url)
+        manager = self._manager_cache.get(cache_key)
+        if manager is not None:
+            return manager
+
+        if proxy_url:
+            manager = urllib3.ProxyManager(proxy_url, cert_reqs=cert_reqs)
+        else:
+            manager = urllib3.PoolManager(cert_reqs=cert_reqs)
+
+        self._manager_cache[cache_key] = manager
+        return manager
+
+    def get(
+        self,
+        url: str,
+        verify: bool = True,
+        proxies: dict | None = None,
+        **kwargs,
+    ) -> _Urllib3Response:
+        response = self._manager(verify, proxies).request('GET', url, **kwargs)
+        return _Urllib3Response(response)
+
+    def post(
+        self,
+        url: str,
+        data=None,
+        headers: dict | None = None,
+        verify: bool = True,
+        proxies: dict | None = None,
+        **kwargs,
+    ) -> _Urllib3Response:
+        response = self._manager(verify, proxies).request(
+            'POST',
+            url,
+            body=data,
+            headers=headers,
+            **kwargs,
+        )
+        return _Urllib3Response(response)
+
+
+REQ_SESSION = _Urllib3Session()
 
