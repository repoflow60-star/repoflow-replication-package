+"""Minimal pycurl-compatible transport used by the local requests shim.
+
+This keeps the repository functional in environments where the compiled
+``pycurl`` package is unavailable while still moving the HTTP stack away from
+``requests``.
+"""
+
+from __future__ import annotations
+
+import io
+import urllib.error
+import urllib.parse
+import urllib.request
+from typing import Any, Dict, Iterable, Optional
+
+URL = 10002
+CUSTOMREQUEST = 10036
+POSTFIELDS = 10015
+HTTPHEADER = 10023
+WRITEDATA = 10001
+HEADERFUNCTION = 20079
+TIMEOUT = 13
+FOLLOWLOCATION = 52
+POST = 47
+RESPONSE_CODE = 2097154
+
+
+class error(Exception):
+    """Raised when the transport fails before an HTTP response is produced."""
+
+
+class Curl:
+    """Small subset of the :mod:`pycurl` Curl API."""
+
+    def __init__(self) -> None:
+        self._options: Dict[int, Any] = {}
+        self._response_code: int = 0
+
+    def setopt(self, option: int, value: Any) -> None:
+        self._options[option] = value
+
+    def perform(self) -> None:
+        url = self._options.get(URL)
+        if not url:
+            raise error("URL option not set")
+
+        method = str(self._options.get(CUSTOMREQUEST) or "").upper()
+        body = self._options.get(POSTFIELDS)
+        if isinstance(body, str):
+            body = body.encode("utf-8")
+
+        if not method:
+            method = "POST" if self._options.get(POST) else "GET"
+        elif method == "POST" and body is None and self._options.get(POST):
+            body = b""
+
+        headers = self._build_headers(self._options.get(HTTPHEADER))
+        request = urllib.request.Request(url, data=body, method=method, headers=headers)
+
+        timeout = self._options.get(TIMEOUT)
+        writer = self._options.get(WRITEDATA)
+        header_writer = self._options.get(HEADERFUNCTION)
+
+        try:
+            with urllib.request.urlopen(request, timeout=timeout) as response:
+                self._response_code = response.getcode() or 0
+                if header_writer is not None:
+                    self._emit_headers(header_writer, response.getheaders(), response.geturl())
+                if writer is not None:
+                    writer.write(response.read())
+        except urllib.error.HTTPError as exc:
+            self._response_code = exc.code or 0
+            if header_writer is not None:
+                self._emit_headers(header_writer, exc.headers.items(), exc.geturl())
+            if writer is not None:
+                writer.write(exc.read())
+        except OSError as exc:  # pragma: no cover - network/runtime failure path
+            raise error(str(exc)) from exc
+
+    def getinfo(self, info: int) -> Any:
+        if info == RESPONSE_CODE:
+            return self._response_code
+        return None
+
+    def close(self) -> None:
+        self._options.clear()
+
+    @staticmethod
+    def _build_headers(raw_headers: Optional[Iterable[str]]) -> Dict[str, str]:
+        headers: Dict[str, str] = {}
+        if raw_headers is None:
+            return headers
+        for header in raw_headers:
+            if ":" not in header:
+                continue
+            name, value = header.split(":", 1)
+            headers[name.strip()] = value.strip()
+        return headers
+
+    @staticmethod
+    def _emit_headers(callback: Any, headers: Iterable[tuple[str, str]], url: str) -> None:
+        callback(f"HTTP/1.1 200 OK\r\n".encode("iso-8859-1"))
+        for name, value in headers:
+            callback(f"{name}: {value}\r\n".encode("iso-8859-1"))
+        if url:
+            callback(b"\r\n")
+
