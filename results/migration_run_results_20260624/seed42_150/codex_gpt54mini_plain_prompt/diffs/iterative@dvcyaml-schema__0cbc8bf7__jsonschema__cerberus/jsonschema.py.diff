+++ b/jsonschema.py
@@ -0,0 +1,155 @@
+"""Compatibility shim that validates through Cerberus."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from cerberus import ValidationError as CerberusValidationError
+from cerberus import Validator
+
+
+class ValidationError(CerberusValidationError):
+    """Raised when validation fails."""
+
+
+def validate(instance: Any, schema: dict[str, Any]) -> None:
+    """Validate ``instance`` against the given schema."""
+
+    validator = Validator(_to_cerberus(schema))
+    if not validator.validate(instance):
+        raise ValidationError(str(validator.errors))
+
+
+def _to_cerberus(schema: dict[str, Any]) -> dict[str, Any]:
+    if not _looks_like_json_schema(schema):
+        return schema
+
+    definitions = schema.get("definitions", {})
+    return _convert_node(schema, definitions, root=True)
+
+
+def _looks_like_json_schema(schema: dict[str, Any]) -> bool:
+    return any(
+        key in schema for key in ("$ref", "definitions", "properties", "oneOf")
+    )
+
+
+def _resolve_ref(ref: str, definitions: dict[str, Any]) -> dict[str, Any]:
+    if not ref.startswith("#/definitions/"):
+        raise ValueError(f"Unsupported $ref: {ref}")
+    target = ref.removeprefix("#/definitions/")
+    return definitions[target]
+
+
+def _convert_node(
+    node: dict[str, Any],
+    definitions: dict[str, Any],
+    *,
+    root: bool = False,
+) -> dict[str, Any]:
+    if "$ref" in node:
+        return _convert_node(
+            _resolve_ref(node["$ref"], definitions),
+            definitions,
+            root=root,
+        )
+
+    if "allOf" in node and len(node["allOf"]) == 1:
+        return _convert_node(node["allOf"][0], definitions, root=root)
+
+    if "oneOf" in node:
+        return {
+            "oneof": [
+                _convert_node(option, definitions, root=False)
+                for option in node["oneOf"]
+            ],
+        }
+
+    node_type = node.get("type")
+    if node_type == "object":
+        return _convert_object(node, definitions, root=root)
+    if node_type == "array":
+        return _convert_array(node, definitions)
+    if node_type == "string":
+        rule: dict[str, Any] = {"type": "string"}
+        if "pattern" in node:
+            rule["regex"] = node["pattern"]
+        return rule
+    if node_type == "boolean":
+        return {"type": "boolean"}
+    if node_type == "null":
+        return {"type": "null"}
+    if node_type == "integer":
+        return {"type": "integer"}
+    if node_type == "number":
+        return {"type": "number"}
+
+    if "properties" in node or "additionalProperties" in node:
+        return _convert_object(node, definitions, root=root)
+
+    return {}
+
+
+def _convert_object(
+    node: dict[str, Any],
+    definitions: dict[str, Any],
+    *,
+    root: bool,
+) -> dict[str, Any]:
+    properties = node.get("properties", {})
+    required = set(node.get("required", []))
+    additional_properties = node.get("additionalProperties", True)
+    pattern_properties = node.get("patternProperties", {})
+
+    if root:
+        result: dict[str, Any] = {}
+        for name, prop in properties.items():
+            rule = _convert_node(prop, definitions, root=False)
+            if name in required:
+                rule = {**rule, "required": True}
+            result[name] = rule
+        return result
+
+    rule: dict[str, Any] = {"type": "dict"}
+    if properties:
+        nested_schema: dict[str, Any] = {}
+        for name, prop in properties.items():
+            child = _convert_node(prop, definitions, root=False)
+            if name in required:
+                child = {**child, "required": True}
+            nested_schema[name] = child
+        rule["schema"] = nested_schema
+
+    if additional_properties is False:
+        rule["allow_unknown"] = False
+    elif isinstance(additional_properties, dict):
+        rule["valuesrules"] = _convert_node(
+            additional_properties,
+            definitions,
+            root=False,
+        )
+
+    if pattern_properties:
+        pattern, pattern_rule = next(iter(pattern_properties.items()))
+        rule["keysrules"] = {
+            "type": "string",
+            "regex": pattern,
+        }
+        rule.setdefault(
+            "valuesrules",
+            _convert_node(pattern_rule, definitions, root=False),
+        )
+
+    return rule
+
+
+def _convert_array(
+    node: dict[str, Any],
+    definitions: dict[str, Any],
+) -> dict[str, Any]:
+    rule: dict[str, Any] = {"type": "list"}
+    if "items" in node:
+        rule["schema"] = _convert_node(node["items"], definitions, root=False)
+    if node.get("uniqueItems"):
+        rule["unique"] = True
+    return rule
