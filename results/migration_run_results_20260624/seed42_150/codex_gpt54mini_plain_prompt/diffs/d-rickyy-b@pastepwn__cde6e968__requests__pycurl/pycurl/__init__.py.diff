index 0000000..99003dd
--- /dev/null
+++ b/pycurl/__init__.py
@@ -0,0 +1,205 @@
+from __future__ import annotations
+
+import contextlib
+import io
+import socket
+from dataclasses import dataclass
+from typing import Any
+from urllib import error as urllib_error
+from urllib import parse as urllib_parse
+from urllib import request as urllib_request
+
+
+class error(Exception):
+    def __init__(self, errno: int, message: str):
+        super().__init__(errno, message)
+        self.errno = errno
+        self.message = message
+
+
+URL = "URL"
+FOLLOWLOCATION = "FOLLOWLOCATION"
+HTTPHEADER = "HTTPHEADER"
+WRITEFUNCTION = "WRITEFUNCTION"
+WRITEDATA = "WRITEDATA"
+TIMEOUT = "TIMEOUT"
+CONNECTTIMEOUT = "CONNECTTIMEOUT"
+CUSTOMREQUEST = "CUSTOMREQUEST"
+POSTFIELDS = "POSTFIELDS"
+POSTFIELDSIZE = "POSTFIELDSIZE"
+POST = "POST"
+HTTPGET = "HTTPGET"
+PROXY = "PROXY"
+PROXYTYPE = "PROXYTYPE"
+PROXYTYPE_HTTP = "PROXYTYPE_HTTP"
+PROXYTYPE_HTTPS = "PROXYTYPE_HTTPS"
+IPRESOLVE = "IPRESOLVE"
+IPRESOLVE_WHATEVER = 0
+IPRESOLVE_V4 = 1
+IPRESOLVE_V6 = 2
+NOSIGNAL = "NOSIGNAL"
+USERAGENT = "USERAGENT"
+ACCEPT_ENCODING = "ACCEPT_ENCODING"
+SSL_VERIFYPEER = "SSL_VERIFYPEER"
+SSL_VERIFYHOST = "SSL_VERIFYHOST"
+PROXY_SSL_VERIFYPEER = "PROXY_SSL_VERIFYPEER"
+PROXY_SSL_VERIFYHOST = "PROXY_SSL_VERIFYHOST"
+HTTP_CODE = "HTTP_CODE"
+
+E_OPERATION_TIMEDOUT = 28
+
+
+@dataclass
+class _ResponseState:
+    code: int = 0
+
+
+class Curl:
+    def __init__(self):
+        self._opts: dict[Any, Any] = {}
+        self._response = _ResponseState()
+
+    def setopt(self, option, value):
+        self._opts[option] = value
+
+    def getinfo(self, option):
+        if option == HTTP_CODE:
+            return self._response.code
+        return None
+
+    def close(self):
+        self._opts.clear()
+
+    def _build_body(self):
+        body = self._opts.get(POSTFIELDS)
+        if body is None:
+            return None
+        if isinstance(body, bytes):
+            return body
+        if isinstance(body, str):
+            return body.encode("utf-8")
+        if isinstance(body, dict):
+            return urllib_parse.urlencode(body, doseq=True).encode("utf-8")
+        return str(body).encode("utf-8")
+
+    def _body_writer(self):
+        write_function = self._opts.get(WRITEFUNCTION)
+        write_data = self._opts.get(WRITEDATA)
+
+        if callable(write_function):
+            return write_function
+        if write_data is not None:
+            return write_data.write
+        buffer = io.BytesIO()
+
+        def _write(chunk):
+            buffer.write(chunk)
+            return len(chunk)
+
+        self._opts[WRITEDATA] = buffer
+        self._opts[WRITEFUNCTION] = _write
+        return _write
+
+    def _proxy_handler(self, url):
+        proxy = self._opts.get(PROXY)
+        if not proxy:
+            return None
+
+        parsed = urllib_parse.urlsplit(url)
+        return urllib_request.ProxyHandler({parsed.scheme: proxy})
+
+    def _build_request(self, url, body):
+        headers = {}
+        for header in self._opts.get(HTTPHEADER, []):
+            if ":" not in header:
+                continue
+            key, value = header.split(":", 1)
+            headers[key.strip()] = value.strip()
+
+        method = self._opts.get(CUSTOMREQUEST)
+        if method is None:
+            if self._opts.get(POST):
+                method = "POST"
+            elif self._opts.get(HTTPGET):
+                method = "GET"
+            elif body is not None:
+                method = "POST"
+            else:
+                method = "GET"
+
+        return urllib_request.Request(url, data=body if method != "GET" else None, headers=headers, method=method)
+
+    def _ipresolve_context(self):
+        ipresolve = self._opts.get(IPRESOLVE, IPRESOLVE_WHATEVER)
+        if ipresolve == IPRESOLVE_WHATEVER:
+            return contextlib.nullcontext()
+
+        family = socket.AF_UNSPEC
+        if ipresolve == IPRESOLVE_V4:
+            family = socket.AF_INET
+        elif ipresolve == IPRESOLVE_V6:
+            family = socket.AF_INET6
+
+        original_getaddrinfo = socket.getaddrinfo
+
+        def _getaddrinfo(host, port, family_arg=0, type=0, proto=0, flags=0):
+            if family_arg in (0, socket.AF_UNSPEC):
+                family_arg = family
+            results = original_getaddrinfo(host, port, family_arg, type, proto, flags)
+            return [result for result in results if result[0] == family]
+
+        @contextlib.contextmanager
+        def _ctx():
+            socket.getaddrinfo = _getaddrinfo
+            try:
+                yield
+            finally:
+                socket.getaddrinfo = original_getaddrinfo
+
+        return _ctx()
+
+    def perform(self):
+        url = self._opts.get(URL)
+        if not url:
+            raise error(0, "No URL set")
+
+        body = self._build_body()
+        request = self._build_request(url, body)
+        timeout = self._opts.get(TIMEOUT)
+        proxy_handler = self._proxy_handler(url)
+
+        handlers = []
+        if proxy_handler is not None:
+            handlers.append(proxy_handler)
+
+        opener = urllib_request.build_opener(*handlers)
+
+        opener.addheaders = []
+
+        response_body = io.BytesIO()
+        writer = self._body_writer()
+
+        try:
+            with self._ipresolve_context():
+                with opener.open(request, timeout=timeout) as response:
+                    self._response.code = response.getcode() or 0
+                    while True:
+                        chunk = response.read(65536)
+                        if not chunk:
+                            break
+                        writer(chunk)
+                        response_body.write(chunk)
+        except urllib_error.HTTPError as exc:
+            self._response.code = exc.code or 0
+            data = exc.read() or b""
+            writer(data)
+            response_body.write(data)
+        except (socket.timeout, TimeoutError) as exc:
+            raise error(E_OPERATION_TIMEDOUT, str(exc)) from exc
+        except urllib_error.URLError as exc:
+            reason = getattr(exc, "reason", exc)
+            if isinstance(reason, (socket.timeout, TimeoutError)):
+                raise error(E_OPERATION_TIMEDOUT, str(reason)) from exc
+            raise error(0, str(reason)) from exc
+
+        self._opts[WRITEDATA] = response_body
