+
+class _PycurlResponse(object):
+    def __init__(self, status_code, headers, content):
+        self.status_code = status_code
+        self.headers = headers
+        self.content = content
+        self.reason = HTTP_REASON_PHRASES.get(status_code, "")
+
+    def json(self):
+        return loads(self.content)
+
+
+class _PycurlSession(object):
+    def __init__(self, auth=None, headers=None):
+        self.auth = auth
+        self.headers = headers or {}
+
+    @staticmethod
+    def _encode_body(data, content_type):
+        if data is None:
+            return None
+        if isinstance(data, bytes):
+            return data
+        if isinstance(data, str):
+            return data.encode("utf-8")
+        if isinstance(data, dict):
+            if content_type and "application/x-www-form-urlencoded" in content_type:
+                return urlencode(data).encode("utf-8")
+            return dumps(data).encode("utf-8")
+        return dumps(data).encode("utf-8")
+
+    @staticmethod
+    def _normalize_headers(headers):
+        normalized = {}
+        for key, value in headers.items():
+            normalized[key] = value
+        return normalized
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        request_headers = self._normalize_headers(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        content_type = request_headers.get("Content-Type")
+        payload = self._encode_body(data, content_type)
+
+        if pycurl is None:
+            return self._request_with_http_client(method, url, payload, timeout, request_headers)
+
+        response_body = BytesIO()
+        response_headers = {}
+        status_code = 0
+
+        def _header_callback(line):
+            raw_length = len(line)
+            if not line:
+                return raw_length
+            if isinstance(line, bytes):
+                line = line.decode("iso-8859-1")
+            line = line.strip("\r\n")
+            if not line:
+                return raw_length
+            if line.startswith("HTTP/"):
+                parts = line.split(" ", 2)
+                if len(parts) > 1:
+                    try:
+                        nonlocal_status[0] = int(parts[1])
+                    except ValueError:
+                        pass
+                return raw_length
+            if ":" in line:
+                name, value = line.split(":", 1)
+                response_headers[name.strip()] = value.lstrip()
+            return raw_length
+
+        nonlocal_status = [status_code]
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url)
+            curl.setopt(pycurl.WRITEFUNCTION, response_body.write)
+            curl.setopt(pycurl.HEADERFUNCTION, _header_callback)
+            curl.setopt(pycurl.FOLLOWLOCATION, False)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            if timeout is not None:
+                curl.setopt(pycurl.TIMEOUT_MS, int(timeout * 1000))
+            if request_headers.get("Accept-Encoding"):
+                curl.setopt(pycurl.ACCEPT_ENCODING, "")
+            if request_headers:
+                curl.setopt(pycurl.HTTPHEADER, ["%s: %s" % (k, v) for k, v in request_headers.items()])
+            if self.auth:
+                user, password = self.auth
+                curl.setopt(pycurl.HTTPAUTH, pycurl.HTTPAUTH_BASIC)
+                curl.setopt(pycurl.USERPWD, "%s:%s" % (user, password))
+
+            method = method.upper()
+            if method == "GET":
+                curl.setopt(pycurl.HTTPGET, True)
+            elif method == "POST":
+                curl.setopt(pycurl.POST, True)
+            else:
+                curl.setopt(pycurl.CUSTOMREQUEST, method)
+
+            if payload is not None:
+                curl.setopt(pycurl.POSTFIELDS, payload)
+
+            curl.perform()
+            status_code = nonlocal_status[0] or curl.getinfo(pycurl.RESPONSE_CODE)
+        finally:
+            curl.close()
+
+        content = response_body.getvalue().decode("utf-8", errors="replace")
+        return _PycurlResponse(status_code, response_headers, content)
+
+    def _request_with_http_client(self, method, url, payload, timeout, request_headers):
+        parsed = urlsplit(url)
+        if parsed.scheme == "https":
+            connection = HTTPSConnection(parsed.hostname, parsed.port or 443, timeout=timeout,
+                                         context=ssl.create_default_context())
+        else:
+            connection = HTTPConnection(parsed.hostname, parsed.port or 80, timeout=timeout)
+
+        path = parsed.path or "/"
+        if parsed.query:
+            path += "?" + parsed.query
+
+        if payload is not None and "Content-Length" not in request_headers:
+            request_headers["Content-Length"] = str(len(payload))
+
+        if "Authorization" not in request_headers and getattr(self, "auth", None):
+            user, password = self.auth
+            token = base64.b64encode(("%s:%s" % (user, password)).encode("utf-8")).decode("ascii")
+            request_headers["Authorization"] = "Basic %s" % token
+
+        connection.request(method.upper(), path, body=payload, headers=request_headers)
+        response = connection.getresponse()
+        content = response.read()
+        if response.getheader("Content-Encoding") == "gzip":
+            try:
+                content = gzip.decompress(content)
+            except OSError:
+                pass
+        content = content.decode("utf-8", errors="replace")
+        headers = dict(response.getheaders())
+        connection.close()
+        return _PycurlResponse(response.status, headers, content)
+
