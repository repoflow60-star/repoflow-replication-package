index 0000000..88dc733
--- /dev/null
+++ b/aiohttp_swagger3/_cattrs.py
@@ -0,0 +1,18 @@
+from dataclasses import asdict, is_dataclass
+from typing import Any
+
+try:
+    import cattrs
+except ImportError:  # pragma: no cover - fallback for environments without the dependency installed yet.
+    cattrs = None
+
+
+_CONVERTER = cattrs.Converter() if cattrs is not None else None
+
+
+def unstructure(value: Any) -> Any:
+    if _CONVERTER is not None:
+        return _CONVERTER.unstructure(value)
+    if is_dataclass(value):
+        return asdict(value)
+    return value
