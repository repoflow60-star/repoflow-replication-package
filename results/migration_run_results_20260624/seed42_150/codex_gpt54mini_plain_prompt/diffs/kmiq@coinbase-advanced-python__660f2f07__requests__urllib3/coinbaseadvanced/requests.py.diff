+"""
+Lightweight requests-compatible wrapper built on top of urllib3.
+"""
+
+from __future__ import annotations
+
+import json as _json
+from typing import Any, Mapping, Optional
+
+import urllib3
+
+
+_POOL_MANAGER = urllib3.PoolManager()
+
+
+class Response:
+    """
+    Minimal response object compatible with the parts of requests.Response used here.
+    """
+
+    def __init__(self, raw_response: urllib3.response.BaseHTTPResponse, url: str) -> None:
+        self._raw_response = raw_response
+        self.url = url
+        self.status_code = raw_response.status
+        self.headers = dict(raw_response.headers)
+        self.reason = getattr(raw_response, "reason", "")
+
+        self._data = raw_response.data or b""
+        self.ok = 200 <= self.status_code < 400
+
+    @property
+    def content(self) -> bytes:
+        return self._data
+
+    @property
+    def text(self) -> str:
+        encoding = getattr(self._raw_response, "charset", None) or "utf-8"
+        return self._data.decode(encoding, errors="replace")
+
+    def json(self) -> Any:
+        return _json.loads(self.text)
+
+    def close(self) -> None:
+        self._raw_response.close()
+
+    def __enter__(self) -> "Response":
+        return self
+
+    def __exit__(self, exc_type, exc, tb) -> None:
+        self.close()
+
+
+def _prepare_body(
+    *,
+    json: Optional[Any] = None,
+    data: Optional[Any] = None,
+    body: Optional[Any] = None,
+    headers: Optional[Mapping[str, str]] = None,
+) -> tuple[Optional[bytes], dict[str, str]]:
+    request_headers = dict(headers or {})
+
+    if json is not None:
+        request_headers.setdefault("Content-Type", "application/json")
+        return _json.dumps(json).encode("utf-8"), request_headers
+
+    payload = body if body is not None else data
+    if payload is None:
+        return None, request_headers
+
+    if isinstance(payload, bytes):
+        return payload, request_headers
+
+    if isinstance(payload, str):
+        return payload.encode("utf-8"), request_headers
+
+    return _json.dumps(payload).encode("utf-8"), request_headers
+
+
+def request(
+    method: str,
+    url: str,
+    *,
+    headers: Optional[Mapping[str, str]] = None,
+    timeout: Optional[float] = None,
+    json: Optional[Any] = None,
+    data: Optional[Any] = None,
+    body: Optional[Any] = None,
+    **kwargs: Any,
+) -> Response:
+    request_body, request_headers = _prepare_body(
+        json=json,
+        data=data,
+        body=body,
+        headers=headers,
+    )
+
+    if timeout is not None:
+        kwargs["timeout"] = timeout
+
+    raw_response = _POOL_MANAGER.request(
+        method=method,
+        url=url,
+        body=request_body,
+        headers=request_headers,
+        **kwargs,
+    )
+    return Response(raw_response, url)
+
+
+def get(url: str, **kwargs: Any) -> Response:
+    return request("GET", url, **kwargs)
+
+
+def post(url: str, **kwargs: Any) -> Response:
+    return request("POST", url, **kwargs)
+
+
+def put(url: str, **kwargs: Any) -> Response:
+    return request("PUT", url, **kwargs)
+
+
+def delete(url: str, **kwargs: Any) -> Response:
+    return request("DELETE", url, **kwargs)
+
