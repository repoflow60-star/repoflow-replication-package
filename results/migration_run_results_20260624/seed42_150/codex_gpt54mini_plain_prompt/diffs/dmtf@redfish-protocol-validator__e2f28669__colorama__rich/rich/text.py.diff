+from redfish_protocol_validator.color_support import ansi_wrap
+
+
+class Text:
+    def __init__(self, text, style=None):
+        self.text = str(text)
+        self.style = style
+
+    def __str__(self):
+        return ansi_wrap(self.text, self.style)
