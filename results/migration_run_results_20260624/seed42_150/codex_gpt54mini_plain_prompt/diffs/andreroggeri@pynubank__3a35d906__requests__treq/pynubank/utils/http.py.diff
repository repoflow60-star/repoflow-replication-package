+import treq
+from twisted.internet import defer, reactor, threads
+
+from pynubank.exception import NuRequestException
+from pynubank.utils.response import HttpResponse
+
+_REACTOR_READY = Event()
+_REACTOR_STARTED = False
+
+
+def _ensure_reactor_running():
+    global _REACTOR_STARTED
+
+    if reactor.running or _REACTOR_STARTED:
+        return
+
+    _REACTOR_STARTED = True
+
+    def run():
+        reactor.callWhenRunning(_REACTOR_READY.set)
+        reactor.run(installSignalHandlers=False)
+
+    thread = Thread(target=run, name='pynubank-treq-reactor', daemon=True)
+    thread.start()
+    _REACTOR_READY.wait()
+
+
+def _headers_to_dict(headers):
+    if headers is None:
+        return {}
+
+    if hasattr(headers, 'getAllRawHeaders'):
+        flattened = {}
+        for name, values in headers.getAllRawHeaders():
+            key = name.decode('utf-8') if isinstance(name, bytes) else name
+            value = values[0] if values else ''
+            flattened[key] = value.decode('utf-8') if isinstance(value, bytes) else value
+        return flattened
+
+    return dict(headers)
+
+
+def _perform_request(method: str, url: str, headers: dict, body: bytes = None) -> HttpResponse:
+    _ensure_reactor_running()
+
+    def request():
+        if method == 'GET':
+            request_fn = getattr(treq, 'get', None)
+            deferred = request_fn(url, headers=headers) if request_fn else treq.request('GET', url, headers=headers)
+        else:
+            request_fn = getattr(treq, 'post', None)
+            deferred = request_fn(url, data=body, headers=headers) if request_fn else treq.request(
+                'POST', url, data=body, headers=headers)
+
+        def build_response(response):
+            def wrap(content):
+                status_code = getattr(response, 'code', getattr(response, 'status_code', None))
+                return HttpResponse(
+                    status_code=status_code,
+                    url=url,
+                    headers=_headers_to_dict(getattr(response, 'headers', None)),
+                    content=content,
+                )
+
+            content_fn = getattr(treq, 'content', None)
+            if content_fn is not None:
+                content_deferred = defer.maybeDeferred(content_fn, response)
+            else:
+                content_value = getattr(response, 'content', b'')
+                content_deferred = defer.maybeDeferred(content_value) if callable(content_value) else defer.succeed(
+                    content_value or b'')
+
+            return content_deferred.addCallback(wrap)
+
+        return deferred.addCallback(build_response)
+
+    return threads.blockingCallFromThread(reactor, request)
+
+
+def get(url: str, headers: dict = None, **kwargs) -> HttpResponse:
+    return _perform_request('GET', url, headers=headers or {})
+
+
+def post(url: str, json: dict, headers: dict = None, **kwargs) -> HttpResponse:
+    body = json_module.dumps(json or {}).encode('utf-8')
+    return _perform_request('POST', url, headers=headers or {}, body=body)
 
 
