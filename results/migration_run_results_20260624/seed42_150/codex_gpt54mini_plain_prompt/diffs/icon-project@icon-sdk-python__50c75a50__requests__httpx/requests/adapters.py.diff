+from __future__ import annotations
+
+from typing import Any
+
+from .cookies import RequestsCookieJar
+from .exceptions import ConnectionError
+from .models import Response
+
+try:
+    import httpx as _httpx
+except Exception:  # pragma: no cover - fallback for environments without httpx
+    _httpx = None
+
+
+class BaseAdapter:
+    def send(self, request, **kwargs):  # pragma: no cover - interface only
+        raise NotImplementedError
+
+    def close(self):
+        pass
+
+
+def _response_from_raw(request, raw) -> Response:
+    content = b''
+    headers = {}
+    reason = getattr(raw, 'reason', '')
+    status_code = getattr(raw, 'status', getattr(raw, 'status_code', 200))
+
+    if hasattr(raw, 'read'):
+        content = raw.read()
+    elif hasattr(raw, 'data') and raw.data is not None:
+        content = raw.data
+    elif hasattr(raw, 'body') and raw.body is not None:
+        body = raw.body
+        content = body.read() if hasattr(body, 'read') else body
+
+    if hasattr(raw, 'headers') and raw.headers is not None:
+        headers = dict(raw.headers.items()) if hasattr(raw.headers, 'items') else dict(raw.headers)
+
+    response = Response(status_code=status_code, headers=headers, content=content, reason=reason, url=getattr(request, 'url', ''), request=request)
+    response.cookies = RequestsCookieJar()
+    return response
+
+
+class HTTPAdapter(BaseAdapter):
+    def send(self, request, **kwargs):
+        if _httpx is None:
+            return self._send_with_urllib(request, **kwargs)
+
+        timeout = kwargs.get('timeout', 10)
+        verify = kwargs.get('verify', True)
+        follow_redirects = kwargs.get('allow_redirects', True)
+        headers = dict(getattr(request, 'headers', {}))
+        content = getattr(request, 'body', None)
+
+        try:
+            with _httpx.Client(verify=verify, timeout=timeout, follow_redirects=follow_redirects, headers=headers) as client:
+                raw = client.request(request.method, request.url, content=content)
+        except Exception as exc:  # pragma: no cover - network failure path
+            raise ConnectionError(str(exc)) from exc
+
+        response = Response(
+            status_code=raw.status_code,
+            headers=dict(raw.headers),
+            content=raw.content,
+            reason=raw.reason_phrase,
+            url=str(raw.url),
+            request=request,
+        )
+        response.encoding = raw.encoding
+        response.cookies = RequestsCookieJar()
+        return response
+
+    def build_response(self, request, raw):
+        return _response_from_raw(request, raw)
+
+    def _send_with_urllib(self, request, **kwargs):  # pragma: no cover - fallback only
+        import urllib.request
+
+        req = urllib.request.Request(request.url, data=request.body if isinstance(request.body, (bytes, bytearray)) else (request.body.encode('utf-8') if isinstance(request.body, str) else None), method=request.method)
+        for key, value in getattr(request, 'headers', {}).items():
+            req.add_header(key, value)
+        timeout = kwargs.get('timeout', 10)
+        try:
+            with urllib.request.urlopen(req, timeout=timeout) as raw:
+                content = raw.read()
+                headers = dict(raw.headers.items())
+                response = Response(status_code=getattr(raw, 'status', 200), headers=headers, content=content, reason=getattr(raw, 'reason', ''), url=request.url, request=request)
+                response.cookies = RequestsCookieJar()
+                return response
+        except Exception as exc:
+            raise ConnectionError(str(exc)) from exc
