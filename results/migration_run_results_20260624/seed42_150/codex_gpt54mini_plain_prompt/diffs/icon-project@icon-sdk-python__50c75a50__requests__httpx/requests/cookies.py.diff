+from __future__ import annotations
+
+from http.cookiejar import Cookie, CookieJar
+
+
+class RequestsCookieJar(CookieJar):
+    def extract_cookies(self, response, request):  # pragma: no cover - not used in tests
+        return None
+
+    def set_cookie(self, cookie):
+        super().set_cookie(cookie)
+
+    def get_dict(self):
+        result = {}
+        for cookie in self:
+            result[cookie.name] = cookie.value
+        return result
+
+
+def _make_cookie(name, value, domain='', path='/'):
+    return Cookie(
+        version=0,
+        name=name,
+        value=value,
+        port=None,
+        port_specified=False,
+        domain=domain,
+        domain_specified=bool(domain),
+        domain_initial_dot=domain.startswith('.'),
+        path=path,
+        path_specified=True,
+        secure=False,
+        expires=None,
+        discard=True,
+        comment=None,
+        comment_url=None,
+        rest={},
+        rfc2109=False,
+    )
+
+
+def cookiejar_from_dict(cookie_dict, jar=None):
+    jar = jar or RequestsCookieJar()
+    for key, value in (cookie_dict or {}).items():
+        jar.set_cookie(_make_cookie(key, value))
+    return jar
+
+
+def merge_cookies(cookiejar, cookies):
+    if not cookies:
+        return cookiejar
+    if isinstance(cookies, dict):
+        cookies = cookiejar_from_dict(cookies)
+    for cookie in cookies:
+        cookiejar.set_cookie(cookie)
+    return cookiejar
+
+
+class MockRequest:
+    def __init__(self, request):
+        self._request = request
+
+    def get_full_url(self):
+        return self._request.url
+
+    def get_host(self):
+        return self._request.url.split('://', 1)[-1].split('/', 1)[0]
+
+    def get_type(self):
+        return self._request.url.split('://', 1)[0]
+
+    def has_header(self, name):
+        return name in getattr(self._request, 'headers', {})
+
+    def get_header(self, name, default=None):
+        return getattr(self._request, 'headers', {}).get(name, default)
+
+    def header_items(self):
+        return list(getattr(self._request, 'headers', {}).items())
+
+
+class MockResponse:
+    def __init__(self, response):
+        self._response = response
+
+    def info(self):
+        return self
+
+    def get_all(self, name, default=None):
+        headers = getattr(self._response, 'headers', {})
+        if name in headers:
+            return [headers[name]]
+        return default
+
+    def getheaders(self, name):
+        return self.get_all(name, [])
