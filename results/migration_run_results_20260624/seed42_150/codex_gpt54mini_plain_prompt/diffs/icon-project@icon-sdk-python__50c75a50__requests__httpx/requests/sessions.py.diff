+from __future__ import annotations
+
+from typing import Dict
+
+from .adapters import HTTPAdapter
+from .models import Request
+
+
+class Session:
+    def __init__(self):
+        self.headers: Dict[str, str] = {}
+        self.adapters = {'http://': HTTPAdapter(), 'https://': HTTPAdapter()}
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        self.close()
+        return False
+
+    def mount(self, prefix, adapter):
+        self.adapters[prefix] = adapter
+
+    def get_adapter(self, url):
+        for prefix in sorted(self.adapters, key=len, reverse=True):
+            if url.startswith(prefix):
+                return self.adapters[prefix]
+        return self.adapters['http://']
+
+    def request(self, method, url, **kwargs):
+        headers = dict(self.headers)
+        headers.update(kwargs.pop('headers', {}) or {})
+        request = Request(method=method, url=url, headers=headers, data=kwargs.pop('data', None), json=kwargs.pop('json', None), params=kwargs.pop('params', None)).prepare()
+        return self.send(request, **kwargs)
+
+    def send(self, request, **kwargs):
+        adapter = self.get_adapter(request.url)
+        return adapter.send(request, **kwargs)
+
+    def post(self, url, **kwargs):
+        return self.request('POST', url, **kwargs)
+
+    def get(self, url, **kwargs):
+        return self.request('GET', url, **kwargs)
+
+    def close(self):
+        for adapter in self.adapters.values():
+            close = getattr(adapter, 'close', None)
+            if callable(close):
+                close()
