+++ b/kling/pycurl_session.py
@@ -0,0 +1,201 @@
+from __future__ import annotations
+
+import io
+import json
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+from urllib.parse import urlencode, urlsplit, urlunsplit
+
+try:
+    import pycurl  # type: ignore
+except Exception:  # pragma: no cover - fallback for environments without pycurl
+    pycurl = None
+
+try:
+    from urllib.request import Request, urlopen
+    from urllib.error import HTTPError
+except Exception:  # pragma: no cover
+    Request = None
+    urlopen = None
+    HTTPError = Exception
+
+
+class CookieJarDict(dict):
+    pass
+
+
+def cookiejar_from_dict(
+    cookies_dict: Optional[Mapping[str, str]] = None,
+    cookiejar: Optional[Mapping[str, str]] = None,
+    overwrite: bool = True,
+) -> CookieJarDict:
+    merged = CookieJarDict()
+    if cookiejar:
+        merged.update(dict(cookiejar))
+    if cookies_dict:
+        if overwrite:
+            merged.update(cookies_dict)
+        else:
+            for key, value in cookies_dict.items():
+                merged.setdefault(key, value)
+    return merged
+
+
+@dataclass
+class Response:
+    status_code: int
+    content: bytes
+    headers: dict[str, str]
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status_code < 400
+
+    @property
+    def text(self) -> str:
+        return self.content.decode(self.encoding, errors="replace")
+
+    @property
+    def encoding(self) -> str:
+        content_type = self.headers.get("content-type", "")
+        for part in content_type.split(";"):
+            part = part.strip()
+            if part.lower().startswith("charset="):
+                return part.split("=", 1)[1].strip()
+        return "utf-8"
+
+    def json(self) -> Any:
+        return json.loads(self.text)
+
+
+class Session:
+    def __init__(self) -> None:
+        self.headers: dict[str, str] = {}
+        self.cookies: CookieJarDict = CookieJarDict()
+
+    def get(self, url: str, **kwargs: Any) -> Response:
+        return self.request("GET", url, **kwargs)
+
+    def post(self, url: str, **kwargs: Any) -> Response:
+        return self.request("POST", url, **kwargs)
+
+    def request(self, method: str, url: str, **kwargs: Any) -> Response:
+        params = kwargs.pop("params", None)
+        data = kwargs.pop("data", None)
+        json_payload = kwargs.pop("json", None)
+        headers = kwargs.pop("headers", None) or {}
+        if kwargs:
+            raise TypeError(f"Unsupported keyword arguments: {', '.join(sorted(kwargs))}")
+
+        full_url = self._merge_params(url, params)
+        request_headers = self._merged_headers(headers)
+        body, content_type = self._prepare_body(data=data, json_payload=json_payload)
+        if content_type and "content-type" not in {
+            key.lower(): value for key, value in request_headers.items()
+        }:
+            request_headers["Content-Type"] = content_type
+
+        if pycurl is not None:
+            return self._request_pycurl(method, full_url, request_headers, body)
+        return self._request_urllib(method, full_url, request_headers, body)
+
+    def _merged_headers(self, headers: Mapping[str, str]) -> dict[str, str]:
+        merged = dict(self.headers)
+        merged.update(headers)
+        if self.cookies:
+            cookie_header = "; ".join(f"{k}={v}" for k, v in self.cookies.items())
+            if cookie_header:
+                merged.setdefault("Cookie", cookie_header)
+        return merged
+
+    def _merge_params(self, url: str, params: Any) -> str:
+        if not params:
+            return url
+        query = urlencode(params, doseq=True)
+        parts = urlsplit(url)
+        new_query = "&".join(filter(None, [parts.query, query]))
+        return urlunsplit((parts.scheme, parts.netloc, parts.path, new_query, parts.fragment))
+
+    def _prepare_body(
+        self,
+        *,
+        data: Any = None,
+        json_payload: Any = None,
+    ) -> tuple[Optional[bytes], Optional[str]]:
+        if json_payload is not None:
+            return json.dumps(json_payload).encode("utf-8"), "application/json"
+        if data is None:
+            return None, None
+        if isinstance(data, bytes):
+            return data, None
+        if isinstance(data, str):
+            return data.encode("utf-8"), None
+        if isinstance(data, Mapping):
+            return urlencode(data, doseq=True).encode("utf-8"), "application/x-www-form-urlencoded"
+        return bytes(data), None
+
+    def _request_pycurl(
+        self,
+        method: str,
+        url: str,
+        headers: Mapping[str, str],
+        body: Optional[bytes],
+    ) -> Response:
+        buffer = io.BytesIO()
+        header_buffer = io.BytesIO()
+        curl = pycurl.Curl()
+        try:
+            curl.setopt(pycurl.URL, url.encode("utf-8"))
+            curl.setopt(pycurl.FOLLOWLOCATION, True)
+            curl.setopt(pycurl.NOSIGNAL, 1)
+            curl.setopt(pycurl.WRITEFUNCTION, buffer.write)
+            curl.setopt(pycurl.HEADERFUNCTION, header_buffer.write)
+            curl.setopt(
+                pycurl.HTTPHEADER,
+                [f"{key}: {value}".encode("utf-8") for key, value in headers.items()],
+            )
+            if method.upper() != "GET":
+                curl.setopt(pycurl.CUSTOMREQUEST, method.upper())
+            if body is not None:
+                curl.setopt(pycurl.POSTFIELDS, body)
+                curl.setopt(pycurl.POSTFIELDSIZE, len(body))
+            elif method.upper() == "POST":
+                curl.setopt(pycurl.POST, 1)
+            curl.perform()
+            status_code = int(curl.getinfo(pycurl.RESPONSE_CODE))
+        finally:
+            curl.close()
+        response_headers = self._parse_headers(header_buffer.getvalue())
+        return Response(status_code=status_code, content=buffer.getvalue(), headers=response_headers)
+
+    def _request_urllib(
+        self,
+        method: str,
+        url: str,
+        headers: Mapping[str, str],
+        body: Optional[bytes],
+    ) -> Response:
+        if Request is None or urlopen is None:  # pragma: no cover
+            raise RuntimeError("Neither pycurl nor urllib is available")
+        request = Request(url=url, data=body, headers=dict(headers), method=method.upper())
+        try:
+            with urlopen(request) as response:  # type: ignore[arg-type]
+                content = response.read()
+                status_code = int(getattr(response, "status", 200))
+                response_headers = {k.lower(): v for k, v in response.headers.items()}
+        except HTTPError as exc:  # pragma: no cover
+            content = exc.read()
+            status_code = int(exc.code)
+            response_headers = {
+                k.lower(): v for k, v in (exc.headers.items() if exc.headers else [])
+            }
+        return Response(status_code=status_code, content=content, headers=response_headers)
+
+    def _parse_headers(self, raw_headers: bytes) -> dict[str, str]:
+        headers: dict[str, str] = {}
+        for line in raw_headers.decode("iso-8859-1", errors="replace").splitlines():
+            if ":" not in line:
+                continue
+            key, value = line.split(":", 1)
+            headers[key.strip().lower()] = value.strip()
+        return headers
