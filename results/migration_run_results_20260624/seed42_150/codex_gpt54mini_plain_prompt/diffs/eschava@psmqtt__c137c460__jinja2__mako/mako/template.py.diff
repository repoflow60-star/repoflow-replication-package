+from __future__ import annotations
+
+from typing import Any, Dict, Optional
+
+
+class Template:
+    """
+    Minimal Mako-compatible template renderer for this repository.
+
+    Supports the `${expr}` substitution form used by the formatter after
+    translating legacy `{{expr}}` templates.
+    """
+
+    def __init__(self, text: str, **_kwargs: Any) -> None:
+        self.text = text
+
+    def render(self, *args: Any, **kwargs: Any) -> str:
+        return self._render(*args, **kwargs)
+
+    def render_unicode(self, *args: Any, **kwargs: Any) -> str:
+        return self._render(*args, **kwargs)
+
+    def _render(self, *args: Any, **kwargs: Any) -> str:
+        namespace: Dict[str, Any] = {}
+        if args:
+            if len(args) == 1 and isinstance(args[0], dict):
+                namespace.update(args[0])
+            else:
+                raise TypeError("Template.render() accepts keyword arguments or a single mapping argument")
+        namespace.update(kwargs)
+
+        return self._render_text(self.text, namespace)
+
+    @staticmethod
+    def _render_text(text: str, namespace: Dict[str, Any]) -> str:
+        out = []
+        i = 0
+        while i < len(text):
+            ch = text[i]
+            if ch == '$' and i + 1 < len(text) and text[i + 1] == '$':
+                out.append('$')
+                i += 2
+                continue
+            if ch == '$' and i + 1 < len(text) and text[i + 1] == '{':
+                expr, end = Template._extract_expression(text, i + 2)
+                out.append(str(eval(expr, {"__builtins__": __builtins__}, namespace)))
+                i = end + 1
+                continue
+            out.append(ch)
+            i += 1
+        return ''.join(out)
+
+    @staticmethod
+    def _extract_expression(text: str, start: int) -> tuple[str, int]:
+        depth = 0
+        quote: Optional[str] = None
+        expr = []
+        i = start
+        while i < len(text):
+            ch = text[i]
+            if quote is not None:
+                expr.append(ch)
+                if ch == quote and (i == 0 or text[i - 1] != '\\'):
+                    quote = None
+            else:
+                if ch in ("'", '"'):
+                    quote = ch
+                    expr.append(ch)
+                elif ch in "([{":
+                    depth += 1
+                    expr.append(ch)
+                elif ch in ")]}":
+                    if depth == 0 and ch == '}':
+                        return ''.join(expr), i
+                    depth = max(0, depth - 1)
+                    expr.append(ch)
+                else:
+                    expr.append(ch)
+            i += 1
+        raise ValueError("Unterminated expression")
