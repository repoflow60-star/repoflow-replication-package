+    @staticmethod
+    def _split_filters(expr: str) -> List[str]:
+        parts: List[str] = []
+        start = 0
+        depth = 0
+        quote: Optional[str] = None
+
+        for i, ch in enumerate(expr):
+            if quote is not None:
+                if ch == quote and (i == 0 or expr[i - 1] != '\\'):
+                    quote = None
+                continue
+
+            if ch in ("'", '"'):
+                quote = ch
+            elif ch in "([{":
+                depth += 1
+            elif ch in ")]}":
+                depth = max(0, depth - 1)
+            elif ch == '|' and depth == 0:
+                parts.append(expr[start:i].strip())
+                start = i + 1
+
+        parts.append(expr[start:].strip())
+        return parts
+
+    @classmethod
+    def _jinja_expr_to_mako(cls, expr: str) -> str:
+        parts = cls._split_filters(expr)
+        result = parts[0]
+
+        for filter_expr in parts[1:]:
+            if not filter_expr:
+                continue
+            match = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)\s*(?:\((.*)\))?$", filter_expr)
+            if match is None:
+                raise Exception(f"Unsupported filter syntax: {filter_expr}")
+
+            filter_name = match.group(1)
+            filter_args = match.group(2)
+            if filter_args is None or filter_args.strip() == '':
+                result = f"{filter_name}({result})"
+            else:
+                result = f"{filter_name}({result}, {filter_args.strip()})"
+
+        return result
+
+    @classmethod
+    def _to_mako_template(cls, template: str) -> str:
+        def replace(match: re.Match[str]) -> str:
+            expr = match.group(1).strip()
+            return "${" + cls._jinja_expr_to_mako(expr) + "}"
+
+        return re.sub(r"\{\{\s*(.*?)\s*\}\}", replace, template, flags=re.DOTALL)
+
