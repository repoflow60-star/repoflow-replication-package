+from concurrent.futures import ThreadPoolExecutor
+
+import requests
+
+
+class FuturesSession(requests.Session):
+    """Minimal requests_futures-compatible session wrapper."""
+
+    def __init__(self, executor=None, max_workers=8, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.executor = executor or ThreadPoolExecutor(max_workers=max_workers)
+
+    def request(self, method, url, *args, **kwargs):
+        return self.executor.submit(requests.Session.request, self, method, url, *args, **kwargs)
+
+    def close(self):
+        try:
+            self.executor.shutdown(wait=False)
+        finally:
+            return super().close()
