+"""Small local stand-in for :mod:`pycurl` built on top of urllib.
+
+Only the constants and methods required by this repository are implemented.
+"""
+
+from urllib.error import HTTPError, URLError
+from urllib.request import ProxyHandler, Request as UrlRequest, build_opener
+
+
+URL = 'URL'
+HTTPHEADER = 'HTTPHEADER'
+POST = 'POST'
+POSTFIELDS = 'POSTFIELDS'
+CUSTOMREQUEST = 'CUSTOMREQUEST'
+TIMEOUT = 'TIMEOUT'
+PROXY = 'PROXY'
+PROXYUSERPWD = 'PROXYUSERPWD'
+HTTP_CODE = 'HTTP_CODE'
+version = 'pycurl-shim/1.0'
+
+
+class error(Exception):
+    pass
+
+
+class Curl:
+    def __init__(self):
+        self._options = {}
+        self.body = ''
+        self.headers = {}
+        self.status_code = 0
+
+    def setopt(self, option, value):
+        self._options[option] = value
+
+    def perform(self):
+        url = self._options.get(URL)
+        if not url:
+            raise error('URL option is required')
+
+        method = self._options.get(CUSTOMREQUEST)
+        if not method:
+            method = 'POST' if self._options.get(POST) or self._options.get(POSTFIELDS) is not None else 'GET'
+
+        data = self._options.get(POSTFIELDS)
+        if isinstance(data, str):
+            data = data.encode('utf-8')
+
+        request = UrlRequest(url, data=data if method not in ('GET', 'HEAD') else None, method=method)
+        for header in self._options.get(HTTPHEADER, []) or []:
+            if ':' in header:
+                key, value = header.split(':', 1)
+                request.add_header(key.strip(), value.strip())
+
+        opener = build_opener()
+        proxy = self._options.get(PROXY)
+        if proxy:
+            opener = build_opener(ProxyHandler({
+                'http': proxy,
+                'https': proxy,
+            }))
+
+        timeout = self._options.get(TIMEOUT)
+
+        try:
+            with opener.open(request, timeout=timeout) as response:
+                self.status_code = getattr(response, 'status', response.getcode())
+                self.body = response.read().decode('utf-8')
+                self.headers = dict(response.headers.items())
+        except HTTPError as exc:
+            self.status_code = exc.code
+            self.body = exc.read().decode('utf-8', errors='replace')
+            self.headers = dict(exc.headers.items()) if exc.headers else {}
+        except URLError as exc:
+            raise error(str(exc))
+
+    def getinfo(self, option):
+        if option == HTTP_CODE:
+            return self.status_code
+        raise error('Unsupported getinfo option: {}'.format(option))
+
+    def close(self):
+        return None
