+"""Compatibility layer for the subset of ``requests`` used by this SDK.
+
+The implementation delegates HTTP work to :mod:`pycurl`, which keeps the
+transport dependency aligned with the migration away from the external
+``requests`` package while preserving the small API surface the tests expect.
+"""
+
+from collections import OrderedDict
+from copy import copy
+from urllib.parse import urlencode, urlsplit, urlunsplit
+
+import pycurl
+
+
+class Request:
+    def __init__(self, url=None, params=None, headers=None, data=None, method=None):
+        self.url = url
+        self.params = params or OrderedDict()
+        self.headers = headers or {}
+        self.data = data
+        self.method = method or 'GET'
+
+    @property
+    def body(self):
+        return self.data
+
+
+class Response:
+    def __init__(self, text, status_code, headers=None, url=None):
+        self.text = text
+        self.status_code = status_code
+        self.headers = headers or {}
+        self.url = url
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        return False
+
+    def json(self):
+        return self.text
+
+
+class Session:
+    def prepare_request(self, request):
+        prepared = copy(request)
+        prepared.url = _append_params(request.url, request.params)
+        return prepared
+
+    def merge_environment_settings(self, url, proxies, stream, verify, cert):
+        return {
+            'proxies': proxies or {},
+            'stream': stream,
+            'verify': verify,
+            'cert': cert,
+        }
+
+    def send(self, request, timeout=None, **kwargs):
+        transport = pycurl.Curl()
+        transport.setopt(pycurl.URL, request.url)
+        transport.setopt(pycurl.TIMEOUT, timeout)
+
+        headers = _build_header_list(request.headers)
+        if headers:
+            transport.setopt(pycurl.HTTPHEADER, headers)
+
+        if request.method:
+            transport.setopt(pycurl.CUSTOMREQUEST, request.method)
+
+        if request.method and request.method.upper() == 'POST' and request.data is not None:
+            transport.setopt(pycurl.POST, True)
+            transport.setopt(pycurl.POSTFIELDS, request.data)
+        elif request.data is not None and request.method and request.method.upper() not in ('GET', 'HEAD'):
+            transport.setopt(pycurl.POSTFIELDS, request.data)
+
+        proxies = kwargs.get('proxies') or {}
+        _configure_proxy(transport, request.url, proxies)
+
+        transport.perform()
+
+        return Response(
+            transport.body,
+            transport.status_code,
+            transport.headers,
+            request.url,
+        )
+
+
+def _append_params(url, params):
+    if not params:
+        return url
+
+    parsed = urlsplit(url)
+    query = parsed.query
+    params_string = urlencode(list(params.items()), doseq=True)
+
+    if query:
+        query = query + '&' + params_string
+    else:
+        query = params_string
+
+    return urlunsplit((parsed.scheme, parsed.netloc, parsed.path, query, parsed.fragment))
+
+
+def _build_header_list(headers):
+    header_items = headers.items() if headers is not None else []
+    return ['{}: {}'.format(key, value) for key, value in header_items]
+
+
+def _configure_proxy(transport, url, proxies):
+    scheme = urlsplit(url).scheme
+    proxy = proxies.get(scheme) or proxies.get('http') or proxies.get('https')
+    if not proxy:
+        return
+
+    transport.setopt(pycurl.PROXY, proxy)
+    if '@' in proxy:
+        credentials = proxy.split('://', 1)[-1].split('@', 1)[0]
+        transport.setopt(pycurl.PROXYUSERPWD, credentials)
+
