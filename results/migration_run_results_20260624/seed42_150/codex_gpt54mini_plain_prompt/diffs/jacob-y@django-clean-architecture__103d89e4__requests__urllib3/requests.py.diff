index 0000000..c1a1ded
--- /dev/null
+++ b/requests.py
@@ -0,0 +1,96 @@
+from __future__ import annotations
+
+import base64
+import json as json_module
+from dataclasses import dataclass
+from typing import Any
+import sys
+import types
+from urllib.parse import urlencode
+
+import urllib3
+from urllib3.exceptions import HTTPError
+
+
+class RequestException(Exception):
+    """Compatibility exception matching the bits of requests we rely on."""
+
+
+@dataclass
+class Response:
+    status_code: int
+    url: str
+    _body: bytes
+    headers: dict[str, str] | None = None
+
+    def json(self) -> Any:
+        if not self._body:
+            return None
+        return json_module.loads(self._body.decode("utf-8"))
+
+    @property
+    def text(self) -> str:
+        return self._body.decode("utf-8")
+
+
+exceptions = types.ModuleType("requests.exceptions")
+exceptions.RequestException = RequestException
+sys.modules.setdefault("requests.exceptions", exceptions)
+_pool_manager = urllib3.PoolManager()
+
+
+def _apply_auth(headers: dict[str, str], auth: tuple[str, str] | None) -> dict[str, str]:
+    if not auth:
+        return headers
+
+    username, password = auth
+    token = base64.b64encode(f"{username}:{password}".encode("utf-8")).decode("ascii")
+    headers["Authorization"] = f"Basic {token}"
+    return headers
+
+
+def _prepare_headers(headers: dict[str, str] | None, auth: tuple[str, str] | None) -> dict[str, str]:
+    prepared_headers = dict(headers or {})
+    return _apply_auth(prepared_headers, auth)
+
+
+def _encode_data(data: Any) -> bytes | None:
+    if data is None:
+        return None
+    if isinstance(data, bytes):
+        return data
+    if isinstance(data, str):
+        return data.encode("utf-8")
+    if isinstance(data, dict):
+        return urlencode(data).encode("utf-8")
+    return str(data).encode("utf-8")
+
+
+def _request(method: str, url: str, *, headers: dict[str, str] | None = None, auth: tuple[str, str] | None = None,
+             body: bytes | None = None) -> Response:
+    try:
+        response = _pool_manager.request(method, url, headers=_prepare_headers(headers, auth), body=body)
+    except HTTPError as exc:
+        raise RequestException(str(exc)) from exc
+
+    response_headers = {key: value for key, value in response.headers.items()}
+    return Response(status_code=response.status, url=url, _body=response.data or b"", headers=response_headers)
+
+
+def get(url: str, *, headers: dict[str, str] | None = None, auth: tuple[str, str] | None = None) -> Response:
+    return _request("GET", url, headers=headers, auth=auth)
+
+
+def post(url: str, *, data: Any = None, json: Any = None, headers: dict[str, str] | None = None,
+         auth: tuple[str, str] | None = None) -> Response:
+    request_headers = dict(headers or {})
+
+    if json is not None:
+        request_headers.setdefault("Content-Type", "application/json")
+        body = json_module.dumps(json).encode("utf-8")
+    else:
+        body = _encode_data(data)
+        if isinstance(data, dict):
+            request_headers.setdefault("Content-Type", "application/x-www-form-urlencoded")
+
+    return _request("POST", url, headers=request_headers, auth=auth, body=body)
