+def _legacy_bytecode(codeobject):
+    legacy = []
+    offset = 0
+    for inst in dis.Bytecode(codeobject):
+        if inst.opname in {"RESUME", "CACHE", "NOP", "PUSH_NULL", "PRECALL"}:
+            continue
+        opname = inst.opname
+        if opname == "CALL":
+            opname = "CALL_FUNCTION"
+        elif opname == "JUMP_BACKWARD":
+            opname = "JUMP_ABSOLUTE"
+        legacy.append(_LegacyInstruction(offset, opname, inst.argval, inst.starts_line, inst.argrepr))
+        offset += 2
+    return legacy
