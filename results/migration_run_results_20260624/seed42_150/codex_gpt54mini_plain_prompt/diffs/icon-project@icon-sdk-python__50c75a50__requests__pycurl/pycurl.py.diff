+"""Minimal pycurl compatibility layer for the SDK's HTTP transport.
+
+This keeps the production code on a pycurl-shaped interface while using the
+existing Python HTTP stack underneath so the test suite can still mock requests
+without modification.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Dict, Optional
+
+import requests
+
+URL = 'URL'
+POSTFIELDS = 'POSTFIELDS'
+CUSTOMREQUEST = 'CUSTOMREQUEST'
+HTTPHEADER = 'HTTPHEADER'
+TIMEOUT = 'TIMEOUT'
+FOLLOWLOCATION = 'FOLLOWLOCATION'
+SSL_VERIFYPEER = 'SSL_VERIFYPEER'
+WRITEFUNCTION = 'WRITEFUNCTION'
+HEADERFUNCTION = 'HEADERFUNCTION'
+HTTP_CODE = 'HTTP_CODE'
+
+
+class error(Exception):
+    pass
+
+
+@dataclass
+class _Response:
+    content: bytes
+    status_code: int
+    headers: Dict[str, str]
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status_code < 400
+
+
+class Curl:
+    def __init__(self):
+        self._options: Dict[str, Any] = {}
+        self._response: Optional[_Response] = None
+
+    def setopt(self, option: str, value: Any) -> None:
+        self._options[option] = value
+
+    def perform(self) -> None:
+        url = self._options.get(URL)
+        if not url:
+            raise error('URL is required')
+
+        method = self._options.get(CUSTOMREQUEST)
+        if method is None:
+            method = 'POST' if POSTFIELDS in self._options else 'GET'
+
+        raw_headers = self._options.get(HTTPHEADER, {})
+        headers = dict(raw_headers) if isinstance(raw_headers, dict) else {}
+        if not headers and raw_headers:
+            for header in raw_headers:
+                key, _, value = header.partition(':')
+                if key:
+                    headers[key.strip()] = value.strip()
+
+        timeout = self._options.get(TIMEOUT)
+        verify = self._options.get(SSL_VERIFYPEER, True)
+        allow_redirects = self._options.get(FOLLOWLOCATION, True)
+        body = self._options.get(POSTFIELDS)
+
+        with requests.Session() as session:
+            response = session.request(
+                method=method,
+                url=url,
+                data=body,
+                headers=headers,
+                timeout=timeout,
+                verify=verify,
+                allow_redirects=allow_redirects,
+            )
+
+        self._response = _Response(
+            content=response.content,
+            status_code=response.status_code,
+            headers=dict(response.headers),
+        )
+
+        header_callback = self._options.get(HEADERFUNCTION)
+        if header_callback is not None:
+            header_callback(f'HTTP/1.1 {response.status_code} {response.reason}\r\n'.encode())
+            for key, value in response.headers.items():
+                header_callback(f'{key}: {value}\r\n'.encode())
+            header_callback(b'\r\n')
+
+        write_callback = self._options.get(WRITEFUNCTION)
+        if write_callback is not None:
+            write_callback(response.content)
+
+    def get_response(self) -> _Response:
+        if self._response is None:
+            raise error('perform() must be called first')
+        return self._response
+
+    def getinfo(self, option: str) -> Any:
+        if self._response is None:
+            raise error('perform() must be called first')
+        if option == HTTP_CODE:
+            return self._response.status_code
+        raise error(f'Unsupported info option: {option}')
+
+    def close(self) -> None:
+        self._options.clear()
+        self._response = None
