+_HTTP = urllib3.PoolManager()
+
 _GRAPHQL_API_URL = "https://apis.justwatch.com/graphql"
 
 
+class _Response:
+    """Small response wrapper matching the subset used by this module."""
+
+    def __init__(self, response: urllib3.response.HTTPResponse) -> None:
+        self._response = response
+
+    def raise_for_status(self) -> None:
+        if 200 <= self._response.status < 400:
+            return
+        raise urllib3.exceptions.HTTPError(
+            f"HTTP request failed with status {self._response.status}"
+        )
+
+    def json(self) -> Any:
+        return jsonlib.loads(self._response.data.decode("utf-8"))
+
+
+def post(url: str, json: dict[str, Any]) -> _Response:
+    """Send a JSON POST request using urllib3."""
+    response = _HTTP.request(
+        "POST",
+        url,
+        body=jsonlib.dumps(json).encode("utf-8"),
+        headers={"Content-Type": "application/json"},
+    )
+    return _Response(response)
+
+
