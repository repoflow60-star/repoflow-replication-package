+"""Compatibility layer that mirrors the tiny subset of ``requests`` used here.
+
+The project historically depended on ``requests`` and the test suite still
+patches ``requests.get`` / ``requests.Session.get``. This module keeps that API
+surface intact while delegating the actual HTTP work to ``aiohttp``.
+"""
+
+import json as _json
+import sys
+import types
+from urllib import error as _urlerror
+from urllib import request as _urlrequest
+
+try:
+    import aiohttp
+except ImportError:  # pragma: no cover - exercised in environments without aiohttp
+    aiohttp = None
+
+
+class RequestException(Exception):
+    pass
+
+
+class HTTPError(RequestException):
+    pass
+
+
+_exceptions = types.ModuleType("requests.exceptions")
+_exceptions.RequestException = RequestException
+_exceptions.HTTPError = HTTPError
+sys.modules[__name__ + ".exceptions"] = _exceptions
+
+
+class Response(object):
+    def __init__(self, status_code, reason, content, url=None, headers=None):
+        self.status_code = status_code
+        self.reason = reason
+        self.content = content
+        self.url = url
+        self.headers = headers or {}
+
+    @property
+    def text(self):
+        return self.content.decode()
+
+    def json(self):
+        return _json.loads(self.text)
+
+
+async def _aiohttp_request(method, url, **kwargs):
+    async with aiohttp.ClientSession() as client:
+        async with client.request(method, url, **kwargs) as response:
+            content = await response.read()
+            return Response(status_code=response.status,
+                            reason=response.reason or "",
+                            content=content,
+                            url=str(response.url),
+                            headers=dict(response.headers))
+
+
+def _urllib_request(method, url, **kwargs):
+    headers = kwargs.pop("headers", None) or {}
+    data = kwargs.pop("data", None)
+    req = _urlrequest.Request(url, data=data, headers=headers, method=method)
+    timeout = kwargs.pop("timeout", None)
+    try:
+        with _urlrequest.urlopen(req, timeout=timeout) as response:
+            content = response.read()
+            return Response(status_code=response.getcode(),
+                            reason=getattr(response, "reason", "") or "",
+                            content=content,
+                            url=response.geturl(),
+                            headers=dict(response.headers))
+    except _urlerror.HTTPError as response:
+        content = response.read()
+        return Response(status_code=response.code,
+                        reason=getattr(response, "reason", "") or "",
+                        content=content,
+                        url=response.geturl(),
+                        headers=dict(response.headers))
+
+
+def request(method, url, **kwargs):
+    if aiohttp is not None:
+        import asyncio
+
+        return asyncio.run(_aiohttp_request(method, url, **kwargs))
+    return _urllib_request(method, url, **kwargs)
+
+
+def get(url, **kwargs):
+    return request("GET", url, **kwargs)
+
+
+class Session(object):
+    def __init__(self, **kwargs):
+        self._defaults = kwargs
+
+    def get(self, url, **kwargs):
+        options = dict(self._defaults)
+        options.update(kwargs)
+        return get(url, **options)
