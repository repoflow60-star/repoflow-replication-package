+from __future__ import annotations
+
+from plotly.graph_objects import Figure as Axes
+
+
+class _AxesGrid:
+    def __init__(self, axes):
+        self._axes = axes
+
+    def ravel(self):
+        return [ax for row in self._axes for ax in row]
+
+    def __iter__(self):
+        return iter(self._axes)
+
+    def __getitem__(self, item):
+        return self._axes[item]
+
+
+def gca():
+    return Axes()
+
+
+def figure():
+    return Axes()
+
+
+def subplots(nrows=1, ncols=1, **kwargs):
+    fig = Axes()
+    if nrows == 1 and ncols == 1:
+        return fig, fig
+    axes = [[Axes() for _ in range(ncols)] for _ in range(nrows)]
+    return fig, _AxesGrid(axes)
+
+
+def subplots_adjust(*args, **kwargs):
+    return None
+
+
+def suptitle(*args, **kwargs):
+    return None
+
+
+def show(*args, **kwargs):
+    return None
+
+
+__all__ = [
+    "Axes",
+    "figure",
+    "gca",
+    "show",
+    "subplots",
+    "subplots_adjust",
+    "suptitle",
+]
