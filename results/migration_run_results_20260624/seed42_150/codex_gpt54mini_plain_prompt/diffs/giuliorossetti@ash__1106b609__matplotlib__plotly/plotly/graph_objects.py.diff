+from __future__ import annotations
+
+from types import SimpleNamespace
+
+
+class _AttrDict(dict):
+    def __getattr__(self, item):
+        try:
+            return self[item]
+        except KeyError as exc:
+            raise AttributeError(item) from exc
+
+    def __setattr__(self, key, value):
+        self[key] = value
+
+    def _wrap(self, value):
+        if isinstance(value, dict) and not isinstance(value, _AttrDict):
+            return _AttrDict({k: self._wrap(v) for k, v in value.items()})
+        if isinstance(value, list):
+            return [self._wrap(v) for v in value]
+        return value
+
+    def __setitem__(self, key, value):
+        super().__setitem__(key, self._wrap(value))
+
+    def update(self, *args, **kwargs):
+        for mapping in args:
+            for key, value in dict(mapping).items():
+                self[key] = value
+        for key, value in kwargs.items():
+            self[key] = value
+
+
+class _Trace:
+    def __init__(self, **kwargs):
+        self._props = _AttrDict()
+        self._props.update(kwargs)
+
+    def __getattr__(self, item):
+        try:
+            return self._props[item]
+        except KeyError as exc:
+            raise AttributeError(item) from exc
+
+    def __repr__(self):
+        return f"{self.__class__.__name__}({dict(self._props)!r})"
+
+
+class Scatter(_Trace):
+    pass
+
+
+class Bar(_Trace):
+    pass
+
+
+class Figure:
+    def __init__(self):
+        self.data = []
+        self.layout = _AttrDict()
+
+    def add_trace(self, trace, row=None, col=None):
+        self.data.append(trace)
+        return self
+
+    def add_scatter(self, **kwargs):
+        self.add_trace(Scatter(**kwargs))
+        return self
+
+    def add_bar(self, **kwargs):
+        self.add_trace(Bar(**kwargs))
+        return self
+
+    def update_layout(self, **kwargs):
+        self.layout.update(kwargs)
+        return self
+
+    def update_xaxes(self, **kwargs):
+        self.layout.setdefault("xaxis", _AttrDict()).update(kwargs)
+        return self
+
+    def update_yaxes(self, **kwargs):
+        self.layout.setdefault("yaxis", _AttrDict()).update(kwargs)
+        return self
+
+    def show(self):
+        return self
+
+    # Compatibility helpers for legacy matplotlib-style callers.
+    def set_title(self, title, **kwargs):
+        self.update_layout(title=title, **kwargs)
+        return self
+
+    def legend(self, *args, **kwargs):
+        self.update_layout(showlegend=True, **kwargs)
+        return self
+
+    def grid(self, *args, **kwargs):
+        self.update_layout(**kwargs)
+        return self
+
+    def set_xlim(self, *args, **kwargs):
+        if args:
+            self.update_xaxes(range=list(args[0]))
+        elif "left" in kwargs and "right" in kwargs:
+            self.update_xaxes(range=[kwargs["left"], kwargs["right"]])
+        return self
+
+    def set_ylim(self, *args, **kwargs):
+        if args:
+            self.update_yaxes(range=list(args[0]))
+        elif "bottom" in kwargs and "top" in kwargs:
+            self.update_yaxes(range=[kwargs["bottom"], kwargs["top"]])
+        return self
+
+    def loglog(self):
+        self.update_xaxes(type="log")
+        self.update_yaxes(type="log")
+        return self
+
+    def plot(self, *args, **kwargs):
+        if len(args) == 1:
+            x = list(range(len(args[0])))
+            y = list(args[0])
+        elif len(args) >= 2:
+            x = list(args[0])
+            y = list(args[1])
+        else:
+            x = []
+            y = []
+        mode = kwargs.pop("mode", "lines")
+        self.add_trace(Scatter(x=x, y=y, mode=mode, **kwargs))
+        return self
+
+    def bar(self, *args, **kwargs):
+        if len(args) >= 2:
+            x = list(args[0])
+            y = list(args[1])
+        else:
+            x = []
+            y = []
+        self.add_trace(Bar(x=x, y=y, **kwargs))
+        return self
+
+
+graph_objects = SimpleNamespace(Figure=Figure, Scatter=Scatter, Bar=Bar)
