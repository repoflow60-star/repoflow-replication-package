+from __future__ import annotations
+
+from typing import Any, Dict, Tuple
+
+import numpy as np
 
 from ash_model.measures import *
 
+from ._plotly import go
+
+
+def _resolve_figure(kwargs: Dict[str, Any]):
+    fig = kwargs.pop("fig", None)
+    if fig is None:
+        fig = kwargs.pop("ax", None)
+    if fig is None:
+        fig = go.Figure()
+    return fig
+
+
+def _resolve_location(kwargs: Dict[str, Any]) -> Tuple[Any, Any]:
+    row = kwargs.pop("row", None)
+    col = kwargs.pop("col", None)
+    return row, col
+
+
+def _trace_style(kwargs: Dict[str, Any], *, default_opacity: float = None):
+    style: Dict[str, Any] = {}
+
+    alpha = kwargs.pop("alpha", None)
+    if alpha is not None:
+        style["opacity"] = alpha
+    if default_opacity is not None and "opacity" not in style:
+        style["opacity"] = default_opacity
+
+    color = kwargs.pop("color", None)
+    marker = dict(kwargs.pop("marker", {}) or {})
+    line = dict(kwargs.pop("line", {}) or {})
+    if color is not None:
+        marker.setdefault("color", color)
+        line.setdefault("color", color)
+
+    marker_size = kwargs.pop("marker_size", None)
+    if marker_size is not None:
+        marker["size"] = marker_size
+
+    marker_symbol = kwargs.pop("marker_symbol", None)
+    if marker_symbol is not None:
+        marker["symbol"] = marker_symbol
+
+    line_width = kwargs.pop("line_width", None)
+    if line_width is not None:
+        line["width"] = line_width
+
+    line_dash = kwargs.pop("line_dash", None)
+    if line_dash is not None:
+        line["dash"] = line_dash
+
+    if marker:
+        style["marker"] = marker
+    if line:
+        style["line"] = line
+
+    for key in (
+        "opacity",
+        "showlegend",
+        "legendgroup",
+        "hovertemplate",
+        "hoverinfo",
+        "text",
+        "customdata",
+        "fill",
+        "fillcolor",
+        "mode",
+    ):
+        if key in kwargs:
+            style[key] = kwargs.pop(key)
+
+    return style
+
+
+def _add_trace(fig, trace, kwargs):
+    row, col = _resolve_location(kwargs)
+    if row is not None or col is not None:
+        try:
+            fig.add_trace(trace, row=row, col=col)
+            return
+        except Exception:
+            pass
+    fig.add_trace(trace)
+
+
+def _positive_log_data(x, y):
+    x_arr = np.asarray(list(x))
+    y_arr = np.asarray(list(y))
+    mask = (x_arr > 0) & (y_arr > 0)
+    if mask.any():
+        return x_arr[mask], y_arr[mask]
+    return x_arr, y_arr
+
 
