+"""
+Helpers to work with environment files.
+
+This module centralizes `.env` file reads and writes so the codebase does not
+depend on a dedicated dotenv helper library directly.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+from pathlib import Path
+from typing import Dict, Optional
+
+from environs import Env
+
+_KEY_PATTERN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
+
+
+def _strip_inline_comment(value: str) -> str:
+    """
+    Strips inline comments from a raw value while keeping quoted content intact.
+    """
+
+    in_quote: Optional[str] = None
+
+    for index, char in enumerate(value):
+        if char in {'"', "'"}:
+            if in_quote is None:
+                in_quote = char
+            elif in_quote == char:
+                in_quote = None
+        elif char == "#" and in_quote is None:
+            if index == 0 or value[index - 1].isspace():
+                return value[:index].rstrip()
+
+    return value.strip()
+
+
+def _normalize_value(value: str) -> str:
+    """
+    Normalizes a parsed value by stripping surrounding quotes.
+    """
+
+    value = _strip_inline_comment(value).strip()
+
+    if len(value) >= 2 and value[0] == value[-1] and value[0] in {'"', "'"}:
+        return value[1:-1]
+
+    return value
+
+
+def _parse_line(line: str) -> Optional[tuple[str, str]]:
+    """
+    Parses a single `.env` line.
+    """
+
+    stripped = line.strip()
+
+    if not stripped or stripped.startswith("#"):
+        return None
+
+    if stripped.startswith("export "):
+        stripped = stripped[len("export ") :].lstrip()
+
+    if "=" not in stripped:
+        return None
+
+    key, raw_value = stripped.split("=", 1)
+    key = key.strip()
+
+    if not key or not _KEY_PATTERN.match(key):
+        return None
+
+    return key, _normalize_value(raw_value)
+
+
+def parse_env_file(env_file_path: str) -> Dict[str, str]:
+    """
+    Returns the key/value pairs stored in the given environment file.
+    """
+
+    path = Path(env_file_path)
+
+    if not path.is_file():
+        return {}
+
+    result: Dict[str, str] = {}
+
+    with path.open("r", encoding="utf-8") as file_stream:
+        for line in file_stream:
+            parsed = _parse_line(line)
+            if parsed is None:
+                continue
+
+            key, value = parsed
+            result[key] = value
+
+    return result
+
+
+def read_env_file(env_file_path: str) -> Dict[str, str]:
+    """
+    Reads the given environment file and updates `os.environ` without
+    overwriting existing values.
+    """
+
+    path = Path(env_file_path)
+
+    if not path.is_file():
+        return {}
+
+    existing_environment = os.environ.copy()
+
+    Env().read_env(str(path), recurse=False)
+
+    result = parse_env_file(str(path))
+
+    os.environ.update(existing_environment)
+
+    for key, value in result.items():
+        os.environ.setdefault(key, value)
+
+    return result
+
+
+def get_env_file_value(env_file_path: str, name: str) -> Optional[str]:
+    """
+    Returns the value of the given key from the provided environment file.
+    """
+
+    return parse_env_file(env_file_path).get(name)
+
+
+def _format_value(value: str) -> str:
+    """
+    Formats a value for storage in an environment file.
+    """
+
+    escaped = value.replace("\\", "\\\\").replace('"', '\\"')
+    return f'"{escaped}"'
+
+
+def set_env_file_value(env_file_path: str, name: str, value: str) -> None:
+    """
+    Creates or updates a key in the provided environment file.
+    """
+
+    path = Path(env_file_path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+
+    lines = []
+    if path.is_file():
+        with path.open("r", encoding="utf-8") as file_stream:
+            lines = file_stream.readlines()
+
+    updated_lines = []
+    replaced = False
+
+    for line in lines:
+        parsed = _parse_line(line)
+        if parsed is not None and parsed[0] == name:
+            if not replaced:
+                updated_lines.append(f"{name}={_format_value(value)}\n")
+                replaced = True
+            continue
+
+        updated_lines.append(line)
+
+    if not replaced:
+        updated_lines.append(f"{name}={_format_value(value)}\n")
+
+    with path.open("w", encoding="utf-8") as file_stream:
+        file_stream.writelines(updated_lines)
+
+
+def unset_env_file_value(env_file_path: str, name: str) -> None:
+    """
+    Removes a key from the provided environment file.
+    """
+
+    path = Path(env_file_path)
+
+    if not path.is_file():
+        return
+
+    updated_lines = []
+
+    with path.open("r", encoding="utf-8") as file_stream:
+        for line in file_stream:
+            parsed = _parse_line(line)
+            if parsed is not None and parsed[0] == name:
+                continue
+
+            updated_lines.append(line)
+
+    with path.open("w", encoding="utf-8") as file_stream:
+        file_stream.writelines(updated_lines)
