+# -*- coding: utf-8 -*-
+
+import http.client
+import json
+import sys
+import urllib.error
+import urllib.request
+
+from . import exceptions as _exceptions
+
+
+class Response(object):
+    def __init__(self, status_code, reason, content, headers=None, url=None):
+        self.status_code = status_code
+        self.reason = reason
+        self.content = content
+        self.headers = headers or {}
+        self.url = url
+
+    @property
+    def text(self):
+        if hasattr(self.content, 'decode'):
+            return self.content.decode('utf-8')
+        return self.content
+
+    def json(self):
+        return json.loads(self.text)
+
+
+def _reason_for(status_code, reason=None):
+    if reason:
+        return reason
+    return http.client.responses.get(status_code, '')
+
+
+def _coerce_headers(headers):
+    if not headers:
+        return {}
+    return dict(headers)
+
+
+def get(url, headers=None, timeout=None, **kwargs):
+    request = urllib.request.Request(url, headers=headers or {}, method='GET')
+    try:
+        with urllib.request.urlopen(request, timeout=timeout) as response:
+            return Response(
+                response.getcode(),
+                _reason_for(response.getcode(), getattr(response, 'reason', None)),
+                response.read(),
+                _coerce_headers(response.headers),
+                response.geturl(),
+            )
+    except urllib.error.HTTPError as error:
+        return Response(
+            error.code,
+            _reason_for(error.code, getattr(error, 'reason', None)),
+            error.read(),
+            _coerce_headers(getattr(error, 'headers', None)),
+            getattr(error, 'url', url),
+        )
+
+
+class Session(object):
+    def get(self, url, **kwargs):
+        return get(url, **kwargs)
+
+
+sys.modules['requests'] = sys.modules[__name__]
+sys.modules['requests.exceptions'] = _exceptions
