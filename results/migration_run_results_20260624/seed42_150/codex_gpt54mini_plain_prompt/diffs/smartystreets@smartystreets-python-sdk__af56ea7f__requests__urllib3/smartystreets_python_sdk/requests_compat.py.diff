@@ -0,0 +1,103 @@
+import json
+from urllib.parse import parse_qsl, urlencode, urlparse, urlunparse
+
+import urllib3
+
+
+class Request:
+    def __init__(self, url=None, params=None, headers=None, data=None, method=None):
+        self.url = url
+        self.params = params or {}
+        self.headers = headers or {}
+        self.data = data
+        self.method = method
+
+    @property
+    def body(self):
+        return self.data
+
+
+class Response:
+    def __init__(self, inner_response):
+        self._inner_response = inner_response
+        self.status_code = inner_response.status
+        self.headers = inner_response.headers
+        self.text = _decode_body(inner_response.data)
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        self.close()
+        return False
+
+    def close(self):
+        if hasattr(self._inner_response, "release_conn"):
+            self._inner_response.release_conn()
+
+    def json(self):
+        return json.loads(self.text)
+
+
+class Session:
+    def __init__(self):
+        self._pool_manager = urllib3.PoolManager()
+
+    def prepare_request(self, request):
+        request.url = _build_url(request.url, request.params)
+        return request
+
+    def merge_environment_settings(self, url, proxies, stream, verify, cert):
+        return {'proxies': proxies or {}}
+
+    def send(self, request, timeout=None, **kwargs):
+        proxies = kwargs.get('proxies') or {}
+        proxy_url = _pick_proxy(request.url, proxies)
+
+        if proxy_url:
+            manager = urllib3.ProxyManager(proxy_url)
+        else:
+            manager = self._pool_manager
+
+        http_response = manager.request(
+            request.method or 'GET',
+            request.url,
+            body=_encode_body(request.data),
+            headers=request.headers,
+            timeout=timeout,
+            preload_content=True,
+        )
+        return Response(http_response)
+
+
+def _build_url(url, params):
+    if not params:
+        return url
+
+    parsed_url = urlparse(url)
+    current_params = parse_qsl(parsed_url.query, keep_blank_values=True)
+    merged_params = current_params + list(params.items())
+    query = urlencode(merged_params, doseq=True)
+    return urlunparse(parsed_url._replace(query=query))
+
+
+def _pick_proxy(url, proxies):
+    if not proxies:
+        return None
+
+    scheme = urlparse(url).scheme
+    return proxies.get(scheme) or proxies.get('https') or proxies.get('http')
+
+
+def _encode_body(body):
+    if isinstance(body, str):
+        return body.encode('utf-8')
+    return body
+
+
+def _decode_body(body):
+    if body is None:
+        return ''
+    if isinstance(body, bytes):
+        return body.decode('utf-8', errors='replace')
+    return body
