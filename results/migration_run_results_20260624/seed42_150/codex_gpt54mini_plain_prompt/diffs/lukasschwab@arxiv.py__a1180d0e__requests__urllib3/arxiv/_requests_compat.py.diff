+"""Minimal requests-compatible wrapper built on urllib3."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from types import SimpleNamespace
+from typing import Optional
+
+import urllib3
+from urllib3.exceptions import HTTPError as _Urllib3HTTPError
+
+
+class ConnectionError(Exception):
+    """Raised when the underlying urllib3 client cannot connect."""
+
+
+exceptions = SimpleNamespace(ConnectionError=ConnectionError)
+codes = SimpleNamespace(OK=200)
+
+
+@dataclass
+class Response:
+    """Small subset of requests.Response used by this package and its tests."""
+
+    status_code: int = 0
+    _content: bytes = b""
+
+    @property
+    def content(self) -> bytes:
+        return self._content
+
+    @content.setter
+    def content(self, value: bytes) -> None:
+        self._content = value
+
+
+class Session:
+    """requests.Session-like wrapper around urllib3.PoolManager."""
+
+    def __init__(self):
+        self._pool = urllib3.PoolManager()
+
+    def get(self, url: str, headers: Optional[dict] = None) -> Response:
+        try:
+            http_response = self._pool.request(
+                "GET",
+                url,
+                headers=headers,
+                retries=False,
+                preload_content=True,
+            )
+        except _Urllib3HTTPError as err:
+            raise ConnectionError(str(err)) from err
+
+        return Response(status_code=http_response.status, _content=http_response.data)
