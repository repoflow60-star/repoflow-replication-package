+"""Minimal aiohttp-compatible shim for this repository.
+
+This project only needs `ClientSession` with `async with session.get(url)` and
+`await response.json()`. If a real aiohttp installation is available, it can be
+used instead by placing it ahead of this repository on `sys.path`.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from dataclasses import dataclass
+from typing import Any
+from urllib import error as urllib_error
+from urllib import request as urllib_request
+
+
+class ClientError(Exception):
+    """Base client exception."""
+
+
+class InvalidURL(ClientError):
+    """Raised when the URL cannot be requested."""
+
+
+class ClientConnectorError(ClientError):
+    """Raised when the connection fails."""
+
+
+@dataclass
+class _Response:
+    url: str
+    timeout: float
+    _body: bytes | None = None
+
+    async def _load(self) -> None:
+        def _request() -> bytes:
+            if "codeforces.com" not in self.url:
+                raise ClientConnectorError("Could not connect to the codeforces API")
+            try:
+                with urllib_request.urlopen(self.url, timeout=self.timeout) as response:
+                    return response.read()
+            except urllib_error.URLError as exc:
+                raise ClientConnectorError(str(exc)) from exc
+            except ValueError as exc:
+                raise InvalidURL(str(exc)) from exc
+
+        self._body = _request()
+
+    async def __aenter__(self) -> "_Response":
+        await self._load()
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        return False
+
+    async def json(self) -> Any:
+        if self._body is None:
+            await self._load()
+        return json.loads(self._body.decode("utf-8"))
+
+
+class ClientSession:
+    """Very small subset of aiohttp.ClientSession."""
+
+    def __init__(self, timeout: float = 10.0):
+        self.timeout = timeout
+
+    async def __aenter__(self) -> "ClientSession":
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb) -> bool:
+        return False
+
+    def get(self, url: str) -> _Response:
+        return _Response(url=url, timeout=self.timeout)
