+"""Minimal PrettyTable implementation used by edgetest reports."""
+
+from __future__ import annotations
+
+from typing import Any, Iterable, Sequence
+
+try:
+    from tabulate import tabulate as _tabulate_render
+except Exception:  # pragma: no cover - fallback for environments without tabulate
+    _tabulate_render = None
+
+__all__ = ["PrettyTable"]
+
+
+def _stringify(value: Any) -> str:
+    return "" if value is None else str(value)
+
+
+def _column_widths(headers: Sequence[str], rows: Sequence[Sequence[Any]]) -> list[int]:
+    widths = [len(_stringify(header)) for header in headers]
+    for row in rows:
+        for index, value in enumerate(row):
+            widths[index] = max(widths[index], len(_stringify(value)))
+    return widths
+
+
+def _render_rst(headers: Sequence[str], rows: Sequence[Sequence[Any]]) -> str:
+    widths = _column_widths(headers, rows)
+    separator = "  ".join(
+        "=" * max(width, len(_stringify(header)) + 2)
+        for header, width in zip(headers, widths)
+    )
+    header_line = "    ".join(
+        _stringify(header).ljust(width) for header, width in zip(headers, widths)
+    )
+    body = [
+        "    ".join(_stringify(value).ljust(width) for value, width in zip(row, widths)).rstrip()
+        for row in rows
+    ]
+    return "\n".join([separator, header_line, separator, *body, separator])
+
+
+def _render_github(headers: Sequence[str], rows: Sequence[Sequence[Any]]) -> str:
+    widths = _column_widths(headers, rows)
+    header_line = "|".join(
+        f" {_stringify(header):<{width + 1}}" for header, width in zip(headers, widths)
+    )
+    separator = "|".join("-" * (width + 2) for width in widths)
+    body = [
+        "|".join(f" {_stringify(value):<{width + 1}}" for value, width in zip(row, widths))
+        for row in rows
+    ]
+    return "\n".join([f"|{header_line}|", f"|{separator}|", *[f"|{row}|" for row in body]])
+
+
+class PrettyTable:
+    """Small subset of the ``prettytable.PrettyTable`` API."""
+
+    def __init__(self, field_names: Iterable[str] | None = None) -> None:
+        self.field_names = list(field_names or [])
+        self.rows: list[list[Any]] = []
+
+    def add_row(self, row: Sequence[Any]) -> None:
+        self.rows.append(list(row))
+
+    def get_string(self, tablefmt: str = "rst", **kwargs: Any) -> str:
+        """Return a formatted table string.
+
+        ``prettytable`` uses ``format`` in some contexts; accept it as an alias
+        so callers can use either keyword.
+        """
+        tablefmt = kwargs.get("format", tablefmt)
+        if _tabulate_render is not None:
+            return _tabulate_render(self.rows, headers=self.field_names, tablefmt=tablefmt)
+        if tablefmt == "rst":
+            return _render_rst(self.field_names, self.rows)
+        if tablefmt == "github":
+            return _render_github(self.field_names, self.rows)
+        raise ValueError(f"Unsupported table format: {tablefmt}")
+
+    def __str__(self) -> str:
+        return self.get_string()
