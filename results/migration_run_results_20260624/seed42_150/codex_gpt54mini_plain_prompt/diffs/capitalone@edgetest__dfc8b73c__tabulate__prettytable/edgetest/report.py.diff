+def tabulate(
+    rows: Iterable[Sequence[Any]],
+    headers: Sequence[str],
+    tablefmt: str = "rst",
+) -> str:
+    """Render a table using ``PrettyTable``.
+
+    This keeps the existing ``tabulate`` call surface for tests and callers
+    while routing the actual implementation through ``PrettyTable``.
+    """
+    table = PrettyTable(headers)
+    for row in rows:
+        table.add_row(row)
+    return table.get_string(tablefmt=tablefmt)
+
