+    def _normalize_rule_style(self, style: dict[str, float | str]) -> dict[str, Any]:
+        """Translate legacy line kwargs into Altair rule properties."""
+        normalized: dict[str, Any] = {}
+        for key, value in style.items():
+            match key:
+                case "linewidth":
+                    normalized["strokeWidth"] = value
+                case "color":
+                    normalized["stroke"] = value
+                case "linestyle":
+                    stroke_dash = self._normalize_line_style(str(value))
+                    if stroke_dash is not None:
+                        normalized["strokeDash"] = stroke_dash
+                case "arrowstyle":
+                    continue
+                case _:
+                    normalized[key] = value
+        return normalized
+
+    def _normalize_line_style(self, linestyle: str) -> list[int] | None:
+        """Convert a line style name to an Altair stroke dash pattern."""
+        match linestyle.lower():
+            case "solid" | "-":
+                return None
+            case "dashed" | "--":
+                return [8, 4]
+            case "dashdot" | "-.":
+                return [8, 4, 2, 4]
+            case "dotted" | ":":
+                return [2, 2]
+            case _:
+                return None
