+"""Minimal FuturesSession implementation used by pdpyras."""
+
+from concurrent.futures import ThreadPoolExecutor
+
+from requests import Session as RequestsSession
+
+
+class FuturesSession(RequestsSession):
+    """A small subset of requests_futures.sessions.FuturesSession.
+
+    The real library returns a Future from ``request`` and runs the blocking
+    requests.Session.request call in a thread pool. That is all pdpyras needs.
+    """
+
+    def __init__(self, max_workers=8, session=None, adapter_kwargs=None, *args, **kwargs):
+        if session is not None:
+            raise NotImplementedError(
+                "Passing a prebuilt session is not supported in the local shim."
+            )
+        super().__init__(*args, **kwargs)
+        self._executor = ThreadPoolExecutor(max_workers=max_workers)
+        self._adapter_kwargs = adapter_kwargs or {}
+
+    def request(self, method, url, **kwargs):
+        bound_request = super().request
+        return self._executor.submit(bound_request, method, url, **kwargs)
+
+    def close(self):
+        try:
+            self._executor.shutdown(wait=True)
+        finally:
+            super().close()
