@@ -0,0 +1,81 @@
+from __future__ import annotations
+
+import asyncio
+import base64
+import json
+from dataclasses import dataclass
+from typing import Any
+
+from .exceptions import RequestException
+
+_loop = asyncio.new_event_loop()
+asyncio.set_event_loop(_loop)
+
+try:
+    from twisted.internet import asyncioreactor
+    import treq
+except Exception:  # pragma: no cover - exercised only when dependencies are missing
+    treq = None  # type: ignore[assignment]
+else:
+    try:
+        asyncioreactor.install(_loop)
+    except Exception:
+        pass
+
+
+@dataclass
+class Response:
+    status_code: int
+    url: str
+    _body: bytes
+
+    def json(self) -> Any:
+        return json.loads(self._body.decode("utf-8"))
+
+    @property
+    def text(self) -> str:
+        return self._body.decode("utf-8")
+
+
+def _await(deferred):
+    try:
+        future = deferred.asFuture(_loop)
+        return _loop.run_until_complete(future)
+    except Exception as exc:  # pragma: no cover - runtime network failure path
+        raise RequestException(str(exc)) from exc
+
+
+def _encode_auth(auth: tuple[str, str] | None) -> dict[str, str]:
+    if not auth:
+        return {}
+    token = base64.b64encode(f"{auth[0]}:{auth[1]}".encode("utf-8")).decode("ascii")
+    return {"Authorization": f"Basic {token}"}
+
+
+def _request(method: str, url: str, *, data=None, json=None, headers=None, auth=None) -> Response:
+    if treq is None:
+        raise RequestException("treq is not available")
+
+    prepared_headers = dict(headers or {})
+    prepared_headers.update(_encode_auth(auth))
+
+    if json is not None:
+        prepared_headers.setdefault("Content-Type", "application/json")
+
+    try:
+        response = _await(treq.request(method, url, headers=prepared_headers, data=data, json=json))
+        body = _await(treq.content(response))
+    except RequestException:
+        raise
+    except Exception as exc:  # pragma: no cover - runtime network failure path
+        raise RequestException(str(exc)) from exc
+
+    return Response(status_code=response.code, url=url, _body=body)
+
+
+def get(url: str, *, headers=None, auth=None) -> Response:
+    return _request("GET", url, headers=headers, auth=auth)
+
+
+def post(url: str, *, data=None, json=None, headers=None, auth=None) -> Response:
+    return _request("POST", url, data=data, json=json, headers=headers, auth=auth)
