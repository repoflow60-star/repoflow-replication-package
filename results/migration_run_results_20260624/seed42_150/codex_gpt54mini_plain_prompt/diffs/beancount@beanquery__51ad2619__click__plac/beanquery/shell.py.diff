+class _Command:
+    name = 'bean-query'
+
+    def __init__(self, func):
+        self.func = func
+        self.__doc__ = func.__doc__
+
+    def __call__(self, *args, **kwargs):
+        return self.main(*args, **kwargs)
+
+    def _build_parser(self, prog_name):
+        parser = argparse.ArgumentParser(
+            prog=prog_name or self.name,
+            description=self.__doc__,
+        )
+        parser.add_argument('filename')
+        parser.add_argument('query', nargs='*')
+        parser.add_argument('--numberify', '-m', action='store_true',
+                            help='Numberify the output, removing the currencies.')
+        parser.add_argument('--format', '-f', choices=tuple(FORMATS.keys()), default='text',
+                            help='Output format.')
+        parser.add_argument('--output', '-o', default='-',
+                            help='Output filename.')
+        parser.add_argument('--no-errors', '-q', action='store_true',
+                            help='Do not report errors.')
+        parser.add_argument('--version', action='version',
+                            version=f'beanquery {beanquery.__version__}, beancount {beancount.__version__}')
+        return parser
+
+    def main(self, args=(), prog_name=None, **extra):
+        del extra
+        parser = self._build_parser(prog_name)
+        if hasattr(parser, 'parse_intermixed_args'):
+            namespace = parser.parse_intermixed_args(list(args))
+        else:
+            namespace = parser.parse_args(list(args))
+        return self.func(
+            namespace.filename,
+            tuple(namespace.query),
+            namespace.numberify,
+            namespace.format,
+            namespace.output,
+            namespace.no_errors,
+        )
+
+
+main = _Command(_main)
