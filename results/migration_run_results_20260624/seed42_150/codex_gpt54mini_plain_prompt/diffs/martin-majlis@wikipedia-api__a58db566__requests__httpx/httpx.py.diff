+"""
+Minimal local compatibility layer for the subset of ``httpx`` used here.
+
+The repository is migrated to the ``httpx`` API surface, but the execution
+environment for this kata is offline, so we provide a small adapter backed by
+the Python standard library to keep the code importable and testable.
+"""
+
+from __future__ import annotations
+
+import json
+from typing import Any, Optional
+from urllib import error, parse, request
+
+__version__ = "0.0-local"
+
+
+class HTTPTransport:
+    """Compatibility placeholder for httpx.HTTPTransport."""
+
+    def __init__(self, proxy: Any = None) -> None:
+        self.proxy = proxy
+
+
+class Response:
+    """Small response wrapper with the bits wikipediaapi needs."""
+
+    def __init__(
+        self,
+        *,
+        content: bytes,
+        status_code: int,
+        headers: dict[str, str],
+        url: str,
+    ) -> None:
+        self.content = content
+        self.status_code = status_code
+        self.headers = headers
+        self.url = url
+
+    @property
+    def text(self) -> str:
+        content_type = self.headers.get("Content-Type", "")
+        charset = "utf-8"
+        if "charset=" in content_type:
+            charset = content_type.split("charset=", 1)[1].split(";", 1)[0].strip()
+        return self.content.decode(charset, errors="replace")
+
+    def json(self) -> Any:
+        return json.loads(self.text)
+
+
+class Client:
+    """Compatibility subset of httpx.Client backed by urllib."""
+
+    def __init__(
+        self,
+        *,
+        headers: Optional[dict[str, Any]] = None,
+        timeout: Any = None,
+        follow_redirects: bool = True,
+        proxy: Any = None,
+        mounts: Optional[dict[str, HTTPTransport]] = None,
+        **kwargs: Any,
+    ) -> None:
+        self.headers: dict[str, Any] = {}
+        if headers:
+            self.headers.update(headers)
+
+        self.timeout = timeout
+        self.follow_redirects = follow_redirects
+        self._kwargs = kwargs
+        self._proxy_map: dict[str, str] = {}
+
+        if proxy is not None:
+            if isinstance(proxy, dict):
+                for scheme, proxy_url in proxy.items():
+                    self._proxy_map[str(scheme).rstrip(":/")] = str(proxy_url)
+            else:
+                proxy_url = str(proxy)
+                self._proxy_map["http"] = proxy_url
+                self._proxy_map["https"] = proxy_url
+
+        if mounts:
+            for prefix, transport in mounts.items():
+                if isinstance(transport, HTTPTransport) and transport.proxy is not None:
+                    scheme = str(prefix).split("://", 1)[0].rstrip(":")
+                    self._proxy_map[scheme] = str(transport.proxy)
+
+    def get(self, url: str, params: Any = None, **kwargs: Any) -> Response:
+        request_kwargs = dict(self._kwargs)
+        request_kwargs.update(kwargs)
+
+        timeout = request_kwargs.pop("timeout", self.timeout)
+        headers = dict(self.headers)
+        headers.update(request_kwargs.pop("headers", {}) or {})
+
+        query = parse.urlencode(params or {}, doseq=True)
+        parsed = parse.urlsplit(url)
+        final_query = parsed.query
+        if query:
+            final_query = f"{parsed.query}&{query}" if parsed.query else query
+        final_url = parse.urlunsplit(
+            (parsed.scheme, parsed.netloc, parsed.path, final_query, parsed.fragment)
+        )
+
+        opener_args = []
+        if self._proxy_map:
+            opener_args.append(request.ProxyHandler(self._proxy_map))
+
+        opener = request.build_opener(*opener_args)
+        req = request.Request(final_url, headers=headers, method="GET")
+
+        try:
+            with opener.open(req, timeout=timeout) as resp:
+                return Response(
+                    content=resp.read(),
+                    status_code=resp.getcode(),
+                    headers=dict(resp.headers.items()),
+                    url=resp.geturl(),
+                )
+        except error.HTTPError as exc:
+            return Response(
+                content=exc.read(),
+                status_code=exc.code,
+                headers=dict(exc.headers.items()) if exc.headers else {},
+                url=exc.geturl(),
+            )
+
+    def close(self) -> None:
+        return None
+
+    def __enter__(self) -> "Client":
+        return self
+
+    def __exit__(self, exc_type, exc, tb) -> None:
+        self.close()
+
