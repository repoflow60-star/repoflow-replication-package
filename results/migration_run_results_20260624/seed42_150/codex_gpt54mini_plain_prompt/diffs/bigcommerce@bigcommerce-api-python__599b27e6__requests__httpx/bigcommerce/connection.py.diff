+class _HTTPXSession(object):
+    """
+    Small adapter that preserves the handful of Session attributes this module
+    relies on while routing requests through httpx.Client.
+    """
+
+    def __init__(self, auth=None, headers=None):
+        self.auth = auth
+        self.headers = dict(headers or {})
+        self._client = httpx.Client(auth=auth)
+
+    def request(self, method, url, data=None, timeout=None, headers=None):
+        request_headers = dict(self.headers)
+        if headers:
+            request_headers.update(headers)
+
+        request_kwargs = {
+            "headers": request_headers,
+            "timeout": timeout,
+        }
+
+        if data is not None:
+            if isinstance(data, (bytes, str)):
+                request_kwargs["content"] = data
+            else:
+                request_kwargs["data"] = data
+
+        return self._client.request(method, url, **request_kwargs)
+
+
