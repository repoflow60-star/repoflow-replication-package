+def _des_key_parts(key: bytes) -> _typing.Tuple[bytes, ...]:
+    if len(key) == 8:
+        return (key,)
+
+    if len(key) == 16:
+        return key[:8], key[8:16], key[:8]
+
+    if len(key) == 24:
+        return key[:8], key[8:16], key[16:24]
+
+    raise ValueError("Key must be a single, double or triple DES key")
