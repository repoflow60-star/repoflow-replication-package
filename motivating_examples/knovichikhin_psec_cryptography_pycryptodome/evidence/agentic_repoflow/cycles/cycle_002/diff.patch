+    return _DES.new(key, _DES.MODE_ECB).decrypt(block)
+
+
+def _encrypt_tdes_block(key: bytes, block: bytes) -> bytes:
+    parts = _des_key_parts(key)
+    if len(parts) == 1:
+        return _encrypt_des_block(parts[0], block)
+
+    k1, k2, k3 = parts
+    return _encrypt_des_block(k1, _decrypt_des_block(k2, _encrypt_des_block(k3, block)))
+
+
+def _decrypt_tdes_block(key: bytes, block: bytes) -> bytes:
+    parts = _des_key_parts(key)
+    if len(parts) == 1:
